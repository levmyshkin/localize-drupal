"යාවත්කාලීන කිරීම් "
"ස්වයංක්‍රීයව පරීක්ෂා "
"කරන්න"

msgid "1 byte"
msgid_plural "@count bytes"
msgstr[0] "1 byte"
msgstr[1] "@count bytes"

