msgstr "<b>@type:</b> <a href=\":tel\">@tel</a> x@ext"

msgid "<a href=\":tel\">@tel</a> x@ext"
msgstr "<a href=\":tel\">@tel</a> x@ext"

msgid "<b>@type:</b> <a href=\":tel\">@tel</a>"
msgstr "<b>@type:</b> <a href=\":tel\">@tel</a>"

