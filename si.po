msgid "feet"
msgstr "පාවහන් (footwear)"

msgctxt "Imperial height unit"
msgid "foot"
msgstr "පාවහන් දාරය (foot)"

msgctxt "Imperial height unit"
msgid "inches"
msgstr "අඟල් (inches)"

msgctxt "Imperial height unit"
msgid "inch"
msgstr "අඟල්"

msgctxt "Imperial height unit"
msgid "Feet"
msgstr "කකුල්"

