"webform_example_element:\n"
"  '#type': webform_example_element\n"
"  "
"'#title': 'Webform Example "
"Element'\n"
"webform_example_element_multiple:\n"
"  '#type': "
"webform_example_element\n"
"  '#title': 'Webform Example Element "
"Multiple'\n"
"  '#multiple': true\n"
""
msgstr ""
"webform_example_element:\n"
"  '#type': webform_example_element\n"
"  "
"'#title': 'වෙබ්ෆෝම් උදාහරණ "
