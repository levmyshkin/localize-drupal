msgstr ""
"overall:\n"
"  '#type': radios\n"
"  '#title': 'సెషన్ "
"మొత్తంగా ఎలా "
"అనిపించింది?'\n"
"  '#options_display': "
"side_by_side\n"
"  '#options': likert_quality\n"
"  '#required': "
"true\n"
"speaker:\n"
"  '#type': webform_likert\n"
"  '#title': "
"'దయచేసి ప్రసంగకర్త యొక్క "
"రేటింగ్ ఇవ్వండి…'\n"
"  '#questions':\n"
"   "
" mastery: 'ఈ అంశంపై పట్టు'\n"
"    presentation: "
"'ప్రదర్శన నైపుణ్యాలు'\n"
"    "
"quality: 'స్లైడ్లు మరియు దృశ్య "
"సహాయాల నాణ్యత'\n"
"  '#answers': "
"likert_quality\n"
"  '#na_answer': true\n"
"  '#required': "
"true\n"
