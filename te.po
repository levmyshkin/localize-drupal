msgctxt "Validation"
msgid "Valid mapping keys"
msgstr ""
"చెల్లుబాటు అయ్యే "
"మ్యాపింగ్ కీలు"

msgid "'@key' is not a supported key."
msgstr "`@key` కి మద్దతు ఉన్న కీ కాదు."

