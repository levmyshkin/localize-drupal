msgstr ""
"%submission: %handler kudeatzailearentzat <b>ez da posta "
"elektronikorik bidali</b> <em>Helbide</em>, <em>CC</em> edo "
"<em>BCC</em> helbide bat ez delako eman."

msgid ""
"%submission: Email <b>not scheduled</b> for %handler handler because "
"%send is not a valid date/token."
msgstr ""
"%submission: %handler kudeatzailearentzat Email <b>ez dago "
"programatuta</b> izan %send ez delako data/token baliozkoa."

msgid ""
"%submission: Email <b>@action</b> by %handler handler to be sent on "
"%date."
msgstr ""
"%submission: %date %ean bidaltzeko %handler kudeatzaileak "
"<b>@action</b> posta elektronikoa."

msgid "%submission: Email <b>unscheduled</b> for %handler handler."
msgstr ""
"%submission: %handler kudeatzailerako <b>ez planifikatutako</b> posta "
"elektronikoa."

