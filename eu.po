msgid ""
"This setting controls how complicated the configuration is. If you do "
"not have a use-case for a more advanced set-up the recommendation is "
"to keep it simple."
msgstr ""
"Ezarpen honek kontrolatzen du konfigurazioa zein konplikatua den. Ez "
"baduzu erabilera-kasu aurreratu baterako beharrik, gomendioa da sinple "
"mantentzea."

msgid "The configuration ignored in all cases"
msgstr "Konfigurazioa beti baztertzen da kasu guztietan"

msgid ""
"One configuration name per line.<br />\n"
"Examples: "
"<ul>\n"
"<li>user.settings</li>\n"
"<li>views.settings</li>\n"
"<li>contact.settings</li>\n"
"<li>webform.webform.* "
"(will ignore all config entities that starts with "
"<em>webform.webform</em>)</li>\n"
"<li>*.contact_message.custom_contact_form.* "
"(will ignore all config entities that starts with "
"<em>.contact_message.custom_contact_form.</em> like fields attached to "
"a custom contact form)</li>\n"
"<li>* (will ignore "
"everything)</li>\n"
"<li>~webform.webform.contact (will force import for "
"this configuration, even if ignored by a "
"wildcard)</li>\n"
"<li>user.mail:register_no_approval_required.body "
"(will ignore the body of the no approval required email setting, but "
"will not ignore other user.mail "
"configuration.)</li>\n"
"<li>language.*|* (will ignore all language "
"collections)</li>\n"
"<li>language.fr|* (will ignore all fr language "
"collection)</li>\n"
"<li>language.fr|field.field.* (will ignore all fr "
"field "
"translations)</li>\n"
"<li>~language.fr|field.field.media.file.field_media_file "
"(will force import for certain field "
"translation)</li>\n"
"<li>language.*|system.site:name (will ignore just "
"the site name but in all translations)</li>\n"
"</ul>"
msgstr ""
"Konfigurazio izen bat lerro bakoitzeko.<br />\n"
"Adibideak: "
"<ul>\n"
"<li>user.settings</li>\n"
"<li>views.settings</li>\n"
"<li>contact.settings</li>\n"
"<li>webform.webform.* "
"(inguruko konfigurazio-entitate guztiak baztertuko ditu "
"<em>webform.webform</em> hasierarekin "
"hasita)</li>\n"
"<li>*.contact_message.custom_contact_form.* (baztertuko "
"ditu <em>.contact_message.custom_contact_form.</em> hasierako "
"konfigurazio-entitate guztiak, hala nola, formulario pertsonalizatu "
"batekin lotutako eremuak)</li>\n"
"<li>* (dena baztertuko "
"du)</li>\n"
"<li>~webform.webform.contact (konfigurazio honen "
"inportazioa derrigortuko du, nahiz eta izarrek baztertua "
"izan)</li>\n"
"<li>user.mail:register_no_approval_required.body "
"(onartuko du baimenik gabeko posta elektronikoko konfigurazioaren "
"gorputza baztertzea, baina ez beste user.mail "
"konfigurazioak)</li>\n"
"<li>language.*|* (hizkuntza- bilduma guztiak "
"baztertuko ditu)</li>\n"
"<li>language.fr|* (fr hizkuntza-bilduma guztia "
"baztertuko du)</li>\n"
"<li>language.fr|field.field.* (fr eremu itzulpen "
"guztiak baztertuko "
"ditu)</li>\n"
"<li>~language.fr|field.field.media.file.field_media_file "
"(ertain eremu itzulpen baten inportazioa derrigortuko "
"du)</li>\n"
"<li>language.*|system.site:name (gune-izena bakarrik "
"baztertuko du, baina itzulpen guztietan)</li>\n"
"</ul>"

