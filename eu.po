msgstr ""
"Erabiltzaileek webformulario guztietarako bidalketa-emaitzen taula "
"pertsonaliza dezakete"

msgid "Customize default table"
msgstr "Lehentasunezko taula pertsonalizatu"

msgid ""
"Below you can customize your dedicated results table, which is "
"displayed only to you."
msgstr ""
"Behean zure emaitza-taula pertsonalizatu dezakezu, eta hau soilik "
"zuentzat agertzen da."

msgid ""
"Below you can customize the default results table, which is displayed "
"to all users."
msgstr ""
"Jarraian, erabiltzaile guztiei erakusten zaien emaitzen taula "
"lehenetsia pertsonaliza dezakezu."

msgid "Your customized table has been saved."
msgstr "Zure pertsonalizatutako taula gordeta geratu da."

msgid "The default customized table has been saved."
msgstr "Taula pertsonalizatu lehenetsia gorde da."

msgid "Your customized table has been reset."
msgstr "Zure pertsonalizatutako taula berriro ezarri da."

msgid "The default customized table has been reset."
msgstr "Taula pertsonalizatua lehenetsiaren egoerara berrezarri da."

msgid "lowercase letters, numbers, underscores, and dashes"
msgstr "minuskulak, zenbakiak, azpimarratuak eta marrak"

