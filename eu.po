msgstr "Eguneratu edukiaren sarbide baimenak"

msgid ""
"The @name config object does not contain any translatable values, so "
"it should not specify a language code."
msgstr ""
"@name konfigurazio objektuak ez du itzultzeko balio duten inolako "
"baliorik, beraz, ez du hizkuntza kodea zehaztu behar."

