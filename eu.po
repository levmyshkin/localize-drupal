msgstr "Eskualde batean oinarritutako kontaktu formulario baten erakustaldia."

msgid "Employee: Email"
msgstr "Langilea: Posta elektronikoa"

msgid "Demo: Region Contact: Employee"
msgstr "Demo: Eskualdea Harremana: Enplegatua"

msgid "Manager: Email"
msgstr "Kudeatzailea: Posta elektronikoa"

