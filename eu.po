msgstr "Desgaitu aukera/kutxatxoa"

msgid "Remove the option/checkbox"
msgstr "Aukera/hautazkoa kendu"

msgid ""
"This message is displayed when the remaining submission is greater "
"than one."
msgstr ""
"Mezu hau erakutsi egiten da gainerako aurkezpena bat baino handiagoa "
"denean."

msgid "One remaining message"
msgstr "Mezu bat geratzen da"

msgid ""
"This message is displayed when there is only one remaining submission "
"available."
msgstr ""
"Mezu hau bakarrik dagoenean agertzen da, aurkeztutako eskaera bat "
"soilik geratzen denean."

msgid "None remaining message"
msgstr "Ez dago mezu gehiagorik geratzen"

msgid "This message is displayed when there are remaining submissions allows."
msgstr "Mezu hau erakusten da oraindik uzten diren bidalketak daudenean."

msgid "This message is displayed when there are not submissions limits."
msgstr "Mezu hau ez da erakusten bidalketa mugak ez daudenean."

msgid ""
"The message is displayed when an element has validation error is "
"submitted."
msgstr ""
"Mezua elementu batek balidazio errorea duenean eta bidaltzen denean "
"agertzen da."

msgid "Define options or checkbox submission limits."
msgstr "Aukerak edo aukera-marka aurkezteko mugak definitu."

