msgstr "Moduluaren izena, deskribapena edo makinaren izenaren arabera iragazi"

msgid "Filter by module or permission"
msgstr "Modulu edo baimenaren arabera iragazi"

msgid "Enable filter on the permissions page"
msgstr "Baieztatu iragazkia baimen orrian"

msgid "Enable filters for use around the administration pages."
msgstr "Gaitu iragazkiak administrazio orrien inguruan erabiltzeko."

msgid "Enable the filter on the permissions page."
msgstr "Gaitu iragazkia baimen orrian."

msgid "Always show description details"
msgstr "Bet Always erakutsi deskribapenaren xehetasunak"

msgid "Always show the description details"
msgstr "Bet Always mostra ezazu deskribapenaren xehetasunak"

msgid "By default descriptions are hidden, this will always show them."
msgstr ""
"Lehenetsiz, deskribapenak ezkutatuta daude, honek beti erakutsiko "
"ditu."

msgid ""
"Allows a user to configure pathauto settings, configure patterns for "
"automated aliases, bulk update and delete URL-aliases."
msgstr ""
"Erabiltzaile bati aukera ematen dio pathauto ezarpenak konfiguratzeko, "
"alias automatizatuetarako ereduak konfiguratzeko, URL-aliasak masiboki "
"eguneratzeko eta ezabatzeko."

msgid "Bulk update aliases"
msgstr "Alias masiboak eguneratu"

msgid "Allows a user to bulk update aliases."
msgstr "Erabiltzaileari aliasak masiboki eguneratzeko aukera ematen dio."

msgid "Bulk delete aliases"
msgstr "Alias masiboki ezabatu"

msgid "Allows a user to bulk delete aliases."
msgstr "Erabiltzaile batek aliasak masiboki ezabatzeko aukera ematen du."

