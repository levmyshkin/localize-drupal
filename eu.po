msgstr ""
"Composer-ekin paketeen instalazio eta eguneratzeak prestatzeko "
"funtzionalitatea eskaintzen duen API modulu bat."

msgid "There is not enough disk space to create a stage directory."
msgstr "Ez dago disko espazio nahikorik etapa direktorio bat sortzeko."

msgid ""
"The stage directory has @stage_count instances of @stage_info_file as "
