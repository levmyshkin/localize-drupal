msgstr ""
"%current_display: %area eremuko esteka %linked_display bistaratzean "
"apuntatzen du, eta hori jada ez dago erabilgarri."

msgid ""
"%current_display: The link in the %area area points to the "
"%linked_display display which does not have a path."
msgstr ""
"%current_display: %area eremuko esteka %linked_display bistaratzean "
"doa, eta hark ez du biderik."

msgid ""
"The text to display for this field. You may enter data from this view "
"as per the \"Replacement patterns\" below. You may include <a "
"href=\"@twig_docs\">Twig</a> or the following allowed HTML tags: "
"<code>@tags</code>"
msgstr ""
"Eremu honetarako bistaratuko den testua. Ikuspegi honetatik datuak "
"sartu ditzakezu beheko \"Ordezko patroien\" arabera. <a "
"href=\"@twig_docs\">Twig</a> edo hurrengo onartutako HTML etiketak "
"barne hartu ditzakezu: <code>@tags</code>"

msgid ""
"The field that is going to be used as the OPML XML URL attribute for "
