msgstr ""
"Aktibo direktorioa ez dago PHP-TUFek babestuta, eta hori beharrezkoa "
"da Pakete Kudeatzailea modu seguruan erabiltzeko."

msgid "The <code>@plugin</code> plugin is not installed."
msgstr "<code>@plugin</code> plugina ez dago instalatuta."

msgid ""
"@message See <a href=\":url\">the help page</a> for more information "
"on how to install the plugin."
msgstr ""
"@message Ikusi <a href=\":url\">laguntza orria</a> plugin-a nola "
"instalatu jakiteko informazio gehiago."

msgid "The <code>@plugin</code> plugin is not listed as an allowed plugin."
msgstr ""
"<code>@plugin</code> plugin-a ez dago baimendutako pluginen artean "
"zerrendatuta."

msgid ""
"@message See <a href=\":url\">the help page</a> for more information "
