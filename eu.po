msgstr "Entitate erreferentzia hautapen kudeatzailearen ezarpenak"

msgid "Default selection handler settings"
msgstr "Hautapenaren kudeatzaile lehenetsien ezarpenak"

msgid "The field instance ID."
msgstr "Eremuaren instantzia IDa."

msgid "The field instance data."
msgstr "Eremuaren instantzia datuak."

msgid "The field type"
msgstr "Eremu mota"

msgid "The field definition."
msgstr "Eremuaren definizioa."

