"Defines if the relative path of each module will be display in its "
"row."
msgstr ""
"Modulu bakoitzaren bidean dagoen erlatiboa bere errondan erakutsiko "
"den zehazten du."

msgid ""
"Machine name: <span dir=\"ltr\" class=\"module-machine-name "
"table-filter-text-source\">@machine-name</span>"
msgstr ""
"Makina izena: <span dir=\"ltr\" class=\"module-machine-name "
"table-filter-text-source\">@machine-name</span>"

msgid "Module path: @module-list"
msgstr "Moduluaren bidea: @module-list"

msgid "Filter by project"
msgstr "Proiektuaren arabera iragazi"

msgid "Filter by module name or description"
msgstr "Iragazi moduluko izenaren edo deskribapenaren arabera"

msgid ""
"<strong>@module_name</strong> (<span "
"class=\"admin-missing\">missing</span>)"
msgstr ""
"<strong>@module_name</strong> (<span "
"class=\"admin-missing\">faltan</span>)"

