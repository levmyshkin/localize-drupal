"den ala ez kontrolatzeko."

msgid "The log entry explaining the changes in this revision."
msgstr "Aldaketa hauek azaltzen dituen berrikuspen honetako eguneratze-aldia."

msgid "At least one authentication provider must be defined for resource @id"
msgstr ""
"Gutxienez autentifikazio hornitzaile bat definitu behar da @id "
"baliabiderako"

msgid "At least one format must be defined for resource @id"
msgstr "Gutxienez formatu bat definitu behar da @id baliabiderako"

msgid "The ID of the shortcut."
msgstr "Laburpenaren ID-a."

msgid "The UUID of the shortcut."
msgstr "Teklatuaren UUID-a."

msgid "The bundle of the shortcut."
msgstr "Aitzakiaren multzoa."

msgid "Weight among shortcuts in the same shortcut set."
msgstr "Shortcut multzo berean dauden lasterbideen arteko pisua."

