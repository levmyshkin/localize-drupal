msgstr "مېدىيانى تېپىپ باشقۇرۇڭ."

msgid "Media thumbnail field display format settings"
msgstr ""
"Media نىڭ كىچىك كۆرۈنۈش (thumbnail) قۇرۇلما "
"كۆرسىتىش تەڭشەكلىرى"

msgid "Media source"
msgstr "سەنەد مەنبەسى"

