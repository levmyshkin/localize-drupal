msgstr ""
"كۆرسەتكۈچكە قوشۇلغۇدەك يېڭى XML ساتى "
"كارىنداشلىرى يوق."

msgid "Indexed @count new XML Sitemap links."
msgstr ""
"@count يېڭى XML Sitemap ئۇلانمىسى ئىندېكس "
"قىلىندى."

msgid "Sort order"
msgstr "تەرتىپ تەرتىپى"

msgid "Cocos (Keeling) Islands"
msgstr "Cocos (Keeling) Islands"

