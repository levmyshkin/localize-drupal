msgid "Provides a webform element for a selecting an image."
msgstr ""
"رەسىمنى تاللاش ئۈچۈن تور شەكىل "
"ئېلېمېنتى بىلەن تەمىنلەيدۇ."

msgid "Webforms: Images"
msgstr "Webforms: رەسىملەر"

