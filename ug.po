msgstr ""
"ئېكسپورتىدا سەل قارىلىدىغان "
"سەپلىمىلەر تىزىمى"

msgid "Settings for advanced ignoring"
msgstr ""
"ئالىي پەرقلەندۈرۈشنى كېڭەيتىپ سەل "
