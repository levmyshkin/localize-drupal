msgstr ""
"Clientsidе Validation module نى ئىشلەتكەندە Webform "
"Clientside Validation module نىڭ "
"ئورنىتىلغان-ئورنىتىلمىغانلىقىنى "
"تەكشۈرۈڭ"

msgid "Webform: Clientside validation"
msgstr ""
"Webform: خېرىدار تەرەپ دەلىللەش (Clientside "
"validation)"

