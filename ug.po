msgstr "Composer نىڭ يولى تەڭشەلدى"

msgid "jQuery UI Autocomplete"
msgstr "jQuery UI Автотولۇق (Autocomplete)"

msgid "Complete drag & drop"
msgstr "تولۇق سۆرەپ-تاشلاپ ئۇلاش"

msgid "Altered"
msgstr "ئۆزگەرتىلگەن"

