msgid "Check XSL functionality"
msgstr "XSL ئىقتىدارىنى تەكشۈرۈڭ"

msgid "Decide to prefetch aliases"
msgstr ""
"alias لارنى ئالدىن‌دىن پۈركۈلەشنى "
