msgstr "نامەلۇم ئىختىيارىي %name تەڭشەك(لەر)."

msgid "Debug: Settings: @title"
msgstr ""
"سازلاشتۇرۇش: @title نى تەڭشەشنى تۈزىتىش: "
"@title"

msgid ""
"Allows Webform settings to be overridden based on submission data, "
