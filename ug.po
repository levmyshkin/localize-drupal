msgstr "تورخەت (webform) سەپلىمەسىگە كىرىش"

msgid "This action will…"
msgstr "بۇ ھەرىكەت…"

msgid "Remove configuration"
msgstr "سەپلىمەلەرنى ئۆچۈرۈش"

