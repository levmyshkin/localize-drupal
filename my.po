msgstr "ပိတ်ထားသည်- %disabled"

msgid "Checking for available updates"
msgstr ""
"ရရှိနိုင်သော "
"အပ်ဒိတ်များကို "
"စစ်ဆေးနေခြင်း"

msgid "Update manager"
msgstr "အပ်ဒိတ်မန်နေဂျာ"

