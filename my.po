msgstr ""
"ဒရော့ပ်ဒေါင်း ခလုတ် (dropbutton) "
"ထဲတွင် အကွက်များကို "
"ပြသပါ။"

msgid "Rendered entity - @label"
msgstr "ပြန်ဆိုထားသော အရာ (entity) — @label"

