msgid "Generated 1 URL alias."
msgid_plural "Generated @count URL aliases."
msgstr[0] ""
"URL ပေါင်း ၁ ခု (alias) ကို "
"ဖန်တီးပြီးပါပြီ။"
msgstr[1] ""
"URL alias ပေါင်း @count ခုကို "
"ဖန်တီးပြီးပါပြီ။"

msgid "Update URL alias"
msgstr ""
"URL အလီယက်ကို "
"အပ်ဒိတ်လုပ်ပါ"

