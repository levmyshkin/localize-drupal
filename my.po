msgstr ""
"မလွယ်ကူမဟုတ်သော "
"အများအပြား "
"ဖောင်ဒြပ်စင်များကို "
"အဆင့်များစွာပါရှိသည့် "
"ဖောင်ဝစ်ဇာ (multi-step form wizard) "
"ထဲတွင် "
"စာမျက်နှာတစ်ခုအဖြစ် "
"ပြသရန်အတွက် ဒြပ်စင်တစ်ခု "
"ပေးထားသည်။"

msgid "_default"
msgstr "`_default`"

