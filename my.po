msgstr "အမည် / ဖော်ပြချက်"

msgid "Options (custom) properties"
msgstr ""
"ရွေးချယ်စရာများ "
"(စိတ်ကြိုက်) "
"ပိုင်ဆိုင်မှုများ"

msgid "Options properties"
msgstr ""
"ရွေးချယ်စရာများ၏ "
"ဂုဏ်သတ္တိများ"

