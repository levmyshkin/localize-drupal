msgstr "@title (တန်ဖိုး @number)"

msgid "1 error has been found: "
msgid_plural "@count errors have been found: "
msgstr[0] ""
"တွေ့ရှိထားသည့် အမှား ၁ "
"ခု-တွေ့ရှိထားသည့် အမှား "
"@count ခုရှိသည် -"

