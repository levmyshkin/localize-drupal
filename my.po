msgstr ""
"@label ကို "
"မော်ကွန်းတင်ထားသည်။"

msgid "@label is open"
msgstr "@label ကိုဖွင့်ထားသည်"

msgid "@label is closed"
msgstr "@label ပိတ်ထားပြီးပါသည်"

