msgid "Height settings"
msgstr "အမြင့် (Height) ဆက်တင်များ"

msgid "Height element type"
msgstr ""
"အမြင့် (Height) အစိတ်အပိုင်း "
"အမျိုးအစား"

msgid "Select menu with suffixes"
msgstr ""
"အဆုံးသတ်စာလုံးများ (suffixes) "
"ပါဝင်တဲ့ မီနူးကို "
"ရွေးချယ်ပါ"

