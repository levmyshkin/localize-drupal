msgstr ""
"အကယ်၍ အမှန်ခြစ်ထားပါက "
"ဝဘ်ဖောမ်အားလုံးတွင် "
"လိုအပ်သော "
"အစိတ်အပိုင်းများကို "
"ညွှန်ပြသည့် အညွှန်းကို "
"ထည့်သွင်းမည်ဖြစ်သည်။"

msgid "Default locked message"
msgstr ""
"မူလ "
"အလိုအလျောက်သော့ခတ်ထားသည့် "
"မက်ဆေ့ခ်ျ"

msgid "Default autofill message"
