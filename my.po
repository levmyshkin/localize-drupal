msgstr "ပုံ src… ကိုထည့်ပါ…"

msgid "more images"
msgstr "ပုံများထပ်ထည့်ရန်"

msgid "@count result for @label"
msgid_plural "@count results for @label"
msgstr[0] ""
"@label အတွက် ရလဒ်အရေအတွက်\n"
"@label "
"အတွက် ရလဒ်များ အရေအတွက်"

