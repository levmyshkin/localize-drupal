msgid "Dollar sign"
msgstr "ဒေါ်လာ သင်္ကေတ"

msgid "Number sign (pound sign, hash)"
msgstr ""
"နံပါတ်သင်္ကေတ "
"(ပေါင်သင်္ကေတ၊ "
"ဟက်ရှ်သင်္ကေတ)"

msgid "At sign"
msgstr "အက်စ်အင် ( @ )"

msgid "Exclamation mark"
msgstr "အာမေဍ္ဍအမှတ် (!)"

msgid "Tilde"
msgstr "တိုင်လ် (Tilde)"

