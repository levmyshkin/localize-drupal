msgstr "ထက်နည်း-သင်္ကေတ (`<`)"

msgid "Greater-than sign"
msgstr "ထက်ပိုကြီးသည့် လက္ခဏာ (>)"

msgid "Backslash"
msgstr ""
"Backslash ကို မြန်မာလို **Backslash** "
