"မမှန်ကန်သော "
"လက်မှတ်ဖိုင်ကို "
"တွေ့ရှိပြီး "
"ဖျက်ပစ်လိုက်ပါသည်။ (@see @url)"

msgid ""
"Invalid signature file detected and deleted. (@see <a "
"href=\":href\">PSA-XXXXX</a>)"
msgstr ""
"တွေ့ရှိထားသော "
"မမှန်ကန်သည့် "
"လက်မှတ်ဖိုင်ကို "
"စစ်ဆေးပြီး "
"ဖျက်ပစ်လိုက်ပါသည်။ (@see <a "
"href=\":href\">PSA-XXXXX</a>)"

