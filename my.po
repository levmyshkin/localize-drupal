msgstr "ညာဘက် အကွက်ကွင်း (right square bracket)"

msgid "Plus sign"
msgstr "အပြင်ဘက်ပိုင်း (Plus sign)"

msgid "Equal sign"
msgstr "ညီမျှသင်္ကေတ (=)"

msgid "Percent sign"
msgstr "ရာခိုင်နှုန်းသင်္ကေတ (%)"

msgid "Caret"
