msgstr ""
"ಮುದ್ರಿತ ವೆಬ್‌ಫಾರ್ಮ್ "
"ಸಲ್ಲಿಕೆಗಳ ಮೇಲ್ಭಾಗದಲ್ಲಿ "
"ಪ್ರದರ್ಶಿಸಲಾಗುವಂತೆ ಕಸ್ಟಮ್ "
"ಹೆಡರ್ ನಮೂದಿಸಿ."

msgid ""
"Enter custom header to be displayed above all printed webform "
"submissions."
msgstr ""
"ಮುದ್ರಿತ ವೆಬ್‌ಫಾರ್ಮ್ "
"ಸಲ್ಲಿಕೆಗಳ ಮೇಲ್ಭಾಗದಲ್ಲಿ "
"ಕಾಣಿಸುವ ಕಸ್ಟಮ್ ಹೆಡರ್ "
"ಅನ್ನು ನಮೂದಿಸಿ."

msgid "Enter custom footer to be displayed below printed webform submissions."
msgstr ""
"ಮುದ್ರಿತ ವೆಬ್‌ಫಾರ್ಮ್ "
"ಸಲ್ಲಿಕೆಗಳ ಕೆಳಗೆ "
"ಪ್ರದರ್ಶಿಸಲು ಕಸ್ಟಮ್ ಫೂಟರ್ "
"ಅನ್ನು ನಮೂದಿಸಿ."

msgid ""
"Enter custom footer to be displayed below all printed webform "
"submissions."
msgstr ""
"ಎಲ್ಲಾ ಮುದ್ರಿತ "
"ವೆಬ್‌ಫಾರ್ಮ್ ಸಲ್ಲಿಕೆಗಳ "
"ಕೆಳಗೆ ಪ್ರದರ್ಶಿಸಬೇಕಾದ "
"ಕಸ್ಟಮ್ ಫೂಟರ್ ಅನ್ನು "
"ನಮೂದಿಸಿ."

msgid "Enter custom print CSS to be attached to printed webform submissions."
msgstr ""
"ಮುದ್ರಿಸಿದ ವೆಬ್‌ಫಾರ್ಮ್ "
"ಸಲ್ಲಿಕೆಗಳಿಗೆ ಜೋಡಿಸಲು "
"ಕಸ್ಟಮ್ ಪ್ರಿಂಟ್ CSS ಅನ್ನು "
"ನಮೂದಿಸಿ."

msgid ""
"Enter custom print CSS to be attached to all printed webform "
"submissions."
msgstr ""
"ಎಲ್ಲಾ ಮುದ್ರಿತ "
"ವೆಬ್‌ಫಾರ್ಮ್ ಸಲ್ಲಿಕೆಗಳಿಗೆ "
"ಜೋಡಿಸಬೇಕಾದ ಕಸ್ಟಮ್ ಮುದ್ರಣ "
"CSS ಅನ್ನು ನಮೂದಿಸಿ."

msgid "@label link"
msgstr "@label ಲಿಂಕ್"

