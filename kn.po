msgstr "ಯಾವುದೇ ಪದವನ್ನು ಒಳಗೊಂಡಿದೆ"

msgid "has word"
msgstr ""
"„has word“ ನ ಕನ್ನಡ ಅನುವಾದ: "
"**„ಹುಟ್ಟುಹಾಕಿದೆ ಪದ“**"

msgid "Contains all words"
msgstr "ಎಲ್ಲಾ ಪದಗಳನ್ನು ಒಳಗೊಂಡಿದೆ"

