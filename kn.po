msgstr ""
"ವೆಬ್‌ಫಾರ್ಮ್ "
"ಸಲ್ಲಿಕೆಗಳನ್ನು PDFಗೆ "
"ಪರಿವರ್ತಿಸಲು ಅವಕಾಶ "
"ನೀಡುತ್ತದೆ"

