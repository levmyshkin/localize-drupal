msgstr "ಸೃಜಿಸು"

msgid "Advanced"
msgstr "ಸುಧಾರಿತ"

msgid "Ignore"
msgstr "ಉಪೇಕ್ಷಿಸು"

msgid "Simple"
msgstr "ಸರಳ"

msgid "Intermediate"
msgstr "ಮಧ್ಯಮ"

msgid "Config"
msgstr "ಕಾನ್ಫಿಗರೇಶನ್"

msgid "List"
msgstr "ಪಟ್ಟಿ"

msgid "View"
msgstr "ನೋಡು"

msgid "Active"
msgstr "ಸಕ್ರಿಯ"

msgid "New"
msgstr "ಹೊಸ"

msgid "Activate"
msgstr "ಸಕ್ರಿಯಗೊಳಿಸು"

msgid "Deactivate"
msgstr "ನಿಷ್ಕ್ರಿಯಗೊಳಿಸು"

msgid "Existing"
msgstr "ಇದೀಗಾಗಲೇ ಇರುವ"

msgid "Import all"
msgstr "ಎಲ್ಲವನ್ನೂ ಆಮದು ಮಾಡಿ"

