msgstr ""
"ಫೈಲ್ ಅಪ್‌ಲೋಡ್ ವಿಫಲವಾಗಿದೆ. "
"%upload"

msgid "URL to file"
msgstr "ಫೈಲ್‌ಗೆ URL"

msgid ""
"An unrecoverable error occurred. The uploaded file likely exceeded the "
