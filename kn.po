msgid "Font filepath"
msgstr "ಫಾಂಟ್ ಫೈಲ್‌ಪಾತ್"

msgid "Font Size in Image Captcha"
msgstr ""
"ಚಿತ್ರ ಕ್ಯಾಪ್ಚಾದಲ್ಲಿನ "
