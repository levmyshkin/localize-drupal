msgstr "ಬ್ಯಾಚ್ ಅಪ್‌ಡೇಟ್ ಗಾತ್ರ"

msgid "Batch delete size"
msgstr "ಬ್ಯಾಚ್ ಅಳಿಸುವ ಗಾತ್ರ"

