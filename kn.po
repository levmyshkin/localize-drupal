msgid "The first element of the array."
msgstr "ಅರೆ (array)ಯ ಮೊದಲ ಅಂಶ."

msgid "The last element of the array."
msgstr "ಅರೆ (array)ಯ ಕೊನೆಯ ಅಂಶ."

msgid "The number of elements in the array."
msgstr "ಅರೆದಲ್ಲಿರುವ ಅಂಶಗಳ ಸಂಖ್ಯೆ."

