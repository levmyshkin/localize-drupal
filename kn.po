msgstr ""
"@module ಮಾಡ್ಯೂಲ್ ಅನ್ನು "
"ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ"

msgid "View the administration theme"
msgstr ""
"ನಿರ್ವಹಣಾ ಥೀಮ್ ಅನ್ನು "
"ವೀಕ್ಷಿಸಿ"

msgid "Database system"
msgstr "ಡೇಟಾಬೇಸ್ ಸಿಸ್ಟಮ್"

msgid "Database system version"
msgstr ""
"ಡೇಟಾಬೇಸ್ ವ್ಯವಸ್ಥೆಯ "
"ಆವೃತ್ತಿ"

