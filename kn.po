msgid "Header options"
msgstr "ಶೀರ್ಷಿಕೆ ಆಯ್ಕೆಗಳು"

msgid "Download export file"
msgstr "ರಫ್ತು ಫೈಲ್ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ"

