msgstr "@size TB"

msgid "@size PB"
msgstr "@size ಪಿಬಿ"

msgid "@size EB"
msgstr "@size EB"

msgid "@size ZB"
msgstr "@size ZB"

msgid "@size YB"
msgstr "@size YB"

msgid "All messages"
msgstr "ಎಲ್ಲಾ ಸಂದೇಶಗಳು"

msgid "Serialized"
msgstr "ಸೀರಿಯಲೈಸ್ ಮಾಡಲಾಗಿದೆ"

msgid "« First"
msgstr "« ಮೊದಲ째"

msgid "Last »"
msgstr "ಕೊನೆಯದು »"

msgid "Discard changes"
msgstr "ಬದಲಾವಣೆಗಳನ್ನು ತ್ಯಜಿಸಿ"

