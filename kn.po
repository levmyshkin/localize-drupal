msgstr ""
"ಅನುಮತಿಸಿದ ಅಕ್ಷರಗಳನ್ನು "
"ಹೊಂದಿರುವ ಸ್ಟ್ರಿಂಗ್"

msgid "Captcha code length"
msgstr "ಕ್ಯಾಪ್ಚಾ ಕೋಡ್‌ನ ಉದ್ದ"

msgid "Right to left support"
msgstr "ಬಲದಿಂದ ಎಡಕ್ಕೆ (Right to Left) ಬೆಂಬಲ"

