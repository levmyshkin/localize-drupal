msgid "Options %label saved."
msgstr "ಆಯ್ಕೆಗಳ %label ಉಳಿಸಲಾಗಿದೆ."

msgid "Options @label have been reset."
msgstr ""
"@label ಗೆ ಸಂಬಂಧಿಸಿದ "
"ಆಯ್ಕೆಗಳನ್ನು "
"ಮರುಹೊಂದಿಸಲಾಗಿದೆ."

msgid "Options @label saved."
msgstr ""
"@label ಗೆ ಸಂಬಂಧಿಸಿದ ಆಯ್ಕೆಗಳು "
