"ನೆರವೇರಿಸಲು, ವಿತರಿಸಲು ಅಥವಾ "
"ಅದರ ಹೊಂದಾಣಿಕೆಯನ್ನು (coherence) "
"ಕಾಯ್ದುಕೊಳ್ಳಲು "
"ಅಗತ್ಯವಿರುವ, ಸಂಬಂಧಿತ "
"ಸಂಪನ್ಮೂಲ."

msgid "Rights Holder"
msgstr "ಹಕ್ಕು ಹೊಂದಿದವರು"

