msgid "File byte size"
msgstr "ಫೈಲ್ ಬೈಟ್ ಗಾತ್ರ"

msgid "The size of the file, in bytes."
msgstr "ಫೈಲ್‌ನ ಗಾತ್ರ, ಬೈಟ್‌ಗಳಲ್ಲಿ."

msgid "Query string value"
msgstr "ವಿಚಾರಣಾ ಸರಣಿಯ ಮೌಲ್ಯ"

