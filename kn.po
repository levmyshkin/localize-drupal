msgstr ""
"ಪಠ್ಯ (ಸ್ವರೂಪಿತ) "
"ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Text (formatted, long) settings"
msgstr ""
"ಪಠ್ಯ (ಸ್ವರೂಪಿತ, ದೀರ್ಘ) "
"ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "Text (formatted, long, with summary) settings"
msgstr ""
