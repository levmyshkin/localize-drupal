msgstr "ಪಠ್ಯದ ಫಾರ್ಮ್ಯಾಟ್‌ಗಳು"

msgid "Search page path"
msgstr "ಹುಡುಕಾಟ ಪುಟದ ಪಾಥ್"

msgid "Many to one"
msgstr "ಬಹಳಕ್ಕೂ ಒಂದು"

msgid "Save layout"
msgstr "ಲೇಔಟ್ ಅನ್ನು ಉಳಿಸಿ"

