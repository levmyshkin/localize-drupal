msgstr ""
"@uri ನಲ್ಲಿ ಅನುವಾದ ಫೈಲ್ ಅನ್ನು "
"ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು "
"ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "One translation files could not be checked. See the log for details."
msgid_plural ""
"@count translation files could not be checked. See the log for "
"details."
msgstr[0] ""
"ಒಂದು ಅನುವಾದ ಫೈಲ್‌ಗಳನ್ನು "
"ಪರಿಶೀಲಿಸಲು "
"ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. "
"ವಿವರಗಳಿಗಾಗಿ ಲಾಗ್ ನೋಡಿ."
msgstr[1] ""
"@count ಅನುವಾದ ಫೈಲ್‌ಗಳನ್ನು "
"ಪರಿಶೀಲಿಸಲು "
"ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. "
"ವಿವರಗಳಿಗಾಗಿ ಲಾಗ್ ನೋಡಿ."

msgid "Importing translation file: %filename (@percent%)."
msgstr ""
"ಅನುವಾದ ಫೈಲ್ ಅನ್ನು ಆಮದು "
"ಮಾಡಲಾಗುತ್ತಿದೆ: %filename (@percent%)."

