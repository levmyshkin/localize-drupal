"ಪ್ರಕಟಿಸಲಾಗಿಲ್ಲ)"

msgid "The comment author's name."
msgstr "ಕಾಮೆಂಟ್‌ ಬರಹಗಾರರ ಹೆಸರು."

msgid "Next steps"
msgstr "ಮುಂದಿನ ಹಂತಗಳು"

msgid "@driver_name settings"
msgstr "@driver_name ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "SQLite"
msgstr "SQLite"

msgid "Database file"
msgstr "ಡೇಟಾಬೇಸ್ ಫೈಲ್"

msgid ""
"The absolute path to the file where @drupal data will be stored. This "
"must be writable by the web server and should exist outside of the web "
"root."
msgstr ""
"@drupal ಡೇಟಾವನ್ನು "
"ಸಂಗ್ರಹಿಸಲಾಗುವ ಫೈಲ್‌ಗೆ "
"ಇರುವ ಸಂಪೂರ್ಣ (absolute) ಪಾತ್. ಇದು "
"ವೆಬ್ ಸರ್ವರ್‌ಗೆ ಬರೆಯಲು (writable) "
"ಸಾಧ್ಯವಾಗಿರಬೇಕು ಮತ್ತು "
"ವೆಬ್ ರೂಟ್ ಹೊರಗೆ "
"ಅಸ್ತಿತ್ವದಲ್ಲಿರಬೇಕು."

msgid "No fields are present yet."
msgstr ""
"ಇನ್ನೂ ಯಾವುದೇ ಫೀಲ್ಡ್‌ಗಳು "
"ಲಭ್ಯವಿಲ್ಲ."

msgctxt "Font weight"
msgid "Strong"
msgstr "ಬಲವಾದ"

