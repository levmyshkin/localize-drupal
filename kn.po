msgid "Label element"
msgstr "ಲೇಬಲ್ ಎಲಿಮೆಂಟ್"

msgid "Field group format:"
msgstr "ಫೀಲ್ಡ್ ಗುಂಪು ಸ್ವರೂಪ:"

msgid ""
"The css class must include only letters, numbers, underscores and "
"dashes."
msgstr ""
"CSS ಕ್ಲಾಸ್‌ನಲ್ಲಿ ಕೇವಲ "
"ಅಕ್ಷರಗಳು, ಸಂಖ್ಯೆಗಳು, "
