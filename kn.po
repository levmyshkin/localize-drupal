msgctxt "Validation"
msgid "Serialized"
msgstr "ಸೀರಿಯಲೈಸ್‌ಡ್"

msgid "This value should be a serialized object."
msgstr ""
"ಈ ಮೌಲ್ಯವು ಸರಳೀಕರಿಸಲಾದ "
"(serialized) ಆಬ್ಜೆಕ್ಟ್ ಆಗಿರಬೇಕು."

