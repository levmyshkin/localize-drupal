msgstr "ಆದ್ಯತೆಯ ಭಾಷೆ"

msgid "Number field"
msgstr "ಸಂಖ್ಯಾ ಫೀಲ್ಡ್"

msgid "Java"
msgstr "ಜಾವಾ"

msgid "Styles"
msgstr "ಶೈಲಿಗಳು"

msgid "Apply filters"
msgstr "ಫಿಲ್ಟರ್‌ಗಳನ್ನು ಅನ್ವಯಿಸಿ"

