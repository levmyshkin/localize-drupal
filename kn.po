msgstr "ಫೀಲ್ಡ್ ಇನ್‌ಸ್ಟೆನ್ಸ್ ಐಡಿ."

msgid "The field instance data."
msgstr "ಫೀಲ್ಡ್ ಇನ್‌ಸ್ಟಾನ್ಸ್ ಡೇಟಾ."

msgid "The field type"
msgstr "ಕ್ಷೇತ್ರದ ಪ್ರಕಾರ"

msgid "The field definition."
msgstr "ಫೀಲ್ಡ್‌ನ ವ್ಯಾಖ್ಯಾನ."

msgid "The formatter settings."
msgstr ""
