msgid "Current date"
msgstr "ಪ್ರಸ್ತುತ ದಿನಾಂಕ"

msgid "Current node's creation time"
msgstr "ಪ್ರಸ್ತುತ ನೋಡಿನ ರಚನೆಯ ಸಮಯ"

