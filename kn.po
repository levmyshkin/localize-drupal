msgstr "ಉಲ್ಲೇಖಿಸಲು ಐಟಂ‌ನ ಪ್ರಕಾರ"

msgid "Reference method"
msgstr "ಉಲ್ಲೇಖ ವಿಧಾನ"

msgid "@entity_type selection"
msgstr "@entity_type ಆಯ್ಕೆಯು"

msgid ""
"Select the method used to collect autocomplete suggestions. Note that "
"<em>Contains</em> can cause performance issues on sites with thousands "
"of entities."
msgstr ""
"ಆಟೋಕಂಪ್ಲೀಟ್ ಸೂಚನೆಗಳನ್ನು "
"ಸಂಗ್ರಹಿಸಲು ಬಳಸುವ "
"ವಿಧಾನವನ್ನು ಆಯ್ಕೆಮಾಡಿ. "
"ಸಾವಿರಾರು ಎಂಟಿಟಿಗಳನ್ನು "
"ಹೊಂದಿರುವ ಸೈಟ್‌ಗಳಲ್ಲಿ "
"<em>Contains</em> ಕಾರ್ಯಕ್ಷಮತೆಯ "
"ಸಮಸ್ಯೆಗಳನ್ನು "
"ಉಂಟುಮಾಡಬಹುದು ಎಂಬುದನ್ನು "
"ಗಮನಿಸಿ."

