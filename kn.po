msgstr ""
"ಅನುವಾದಗಳನ್ನು ಆಮದು "
"ಮಾಡಲಾಗಿದೆ."

msgid "Updating configuration translations"
msgstr ""
"ಕಾನ್ಫಿಗರೇಶನ್ "
"ಅನುವಾದಗಳನ್ನು "
"ನವೀಕರಿಸಲಾಗುತ್ತಿದೆ"

