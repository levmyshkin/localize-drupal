msgstr "-ಆಯ್ಕೆ-"

msgid ""
"Text to place as \"title\" text which most browsers display as a "
"tooltip when hovering over the link."
msgstr ""
"ಲಿಂಕ್ ಮೇಲೆ ಹೋವರಿಂಗ್ "
"ಮಾಡುವಾಗ ಹೆಚ್ಚಿನ "
