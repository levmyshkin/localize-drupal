msgstr ""
"<em>Manage</em> ಆಡಳಿತ ಮೆನುದಲ್ಲಿ, "
"<em>Structure</em> &gt; @structure_menu_link ಗೆ ಹೋಗಿ."

msgid ""
"In the <em>Manage</em> administration menu, navigate "
