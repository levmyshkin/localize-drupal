msgstr "ಫಾರ್ಮ್ ಮುಚ್ಚಲಾದ ಸಂದೇಶ"

msgid "Form exception message"
msgstr "ಫಾರ್ಮ್ ಅಪವಾದ ಸಂದೇಶ"

