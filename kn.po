msgid "Translation file location could not be determined."
msgstr ""
"ಅನುವಾದ ಫೈಲ್‌ನ ಸ್ಥಳವನ್ನು "
"ನಿರ್ಧರಿಸಲು "
"ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "no version"
msgstr "ಯಾವುದೇ ಆವೃತ್ತಿ ಇಲ್ಲ"

