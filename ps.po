"  '#questions':\n"
"    mastery: 'د دې موضوع "
"پوهه'\n"
"    presentation: 'د وړاندې کولو "
"مهارتونه'\n"
"    quality: 'د سلایډونو او بصري "
"مرستو کیفیت'\n"
"  '#answers': likert_quality\n"
"  "
"'#na_answer': true\n"
"  '#required': true\n"
"learn:\n"
"  '#type': "
"radios\n"
"  '#title': 'ایا په دې ناستې کې مو داسې "
