"استعمالولی شئ؟'\n"
"  '#options_display': side_by_side\n"
"  "
"'#options':\n"
"    'Yes': 'هو'\n"
"    'No': 'نه'\n"
"    N/A: N/A\n"
"  "
"'#required': true\n"
"comments:\n"
"  '#type': textarea\n"
"  '#title': "
"تبصرې\n"
