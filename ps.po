msgstr ""
"هغه سیمه چې بلاک په هغې کې ځای پر ځای "
"شوی دی."

msgid "Visibility expression."
msgstr "د لیدلو څرګندونه."

msgid "Pages list."
msgstr "د مخونو لېست"

msgid "Cache rule."
