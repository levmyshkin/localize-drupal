msgstr "د ډیټابېس اتصال د JSON ډول ملاتړ کوي."

msgid ""
"<a href=\"https://www.drupal.org/docs/system-requirements\">Database "
"connection does not support JSON.</a>"
msgstr ""
"<a href=\"https://www.drupal.org/docs/system-requirements\">د "
