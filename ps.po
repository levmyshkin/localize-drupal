"ټولیزه توګه څنګه وه؟'\n"
"  '#options_display': "
"side_by_side\n"
"  '#options': likert_quality\n"
"  '#required': "
"true\n"
"speaker:\n"
"  '#type': webform_likert\n"
"  '#title': "
"'مهرباني وکړئ د ویناوال د… درجه "
