msgstr "Arika webform"

msgid "Close webform"
msgstr "Funga webform"

msgid "Restore webform"
msgstr "Subiza webform"

msgid "Star/flag submission"
msgstr "Icyifuzo cyo kohereza inyenyeri/ibendera"

msgid ""
"%form: Email not sent for %handler handler because the <em>@type</em> "
