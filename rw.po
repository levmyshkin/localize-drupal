msgstr ""
"Iyi filter iragaragara. Niba uyihishe, abakoresha ntibazashobora "
"kuyihindura."

msgid "Hide filter"
msgstr "Hisha gushungura"

msgid "Expose operator"
msgstr "Fungura uyikoresha (operator)"

