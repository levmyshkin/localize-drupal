msgstr "Kuraho urufunguzo rwo kwemeza kuri state"

msgid "Generate verification key"
msgstr "Kubyara urufunguzo rwo kugenzura"

msgid "The IndexNow verification key is saved in <em>settings.php</em>: @key"
msgstr ""
"Urufunguzo rwo kugenzura rwa IndexNow rubikwa muri "
"<em>settings.php</em>: @key"

msgid ""
"The IndexNow verification key is defined in <em>Drupal state</em>: "
"@key"
msgstr ""
"Inyandiko yo kwemeza IndexNow isobanurwa muri <em>Drupal state</em>: "
"@key"

