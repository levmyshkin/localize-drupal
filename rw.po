msgstr "Itariki/igihe ntarengwa ntibishobora kurenza"

msgid "Specifies the minimum date/time."
msgstr "Igaragaza itariki/igihe ntarengwa."

msgid ""
"Accepts any date in any <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">GNU "
"Date/Time Input Format</a>. Strings such as today, +2 months, and Dec "
"9 2004 10:00 PM are all valid."
msgstr ""
"Byemera itariki iyo ari yo yose mu buryo ubwo ari bwo bwose <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">bwo "
"Kwakira Itariki n’Igihe bwa GNU</a>. Inyandiko nk’uri uyu munsi "
"(today), +2 months, na Dec 9 2004 10:00 PM zose ziremewe."

msgid "Date/time maximum"
msgstr "Igihe ntarengwa ntarengwa cyo gukoresha / igihe fatizo ntarengwa"

msgid "Specifies the maximum date/time."
msgstr "Igaragaza itariki/igihe ntarengwa."

msgid "Other maximum"
msgstr "Izindi ntarengwa zindi"

