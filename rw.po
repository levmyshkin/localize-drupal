msgid "Full data (unserialized)"
msgstr "Amakuru yose (adafunyitse)"

msgid "Full data (serialized)"
msgstr "Amakuru yose (yanditse mu buryo bwa serialization)"

msgid "A certain key"
msgstr "Igenzura runaka (canke: urufunguzo runaka)"

msgid "Which key should be displayed"
msgstr "Ni uruhe bintu nyamukuru kigomba kugaragazwa?"

msgid "You have to enter a key if you want to display a key of the data."
msgstr ""
"Ugomba kwinjiza urufunguzo niba ushaka kwerekana urufunguzo "
"rw’amakuru."

msgid "How many different units to display in the string."
msgstr ""
"Ni bangahe utunyonge tw’ibice bitandukanye ugomba kwerekana muri iyo "
"nteruro."

msgid "This filter is not exposed. Expose it to allow the users to change it."
msgstr ""
"Akayunguruzo ntikagaragajwe. Rigaragaze kugirango abakoresha babashe "
"kugihindura."

msgid "Expose filter"
msgstr "Garagaza kuyungurura"

