"permission callback."

msgid ""
"Upgrades to Drupal 10 are supported from Drupal 9.4.x and Drupal "
"9.5.x. It is suggested to update to the latest Drupal 9 version "
"available. <a href=\":platform\">Several hosting platform requirements "
"have been raised for Drupal 10</a>."
msgstr ""
"Kuvugurura kuri Drupal 10 birashyigikiwe kuva kuri Drupal 9.4.x na "
"Drupal 9.5.x. Birasabwa kuvugurura ukajya kuri verisiyo iheruka ya "
"Drupal 9 iboneka. <a href=\":platform\">Habayeho izindi bisabwa ku "
"bijyanye n’ibikorwa by’abatanga serivisi z’ubwakire (hosting) "
"kuri Drupal 10</a>."

msgid "Version @version."
msgstr "Icyiciro @version."

msgid "Version @current does not allow to upgrade and @new is available."
msgstr "Icyiciro @current nticyemerera kuvugurura kandi @new irahari."

msgid "Drupal core should be at least 9.4.x"
msgstr "Drupal core igomba kuba nibura 9.4.x"

msgid "Language:"
msgstr "Ururimi:"

