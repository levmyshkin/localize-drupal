msgstr ""
"Tanga ikimenyetso cyo guhindura (translation link) kuri "
"@entity_type_label."

msgid "Interface text language selected for page"
msgstr "Ururimi rw’inyandiko rwatoranyijwe kuri page"

msgid ""
