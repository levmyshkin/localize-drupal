msgstr "Urugero: Ikintu cya Webform"

msgid "An example of a custom Webform element."
msgstr "Urugero rw’ikintu gishya cya Webform."

msgid "Example: Webform Handler"
msgstr "Urugero: Ubufasha (Handler) bwa Webform"

msgid "An example of a custom Webform handler."
msgstr ""
"Urugero rw’umurebure (handler) rwa Webform rukoreshwa mu buryo "
"bwihariye."

msgid "Example: Remote post"
msgstr "Urugero: Kohereza kure"

msgid "An example of a webform submission posted to a remote server."
msgstr "Urugero rwo gutanga ifishi (webform) roherejwe kuri seriveri yo kure."

msgid "Example: Computed"
msgstr "Urugero: Byubazwe"

msgid "Examples of a computed elements."
msgstr "Ingero z’ibintu byibarirwaho (computed)."

msgid "Example: Computed Ajax"
