msgstr ""
"Kiibare niba byatoranyijwe, ibisubizo bizazamuka bikagaragara hejuru "
"y’urupapuro uko ukoresha agenda hasi uca mu bibazo."

msgid "Form access denied message attributes"
msgstr "Ubutumwa bwo kwanga kugerwa ku ifishi - ibiranga"

