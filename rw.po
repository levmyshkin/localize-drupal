"munsi ku gihe washyizeho."

msgid "Please select predefined options."
msgstr "Nyamuneka hitamo amahitamo asanzwe."

msgid "@title visible"
msgstr "@title iragaragara"

msgid "@title title display"
msgstr "@title kugaragaza umutwe title"

msgid "Remove whitespace around the"
msgstr "Kuraho umwanya udakenewe (whitespace) imbere no hanze y’aho"

msgid "computed value and between HTML tags"
msgstr "Agaciro kabazwe na hagati y’amatangazo ya HTML"

