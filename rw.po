msgstr "Umurebeshabikorwa wa URL y’urupapuro rw’umutungo muri menu"

msgid "Generates menu link URLs by overriding the 'entity' URL generator."
msgstr ""
"Bikora imiyoboro ya URL y’urutonde rwa menu hihindura (overriding) "
"umupanga wa URL w’“entity”."

msgid "Entity URL generator"
msgstr "Umutangabikorwa wa URL y’Ikintu"

msgid "Generates URLs for entity bundles and bundle overrides."
msgstr ""
"Byubaka ama URL y’imiterere (entity bundles) n’ibisimbura byayo "
"(bundle overrides)."

msgid "Add sitemap"
msgstr "Ongeraho sitemap"

msgid "Garbage collection in the simple_sitemap_views table"
msgstr ""
"Iseswa ry’imyanda (garbage collection) muri simple_sitemap_views "
"table"

