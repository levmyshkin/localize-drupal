msgstr "Koresha iyi sitemap mu gihe cyo kuyitangira (generation)."

msgid ""
"Do not index entities of type <em>@bundle</em> in sitemap "
"<em>@sitemap</em>"
msgstr ""
"Ntugaragaze (index) intego z'ubwoko <em>@bundle</em> muri sitemap "
"<em>@sitemap</em>"

