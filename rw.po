msgstr "Kuvugurura igenamiterere rya webform"

msgid "Repair configuration"
msgstr "Kugorora igenamiterere"

msgid "Date minimum"
msgstr "Itariki ntarengwa"

msgid "Date maximum"
msgstr "Itariki ntarengwa"

