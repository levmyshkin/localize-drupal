msgstr ""
"Habayeho ikosa ryo kwemeza (validating) ibice. Wenda uzakenera "
"guhindura <a href=\":href\">isoko rya YAML</a> kugira ngo ikibazo "
"gikemuke."

msgid "Leaving blank will use the default maxlength."
msgstr "Ugasize ubusa bizakoresha agaciro gasanzwe ka maxlength."

msgid "Leaving blank will use the default rows."
msgstr "Kusiga ubusa bizakoresha imirongo isanzwe."

