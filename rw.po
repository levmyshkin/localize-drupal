msgstr "Imbonerahamwe z’ibitumwa bya Webform zasunitse (zaciwe)."

msgid "The entered text appears before the progress bar."
msgstr ""
"Umwandiko wanditse ugaragara mbere y’aho igipimo cy’iterambere "
"gikorera."

