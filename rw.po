msgstr "Ibisobanuro by’umuyobozi/ibitekerezo"

msgid ""
"Admin notes/comments are display next to the element title in the form "
"builder and visible in the form's YAML source"
msgstr ""
"Aho bisobanuro/ibitekerezo by’Umuyobozi bishyirwa (admin "
"notes/comments) bigaragara iruhande rw’iry’umutwe w’iyo element "
"muri form builder kandi bigaragara mu iboneza rya form (YAML source)."

msgid "Webforms: @webforms"
msgstr "Formulari zo gukoresha urubuga: @webforms"

msgid "Next submission number disabled"
msgstr "Numero y’ubutumwa bukurikira bumaze guhagarikwa"

