msgstr ""
"Ntukore indekisi y’iyi <em>@bundle</em> muri sitemap "
"<em>@sitemap</em>"

msgid "Index this <em>@bundle</em> entity in sitemap <em>@sitemap</em>"
msgstr "Indekisha iyi <em>@bundle</em> ukoresho muri sitemap <em>@sitemap</em>"

msgid "Do not index entities of this type in sitemap <em>@sitemap</em>"
msgstr ""
"Ntukoreshe indangamanota (index) z’impinduka z’ubu bwoko muri "
"sitemap <em>@sitemap</em>"

msgid "Index entities of this type in sitemap <em>@sitemap</em>"
msgstr "Shyiramo indangamuntu z’ubu bwoko muri sitemap <em>@sitemap</em>"

