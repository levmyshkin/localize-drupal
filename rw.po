msgstr "Kohereza imodoka kuri page ikurikira iyo page irangiye"

msgid "Display show/hide all elements link"
msgstr "Garagaza in/ihishe byose bihuza ibintu (link)"

msgid "Default wizard show all elements label"
msgstr "Ubuyobozi busanzwe (wizard) bwerekana ibintu byose kurutonde."

msgid "Default wizard hide all elements label"
msgstr "Byihishe icyerekezo cyose bya wizard isanzwe (label)"

msgid "@start of @end"
msgstr "@end"

msgid "Current card"
msgstr "Ikadi iriho ubu"

msgid "The current card."
msgstr "Kaadi iriho ubu."

msgid "Do you want to convert this webform's wizard pages to cards?"
msgstr ""
"Urashaka guhindura impapuro zo kuri wizard z’iyi webform zigahinduka "
"amakarita?"

msgid "Form wizard/cards settings"
msgstr "Igenamiterere ry’umufasha w’ibice/utuzu (form wizard/cards)"

msgid "Default wizard/cards previous page button label"
msgstr "Aderesi y’inyuma ya wizard/cards ihindurwamo mbere label y’inyuma"

msgid "Default wizard/cards next page button label"
msgstr ""
"Uruhindu rw’imwe ya wizard/indanga zikorwa: izina ry’icyo buto "
"igira “urupapuro rukurikira”"

msgid "@index of @total"
msgstr "@index ya @total"

msgid ""
"Please note: More complex webform elements may still require "
"server-side validation."
msgstr ""
"Nyabuneka menya ko: Ibice (elements) by’ifishi y’urubuga (webform) "
"bikomeye kurushaho bishobora guhatirwa kwemezwa hakoreshejwe kugenzura "
"kuruhande rwa seriveri (server-side validation)."

msgid "The card's title HTML tag."
msgstr "Inyandiko y’umutwe (title) wa karadi HTML tag."

msgid "This is used for the Next Page button on the card."
msgstr "Ibi bikoreshwa kuri buto y’Urupapuro rukurikira ku ikarita."

msgid "This is used for the Previous button on the card."
msgstr "Ibi bikoreshwa ku buto “Mbere” buri kuri ka ka-karte."

msgid "Webform Clientside Validation"
msgstr "Kwemeza kurubuga kuruhande rw’umukiriya (Webform)"

msgid "Remove @item @number"
msgstr "Kuraho @item @number"

msgid "Display show/hide all wizard pages link"
msgstr "Kwerekana/guhisha iby’amapaji byose bya wizard ihuza"

msgid ""
"If checked, a hide/show all elements link will be added to this "
"webform when there are wizard pages."
msgstr ""
"Ki gisunitse, umuhuza wo kwihisha/kugaragaza ibintu byose uzongerwaho "
"kuri iyi form y’urubuga mu gihe haboneka impapuro zo mu buryo bwa "
"“wizard”."

msgid "Wizard show all elements label"
msgstr "Wizard yerekana ibintu byose ijambo ngira ngombwa"

msgid "@type option value"
msgstr "@type guhitamo agaciro"

