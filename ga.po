msgstr "Lipéad réamhshocraithe don chnaipe scriosta"

msgid ""
"Check if Webform Clientside Validation module is installed when using "
"the Clientside Validation module"
msgstr ""
"Seiceáil an bhfuil an modúl **Webform Clientside Validation** "
"suiteáilte nuair a úsáidtear an modúl **Clientside Validation**"

msgid "Webform: Clientside validation"
msgstr "Webform: Bailíochtú ar an gcliant"

