msgstr ""
"Is féidir leat míreanna meán a leabú (trí úsáid a bhaint as an "
"gclib <code>&lt;drupal-media&gt;</code>)."

msgid "Logs system events in the database."
msgstr "Logálann sé imeachtaí córais sa bhunachar sonraí."

msgid "Check <em>Make this the default form</em> and click <em>Save</em>."
msgstr ""
"Cuir tic leis an gcomhad <em>Make this the default form</em> agus "
