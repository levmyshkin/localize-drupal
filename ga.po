msgstr "Socruithe láimhseálaí roghnúcháin le haghaidh tagairtí aonáin"

msgid "Default selection handler settings"
msgstr "Socruithe réamhshocraithe do láimhseálaí na roghnaithe"

msgid "The field instance ID."
msgstr "Aitheantas na sampla réimse."

msgid "The field instance data."
msgstr "Sonraí an fhaisnéise réimse."

msgid "The field type"
msgstr "An cineál réimse"

msgid "The field definition."
msgstr "Sainmhíniú an réimse."

msgid "The formatter settings."
msgstr "Na socruithe formáidithe."

msgid "File selection handler settings"
msgstr "Socruithe láimhseálaí roghnúcháin comhaid"

msgid "Source module not found for @migration_id."
msgstr "Níor aimsíodh an modúl foinse do @migration_id."

msgid "Destination module not found for @migration_id."
msgstr "Níor aimsíodh an modúl scríbe do @migration_id."

