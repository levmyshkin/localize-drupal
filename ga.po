"The @name config object must specify a language code, because it "
"contains translatable values."
msgstr ""
"Ní mór don réad cumraíochta @name cód teanga a shonrú, toisc go "
"bhfuil luachanna aistrithe ann."

msgid "Edit @entity_label"
msgstr "Cuir in eagar @entity_label"

msgid "Edit @entity_bundle @entity_id"
msgstr "Cuir in eagar @entity_bundle @entity_id"

