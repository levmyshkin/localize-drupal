msgstr ""
"Roghnaigh na róil agus na húsáideoirí ar cheart dóibh a bheith in "
"ann an eilimint seo a fheiceáil agus aighneacht á féachaint."

msgid "Read the %label element's <a href=\":href\">API documentation</a>."
msgstr "Léigh <a href=\":href\">doiciméadú API</a> an eilimint %label."

