msgstr "An cód teanga don teachtaireacht."

msgid "The source language from which this translation was created."
msgstr "An teanga foinse as ar cruthaíodh an t-aistriúchán seo."

msgid "Translation outdated"
msgstr "Aistriúchán as dáta"

msgid "Translation author"
msgstr "Údar an aistriúcháin"

