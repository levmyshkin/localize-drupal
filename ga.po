msgid ""
"<strong>ATTENTION DEVELOPERS!!!</strong> The webform submission form's "
" BASE_FORM_ID and FORM_ID have changed."
msgstr ""
"<strong>AIRD AR FHEIDHMEANNACH A FORBAIRT!!!</strong> Tá athrú "
"tagtha ar **BASE_FORM_ID** agus ar **FORM_ID** sa fhoirm um chur "
"isteach Webform."

msgid ""
"Please make sure to update all webform related "
"<code>hook_form_BASE_FORM_ID_alter()</code> and "
"<code>hook_form_FORM_ID_alter()</code> hooks."
msgstr ""
"Bí cinnte gach ceann de na hooks a bhaineann le webform a nuashonrú, "
"go háirithe <code>hook_form_BASE_FORM_ID_alter()</code> agus "
"<code>hook_form_FORM_ID_alter()</code>."

