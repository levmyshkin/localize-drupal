msgstr ""
"Níor próiseáladh an eintiteas den chineál @type. Sainíonn sé na "
"patrúin seo a leanas: @patterns"

msgid ""
"Unrecognized entity bundle @entity:@bundle was not processed. It "
"defines the following patterns: @patterns"
msgstr ""
"Níor próiseáladh an bundle aonáin @entity:@bundle, mar ní "
"aithníodh é. Sainíonn sé na patrúin seo a leanas: @patterns"

msgid "Add Pathauto pattern"
msgstr "Cuir patrún Pathauto leis"

msgid "Pathauto pattern config"
msgstr "Cumraíocht phhatrún Pathauto"

msgid "Pathauto state"
msgstr "Stádas Pathauto"

