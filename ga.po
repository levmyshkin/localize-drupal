msgid "Webform Cards"
msgstr "Cártaí Foirme Gréasáin"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"Soláthraíonn sé eilimint coimeádáin “Cárta” le haghaidh "
"pagéiniú ilchéimeanna tapa ar an gcliant."

