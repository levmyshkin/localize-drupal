msgstr "Ychwanegu llwybrau byr at %shortcut_set"

msgid "Add to shortcuts"
msgstr "Ychwanegu at y llwybrau byr"

msgid "Remove from %shortcut_set shortcuts"
msgstr "Dileu o %shortcut_set lwybrau byr"

msgid "Remove from shortcuts"
msgstr "Tynnwch o’r llwybrau byr"

