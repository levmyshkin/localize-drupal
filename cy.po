msgstr ""
"Mae’r colofnau isod yn cael eu harddangos i ddefnyddwyr sy’n gallu "
"gweld cyflwyniadau blaenorol a/neu ddrafftiau sydd ar y gweill."

msgid "Select settings"
msgstr "Dewiswch y gosodiadau"

msgid "Default empty option optional"
msgstr "Opsiwn gwag diofyn, dewisol"

