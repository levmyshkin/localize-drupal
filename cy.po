msgstr ""
"%submission: Nid yw'r e-bost <b>wedi'i amserlennu</b> ar gyfer "
"%handler oherwydd nad yw %send yn ddyddiad/token dilys."

msgid ""
"%submission: Email <b>@action</b> by %handler handler to be sent on "
