msgstr "Galluogi’r ddewislen symudol ar bob lled (pant)."

msgid "Header site branding background color"
msgstr "Lliw cefndir brandio’r wefan yn yr adran pennawd"

msgid "Search by keyword or phrase."
msgstr "Chwiliwch yn ôl gair allweddol neu ymadrodd."

