msgstr "Statws y ffeil, dros dro (FALSE) a pharhaol (TRUE)."

msgid "Web page addresses and email addresses turn into links automatically."
msgstr ""
"Mae cyfeiriadau gwe’r dudalen a chyfeiriadau e-bost yn troi’n "
"ddolenni’n awtomatig."

msgid "Background color must be a hexadecimal color value."
msgstr "Rhaid i'r lliw cefndir fod yn werth lliw hecsadecimalaidd."

