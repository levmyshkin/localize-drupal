msgid "Handle plugin ID"
msgstr "プඡါイン አይዲ አስተናግድ (Handle plugin ID)"

msgid "Confirmation URL %url is not valid."
msgstr ""
"የማረጋገጫ ዩአርኤል %url ትክክል (valid) "
"አይደለም።"

msgid "@webform: Confirmation URL %url is not valid."
msgstr ""
"@webform: የማረጋገጫ ዩአርኤል %url ተቀባይነት "
"የለውም።"

msgid "Webform settings %label has been saved."
msgstr "የቅፅ መቼቶች %label ተቀምጠዋል።"

msgid "A tooltip displayed after the title."
msgstr ""
"ከርዕሱ በኋላ የሚታይ መጠቆሚያ ጠቃሚ "
"መረጃ።"

msgid "Unique message"
msgstr "ልዩ መልእክት"

msgid "@label: Image"
msgstr "@label: ምስል"

msgid "@label: Link"
msgstr "@label: አገናኝ"

msgid "@label: Modal"
msgstr "@label: ሞዳል"

msgid "Options single value format"
msgstr "አማራጮች ነጠላ ዋጋ ቅርጸት"

msgid "Options multiple values format"
msgstr "አማራጮች ብዙ እሴቶች ቅርጸት"

msgid ""
"Elements that collect a single option value include select menus, "
"radios, and buttons."
msgstr ""
"አንድ አማራጭ እሴት የሚሰበስቡ ክፍሎች "
"የመምረጫ ምናሌዎች፣ ራዲዮዎች እና "
"አዝራሮችን ያካትታሉ።"

msgid "Default sender email"
msgstr "የነባር ላኪ ኢሜይል"

msgid "Reviewing @count YAML configuration '@prefix.*' files in '@module'."
msgstr ""
"በ'@module' ውስጥ ያሉ የ'@prefix.*' YAML ውቅር "
"ፋይሎችን በመከለስ ላይ።"

msgid "Webform: External libraries"
msgstr "ዌብፎርም፡ ውጫዊ ቤተ-መጻሕፍት"

msgid "Jacob Rockowitz"
msgstr "ያዕቆብ ሮኮዊትስዝ"

msgid "Option description"
msgstr "የአማራጭ መግለጫ"

msgid "If unchecked, all warnings about missing libraries will be disabled."
msgstr ""
"ምልክቱ ካልተደረገ ሁሉም የሚያስጠነቅቁ "
"ስለሚጠፋ ቤተ መጽሐፍት ማስጠንቀቂያዎች "
"ተወግደዋል።"

msgid ""
"The default sender address for emailed webform results; often the "
"email address of the maintainer of your forms. The person or agent "
"submitting the message to the network, if other than shown by the From "
"header"
msgstr ""
"የኢሜይል ዌብፎርም ውጤቶች ነባር ላኪ "
"አድራሻ; ብዙ ጊዜ የፎርሞችዎ "
"አስተዳዳሪ/አባል የኢሜይል አድራሻ "
"ይሆናል። መልዕክቱን ወደ ኔትወርኩ "
"የሚያቀርበው ሰው ወይም ወኪል፣ በከ “From” "
"ራስጌ የተ göstər ካልሆነ በስተቀር።"

msgid "Unique per entity"
msgstr "ከአካል አንድ በአንድ ልዩ (Unique per entity)"

msgid "Unique per user"
msgstr ""
"በአንድ ተጠቃሚ ላይ ብቻ ልዩ (ልዩ በአንድ "
"ተጠቃሚ)"

msgid "Options description display"
msgstr "የአማራጮች መግለጫ ማሳያ"

msgid "None -- Message state is never stored."
msgstr ""
"هیڅም — መልእክት ሁኔታው በፍጹም "
"አይከማችም።"

msgid "Session storage -- Message state is reset after the browser is closed."
msgstr ""
"ሰеッション ማከማቻ — የመልዕክት ሁኔታው "
"አሳሹ ከተዘጋ በኋላ ዳግም ይጀምራል።"

msgid "Local storage -- Message state persists after the browser is closed."
msgstr ""
"የአካባቢ ማከማቻ — መልዕክት ሁኔታው "
"አሳሹ ከተዘጋ በኋላም ይቀጥላል።"

msgid ""
"User data -- Message state is saved to the current user's data. "
"(Applies to authenticated users only)"
msgstr ""
"የተጠቃሚ መረጃ — መልዕክት ሁኔታው ወደ "
"አሁኑ ተጠቃሚ ውሂብ ውስጥ ይቀመጣል። "
"(ለማረጋገጡ ተጠቃሚዎች ብቻ ይሠራል)"

msgid ""
"State API -- Message state is saved to the site's system state. "
"(Applies to authenticated users only)"
msgstr ""
"የመንግስት ኤፒአይ (State API) — መልዕክቱ "
"ሁኔታ (message state) የጣቢያው የስርዓት ሁኔታ "
"(system state) ውስጥ ይቀመጣል። (ለማረጋገጡ "
"ተጠቃሚዎች ብቻ ይሠራል)"

msgid ""
"The email address submitting the message, if other than shown by the "
"From header"
msgstr ""
"መልዕክቱን የሚልክበት ኢሜይል አድራሻ፣ "
"ከከጀር ራስጌ (From header) የሚታየው ካልሆነ "
"በስተቀር"

msgid "Webforms: Forms configuration"
msgstr "የዌብፎርሞች (Webforms): የፎርሞች ውቅር"

msgid "Webforms: Elements configuration"
msgstr "የድር ቅጾች፦ አካላት ውቅር"

msgid "Webforms: Submissions configuration"
msgstr "የዌብፎርሞች፦ የአቤቱታ (submissions) ማዋቀር"

msgid "Webforms: Handlers configuration"
msgstr "የድር ቅጾች (Webforms): አስተናጋጆች ማዋቀር"

msgid "Webforms: Exporters configuration"
msgstr "የድልፎርምስ (Webforms): ኤክስፖርተሮች ውቅር"

msgid "Webforms: Libraries configuration"
msgstr "ዌብፎርሞች፡ ቤተ-መጻሕፍት ውቅር"

msgid "Webforms: Advanced configuration"
msgstr "የድር ቅጾች (Webforms): የላቀ ቅንብሮች"

msgid "Webforms: Submissions purge"
msgstr "ዌብፎርምስ፦ የቅርቦት መጥፊያ"

msgid "Batch email size"
msgstr "Batch email size የባች ኢሜይል መጠን"

msgid "Display element description as help text (tooltip)"
msgstr ""
"ဒေတን መግለጫውን እንደ መርዳት ጽሑፍ "
"(መጠቆሚያ) አሳይ"

msgid "Check if CDN is being used for external libraries"
msgstr ""
"የውጭ ቤተ-መጽሐፍት (external libraries) ለCDN "
"እየተጠቀሙ መሆኑን ያረጋግጡ"

msgid ""
"Check if Webform Bootstrap Integration module is installed when using "
"the Bootstrap theme"
msgstr ""
"Bootstrap theme ን ሲጠቀሙ Webform Bootstrap Integration "
"ሞጁሉ ተጭኗል መሆኑን ያረጋግጡ"

msgid "Check if SPAM protection module is installed"
msgstr "SPAM መከላከያ ሞጁሉ ተጭኖ መሆኑን ይፈትሹ"

msgid "Ajax scroll top"
msgstr "Ajax ጣሪያ ወደ ላይ (Scroll to top)"

msgid "Allow users to save multiple drafts"
msgstr ""
"ተጠቃሚዎች ብዙ ረቂቆችን እንዲያስቀምጡ "
"ፍቀድ።"

msgid ""
"Unable to find '@target' module (config/install), config directory "
"(sync), or path (/some/path/)."
msgstr ""
"‘@target’ ሞጁሉን አልተገኘም (config/install), የ "
"config ነጠብጣብ መዝገብ (sync)، ወይም መንገድ "
"(/some/path/)."

msgid "Update default value"
msgstr "ነባር እሴት ያዘምኑ"

msgid "Webform Nodes"
msgstr "ዌብ፫ርም ኖዶች (Webform Nodes)"

msgid "Introduction to Webform for Drupal 8"
msgstr "የDrupal 8 ለ Webform መግቢያ"

msgid "About Webform & the Drupal community"
msgstr ""
"የዌብፎርም (Webform) እና የድሩፓል (Drupal) "
"ማህበረሰብ ስለ"

msgid "Building forms & templates"
msgstr "ቅጾችን እና ቴምፕሌቶችን መገንባት"

msgid "Adding elements to a webform"
msgstr ""
"የድረ-ገጽ ፎርም (webform) ውስጥ አካላት "
"መጨመር"

msgid "Configuring webform settings"
msgstr "የድር ቅጽ (Webform) መቼቶችን በማዋቀር ላይ"

msgid "Configuring the Webform module"
msgstr "የWebform ሞጁሉን ማዋቀር"

msgid "Understanding webform plugins"
msgstr "የዌብፎርም ፕላጊኖችን መረዳት"

msgid "Translating webforms"
msgstr "የዌብፎርሞች ትርጉም"

msgid "Webform development tools"
msgstr "የዌብፎርም ልማት መሳሪያዎች"

msgid "Configuration: Forms"
msgstr "ማዋቀር፦ ቅጾች"

msgid ""
"The Webform module utilizes third-party Open Source libraries to "
"enhance webform elements and to provide additional functionality."
msgstr ""
"የዌብፎርም (Webform) ሞጁል የዌብፎርም "
"ክፍሎችን ለማሻሻል እና ተጨማሪ ተግባራትን "
"ለመስጠት የሦስተኛ ወገን ነፃ ክፍት-ምንጭ "
"ቤተ-መጻሕፍትን (Open Source libraries) ይጠቀማል።"

msgid ""
"If these libraries are not installed, they will be automatically "
"loaded from a CDN."
msgstr ""
"እነዚህ ቤተ-መጽሐፍት ካልተገጠሙ (installed)፣ "
"በራስ-ሰር ከ CDN ተጭነው ይጫናሉ።"

msgid "Plugins: Elements"
msgstr "Plugins: አካሎች"

msgid "Webform: Source"
msgstr "ዌብፎርም፡ ምንጭ"

msgid "Webform: Test"
msgstr "ዌብፎርም፡ ሙከራ"

msgid "Webform: API"
msgstr "Webform፡ ኤፒአይ"

msgid "Webform: Translate"
msgstr "ዌብፎርም፡ ትርጉም"

msgid ""
"The <strong>Form</strong> settings page allows a webform's status, "
"attributes, behaviors, labels, messages, wizard settings and preview "
"to be customized."
msgstr ""
"የ<strong>ቅጽ</strong> መቼቶች ገጹ የዌብፎርም "
"ሁኔታ፣ ባህሪዎች፣ ባህሪይ (behaviors)፣ "
"መለያዎች (labels)፣ መልዕክቶች (messages)፣ "
"የዊዛርድ መቼቶች እና ቅድም እይታ (preview) "
"እንዲተካ ያስችላል።"

msgid ""
"The <strong>Submissions</strong> page displays a customizable overview "
"of a webform's submissions."
msgstr ""
"የ<strong>ඉቀርቦች</strong> ገጹ የድር ፎርም "
"እውነተኛ እቀርቦችን የሚያሳይ ተለዋዋጭ "
"(customizable) አጠቃላይ እይታን ያሳያል።"

msgid "Submissions can be reviewed, updated, flagged and/or annotated."
msgstr ""
"ඉදිරිපත් කිරීම් "
"መពិនិតුරු කරලා, "
"යාවත්කාලීන කරලා, සලකුණු (flag) "
"කළා සහ/හෝ අදහස් (annotations) එක් කළ "
"හැක."

msgid ""
"The <strong>Download</strong> page allows a webform's submissions to "
"be exported into a customizable CSV (Comma Separated Values) file and "
"other common data formats."
msgstr ""
"የ<strong>Download</strong> ገጹ የድር ፎርም (webform) "
"የገቢዎችን ወደ ሊበጅ የሚችል የCSV (Comma "
"Separated Values) ፋይል እና ሌሎች የተለመዱ "
"የውሂብ ቅርጸቶች መላክ/መውጣት ይፈቅዳል።"

msgid ""
"The <strong>View</strong> page displays a submission's general "
"information and data."
msgstr ""
"<strong>View</strong> ስаҳኑ የእባኤውን (submission) "
"አጠቃላይ መረጃ እና ውሂብ ያሳያል።"

msgid "Submission: Table"
msgstr "አቅርቦት፦ ሰንጠረዥ"

msgid ""
"The <strong>Table</strong> page displays a submission's general "
"information and data using tabular layout."
msgstr ""
"የ<strong>ሰንጠረዥ</strong> ገጹ በሰንጠረዥ "
"እቅድ አቀማመጥ ውስጥ የአንድ ማስገባት "
"አጠቃላይ መረጃ እና ውሂብን ያሳያል።"

msgid "Submission: Plain text"
msgstr "ግቤት፦ ግልጽ ጽሑፍ"

msgid ""
"The <strong>Plain text</strong> page displays a submission's general "
"information and data as plain text."
msgstr ""
"የ <strong>ቀላል ጽሑፍ</strong> ገጹ የአቅርቦቱን "
"አጠቃላይ መረጃ እና ውሂብ እንደ ቀላል "
"ጽሑፍ ያሳያል።"

msgid "Submission: Data (YAML)"
msgstr "ቅርብ ማስገባት፦ ውሂብ (YAML)"

msgid "Submission: Edit All"
msgstr "የግብዓት ማስገቢያ፦ ሁሉንም አስተካክል"

msgid ""
"The <strong>Resend</strong> form allows administrator to preview and "
"resend emails and messages."
msgstr ""
"የ<strong>Resend</strong> ፎርሙ አስተዳዳሪዎች "
"ኢሜይሎችን እና መልዕክቶችን ቅድመ እይታ "
"በማድረግ እንደገና እንዲልኩ ያስችላል።"

msgid ""
"The <strong>Submissions</strong> page displays a customizable overview "
"of a webform node's submissions."
msgstr ""
"<strong>උප提交</strong>  පිටුව  "
"වෙබ්ෆෝම් නෝඩ් එකක උප提交 "
"(submissions) සඳහා අභිරුචිකරණය කළ "
"හැකි දර්ශනයක් (overview) "
"පෙන්වයි."

msgid ""
"Only webform administrators are allowed to access this page and create "
"new submissions."
msgstr ""
"የዌብፎርም (Webform) አስተዳዳሪዎች ብቻ "
"ወደዚህ ገጽ መግባት እና አዲስ ማስገባቶች "
"(submissions) መፍጠር ይችላሉ።"

msgid "The delimiter used when an element has multiple values."
msgstr ""
"አንድ አካል ብዙ እሴቶች ሲኖረው "
"የሚጠቀሙት መለያያ (ዴሊሚተር)።"

msgid ""
"Include an element's title with all sub elements and values in each "
"column header"
msgstr ""
"በእያንዳንዱ የአምድ ራስጌ ውስጥ በሁሉም "
"ንኡስ አካሎቹ እና እሴቶቹ ጋር የአካሉን "
"ርዕስ ያካትቱ።"

msgid ""
"Message (reloads the current page/form and displays the confirmation "
"message at the top of the page)"
msgstr ""
"መልዕክት (የአሁኑን ገጽ/ቅጽ እንደገና "
"ይጫናል እና የማረጋገጫ መልዕክቱን በገጹ "
"ላይ ከላይ ያሳያል)"

msgid ""
"URL with message (redirects to a custom path or URL and displays the "
"confirmation message at the top of the page)"
msgstr ""
"پیغام ያለበት ዩአርኤል (ወደ ብጁ መንገድ "
"ወይም ዩአርኤል ይመራል እና የማረጋገጫ "
"መልእክቱን በገጹ ላይ ከላይ ያሳያል)"

msgid "Autofocus the first element"
msgstr "የመጀመሪያውን እቃ በራስ-ማተኮር ያድርጉ"

msgid ""
"If checked, the first visible and enabled form element will be focused "
"when adding a new submission."
msgstr ""
"ከተሰለጠ ማለት በአዲስ ማስገባት ጊዜ "
"በመጀመሪያ የሚታይ እና የተነቃ የፎርም "
"ክፍል ወደ ላይ ይመረጣል (focus)።"

msgid "Allow source entity to be populated using query string parameters"
msgstr ""
"ምንጭ አካል (source entity) በጥያቄ ሕብረ-መረጃ "
"መለኪያዎች (query string parameters) እንዲሞላ "
"ፍቀድ።"

msgid "Require source entity to be populated using query string parameters"
msgstr ""
"የምንጭ አካል (source entity) በዱኩመንት ጥያቄ "
"መለኪያዎች (query string parameters) ተጠቅሞ መሙላት "
"ይፈልጋል።"

msgid "The title displayed on the preview page."
msgstr "በቅንብር ገጹ ላይ የሚታየው ርዕስ።"

msgid "Allow this webform to be used as a template"
msgstr ""
"මෙህ ዌብፎርም እንደ ናሙና (template) "
"እንዲጠቀም ይፍቀዱ"

msgid "Disable saving of submissions"
msgstr "የአቅርቦቶችን ማስቀመጥ አቦዝን"

msgid "Allow users to post submissions from a dedicated URL"
msgstr ""
"ተጠቃሚዎች የተወሰነ ዩአርኤል በመጠቀም "
"ማስገባቶችን እንዲለጥፉ ፍቀድ።"

msgid ""
"Any user who can update this webform will still be able to <a "
"href=\":view_href\">view</a> and <a href=\":test_href\">test</a> this "
"webform with the administrative theme."
msgstr ""
"ይህን ዌብፎርም ማዘመን የሚችል ማንኛውም "
"ተጠቃሚ በአስተዳደራዊ ገጽታው (administrative "
"theme) እስከሚቻል ድረስ ይህን ዌብፎርም በ<a "
"href=\":view_href\">ማየት</a> እና <a "
"href=\":test_href\">መሞከር</a> ይችላል።"

msgid ""
"Select where the page should be scrolled to when paging, saving of "
"drafts, previews, submissions, and confirmations. Select 'None' to "
"disable scrolling."
msgstr ""
"“පිටුව” පිටු පෙරළීම (paging), "
"කෙටුම්පත් සුරැකීම, "
"පෙරදසුන් (previews), ඉදිරිපත් "
"කිරීම් (submissions) සහ තහවුරු "
"කිරීම් (confirmations) කරන විට පිටුව "
"කොතැනට ස්ක්‍රෝල් විය "
"යුතුද තෝරන්න. “කිසිවක් (None)” "
"තෝරන්නේ නම් ස්ක්‍රෝල "
"කිරීම අක්‍රීය කෙරේ."

msgctxt "Sort by {sort} in {direction} order"
msgid "in"
msgstr "ውስጥ"

msgctxt "Sort by {sort} in {direction} order"
msgid "order"
msgstr "ትዕዛዝ"

msgctxt "Show {limit} results per page"
msgid "Show"
msgstr "አሳይ"

msgid ""
"If checked, all element descriptions will be moved to help text "
"(tooltip)."
msgstr ""
"ከተምረጡ (checked) ሁሉም የኤለመንት "
"መግለጫዎች ወደ የمدግዳት ጽሑፍ (tooltip) "
"ይዛወራሉ።"

msgid ""
"Text that will be shown when empty elements are included in submission "
"previews and/or emails"
msgstr ""
"የባዶ (empty) ኤለመንቶች ወደ ማስገቢያ "
"ቅድመ-እይታዎች እና/ወይም ኢሜይሎች "
"ሲካተቱ ሲታይ የሚታይ ጽሑፍ"

msgid "Default more label"
msgstr "የነባር “ተጨማሪ” መለያ"

msgid "Header 1 (h1)"
msgstr "ራስጌ 1 (h1)"

msgid "Header 2 (h2)"
msgstr "ርዕስ 2 (h2)"

msgid "Header 3 (h3)"
msgstr "ራስ 3 (h3)"

msgid "Header 4 (h4)"
msgstr "ራስ 4 (h4)"

msgid "Header 5 (h5)"
msgstr "የራስጥል 5 (h5)"

msgid "Header 6 (h6)"
msgstr "ራስጌ 6 (h6)"

msgid "Label (label)"
msgstr "መለያ (መለያ)"

msgid ""
"If checked, the first default option for a select menu will always be "
"displayed."
msgstr ""
"ከተፈቀደ/ከተሰማማ እንደሆነ፣ የመደበኛ "
"(default) የመጀመሪያ ምርጫ ሁልጊዜ በመምረጫ "
"ሜኑ (select menu) ላይ ይታያል።"

msgid "Allow files to be uploaded to public file system"
msgstr ""
"ፋይሎች ወደ ይፋዊ የፋይል ስርዓት "
"እንዲያስገቡ (እንዲጫኑ) ፍቀድ።"

msgid ""
"Allowing public file uploads is dangerous for webforms that are "
"available to anonymous and/or untrusted users."
msgstr ""
"የሕዝብ ፋይል ማንሳት (public file uploads) "
"በማይታወቁ እና/ወይም በአያስተማማኙ "
"ተጠቃሚዎች ሊደረሱ የሚችሉ የድረ-ገጽ "
"ፎርሞች (webforms) ላይ ሲፈቀድ አደገኛ ነው።"

msgid ""
"If checked, users will not be allowed to navigate back to the webform "
"using the browser's back button."
msgstr ""
"ከተመረጠ (checked)፣ ተጠቃሚዎች የአሳሹ (browser) "
"የመመለሻ (back) አዝራርን ተጠቅመው ወደ "
"ዌብፎርሙ መመለስ አይፈቀዳቸውም።"

msgid ""
"Leave blank to not automatically include a preview message on all "
"forms."
msgstr ""
"ባዶ ይተዉ የሁሉንም ፎርሞች ላይ በራስ ሰር "
"የቅድመ እይታ መልእክት እንዳይካተት።"

msgid "Log all submission events for all webforms"
msgstr ""
"ሁሉንም ዌብፎርሞች ለሚደረጉ ማስገባቶች "
"ሁሉንም ክስተቶች መመዝገብ"

msgid "Element contains ignored/unsupported properties: @properties"
msgstr ""
"አካሉ የተተዉ/የማይደገፉ ባህሪያትን "
"ይዟል፦ @properties"

msgid "Current webform"
msgstr "የአሁኑ የዌብፎርም"

msgid "Question description"
msgstr "የጥያቄ መግለጫ"

msgid "Compact, with the option values delimited by commas in one column."
msgstr ""
"አጠር ያለ፣ እና አማራጭ እሴቶቹ በኮማ (፣) "
"ተለይተው በአንድ አምድ ውስጥ እንዲገለጹ "
"የሚኖረው አማራጭ።"

msgid "Separate, with each possible option value in its own column."
msgstr ""
"እያንዳንዱ የሚቻል እሴት አማራጭ በየራሱ "
"አምድ ውስጥ ተቀምጦ ተለይ።"

msgid "HTML (CSS & JavaScript)"
msgstr "HTML (CSS እና JavaScript)"

msgid "The type of element to be displayed."
msgstr "የሚታየው አካል (element) ዓይነት።"

msgid "Please select predefined options or enter custom options."
msgstr ""
"ദയവായി የተቀየሩ አማራጮችን ይምረጡ "
"ወይም የተበጀ አማራጮችን ያስገቡ።"

msgid "Custom Properties"
msgstr "ብጁ (Custom) ባህሪያት"

msgid "Options for %title is required."
msgstr "የ%title አማራጮች ያስፈልጋሉ።"

msgid "ID, an entity's unique identified"
msgstr ""
"ID፣ አካል (entity) ልዩ መለያ የሆነ ልዩ "
"መታወቂያ"

msgid "Title, an entity's title/label"
msgstr ""
"ርእስ፣ የአካል (entity) ርእስ/መለያ መግለጫ "
"(label)"

msgid "URL, an entity's URL"
msgstr "URL፣ የአንድ አካል (entity) የዩአርኤል አድራሻ"

msgid "Replace file upload input with an upload button"
msgstr ""
"የፋይል ማስጫኛ መግቢያውን በማስጫኛ "
"አዝራር ይተኩ።"

msgid "Allow users to close the message"
msgstr ""
"အသုံးပြန်သူများအား "
"መልእክቱን እንዲዘጉ ፍቀድ"

msgid "Display term hierarchy using breadcrumbs"
msgstr ""
"Breadcrumbs ን በመጠቀም የቃላት አወቃቀር ቅደም "
"ተከተል (hierarchy) አሳይ"

msgid "Used to create unique file names for exported submissions."
msgstr ""
"ለተወጡ ስርዓተ-መረጃዎች ልዩ የፋይል "
"ስሞች ለመፍጠር ይጠቅማል።"

msgid ""
"The full URL to POST to when an existing webform submission is @state. "
"(e.g. @url)"
msgstr ""
"مौजूው የዌብፎርም ምዝገባ በ@state ሲሆን "
"ለመላክ (POST) የሚያስፈልገው ሙሉው URL። "
"(ለምሳሌ፣ @url)"

msgid ""
"Response data can be passed to the submission data using "
"[webform:handler:{machine_name}:{state}:{key}] tokens. (i.e. "
"[webform:handler:remote_post:completed:confirmation_number])"
msgstr ""
"ምላሽ (response) ውሂብን ወደ ማስገቢያ (submission) "
"ውሂብ ለማስተላለፍ በ "
"[webform:handler:{machine_name}:{state}:{key}] ቶከኖች "
"ማጠቀም ይቻላል። (ማለትም "
"[webform:handler:remote_post:completed:confirmation_number])"

msgid ""
"The <b>POST</b> request method requests that a web server accept the "
"data enclosed in the body of the request message. It is often used "
"when uploading a file or when submitting a completed webform. In "
"contrast, the HTTP <b>GET</b> request method retrieves information "
"from the server."
msgstr ""
"የ<b>POST</b> ጥያቄ (request) ዘዴ የድር አገልጋይ "
"(web server) በጥያቄው መልእክት ውስጥ በሚገኘው "
"(body) ክፍል የተካተተውን ውሂብ እንዲቀበል "
"ይጠይቃል። ብዙ ጊዜ ፋይል ሲጫን (upload) "
"ወይም የተጠናቀቀ የዌብፎርም (webform) ሲልክ "
"ይጠቅማል። በተቃራኒው፣ የHTTP <b>GET</b> ጥያቄ "
"ዘዴ ከአገልጋዩ ላይ መረጃ (information) "
"ያገኛል።"

msgid "Request options"
msgstr "የጥያቄ አማራጮች"

msgid "Response data:"
msgstr "የምላሽ ውሂብ፦"

msgid ""
"Custom composite sub elements do not support elements with multiple "
"values."
msgstr ""
"ብጁ የተዋሃዱ ንዑሳን ክፍሎች ብዙ እሴቶች "
"ያላቸውን ክፍሎች አይደግፉም።"

msgid "Custom composite elements do not support the %type element."
msgstr ""
"ብጁ የተዋቀሩ ውህድ አካላት %type አካልን "
"አይደግፉም።"

msgid "Limit per user"
msgstr "በተጠቃሚ አንድ ገደብ"

msgid "Horizontal rule settings"
msgstr "የአግድም መስመር ማስተካከያዎች"

msgid "Horizontal rule attributes"
msgstr "የአግድም መስመር ባህሪያት"

msgid "Provides a horizontal rule element."
msgstr "የአግድም መስመር ኤለመንት ይሰጣል።"

msgid "Example settings"
msgstr "ምሳሌ ክንውኖች"

msgid ""
"Duplicate key found. The %key key must only be assigned on one "
"element."
msgstr ""
"የተባዛ ቁልፍ ተገኝቷል። %key የሚባለው "
"ቁልፍ በአንድ አባል ብቻ ላይ መመደብ "
"አለበት።"

msgid "The label of the webform submission."
msgstr ""
"د వెಬ್フォーム சமర్పণের லேбেল "
"የሚባለው"

msgid "Total submissions limit interval"
msgstr "የጠቅላላ  സമርት የገደብ ክፍተት"

msgid "The total submissions interval for the webform."
msgstr ""
"የዌብፎርሙ የአጠቃላይ ማስገባት ጊዜ "
"ክፍተት።"

msgid "Per user submission limit interval"
msgstr "የተጠቃሚ አስገባ ገደብ ቆይታ ጊዜ (interval)"

msgid "Total submissions limit interval per source entity"
msgstr ""
"ከምንጭ አካል (source entity) በየጊዜ ቅንብር "
"የተፈቀደ አጠቃላይ የግብዓቶች (submissions) "
"ገደብ ጊዜ ክፍተት"

msgid "The total submissions interval for the webform source entity."
msgstr ""
"د وېبფორმ 소ース ኤንቲቲ ለአጠቃላይ  "
"సమስት የሚያደርጉት የጊዜ ክፍተት።"

msgid "The total submissions interval per user for the webform source entity."
msgstr ""
"የዌብፎርም ምንጭ አካል (entity) ለአንድ "
"ተጠቃሚ የጠቅላላ አቤቱታዎች (submissions) ጊዜ "
"ክፍተት።"

msgid "Convert anonymous drafts and submissions to authenticated"
msgstr ""
"የማይታወቁ ረቂቆችን እና ግብአቶችን ወደ "
"ማረጋገጠ ተጠቃሚ ቀይር"

msgid "Submission exception message"
msgstr "የማስገባት ልዩ ሁኔታ መልዕክት"

msgid "Login message when access denied to private file uploads."
msgstr ""
"የግል ፋይል ማስገቢያዎች መዳረሻ ሲከለከል "
"የሚታየው የመግቢያ መልዕክት።"

msgid "Displays an HTML container. (i.e. @div)"
msgstr "HTML መያዣ (container) ያሳያል። (ማለትም @div)"

msgid "Displays a form label without any associated element. (i.e. @label)"
msgstr ""
"ከማንኛውም ተያያዥ ኤለመንት ጋር "
"የማይጣመር የፎርም መለያ ያሳያል። "
"(ማለትም @label)"

msgid "Displays a custom table. (i.e. @table)."
msgstr "ብጁ ሰንጠረዥ ያሳያል። (ማለትም @table)"

msgid ""
"Displays a section container (i.e. @section) with a header (i.e. "
"@header)."
msgstr ""
"@header ያለው ራስገብ (ማለትም @header) በመያዝ "
"የክፍል ኮንቴይነር (ማለትም @section) "
"ያሳያል።"

msgid ""
"Enter a unique machine-readable name. Can only contain lowercase "
"letters, numbers, and underscores."
msgstr ""
"ልዩ የማሽን-መለያ ስም ያስገቡ። ዝቅተኛ "
"ፊደሎች፣ ቁጥሮች እና መስመር（underscore）ብቻ "
"ሊኖሩ ይችላሉ።"

msgid "Allow all elements to be populated using query string parameters"
msgstr ""
"ሁሉንም ክፍሎች ከኩዌሪ ስትሪንግ "
"መለኪያዎች በመጠቀም እንዲሞሉ ፍቀድ"

msgid ""
"If checked, all elements can be populated using query string "
"parameters. For example, appending ?name=John+Smith to a webform's URL "
"would set the 'name' element's default value to 'John Smith'. Please "
"note that individual elements can also have prepopulation enabled."
msgstr ""
"ከተመረጠ ሁሉም ክፍሎች በመጠይቅ "
"ሕብረቁምፊ (query string) ፓራሜተሮች በመጠቀም "
"ሊሞሉ ይችላሉ። ለምሳሌ በዌብፎርም "
"ዩአርኤል ላይ ?name=John+Smith ብለው በመጨመር "
"የ“name” ክፍሉ የነባር እሴት ወደ “John Smith” "
"ይቀይራል። እባክዎ ብቻቸው ክፍሎች "
"የቅድሚያ ሞላት (prepopulation) ማስቻል "
"እንዳላቸው ያስታውሱ።"

msgid ""
"Unchecking this box will delete ALL aliases you may have created for "
"this form via the <a href=\":path_alias\">path</a> module."
msgstr ""
"මෙኛ ሳጥኑን ባትምር ማድረግ ይህ ፎርም "
"ለማንኛውም በ<a href=\":path_alias\">path</a> ሞጁል "
"በኩል ያባረከቧቸው ሁሉም ተለዋዋጭ ስሞች "
"(aliases) ይሰርዛል።"

msgid "Other field"
msgstr "ሌላ መስክ"

msgid ""
"Install the <a href=\":module_href\">Twig tweak</a> module, which "
"provides a Twig extension with some <a "
"href=\":documentation_href\">useful functions and filters</a> that can "
"improve development experience."
msgstr ""
"የ <a href=\":module_href\">Twig tweak</a> ሞጁሉን ይጫኑ፤ "
"ይህ ሞጁል የTwig ቅጥያ (extension) ያቀርባል እና "
"የአስተዋይና ምቹ የሆነ <a "
"href=\":documentation_href\">ተጠቃሚ ፂንጎዎች እና "
"ማጣሪያዎች</a> ይኖሩታል፣ ይህም የልማት "
"ልምድን ሊያሻሽል ይችላል።"

msgid "Saving of results is disabled."
msgstr "የውጤቶች ማስቀመጥ ተሰናክሏል።"

msgid "Signatures will still be saved to %directory."
msgstr ""
"ፋይሎቹ በ %directory ውስጥ እንደሚቀመጡ "
"ፊርማዎቹም ይቀመጣሉ።"

msgid "Flag/Star"
msgstr "አመልካች/ኮከብ"

msgid "Unflag/Unstar"
msgstr "ያልተዘርዘረ/ያልተመረጠ (Unflag/Unstar)"

msgid "Append the below text to notes (Plain text)"
msgstr ""
"පහත සඳහන් පෙළを Notes (Plain text) වෙත "
"අමුණන්න."

msgid "Display message type"
msgstr "መልዕክት ዓይነት አሳይ"

msgid "Element key"
msgstr "የኤለመንት ቁልፍ"

msgid "If checked, trigger actions will be displayed onscreen to all users."
msgstr ""
"ካረጋገጡ ከሆነ፣ ተግባራት (actions) መነሳት "
"ሲከናወኑ ለሁሉም ተጠቃሚዎች በመድረክ "
"(onscreen) ላይ ይታያሉ።"

msgid "%key is not valid element key."
msgstr ""
"%key የሚለው ቁልፍ ትክክለኛ የኤለመንት "
"ቁልፍ (element key) አይደለም።"

msgid "Flagged/Starred"
msgstr "ከላይ ተመልክቷ/ኮከብ ያለው (Flagged/Starred)"

msgid "Unflagged/Unstarred"
msgstr "ባልተለየ/ከኮከብ ያልተደረገ"

msgid "Trigger an action on a submission."
msgstr ""
"ለማስገባት (submission) ላይ አንድ እርምጃ "
"አነሳ (trigger) ያድርጉ።"

msgid "Custom settings (YAML)"
msgstr "ብጁ ቅንብሮች (YAML)"

msgid "Enter the setting name and value as YAML."
msgstr ""
"ቅንብሩ ስም እና ዋጋውን በ YAML መልክ "
"አስገባ።"

msgid "Available custom settings"
msgstr "የሚገኙ የተበጁ ማሰናጃዎች"

msgid "If checked, settings will be displayed onscreen to all users."
msgstr ""
"اگر تیک زده شود، ማስተካከያዎቹ ለሁሉም "
"ተጠቃሚዎች በስክሪን ላይ ይታያሉ።"

msgid "Unknown custom %name setting(s)."
msgstr ""
"የማይታወቅ ተፈጻሚ የተበጁ  %name "
"ቅንጅት(ዎች)።"

msgid "Debug: Settings: @title"
msgstr "የማስተካከያ መረጃ፦ ቅንብሮች፦ @title"

msgid ""
"Allows Webform settings to be overridden based on submission data, "
"source entity fields, and conditions."
msgstr ""
"የዌብፎርም ማስተካከያዎች በማስገቢያ "
"መረጃ፣ በምንጭ አካል መስኮች እና "
"በሁኔታዎች መሠረት እንዲታወክሉ "
"(እንዲቀየሩ) ይፈቅዳል።"

msgid "every @increment minutes"
msgstr "@increment ደቂቃዎች በየደጋታው"

msgid "every @increment hours"
msgstr "ከ @increment ሰዓታት በኋላ በየጊዜው"

msgid "every @increment days"
msgstr "በ@increment ቀናት ሁሉ"

msgid "every @increment weeks"
msgstr "በየ @increment ሳምንታት በኩል"

msgid "every year"
msgstr "በየዓመቱ"

msgid "Data (keys):"
msgstr "ውሂብ (ቁልፎች):"

msgid "Execute when:"
msgstr "ይፈጽም መቼ፡"

msgid ""
"Please make sure to backup your website before updating the Webform "
"module."
msgstr ""
"ദಯቺኛ የድር ጣቢያዎን ማዘመን ከመጀመርዎ "
"በፊት የ Webform ሞጁሉን እንደሚያዘምኑ "
"እባክዎን ያስቀምጡ (backup)።"

msgid "Edit webform Twig templates"
msgstr ""
"የድረ-ገጽ ቅፅ (webform) Twig ቴምፕሌቶችን "
"አርትዕ ያድርጉ"

msgid "Add @label element"
msgstr "@label አካል ጨምር"

msgid "Enter a <a href=\":href\">regular expression</a>"
msgstr ""
"একዝ <a href=\":href\">ቋሚ መደበኛ እይታ (regular "
"expression)</a> አስገቡ"

msgid "Answers description display"
msgstr "መልሶች መግለጫ ማሳያ"

msgid ""
"If checked, file name will be transliterated, lower-cased and all "
"special characters converted to dashes (-)."
msgstr ""
"ካትራ ከተመረጠ የፋይሉ ስም ተርጉሞ "
"(transliterated) ዝቅተኛ ፊደል ተደርጎ ሁሉም ልዩ "
"ባህሪያት ወደ ዳሾች (-) ይቀየራሉ።"

msgid "Generate Excel compatible file"
msgstr "ኤክሴል ተኳሃኝ (compatible) ፋይል ፍጠር"

msgid "Body custom value (Twig)"
msgstr "የቅንጅት ስልት ነባሪ ዋጋ (Twig)"

msgid ""
"All of the below webform settings can be overridden but overriding "
"certain settings can trigger unexpected results."
msgstr ""
"ከሚከተሉት የድረ-ገጽ ፎርም (webform) "
"ማሰናጃዎች ሁሉ ቢቻልም ሁሉም ማሰናጃዎች "
"እንዲያው ሊተሻሹ ይችላሉ፤ ነገር ግን "
"አንዳንዶቹን ማሰናጃዎች መተሻሽ መልካም "
"ያልሆኑ ያልተጠበቁ ውጤቶችን ሊያስከትል "
"ይችላል።"

msgid "every @increment years"
msgstr "በእያንዳንዱ @increment ዓመታት ውስጥ"

msgid "Lock selected submission configuration"
msgstr "የተመረጠውን የማስገባት ውቅር ቆልፍ"

msgid "Unlock selected submission configuration"
msgstr "የተመረጠውን የማስገቢያ ውቅር ክፈት"

msgid "Display required indicator"
msgstr "የሚፈለግ አመልካች አሳይ"

msgid "Submission locked message"
msgstr "የግብዓት ማስገቢያ ተቆልፏል መልዕክት"

msgid "A flag that indicates a locked webform submission."
msgstr ""
"የተቆለፈ የድር ቅጽ ግቤት (webform submission) "
"መሆኑን የሚያመለክት ባንዲር።"

msgid "You have successfully installed the Webform module."
msgstr "የWebform ሞጁሉን በተሳካ ሁኔታ ጭነዋል።"

msgid ""
"Learn more about the <a href=\":about_href\">Webform module and "
"Drupal</a>"
msgstr ""
"دربارهٔ <a href=\":about_href\">Webform module እና "
"Drupal</a> ተጨማሪ ይወቁ"

msgid "Locked [@total]"
msgstr "ተቆልፏል [@total]"

msgid "Unlocked [@total]"
msgstr "ተከፈተ [@total]"

msgid "Lock this submission"
msgstr "ይህን ግብዓት መዝጋት (Lock)"

msgid "If checked, users will not be able to update this submission."
msgstr ""
"ከተሞሉ ተጠቃሚዎች ይህን ማስገባት ማዘመን "
"አይችሉም።"

msgid "@title (@id): Found element validation errors."
msgstr ""
"@title (@id): ለእቃ ማረጋገጫ ስህተቶች "
"ተገኝተዋል።"

msgid "The URL !url could not be downloaded."
msgstr "ዩአርኤል !url መጫን/ማውረድ አልተቻለም።"

msgid ""
"If checked, all modal/off-canvas dialogs (i.e. popups) will be "
"disabled."
msgstr ""
"ከተመረጠ ሁሉም ሞዳል/ከጎን የሚንሸራሸሩ "
"መጋለጫዎች (ማለትም ፖፕ-አፕዎች) "
"ይታገዳሉ።"

msgid "Leave blank to not display a message when a form is autofilled."
msgstr ""
"ቅጹ አውቶማቲክ ሲሞላ መልእክት እንዳይታይ "
"ለማድረግ ባዶ ይተዉ።"

msgid "Above (Floating)"
msgstr "ከላይ (በምልክት መንጠፊያ)"

msgid "Below (Floating)"
msgstr "ከዚህ በታች (በሚንሳፈፍ)"

msgid "Output prefix"
msgstr "የውጤት ፍለጋ ቅድመ-ቅጥ (prefix)"

msgid "Output suffix"
msgstr "የውጤት መጨረሻ (Suffix)"

msgid "Change lock"
msgstr "የመቆለፊያ ለውጥ"

msgid ""
"This %plugin_id handler is broken or missing. You might need to enable "
"the original module and/or clear the cache."
msgstr ""
"ይህ %plugin_id ን የሚያስተናግድ "
"አያያዥ/አስተናጋጅ ተበላሽቷል ወይም "
"አልተገኘም። ምናልባት ዋናውን ሞጁሉን "
"ማንቃት እና/ወይም ካሸን (cache) ማጽዳት "
"ይኖርብዎታል።"

msgid ""
"Use [webform_submission:values:ELEMENT_KEY:raw] to get plain text "
"values."
msgstr ""
"ቀላል ጽሑፍ ዋጋዎችን ለማግኘት "
