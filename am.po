msgstr "ቀዳሚ (Default) የእይታ ሁኔታ"

msgid "URL to image"
msgstr "ለምስል የሚሆን ዩአርኤል"

msgid "Content revisions"
msgstr "የይዘት ማሻሻያዎች"

msgid "Recipient ID"
msgstr "የተቀባዩ መታወቂያ"

msgid "%time hence"
msgstr "%time እንግዲህ"

msgid "Language selection"
msgstr "የቋንቋ ምርጫ"

msgid "Delete all translations"
msgstr "ሁሉንም ትርጉሞች ሰርዝ"

