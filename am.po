"    '#options':\n"
"      1: One\n"
"      2: "
"Two\n"
"      3: Three\n"
"      other: Other…\n"
"  radios_other:\n"
"    "
"'#type': textfield\n"
"    '#attributes':\n"
"      placeholder: 'Enter "
