msgstr ""
"ሁሉንም @plural_label የሚመጥነውን የንድፍ "
"አቀማመጥ (layout) ቴምፕሌት እያስተካከሉ "
"ነው።"

msgid "Section: @delta"
msgstr "ክፍል፡ @delta"

