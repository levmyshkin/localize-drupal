msgid "Tee shirt limits"
msgstr "የቲ-ሸርት ገደቦች"

msgid "No more tee shirts are available."
msgstr "የቲሸርት ተጨማሪ ምንም አይገኝም።"

msgid "[@remaining shirts remaining]"
msgstr "[አሁን የቀሩ ሸሚዞች የቀሩ ሸሚዞች]"

msgid "[@remaining shirt remaining]"
msgstr "[ቀሪው ሸሚዝ ቀሪው]"

msgid "[Unlimited]"
msgstr "[ማያገደብ]"

msgid "Submission limits and options limits"
msgstr "የඋልታ ገደቦች እና የአማራጭ ገደቦች"

msgid "This screencast shows how to set submission limits and options limits."
msgstr ""
"ይህ ስክሪንካስት የቅርብ ግቤት (submission) "
"ገደቦችን እና የአማራጮች (options) ገደቦችን "
"እንዴት ማዘጋጀት እንደሚቻል ያሳያል።"

msgid "Webform now supports option limits as well as submission limits"
msgstr ""
"Webform አሁን የአማራጭ ገደቦችን እንዲሁም "
"የඋሳታ ገደቦችንም ይደግፋል።"

msgid ""
"Please make sure users are allowed to 'view any submission' and 'edit "
"any submission'."
msgstr ""
"ദയവായി ഉപയോക്താക്കൾക്ക് "
"‘ഏതെങ്കിലും സമർപ്പണം "
"കാണുക’ (view any submission) എന്നും "
"‘ഏതെങ്കിലും സമർപ്പണം "
"തിരുത്തുക’ (edit any submission) "
"എന്നും അനുവാദമുണ്ടെന്ന് "
"ഉറപ്പാക്കുക."

msgid ""
"Please make sure authenticated users are allowed to 'view own "
"submission' and 'edit own submission'."
msgstr ""
"ದተኛ እንዲሁም ማረጋገጥ ያለብዎት ፣ "
"የተገለጹ (authenticated) ተጠቃሚዎች  “own submission "
"ን መመልከት” እና “own submission ን ማረም” "
"መፈቀድ እንዳለባቸው ነው።"

msgid ""
"Please note: Settings the element's title display to 'none' means the "
"title will not be rendered or accessible to screenreaders"
msgstr ""
"ദയവായി ശ്രദ്ധിക്കുക: "
"ელემന്റിന്റെ "
"ಶീർഷകത്തിന്റെ نمایش “none” "
"എന്നതായി "
"സജ്ജീകരിക്കുന്നുവെങ്കിൽ, "
"ആ ശീർഷകം റെൻഡർ "
"ചെയ്യപ്പെടുകയില്ല "
"അല്ലെങ്കിൽ സ്‌ക്രീൻ "
"റീഡറുകൾക്ക് "
"ലഭ്യമാകുകയില്ല."

msgid "File base name (no extension)"
msgstr ""
"የፋይል መሰረታዊ ስም (ማስፈንጠሪያው "
"ሳይካተት)"

msgid ""
"File names combined with their full URI can not exceed 255 characters. "
"File names that exceed this limit will be truncated."
msgstr ""
"የፋይል ስሞች ከሙሉ ዩአርአይ (URI) ጋር "
"ተጣምረው 255 ቁምፊዎችን ከመብለጥ "
"አይችሉም። ይህን ገደብ የሚያልፉ የፋይል "
"ስሞች ይቆረጣሉ።"

msgid "Demo: Event Registration System"
msgstr "ዴሞ፡ የክስተት ምዝገባ ሥርዓት"

msgid "[total]/[limit]"
msgstr "[total]/[limit]"

msgid "Preferred countries"
msgstr "የሚመረጡ አገሮች"

msgid "Specify the countries to appear at the top of the list."
msgstr ""
"የዝርዝሩ መጀመሪያ ላይ ለሚታዩ አገሮች "
"ይግለጹ።"

msgid "Custom parameters"
msgstr "ብጁ (Custom) መመኪያዎች"

msgid ""
"Enter additional custom parameters to be appended to the email "
"message's parameters. Custom parameters are used by <a "
"href=\":href\">email related add-on modules</a>."
msgstr ""
"የኢሜይል መልዕክት መለኪያዎች (parameters) ላይ "
"ሊታከሉ የሚችሉ ተጨማሪ ብጁ (custom) "
"መለኪያዎችን ያስገቡ። ብጁ መለኪያዎች በ <a "
"href=\":href\">ኢሜይል-ተኮር የተጨማሪ ሞጁሎች</a> "
"ይጠቅማሉ።"

msgid "Update wizard progress bar's pages based on conditions"
msgstr ""
"የዝርዝር መጫኛ (wizard) የሂደት መስመሩን "
"ገጾች በሁኔታዎች መሰረት ያዘምኑ"

msgid "Configuration: Images"
msgstr "ውቅር፦ ምስሎች"

msgid ""
"The <strong>Images configuration</strong> page lists reusable images "
"for the image select element."
msgstr ""
"የ<strong>ምስሎች ቅንብር</strong> ገጹ ለምስል "
"ምርጫ አካሉ ተደጋጋሚ ሊጠቀሙ የሚችሉ "
"ምስሎችን ያሳያል።"

msgid "@count reference"
msgid_plural "@count references"
msgstr[0] "@count ማጣቀሻ"
msgstr[1] "@count ማጣቀሻዎች"

msgid "Configuration: Custom options"
msgstr "ቅንብር፦ ብጁ አማራጮች"

msgid ""
"The <strong>Custom options configuration</strong> page lists reusable "
"HTML/SVG custom options elements."
msgstr ""
"የ <strong>ብጁ አማራጮች ማዋቀር</strong> ገጽ "
"እንደገና ሊውል የሚችል የ HTML/SVG ብጁ "
"አማራጭ አካላትን ያሳያል።"

msgid "SVG Pan & Zoom"
msgstr "SVG ፓን እና ዙም"

msgid "Simple pan/zoom solution for SVGs in HTML."
msgstr ""
"በHTML ውስጥ ለ SVG ዎች ቀላል የ pan/zoom "
"መፍትሄ።"

msgid "Svg-pan-zoom is used by custom options elements."
msgstr ""
"Svg-pan-zoom ን ብጁ (custom) ኦፕሽን (options) "
"ኤለመንቶች ለመጠቀም ነው ይጠቀማል።"

msgid ""
"Provides a webform element for converting HTML or SVG markup into a "
"selectable single or multiple options input."
msgstr ""
"HTML ወይም SVG ማርክፕን (markup) ወደ ተመራጭ "
"አንድ ወይም ብዙ አማራጮች የሚያደርግ "
"የድረ-ገጽ ቅጽ (webform) ክፍል ይሰጣል።"

msgid "Add custom options"
msgstr "ብጁ አማራጮች አክል"

msgid "Webforms: Custom options"
msgstr "ዌብፎርሞች፡ ብጁ አማራጮች"

msgid "Edit custom options"
msgstr ""
"አማራጮችን ከተለመደው ውስጥ አርትዕ "
"ያድርጉ"

msgid "Preview custom options"
msgstr "የተበጁ አማራጮችን ቅድመ እይታ"

msgid "Duplicate custom options"
msgstr "የተባዙ ብጁ አማራጮች"

msgid "Delete custom options"
msgstr "ተጠቃሚ የተበጁ አማራጮችን ሰርዝ"

msgid "Type of custom options"
msgstr "የተለያዩ የተበጁ አማራጮች ዓይነት"

msgid "HTML/SVG markup"
msgstr "HTML/SVG ማርክአፕ"

msgid "HTML/SVG URL"
msgstr "HTML/SVG URL"

msgid "Option text attribute names"
msgstr "የአማራጭ ጽሑፍ ባህሪ ስሞች"

msgid "Show select menu"
msgstr "የመምረጫ ምናሌ አሳይ"

msgid "Use as a select element"
msgstr "እንደ ምርጫ (select) አካል ይጠቀሙ"

msgid "Use as an entity reference element"
msgstr "እንደ አካል ማጣቀሻ እቃ ይጠቀሙ"

msgid ""
"Enter the absolute URL or root-relative path to the HTML/SVG file. The "
"HTML/SVG file must be publicly accessible using http:// or https://."
msgstr ""
"HTML/SVG ፋይሉን ወደሚያሳይ ፍጹም (absolute) URL "
"ወይም ስር-ተመራጭ (root-relative) መንገድን "
"ያስገቡ። HTML/SVG ፋይሉ በ http:// ወይም https:// "
"በመጠቀም ማንኛውም ሰው በቀላሉ ሊያገኘው "
"የሚችል (publicly accessible) መሆን አለበት።"

msgid "HTML/SVG markup template (Twig)"
msgstr ""
"دኤችቲኤምኤల్/එスවጂ ማርክአፕ ናሙና "
"ቴምፕሌት (Twig)"

msgid ""
"The entire element with descriptions without the hash (#) prefixes is "
"passed as variables to the Twig template."
msgstr ""
"##፣ hash (#) ቅድመ ቃላት የሌላቸው "
"መግለጫዎችን ጨምሮ ያለው ሙሉው ኤለመንት "
"በTwig ቴምፕሌቱ ውስጥ እንደ ተለዋዋጮች "
"ይተላለፋል።"

msgid ""
"Enter a comma-delimited list of attribute names. The first matched "
"value attribute will be used for all custom option values .Leave blank "
"if options values is populated using Twig."
msgstr ""
"እባክዎ የባህሪ ስሞችን በኮማ ተለይተው "
"የተዘረዘሩ ዝርዝር ያስገቡ። የመጀመሪያው "
"ተዛማጅ የተገኘ ዋጋ ባህሪ ለሁሉም ብጁ "
"የአማራጭ ዋጋዎች ይጠቀማል። የአማራጭ "
"ዋጋዎች በTwig ተሞልቶ ከሆነ ባዶ ይተው።"

msgid ""
"Enter a comma-delimited list of attribute names. The first matched "
"text attribute will be used for all custom option text. Leave blank if "
"options text is populated using Twig."
msgstr ""
"ነጠብጣብ (comma) የተለያዩ የባህሪ ስሞችን "
"ዝርዝር ያስገቡ። ከሚገጥሙት የመጀመሪያው "
"የጽሑፍ ባህሪ ሁሉንም የተለመዱ አማራጭ "
"ጽሑፍ ለመጠቀም ይውላል። አማራጮቹ ጽሑፍ "
"በTwig ተሞልቷል ከሆነ ባዶ ይተዉት።"

msgid ""
"If checked, SVG graphic can be panned and zooming using the <a "
"href=\":href\">svg-pan-zoom</a> library"
msgstr ""
"እንዲህ ከተመረጠ (checked) ፣ SVG ግራፊክን በ <a "
"href=\":href\">svg-pan-zoom</a> መጠቃለያ (library) "
"በመጠቀም ማንቀሳቀስ (panning) እና "
"ማሳነስ/መቅረብ (zooming) ማድረግ ይቻላል።"

msgid "Show select menu associated with the custom options element"
msgstr ""
"የተለመደው (custom options) እቃ ከሚያያዝ ምርጫ "
"ሜኑ ያሳዩ"

msgid ""
"If checked, the select menu associated with the custom options element "
"will be visible. Displaying the standard HTML select menu assists "
"mobile users and users with disabilities when thy are selecting custom "
"options."
msgstr ""
"ይህ ከተመረጠ (ቼክ ከተደረገ) ከተለየ "
"አማራጮች ኤለመንት ጋር የተያያዘው "
"የመምረጫ ሜኑ ይታያል። መደበኛውን የHTML "
"መምረጫ ሜኑ ማሳየት ለሞባይል ተጠቃሚዎች "
"እና ለአካል ጉድለት ያላቸው ተጠቃሚዎች "
"ተለዩ አማራጮችን ሲመርጡ እንዲረዳቸው "
"ይጠቅማል።"

msgid "Use as a basic select element"
msgstr "እንደ መሰረታዊ ምርጫ እቃ ሆኖ ይጠቀሙ"

msgid "HTML/SVG file URL or path %url not found."
msgstr ""
"የHTML/SVG ፋይል ዩአርኤል ወይም መንገድ %url "
"አልተገኘም።"

msgid "Custom options %label saved."
msgstr "የተለመዱ አማራጮች %label ተቀምጠዋል።"

msgid "Custom options @label saved."
msgstr "ብጁ አማራጮች @label ተቀምጠዋል።"

msgid "One -- This is the number 1."
msgstr "አንድ — ይህ ቁጥር 1 ነው።"

msgid "Two -- This is the number 2."
msgstr "ሁለት — ይህ ቁጥር 2 ነው።"

msgid "Three -- This is the number 3."
msgstr "ሶስት — ይህ ቁጥር 3 ነው።"

msgid "%title custom options are not valid. @message"
msgstr ""
"%title የተበጁ አማራጮች ትክክል አይደሉም። "
"@message"

msgid "Webform options custom"
msgstr "ዌብፎርም አማራጮች ብጁ"

msgid "custom options"
msgstr "ብጁ አማራጮች"

msgid "Filter custom options"
msgstr "ተጨማሪ አማራጮችን ማጣሪያ ያድርጉ"

msgid "Show all custom options"
msgstr "ሁሉንም ብጁ (custom) አማራጮች አሳይ"

msgid "(Entity reference)"
msgstr "(የአካል ማጣቀሻ)"

msgid "Option text / description"
msgstr "የአማራጭ ጽሑፍ / መግለጫ"

msgid "Custom element"
msgstr "ብጁ አካል"

msgid ""
"Provides a form element for creating custom options using HTML and SVG "
"markup."
msgstr ""
"HTML ਅਤੇ SVG մարքափ օգտագործിച്ച് "
"հատուկ արզանքներ ստեղծելու համար ձև "
"տարր տրամադրում է։"

msgid "Custom elements"
msgstr "ብጁ (custom) ኤለመንቶች"

msgid "Custom entity reference"
msgstr "ብጁ አካል (Custom entity) ማጣቀሻ"

msgid ""
"Provides a form element for creating custom options using HTML and SVG "
"markup with entity references."
msgstr ""
"HTML እና SVG ማርክአፕ በመጠቀም ከአካል "
"ማጣቀሻዎች (entity references) ጋር "
"ተጠቃሚ-የተዘጋጀ አማራጮች ለመፍጠር የቅጽ "
"አካል ይሰጣል።"

msgid ""
"Webform module supports creating custom elements using HTML and SVG "
"markup"
msgstr ""
"የWebform ሞጁል የHTML እና የSVG ማርከፕ (markup) "
"በመጠቀም ብጁ ኤለመንቶችን ለመፍጠር "
"ይደግፋል።"

msgid ""
"If checked, to submissions token will be removed from the Confirmation "
"URL and the [webform_submission] tokens will not be available within "
"the confirmation message."
msgstr ""
"ከተሞለከተ (checked) ከሆነ፣ የግብዓት ቶከኑ "
"(submissions token) ከማረጋገጫ (Confirmation) ዩአርኤል "
"ውስጥ ይወገዳል እና የ [webform_submission] ቶከኖች "
"በማረጋገጫ መልዕክት (confirmation message) ውስጥ "
"አይገኙም።"

msgid ""
"You may use tokens to pass query string parameters. Make sure all "
"tokens include the urlencode suffix. (i.e. "
"[webform_submission:values:email:urlencode])"
msgstr ""
"የፍለጋ ጥያቄ መለኪያዎችን ለማለፍ "
"ቶከኖችን መጠቀም ይችላሉ። ሁሉም ቶከኖች "
"የ urlencode ቅጥያን እንዲካተቱ ያረጋግጡ። "
"(ማለትም፣ [webform_submission:values:email:urlencode])"

msgid "Example: Custom Options"
msgstr "ምሳሌ፡ ብጁ አማራጮች"

msgid "Example of a custom options element."
msgstr "د የተበጀ ኦፕሽኖች ኤለመንት ምሳሌ።"

msgid ""
"states:\n"
"  '#type': 'webform_options_custom:us_states'\n"
"  '#title': "
"'U.S. States'\n"
"  '#required': true\n"
"button:\n"
"  '#type': "
"'webform_options_custom:buttons'\n"
"  '#title': 'Buttons'\n"
"  "
"'#required': true\n"
"  '#options':\n"
"    one: One -- This is the number "
"1.\n"
"    two: Two -- This is the number 2.\n"
"    three:  Three -- This "
"is the number 3.\n"
""
msgstr ""
"```yaml\n"
"states:\n"
"  '#type': 'webform_options_custom:us_states'\n"
"  "
"'#title': 'የአሜሪካ ግዛቶች'\n"
"  '#required': "
"true\n"
"button:\n"
"  '#type': 'webform_options_custom:buttons'\n"
"  "
"'#title': 'ቁልፎች'\n"
"  '#required': true\n"
"  '#options':\n"
"    "
"one: አንድ -- ይህ ቁጥር 1 ነው።\n"
"    two: ሁለት -- "
"ይህ ቁጥር 2 ነው።\n"
"    three:  ሶስት -- ይህ "
"ቁጥር 3 ነው።\n"
"```"

msgid "An example of custom buttons."
msgstr "የብጁ ቁልፎች ምሳሌ።"

msgid "{  }"
msgstr "{  }"

msgid "U.S. states"
msgstr "የአሜሪካ ግዛቶች"

msgid "A clickable map of U.S. states."
msgstr "የአሜሪካ ግዛቶች የሚነካ ካርታ።"

msgid "us_states.svg"
msgstr "us_states.svg"

msgid ""
"The 'checked'  or 'selected' looks to see if an 'option_value' is "
"checked or selected for an options element (select, checkboxes, or "
"radios)"
msgstr ""
"“checked” ወይም “selected” በአማራጭ እቃ (options "
"element) (select፣ checkboxes፣ ወይም radios) ውስጥ የ "
"“option_value” መመረጡን ወይም መምረጡን "
"(checked/selected) እንደሆነ ለማየት ይመልከታል።"

msgid ""
"The 'option_value' is options value for an options element (select, "
"checkboxes, or radios)."
msgstr ""
"«option_value» የአማራጭ እሴት (options value) ነው "
"ለአማራጮች አካል (select, checkboxes, ወይም radios)።"

msgid ""
"The source entity title that the webform submission was submitted "
"from, defaults to the webform title when there is no source entity."
msgstr ""
"വെബ്‌ഫോം സമർപ്പണം "
"സമർപ്പിച്ചിടുന്ന ഉറവിട "
"entity തലക്കെട്ടാണ് ഇത്; ഉറവിട "
"entity ഇല്ലെങ്കിൽ ഇതിന്റെ "
"ഡീഫോൾട്ട് വെബ്‌ഫോം "
"തലക്കെട്ടാണ്."

msgid "Webform custom options elements"
msgstr "ዌብፎርም የተበጀ አማራጮች ክፍሎች"

msgid "Allow users to view a submission using a secure token"
msgstr ""
"ተጠቃሚዎች የተለጠፈውን ንብረት "
"በአስተማማኝ ቶከን በመጠቀም ማየት "
"እንዲችሉ ፍቀድ"

msgid ""
"If checked users will be able to view a submission using the webform "
"submission's URL appended with the submission's (secure) token."
msgstr ""
"ይህ ከተመረጠ (checked) ተጠቃሚዎች "
"በዌብფორმ ማስገቢያ (webform submission) "
"የተጠቃሚውን የማስገቢያ  (secure) ቶከን "
"ተያይዞ በሚጨመር አድራሻ (URL) በኩል "
"ማስገቢያውን ማየት ይችላሉ።"

msgid "Submission View"
msgstr "የአስገባ እይታ"

msgid "Recipient user roles"
msgstr "የተቀባይ ተጠቃሚ ሚናዎች"

msgid ""
"Select user roles that can be assigned to receive a webform's email. "
"<em>Please note: Selected user roles will be available to all "
"webforms.</em>"
msgstr ""
"የድር ፎርም ኢሜል ለመቀበል ሊመደቡ "
"የሚችሉ የተጠቃሚ ሚናዎችን ምረጡ። "
"<em>እባክዎ ልብ ይበሉ፦ የተመረጡ ተጠቃሚ "
"ሚናዎች ለሁሉም የድር ፎርሞች ይገኛሉ።</em>"

msgid ""
"Please note: You can select which <strong>user roles</strong> are "
"available to receive webform emails by going to the Webform module's "
"<a href=\":href\">admin settings</a> form."
msgstr ""
"እባክዎ ልብ ይበሉ፦ የዌብፎርም ኢሜይሎችን "
"ለመቀበል ሊመርጡ የሚችሉትን "
"<strong>የተጠቃሚ ሚናዎች</strong> ማሳወቂያ "
"በመሆኑ ወደ የዌብፎርም ሞጁሉ የ <a "
"href=\":href\">አስተዳደር ቅንብሮች</a> ቅጽ "
"ይሂዱ።"

msgid "The current (last submitted) wizard page of the webform submission."
msgstr ""
"د وېبフォーム ማስገባት የአሁኑ (በመጨረሻ "
"የተላከ) የመመሪያ ገጽ።"

msgid ""
"The current (last submitted) wizard page title of the webform "
"submission."
msgstr ""
"የዌብፎርም ምዝገባ (የመጨረሻ ጊዜ የተላከ) "
"የአሁኑ የመመሪያ ገጽ ርዕስ።"

msgid "Exclude file attachments"
msgstr "Файል ցእዳዎችን አትካትት"

msgid "Notes element types"
msgstr "ማስታወሻ ኤለመንት ዓይነቶች"

msgid "Notes element type"
msgstr "የማስታወሻ (Notes) አካል አይነት"

msgid "Notes element type:"
msgstr "የማስታወሻ አካል ዓይነት፦"

msgid "Webform jQueryUI Buttons"
msgstr "ዌብፎርም ጃኬዋሪ UI ቁልፎች"

msgid ""
"Provides a group of multiple buttons used for selecting a value. "
"jQueryUI is no longer maintained."
msgstr ""
"በእሴት ለመምረጥ የሚያገለግሉ ብዙ "
"ቁልፎችን ቡድን ይሰጣል። jQueryUI ከዚህ በኋላ "
"አይታደስም።"

msgid ""
"The %key element can not be removed because the %title webform has "
"related <a href=\":href\">variants</a>."
msgstr ""
"የ %key ክፍል (element) ሊወገድ አይችልም "
"ምክንያቱም %title ዌብፎርሙ ተያያዥ <a "
"href=\":href\">variants</a> አሉት።"

msgid "Title / Notes"
msgstr "శීර්ሻት / ማስታወሻዎች"

msgid "Save variants"
msgstr "ተለዋጮችን አስቀምጥ"

msgid "Webform %label variant saved."
msgstr "የድረ-ቅጽ (Webform) %label ተለዋጭ ተቀምጧል።"

msgid "This @label variant was @op."
msgstr "ይህ @label ተለዋዋጭ የ@op ነበር።"

msgid "Webform @label variant saved."
msgstr "የWebform @label ተለዋጭ (variant) ተቀምጧል።"

msgid "Personalized Webforms"
msgstr "ግል ተመጣጣኝ የድር ፎርሞች"

msgid ""
"The <strong>Variant plugins</strong> overview page lists all available "
"webform variant plugins."
msgstr ""
"<strong>የቫሪያንት ፕላጊኖች</strong> አጠቃላይ "
"እይታ ገጹ ይገኙ ሁሉንም የድር ፎርም "
"ቫሪያንት ፕላጊኖች ዝርዝር ያሳያል።"

msgid "Filter by variant name"
msgstr "የተለያዩ ስም በመመርጠት ማጣራት"

msgid "Enter @none or @none_translated to hide this message."
msgstr ""
"ይህን መልዕክት ለማስወገድ @none ወይም "
"@none_translated ያስገቡ።"

msgid "Add @label variant"
msgstr "@label ተለዋጭ አክል (variant) ያስገቡ"

msgid "Apply variant?"
msgstr "የተለያዩ ስሪት ማስተካከል ይፈልጋሉ?"

msgid "Apply the selected variants to the %webform webform?"
msgstr ""
"ለ %webform webform ላይ የተመረጡትን ቫሪያንቶች "
"ተግብር?"

msgid "Apply variant to the %webform webform?"
msgstr ""
"ይህንን ተለዋጭ (variant) በ %webform ዌብፎርም "
"ላይ ተግብር?"

msgid "Are you sure you want to apply the %title variant?"
msgstr ""
"በ %title ተለዋጭነት ላይ ማድረግ እርግጠኛ "
"ነዎት?"

msgid "Are you sure you want to apply the selected variants?"
msgstr ""
"የተመረጡትን ተለዋጮች ማስተግበር "
"እርግጠኛ ነዎት?"

msgid ""
"Replace existing settings, elements, and handler with selected "
"variants."
msgstr ""
"የተመረጡትን ተለዋዋጮች በመጠቀም "
"ከነበሩት ቅንብሮች፣ ክፍሎች እና "
"አስተናጋጆችን ተተኩ።"

msgid "Replace existing settings, elements, and handler with this variant."
msgstr ""
"ነባሩን ማስተካከያዎች፣ ኤለመንቶች እና "
"ሃንደለርን ይህኛው ልዩነት በመተካት "
"ይቀይሩ።"

msgid "After selected variants are applied…"
msgstr "በተመረጡ ተለያዮች ተተግብረው በኋላ…"

msgid "After this variant is applied…"
msgstr "ይህ ልዩነት ከተተገበረ በኋላ…"

msgid "Delete the '@title' variant?"
msgstr "“@title” የሚለውን ቫሪያንት ሰርዝ?"

msgid "Delete the %title variant from the %webform webform?"
msgstr ""
"%webform webform ውስጥ ያለውን %title ተለዋጭ (variant) "
"ሰርዝ?"

msgid "Are you sure you want to delete the %title variant?"
msgstr ""
"%title የሚለውን ተለዋጭ ሊሰርዙ መፈለግዎ "
"ትክክል ነው?"

msgid "Remove this variant"
msgstr "ይህን ልዩነት ሰርዝ"

msgid "Duplicate @label variant"
msgstr ""
"የ@label ተመሳሳይ አማራጭን ቀጂ "
"(ዱፕလිකේት)"

msgid "Form overview settings"
msgstr "የቅጽ አጠቃላይ መግለጫ ቅንብሮች"

msgid "Form Ajax settings"
msgstr "د ፎርም ኤ이-ጃክስ ቅንብሮች"

msgid ""
"You need to be assigned <a href=\"@href\">Edit webform variants</a> "
"permission to be able create and manage variants."
msgstr ""
"ተለዋዋጮች (variants) ለመፍጠር እና "
"ለመቆጣጠር መቻል የቻለ ሆኖ <a "
"href=\"@href\">የድር ፎርም ተለዋዋጮችን ማረም</a> "
"ፍቃድ መተየብ አለብዎት።"

msgid ""
"Users need to be assigned <a href=\"@href\">Edit webform variants</a> "
"permission to be able create and manage variants."
msgstr ""
"ተጠቃሚዎች እንዲፈጥሩ እና እንዲቆጣጠሩ "
"የዌብፎርም ተለዋዋጮችን ሊችሉ የ <a "
"href=\"@href\">Edit webform variants</a> ፍቃድ "
"ሊመደብላቸው ያስፈልጋል።"

msgid ""
"To limit the minimum date to the submission date use the "
"<code>[webform_submission:created:html_date]</code> token."
msgstr ""
"የትኛውንም የቀን ዝቅተኛ ገደብ ከማስገባት "
"ቀን ጋር ለማድረግ "
"የ<code>[webform_submission:created:html_date]</code> ቶከን "
"ተጠቀሙ።"

msgid ""
"To limit the maximum date to the submission date use the "
"<code>[webform_submission:created:html_date]</code> token."
msgstr ""
"උපுமිතික දිනය ලෙස സമർപ്പණ "
"දිනය දක්වා උපරිම දිනය සීමා "
"කිරීමට <code>[webform_submission:created:html_date]</code> "
"ටୋකනය භාවිතා කරන්න."

msgid ""
"To limit the minimum date/time to the submission date/time use the "
"<code>[webform_submission:created:html_datetime]</code> token."
msgstr ""
"የተላከው ቀን/ሰዓት ከመላክ ቀን/ሰዓት "
"መጀመሪያ ለመውሰን ዝቅተኛውን ቀን/ሰዓት "
"ለመገደብ የ "
"<code>[webform_submission:created:html_datetime]</code> ቶከን "
"ይጠቀሙ።"

msgid ""
"To limit the maximum date/time to the submission date/time use the "
"<code>[webform_submission:created:html_datetime]</code> token."
msgstr ""
"උපචార/ඉදිරිපත් කිරීමේ "
"දිනය/වේලාවට උපරිම "
"දිනය/වේලාව සීමා කිරීමට "
"<code>[webform_submission:created:html_datetime]</code> "
"ටෝකනය භාවිතා කරන්න."

msgid ""
"View displays with exposed filters are not supported because exposed "
"filters nest a &lt;form&gt; within a &lt;form&gt; and this breaks the "
"webform."
msgstr ""
"ኤክፖዝድ ፊልተሮች ያላቸው ማሳያዎች "
"አይደገፉም፣ ምክንያቱም ኤክፖዝድ "
"ፊልተሮች በውስጥ ውስጡ የ&lt;form&gt; ማካተት "
"በ&lt;form&gt; ውስጥ ያደርጋሉ፤ ይህም "
"ዌብፎርሙን ይሰብራል።"

msgid ""
"Only users who can 'Administer views' or 'Edit webform source code' "
"can update the view name, display id, and arguments."
msgstr ""
"“View Administer (አስተዳዳሪ)” ወይም “Edit webform "
"source code (የ webform ምንጭ ኮድ ማረም)” ማድረግ "
"የሚችሉ ብቻ ተጠቃሚዎች የቪው ስም፣ የ display "
"id እና አርጉመንቶችን ሊያዘምኑ ይችላሉ።"

msgid "View display %display_id does not exist."
msgstr "%display_id የማሳያ መታየት አልኖረም።"

msgid ""
"View display %display_id has exposed filters which will break the "
"webform."
msgstr ""
"እይታው  %display_id ያለው የተጋለጡ ማጣሪያዎች "
"የዌብፎርሙን ያበላሻሉ።"

msgid ""
"Provides a view embed element. Only users who can 'Administer views' "
"or 'Edit webform source code' can create and update this element."
msgstr ""
"እይታ (views) ኢምብድ ኤለመንት ይሰጣል። "
"ይህን ኤለመንት መፍጠር እና መዘመን "
"የሚችሉት ብቻ “Administer views” ወይም “Edit "
"webform source code” የሚባሉ ፈቃዶች ያላቸው "
"ተጠቃሚዎች ናቸው።"

msgid ""
"After clicking 'Save', the 'Variants' manage tab will be displayed. "
"Use the 'Variants' manage tab to add and remove variants."
msgstr ""
"‘Save’ ን ከተጫኑ በኋላ የ‘Variants’ "
"አስተዳደር ትር ይታያል። የ‘Variants’ "
"አስተዳደር ትርን ተጠቅመው ቫሪያንቶችን "
"ለመጨመር እና ለማስወገድ ይጠቀሙ።"

msgid ""
"Add and remove variants using the <a href=\"@href\">Variants</a> "
"manage tab."
msgstr ""
"በ <a href=\"@href\">Variants</a> የማስተዳደር ትር "
"በመጠቀም ለውጦችን (variants) አክል እና "
"አስወግድ።"

msgid "Select the variant type to be displayed on the 'Variants' manage tab."
msgstr ""
"«Variants» የሚባለውን ማቀናበር ትር (manage tab) "
"ላይ ለማሳየት የሚመረጥ የቫሪያንት "
"አይነትን ይምረጡ።"

msgid "This variant is currently in-use. The variant type cannot be changed."
msgstr ""
"ይህ ተለዋጭ በአሁኑ ጊዜ ተጠቃሚ ላይ ነው። "
"የተለዋጭ አይነቱ መቀየር አይቻልም።"

msgid "Prepopulate this variant"
msgstr "ይህንን አማራጭ ቀድሞ ይሞሉ"

msgid "Randomly load variant"
msgstr "በዘፈቀደ ይለዋዋጩን ጫን"

msgid ""
"Randomly redirects to the webform with the variant populated using "
"query string parameter. This element's default value/data will be "
"ignored."
msgstr ""
"በጣም የተለመደ መልኩ የጥያቄ ሕብረቁምፊ "
"(query string) አማካኝነት በሚሰጠው መለያ ውሂብ "
"እየተመረጠ ወደ ዌብፎርሙ በድንገት "
"ይዘዋወራል። የዚህ ክፍል ነባሪ ዋጋ/ውሂብ "
"ይተዋል (አይተገበርም)።"

msgid "Included email values/markup"
msgstr "የተካተቱ ኢሜይል እሴቶች/ማርኩፕ"

msgid "If checked, empty elements will be excluded from the email values."
msgstr ""
"ይህ ከተመረጠ ባዶ ክፍሎች ከኢሜይል "
"እሴቶች ውስጥ ይወገዳሉ።"

msgid "If checked, empty checkboxes will be excluded from the email values."
msgstr ""
"ከተሰየመ (checked) ከሆነ ባዶ የሆኑ ምልክት "
"ሳጥኖች ከኢሜይል እሴቶች ውስጥ ይቀርባሉ።"

msgid "Exclude file elements with attachments"
msgstr ""
"ከցንክት/ցንብር (attachments) ጋር የተያያዙ "
"ፋይል አካላትን አስወግድ"

msgid ""
"If checked, file attachments will be excluded from the email values, "
"but the selected element files will still be attached to the email."
msgstr ""
"ይህ ከተመረጠ (checked) ከሆነ የፋይል "
"ցተያያዞች ከኢሜይል እሴቶች ውስጥ "
"ይገለላሉ፣ ነገር ግን የተመረጠው አካል "
"ፋይሎች ለኢሜይሉ እንደ ተመረጡ "
"ይցተያያዛሉ።"

msgid "Settings (YAML)"
msgstr "ቅንብሮች (YAML)"

msgid "Enter the element name and properties as YAML."
msgstr ""
"ኤለመንቱን ስም እና ባህሪያቱን እንደ YAML "
"አስገቡ።"

msgid "Handlers (YAML)"
msgstr "አስተናጋጅ (YAML)"

msgid "Enter the handler id and settings as YAML."
msgstr ""
"የሃንደለር መታወቂያ (handler id) እና "
"ቅንብሮቹን YAML በመጠቀም ያስገቡ።"

msgid "Default handlers"
msgstr "ነባብ አስተናጋጅ (handlers)"

msgid "Setting %name is not a valid setting name."
msgstr ""
"%sname አቀማመጥ (setting) ስም ልክ ያልሆነ "
"የቅንብር ስም አይደለም።"

msgid "Element %key is not a valid element key."
msgstr ""
"አካል %key ትክክለኛ የአካል ቁልፍ (element key) "
"አይደለም።"

msgid "Handler %id is not a valid handler id."
msgstr ""
"හැንደለር %id ትክክለኛ የහැንደለር "
"መታወቂያ (handler id) አይደለም።"

msgid "Debug: Override: @title"
msgstr "ዲባግ፡ መተካት፡ @title"

msgid "Override a webform's settings, elements, and handlers."
msgstr ""
"የዌብፎርም ቅንብሮችን፣ ኤለመንቶቹን እና "
"ሃንደለሮቹን ማሻሻል (Override) ያድርጉ።"

msgid "Elements:"
msgstr "አካሎች፡"

msgid "Handlers:"
msgstr "አስተናጋጅዎች፡"

msgid ""
"Page caching will be disabled when a time restriction is applied to a "
"webform."
msgstr ""
"የገጽ መቆያ መቀመጥ (page caching) የዌብፎርም "
"ላይ የጊዜ ገደብ ሲተገበር ይቦዘናል።"

msgid "Demo: Application Evaluations"
msgstr "የማሳያ፡ የመተግበሪያ ግምገማዎች"

msgid "No evaluations have been submitted."
msgstr "هیڅ ውድድር (ግምገማ) አልተላከም።"

msgid "Example: Variant: A/B test"
msgstr "ምሳሌ፡ ቫሪያንት፡ A/B ሙከራ"

msgid "A feedback form with an A/B test."
msgstr "የA/B ሙከራ የያዘ የግብረመልስ ፎርም።"

