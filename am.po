msgstr "የአቀባዊ ትሮች ማሰናጃዎች"

msgid "Error response message"
msgstr "የስህተት መልዕክት ምላሽ"

msgid "Error response messages"
msgstr "የስህተት መልዕክቶች ምላሽ"

msgid ""
"<strong>ATTENTION DEVELOPERS!!!</strong> The webform submission form's "
" BASE_FORM_ID and FORM_ID have changed."
msgstr ""
"<strong>ልብ ይበሉ ገንቢዎች!!!</strong> "
"የዌብፎርም አቤቱታ (submission) ፎርሙ የ "
"<strong>BASE_FORM_ID</strong> እና <strong>FORM_ID</strong> "
"ሁኔታ ተቀይሯል።"

msgid ""
"Please make sure to update all webform related "
"<code>hook_form_BASE_FORM_ID_alter()</code> and "
"<code>hook_form_FORM_ID_alter()</code> hooks."
msgstr ""
"ദയവായി വെബ്‌ഫോം "
"സംബന്ധമായ എല്ലാ "
"`<code>hook_form_BASE_FORM_ID_alter()</code>` နှင့် "
"`<code>hook_form_FORM_ID_alter()</code>` hooks-ዎን ይዘምኑ።"

msgid "<a href=\":href\">Learn more</a>"
msgstr "<a href=\":href\">ተጨማሪ ይወቁ</a>"

msgid "Custom error response message"
msgstr "የተበጁ የስህተት ምላሽ መልእክት"

msgid ""
"<a "
"href=\"https://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">List "
"of HTTP status codes</a>."
msgstr ""
"<a href=\"https://en.wikipedia.org/wiki/List_of_HTTP_status_codes\">د "
"HTTP நிலை код‌ код‌ಗಳ ዝርዝር</a>"

msgid "Access group"
msgstr "የቡድን መዳረሻ"

msgid ""
"Drupal core does not automatically delete unused files because unused "
"files could reused. For webform submissions it is recommended that "
"unused files are deleted."
msgstr ""
"Drupal core ተጠቃሚ ያልሆኑ ፋይሎችን በራስ ሙሉ "
"ወደፊት በራስ በራስ አይሰርዝም፤ "
"ምክንያቱም ተጠቃሚ ያልሆኑ ፋይሎች "
"እንደገና ሊውሉ ስለሚችሉ ነው። ለዌብፎርም "
"ግብዓቶች ግን ተጠቃሚ ያልሆኑ ፋይሎች "
"እንዲሰረዙ ይመከራል።"

msgid ""
"Drupal core does not immediately delete temporary file. For webform "
"submissions it is recommended that temporary files are immediately "
"deleted."
msgstr ""
"Drupal core የጊዜያዊ ፋይሎችን በቀጥታ "
"አይሰርዝም። ለ webform ማስገባቶች ግን "
"የጊዜያዊ ፋይሎች በፍጥነት እንዲሰረዙ "
"ይመከራል።"

msgid ""
"Uploaded files should be attached to an email and/or remote posted to "
"an external server."
msgstr ""
"උඩුගත කරන ලද ගොනු "
"විද්‍යුත් ලිපියකට අමුණා "
"හෝ/සහෝ බාහිර සේවාදායකයකට "
"දුරස්ථව සකසමින් (remote) පළ කළ "
"යුතුය."

msgid ""
"Upload files will include the file's id, name, uri, and data (<a "
"href=\":href\">Base64</a> encode)."
msgstr ""
"የማስቀመጫ ፋይሎች የፋይሉን id፣ ስሙን፣ "
"uriን እና ውሂቡን ( <a href=\":href\">Base64</a> ኮድ "
"የተደረገ) ይይዛሉ።"

msgid "Field overrides"
msgstr "የመስክ ማሻሻያዎች"

msgid ""
"Use field overrides to override the country-specific address format, "
"forcing specific fields to always be hidden, optional, or required."
msgstr ""
"የመስክ ነጥቦች (field overrides) ተጠቅመው "
"በአገር-ተኮር የአድራስ ቅርጸ ተወላጅነትን "
"ለመቀየር ያስችሉ፤ ይህም ተወሰኑ መስኮች "
"ሁልጊዜ እንዲደበቁ፣ እንዲመረጡ (optional) "
"ወይም እንዲጠየቁ (required) በቋሚነት "
"ለመገደብ ያስችላል።"

msgid "Webform plugins"
msgstr "የድረ-ቅጽ ፕላጊኖች"

msgid "Overview of plugins used by the Webform module."
msgstr ""
"የ Webform ሞጁል የሚጠቀሙ ፕላጊኖች አጠቃላይ "
"እይታ።"

msgid "Webform plugins: Elements"
msgstr "የድር ቅጽ ተሰኪዎች፦ አካሎች"

msgid "Webform plugins: Handlers"
msgstr ""
"የድረ-ገጽ ፎርም ፕላጊኖች፦ ተቆጣጣሪዎች "
"(Handlers)"

msgid "Webform plugins: Exporters"
msgstr "የድር ፎርም ፕላጊኖች፡ ኤክスポርተሮች"

msgid "Preset dialog options"
msgstr "ቅድሚያ የተቀመጡ የውይይት አማራጮች"

msgid "Dialog name"
msgstr "የመግባባት ስም"

msgid "Dialog title"
msgstr "የዳይአሎግ ርዕስ"

msgid "Dialog height"
msgstr "የውይይት ቁመት"

msgid "more items"
msgstr "ተጨማሪ እቃዎች"

msgid ""
"<strong>Warning</strong>: The below settings give users, permissions, "
"and roles full access to this webform and its submissions."
msgstr ""
"<strong>ማስጠንቀቂያ</strong>: ከዚህ በታች ያሉት "
"ቅንብሮች ተጠቃሚዎች፣ ፈቃዶች እና ሚናዎች "
"ለዚህ ድረ-ገጽ ቅጽ (webform) እና ለእሱ "
"አቤቱታዎች ሙሉ መዳረሻ ይሰጣሉ።"

msgid "Dialog settings"
msgstr "የዳይሎግ ቅንብሮች"

msgid "A message to be displayed when there are previous submissions."
msgstr ""
"قبлዎ የተላኩ ንዑስ ምልክቶች ካሉ ሲታይ "
"ሊታይ የሚገባ መልእክት።"

msgid "Enter preset dialog options available to all webforms."
msgstr ""
"ሁሉም የዌብፎርሞች ዝርዝር መቀናበሪያ "
"ለሚገኙ ቅድመ መርጫ አማራጮች ያስገቡ።"

msgid ""
"Name must be lower-case and contain only letters, numbers, and "
"underscores."
msgstr ""
"ስሙ ትንሽ ፊደል (lower-case) መሆን አለበት እና "
"ፊደሎች፣ ቁጥሮች እና አണ്ടർስኮር (“_”) "
"ብቻ መያዝ አለበት።"

msgid "Width and height are optional."
msgstr "ስፋት እና ቁመት አማራጭ ናቸው።"

msgid "Summary attributes"
msgstr "የማጠቃለያ አትሪቡቶች"

msgid ""
"Apply classes to the details' summary around both the field and its "
"label."
msgstr ""
"የመስኩን እና መለያውን አካባቢ ውስጥ "
"ባለው የዝርዝር መጠቃለያ (details' summary) ላይ "
"ክፍሎችን (classes) ተግብር።"

msgid "Apply custom styles to the details' summary."
msgstr ""
"የዝርዝሮችን ማጠቃለያ (summary) ላይ ብጁ "
"ስታይሎችን ተፈጽም።"

msgid "Enter additional attributes to be added to the details' summary."
msgstr ""
"የዝርዝሮቹ ማጠቃለያ (summary) ላይ ሊታከሉ "
"የሚችሉ ተጨማሪ ባህሪዎችን ያስገቡ።"

msgid "@total webform.webform.* configuration file(s) updated."
msgstr "የ@total webform.webform.* ውቅር ፋይ(ሎች) ዘምኗል።"

msgid "No webform.webform.* configuration files updated."
msgstr "የwebform.webform.* ውቅር ፋይሎች አልተዘመኑም።"

msgid "Archived [@total]"
msgstr "ተመዝግቧል [@total]"

msgid ""
"This webform is <a href=\":href\">closed</a>. Only submission "
"administrators are allowed to access this webform and create new "
"submissions."
msgstr ""
"ይህ ዌብፎርም <a href=\":href\">ተዘግቷል</a>። "
"የማስገባት አስተዳዳሪዎች ብቻ ይህን "
"ዌብፎርም ለመግባት እና አዳዲስ ማስገባቶች "
"ለመፍጠር ይፈቀድላቸዋል።"

msgid ""
"This webform is <a href=\":href\">archived</a>. Only submission "
"administrators are allowed to access this webform and create new "
"submissions."
msgstr ""
"ይህ የድር ቅጽ <a href=\":href\">ተመዝግቦ "
"ቆይቷል</a>። የቅጹ ግብአትን (submission) "
"እንዲቀርቡ እና አዲስ ግብአቶችን "
"እንዲፈጥሩ በዚህ የድር ቅጽ መድረስ "
"የሚፈቀድላቸው የግብአት አስተዳዳሪዎች "
"ብቻ ናቸው።"

msgid ""
"This webform's <a href=\":href\">submission handlers</a> requires "
"submissions to be saved to the database."
msgstr ""
"ይህ የድር ፎርሙ የ <a href=\":href\">የግቤት "
"አስተናጋጆች</a> ያስፈልጉት ግቤቶች ወደ "
"ዳታቤዝ እንዲቀመጡ ነው።"

msgid ""
"You are previewing the below template, which can be used to <a "
"href=\":href\">create a new webform</a>. <strong>Submitted data will "
"be ignored</strong>."
msgstr ""
"ከዚች በታች ያለውን ቴምፕሌት እየተመለከቱ "
"ነው፤ ይህም አዲስ የድር ፎርም ለመፍጠር "
"ሊጠቅም ይችላል። <strong>የተላከው መረጃ ችላ "
"ይባላል</strong>።"

msgid "No items entered. Please add items below."
msgstr ""
"አንዳች እቃ አልተገባም። እባክዎ ከታች "
"እቃዎችን ያክሉ።"

msgid "Currently loaded drafts will be deleted when the form is reset."
msgstr ""
"አခု ተጭኖ የተጫኑ ረቂቆች ቅጹ ሲደገም "
"(reset) ሲያደርግ ይሰረዛሉ።"

msgid ""
"If checked, this webform will be closed and unavailable to webform "
"blocks and fields."
msgstr ""
"اگر ተምርቷ ከሆነ፣ ይህ የድር-ቅጹ ተዘግቶ "
"ለድር-ቅጽ ብሎኮችና መስኮች የማይገኝ "
"ይሆናል።"

msgid "Label attributes"
msgstr "የመለያ (Label) ባህሪያት"

msgid "Apply classes to the element's label."
msgstr ""
"አባል (element) መለያው (label) ላይ ክፍሎችን "
"(classes) ተግብር።"

msgid "Apply custom styles to the element's label."
msgstr ""
"የእቃውን መለያ (label) ላይ ተጠቃሚ የሆኑ "
"ቅጦችን ተግብር።"

msgid "Enter additional attributes to be added to the element's label."
msgstr ""
"የእቃው መለያ (label) ላይ ሊጨመሩ የሚችሉ "
"ተጨማሪ ባህሪዎችን ያስገቡ።"

msgid "Exclude unselected checkbox"
msgstr "የማልተመረጠውን ሳጥን አስወግድ"

msgid "Allows viewing <em>own</em> submissions for all webforms."
msgstr ""
"ለሁሉም የድር ቅጾች የ<em>ራስዎ</em> "
"ማስገቢያዎችን ማየት ይፈቅዳል።"

msgid "Allows updating <em>own</em> submissions for all webforms."
msgstr ""
"ለሁሉም ዌብፎርሞች የራስዎን <em>ገቢዎች</em> "
"ማዘመን ያስችላል።"

msgid "Allows deleting <em>own</em> submissions for all webforms."
msgstr ""
"ለሁሉም የድር ቅጾች የራስዎን <em>ብቻ</em> "
"ግቤቶች መሰረዝ ይፈቅዳል።"

msgid "Export temporary directory"
msgstr "የጊዜያዊ ክታብ መውጫ ማውጣት"

msgid "Hide accessibility"
msgstr "ተደራሽነትን ደብቅ"

msgid "Show accessibility"
msgstr "**Accessibilityን ያሳዩ**"

msgid "Enable required"
msgstr "አስፈላጊ አንቃ (Enable) ነቃ ያድርጉ"

msgid "Enable client-side validation"
msgstr ""
"የደንበኛ-በጎን ማረጋገጫ (client-side validation) "
"አንቃ።"

msgid "Webform Examples Accessibility"
msgstr "የዌብፎርም ምሳሌዎች ተደራሽነት"

msgid ""
"This presentation is about approaching accessibility using the Webform "
"module for Drupal 8."
msgstr ""
"ይህ አቀራረብ በ Drupal 8 ውስጥ Webform ሞጁልን "
"በመጠቀም ተደራሽነትን (accessibility) ለመቅረብ "
"ስልት ላይ ያተኮረ ነው።"

msgid "Accessibility | Drupal.org"
msgstr "ተደራሽነት | Drupal.org"

msgid "The Webform module aims to be accessible to all users."
msgstr ""
"የWebform ሞጁል ለሁሉም ተጠቃሚዎች "
"እንዲደረስ የሚያስችል መሆንን ይፈልጋል።"

msgid ""
"A flexible SASS component to illustrate the steps in a multi-step "
"process e.g. a multi-step form, a timeline or a quiz."
msgstr ""
"በብዙ ደረጃዎች ሂደት (ለምሳሌ ብዙ ደረጃ "
"ፎርም፣ የጊዜ መስመር ወይም ኩይዝ) ውስጥ "
"ደረጃዎቹን ለማሳየት የሚያስችል ተጣጣፊ "
"SASS ኮምፖነንት።"

msgid "The text displayed within a multi-step wizard's progress bar"
msgstr ""
"ባහු-ደረጃ ረዳት (wizard) የእድገት አሞሌ "
"ውስጥ የሚታየው ጽሑፍ"

msgid "Advanced address"
msgstr "የላቀ አድራሻ"

msgid ""
