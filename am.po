"Enter message to be displayed when file upload limit is reached. You "
"may use %quota as a placeholder."
msgstr ""
"የፋይል አባል (upload) ገደቡ ሲደርስ የሚታይ "
"መልዕክት ያስገቡ። %quotaን እንደ ቦታ "
"ማስቀመጫ (placeholder) መጠቀም ይችላሉ።"

msgid ""
"You must allow users to post submissions from a dedicated URL to use "
"open this webform is a dialog."
msgstr ""
"အသုံးပြုသူ들이 သီးသန့် URL "
"တစ်ခုမှ "
"တင်သွင်းချက်များကို "
"စာရင်းသွင်းနိုင်အောင် "
"သင်သည် "
"ထိုဝက်ဘ်ဖောင်မ်ကို "
"ဖွင့်ရန် (open this webform) "
"ဒိုင်ယာလော့ဂ်အဖြစ် "
"အသုံးပြုခွင့် ပေးရမည်။"

msgid "Please delete submissions from the selected webforms."
msgstr ""
"ദയവായി "
"തിരഞ്ഞെടുക്കപ്പെട്ട "
"വെബ്ഫോമുകളിൽ നിന്നുള്ള "
"സമർപ്പണങ്ങൾ മായ്ക്കുക."

msgid "The selected webforms have a total of @total submissions."
msgstr ""
"የተመረጡት ዌብፎርሞች በአጠቃላይ @total "
"ማስገቢያዎች አሏቸው።"

msgid ""
"You may not delete these webforms until there is less than @batch "
"total submissions."
msgstr ""
"@batch ጠቅላላ ምዝገባዎች ከበለጠ በታች "
"እስኪሆን ድረስ እነዚህን የድረ-ገጽ ቅጾች "
"(webforms) መሰረዝ አትችሉም።"

msgid "Filter by data and/or notes"
msgstr ""
"ውሂብ እና/ወይም ማስታወሻዎች በመጣራት "
"ያጣሩ"

msgid ""
"If checked, support option, displayed on the <a "
"href=\":help_href\">Help</a> page will be disabled."
msgstr ""
"ከተምረጡ የተሻሻለው የድጋፍ አማራጭ፣ በ <a "
"href=\":help_href\">Help</a> ገጽ ላይ የሚታየው "
"ይቦዘናል።"

msgid "Minimum amount of items displayed"
msgstr "በሚታየው የተግባር ነገሮች ዝቅተኛ ብዛት"

msgid "Date part title display"
msgstr "የቀን ክፍል ಶنوان ማሳያ"

msgid "Determines the placement of the title for date parts."
msgstr ""
"ቀን ክፍሎች ውስጥ ርዕሱ የሚቀመጥበትን "
"ቦታ ይወስናል።"

msgid ""
"For more advanced use-cases like rendered entities or more complex "
"entity filtering or sorting, you may want to use the \"Views: Filter "
"by an entity reference view\" reference method."
msgstr ""
"እንደ ተደረጉ አካሎች (rendered entities) ያሉ "
"የበለጠ ውስብስብ የአጠቃቀም አጋጣሚዎች "
"ወይም የበለጠ ውስብስብ የአካል ማጣሪያ "
"(filtering) ወይም ማስተካከል (sorting) ለማድረግ "
"ከፈለጉ፣ “Views: Filter by an entity reference view” "
"የሚለውን የማጣቀሻ ዘዴ መጠቀም ትፈልጉ "
"ይሆናል።"

msgid "Justify content"
msgstr "محتואን አስተካክል (justify) ማድረግ"

msgid "Space between (space-between)"
msgstr "በመካከል ያለ ርቀት (space-between)"

msgid "Space around (space-around)"
msgstr "(space-around) ዙሪያ ያለው ቦታ"

msgid "Terms display"
msgstr "የቃላት መታያ"

msgid "Terms link"
msgstr "የመደብ/ውሎች ማገናኛ"

msgid "Enter the URL or path of the terms of service."
msgstr ""
"የተገልጋይ አገልግሎት (terms of service) የURL "
"ወይም መንገድ (path) ያስገቡ።"

msgid "Terms link target"
msgstr "የቃላት አገናኝ  hዝግጅት ዓላማ"

