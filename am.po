msgstr "የsitemap ካርታውን ለፍለግ ሞተሮች ያስገቡ።"

msgid "Default priority"
msgstr "የነባር ቅድሚያ (priority)"

msgid "Indexed"
msgstr "Index කරされた ነው"

msgid "Minimum sitemap lifetime"
msgstr ""
"የአንድ የsitemap ከፍተኛ የህይወት ጊዜ (Minimum "
"sitemap lifetime)"

msgid "No minimum"
msgstr "የአነስተኛው መጠን የለም"

msgid "Number of links in each sitemap page"
msgstr ""
"በእያንዳንዱ የsitemap ገጽ ላይ ያሉ የሊንኮች "
"ብዛት"

msgid "Maximum number of sitemap links to process at once"
msgstr ""
"በአንድ ጊዜ ለመወሰን (ለማስኬድ) የሚቻሉ "
"ከፍተኛ የsitemap ሊንኮች ቁጥር"

msgid ""
"If you have problems running cron or rebuilding the sitemap, you may "
"want to lower this value."
msgstr ""
"cron ማስኬድ ወይም የ sitem​ap እንደገና "
"መገንባት ችግኝ ካጋጠሙዎት፣ ይህን እሴት "
"ማውረድ ተገቢ ሊሆን ይችላል።"

msgid "Sitemap cache directory"
msgstr "የሳይትማፕ መደብር (cache) ማከማቻ አቃፊ"

msgid "Invalid base URL."
msgstr "የመሠረት ዩአርኤል ልክ አይደለም።"

msgid "Your sitemap is up to date and does not need to be rebuilt."
msgstr ""
"የඔር ስाइटમેప్ ወቅታዊ ነው እና "
"እንደገና እንዲገነባ አያስፈልግም።"

msgid "The priority of this URL relative to other URLs on your site."
msgstr ""
"በጣቢያዎ ላይ ካሉ ሌሎች ዩአርኤሎች ጋር "
"በተነጻጻሪ ይህ ዩአርኤል ያለው ቅድሚያ "
"(priority)።"

msgid "Default (@value)"
msgstr "ነባሪ (@value)"

msgid "Rebuilding Sitemap"
msgstr "Сitemap እንደገና መገንባት"

msgid "Click on the table headers to change sorting."
msgstr ""
"ማስታወቂያዎች ላይ የሚሰሩትን ሰንጠረዥ "
"ርዕሶች በመጫን መለያየት (sorting) ለመቀየር "
"ይችላሉ።"

msgid "Path to link"
msgstr "ወደ ማገናኛው መንገድ"

msgid "There is already an existing link in the sitemap with the path %link."
msgstr ""
"የsitemap ውስጥ በዚህ መንገድ %link ጋር ያለ "
"አስቀድሞ የተቀመጠ ሊንክ አሁን አለ።"

msgid "The custom link for %loc was saved."
msgstr "የ%loc ተፈጥሯዊ አገናኝ ተቀምጧል።"

msgid "The custom link for %loc has been deleted."
msgstr "የ%loc ተግባራዊ አገናኝ ተሰርዟል።"

msgid "Adds user configurable links to the sitemap."
msgstr ""
"ለsitemap መጠቃለያ የሚሆኑ ተጠቃሚ በፈቃድ "
"ሊቀናጅ የሚችሉ አገናኞችን ያክላል።"

msgid "Submit the sitemap to the following engines"
msgstr ""
"ከሚከተሉት የፍለጋ ሞተሮች ጋር የሲትማፕ "
"ላክ/አቅርብ"

msgid "Do not submit more often than every"
msgstr ""
"ከየትኛውም ጊዜ በፊት ይህን ያህል "
"በማንሳት ከሚታወቀው ጊዜ እንዳትይቀር "
"እርስዎ በየጊዜው በተደጋጋሚ አትላኩ።"

msgid "Only submit if the sitemap has been updated since the last submission."
msgstr ""
"የካርታ (sitemap) ከቀድሞው ማስገባት በኋላ "
"ከተዘመነ ብቻ ያስገቡ።"

msgid "Custom submission URLs"
msgstr "ብጁ የአቋራጭ የመልእክት URLዎች"

msgid "Submitted the sitemap to %url and received response @code."
msgstr ""
"%url ላይ የsitemap ን ተልክቻለሁ እና ምላሹን "
"@code እንደተቀበልኩ አግኝቻለሁ።"

msgid "Search Engines"
msgstr "የፈለጊ ሞተሮች"

msgid "Automatic (recommended)"
msgstr "ራስሰር (የሚመከር)"

msgid "(highest)"
msgstr "(ከፍተኛው)"

msgid "(normal)"
msgstr "(መደበኛ)"

msgid "(lowest)"
msgstr "(በጣም ዝቅተኛ)"

msgid "Please increase the number of links per page."
msgstr ""
"ദయፋ እባክዎ በገጽ ላይ ያሉ ሊንኮችን "
"ብዛት ያሳድጉ።"

msgid "Include a stylesheet in the sitemaps for humans."
msgstr ""
"ለሰዎች የሚሆን የቅጥ ሉህን በsitemaps ውስጥ "
"ያካትቱ።"

msgid "Save and restore any custom inclusion and priority links."
msgstr ""
"ማንኛውንም ብጁ የማካተት እና የቅድሚያ "
"አገናኞችን ማስቀመጥ እና መመለስ (restore) "
"ያድርጉ።"

msgid "Inclusion: @value"
msgstr "መካተት፦ @value"

msgid "Priority: @value"
msgstr "ቅድሚያ፦ @value"

msgid ""
"Changing these type settings will affect any items of this type that "
"have either inclusion or priority set to default."
msgstr ""
"እነዚህን የዓይነት ቅንጅቶች መቀየር "
"በነባሪ ላይ የተቀመጠ ወይም በማካተት "
"(inclusion) ወይም በቅድሚያ (priority) የተቀመጠ "
"ያለው ይህ ዓይነት ያላቸውን ማንኛውንም "
"እቃዎች ላይ ተፅእኖ ያደርሳል።"

msgid ""
"How frequently the page is likely to change. This value provides "
"general information to search engines and may not correlate exactly to "
"how often they crawl the page."
msgstr ""
"ይህ ገፁ ምን ያህል በየጊዜው ሊቀየር "
"እንደሚችል ግምት የሚሰጥ መረጃ ነው። ይህ "
"እሴት ለፍለጋ ሞተሮች አጠቃላይ መረጃ "
"ይሰጣል እና ገፁን እነሱ በየጊዜው "
"በትክክል እንዴት እንደሚሳቡ (crawl) "
"ከሚሆነው ጋር በትክክል የተመጣጠነ ሊሆን "
"አይችልም።"

msgid "The directory %directory does not exist or is not writable."
msgstr ""
"የ%s%directory ማውጫ የለም ወይም መፃፍ "
"አይቻልም።"

msgid "Select which link types you would like to rebuild"
msgstr ""
"የትኞቹን የአገናኝ ዓይነቶች "
"እንደምትመልሱ (rebuild) መምረጥ "
"እንደምትፈልጉ ይምረጡ።"

msgid ""
"If no link types are selected, the sitemap files will just be "
"regenerated."
msgstr ""
"هیڅ አገናኝ ዓይነቶች ካልተመረጡ የ sitemap "
"ፋይሎቹ በቃ እንደገና ይተነካሉ "
"(ይታደሳሉ)።"

msgid ""
"Check the <a href=\"@status-report\">status report</a> for more "
"information."
msgstr ""
"ለበለጠ መረጃ የ <a href=\"@status-report\">ሁኔታ "
"ሪፖርቱን</a> ይመልከቱ።"

msgid "Last modification date format"
msgstr "የመጨረሻ ማሻሻያ ቀን ቅርጸ-አቀማመጥ"

msgid "Enable developer mode to expose additional settings."
msgstr ""
"አပိုም ማስተካከያዎችን ለማሳየት "
"የገንቢ ሁነታን አግብር።"

msgid ""
"Enter one URL per line. The token [sitemap] will be replaced with the "
"URL to your sitemap. For example: %example-before would become "
"%example-after."
msgstr ""
"በመስመር አንድ ዩአርኤል ብቻ ያስገቡ። "
"ቶከኑ “[sitemap]” ከእርስዎ የsitemap ዩአርኤል "
"ጋር ይተካል። ለምሳሌ፣ %example-before ወደ "
"%example-after ይቀየራል።"

msgid "Invalid URL %url."
msgstr "የማይታወቅ ዩአርኤል %url።"

msgid "Prefetch URL aliases during sitemap generation."
msgstr ""
"ፍርጅት (sitemap) ሲፈጠር የ URL አልያሶችን "
"ቀድሞ ማውረድ (prefetch)።"

msgid ""
"If there are problems with rebuilding the sitemap, you may want to "
"manually set this value. If you have more than @max links, an index "
"with multiple sitemap pages will be generated. There is a maximum of "
"@max sitemap pages."
msgstr ""
"የ sitemapን እንደገና ለመገንባት ችግኝ "
"ካለበት፣ ይህን ዋጋ በእጅ ማስቀመጥ "
"ትችላለህ። ከ @max በላይ ሊንኮች ካሉ በርካታ "
