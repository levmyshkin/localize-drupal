msgstr "@title: @unit"

msgctxt "Imperial height unit"
msgid "Inches"
msgstr "ኢንች"

msgid "Height settings"
msgstr "የቁመት ቅንብሮች"

msgid "Height element type"
msgstr "የከፍታ አካል አይነት"

msgid "Select menu with suffixes"
msgstr ""
"የመነሻ ምናሌን በተራፊ ቃላቶች (suffixes) "
"ይምረጡ"

msgid "Height suffix format"
msgstr "የቁመት ተቀናቃኝ (suffix) ቅርጸት"

msgid "Units (feet/foot and inches/inch)"
msgstr "ክፍሎች (ጫማ/ጫማ እና ኢንች/ኢንች)"

msgid "Abbreviated units (ft and in)"
msgstr "አጭር ክፍሎች (ft እና in)"

msgid "Symbols (″ and ′)"
msgstr "ምልክቶች (″ እና ′)"

msgid "Feet minimum"
msgstr "కम минимум"

msgid "Specifies the feet's minimum value."
msgstr "የእግሩን ዝቅተኛ ዋጋ ይገልጻል።"

msgid "Feet maximum"
msgstr ""
"ከፍተኛ የሚፈቀድ እስከ ድንጋጌ እግሮች (Feet "
"maximum)"

msgid "Specifies the feet's maximum value."
msgstr "የእግር መጠኑ ከፍተኛ ዋጋውን ይወስናል።"

msgid "@title: Feet"
msgstr "@title: እግሮች"

msgid "@title: Inches"
msgstr "@title: ኢንች"

msgid "Height (feet/inches)"
msgstr "ቁመት (ጫማ/ኢንች)"

msgid "Access the webform help page"
msgstr "የዌብፎርም የእርዳታ ገጹን ይክፈቱ"

msgid "Allow users to delete a submission using a secure token"
msgstr ""
"အသုံးပြုသူများသည် "
"လုံခြုံရေး တိုကင် (secure token) "
"ကို အသုံးပြုခြင်းဖြင့် "
"တင်သွင်းချက်တစ်ခုကို "
"ဖျက်နိုင်စေရန် "
"ခွင့်ပြုပါ။"

msgid ""
"The below Ajax scroll, effect, and speed settings will also be applied "
"to cards."
msgstr ""
"নከታች ያሉት የ Ajax ስክሮል፣ የውጤት (effect) "
"እና የፍጥነት (speed) ቅንብሮች ለካርዶችም "
"ተፈፃሚ ይሆናሉ።"

msgid "Page/card name (?page=contact)"
msgstr "የገጽ/ካርድ ስም (?page=contact)"

msgid "Page/card index (?page=2)"
msgstr "የገጽ/ካርድ ኢንዴክስ (?page=2)"

msgid "is not checked"
msgstr "ማርከስ አልተፈተሸም"

msgid ""
"If checked, the generated file's carriage returns will be compatible "
"with Excel and a marker flagging the data as UTF-8 will be added at "
"the beginning."
msgstr ""
"ከተመረጠ፣ የተፈጠረው ፋይል የመጓጓዣ "
"(carriage returns) መጠኖች ከኤክሴል ጋር ተኳሃኝ "
"ይሆናሉ እና ውሂቡን እንደ UTF-8 የሚያመለክት "
"ምልክት በመጀመሪያ ላይ ይታከላል።"

msgid ""
"If multiple email addresses are entered the '@name' will be not "
"included in the email."
msgstr ""
"ብዙ የኢሜይል አድራሻዎች ከገቡ የ«@name» "
"ስሙ በኢሜይሉ ውስጥ አይካተትም።"

msgid "Submission Delete"
msgstr "የማስገባት ሰርዝ"

msgid "The URL alias has to start with a slash and cannot end with a slash."
msgstr ""
"URL አሊያሱ በስጠት (/) መጀመር አለበት እና "
"በስጠት (/) ላይ መጨረስ አይችልም።"

msgid "The base path has to start with a slash and cannot end with a slash."
msgstr ""
"መሰረታዊ መንገዱ በሰረዝ (/) መጀመር "
"አለበት እና በሰረዝ (/) መጨረስም "
"አይችልም።"

msgid "Submission access token settings"
msgstr "የንቀሳቃሽ መዳረሻ ቶከን ማሰናጃዎች"

msgid "The webform (@webform) is broken or missing."
msgstr ""
"የዌብፎርም (@webform) ተበልሷል ወይም "
"አልተገኘም።"

msgid ""
"To add details and fieldsets this vertical tabs element, you must "
"defined a custom <code>'#group': vertical_tab_key</code> property in "
"the details or fieldset element with this vertical tabs' element key."
msgstr ""
"ይህን የvertical tabs ኤለመንት ዝርዝሮችን እና "
"fieldsets ለማከል በdetails ወይም fieldset ኤለመንቱ "
"ውስጥ ከዚህ የvertical tabs ኤለመንት ቁልፍ ጋር "
"እኩል የሆነ የvertical tabs ኤለመንት ቁልፍ "
"የሚያመለክት የ`<code>'#group': vertical_tab_key</code>` "
"ንብረት ብጁ ልትገልጽ ይገባል።"

msgid ""
"The default tab must be the [id] attributes of the details or fieldset "
"element."
msgstr ""
"ነባሩ ትር (tab) የዚያ ዝርዝር (details) ወይም "
"fieldset አካል የ `id` ባህሪዎች (attributes) መሆን "
"አለበት።"

msgid ""
"A short description of the element used as help for the user when they "
"use the webform."
msgstr ""
"ዌብֆormን ሲጠቀሙ ተጠቃሚው ለመረዳት እንደ "
"እርዳታ የሚጠቀሙት ኤለመንት አጭር "
"መግለጫ።"

msgid "level(s)"
msgstr "ደረጃ/ደረጃዎች"

msgid "Default wizard/cards show all elements label"
msgstr ""
"የነባር ዊዛርድ/ካርዶች ሁሉንም ክፍሎች "
"መለያ ያሳያሉ"

msgid "Default wizard/cards hide all elements label"
msgstr ""
"ነባሪ wizard/cards ሁሉንም ክፍሎች መለያ "
"ይደብቃሉ"

msgid ""
"It is recommended that these libraries are installed in your Drupal "
"installation's /libraries or /web/libraries directory."
msgstr ""
"این کتابخانه‌ها የእርስዎ የDrupal መጫኛ "
"ከሚደረግበት ውስጥ በ /libraries ወይም "
"/web/libraries ዳይሬክቶሪ ውስጥ መጫን "
"እንደሚመከር ነው።"

msgid "Filter by exporter label"
msgstr "በላኪ መለያ ስም መሰናዶ ያድርጉ"

msgid "exporter"
msgstr "ላኪ (exporter)"

msgid "exporters"
msgstr "ላኪዎች"

msgid "Enter a part of the exporter label to filter by."
msgstr ""
"የማጣሪያ መስፈርት ለማድረግ "
"የኤክስፖርተሩ መለያ ስም (label) ክፍል "
"ያስገቡ።"

msgid "Filter by handler label"
msgstr "የአስተናጋጅ መለያ መለኪያ በመምረጥ ያጣሩ"

msgid "Enter a part of the handler label to filter by."
msgstr ""
"የክንውን መለያ (handler label) ከዚህ መጀመሪያ "
"የሚያጣራ በመሆኑ ክፍል ጽሑፍ ያስገቡ።"

msgid "Filter by variant label"
msgstr "የተለያዩ መለያ በመለያ ይጣሩ"

msgid "Enter a part of the variant label to filter by."
msgstr ""
"የተለያዩ መለያ (variant label) ከምን ክፍል "
"በመረጃ ለማጣራት ነው፣ ያንን ክፍል "
"ያስገቡ።"

msgid ""
"If set, this message will be used when a required likert question is "
"empty, instead of the default \"X field is required.\" message. To "
"include the question title in the required message, please include the "
"@name placeholder in the required message."
msgstr ""
"ይህ ከተቀናበረ (set) በኋላ፣ ይህ መልእክት "
"የሚያስፈልግ ሊከርት (likert) ጥያቄ ባዶ ሲሆን "
"ከነባሩ “X field is required.” መልእክት ፋንታ "
"ይጠቀማል። በተፈለገው መልእክት ውስጥ "
"የጥያቄውን ርዕስ ለማካተት፣ እባክዎ @name "
"የማተኪያ (placeholder) ን በመልእክቱ ውስጥ "
"ያካትቱ።"

msgid "Specifies the day(s) of the week."
msgstr "የሳምንቱ ቀናት (ቀኖቹን) ይገልጻል።"

msgid ""
"<strong>ATTENTION!!!</strong> The default Contact webform, included "
"with the Webform module, has been updated to send the confirmation "
"email to an authenticated user's email address."
msgstr ""
"<strong>አስተውሉ!!!</strong> በ Webform ሞጁል ውስጥ "
"የተካተተው ነባር የመገናኛ ዌብፎርም "
"የማረጋገጫ ኢሜይሉን ለማረጋገጫ "
"ስለተግባር የተፈቀደ (authenticated) ተጠቃሚ "
"የኢሜይል አድራሻ እንዲላክ ተዘምኗል።"

msgid "Disable support options"
msgstr "የድጋፍ አማራጮችን ያሰናክሉ"

msgid ""
"Visit the Webform <a "
"href=\"https://www.drupal.org/node/2856146\">documentation pages</a> "
"for an <a "
"href=\"https://www.drupal.org/node/2834423\">introduction</a>, <a "
"href=\"https://www.drupal.org/node/2837024\">features overview</a>, <a "
"href=\"https://www.drupal.org/node/2932764\">articles</a>, <a "
"href=\"https://www.drupal.org/node/2860989\">recipes</a>, and more..."
msgstr ""
"የ Webform ላይ ለ<a "
"href=\"https://www.drupal.org/node/2856146\">ሰነዶቹ</a> "
"ይመልከቱ፤ ለ<a "
"href=\"https://www.drupal.org/node/2834423\">መግቢያ</a>፣ <a "
"href=\"https://www.drupal.org/node/2837024\">ባህሪዎች "
"አጠቃላይ እይታ</a>፣ <a "
"href=\"https://www.drupal.org/node/2932764\">ጽሑፎች</a>፣ <a "
"href=\"https://www.drupal.org/node/2860989\">ምግብ አዘጋጅ "
"ሀሳቦች</a> እና ሌሎችም ይኖራሉ…"

msgid ""
"A unique name for this variant instance. Can only contain "
"@requirements."
msgstr ""
"ለዚህ የተለየ ተለዋዋጭ ስርዓት ምሳሌ "
"የሚሆን ልዩ ስም። የ@requirements ብቻ ይይዟ "
"ሊኖር ይችላል።"

msgid ""
"Get involved in the Drupal community and the Webform module. Review a "
"patch, write documentation, contribute code, volunteer at an event, "
"and more..."
msgstr ""
"የDrupal ማህበረሰብ እና የWebform ሞጁል ውስጥ "
"ተሳተፉ። ፓትች ይመልከቱ፣ ሰነድ ይጻፉ፣ "
"ኮድ ያበርክቱ፣ በአንድ ክስተት ላይ "
"በፍቃደኝነት ይሰሩ እና ሌሎችም..."

msgid "Open to all"
msgstr "ለሁሉም ክፍት ነው"

msgid "Fund development"
msgstr "የፈንድ ልማት"

msgid ""
"Help fund the day-to-day tasks required to maintain the Webform "
"module. Funds are used to triage issues, resolve security issues, and "
"tag new releases."
msgstr ""
"የ Webform ሞጁሉን ለመጠበቅ የሚያስፈልጉ "
"የዕለታዊ ተግባራትን ለመደገፍ እገዛ "
"ይሁን። የሚውሉት ገንዘብ ችግኞችን "
"ለመመርመር ማስተናገድ፣ የደኅንነት "
"ጉዳዮችን ለመፍታት እና አዳዲስ ልቀቶችን "
"(ሪሊዝ) ለመለየት/ለማውጣት ያገለግላል።"

msgid "Fund"
msgstr "ፈንድ"

msgid "Starting at $5 a month"
msgstr "ከየማለትም $5 በወር ጀምሮ"

msgid ""
"<code>:rawurlencode</code> Raw URL encodes returned value with only "
"hex digits."
msgstr ""
"<code>:rawurlencode</code> የጥሬ ዩአርኤል ኮዲንግ "
"ተመላሽ ዋጋውን በhex አኃዞች ብቻ በመጠቀም "
"ዩአርኤል ይመዝግባል።"

msgid "Link label to the referenced webform"
msgstr ""
"ለተጣቀሰው የድር ፎርም ላይ የሚያመለክት "
"መለያ (link) ስም/መለያ (label)"

msgid "The phone number is not valid."
msgstr "የስልክ ቁጥሩ ትክክል አይደለም።"

msgid ""
"Multiple values are comma delimited with any nested commas URI escaped "
"(%2C)."
msgstr ""
"ብዙ እሴቶች በመካከላቸው ትክክለኛ "
"ሰዋሰዋትን የሚያዘምኑ ማንኛውንም ውስጣዊ "
"ኮማዎች በURI ማምለጫ መልክ (%2C) በመጠቀም "
"በነጠላ ኮማ (፣) ይለያያሉ።"

msgid "The Webform module's Open Collective"
msgstr "የ Webform ሞጁሉ Open Collective"

msgid ""
"This screencast provides details about the Webform module's Open "
"Collective"
msgstr ""
"ይህ ስክሪንካስት የ Webform ሞጁል የ Open Collective "
"ባህሪዎችን ዝርዝር መረጃ ያቀርባል።"

msgid "Webform module's Open Collective"
msgstr "የWebform ሞጁል የOpen Collective"

msgid ""
"Generate a composer.json file using <code>drush "
"@webform-libraries-composer</code>."
msgstr ""
"<code>drush @webform-libraries-composer</code> ን ተጠቅሞ "
"composer.json ፋይል ይፍጠሩ።"

msgid ""
"If checked, users will be able save and resume multiple drafts. Please "
"note: Authenticated user need to be able 'view own submissions' to "
"access saved drafts."
msgstr ""
"እንዲህ ከተመረጠ (ከተፈቀደ)፣ ተጠቃሚዎች "
"በርካታ ረቂቆችን ተቀምጠው ማቀጠል "
"ይችላሉ። እባክዎ ይህን ያስታውሱ፦ እውቅ "
"ተጠቃሚ (authenticated user) ተቀምጠ ረቂቆችን "
"ለመድረስ የራሳቸውን "
"“የማስታወቂያ/ማስገቢያ መመልከቻ (view own "
"submissions)” ፈቃድ መኖር አለበት።"

msgid "Webform ida required"
msgstr "የድረ-ፎርም መታወቂያ (ID) ያስፈልጋል።"

msgid "Raw/return value"
msgstr "ጥሬ/የመመለሻ እሴት"

msgid "Currency (+)"
msgstr "ገንዘብ (+)"

msgid "Currency (-)"
msgstr "Mudina ( - )"

msgid "Currency (+/-)"
msgstr "ገንዘብ (+/-)"

