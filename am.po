msgstr "@type: @tel x@ext"

msgid "@tel x@ext"
msgstr "@tel x@ext"

msgid "@type: @tel"
msgstr "@type: @tel"

msgid "@tel"
msgstr "@tel"

msgid "Telephone advanced"
msgstr "ስልክ የላቀ ቅንብሮች"

msgid ""
"Provides a form element to display a telephone number with type and "
"extension."
msgstr ""
"ტелекאָמንዌዜ ምሳሌ ለማሳየት "
"የሚያስችል የስልክ ቁጥር አይነት እና "
"ማስፋፊያ (extension) ጋር የሚያሳይ ቅጽ ክፍል "
"ይሰጣል።"

msgid "Term reference settings"
msgstr "የቃል ማጣቀሻ ማሰናጃዎች"

msgid "Phone type"
msgstr "የስልክ ዓይነት"

msgid "Webform roles"
msgstr "የዌብፎርም ሚናዎች"

msgid "The email addresses of all users assigned to the %title role."
msgstr ""
"የ%title ሚና ተመድበው ላሉት ሁሉም "
"ተጠቃሚዎች ኢሜይል አድራሻዎች።"

msgid ""
"Allows viewing of <em>all</em> submission events, if the user can "
"access a webform's results."
msgstr ""
"အသုံးပြောက်သူသည် ၀ဘဖর্ম "
"(webform) ၏ ရလဒ်များကို "
"ကြည့်ရှုခွင့်ရှိပါက "
"<em>အားလုံး</em>သော "
"တင်သွင်းမှု (submission) "
"ဖြစ်ရပ်များကို "
"ကြည့်ရှုနိုင်စေသည်။"

msgid "Restrict webform element access to certain roles and users."
msgstr ""
"የድር ቅጽ (webform) ኤለመንት መዳረሻን ወደ "
"ተወሰኑ ሚናዎች (roles) እና ተጠቃሚዎች ብቻ "
"ይገድቡ።"

msgid "View any webform submission"
msgstr ""
"ማንኛውንም የድር ፎርም  സമፋ  (submission) "
"ይመልከቱ"

