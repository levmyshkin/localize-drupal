"'የአባት/የኋለኛ ስም'\n"
"    '#type': textfield\n"
"    "
"'#required': true\n"
"  email:\n"
"    '#type': email\n"
"    '#title': "
"'ኢሜይል'\n"
"    '#required': true\n"
"other:\n"
"  '#title': 'ሌላ "
"መረጃ'\n"
"  '#type': fieldset\n"
"  teeshirt:\n"
"    '#type': "
"select\n"
"    '#title': 'የቲሸርት መጠን'\n"
"    "
"'#options':\n"
"      XS: 'XS - በጣም ትንሽ'\n"
"      S: 'S - "
"ትንሽ'\n"
