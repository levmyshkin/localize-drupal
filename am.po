msgstr ""
"የWebform jQuery UI Datepicker ሞጁል ቀን መምረጫዎችን "
"ለመደገፍ ያስፈልጋል። ይህን የቀን መምረጫ "
"ማስጠንቀቂያ በ<a href=\":href\">በሁሉም "
"የWebformዎች ውስጥ #datepicker ባህሪውን "
"በማስወገድ</a> ያጥፉ።"

msgid "The source entity type."
msgstr "የምንጭ አካል ዓይነት።"

msgid ""
"If checked, the preview page/card will include 'Edit' buttons for each "
"previous page/card."
msgstr ""
"ካረጋገጠ በተራ ግለጫ ገጽ/ካርድ ውስጥ "
"ለእያንዳንዱ ቀደም ያለ ገጽ/ካርድ "
"“አርትዕ (Edit)” ቁልፎችን ያካትታል።"

msgid ""
"This setting is only available when 'Enable preview page/card' is "
"enabled."
msgstr ""
"ይህ ቅንብር የ“Preview page/card አስችል” "
"ከተነቃ ብቻ ይገኛል።"

msgid "Disable required"
msgstr "አስፈላጊነቱን አቦዝን"

msgid ""
"Scheduled emails are queued and sent via hourly <a href=\"@href\">cron "
"tasks</a>. To schedule an email for a specific time, site "
"administrators must increase the cron task execution frequency."
msgstr ""
"የታቀዱ ኢሜይሎች ተሰልፈው በየሰዓቱ <a "
"href=\"@href\">cron ስራዎች</a> በኩል ይላካሉ። "
"ለተወሰነ ጊዜ ኢሜይል ለመቆጠብ የድረ ገጹ "
"አስተዳዳሪዎች የcron ስራ አፈጻጸም "
"የተከናወነበትን የድግግሞሽ መጠን ማሳደግ "
"አለባቸው።"

msgid ""
"Provides the \"Scheduled email\" handler, which sends Webform "
"submissions via scheduled email using cron."
msgstr ""
"“Scheduled email” (በተያዘ ጊዜ ኢሜይል) "
"ተቆጣጣሪውን ይሰጣል፣ እሱም በ cron "
"በመጠቀም በተያዘ ጊዜ ኢሜይል በሚላክ "
"መንገድ የ Webform ማስገቢያዎችን ይልካል።"

msgid "Clear default value"
msgstr "ግልጽ ነባሪ ዋጋ"

msgid "This setting is only available when 'Enable preview page' is enabled."
msgstr ""
"ይህ መቼት የ“Preview page” ን እንዲያነቃ "
"ሲደረግ ብቻ ይገኛል።"

msgid ""
"The 'tokenized' URL to delete a submission will be available when "
"viewing a submission's information and can be inserted into an email "
"using the [webform_submission:token-delete-url] token."
msgstr ""
"“tokenized” የሚባለው ዩአርኤል ማስወገጃ "
"(ማጥፊያ) ለማስገባት ይሆናል "
"የማስገቢያውን መረጃ ሲመለከቱ ሲታይ እና "
"በኢሜይል ውስጥ በ [webform_submission:token-delete-url] "
"ቶከን በመጠቀም ሊገባ ይችላል።"

msgid ""
"Use the <a "
"href=\"https://github.com/wikimedia/composer-merge-plugin\">Composer "
"Merge plugin</a> to include the Webform module's <a "
"href=\"https://cgit.drupalcode.org/webform/tree/composer.libraries.json\">composer.libraries.json</a> "
"or generate a custom file using <code>drush webform:libraries:composer "
"&gt; DRUPAL_ROOT/composer.libraries.json</code>."
msgstr ""
"የ <a "
"href=\"https://github.com/wikimedia/composer-merge-plugin\">Composer "
"Merge ፕላጊን</a> ተጠቅመው የ Webform ሞጁሉን <a "
"href=\"https://cgit.drupalcode.org/webform/tree/composer.libraries.json\">composer.libraries.json</a> "
"ለማካተት ይሁን ወይም ከሚታወቀው ፋይል "
"በመፍጠር የተለየ ፋይል ማዘጋጀት ይችላሉ፤ "
"ለማዘጋጀትም <code>drush webform:libraries:composer &gt; "
"DRUPAL_ROOT/composer.libraries.json</code> ይጠቀሙ።"

msgid "Use lazy builder"
msgstr "Lazy builder ይጠቀሙ"

msgid "<code>:base64encode</code> base64 encodes returned value"
msgstr ""
"<code>:base64encode</code> የመመለሰውን እሴት በbase64 "
"ይመረጥ (encode) ያደርጋል"

msgid "Wizard page type"
msgstr "Wizard የገጽ አይነት"

msgid "Wizard page title tag"
msgstr "Wizard የገጽ ርዕስ መለያ (title tag)"

msgid "Default enable page"
msgstr "የነባር ሁኔታ ገጽን ነቅቶ ማብራት"

msgid "email scheduled"
msgstr "ኢሜይል ተሰዷል ለማስተላለፍ"

msgid "email rescheduled"
msgstr "የኢሜይሉ ቀጠሮ ተሰርዞ ተደግሞ ተመድቧል"

msgid "email unscheduled"
msgstr "የኢሜይል መርሐ-ግብር አልተደረገም"

msgid "skipped (disabled)"
msgstr "ወለደ (ተሰናክሏል)"

msgid "scheduled email disabled"
msgstr "የታቀደ ኢሜይል ተጠፍቷል"

msgid "scheduled email skipped"
msgstr "ተዘጋጅቶ የተላከ ኢሜይል ተዘለለ"

msgctxt "Add check mark"
msgid "checked"
msgstr "ማረጋገጠ ነው።"

msgctxt "Remove check mark"
msgid "unchecked"
msgstr "ባለምልክት (Unchecked)"

msgid "This webform has no elements added to it."
msgstr ""
"ይህ የድር ፎርም ውስጥ የተጨመሩ አካላት "
"(elements) የሉትም።"

msgctxt "Add check mark"
msgid "Checked"
msgstr "ተፈትሿል/ተረጋግጧል"

msgctxt "Remove check mark"
msgid "Unchecked"
msgstr ""
"ምልክት ያልተነገረበት/ምልክት "
"ያልተደረገበት"

msgid ""
"%name must be a valid time with intervals from the dropdown (%step "
"min/s)."
msgstr ""
"`%name` ከታች ውስጥ (%step min/s) በሚታየው ክፍተት "
"መሠረት የተወሰነ ትክክለኛ ሰዓት መሆን "
"አለበት።"

msgid "The container used to display a wizard page."
msgstr ""
"የ wizard ገጽን ለማሳየት የተጠቀሙት መያዣ "
"(container)።"

msgid "The page's title HTML tag."
msgstr "د پجېի  శീರ್ಷክ (title) HTML ታግ  (tag)"

msgid "Allow users to post submissions from a dedicated URL for all webform"
msgstr ""
"ለሁሉም የዌብፎርም መላኪያዎች ከተወሰነ "
"ዩአርኤል በኩል ተጠቃሚዎች መላኪያ "
"እንዲለጥፉ ፍቀድ"

msgid ""
"If unchecked, all webform must added to your website using a node, "
"block, or paragraph."
msgstr ""
"ካልተሰየመ (unchecked) ተቆጣጣሪ ከሆነ፣ ሁሉም "
"የድር ፎርም (webform) ወደ ድር ጣቢያዎ በኖድ "
"(node)፣ ብሎክ (block) ወይም በገፅታ (paragraph) "
"በኩል መጨመር አለባቸው።"

msgid "Option text and description"
msgstr "የአማራጭ ጽሑፍ እና መግለጫ"

msgid "Hidden element attributes"
msgstr "የተደበቁ ኤለመንት ባህሪዎች"

msgid ""
"To send email attachments, please install and configure the <a "
"href=\":href_smtp\">SMTP Authentication Support</a> module, the <a "
"href=\":href_mailsystem\">Mail System</a> and <a "
"href=\":href_swiftmailer\">SwiftMailer</a> module or the <a "
"href=\":href_symfony_mailer\">Symfony Mailer</a> module."
msgstr ""
"ኢሜይል አባሪዎችን ለመላክ እባክዎ የ <a "
"href=\":href_smtp\">SMTP Authentication Support</a> ሞጁል፣ የ "
"<a href=\":href_mailsystem\">Mail System</a> ሞጁል እና የ <a "
"href=\":href_swiftmailer\">SwiftMailer</a> ሞጁልን ወይም የ "
"<a href=\":href_symfony_mailer\">Symfony Mailer</a> ሞጁልን "
"ጫን እና ያዋቅሩ።"

msgid "Webform settings tokens."
msgstr "የዌብፎርም ቅንብሮች ቶከኖች።"

msgid "Learn about Webform settings tokens"
msgstr ""
"የWebform ሰረዝ (settings) ቶከኖችን ስለመማር "
"ይወቁ"

msgid "Repairing webform actions…"
msgstr "የዌብፎርም እርምጃዎችን በመጠገን ላይ…"

msgid ""
"Unable to extract @filename to @destination.<br "
"/><pre>@process_output</pre>"
msgstr ""
"@filename ከ @destination ሊወጣ አልቻለም።<br "
"/><pre>@process_output</pre>"

msgid ""
"Multiple email addresses may be separated by commas. Emails are only "
"sent to cc and bcc addresses if a To email address is provided."
msgstr ""
"ብዙ የኢሜይል አድራሻዎች በኮማ ተለይተው "
"ሊጻፉ ይችላሉ። የኢሜይል ማሳወቂያው "
"የሚላከው ወደ “To” ኢሜይል አድራሻ ከተሰጠ "
"ብቻ ነው፤ ከዚያም ብቻ ወደ cc እና bcc "
"አድራሻዎች ይላካል።"

msgid "Adds a 'Schema' tab to the webform builder UI."
msgstr ""
"የድር ፎርም ገንቢ ተጠቃሚ ገጽ (UI) ላይ "
"“ስኬማ” ትር (tab) ይጨምራል።"

msgid "Access webform schema"
msgstr "የድር ቅጽ ስኬማን መድረስ"

msgid "Allows users to view and download a webform's schema"
msgstr ""
"ഉപയോക্তанերին ವೆবフォームයකым "
"schema பார்க்கാനും ഡൗൺলোഡ് "
"ചെയ്യാനും അനുവദിക്കുന്നു"

msgid ""
"Tippy.js a tiny, low-level library for creating \"floating\" elements "
"like tooltips, popovers, dropdowns, menus, and more."
msgstr ""
"Tippy.js እንደ መሳብ (tooltip)፣ ፖፓቨር (popover)፣ "
"ድርብት (dropdowns)፣ ሜኑዎች እና ሌሎች ብዙ "
"ነገሮች ያሉ “ተንሳፋፊ” አካላትን "
"ለመፍጠር ትንሽ፣ ዝቅተኛ ደረጃ (low-level) "
"የሆነ የመደበኛ መጠቀሚያ ቤተ-መፃሕፍት "
"(library) ነው።"

msgid "Popper.js is used to provide tooltip behavior for elements."
msgstr ""
"Popper.js ለአካሎች እንደ መግለጫ ጽሑፍ (tooltip) "
"ባህሪ ለመስጠት ይጠቅማል።"

msgid "Tippy.js is used to provide tooltip behavior for elements."
msgstr ""
"Tippy.js የሚጠቀምበት መሣሪያዎች ላይ መግለጫ "
"(tooltip) ባህሪን ለማቅረብ ነው።"

msgid "Repairing webform HTML editor…"
msgstr "የዌብፎርም HTML ኤዲተርን በመጠገን ላይ…"

msgid "Webform (Default) - DO NOT EDIT"
msgstr "ዌብፎርም (ነባሪ) - አትቀይሩ"

msgid ""
"Download and extract a zipped archive containing all webform libraries "
"(<a href=\":href_61x\">6.1.x</a> or <a href=\":href_62x\">6.2.x</a>) "
"and extract the directories and files to /libraries or /web/libraries"
msgstr ""
"የዚፕ አーカይቭ ፋይል ያውርዱና ይክፈቱ፣ "
"ውስጡም የሁሉም webform ቤተ-መጻሕፍት ይኖሩ (<a "
"href=\":href_61x\">6.1.x</a> ወይም <a "
"href=\":href_62x\">6.2.x</a>) እና ዳይሬክቶሪዎቹን "
"እና ፋይሎቹን ወደ /libraries ወይም /web/libraries "
"ያስገቡ (ያውጡ)።"

msgid "Use a lazy builder to render the form after the page is built/loaded."
msgstr ""
"የገፁ መገንባት/መጫን ከተጠናቀቀ በኋላ "
"ፎርሙን ለማቅረብ ድንግል (lazy) ገንቢ "
"ይጠቀሙ።"

msgid ""
"If checked, the form will be loaded after the page has been built and "
"cached. Lazy builders work best when using the <a "
"href=\":href\">BigPipe</a> module."
msgstr ""
"اگر فعال شوی ከሆነ፣ ፎርሙ ገጹ ተገንብቶ "
"ተ缓存 (cached) ከተደረገ በኋላ ይጫናል። ላዚ "
"ባይልደርስ (Lazy builders) የሚሻለውን ውጤት "
"ሲያገኙ <a href=\":href\">BigPipe</a> ሞጁሉን (module) "
"ሲጠቀሙ ነው።"

msgid "The URL where the user submitted the webform submission."
msgstr ""
"የተጠቃሚው የድረ-ቅጽ ግብአት (webform submission) "
"የተላከበት ዩአርኤል።"

msgid ""
"Click OK to submit the form without finishing the file upload or "
"cancel to return to form."
msgstr ""
"ፋይሉን መጨረስ ካልጨረሰ ወይም ወደ ቅጹ "
"ለመመለስ ለመሰረዝ ካልመረጡ ቅጹን ለመላክ "
"“OK” ይጫኑ።"

msgid ""
"The automatic saving of drafts only applies to previewing when using "
"cards. Please try using the <a href=\":href\">Webform autosave "
"module</a>."
msgstr ""
"ከማስቀመጥ በፊት የረቂቆች ራስ-ማስቀመጥ "
"(automatic saving of drafts) በካርዶች (cards) ሲጠቀሙ "
"በመመልከት (preview) ጊዜ ብቻ ይሠራል። "
"እባክዎ የ <a href=\":href\">Webform autosave module</a> "
"እንዲሞክሩ ይሞክሩ።"

msgid ""
"The <strong>Forms</strong> management page lists all available "
"webforms, which can be filtered by the following: keyword (including "
"title, description, elements, user name, or role), category, and "
"status."
msgstr ""
"የ <strong>ቅጾች</strong> አስተዳደር ገጹ ሁሉንም "
"የሚገኙ ድረ-ገጽ ቅጾች (webforms) ያሳያል፤ "
"እነዚህን በሚከተሉት መስፈርቶች በመጣራት "
"ማጣራት ይቻላል፦ ቁልፍ ቃል (ርዕስ፣ "
"መግለጫ፣ አባሎች፣ የተጠቃሚ ስም ወይም "
"ሚናን ጨምሮ)፣ ምድብ፣ እና ሁኔታ።"

msgid ""
"Hiding the %label button can cause unexpected issues. If checked, make "
"sure there is another 'Submit button(s)' element in your form."
msgstr ""
"%label ቁልፉን መደበቅ ያልተጠበቁ ችግኝዎች "
"ሊያስከትል ይችላል። ከተፈቀደ/ከተሞላ "
"እባክዎ በፎርምዎ ውስጥ ሌላ የ“Submit "
"button(s)” ኤለመንት መኖሩን ያረጋግጡ።"

msgctxt "form"
msgid "Webform"
msgstr "ዌብፎርም"

msgid "Default confirmation noindex"
msgstr "የነባር ማረጋገጫ noindex"

msgid "Example textarea"
msgstr "ምሳሌ ጽሑፍ ሳጥን"

msgid "Please enter some text."
msgstr "ദയاً केही লেখা داخلしてください."

msgid ""
"<strong>Warning:</strong> Opening %type files with spreadsheet "
"applications may expose you to <a href=\":injection_href\">formula "
"injection</a> or other security vulnerabilities. When the submissions "
"contain data from untrusted users and the downloaded file will be used "
"with Microsoft Excel, use the <a href=\":excel_href\">Webform XLSX "
"export</a> module."
msgstr ""
"<strong>ማስጠንቀቂያ፦</strong> የ %type ፋይሎችን "
"በስፕሬድሼት መተግበሪያዎች ሲከፍቱ ወደ <a "
"href=\":injection_href\">የፎርሙላ መወጋት (formula "
"injection)</a> ወይም ሌሎች የደህንነት ጉድለቶች "
"ሊያጋልጡዎት ይችላሉ። ማስገቢያዎቹ "
"ከእምነት ያልተረጋገጡ ተጠቃሚዎች የመጡ "
"ውሂብ ከያዙ እና የተወረደው ፋይል በ Microsoft "
"Excel ሲጠቀሙበት የሚሰራ ከሆነ እባክዎ <a "
"href=\":excel_href\">Webform XLSX export</a> የሚባል ሞጁል "
"ይጠቀሙ።"

msgctxt "module"
msgid "Webform"
msgstr "የድረ-ገጽ ቅጽ"

msgid "Default confirmation robots noindex"
msgstr "ነባሪ እርግጠኝነት ሮቦቶች noindex"

msgid ""
"If checked, a meta tag robots noindex directive  will be added to the "
"confirmation page of all webforms."
msgstr ""
"ከተመረጠ (checked) ማለት የrobots noindex መመሪያ "
"ያለው ሜታ ቴግ በሁሉም ዌብፎርሞች "
"የማረጋገጫ ገጽ ላይ ይጨመራል።"

msgid "Webform submissions can only be unlocked programmatically."
msgstr ""
"የዌብፎርም ማስገቢያዎች በፕሮግራማቲክ "
"መንገድ ብቻ ሊከፈቱ (ሊፈቱ) ይችላሉ።"

msgid ""
"An error occurred while trying to validate the submission. Please save "
"your work and reload this page."
msgstr ""
"የ സമፈጽ (submission) ለማረጋገጥ ሲሞከር "
"ስህተት ተፈጥሯል። ദየስራዎን ያስቀምጡ "
"እና ይህን ገጽ እንደገና ይጫኑ (reload)።"

msgid "@label (Users, custom email addresses, Administrators)"
msgstr ""
"@label（ተጠቃሚዎች፣ ብጁ ኢሜይል "
"አድራሻዎች፣ አስተዳዳሪዎች）"

msgid ""
"If you enjoy and value Drupal and the Webform module consider <a "
"href=\":href_involved\">getting involved in the Drupal community</a>, "
"<a href=\":href_join\">joining the Drupal Association</a>, and <a "
"href=\":href_opencollective\">contributing funds to the Webform "
"module's Open Collective</a>."
msgstr ""
"ዶርፓል እና Webform ሞጁሉን ከወደዱ እና "
"ከምትጠቅሙ ከሆነ የDrupal ማህበረሰብ ውስጥ <a "
"href=\":href_involved\">መሳተፍ</a>፣ <a "
"href=\":href_join\">የDrupal Association መቀላቀል</a> እና "
"<a href=\":href_opencollective\">ለWebform ሞጁሉ የOpen "
"Collective ገንዘብ መመድብ</a>ን እንዲያስቡ "
"ያበረታታል።"

msgid "This behavior is not supported when Ajax is enabled."
msgstr ""
"Ajax ከነቃ ጋር ሲሆን ይህ ባህሪ ድጋፍ "
"አይደረግም።"

msgid ""
"If checked, the browser back button will submit the previous page and "
"navigate back emulating the behavior of user clicking a wizard or "
"preview page's back button."
msgstr ""
"اگر چک شده باشد، د بر라우ዘer ተ వెደው "
"“back” ቁልፍ ቀደም ገጹን ይልካል እና "
"የ“wizard” ወይም የ“preview” ገጽ የትኩረት "
"“back” ቁልፍን የተጠቃሚው መንገድ "
"በመኮረጅ ወደኋላ ይመልሳል።"

msgid "@name must be %max @type but is currently %length @type long."
msgstr ""
"@name ያለበት መሆን አለው %max @type ግን በአሁኑ "
"ጊዜ %length @type ረጅም ነው።"

msgid "@name must be at least %min @type but is currently %length @type long."
msgstr ""
"@name ቢያንስ %min @type መሆን አለበት፣ ነገር "
"ግን በአሁኑ ጊዜ %length @type ርዝመት ነው።"

msgid "Decimal (-)"
msgstr "እጥፍ-እርግዝ (−)"

msgid "Decimal (+/-)"
msgstr "Decimal (+/-) ን እባክዎ ይፈልጉ (Decimal ሲሆን ±)"

msgid "If checked, variants will be available using query string parameters."
msgstr ""
"ካረጋገጠ ከሆነ፣ ተለያዮች በጥያቄ ሕብረት "
"(query string) መለኪያዎች በመጠቀም ይገኛሉ።"

msgid ""
"This is used for the Previous Page button on the page before this page "
"break."
msgstr ""
"ይህ ከዚህ የገጽ መከፋፈል በፊት ባለው ገጽ "
"ላይ ለሚታየው «ቀዳሚ ገጽ» ቁልፍ "
"ይጠቅማል።"

msgid ""
"This is used for the Next Page button on the page after this page "
"break."
msgstr ""
"ይህ ይህን የገጽ መቆራረጥ በኋላ ላለው ገጽ "
"ላይ ለሚታየው “ቀጣይ ገጽ” ቁልፍ ላይ ነው "
"የሚውለው።"

msgid ""
"<strong>Warning:</strong> Opening %type files with spreadsheet "
"applications may expose you to <a href=\":injection_href\">formula "
"injection</a> or other security vulnerabilities. When the submissions "
"contain data from untrusted users and the downloaded file will be used "
"with Microsoft Excel, use the <strong>XLSX</strong> export format."
msgstr ""
"<strong>ማስጠንቀቂያ:</strong> የ %type ፋይሎችን "
"ከሰንጠረዥ መተግበሪያዎች (spreadsheet applications) "
"ጋር መክፈት በ <a href=\":injection_href\">ፎርሙላ "
"መነጋገሪያ (formula injection)</a> ወይም በሌሎች "
"የደህንነት ጉድለቶች ሊጋለጡዎት ይችላል። "
"ተሞልተው የሚገኙ ማስገቢያዎች ከታመን "
"ያልተሰጠላቸው (untrusted) ተጠቃሚዎች የመጡ "
"መረጃ ካለው እና የተወረደው ፋይል በ Microsoft "
"Excel ጋር እንዲጠቀምበት ከሆነ፣ "
"<strong>XLSX</strong> የውጤት ቅርጸትን ይጠቀሙ።"

msgid ""
"The Drupal Association is an educational non-profit organization that "
"tasks itself with fostering and supporting the Drupal software "
"project, the community and its growth."
msgstr ""
"Drupal Association ትምህርታዊ ያልትርፍ ድርጅት "
"ሲሆን የDrupal ሶፍትዌር ፕሮጀክቱን፣ "
"ማህበረሰቡን እና እድገቱን ለማስተዋወቅ "
"እና ለመደገፍ ራሱን ሚስጥር ያደርጋል።"

msgid "Cute Dogs"
msgstr "ከማሸኝ ውሾች"

msgid ""
"The Webform module may not update properly using this administrative "
"interface. It is strongly recommended that you update the Webform "
"module <a href=\":href_manual\">manually</a> or by using <a "
"href=\":href_composer\">Composer</a>."
msgstr ""
"ይህን የአስተዳደር በይነገጽ በመጠቀም "
"የWebform ሞጁሉ ትክክል ሁኔታ ላይ ሊዘመን "
"አይችል ይችላል። በጣም እንደሚመከርዎት "
"የWebform ሞጁሉን <a href=\":href_manual\">በእጅ</a> "
"ያዘምኑ ወይም <a href=\":href_composer\">Composer</a> "
"በመጠቀም ያዘምኑ።"

msgid "Bootstrap 3.x missing."
msgstr "Bootstrap 3.x አልተገኘም።"

msgid ""
"Bootstrap 3.x. must be enabled to install the Webform Bootstrap "
"module."
msgstr ""
"Webform Bootstrap ሞጁሉን ለመጫን Bootstrap 3.x መንቃት "
"(enabled) አለበት።"

msgid "Webform Bootstrap (3.x)"
msgstr "ვебফর্ম බൂട്ടstrap (3.x)"

msgid "XML Sitemap settings"
msgstr "XML ሳይትማፕ ቅንብሮች"

msgid ""
"The sitemap page link count of @size will create more than 1,000 "
"sitemap pages. Please increase the link count."
msgstr ""
"የ @size የሳይትማፕ ገጾች ሊንክ ብዛት ከ1,000 "
"በላይ የሳይትማፕ ገጾች ያስከትላል። "
"እባክዎ የሊንኩን ብዛት ጨምሩ።"

msgid "Add XML Sitemap"
msgstr "XML ሳይትማፕ ጨምር"

msgid "Add XmlSitemap"
msgstr "XmlSitemap አክል"

msgid "Edit XmlSitemap"
msgstr "XML സাইট്മാപ്പንና ያርትዑ"

msgid "Delete XmlSitemap"
msgstr "XML Sitemap ሰርዝ"

msgid "Sitemap Entities"
msgstr "የሳይትማፕ አካላት"

msgid "Link Bundle Settings"
msgstr "ትስስር ቡንደል ቅንብሮች"

msgid "Sitemap XML"
msgstr "የsitemap XML"

msgid "Sitemap XSL"
msgstr "የጣቢያ ካርታ XSL"

msgid "Last modified xmlsitemap format"
msgstr ""
"XML സাইটম্যাপ ቅርጸት የመጨረሻ "
"ማሻሻያ"

msgid "Disable cron generation of sitemap files"
msgstr "የ sitemap ፋይሎች መፍጠር (cron) አሰናክል"

msgid "Context of the sitemap"
msgstr "የsitemap አውድ (context)"

msgid "Custom sitemap entities settings"
msgstr "የተበጁ የ­sitemap አካል ቅንብሮች"

msgid "There is another sitemap saved with the same context."
msgstr ""
"ተመሳሳይ አውድ (context) ያለው ሌላ  sitemap "
"ተቀምጧል።"

msgid "Generate additional compressed sitemaps using gzip."
msgstr ""
"gzip ን በመጠቀም ተጨማሪ የተጨመቁ የጣቢያ "
"ካርታዎች (sitemaps) ይፍጠሩ።"

msgid "XMLSitemap engines settings"
msgstr "የXML የቦታ ካርታ ሞተሮች ቅንብሮች"

msgid "Url engines"
msgstr "የURL ሞተሮች"

msgid "No link types are rebuildable."
msgstr ""
"هیڅ የአገናኝ አይነቶች እንደገና ሊገነቡ "
"አይችሉም።"

msgid "Status Override"
msgstr "የሁኔታ እሽግ (Status Override)"

msgid "Sub-type"
msgstr "උፖ-ዓይነት"

msgid "Priority Override"
msgstr "የቅድሚያ መተካት (Priority Override)"

msgid "Change Count"
msgstr "የለውጦች ብዛት"

msgid "XML Sitemap Settings"
msgstr "የXML የጣቢያ ካርታ ቅንብሮች"

msgid "Minimum lifetime of an xmlsitemap xml file"
msgstr "የ XML sitemap የፋይል አነስተኛ የሕይወት ጊዜ"

msgid "Cannot determine language for sitemap @id"
msgstr "ለ sitemap @id ቋንቋን መወሰን አይቻልም"

msgid "XML Sitemap Custom"
msgstr "XML የጣቢያ ካርታ ማበጀት"

msgid "Use a relative path with a slash in front. For example, \"/about\"."
msgstr ""
"ከፊት የተቀመጠ የስተጀምሮ ምልክት (slash) "
"ያለው አንጻራዊ መንገድ ይጠቀሙ። ለምሳሌ፣ "
"“/about”።"

msgid "XML Sitemap Engines"
msgstr "XML ሳይትማፕ ኢንጂኖች"

msgid "Minimum lifetime for sitemaps"
msgstr "የጣቢያ քարտ (sitemaps) ዝቅተኛ የህይወት ጊዜ"

msgid "Generated %sitemap-url with @count links."
msgstr "%sitemap-url ተፈጥሯል፣ ከ @count አገናኞች ጋር።"

msgid "Generated sitemap index %sitemap-url."
msgstr "የተፈጠረ የsitemap ኢንዴክስ %sitemap-url።"

msgid "Links cleared"
msgstr "ሊንኮች ተጠርጓል"

msgid "Processed %entity_type_id @last_id (@progress of @count)."
msgstr ""
"የተሰራ %entity_type_id @last_id（@count ከ @progress ደረጃ "
"ጋር）。"

msgid ""
"Most sites should only need a sitemap for their default language since "
"translated content is now added to the sitemap using alternate links. "
"If you truly need a sitemap for multiple languages, it is still "
"possible to do so."
msgstr ""
"ብዙ ጣቢያዎች በነባሪ ቋንቋ ብቻ የsitemap "
"የሚያስፈልጋቸው ነገር ነው፤ ምክንያቱም "
"ተተርጉመው የተዘጋጁ ይዘቶች አሁን ወደ "
"አማራጭ ሊንኮች (alternate links) በመጠቀም በsitemap "
"ውስጥ ተጨምረዋል። እውነት ከሆነ ለብዙ "
"ቋንቋዎች የsitemap በትክክል የሚያስፈልግዎት "
"ከሆነ ግን ይህም ሊደረግ ይችላል።"

msgid "Indexed @count new @type items."
msgstr "@count አዲስ @type እቃዎች ተመዝግበዋል።"

msgid "Sitemap label"
msgstr "የሳይትማፕ መለያ"

msgid "No new XML Sitemap links to index."
msgstr ""
"ኢንዴክስ ለማድረግ ምንም አዲስ XML "
"ኤስኤምኤፕ ሊንኮች አልታከሉም።"

msgid "Indexed @count new XML Sitemap links."
msgstr ""
"@count አዳዲስ የ XML የsitemap አገናኞች ተጠቃሚ "
"ተደርገዋል።"

msgid "Sort order"
msgstr "የማዘዣ ቅደም ተከተል"

msgid "Cocos (Keeling) Islands"
msgstr "ኮኮስ (ကീല링) ደሴቶች"

msgid "Next page"
msgstr "የሚቀጥለው ገጽ"

msgid ""
"Randomize the rotation angle for each image. The angle specified above "
"is used as a maximum."
msgstr ""
"ለእያንዳንዱ ምስል የማዞሪያ አንግልን "
"ይቀይሩ (ይዘርፉ)። ከላይ የተገለጸው "
"አንግል እንደ ከፍተኛ ዋጋ ይጠቅማል።"

msgid "Diego Garcia"
msgstr "ዲዬጎ ගارسია"

msgid "Lower case"
msgstr "ትችላላ ፊደል (ትችላ የታችኛ ፊደል)"

msgid "Multiple roles"
msgstr "ብዙ ሚናዎች"

msgid "Unordered list - use the &lt;li&gt; to begin each list item"
msgstr ""
"ትዕዛዝ ያልተደረገ ዝርዝር — እያንዳንዱን "
"የዝርዝር እቃ ለመጀመር &lt;li&gt; ይጠቀሙ"

msgid "Configure Custom tags."
msgstr "ለተለመዱ ታጎች ያቀናብሩ።"

msgid "Period (.)"
msgstr "ነጥብ (.)"

msgid "Properties:"
msgstr "ባህሪዎች፡"

msgid "Russian"
msgstr "ሩሲያኛ"

msgid ""
"Changes made in this table will not be saved until the form is "
"submitted."
msgstr ""
"এই పట్టিতে করা "
"পরিবর্তনগুলো ফর্মটি জমা "
"দেওয়া পর্যন্ত সংরক্ষণ "
"করা হবে না।"

msgid ""
"The <em>Context</em> module lets users define conditions for when "
"certain reactions should take place."
msgstr ""
"<em>Context</em> የተባለው ሞጁል ተጠቃሚዎች ልዩ "
"አድማጭ እርምጃዎች መቼ እንዲከናወኑ "
"ሁኔታዎችን እንዲወስኑ ያስችላቸዋል።"

msgid ""
"An example of a condition could be when viewing a certain node type "
"and blocks should be placed as a reaction when viewing a page with "
"this node type."
msgstr ""
"ሁኔድ ምሳሌ ሆኖ ሊታይ የሚችለው አንድ "
"ተወሰነ የኖድ ዓይነት ሲመለከቱ እና ይህን "
"የኖድ ዓይነት ያለው ገጽ ሲታይ እንደ ምላሽ "
"ብሎኮች መቀመጥ አለባቸው የሚል ሁኔታ "
"ነው።"

msgid "Managing Context"
msgstr "የአውድ አስተዳደር"

msgid ""
"Users with <em>Administer contexts</em> permission can add contextual "
"conditions and reactions for different portions of their site. For "
"each context, they can choose the conditions that trigger this context "
"to be active and choose different aspects of their site that should "
"react to this active context."
msgstr ""
"<em>“Contexts አስተዳደር”</em> ፍቃድ ያላቸው "
"ተጠቃሚዎች በጣቢያቸው የተለያዩ ክፍሎች "
"ላይ ለየትኛው ሁኔታ ምላሽ እንዲሰጥ "
"የሚያቀናብሩ የሁኔታዊ ቅድመ-ሁኔታዎች "
"(contextual conditions) እና ምላሾች (reactions) ማከል "
"ይችላሉ። ለእያንዳንዱ context ይህ ሁኔታ "
"እንዲነቃ የሚያደርጉትን ሁኔታዎች (conditions) "
"መምረጥ እና ይህ ንቁ ሁኔታ ሲኖር የሚምላሽ "
"ሊሆኑ የሚገቡ የጣቢያቸውን የተለያዩ "
"ገፅታዎች (aspects) መምረጥ ይችላሉ።"

msgid "Adding new custom reactions"
msgstr "አዲስ የተበጁ ምላሾችን መጨመር"

msgid ""
"Reactions for the context module are defined trough the new <a "
"href=\"https://www.drupal.org/developing/api/8/plugins\">Drupal 8 "
"Plugin API</a>."
msgstr ""
"ለኮንቴክስት ሞጁሉ የሚፈጠሩ ምላሾች "
"በአዲሱ <a "
"href=\"https://www.drupal.org/developing/api/8/plugins\">Drupal 8 "
"Plugin API</a> በኩል ይወሰናሉ።"

msgid ""
"The Context module defines a plugin type named ContextReaction that "
"users can extend when creating their own plugins."
msgstr ""
"የኮንቴክስት (Context) ሞጁሉ ተጠቃሚዎች "
"የራሳቸውን ፕላጊኖች ሲፈጥሩ ሊያሻሽሉት "
"የሚችሉ “ContextReaction” የሚባል የፕላጊን "
"አይነትን ይወክላል።"

msgid ""
"A context reaction requires a configuration form and execute method. "
"The execution of the plugin is also something that will have to be "
"handled by the author of the reaction."
msgstr ""
"የኮንቴክስት ምላሽ (context reaction) ማዋቀር "
"ፎርም እና የማስፈጸሚያ ዘዴ (execute method) "
"ይፈልጋል። የፕለጊኑ ማስፈጸሚያ አፈጻጸም "
"ራሱ ደግሞ በምላሹ ደራሲ (author) መያዝ "
"የሚገባ ነገር ነው።"

msgid "new window"
msgstr "አዲስ መስኮት"

msgid "Translate All"
msgstr "সবকিছু অনুবাদ করুন"

msgid ""
"Unable to connect to DeepL API. Please verify your API key and "
"settings in the configuration page."
msgstr ""
"ወደ DeepL API መገናኘት አልተቻለም። እባክዎ "
"በቅንብሮች ገጹ ላይ ያለዎትን API ቁልፍ እና "
"ማስኪያ ቅንጅቶች ያረጋግጡ።"

msgid "No strings found to translate."
msgstr ""
"ተرجማ ለመተርጎም ምንም ሕብረ ጽሑፎች "
"አልተገኙም።"

msgid ""
"Translation process stopped due to an error. Please verify your DeepL "
"API key and settings."
msgstr ""
"ትርጉም ሂደቱ በስህተት ምክንያት "
"ተቋርጧል። దeepL API ቁልፍዎን እና "
"ቅንብሮችዎን እባክዎ ያረጋግጡ።"

msgid "Translations completed! DeepL API characters remaining: @remaining"
msgstr ""
"ትርጉሞች ተጠናቀዋል! DeepL API የቀሩ "
"ባህሪዎች፦ @remaining"

msgid ""
"Translation process failed. Please verify your DeepL API key and "
"settings."
msgstr ""
"የትርጉም ሂደቱ አልተሳካም። ദየ DeepL API "
"ቁጥርዎን እና ቅንብሮችዎን እባክዎ "
"ያረጋግጡ።"

msgid "Translation failed: @message"
msgstr "ትርጉም አልተሳካም፡ @message"

msgid "Translation failed. Please try again."
msgstr ""
"ትርጉም አልተሳካም። እባክዎ እንደገና "
"ይሞክሩ።"

msgid "Translating: @processed of @total strings (@percentage%)"
msgstr ""
"ትርጉም በመስራት ላይ፦ @processed ከ @total "
"ጽሑፎች (@percentage%)"

msgid "Translation completed!"
msgstr "ትርጉሙ ተጠናቋል!"

msgid ""
"Bulk actions are now available. These actions will be applied to all "
"selected items. This can be accessed via the \"Skip to bulk actions\" "
"link that appears after every enabled checkbox. "
msgstr ""
"በአሁኑ ጊዜ በዕብዛ እርምጃዎች የሚሰጡ "
"አማራጮች ይገኛሉ። እነዚህ እርምጃዎች "
"በምትመርጡት ሁሉም ንጥሎች ላይ "
"ይተገበራሉ። ይህን እርምጃ መድረስ ከሚረዳ "
"መንገድ በኋላ በሚታየው “Skip to bulk actions” "
"የሚለው አገናኝ በኩል ሊደርሱበት ይችላሉ፤ "
"ይህም ከእያንዳንዱ ነቅቷ ምርጫ ሳጥን "
"በኋላ ይታያል።"

msgid "1 item selected"
msgid_plural "@count items selected"
msgstr[0] "በ1 ንጥል ተመርጧል "
msgstr[1] "@count ንጥሎች ተመርጠዋል"

msgid "Path to Composer is configured"
msgstr "የComposer መንገድ ተዋቅሯል"

msgid "jQuery UI Autocomplete"
msgstr "jQuery UI አውቶኮምፌሌት"

msgid "Complete drag & drop"
msgstr "የተሟላ መጎተት እና መጣል (Drag & Drop)"

msgid "Altered"
msgstr "የተሻሻለ"

msgid ""
"Value stored in the database. Leave blank to store an empty string in "
"the database."
msgstr ""
"የዲታ ቤዝ ውስጥ የሚቀመጥ እሴት። ባዶ "
"ይተው እሴቱን ዲታ ቤዝ ውስጥ ባዶ ሕብረ "
"ጽሑፍ (empty string) እንዲቀመጥ ያደርጋል።"

msgid "Getting involved and support options"
msgstr "ተሳትፎ መግባት እና የድጋፍ አማራጮች"

msgid "(Twig)"
msgstr "(ታዊግ)"

msgid "Webforms: Repair webform configuration"
msgstr ""
"የድር ቅጾች (Webforms): የድር ቅጹን ውቅር "
"ጥገና ማድረግ"

msgid ""
"The attachment's link will only be displayed on the form after the "
"submission is completed."
msgstr ""
"የአባሪው ሊንኩ ስራው ከተጠናቀቀ በኋላ "
"ብቻ ቅጹ ላይ ይታያል።"

msgid ""
"Enter a @type or token which returns in a @type in a format compatible "
"with <a href=\":href\" target=\"_blank\">PHP's strtotime function</a> "
"(eg. @format). If timezone information is not provided, the @type will "
"be interpreted in the site's default timezone (@site_default_tz)."
msgstr ""
"@type ወይም ቶከን ያስገቡ የሚመልሰው ከ @type "
"ጋር ተኳሃኝ በሆነ መልኩ ከ <a href=\":href\" "
"target=\"_blank\">PHP የ strtotime ተግባር</a> ጋር "
"ተኳሃኝ በሆነ ቅርጸ-ቁምፊ መልክ ይመጣል "
"(ለምሳሌ፣ @format)። የጊዜ ሰቅ (timezone) መረጃ "
"ካልቀረበ፣ @type በተጠቃሚው የጣቢያው ነባሪ "
"የጊዜ ሰቅ (@site_default_tz) ላይ እንደሚተረጎም "
"ይቆጠራል።"

msgid ""
"The %field @type field is required. Please enter a @type or token "
"which returns in a @type in a format compatible with <a href=\":href\" "
"target=\"_blank\">PHP's strtotime function</a> (eg. @format)."
msgstr ""
"የ %field @type መስክ አବশ্যኮ ነው። እባክዎ "
"@type ያስገቡ ወይም ወደ @type የሚመልስ ቶከን "
"ያስገቡ፣ ከ <a href=\":href\" target=\"_blank\">PHP የ "
"strtotime ተግባር</a> ጋር ተኳሃኝ በሆነ "
"ቅርጸ-ቁጥር ውስጥ (ለምሳሌ፣ @format)።"

