msgstr "%type_name፡ አዲስ ይዘት ፍጠር"

msgid "%type_name: Edit own content"
msgstr "%type_name: የራስዎን ይዘት አርትዕ"

msgid "%type_name: Edit any content"
msgstr "%type_name: የማንኛውንም ይዘት ያስተካክሉ"

