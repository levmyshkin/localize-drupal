msgid_plural "Only @count instances are permitted"
msgstr[0] ""
"@count አንዱ ማሳያ ብቻ ይፈቀዳል  \n"
"@count አንዱ "
"ማሳያዎች ብቻ ይፈቀዳሉ"

msgid "Sharing Webforms"
msgstr "ዌብፎርም መጋራት"

msgid ""
"This screencast walks through how to share a webform with any website, "
"webpage, or application."
msgstr ""
"ይህ ስክሪንካስት የድር ቅጽ (webform) እንዴት "
"ከማንኛውም ድረ-ገጽ (website), የድረ-ገጽ ገጽ "
"(webpage) ወይም መተግበሪያ (application) ጋር "
"እንደሚጋራ ይመራዎታል።"

msgid "Default wizard/cards start label"
msgstr "የነባሪ ዊዛርድ/ካርዶች መጀመሪያ መለያ"

msgid "Default section/card title tag"
msgstr "የነባር ክፍል/ካርድ ርዕስ መለያ (tag)"

msgid "Show wizard/cards progress bar"
msgstr ""
"ጠንቃቃ የመመሪያ (wizard) / ካርዶች "
"የመከታተያ መስመርን አሳይ"

msgid "Show wizard/cards progress pages"
msgstr "Wizard/cards የመገለጫ ሂደት ገጾችን አሳይ"

msgid "Show wizard/cards progress percentage"
msgstr ""
"የዊዛርድ/ካード የመከታተያ መጠን በመቶኛ "
"ያሳዩ"

msgid "Update wizard/cards progress bar's pages based on conditions"
msgstr ""
"የዳታ የማስጀመሪያ ዊዛርድ/ካርዶች "
"የእድገት ባር ገጾችን በሁኔታዎች መሰረት "
"ያዘምኑ"

msgid ""
"If checked, the wizard/cards progress bar's pages will be hidden or "
"shown based on each pages conditional logic."
msgstr ""
"ከተመረጠ (checked) የአዋቂው/cards የእድገት "
"መግለጫ (progress bar) ገጾች በእያንዳንዱ ገጽ "
"ላይ ተፈጻሚ የሚሆነውን የሁኔታዊ ሎጂክ "
"(conditional logic) መሰረት ተደብቀው ወይም "
"ታይተው ይታያሉ።"

msgid "Wizard/cards start label"
msgstr "Wizard/cards ጀምር መለያ"

msgid ""
"The first page label in the progress bar. Subsequent pages are titled "
"by their wizard/card page title."
msgstr ""
"የመጀመሪያው ገጽ መለያ በዕድገት አሞሌው "
"ውስጥ። ቀጣዮቹ ገጾች የእነሱን "
"ዊዛር/ካርድ ገጽ ርዕስ በመጠቀም "
"ይሰየማሉ።"

msgid "Wizard/cards end label"
msgstr "Wizard/cards መጨረሻ መለያ"

msgid "Track wizard/cards progress in the URL by"
msgstr ""
"የዳሰሳ ዊዛርድ/ካርዶች የእድገት ሁኔታን "
"በURL ውስጥ በመከታተል በኩል በ"

msgid "Wizard/cards previous page button label"
msgstr ""
"የዊዛርድ/ካርዶች ቀዳሚ ገጽ ቁልፍ መለያ "
"(label)"

msgid "This is used for the previous page button within a wizard/cards."
msgstr ""
"ይህ በወizard/cards ውስጥ ለቀድሞው ገጽ ቁልፍ "
"ነው የሚውለው።"

msgid "Wizard/cards next page button label"
msgstr "Wizard/cards 다음 페이지 버튼 라벨"

msgid "This is used for the next page button within a wizard/cards."
msgstr ""
"ይህ በዊዛርድ/ካርዶች ውስጥ ለሚቀጥለው "
"ገጽ ቁልፍ የሚውል ነው።"

msgid "Display show/hide all wizard/cards pages link"
msgstr ""
"ሁሉንም ዊዛርድ/ካርዶች ገፆች አገናኝን "
"ታሳይ/ደብቅ ያሳዩ"

msgid ""
"If checked, a hide/show all elements link will be added to this "
"webform when there are wizard/cards pages."
msgstr ""
"اگر تیک زده شود، wizard/cards ገፆች ሲኖሩ "
"ለዚህ ዌብፎርም ውስጥ ሁሉንም ኤለመንቶች "
"የማሳየት/የመደበቅ አገናኝ ይታከላል።"

msgid "Wizard/cards show all elements label"
msgstr ""
"ዊዛርድ/ካርዶች ሁሉንም እቃዎች መለያ "
"ያሳያሉ"

msgid "Wizard/card hide all elements label"
msgstr "Wizard/card ሁሉንም አካሎች ደብቅ መለያ"

msgid "Webform Cards"
msgstr "የዌብፎርም ካርዶች"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"ፈጣን የክለይንት-ሳይድ ባለብዙ-እርምጃ "
"የፎርም ገጽ ክፍል (pagination) ለማድረግ ‘Card’ "
"ኮንቴይነር ኤለመንት ያቀርባል።"

msgid "Convert wizard pages to cards"
msgstr "Wizard ገጾችን ወደ ካርዶች ቀይር"

msgid "Convert @title wizard pages to cards"
msgstr "@title ዊዛርድ ገጾችን ወደ ካርዶች ቀይር"

msgid ""
"Please make sure to test the converted webform on a staging server "
"before using cards in production."
msgstr ""
"ദയവായി, ഉൽപ്പാദനത്തിൽ "
"കാർഡുകൾ "
"ഉപയോഗിക്കുന്നതിന് "
"മുമ്പ്, മാറ്റിയ വെബ്‌ഫോം "
"ഒരു സ്റ്റേജിംഗ് സർവറിൽ "
"പരിശോധിക്കുക."

msgid ""
"Cards provide an almost identical user experience to wizard pages, but "
"moving between cards is much faster. Cards use JavaScript for "
"pagination and client-side validation. Cards also support "
"auto-forwarding with conditional logic."
msgstr ""
"کാർዶች የዊዛርድ ገጾችን የሚመስል ብዙ "
"ተመሳሳይ የተጠቃሚ ልምድ ይሰጣሉ፣ ነገር "
"ግን ከካርድ ወደ ካርድ መቀየር በጣም ፈጣን "
"ነው። ካርዶች ለፔጅኔሽን እና "
"ለደንበኛ-ጎን ማረጋገጫ ጃቫስክሪፕትን "
"ይጠቀማሉ። ካርዶች በተጨማሪም ውሳኔ-ተኮር "
"ሎጂክ ጋር አውቶ-ፎርዋዲንግን ይደግፋሉ።"

msgid ""
"Please confirm that you want to convert this webform's wizard pages to "
"cards"
msgstr ""
"እባክዎ ይህን የዌብፎርሙ ዊዛርድ ገጾች "
"ወደ ካርዶች እንዲቀየሩ መፈለግዎን "
"ያረጋግጡ።"

msgid "Wizard pages have been successfully converted to cards."
msgstr ""
"Wizard ገጾች በስኬቶች (cards) በተሳካ ሁኔታ "
"ተቀይረዋል።"

msgid "Card settings"
msgstr "የካርድ ቅንብሮች"

msgid "Provides an element for a fast clientside pagination."
msgstr ""
"ፈጣን የክላይንት-ጎን (client-side) ፔጅኔሽን "
"ለማቅረብ አንድ አካል (element) ይሰጣል።"

msgid ""
"Pages and cards cannot be used in the same webform. Please remove or "
"convert the pages/cards to the same element type."
msgstr ""
"“Pages” እና “cards” አንድ የዌብፎርም ውስጥ "
"በአንድ ጊዜ መጠቀም አይቻልም። እባክዎ "
"አንዳቸውን ያስወግዱ ወይም “pages/cards” ን "
"ወደ ተመሳሳይ የአካል አይነት ይቀይሩ።"

msgid "Edit '@label' (@start of @end)"
msgstr "'@label' ን አስተካክል (@start of @end)"

msgid "\"@title: @page\" loaded. (@start of @end)"
msgstr "«@title: @page» ተጫንቷል። (@start of @end)"

msgid "Add new @item after @item @number"
msgstr "@number በኋላ @item ውስጥ ሌላ @item ጨምር"

msgid ""
"If checked, the wizard's progress bar's pages will be hidden or shown "
"based on each pages conditional logic."
msgstr ""
"ከተመረጠ፣ የረዳቱ (wizard) የእድገት አሞሌ "
"የሚኖሩ ገጾች በእያንዳንዱ ገጽ ላይ ባለው "
"የሁኔታ አመክንዮ (conditional logic) መሰረት "
"ተደብቀው ወይም ይታዩ ይሆናሉ።"

msgid "Wizard hide all elements label"
msgstr "ዊዛርድ ሁሉንም አባላት መደበቅ ለያቄ"

msgid "This is used by the add/remove (+/-) icons."
msgstr ""
"ይህ ለመጨመር/ማስወገድ (+/-) አዶዎች ተጠቃሚ "
"ነው።"

msgid "Title attributes"
msgstr "የርዕስ ባህሪያት"

msgid "Apply classes to the title tag."
msgstr ""
"ክፍሎችን ወደ  శీርስ ታግ (title tag) ላይ "
"ተግብር።"

msgid "Apply custom styles to the  title tag."
msgstr ""
"የርዕስ መለያው (title) ላይ ብጁ ስታይሎችን "
"ተግብር።"

msgid "Enter additional attributes to be added to the title tag."
msgstr ""
"ርእስ መለያ (title) ታግ ውስጥ ለመጨመር "
"ተጨማሪ ባህሪዎችን አስገቡ።"

msgid "Include '@type of the above' option"
msgstr "“@type of the above” አማራጭን ያካትቱ"

msgid "@type option text"
msgstr "@type ኦፕሽን ጽሑፍ"

msgid "Container (no title)"
msgstr "ኮንቴይነር (ርዕስ የለውም)"

msgid "Buttons - flexbox"
msgstr "ቁልፎች — ፍሌክስቦክስ"

msgid "Buttons - horizontal"
msgstr "አዝራቦች — አግድም (ትይዩ)"

msgid "Buttons - vertical"
msgstr "አዝራሮች - ቁመታዊ"

msgid "%title content type already exists"
msgstr "%title የይዘት አይነት ቀድሞውኑ አለው"

msgid ""
"This screencast walks through how to create faster and better "
"multistep form user experiences using the Webform Cards module."
msgstr ""
"ይህ ስክሪንካስት የ Webform Cards ሞጁልን "
"በመጠቀም ፈጣን እና የተሻሻለ ባለብዙ "
"ደረጃ የቅጽ ተጠቃሚ ልምዶችን እንዴት "
"እንደሚፈጥሩ ያሳያል።"

msgid "Do not track user IP address"
msgstr "የተጠቃሚውን IP አድራሻ አትከታተል"

msgid "Do not track user IP addresses"
msgstr "የተጠቃሚዎችን IP አድራሻዎች አይከታተሉ"

msgid "Webform Custom Options"
msgstr "ዌብ፫ርም ብጁ አማራጮች"

msgid "Webform Options Limit"
msgstr "የድር ፎርም አማራጮች ገደብ"

msgid "Webform Submission Export/Import"
msgstr ""
"የድር ቅፅ  സമሙላት መላክ/መመገብ "
"(Export/Import)"

msgid ""
"The 'tokenized' URL to view a submission will be available when "
"viewing a submission's information and can be inserted into an email "
"using the [webform_submission:token-view-url] token."
msgstr ""
"የማስረከብ መመልከቻው (submission) ለማየት "
"የሚያስችለው “tokenized” URL የሚገኘው "
"የማስረከብ መረጃውን ሲመለከቱ ነው፣ እና "
"ወደ ኢሜይል በ[webform_submission:token-view-url] ቶከን "
"ሊገባ ይችላል።"

msgid ""
"The 'tokenized' URL to update a submission will be available when "
"viewing a submission's information and can be inserted into an email "
"using the [webform_submission:token-update-url] token."
msgstr ""
"የማስገቢያ (submission) ለማዘመን የተከፋፈለ "
"(tokenized) ዩአርኤል እንዲያዩት በማስገቢያው "
"መረጃ ላይ ሲመለከቱ ይገኛል፣ እንዲሁም "
"በኢሜይል ውስጥ በመግባት ይቻላል በ "
"[webform_submission:token-update-url] ቶከን በኩል።"

msgid "User IP address tracking is disabled for all webforms."
msgstr ""
"የተጠቃሚ አይፒ አድራሻ መከታተያ ለሁሉም "
"የድር ፎርሞች ተዘግቷል።"

msgid "If checked, a user's IP address will not be recorded for this webform."
msgstr ""
"ይህ በምልክት ተደርጎ ከሆነ፣ ለዚህ "
"ዌብፎርም ተጠቃሚ የአይፒ አድራሻ መዝገብ "
"አይደረግም።"

msgid ""
"This is the \"To:\" email header which will be the person(s) "
"responsible for receiving this webform."
msgstr ""
"ይህ “To:” የኢሜል ራስጌ ነው፣ ይህም ይህን "
"ዌብፎርም ለመቀበል ተጠያቂ የሆኑ(ች) "
"ሰው(ዎች) የሚሆኑበት ነው።"

msgid ""
"This is the \"From:\" email header which should come from "
"<em>you</em>.  It should be your brand, company, organization, or "
"website entity."
msgstr ""
"ይህ “From:” የኢሜይል ራስጌ (header) ነው፣ እሱ "
"<em>ከእርስዎ</em> መምጣት አለበት። እሱ "
"የእርስዎ ብራንድ፣ ኩባንያ፣ ድርጅት ወይም "
"የድር ጣቢያ አካል (entity) መሆን አለበት።"

msgid "Reply to (individual/organization)"
msgstr "ለ (ግለሰብ/ድርጅት) መልስ ስጥ"

msgid ""
"The \"Reply-To:\" email header is used for replying to the email that "
"is received.  For example, if you collect a customers email, you would "
"want to reply-to them. If you collect a lead generation form and want "
"to reply to the coordinator, you would reply-to them."
msgstr ""
"“Reply-To:” የኢሜይል ራስጌ (header) የሚጠቅምው "
"ተቀብለው የመጡትን ኢሜይሎች ለመመለስ "
"(reply) ነው። ለምሳሌ፣ የደንበኞችን ኢሜይል "
"ከሰበሰቡ በእነርሱ ላይ መመለስ (reply-to) "
"ትፈልጋላችሁ። የመሪ ማመንጫ (lead generation) "
"ፎርም ከሰበሰቡ እና ከመርሃ "
"ግብር/ኮኦርዲ네ተር ጋር መመለስ (reply-to) "
"ከፈለጋችሁ በእሱ ላይ መመለስ "
"ትፈልጋላችሁ።"

msgid "Reply to:"
msgstr "ይመልሱ ወደ፦"

msgid "Options text"
msgstr "አማራጮች ጽሑፍ"

msgid "Options value"
msgstr "የአማራጮች ዋጋ"

msgid "Send from (website/domain)"
msgstr "ከ (ድረ-ገጽ/ዶሜይን) ላክ"

msgid "Less than/Equal to"
msgstr "ከወይም እኩል በሆነ (≤)"

msgid "Greater than/Equal to"
msgstr "ከዚህ በላይ ወይም እኩል ነው (>=)"

msgid ""
"If checked, the next button will be hidden when the input is not "
"filled and can be auto-forwarded."
msgstr ""
"ከተነቃ በሚቀጥለው ትር አዝራሩ ግቤቱ "
"ሲሞላ እስካልሆነ ድረስ ይደበቃል እና "
"በራስ በራስ ወደቀጣዩ ሊሻገር ይችላል።"

msgid "Clear value(s) when hidden"
msgstr ""
"ይታይታ ሲደበቅ የተለያዩ እሴቶችን ግልጽ "
"አድርግ"

msgid "Not between"
msgstr "መካከል አይደለም"

msgid ""
"If unchecked, all warnings about the Webform Clientside Validation "
"will be disabled."
msgstr ""
"አልተምረጠም ከሆነ፣ ስለ Webform Clientside "
"Validation የሚታዩ ሁሉም ማስጠንቃታዎች "
"ይቦዘኑ/ይታገዳሉ።"

msgid "Show remove element button"
msgstr "ከማስወገድ እቃ ቁልፍ አሳይ"

msgid "If unchecked, the remove button will be removed from each table row."
msgstr ""
"ከሚረጡ ካልተደረገ በስተቀር፣ የመቁረጥ "
"(remove) ቁልፉ በእያንዳንዱ የጠረጴዛ ረድፍ "
"ላይ እንደሚወገድ ይሆናል።"

msgid "Admin notes/comments"
msgstr "የአስተዳዳሪ ማስታወሻ/አስተያየቶች"

msgid ""
"Admin notes/comments are display next to the element title in the form "
"builder and visible in the form's YAML source"
msgstr ""
"አስተዳዳሪ ማስታወሻዎች/ኮሜንቶች በቅጽ "
"ገንቢው ውስጥ ከእቃው (element) ርዕስ ቀጥሎ "
"ይታያሉ እና በቅጹ የYAML ምንጭ ውስጥ "
"ይታያሉ።"

msgid "Webforms: @webforms"
msgstr "የድረ-ገፅ ቅጾች፡ @webforms"

msgid "Next submission number disabled"
msgstr "የሚቀጥለው ማስገቢያ ቁጥር አሰናክሏል"

msgid "is filled"
msgstr "ተሞልቷል"

msgid "is checked"
msgstr "ይመረጡ ነው (ወይም ተፈትሿል)"

msgid "is between"
msgstr "ከመካከል ነው (ወይም “በመካከል ነው”)"

msgid "is not between"
msgstr "መካከል አይደለም"

msgid "This @name is <strong>@state</strong>"
msgstr "ይህ @name  <strong>@state</strong> ነው"

msgid "when <strong>@logic</strong> of the following conditions are met:"
msgstr ""
"የሚከተሉት ሁኔታዎች ውስጥ <strong>@logic</strong> "
"ተሟልቶ ሲገኝ፦"

msgid ""
"When <strong>@logic</strong> of the following (nested) conditions are "
"met:"
msgstr ""
"የሚከተሉት (የተገባበሩ/nested) ሁኔታዎች "
"ውስጥ <strong>@logic</strong> ተሟልቶ ሲሆን፦"

msgid "<strong>@name</strong> @trigger."
msgstr "<strong>@name</strong> የ @trigger ግብር።"

msgid ""
"<strong>@name</strong> @trigger <strong>@min</strong> and "
"<strong>@max</strong>."
msgstr ""
"<strong>@name</strong> @trigger <strong>@min</strong> እና "
"<strong>@max</strong>።"

msgid "<strong>@name</strong> @trigger <strong>@value</strong>."
msgstr "<strong>@name</strong> @trigger <strong>@value</strong>።"

msgid ""
"Auto-forward to next card when a card with a single click-able input "
"is completed"
msgstr ""
"በአንድ ጠቅታ ብቻ የሚቻል ግቤት ያለው "
"ካርድ ሲጠናቀቅ ወደሚቀጥለው ካርድ "
"በራስ-ሰር መቀየር"

msgid ""
"If checked, the used will be moved to the next card when a single "
"click-able input is checked (i.e. radios, rating, and image select)."
msgstr ""
"ማስታወቂያ ከተመረጠ፣ አንድ ጊዜ በሚጫን "
"መጫኛ ሲመረጥ (ማለትም radios፣ rating እና image "
"select) ጊዜ ተመረጠው እየተጠቀመው ካርዱን "
"ወደሚቀጥለው ካርድ ይወሰዳል።"

msgid "Disable next submission number"
msgstr "ቀጣዩን የመስጠት ቁጥር አቦዝን"

msgid ""
"If checked the next number will be automatically set to the internal "
"submission id."
msgstr ""
"ይህ ካረጋገጠ (checked) ቀጣዩ ቁጥር በራስ ሰር "
"ወደ ውስጣዊ የቅርብ መታወቂያ (internal submission "
"id) ይቀመጣል።"

msgid ""
"If checked, all submission properties and values  will be included in "
"the displayed debug information. This includes sid, created, updated, "
"completed, and more."
msgstr ""
"اگر چک شده باشد، تمام "
"ارسال‌شده‌گى‌های ویژگی‌ها و مقادیر "
"آن‌ها در اطلاعات دیباگِ نمایش‌ "
"داده‌شده گنجانده می‌شود. این شامل sid، "
"created، updated، completed و موارد دیگر نیز "
"می‌شود."

msgid "Data format:"
msgstr "የውሂብ ቅርጸት፦"

msgid "The URL or path to redirect the user to upon successful submission."
msgstr ""
"Օգտատիրոջը վերահղելու համար այն URL-ը "
"կամ ուղին, որը կօգտագործվի հաջող "
"ներկայացումից հետո։"

msgid ""
"Paths beginning with a forward slash (/) will redirect be treated as "
"root-relative. Paths without a forward slash (/) will redirect be "
"treated as Drupal relative path."
msgstr ""
"የ «/» (ፊት ለፊት በቀላሉ ስלאሽ) ይጀምሩ "
"መንገዶች (paths) ሥር ከሆነ በላይ መጀመሪያ "
"(root-relative) እንደሚታዩ ይደርሳሉ።  «/» "
"ሳይጀምሩ መንገዶች ደግሞ (paths) የDrupal "
"አንጻራዊ መንገድ (Drupal relative path) እንደሚታዩ "
"ይደርሳሉ።"

msgid "Display element"
msgstr "ኤለመንት አሳይ"

msgid "Download attachments"
msgstr "ց%C2%A0ዓ%C2%A0፡%20ያ%C2%A0ው%E1%8D%88%C2%A0%D8%A7%E2%80%8E%E1%89%85%C2%A0%20attachments%20ይ%C2%A0%E1%8B%B5%C2%A0%E1%8B%B5%20%E1%8B%AB%E1%88%83%C2%A0%E1%8B%8E"

msgid ""
"If checked, the exported file and any attachments files will be "
"download in the archive file."
msgstr ""
"ከተፈቀደ (checked) ከሆነ የተላከው ፋይል እና "
"ማንኛውም የአባሪ ፋይሎች በአርክाइव "
"ፋይሉ ውስጥ ተጠቃልለው ይወርዳሉ።"

msgid "Tabby"
msgstr "ታቢ"

msgid "Tabby provides lightweight, accessible vanilla JS toggle tabs."
msgstr ""
"Tabby ቀላል እና ተደራሽ የሆነ የባለብዙ "
"የጃቫስክிரፕት ባዶ (vanilla JS) ቶግል "
"ታብዎችን ያቀርባል።"

msgid "Tabby is used to display tabs in the administrative UI"
msgstr ""
"Tabby የአስተዳደር ተጠቃሚ በይነገጽ "
"(administrative UI) ውስጥ ትሮችን (tabs) ለማሳየት "
"ይጠቅማል።"

msgid ""
"Tippy.js is the complete tooltip, popover, dropdown, and menu solution "
"for the web, powered by Popper."
msgstr ""
"Tippy.js የሙሉ መፍትሄ ነው—የመጠቆሚያ "
"(tooltip)፣ ፖፓቨር (popover)፣ ድሮፕዳውን (dropdown) "
"እና ሜኑ (menu) ለድር አገልግሎት፣ በ Popper "
"የተጎለበተ።"

msgctxt "Imperial height unit abbreviate"
msgid "ft"
msgstr "ft"

msgctxt "Imperial height unit abbreviate"
msgid "in"
msgstr "ውስጥ"

msgctxt "Imperial height unit"
msgid "feet"
msgstr "እግሮች"

msgctxt "Imperial height unit"
msgid "foot"
msgstr "እግር"

