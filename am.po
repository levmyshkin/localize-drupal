"webform_section\n"
"  subscribe:\n"
"    '#title': 'Please subscribe me to "
"your mailing list.'\n"
"    '#type': "
"checkbox\n"
"additional_information:\n"
"  '#title': 'Additional "
"Information'\n"
"  '#type': webform_section\n"
"  '#open': true\n"
"  "
"notes:\n"
"    '#title': Comments\n"
"    '#type': textarea\n"
"actions:\n"
"  "
"'#type': webform_actions\n"
"  '#title': 'Submit button(s)'\n"
"  "
"'#submit__label': Register\n"
""
msgstr ""
"```yaml\n"
"personal_information:\n"
"  '#title': 'የግል "
"መረጃዎ'\n"
"  '#type': webform_section\n"
"  first_name:\n"
"    "
"'#title': 'የመጀመሪያ ስም'\n"
"    '#type': textfield\n"
"    "
"'#required': true\n"
"  last_name:\n"
"    '#title': "
"'የአባት/የኋለኛ ስም'\n"
"    '#type': textfield\n"
"    "
"'#required': true\n"
"contact_information:\n"
"  '#title': "
"'የግንኙነት መረጃዎ'\n"
"  '#type': webform_section\n"
"  "
"contact:\n"
"    '#type': webform_contact\n"
"    '#title': "
"ግንኙነት\n"
"    '#title_display': invisible\n"
"    "
"'#name__access': false\n"
"    '#company__access': "
"false\n"
"mailinglist:\n"
"  '#title': 'የመልዕክት "
"ዝርዝር'\n"
"  '#type': webform_section\n"
"  subscribe:\n"
"    "
"'#title': 'እባክዎ ከዚህ የመልዕክት ዝርዝር "
"(mailing list) ጋር እንድታስመዝግቡኝ።'\n"
"    "
"'#type': checkbox\n"
"additional_information:\n"
"  '#title': "
"'ተጨማሪ መረጃ'\n"
"  '#type': webform_section\n"
"  '#open': "
"true\n"
"  notes:\n"
"    '#title': 'አስተያየቶች'\n"
"    '#type': "
"textarea\n"
"actions:\n"
"  '#type': webform_actions\n"
"  '#title': "
"'የማስገባት አማራጮች'\n"
"  '#submit__label': "
"መመዝገብ\n"
"```"

msgid "Default file upload limit per form"
msgstr ""
"በእያንዳንዱ ፎርም ላይ የሚፈቀደው ነባር "
"የፋይል ማብሰብ ገደብ"

msgid "Invoked @id: @class_name:@method_name @context1"
msgstr ""
"@context1 ውስጥ ተጠርቷል፣ @class_name:@method_name "
"(መታወቂያ፡ @id)"

msgid "Example of a webform submission handler."
msgstr ""
"የዌብፎርም ግቤት መቆጣጠሪያ (submission handler) "
"ምሳሌ።"

msgid ""
"Inline (Displays message when access is denied to field, nodes, and "
"blocks)"
msgstr ""
"በመስክ፣ በኖዶች እና በብሎኮች መዳረሻ "
"ሲከለከል መልዕክት የሚታይ (Inline)"

msgid ""
"Page (Displays message when access is denied to forms, fields, nodes, "
"and blocks)"
msgstr ""
"የገጽ (ፎርሞች፣ መስኮች፣ ኖዶች እና "
"ብሎኮች ላይ መዳረስ ሲከለከል መልዕክት "
"ያሳያል)"

msgid ""
"Login (Redirects to user login form and displays message. Field, "
"nodes, and block only display the message.)"
msgstr ""
"ግባ (የተጠቃሚ መግቢያ ቅጽ ወደሚቀይር እና "
"መልዕክት ያሳያል። መስክ፣ ኖዶች እና "
"ብሎክ ብቻ መልዕክቱን ያሳያሉ።)"

msgid ""
"When this container is hidden all this container's subelement values "
"will be cleared."
msgstr ""
"ይህ ኮንቴይነር ሲደበቅ የዚህ ኮንቴይነር "
"የሁሉም ንዑስ እቃዎች (subelements) ዋጋዎች ሁሉ "
"ይታጠፋሉ።"

msgid "When this element is hidden, this element's value will be cleared."
msgstr ""
"ይህ አካል ሲደበቅ የዚህ አካል ዋጋ "
"ይጸዳል።"

msgid "Input hiding"
msgstr "የግብዓት መደበቂያ"

msgid "Hide the input of the element when the input is not being focused."
msgstr ""
"ኤለመንቱ ግቤት ላይ ካልተፈጸመ (focus) ሲሆን "
"ግቤቱን ደብቅ።"

msgid "Append the below suffixes to alter the returned value."
msgstr ""
"ተ្រឲ የታችኛውን ማሟያ መደምደሚያዎች "
"(suffixes) ተጨምሩ የተመለሰውን እሴት "
"ለመቀየር።"

msgid "<code>:urlencode</code> URL encodes returned value."
msgstr ""
"<code>:urlencode</code> ዩአርኤል የተመለሰውን "
"እሴት ይከብራል (encodes)።"

msgid "Submission exclude empty elements"
msgstr "የተላክ እቃዎች ባዶ እቃዎችን ያስወግዱ"

msgid "Submission exclude unselected checkboxes"
msgstr ""
"የማስገባት እቃዎች አይመረጡም ያሉ "
"ቼክቦክሶችን ይዘልላል"

msgid "@source_entity: @webform"
msgstr "@source_entity: @webform"

msgid ""
"Select how the form's title is displayed when this webform is attached "
"to a source entity. This title is only displayed when a webform is "
"linked to from a source entity or opened in dialog."
msgstr ""
"ይህ ዌብፎርም ከምንጭ አካል (source entity) ጋር "
"ሲያያዝ የፎርሙ ርዕስ እንዴት እንደሚታይ "
"ይምረጡ። ይህ ርዕስ ዌብፎርሙ ከምንጭ "
"አካል ተገናኝቶ ሲከፈት ወይም በዳይሎግ "
"ውስጥ ሲከፈት ብቻ ይታያል።"

msgid "Source entity: Webform"
msgstr "ምንጭ አካል (Source entity): የዌብፎርም"

msgid "Webform: Source entity"
msgstr "ዌብፎርም፦ የምንጭ አካል"

msgid "Included submission values"
msgstr "የተካተቱ የማስገባት ዋጋዎች"

msgid ""
"If you wish to include only parts of the submission when viewing as "
"HTML, table, or plain text, select the elements that should be "
"included. Please note, element specific access controls are still "
"applied to displayed elements."
msgstr ""
"የማቅረቢያው ክፍሎች ብቻ በ HTML፣ በጠረጴዛ "
"(table) ወይም በቀላል ጽሑፍ (plain text) ሲታዩ "
"ለማካተት ከፈለጉ፣ ሊካተቱ የሚገቡትን "
"እቃዎች (elements) ይምረጡ። እባክዎን ይህን "
"ያስታውሱ፣ የእቃ-ተኮር መዳረሻ ቁጥጥር "
"(access controls) አሁንም ለታዩ እቃዎች ላይ "
"ተፈጻሚ ይሆናል።"

msgid "If checked, an add more input will be added below the multiple values."
msgstr ""
"اگر چک شده باشد، در زیرِ چندین مقدار، "
"یک ورودی «ደማረ ላይ ጨምር» ይታከላል።"

msgid "Wrapper type and attributes"
msgstr "የመያዣ አይነት እና ባህሪያት"

msgid "Wraps inputs in a fieldset."
msgstr ""
"የግብዓቶችን መጠቅለያ በfield set ውስጥ "
"ያደርጋል።"

msgid "Wraps inputs in a basic form element with title and description."
msgstr ""
"መሰረታዊ ፎርም አባል (element) ውስጥ "
"ግቤቶችን በማሸፈን፣ ከርዕስ እና መግለጫ "
"ጋር።"

msgid "Wraps inputs in a basic div with no title or description."
msgstr ""
"ශୀರ್ಷකයක්ንም መግለጫንም ሳይይዝ፣ "
"መግብዓቶችን በቀላል div ውስጥ ይጠቅልላል።"

msgid ""
"Use this paragraph field's main entity as the webform submission's "
"source entity."
msgstr ""
"የዚህ የአንቀጽ መስክ ዋና አካል (main entity) "
"እንደ ዌብፎርም ማስገቢያ (webform submission) "
"ምንጭ አካል (source entity) ይጠቀሙ።"

msgid ""
"If unchecked, the current page's entity will be used as the webform "
"submission's source entity."
msgstr ""
"ካልተሰየመ (unchecked) ከሆነ፣ የዚህ ገጽ "
"የአካል (entity) ሲቆም የዌብፎርም ግብዓት "
"(submission) ምንጭ እንደሚጠቀም ይሆናል።"

msgid ""
"This paragraph field's main entity will be used as the webform "
"submission's source entity."
msgstr ""
"ይህ የ“paragraph” መስክ ዋና አካል "
"የዌብፎርም ማስገቢያው ምንጭ አካል ሆኖ "
"ይጠቀማል።"

msgid ""
"If set, this message will be used when a pattern is not matched, "
"instead of the default \"@message\" message."
msgstr ""
"ይህ ከተዘጋጀ ይህ መልዕክት ከ“pattern” ጋር "
"ማዛመድ ካልተገኘ በአማራጭ “@message” "
"መልዕክት ምትክ ይጠቀማል።"

msgid "@title minimum message"
msgstr "@title ዝቅተኛ መልዕክት"

msgid "@title maximum message"
msgstr "@title ከፍተኛ መልዕክት"

msgid "Limit user to one submission per source entity"
msgstr ""
"ተጠቃሚውን በአንድ ምንጭ አካል ላይ አንድ "
"ጊዜ ብቻ እንዲያስገባ ገድብ።"

msgid "Advanced Webforms"
msgstr "උසස් වෙබ්ഫորմස්"

msgid ""
"This presentation gives you the extra knowledge you need to get the "
"most out the Webform module."
msgstr ""
"ይህ አቀራረብ የዌብፎርም (Webform) ሞጁሉን "
"ከምንም በላይ ተጠቅመው እንዲጠቅሙበት "
"የሚያስፈልግዎትን ተጨማሪ እውቀት "
"ይሰጥዎታል።"

msgid "Allow users to update a submission using a secure token"
msgstr ""
"ተጠቃሚዎች ደህንነት ያለው ቶከን በመጠቀም "
"ማስረከቡን እንዲያዘምኑ ያስችሉ"

msgid "Limit total to one submission per webform/source entity"
msgstr ""
"ጠቅላላውን ለአንድ ብቻ የዌብፎርም/ምንጭ "
"አካል ውስጥ በአንድ ጊዜ የሚፈቀድ "
"ማስገቢያ ደረጃ ያድርጉ"

msgid ""
"Only submission administrators will only be able to create and update "
"the unique submission."
msgstr ""
"የማስገቢያ (submission) አስተዳዳሪዎች ብቻ ልዩ "
"የማስገቢያውን (unique submission) መፍጠር እና "
"ማዘመን (update) ይችላሉ።"

msgid ""
"Webform blocks can be used to place this webform on the desired source "
"entity types."
msgstr ""
"የWebform ብሎኮች ይህን ዌብፎርም በተፈለገው "
"ምንጭ አካል ዓይነቶች ላይ ለማስቀመጥ "
"ሊውሉ ይችላሉ።"

msgid "Limit users to one submission per webform/source entity"
msgstr ""
"ተጠቃሚዎችን ለአንድ የድር ቅጽ/ምንጭ "
"አካል አንድ ጊዜ ብቻ የማስገባት ገደብ "
"ይጣሩ"

msgid ""
"Only authenticated users will be able to create and update their "
"unique submission."
msgstr ""
"የተመረጡ (authenticted) ተጠቃሚዎች ብቻ "
"የራሳቸውን ልዩ ግብዓት (submission) መፍጠር "
"እና ማዘመን ይችላሉ።"

msgid ""
"<strong>Warning</strong>: The below settings give users, permissions, "
"and roles full access to this webform's configuration via API "
"requests."
msgstr ""
"<strong>ማስጠንቀቂያ</strong>: ከታች ያሉት "
"ማስተካከያዎች በAPI ጥያቄዎች ተጠቅመው "
"ተጠቃሚዎች፣ ፈቃዶች እና ሚናዎች ለዚህ "
"የድር ቅጽ (webform) ውቅር ሙሉ መድረሻ "
"እንዲኖራቸው ይፈቅዳሉ።"

msgid "Affect any elements which use these images"
msgstr ""
"እነዚህን ምስሎች የሚጠቀሙ ማንኛውንም "
"ክፍሎች ላይ ተፅዕኖ ያሳድሩ"

msgid "%label is used by the below webform(s)."
msgstr ""
"%label በከታች ያሉት Webform(ዎች) ውስጥ "
"በመጠቀም ይረዳል።"

msgid "Delete all related submissions"
msgstr "ሁሉንም ተዛማጅ ግብዓቶች ሰርዝ"

msgid "Affect any fields or nodes which reference this webform"
msgstr ""
"ይህን የድር ቅጽ የሚያጣብቁ ወይም "
"የሚጠቅሱ ማንኛውንም መስኮች ወይም ኖዶች "
"ላይ ተጽዕኖ ያድርጉ"

msgid "Affect any elements which use these options"
msgstr ""
"እነዚህን አማራጮች የሚጠቀሙ ማንኛውም "
"አካላት ላይ ተጽዕኖ ያድርጉ"

msgid "%label is used by the below composite element(s)."
msgstr ""
"%label ከታች ባሉት ውህድ አካል(ዎች) ጋር "
"ይጠቅማል።"

msgid "@webform: @source_entity"
msgstr "@webform: @source_entity"

msgid "Delete '@label' @entity-type?"
msgstr "'@label' @entity-typeን ሰርዝ?"

msgid "Delete %label @entity-type?"
msgstr "%label @entity-type ይሰረዝ?"

msgid "Yes, I want to delete the %label @entity-type"
msgstr "አዎ፣ የ%label @entity-type እፈልጋለሁ ማጥፋት።"

msgid "Clear all %label submissions?"
msgstr "ሁሉንም %label  സമርጫዎች መሰረይ?"

msgid "Remove records from the database"
msgstr "ከዲቢ (database) ላይ መዝገቦችን ሰርዝ"

msgid "Remove @submission_total @submissions in @form_total @forms"
msgstr ""
"በ @forms ውስጥ ያሉ @form_total ውስጥ @submission_total "
"እና @submissions ን አስወግድ።"

msgid "Scheduled email settings"
msgstr "የታቀደ (Scheduled) ኢሜይል ቅንብሮች"

msgid "Webform scheduled email settings"
msgstr "የዌብፎርም የታቀደ ኢሜይል ቅንብሮች"

msgid "Scheduled email type (date or date/time)"
msgstr ""
"ተመድቦ የኢሜይል አይነት (ቀን ወይም "
"ቀን/ሰዓት)"

msgid "Email will be sent immediately when testing this webform"
msgstr ""
"ይህን የድር ቅፅ (webform) ሲፈትሹ ኢሜይል "
"በተመልከት ጊዜ ይላካል።"

msgid "How to Create Forms using Webform and Contact in Drupal 8"
msgstr ""
"የ Drupal 8 ውስጥ Webform እና Contact በመጠቀም "
"ቅጾችን እንዴት መፍጠር እንደሚቻል"

msgid "WebWash"
msgstr "ዌብዋሽ"

msgid ""
"Learn how to create forms using Webform and Contact module in Drupal "
"8."
msgstr ""
"Drupal 8 ውስጥ በWebform እና Contact ሞጁሎች "
"ተጠቅመው ፎርሞችን እንዴት መፍጠር "
"እንደሚቻል ይማሩ።"

msgid "Learn how to download and install the Webform module."
msgstr ""
"የWebform ሞጁሉን እንዴት ማውረድ እና መጫን "
"እንደሚቻል ይማሩ።"

msgid "Using Webform in Drupal 8, 1.2: Create a Form"
msgstr ""
"የ Drupal 8 ውስጥ Webform ን በመጠቀም፣ 1.2: ፎርም "
"ፍጠር"

msgid ""
"Learn how to create a form from scratch and add three elements to it: "
"Name, Email and Telephone."
msgstr ""
"ከመጀመሪያው ጀምሮ ፎርምን እንዴት መፍጠር "
"እንደሚቻል ይማሩ እና ለእሱ ሶስት "
"አካላትን ያክሉ፡ ስም፣ ኢሜይል እና ስልክ "
"ቁጥር።"

msgid "Learn how to create conditional elements."
msgstr "条件付きの要素（element）を作成する方法を学びましょう。"

msgid "Using Webform in Drupal 8, 2.2: Create Multi-step Wizard"
msgstr ""
"Drupal 8 ውስጥ Webform ን በመጠቀም፣ 2.2፡ ባለብዙ "
"ደረጃ (Multi-step) ዊዛርድ ፍጠር"

msgid "Learn how to create a multi-step page form."
msgstr ""
"چند ደረጃ ያለው የገጽ ቅጽ እንዴት "
"እንደሚፈጥሩ ይወቁ።"

msgid "Using Webform in Drupal 8, 2.3: Float Elements Next to Each Other"
msgstr ""
"Drupal 8 ውስጥ Webform መጠቀም፣ 2.3፦ ከአንዱ "
"አጠገብ ሌላው የሚቆሙ Float ክፍሎች"

msgid "Learn how to float elements next to each other on a form."
msgstr ""
"ፎርም ላይ አንድ በአንድ እንዲተካከሉ "
"አባሎችን እንዴት አጠገብ እንደሚያስቀምጡ "
"ይማሩ።"

msgid "Using Webform in Drupal 8, 2.4: Create List Options"
msgstr ""
"በ Drupal 8 ውስጥ Webform ን መጠቀም፣ 2.4፡ "
"የዝርዝር አማራጮችን መፍጠር"

msgid "Learn how to create reusable list options for elements."
msgstr ""
"ဒြပ်စင်များအတွက် "
"ပြန်လည်အသုံးပြုနိုင်သော "
"လစ္စတ်ရွေးချယ်စရာများကို "
"ဘယ်လိုဖန်တီးရမလဲဆိုတာ "
"လေ့လာပါ။"

msgid "Using Webform in Drupal 8, 2.5: Sending Emails"
msgstr ""
"Drupal 8 ውስጥ Webform በመጠቀም፣ 2.5፡ "
"ኢሜይሎችን መላክ"

msgid "Learn how to send emails when a submission is submitted."
msgstr ""
"സമర్పණයක් ሲገባ ሲደረግ ኢሜይሎችን "
"እንዴት መላክ እንደሚቻል ይማሩ።"

msgid "Using Webform in Drupal 8, 2.6: Create Confirmation Page"
msgstr ""
"Drupal 8 ውስጥ Webform በመጠቀም፣ 2.6፡ "
"የማረጋገጫ ገጽ መፍጠር"

msgid "Learn how to create a custom confirmation page."
msgstr ""
"አንድ ብጁ የማረጋገጫ ገጽ እንዴት "
"እንደሚፈጥሩ ይማሩ።"

msgid "Learn how to view and manage submission data."
msgstr ""
"የማስገባት መረጃን እንዴት ማየት እና "
"መቆጣጠር እንደሚቻል ይማሩ።"

msgid "Using Webform in Drupal 8, 3.2: Allow Draft Submissions"
msgstr ""
"ድራፓል 8 ውስጥ ዌብፎርምን በመጠቀም፣ 3.2፡ "
"ረቂቅ ቅርጾችን መፍቀድ"

msgid "Learn how to allow users to save draft submissions."
msgstr ""
"အသုံးပြုသူများအား "
"မူကြမ်းတင်ပြချက်များကို "
"သိမ်းဆည်းနိုင်အောင် "
"ခွင့်ပြုရန် "
"မည်သို့လုပ်ဆောင်ရမည်ကို "
"လေ့လာပါ။"

msgid "Learn how to integrate Webform with other system using Zapier."
msgstr ""
"Zapierን በመጠቀም የWebformን ከሌሎች ስርዓቶች "
"ጋር እንዴት እንደሚያዋህዱ ይማሩ።"

msgid "Learn how to display a form as a block."
msgstr ""
"ፎርሙን እንደ ብሎክ ለማሳየት እንዴት "
"እንደሚቻል ይማሩ።"

msgid "Using Webform in Drupal 8, 5.2: Display Form using Webform Node"
msgstr ""
"Drupal 8 ውስጥ የ Webform ን በመጠቀም፣ 5.2፡ ከ "
"Webform ኖድ በመጠቀም ፎርምን ማሳየት"

msgid "Learn how to display forms using Webform Node sub-module."
msgstr ""
"Webform Node ማባዣ (sub-module) በመጠቀም ፎርሞችን "
"እንዴት ማሳየት እንደሚቻል ይማሩ።"

msgid "The %handler email/handler for the %webform webform does not exist."
msgstr ""
"የ %webform የዌብፎርም የ %handler "
"ኢሜይል/ሀንደለር አልነበረም።"

msgid ""
"Testing the %webform webform %handler @type. <strong>All other "
"emails/handlers are disabled.</strong>"
msgstr ""
"የ %webform የ webform %handler አይነትን በመፈተሽ። "
"<strong>ሌሎች ሁሉም ኢሜይሎች/ሃንድለሮች "
"ተበልጠዋል (disabled)።</strong>"

msgid "@title is @value"
msgstr "`@title` ከ`@value` ጋር"

msgid ""
"Creating custom conditional logic (Form API #states) with nested "
"conditions or custom selectors will disable the conditional logic "
"builder. This will require that Form API #states be manually entered."
msgstr ""
"ከተፈጠሩ ልማዳዊ ሁኔታዊ ሎጂክ (Form API #states) "
"ጋር የተደፋፈሩ ሁኔታዎች ወይም ልማዳዊ "
"ምርጫዎች (selectors) መጠቀም የሁኔታዊ ሎጂክ "
"ገንቢውን ያሰናክላል። ይህም Form API #states "
"በእጅ በእጅ እንዲገቡ ይፈልጋል።"

msgid ""
"The %selector element is used more than once within the %state state. "
"To use multiple values within a trigger try using the pattern trigger."
msgstr ""
"የ `%selector` ኤለመንት በ `%state` ሁኔታ ውስጥ "
"ከአንድ ጊዜ በላይ ይጠቀማል። በትርጎ "
"(trigger) ውስጥ ብዙ እሴቶችን ለመጠቀም ከ "
"`trigger` ጋር የሚመጣውን ንድፍ ፓትርን (pattern) "
"በመጠቀም ይሞክሩ።"

msgid ""
"Scheduled forms do not work as expected for anonymous users when "
"Drupal's <a href=\":page_cache_href\">Internal Page Cache</a> module "
"is enabled. This is a <a href=\":issue_href\">known issue</a>."
msgstr ""
"የተቀናበሩ ቅጾች (Scheduled forms) ከ Drupal "
"አማካኝነት <a href=\":page_cache_href\">Internal Page "
"Cache</a> ሞጁል ሲነቃ ለአኖኒመሰ ተጠቃሚዎች "
"በተጠበቀው መልኩ አይሰሩም። ይህ የ <a "
"href=\":issue_href\">የታወቀ ጉዳይ</a> ነው።"

msgid "Display wrapper attributes"
msgstr ""
"የማሳያ ውስጥ መጠቅለያ (wrapper) አትሪቡቶች "
"አሳይ"

msgid ""
"Apply classes to the element's display wrapper. Select 'custom…' to "
"enter custom classes."
msgstr ""
"ဒြပ်စင်၏ 표시 (display) ዙሪያ ጠባቂ "
"(wrapper) ላይ ክፍሎች (classes) ተግብር። "
"ለተፈላጊ (custom) ክፍሎች ለመግባት “custom…” "
"ይምረጡ።"

msgid "Apply custom styles to the element's display wrapper."
msgstr ""
"የእቃውን ማሳያ መጠቅስ (display wrapper) ላይ "
"ተጨማሪ ስታይሎችን ይተግብሩ።"

msgid ""
"Enter additional attributes to be added to the element's display "
"wrapper."
msgstr ""
"ဒြပ်စည်း (element) ၏ ප්‍රదర్శන "
"wrapper  ဆိုင်ရာ "
"ပေါင်းထည့်ရမည့် "
"အပိုဂုဏ်သတ္တိများကို "
"ထည့်သွင်းပါ။"

msgid "Vehicle identification number (VIN)"
msgstr "የተሽከርካሪ መለያ ቁጥር (VIN)"

msgid "No error response messages entered. Please add messages below."
msgstr ""
"ምንም የስህተት መልዕክቶች አልተገቡም። "
"እባክዎ ከታች መልዕክቶችን ያክሉ።"

msgid "<strong>@title</strong> (Installed)"
msgstr "<strong>@title</strong> (ተጭኗል)"

msgid ""
"The <a href=\":homepage_href\">@title</a> library is installed by the "
"<b><a href=\":module_href\">@module</a></b> module."
msgstr ""
"የ <a href=\":homepage_href\">@title</a> ቤተ-መጽሐፍት "
"(library) የተጫነው በ <b><a "
"href=\":module_href\">@module</a></b> ሞጁል ነው።"

msgid "Repair webform configuration"
msgstr "የዌብፎርም ውቅርን ጠግን"

msgid "Repair configuration"
msgstr "የቅንብር ጥገና"

msgid "Date minimum"
msgstr "ቀን መቁጠር ዝቅተኛው"

msgid "Date maximum"
msgstr "ከፍተኛ ቀን"

msgid ""
"'Date/time' minimum or maximum should not be used with 'Date' or "
"'Time' specific minimum or maximum."
msgstr ""
"‘ቀን/ሰዓት’ ዝቅተኛ ወይም ከፍተኛ እሴት "
"ከ‘ቀን’ ወይም ከ‘ሰዓት’ ግልጽ ዝቅተኛ "
"ወይም ከፍተኛ እሴቶች ጋር መጠቀም "
"አይገባም።"

msgid "Date/time minimum"
msgstr "የቀን/ሰዓት ዝቅተኛ እሴት"

msgid "Specifies the minimum date/time."
msgstr "የቢያንስ ቀን/ሰዓትን ይገልጻል።"

msgid ""
"Accepts any date in any <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">GNU "
"Date/Time Input Format</a>. Strings such as today, +2 months, and Dec "
"9 2004 10:00 PM are all valid."
msgstr ""
"ማንኛውንም ቀን በማንኛውም <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">GNU "
"የቀን/ሰዓት ግቤት ቅርጸት</a> ውስጥ "
"ይቀበላል። “today”፣ “+2 months” እና “Dec 9 2004 "
"10:00 PM” ያሉ ዐይነቶች ሁሉ ትክክል ናቸው።"

msgid "Date/time maximum"
msgstr "የቀን/ሰዓት ಗರಿಷ್ಠ እሴት"

msgid "Specifies the maximum date/time."
msgstr "የከፍተኛ ቀን/ሰዓትን ይገልጻል።"

msgid "Other maximum"
msgstr "ሌላ ከፍተኛው"

msgid "Determines the placement of the file upload help ."
msgstr ""
"የፋይል ክትትል እገዛው ሊቀመጥበት "
"የሚኖረውን ቦታ ይወስናል።"

msgid "@title: Email @action by '@handler' handler to be sent on @date."
msgstr ""
"@title: ኢሜይል @action በ'@handler' እጅ ለ@date "
"ለመላክ።"

msgid "@title: Email unscheduled for '@handler' handler."
msgstr ""
"@title: '@handler' ኸንደኛ አግልግሎት ለኢሜይሉ "
"ተመድቦ ያልተደረገ ነበር።"

msgid "Webform Submission Log"
msgstr "የዌብፎርም  സമሞ መዝገብ"

msgid "Dedicated logging and reporting for webform submissions."
msgstr ""
"የድር ፎርም  സമሚት (submissions) ለመመዝገብ "
"እና ለሪፖርት ማቅረብ የተለየ መመዝገብና "
"ሪፖርቲንግ።"

msgid "The element key %name on line @line_number is a reserved key."
msgstr ""
"መስመር @line_number ላይ ያለው የአካል ቁልፍ "
"%name የተጠበቀ (reserved) ቁልፍ ነው።"

msgid ""
"The webform submission log will track more detailed user information "
"including email addresses and subjects."
msgstr ""
"የድረ-ገጽ ፎርም ግብዓት መዝገብ (webform "
"submission log) ኢሜይል አድራሻዎችንና ርዕሶችን "
"ጨምሮ የተጨማሪ የተጠቃሚ መረጃዎችን "
"ይከታተላል።"

msgid ""
"Enable the 'Webform Submission Log' module to better track and "
"permanently store submission logs."
msgstr ""
"የ«Webform Submission Log» ሞጁሉን አንቃ ማድረግ "
"በመጠቀም የቅርብ ላኪ መዝገቦችን የተሻለ "
"ለመከታተል እና መዝገቦቹን ቋሚ በሆነ "
"መልኩ ለማስቀመጥ ይረዳል።"

msgid "Required elements defaults to: %required"
msgstr ""
"අవශ්‍ය අංගයන් සඳහා "
"පෙරනිමිය මෙයට සකසා ඇත: %required"

msgid "Optional elements defaults to: %optional"
msgstr ""
"አማራጭ አካላት ነባሪ እሴት ይሆናል፡ "
"%optional"

msgid "Counter minimum or maximum is required."
msgstr ""
"የአነስተኛ ወይም የከፍተኛ መጠን "
"የሚያስፈልግ ነው።"

msgid ""
"Use x-www-form-urlencoded if unsure, as it is the default format for "
"HTML webforms. You also have the option to post data in <a "
"href=\"http://www.json.org/\">JSON</a> format."
msgstr ""
"የማታውቁ ከሆነ `x-www-form-urlencoded` ይጠቀሙ፤ "
"እሱ ለ HTML ዌብፎርሞች ነባሪ ቅርጸ-ቅርጽ "
"ነው። እንዲሁም መረጃውን በ <a "
"href=\"http://www.json.org/\">JSON</a> ቅርጸ-ቅርጽ "
"ለመላክ አማራጭ አለዎት።"

msgid "@label text / description"
msgstr "@label ጽሁፍ / መግለጫ"

msgid "Select what happens when a user is denied access to this webform."
msgstr ""
"මෙහි වෙබ්‌ආකාරයට (webform) "
"ප්‍රවේශය පරිශීලකයෙකුට "
"ප්‍රතික්ෂේප වූ විට "
"සිදුවිය යුත්තේ කුමක්දැයි "
"තෝරන්න။"

msgid ""
"Go to <a href=\":href\">submission settings</a> to select what happens "
"when a user is denied access to submissions."
msgstr ""
"Օգտատիրոջը ներկայացումների "
"հասանելիությունը մերժվելիս ինչ է "
"կատարվում ընտրելու համար անցեք <a "
"href=\":href\">ներկայացումների "
"կարգավորումներ</a>:"

msgid "Select what happens when a user is denied access to a submission."
msgstr ""
"ተጠቃሚው ለገቢ (submission) መዳረሻ "
"እንደተከለከለ ሲደርስ ምን እንደሚከናወን "
"ይምረጡ።"

msgid ""
"Go to <a href=\":href\">form settings</a> to select what happens when "
"a user is denied access to a webform."
msgstr ""
"ተጠቃሚው ወደ ዌብፎርም መድረስ ከተከለከለ "
"ምን እንደሚሆን ለመምረጥ ወደ <a "
"href=\":href\">የፎርም ቅንብሮች</a> ይሂዱ።"

msgid "Wrap long lines of text"
msgstr ""
"ረጅም የጽሑፍ መስመሮችን መጠቅለል (Wrap) "
"ያድርጉ"

msgid "200 OK"
msgstr "200 እሺ"

msgid ""
"Please make sure to enable 'Include files as attachments' for each "
"email handler that you want to send this attachment."
msgstr ""
"እባክዎ ይህን እንደ አባሪ (attachment) ለመላክ "
"የሚፈልጉትን እያንዳንዱን የኢሜይል "
"ሃንደለር (email handler) ውስጥ “Include files as "
"attachments” እንዲነቃ መፈታታትዎን "
"ያረጋግጡ።"

msgid ""
"Please enter the attachment's file name with a file extension. The "
"file extension will be used to determine the attachment's content "
"(mime) type."
msgstr ""
"ദയവായി "
"അറ്റാച്ച്മെന്റിന്റെ ഫയൽ "
"നാമം ഫയൽ "
"എക്സ്റ്റെൻഷനോടൊപ്പം "
"നൽകുക. ആ ഫയൽ എക്സ്റ്റെൻഷൻ "
"അറ്റാച്ച്മെന്റിന്റെ "
"ഉള്ളടക്കത്തിന്റെ (mime) തരം "
"നിർണയിക്കാൻ ഉപയോഗിക്കും."

msgid ""
"Make sure the attachment URL/Path is publicly accessible. The "
"attachment's URL/path will never be displayed to end users."
msgstr ""
"አባሪው (attachment) ዩአርኤል/መንገድ (path) "
"ህዝብ ሊያገኘው የሚችል መሆኑን ያረጋግጡ። "
"የአባሪው ዩአርኤል/መንገድ ለመጨረሻ "
"ተጠቃሚዎች በጭራሽ አይታይም።"

msgid ""
"Webforms must first be <a href=\":href\">created</a> before "
"referencing them."
msgstr ""
"የድር ፎርሞች (Webforms) እነሱን ለመጥቀስ "
"ከመጀመርዎ በፊት በመጀመሪያ <a "
"href=\":href\">መፍጠር</a> አለባቸው።"

msgid "Sending webform email attachments"
msgstr "ვեբ폼 ኢሜይል አባሪዎችን መላክ"

msgid ""
"This presentation shows how to set up and add email attachments via an "
"email handler."
msgstr ""
"ይህ በማቅረብ መግለጫ አማካኝነት ኢሜይል "
"ሃንደለቶችን (attachments) በኢሜይል ሃንደለር "
"በኩል እንዴት ማዘጋጀትና እንዴት "
"እንደሚተጨምሩ ያሳያል።"

msgid "How to send email attachments? | Drupal.org"
msgstr ""
"የኢሜል አባሪዎችን እንዴት መላክ ይቻላል? | "
"Drupal.org"

msgid ""
"Multiple test submissions can be created using the Devel generate "
"module."
msgstr ""
"በ Devel generate ሞጁሉ በመጠቀም ብዙ የፈተና "
"ማስገቢያዎች (test submissions) ሊፈጠሩ ይችላሉ።"

msgid "Form access denied settings"
msgstr "የቅጽ መዳረሻ ተከልክሏል ማሰናጃዎች"

msgid "Form preview settings"
msgstr "የቅጹ አብራሪ ቅንብሮች"

msgid "Form custom settings"
msgstr "ቅጽ የተበጁ መቼቶች"

msgid "Form method"
msgstr "የፎርም ዘዴ (Method)"

msgid "Form action"
msgstr "የቅጽ እርምጃ"

msgid "Form custom properties"
msgstr "ቅጽ ውስጥ የተለያዩ ብጁ ባህሪዎች"

msgid "Submission general settings"
msgstr "የማስገባት አጠቃላይ መቼቶች"

msgid "Submission user settings"
msgstr "የማስገቢያ ተጠቃሚ ቅንብሮች"

msgid "Submission access denied settings"
msgstr "የማስገባት መዳረሻ ተከልክሏል ቅንብሮች"

msgid "Submission limit settings"
msgstr "የඉሩጅት ገደብ ማስተካከያዎች"

msgid "Submission draft settings"
msgstr "የማስገባት ረቂቅ ቅንብሮች"

msgid "Submission autofill settings"
msgstr "የመምሪያ ራስ-መሙላት ቅንብሮች"

msgid "Submission views settings"
msgstr "የተስገበሩ እይታ (Submission) ቅንብሮች"

msgid "Form confirmation settings"
msgstr "دርም ማረጋገጫ ቅንብሮች"

msgid "Form dialog settings"
msgstr "دረስብ የቅንብር ውይይት (Dialog) ቅንብሮች"

msgid ""
"The HTML to display for a single element value. You may include HTML "
"or <a href=\":href\">Twig</a>. You may enter data from the submission "
"as per the \"variables\" below."
msgstr ""
"ለአንድ ነጠላ እሴት ማሳያ የሚውለው የHTML "
"ይዘት። እርስዎ ውስጥ HTML ማካተት ይችላሉ "
"ወይም <a href=\":href\">Twig</a> ማካተት ይችላሉ። "
"ከታች በ«variables» መሠረት የማስገባት "
"ውሂብን እንደ ማንኛውም በመግባት ሊገቡ "
"ይችላሉ።"

msgid ""
"The text to display for a single element value. You may include <a "
"href=\":href\">Twig</a>. You may enter data from the submission as per "
"the \"variables\" below."
msgstr ""
"ለአንድ የእሴት እትም ለማሳየት የሚሆነው "
"ጽሑፍ። <a href=\":href\">Twig</a> ማካተት "
"ትችላለህ። ከታች “variables” በተገለጹት "
"መሠረት በማስገባቱ (submission) ውስጥ ያለውን "
"ውሂብ መግባት ትችላለህ።"

msgid ""
"The HTML to display for multiple element values. You may include HTML "
"or <a href=\":href\">Twig</a>. You may enter data from the submission "
"as per the \"variables\" below."
msgstr ""
"ብዙ ኤለመንት ዋጋዎች ለማሳየት "
"የሚያስፈልግ HTML። HTML ማካተት ይችላሉ ወይም "
"<a href=\":href\">Twig</a> መጠቀም ይችላሉ። ከታች "
"በተመለከቱት “variables” መሠረት ከማስገባቱ "
"የመጣውን ውሂብ ማስገባት ይችላሉ።"

msgid ""
"The text to display for multiple element values. You may include <a "
"href=\":href\">Twig</a>. You may enter data from the submission as per "
"the \"variables\" below."
msgstr ""
"ብዙ የእቃ ዋጋዎች ለመታየት የሚውል "
"ጽሑፍ። እርስዎ <a href=\":href\">Twig</a> ማካተት "
"ይችላሉ። ከታብል ግቤቱ ውስጥ ውሂብ እንደ "
"“variables” በታች በተገለጸው መሠረት "
"ማስገባት ይችላሉ።"

msgid ""
"Editing webform source code allows users to alter and possibly break a "
"webform's render array."
msgstr ""
"የዌብፎርም ምንጭ ኮድን ማረም ተጠቃሚዎች "
"የዌብፎርሙን የማቅረቢያ (render array) ሊለውጡ "
"እና ምናልባት ሊያበላሹ ይችላሉ።"

msgid ""
"The <strong>Upload</strong> page allows a CSV (comma separated values) "
"file or URL to be uploaded, converted, and imported into webform "
"submissions."
msgstr ""
"<strong>Upload</strong> የሚል ገጽ በCSV (ነጥብ "
"በነጥብ የተለያዩ እሴቶች፣ comma separated values) "
"ፋይል ወይም URL እንዲሁ ተጭኖ እንዲገባ፣ "
"ተቀይሮ ወደ ዌብፎርም ምልክቶች (webform "
"submissions) እንዲገባ ያስችላል።"

msgid "Provides the ability to export and import submissions."
msgstr ""
"የተሞላ አቅርቦቶችን (submissions) "
"መላክ/መውጣት (export) እና ማስመጣት (import) "
"እንዲቻል አቅም ይሰጣል።"

msgid "Unable to locate source entity (@entity_type:@entity_id)"
msgstr ""
"ምንጭ አካልን (@entity_type:@entity_id) ማግኘት "
"አልተצליחም"

msgid ""
"The upload directory %directory for the file element %name could not "
"be created or is not accessible. A newly uploaded file could not be "
"saved in this directory as a consequence, and the upload was canceled."
msgstr ""
"የፋይል አካሉ %name የሚጠቀምበትን ማስጫኛ "
"አቃፊ %directory መፍጠር አልተቻለም ወይም "
"መድረስ አይቻልም። በዚህ ምክንያት አዲስ "
"የተጫነ ፋይል በዚህ አቃፊ ውስጥ መቀመጥ "
"አልተቻለም እና ማስጫኑ ተሰርዟል።"

msgid "Importing submissions is a new and experimental feature."
msgstr ""
"የተሰጡ ምዝገባዎችን መግባት (importing) አዲስ "
"እና በሙከራ ላይ ያለ ባህሪ ነው።"

msgid ""
"Please test and review your imported submissions using a "
"development/test server."
msgstr ""
"దయచేసి ከመጠባበቂያ/ሙከራ አገልጋይ "
"ጋር የተገባበሩትን ማቅረቦች በሙከራ እና "
"በግምገማ ያስፈልጉ።"

msgid "All submission properties and data is optional."
msgstr ""
"ሁሉም የማስገባት ባህሪዎችና ውሂብ አማራጭ "
"ናቸው።"

msgid "If UUIDs are included, existing submissions will always be updated."
msgstr ""
"UUID ዎች ከተካተቱ፣ ያሉት ግብዓቶች ሁሌም "
"በራሳቸው መዘመን ይደረጋሉ።"

msgid ""
"If UUIDs are not included, already imported and unchanged records will "
"not create duplication submissions."
msgstr ""
"UUIDs ካልተካተቱ በስተቀር፣ እድሜያቸው እና "
"ማስገባታቸው ያልተቀየሩ የተገቡ መዛግብት "
"ዳግም ማስገባት (duplication submissions) "
"አይፈጥሩም።"

msgid ""
"File uploads must use publicly access URLs which begin with http:// or "
"https://."
msgstr ""
"የፋይል ማስገባት (uploads) እውነተኛ ይግባኝ "
"ያላቸው (publicly accessible) URL ዎችን መጠቀም "
"አለባቸው፣ እነዚህም `http://` ወይም `https://` "
"በሚጀምሩ መሆን አለባቸው።"

msgid "Entity references can use UUIDs or entity IDs."
msgstr ""
"የእንተዋይ ማጣቀሻዎች UUID ወይም "
"የእንተዋይ መታወቂያ (entity IDs) መጠቀም "
"ይችላሉ።"

msgid ""
"Composite (single) values are annotated using double underscores. "
"(e.g. ELEMENT_KEY__SUB_ELEMENT_KEY)"
msgstr ""
"የተዋሃዱ (ነጠላ) እሴቶች በእርግጥ ሁለት "
"መደበኛ መስመሮች (double underscores) "
"ተገልጸዋል። (ለምሳሌ፣ ELEMENT_KEY__SUB_ELEMENT_KEY)"

msgid ""
"Multiple composite values are formatted using <a href=\":href\">inline "
"YAML</a>."
msgstr ""
"ብዙ የተዋቀሩ ውህዶች (composite) ዋጋዎች በ<a "
"href=\":href\">በመስመር-ውስጥ YAML</a> ተቀርበው "
"ይታያሉ።"

msgid "Import maximum execution time limit is @time."
msgstr ""
"የከፍተኛ አስፈጻሚ ጊዜ ገደብ መግቢያ @time "
"ነው።"

msgid ""
"<a href=\":href_view\">View</a> or <a "
"href=\":href_download\">download</a> an example submission CSV."
msgstr ""
"<a href=\":href_view\">ይመልከቱ</a> ወይም <a "
"href=\":href_download\">ያውርዱ</a> የምሳሌ የገቢያ "
"(submission) CSV ፋይል።"

msgid "Import data source"
msgstr "የውሂብ ምንጭ ያስገቡ"

msgid "Upload Submission CSV file"
msgstr "የማስገባት CSV ፋይል እዚህ ላክ/ጫን"

msgid "Enter Submission CSV remote URL"
msgstr "የአቀራረብ CSV የርቀት URL ያስገቡ"

msgid "Remote URL could be a <a href=\":href\">published Google Sheet</a>."
msgstr ""
"ርቀት ያለው ዩአርኤል የ <a href=\":href\">ታትሞ "
"የወጣ የGoogle Sheet</a> ሊሆን ይችላል።"

msgid "Submission CSV (Comma Separated Values) file"
msgstr ""
"የማስገባት CSV ፋይል (በኮማ የተለያዩ "
"እሴቶች)"

msgid "Are you sure you want to import @submissions?"
msgstr ""
"እርግጠኛ ነዎት @submissions እንዲገባ (import) "
"ማድረግ ይፈልጋሉ?"

msgid ""
"No UUID or token was found in the source (CSV). A unique hash will be "
"generated for the each CSV record. Any changes to already an imported "
"record in the source (CSV) will create a new submission."
msgstr ""
"ምንጭ (CSV) ውስጥ UUID ወይም ቶከን "
"አልተገኘም። ለእያንዳንዱ የCSV መዝገብ ልዩ "
"ሃሽ ይፈጠራል። ከዚህ በፊት በማስመጣት "
"ሂደት ውስጥ የተገባ መዝገብ ላይ በምንጭ "
"(CSV) ውስጥ ያሉ ማንኛውም ለውጦች አዲስ "
"ግቤት (submission) ያስፈጥራሉ።"

msgid "Import mapping"
msgstr "አቀናባታ (mapping) ውስጥ አስገባ"

msgid "Importing submissions"
msgstr "የግብዓቶችን ማስመጣት"

msgid "Imported @count of @total submissions…"
msgstr ""
"ከ @total መዝገቦች ውስጥ @count ግቤቶች "
"ተጭነዋል…"

msgid ""
"Submission import completed. (total: @total; created: @created; "
"updated: @updated; skipped: @skipped)"
msgstr ""
"የእትም ማስገባት ሂደት ተጠናቋል። "
"(አጠቃላይ፡ @total; ተፈጠሩ፡ @created; "
"ተዘምነዋል፡ @updated; ተዘልሏል፡ @skipped)"

msgid "Webform module now supports importing submissions | Drupal.org"
msgstr ""
"የ Webform ሞጁል አሁን  സമርብ (submissions) "
"መግባትን (imports) ይደግፋል | Drupal.org"

msgid ""
"Batch import size is used when submissions are being "
"imported/uploaded."
msgstr ""
"“Batch import size” (የባች ማስመጣት መጠን) "
"በማስገባት/መስቀል ጊዜ ውሂቡ ሲያስመጡ "
"ሲደረግ የሚጠቀሙበት መጠን ነው።"

msgid "If checked, users will be able search/filter images by their labels."
msgstr ""
"ከተምረጠ ተጠቃሚዎች ምስሎቹን በመለያ "
"ስያሜዎቻቸው በመፈለግ/በመጣራት ሊፈልጉ "
"ይችላሉ።"

msgid "Filter placeholder label"
msgstr "የማጣሪያ ቦታ (placeholder) መለያ"

msgid "Filter single item label"
msgstr "የነጠላ ንጥል መለያ ማጣሪያ መለያ"

msgid "Filter plural items label"
msgstr "የበለጠ እቃዎች መለያን ማጣሪያ"

msgid "Filter no results label"
msgstr "ምንም ውጤት የለም መለያ አጣራ"

msgid ""
"CSV data that can't be converted to submission data will display a "
"warning. If checked, these warnings will be treated as errors and "
"prevent the submission from being created."
msgstr ""
"ወደ ማስገቢያ መረጃ ሊለወጥ ያልቻለ የ CSV "
"ውሂብ ማስጠንቀቂያ ያሳያል። ካነቃቁት፣ "
"እነዚህ ማስጠንቀቂያዎች እንደ ስህተቶች "
"ይቆጠራሉ እና ማስገቢያው እንዳይፈጠር "
"ይከለክላሉ።"

msgid "Webforms for Healthcare"
msgstr "የጤና አገልግሎት ዘርፍ የድር ቅጾች"

msgid ""
"This presentation discusses how healthcare organizations can leverage "
"the Webform module for Drupal 8."
msgstr ""
"ይህ ማቅረቢያ የጤና አገልግሎት ድርጅቶች "
"Webform ሞጁልን በDrupal 8 ላይ እንዴት መጠቀም "
"እንደሚችሉ ይመራል።"

