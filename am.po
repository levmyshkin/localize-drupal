msgstr ""
"የክልል መሠረት የተዋቀረ የእውቂያ ቅጽ "
"ማሳያ።"

msgid "Employee: Email"
msgstr "ሰራተኛ፦ ኢሜይል"

msgid "Demo: Region Contact: Employee"
msgstr "ደሞ አጠቃቀም: ክልል አግኝት፡ ሰራተኛ"

msgid "Manager: Email"
msgstr "አስተዳዳሪ፦ ኢሜይል"

msgid "Demo: Region Contact: Manager"
msgstr "ዴሞ፦ የክልል አግኝነት፦ አስተዳዳሪ"

