msgstr "ወርሃዊ"

msgid "Variants"
msgstr "አማራጮች"

msgid "Last modification date"
msgstr "የመጨረሻ ማሻሻያ ቀን"

msgid "Change frequency"
msgstr "የለውጥ ድግግሞሽ"

msgid "Sitemap file"
msgstr "የሳይትማፕ ፋይል"

msgid "Number of sitemaps in this index"
msgstr ""
"በዚህ ማውጫ ውስጥ ያሉ የሳይትማፕዎች "
"ብዛት"

msgid "Sitemap URL"
msgstr "የዕቅድ ገጽ ዩአርኤል (Sitemap URL)"

msgid "Number of URLs in this sitemap"
msgstr ""
"በዚህ የሳይትማፕ ውስጥ ያሉ ዩአርኤሎች "
"ብዛት"

msgid "URL location"
msgstr "የURL አቀማመጥ"

msgid "Default base URL"
msgstr "የነባብ መሠረታዊ ዩአርኤል"

msgid "Translation set"
msgstr "የትርጉም ስብስብ"

msgid "Maximum links in a sitemap"
msgstr "በ sitemap ውስጥ ከፍተኛው የሊንኮች ብዛት"

msgid "Exclude duplicate links"
msgstr ""
"ድግግሞሽ የሆኑ ሊንኮችን አትሳት "
"(አትጨምር)"

msgid "Skip non-existent translations"
msgstr "ያልተነበበ/የማይኖር ትርጉሞችን አይዝለሉ"

msgid "The base URL is invalid."
msgstr ""
"መሠረታዊው ዩአርኤል (base URL) ዋጋ የሌለው "
"ነው።"

msgid "Include images"
msgstr "ምስሎችን አካትት"

msgid "The sitemap will be generated according to this interval."
msgstr ""
"የ sitemaps ፋይሉ ይህንን የጊዜ ልክ መሠረት "
"በማድረግ ይተነታነታል።"

msgid "There will be no links generated for languages checked here."
msgstr ""
"මෙහි የተመረጡ ቋንቋዎች ለማንኛውም "
"እነዚህ ሊንኮች አይፈጠሩም።"

msgid "Sitemap variants"
msgstr "የጣቢያ ካርታ ተለዋዋጮች"

msgid "Rebuild queue"
msgstr "የኪው (Queue) እንደገና ገንባ"

msgid "There are no items to be indexed."
msgstr "እንዲመዘገቡ የሚቻሉ ንጥሎች የሉም።"

msgid "Regenerate the sitemaps during cron runs"
msgstr ""
"ክron ሲሮጥ በሚተግበርበት ጊዜ የsitemap "
"እንደገና ይፍጠሩ"

msgid "Sitemap generation max duration"
msgstr "የስይትমֵፕ ማመንጫ ከፍተኛ ቆይታ"

msgid "Default hreflang"
msgstr "ቀዳሚ (default) hreflang"

msgid "Rebuild queue & generate"
msgstr "“ኪውውን እንደገና ገንባ እና አተረፋ”"

msgid "Parents"
msgstr "ወላጆች"

msgid "Book"
msgstr "መጽሐፍ"

msgid "format"
msgstr "ቅርጸት"

msgid "The name of the menu."
msgstr "የሜኑው ስም።"

msgid "Root"
msgstr "መሰረት"

msgid "Tokens"
msgstr "ቶከኖች"

msgid "Token"
msgstr "ቶከን"

msgid "Available tokens"
msgstr "Upለሰብ መለያዎች ይገኛሉ"

msgid "Keys"
msgstr "ቁልፎች"

msgid "Interface language"
msgstr "የተጠቃሚ በይነገጽ ቋንቋ"

msgid "Root term"
msgstr "የመጀመሪያ ቃል"

msgid "Menu links"
msgstr "የሜኑ ሊንኮች"

msgid "Array"
msgstr "ድርድር"

msgid "Link ID"
msgstr "የማገናኛ መታወቂያ (Link ID)"

msgid "Base name"
msgstr "የመሠረታዊ ስም"

msgid "No tokens available."
msgstr "ቶክኖች አይገኙም።"

msgid "Click a token to insert it into the field you've last clicked."
msgstr ""
"ባለፈው ጠቅ ያደረጉት መስክ ውስጥ "
"ለማስገባት ቶከን ላይ ጠቅ ያድርጉ።"

msgid "Translation source node"
msgstr "የትርጉም ምንጭ ኖድ"

msgid ""
"Provides a user interface for the Token API and some missing core "
"tokens."
msgstr ""
"Token API እና ከጎደሉ ዋና (core) ቶከኖች መካከል "
"ጥቂቶችን ለማቅረብ የተጠቃሚ ተግባር (user "
"interface) ያቀርባል።"

msgid "Insert this token into your form"
msgstr ""
"මෙම ቶክን (token) እዚህ በፎርምዎ ውስጥ "
"ያስገቡ።"

msgid "First click a text field to insert your tokens into."
msgstr ""
"መጀመሪያ የጽሑፍ ሜዳ (text field) ላይ ጠቅ "
"በማድረግ ቶከኖችዎን ለማስገባት።"

msgid "The explanation of the most recent changes made to the node."
msgstr ""
"በኖዱ ላይ የተደረጉትን በጣም ወቅታዊ "
"ለውጦች ማብራሪያ።"

msgid "The title of the current page."
msgstr "የአሁኑ ገጽ ርዕስ።"

msgid "The URL of the current page."
msgstr "የአሁኑ ገጹ ዩአርኤል።"

msgid "The page number of the current page when viewing paged lists."
msgstr ""
"የገጽ ቁጥር (pagination) ያላቸው ዝርዝሮችን "
"ሲመለከቱ የአሁኑ ገጽ ቁጥር።"

msgid "The source node for this current node's translation set."
