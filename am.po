"Drupal @version ጋር የሚስማማ አይደለም፤"

msgid "Incompatible module"
msgid_plural "Incompatible modules"
msgstr[0] "අසәйරෑ ሞጁል"
msgstr[1] "አስተካክል ሞጁሎች አይተናገዱም"

msgid ""
"The following theme is installed, but it is incompatible with Drupal "
"@version:"
msgid_plural ""
"The following themes are installed, but they are incompatible with "
"Drupal @version:"
msgstr[0] ""
"የሚከተለው ገጽታ (theme) ተጭኗል፣ ነገር ግን "
"ከDrupal @version ጋር የማይስማማ ነው፦ "
"የሚከተለው ገጽታ (theme) ተጭኗል፣ ነገር ግን "
"ከDrupal @version ጋር የማይስማማ ነው፦"

