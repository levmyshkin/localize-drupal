msgctxt "At no time"
msgid "never"
msgstr "አትቼጥቅ (ወይም፦ በፍፁም አይደለም)"

msgctxt "At all times"
msgid "always"
msgstr "ከዚህ በላይ ሁልጊዜ"

msgid "Administer XML Sitemap settings."
msgstr ""
"የXML የጣቢያ ካርታ (Sitemap) ቅንብሮችን "
"ያስተዳድሩ።"

msgid "Add new XML Sitemap"
msgstr "አዲስ XML ስይትማፕ ጨምር"

msgid "Edit XML Sitemap"
msgstr "XML የጣቢያ ካርታን አርትዕ ያድርጉ"

msgid "Delete XML Sitemap"
msgstr "XML Sitemap ሰርዝ"

msgid "Dutch"
msgstr "ኔዘርላንድስ (ደች)"

msgid "Disable the following"
msgstr "নከታ ዝህ ይቀናቸው:"

msgid "Config exists"
msgstr "ቅንብር አለው"

msgid "Portuguese, Brazil"
msgstr "පோரቹගीसኛ (බ්‍රაზිල්)"

msgid "Back to overview."
msgstr "ወደ መግለጫ ቦታ ተመለስ።"

msgid "There are no configuration changes to make."
msgstr ""
"ማዋቀር (configuration) ለመጀመር ምንም ለውጦች "
"ማድረግ አያስፈልግም።"

