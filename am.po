msgstr "@title የምናሌ አገናኝን አንቃ"

msgid ""
"A unique name to construct the URL for the menu. It must only contain "
"lowercase letters, numbers and hyphens."
msgstr ""
"ለመናኸሪያው ዩአርኤሉ ለመገንባት "
"የሚያገለግል ልዩ ስም። ትንንሽ ፊደሎችን፣ "
"አሃዞችን እና ሃይፍኖችን ብቻ መያዝ "
"አለበት።"

msgid "Schema version"
msgstr "የስኬማ ስሪት"

msgid "Number of servings"
msgstr "የአገልግሎት ቁጥር"

msgid "Theme name"
msgstr "Дизაინის ስም"

msgid "URL fallback"
msgstr "ዩአርኤል መተኪያ (ፎልባክ)"

