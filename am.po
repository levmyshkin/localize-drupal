msgid ""
"The amount of time before the next allowed submission per user for the "
"webform source entity."
msgstr ""
"የድረ-ገጽ ቅጽ (webform) ምንጭ አካል ለአንድ "
"ተጠቃሚ ቀጣዩ እንደገና ሊፈቀድ የሚችል "
"ማስገባት ድረስ ያለው ጊዜ።"

msgid "No choices to choose from"
msgstr "ከመምረጥ የሚቻል ምርጫ የለም።"

msgid "Press to select"
msgstr "እንዲመርጡ ይጫኑ"

msgid "Press Enter to add <b>@value</b>"
msgstr "<b>@value</b> ለማከል Enter ይጫኑ"

msgid "Only @max value can be added"
msgstr "@max እሴት ብቻ ሊታከል ይችላል"

msgid "All custom email addresses"
msgstr "ሁሉም ብጁ ኢሜይል አድራሻዎች"

msgid "@label (Users and custom email addresses)"
msgstr ""
"@label (ተጠቃሚዎች እና ተለያይ የኢሜይል "
"አድራሻዎች)"

msgid ""
"The email addresses of <strong>users</strong> and <strong>custom email "
"addresses</strong> assigned to the %title access type for the current "
"webform."
msgstr ""
"የ <strong>ተጠቃሚዎች</strong> እና ለአሁኑ "
"ዌብፎርም የተመደበው %title የመዳረሻ ዓይነት "
"ላይ የተመደቡ <strong>ብጁ ኢሜይል "
"አድራሻዎች</strong> ኢሜይል አድራሻዎች።"

msgid "@label (Users)"
msgstr "@label (ተጠቃሚዎች)"

msgid ""
"The email addresses of <strong>users</strong> assigned to the %title "
"access type for the current webform."
msgstr ""
"በዚህ የአሁኑ የዌብፎርም የመዳረሻ አይነት "
"%title ለተመደቡት <strong>ተጠቃሚዎች</strong> "
"የኢሜይል አድራሻዎች።"

msgid "@label (Custom email addresses)"
msgstr ""
"@label (በማበጀት የተዘጋጁ ኢሜይል "
"አድራሻዎች)"

msgid ""
"The email addresses of <strong>users</strong>, <strong>custom email "
"addresses</strong>, and <strong>administrators</strong> assigned to "
"the %title access type for the current webform."
msgstr ""
"የኢሜይል አድራሻዎች "
"የ<strong>ተጠቃሚዎች</strong>፣ <strong>የተበጁ "
"የኢሜይል አድራሻዎች</strong> እና "
"<strong>አስተዳዳሪዎች</strong> ለመነሻ የ%title "
"መዳረሻ አይነት ተመድበው ለአሁኑ የድር "
"ቅጽ (webform)።"

msgid "Access controls"
msgstr "መዳረሻ ቁጥጥሮች"

msgid "Custom notifications"
msgstr "ብጁ ማሳወቂያዎች"

msgid "more emails"
msgstr "ተጨማሪ ኢሜይሎች"

msgid "Entity print"
msgstr "አካል ማተሚያ"

msgid "Allows webform submissions to be converted to a PDF"
msgstr ""
"የድር ፎርም ማስገቢያዎችን ወደ PDF "
"እንዲቀየሩ ያስችላል"

msgid "Enter custom header to be displayed above printed webform submissions."
msgstr ""
"ህትመት የሚደረጉ የድር ቅጾች ማስገቢያዎች "
"ከላይ ለማሳየት ብጁ ራስጌ ያስገቡ።"

msgid ""
"Enter custom header to be displayed above all printed webform "
"submissions."
msgstr ""
"ሁሉንም የታተመ የድረ-ቅጽ ማስገቢያዎች "
"ከላይ ለመታየት የራስዎን ራስጌ ያስገቡ።"

msgid "Enter custom footer to be displayed below printed webform submissions."
msgstr ""
"මුుదህራፊ የታተመ የድር ፎርም "
"ማስገቢያዎች ከታች ለሚታይ ተጨማሪ መዘጋጃ "
"(footer) ያስገቡ።"

msgid ""
"Enter custom footer to be displayed below all printed webform "
"submissions."
msgstr ""
"ሁሉንም የታተሙ ዌብፎርም ማስረከቦች በታች "
"ለመታየት የተበጀ ግራ-መደረሻ (footer) "
"አስገቡ።"

msgid "Enter custom print CSS to be attached to printed webform submissions."
msgstr ""
"ለታተመ የድር ፎርም ምዝገባዎች ላይ "
"ማያያዝ የሚቻል ብጁ የህትመት CSS አስገቡ።"

msgid ""
"Enter custom print CSS to be attached to all printed webform "
"submissions."
msgstr ""
"ሁሉም በድረ-ገፅ ቅጾች (webform) ላይ ለሚደረጉ "
"ታተሞች ስር ለመያያዝ የተለየ ማተሚያ የCSS "
"ኮድ ያስገቡ።"

msgid "@label link"
msgstr "@label  සබዳ"

msgid "Enable @label link"
msgstr "@label ሊንኩን ንቁ ያድርጉ"

msgid "@label link text"
msgstr "@label ሊንክ ጽሑፍ"

msgid "@label link attributes"
msgstr "@label የማገናኛ ባህሪዎች"

msgid "Download @label"
msgstr "@label ን ያውርዱ"

msgid "Debug generated documents"
msgstr "የተፈጠሩ ሰነዶችን ዲባግ አድርግ"

msgid ""
"If checked, administrators will see debug links below each export "
"type."
msgstr ""
"ከተመረጠ (ቼክ ከተደረገ) የአስተዳዳሪዎች "
"በእያንዳንዱ የውጭ አይነት በታች የሚታዩ "
"የዲባግ ሊንኮችን ያያሉ።"

msgid "Entity print settings"
msgstr "የአካል ማተሚያ ቅንብሮች"

msgid "Print template"
msgstr "የህትመት ቅጽ (template)"

msgid "Print header"
msgstr "ራስጌን አትም (Print header)"

msgid "Print footer"
msgstr "የግርጌ (footer) አታሚን አትምት"

msgid "Print CSS"
msgstr "CSS አታሚ ቅጥ"

msgid "Enable export link"
msgstr ""
"صادرات (export) አገናኝን  ಸක්‍රීዬ "
"ያድርጉ"

msgid "Export link text"
msgstr "የማገናኛ አገናኝ ጽሑፍ ላክ (Export link text)"

msgid "@label documents"
msgstr "@label ሰነዶች"

msgid "Exports results as @label documents"
msgstr "ውጤቶቹን እንደ @label ሰነዶች ያቀርባል"

msgid "Unable to generate '@filename'."
msgstr "«@filename» መፍጠር አልቻለም።"

msgid "Attachment @label"
msgstr "አባሪ @label"

msgid "File name must include *.@extension file extension."
msgstr ""
"የፋይል ስም ውስጥ `*.@extension` የሚለውን ፋይል "
"ቅጥያ (file extension) መካተት አለበት።"

msgid ""
"Choices.js is used to improve the user experience for select menus. "
"Choices.js is an alternative to Select2."
msgstr ""
"Choices.js የመምረጫ ሜኑዎችን ተጠቃሚ ልምድ "
"ለማሻሻል ያገለግላል። Choices.js እንደ Select2 "
"ያለ አማራጭ (alternative) ነው።"

msgid ""
"<a href=\":select2_href\">Select2</a>, <a "
"href=\":choices_href\">Choices</a>, and <a "
"href=\":chosen_href\">Chosen</a> provide very similar functionality, "
"most websites should only have one of these libraries enabled."
msgstr ""
"<a href=\":select2_href\">Select2</a>, <a "
"href=\":choices_href\">Choices</a> እና <a "
"href=\":chosen_href\">Chosen</a> በጣም ተመሳሳይ "
"ተግባር ያቀርባሉ፤ አብዛኛዎቹ ድረ-ገጾች "
"ከእነዚህ መጽሐፍት ውስጥ አንዱን ብቻ "
"እንዲበራ (enabled) መሆን አለበት።"

msgid ""
"The open, closed, or scheduled status applies to only this webform "
"instance."
msgstr ""
"የክፍት፣ የተዘጋ ወይም የታቀደ (scheduled) "
"ሁኔታው ለዚህ የዌብፎርም ኢንስታንስ ብቻ "
"ይሠራል።"

msgid ""
"If checked, the HTML5 date element will be replaced with a <a "
"href=\"https://jqueryui.com/datepicker/\">jQuery UI datepicker</a>"
msgstr ""
"ይህ ከተመረጠ (checked) የHTML5 ቀን አካል በ <a "
"href=\"https://jqueryui.com/datepicker/\">jQuery UI datepicker</a> "
"ይተካል።"

msgid "Date days of the week"
msgstr "የሳምንቱ ቀናት (ቅዳሜ፣ እሑድ፣ ወዘተ)"

msgid "%name must be a %days."
msgstr "%name ከ %days ጋር መሆን አለበት።"

msgid ""
"Replace select element with jQuery <a href=\":href\">Select2</a> "
"select box."
msgstr ""
"<select> ን የ jQuery <a href=\":href\">Select2</a> ምርጫ "
"ሳጥን በመተካት ይቀይሩ።"

msgid ""
"Replace select element with <a href=\":href\">Choice.js</a> select "
"box."
msgstr ""
"`select` ኤለመንትን ከ`<a href=\":href\">Choice.js</a>` "
"ምርጫ ሳጥን ጋር ይተኩ።"

msgid ""
"Replace select element with jQuery <a href=\":href\">Chosen</a> select "
"box."
msgstr ""
"select ኤለመንትን በ jQuery <a href=\":href\">Chosen</a> "
"ምርጫ ሳጥን ተክተው።"

msgid ""
"@libraries provide very similar functionality, only one should be "
"enabled."
msgstr ""
"`@libraries` ተመሳሳይ ዓይነት አቅም ይሰጣሉ፣ "
"ስለዚህ አንዱ ብቻ ሊነቃ (enabled) መሆን "
"አለበት።"

msgid ""
"Custom options can only be updated via the <a href=\":href\">YAML "
"source</a>."
msgstr ""
"ተጨማሪ አማራጮች በ<a href=\":href\">YAML ምንጭ</a> "
"ብቻ ተዘምነው ሊቀየሩ ይችላሉ።"

msgid "Custom options can only be updated via the YAML source."
msgstr ""
"ብጁ አማራጮች በYAML ምንጭ ብቻ ነው ማዘመን "
"የሚቻለው።"

msgid "every @increment seconds"
msgstr "@increment ሰከንዶች በእየ ሰከንዱ"

msgid ""
"Provides the <a href=\":href\">CAPTCHA</a> for adding challenges to "
"forms."
msgstr ""
"ቅንብሮች (forms) ላይ ፈተናዎች (challenges) "
"ለመጨመር የ <a href=\":href\">CAPTCHA</a> መጨመሪያን "
"ይሰጣል።"

msgid ""
"Replace <em>Add CAPTCHA administration links to forms</em> with "
"CAPTCHA webform element"
msgstr ""
"<em>ቅጾች ውስጥ CAPTCHA አስተዳደር አገናኞችን "
"ለመጨመር</em> የሚለውን ከ CAPTCHA ዌብፎርም "
"አካል ጋር ተተኩ》"

msgid ""
"If checked and <a href=\":href\">Add CAPTCHA administration links to "
"forms</a> is enabled, the CAPTCHA fieldset added to every form will "
"create a new CAPTCHA webform element instead of tracking each "
"webform's id."
msgstr ""
"ከተመረጠ እና <a href=\":href\">የCAPTCHA አስተዳደር "
"አገናኞችን ወደ ቅጾች ማከል</a> እንዲነቃ "
"ከተደረገ፣ ለእያንዳንዱ ቅጽ የሚጨመረው "
"CAPTCHA fieldset የእያንዳንዱን webform የid "
"ሲያስታውል ከመሄድ ይልቅ አዲስ የCAPTCHA webform "
"ኤለመንት ይፈጥራል።"

msgid "It changes the \"@from\" link label and behavior to \"@to\""
msgstr ""
"ከ“@from” የሚለውን ሊንክ መለያና ባህሪ ወደ "
"“@to” ይቀይራል።"

msgid "Sorry… This form is closed to new submissions."
msgstr ""
"ይቅርታ… ይህ ፎርም ለአዲስ አቅርቦቶች "
"ዝግ ነው።"

msgid ""
"You have a pending draft for this webform. <a href=\"#\">Load your "
"pending draft</a>."
msgstr ""
"ለዚህ ዌብፎርም የሚቀርብ ረቂቅ አለዎት። <a "
"href=\"#\">የሚቀርብ ረቂቅዎን ጫን</a>።"

msgid ""
"You have pending drafts for this webform. <a href=\"#\">View your "
"pending drafts</a>."
msgstr ""
"በዚህ ዌብፎርም ላይ የሚጠብቁ ረቂቆች "
"አሉዎት። <a href=\"#\">የሚጠብቁ ረቂቆችዎን "
"ይመልከቱ</a>።"

msgid "Webforms: Help"
msgstr "ዌብፎርምስ፦ እርዳታ"

msgid "Ajax progress type"
msgstr "Ajax ሂደት ዓይነት"

msgid "Ajax speed"
msgstr "Ajax ፍጥነት"

msgid "Default Ajax progress type"
msgstr "የነባር የኤጄክስ (Ajax) መሻሻል አይነት"

msgid "Default Ajax effect"
msgstr "የነባሪ አያክስ ውጤት"

msgid "Default Ajax speed"
msgstr "ነባሪ Ajax ፍጥነት"

msgid ""
"This screencast shows how to download, export, and email PDF copies of "
"webform submissions."
msgstr ""
"ይህ ስክሪንካስት የድረ-ገጽ ፎርም (webform) "
"ማስገቢያዎችን የPDF ቅጂዎችን እንከታተል "
"በመውረድ (download)፣ በመላክ (export) እና "
"በኢሜይል በመላክ እንዴት እንደሚቻል "
"ያሳያል።"

msgid "@number milliseconds"
msgstr "@number ሚሊሰከንዶች"

msgid ""
"Select the default progress indicator displayed when Ajax is "
"triggered."
msgstr ""
"Ajax ሲነቃ (trigger) ሲፈጠር የሚታየውን ነባሪ "
"የእድገት ማመልከቻ ይምረጡ።"

msgid "Select the default effect displayed when Ajax is triggered."
msgstr ""
"Ajax ተነሳሽ (trigger) ሲሆን የሚታይ ነባሪ "
"ውጤትን ይምረጡ።"

msgid "Select the default effect speed."
msgstr "የነባሩን የውጤት ፍጥነት ይምረጡ።"

msgid "Webform element property tokens."
msgstr "የ Webform ኤለመንት ንብረት ቶከኖች።"

msgid "Learn about element property tokens"
msgstr "ኤለመንት የንብረት ቶከኖችን ማወቅ"

msgid ""
"For example, to display an email element's title (aka #title) you "
"would use the [webform:element:email:title] token."
msgstr ""
"ለምሳሌ፣ የኢሜይል ኤለመንት ርዕስን (aka "
"#title) ለማሳየት የ [webform:element:email:title] ቶከን "
"መጠቀም ይችላሉ።"

msgid "Repairing admin configuration…"
msgstr "አስተዳዳሪ (admin) ውቅርን በመጠገን…"

msgid "Removing (unneeded) webform submission translation settings…"
msgstr ""
"(የማይፈለጉ) የዌብፎርም ማስረከብ "
"የትርጉም ቅንብሮችን በማስወገድ ላይ…"

msgid "▶ Watch more videos"
msgstr "▶ ተጨማሪ ቪዲዮዎችን ይመልከቱ"

msgid "Wait time before next submission"
msgstr ""
"የሚቀጥለው ማስገቢያ ከመድረሱ በፊት "
"የሚወሰድ ጊዜ"

msgid "Remaining number of submissions"
msgstr "ቀሪ የማመልከቻ ቁጥር"

msgid "The remaining number of submissions for the webform."
msgstr "ለዌብፎርሙ የቀረው የማስገባት ቁጥር።"

msgid "Per user wait time before next submission"
msgstr ""
"በተጠቃሚው ቀጣይ አስገባት በፊት የሚጠበቅ "
"ጊዜ"

msgid "Per user remaining number of submissions"
msgstr "የተጠቃሚው ቀሪ የማስገቢያዎች ብዛት"

msgid "The remaining number of submissions for the user for the webform."
msgstr ""
"የድር ፎርሙ (webform) ለተጠቃሚው የቀሩ "
"የማስገቢያ ብዛት።"

msgid "Wait time before next submission for a source entity"
msgstr ""
"ለምንጭ አካል ቀጣይ ማቅረብ ከመፈጸም "
"በፊት የሚጠበቅ ጊዜ"

msgid "Remaining number of submissions for source entity"
msgstr "ከምንጭ አካል የቀሩ የማስገቢያዎች ብዛት"

msgid "Remaining number of submissions for the webform source entity."
msgstr ""
"ለዌብፎርም ምንጭ አካል የቀረው የተሞሉ "
"ማመልከቻዎች ብዛት።"

msgid "Per user submission limit for a source entity"
msgstr ""
"ለምንጭ አካል (source entity) በአንድ ተጠቃሚ "
"የሚፈቀድ የአቅርቦት ገደብ"

msgid "Per user submission limit interval for a source entity"
msgstr ""
"ለምንጭ አካል የተወሰነ እሴት የአንድ "
"ተጠቃሚ ማቅረቢያ ገደብ ጊዜ ክፍተት"

msgid "Per user wait time before next submission for a source entity"
msgstr ""
"ከምንጭ አካል በኋላ ለቀጣዩ ማስገቢያ "
"የተጠቃሚው የመጠበቂያ ጊዜ"

msgid "Per user total submissions for a source entity"
msgstr ""
"ለመለያ አካል (source entity) ለእያንዳንዱ "
"ተጠቃሚ የአጠቃላይ የግቤቶች ብዛት"

msgid "Per user remaining number of submissions for a source entity"
msgstr ""
"ለምንጭ አካል የተረፈ የተጠቃሚ የማስገባት "
"ቁጥር"

msgid ""
"The remaining number of submissions for the user for the webform "
"source entity."
msgstr ""
"ለድር ፎርም ምንጭ አካል (webform source entity) "
"ለተጠቃሚው የቀረው የማስገባት (submission) "
"ቁጥር።"

msgid "%d character(s) entered"
msgstr "%ዲ የቁምፊ(ዎች) ገብተዋል"

msgid "%d character(s) remaining"
msgstr "%d የቀሩ ባህሪ(ዎ)"

msgid "Learn how to use regular expressions with conditional logic."
msgstr ""
"شرطی ሏሳብ ጋር ተያይዞ የሬጉላር ኤክspression "
"(ሬጉላር ቅጦችን) እንዴት እንደሚጠቀሙ "
"ይማሩ።"

msgid "Specifies the number of visible options."
msgstr "ማየት የሚቻሉ አማራጮች ብዛት ያስቀምጣል።"

msgid ""
"If checked, only file upload elements selected in the above included "
"email values will be attached to the email."
msgstr ""
"اگر تیک خورده باشد، تنها  فایل‌هایی که "
"در بالا зазнач شدهٔ ایمیل ارزش‌ها "
"مشخص شده‌اند و مربوط به «بارگذاری "
"فایل» هستند، به ایمیل ضمیمه می‌شوند."

msgid "Error response redirect URL"
msgstr "የስህተት መልስ መቀየሪያ URL"

msgid "File upload in progress. Uploaded file may be lost."
msgstr ""
"የፋይል ማስጫን በሂደት ላይ ነው። ከጨረሰ "
"በኋላ የተሞላው ፋይል ሊጠፋ ይችላል።"

msgid ""
"Disabled attachments will not be included as file attachments in sent "
"emails."
msgstr ""
"የተዘጉ ከማያያዝ (attachments) ፋይሎች በመላክ "
"የሚላኩ ኢሜይሎች ውስጥ እንደ ፋይል "
"ከማያያዝ አይካተቱም።"

msgid "Repairing webform entity print settings…"
msgstr ""
"የድር ፎርም (webform) እስቲቲ ህትመት "
"ቅንብሮችን በማስተካከል ላይ…"

msgid "We are unable to complete the current request."
msgstr "አሁን ያለውን ጥያቄ መፈጸም አልቻልንም።"

msgid "Do you want to reload the current page?"
msgstr ""
"አሁኑን ገጽ እንደገና መጫን (ዳግም ማስጫን) "
"ይፈልጋሉ?"

msgid "Provides a more slideout element."
msgstr "ከበለጠ ተንሸራታች (slideout) አካል ይሰጣል።"

msgid "Custom error response redirect URL"
msgstr "የተለመደ ስህተት ምላሽ ወደ ማዞሪያ URL"

msgid "The URL or path to redirect to when a remote fails."
msgstr ""
"ርቅበት ሲሳካ ሲቀርብ ወደሚደርስ የURL "
"ወይም የመንገድ መዞሪያ (redirect)።"

msgid "Error URL:"
msgstr "የ URL ስህተት፦"

msgid "To output individual elements, replace the '?' with…"
msgstr ""
"ለአንዳንድ ክፍሎችን ለማሳየት “?”ን ከ… "
"ጋር ተተካ።"

msgid "Source element"
msgstr "የምንጭ አካል"

msgid "Destination element"
msgstr "የመዳረሻ አካል"

msgid "Destination state"
msgstr "የመጨረሻ ሁኔታ"

msgid "Same as…"
msgstr "ከ… ጋር ተመሳሳይ ነው፤ …"

msgid "Draft created"
msgstr "የረቂቅ ፈጠራ ተደርጓል"

msgid "Draft updated"
msgstr "እትም የተዘመነ ነው"

msgid "lowercase letters, numbers, and underscores"
msgstr ""
"ਢታ (ዝቅተኛ ፊደሎች)፣ ቁጥሮች፣ እና "
"መስመር መከፋፈያዎች (_)"

msgid ""
"Please note: Automatically generated element keys are lowercased "
"letters, numbers, and underscores"
msgstr ""
"እባክዎ ያስተውሉ፦ በራስ-ሰር የሚመነጩ "
"የኤለመንት ቁልፎች ትንንሽ ፊደላት፣ "
"ቁጥሮች እና አンダስ코ር (underscores) ይሆናሉ።"

msgid "Lowercase letters, numbers, and underscores. (i.e. element_key)"
msgstr ""
"ትንኹስ ፊደሎች፣ ቁጥሮች እና አንድርስኮር "
"(underscore)። (ማለትም element_key)"

msgid "Letters, numbers, and underscores. (i.e. element_KEY)"
msgstr ""
"፡፡ ፊደሎች፣ ቁጥሮች እና መውሰጃ "
"መስመሮች (underscores)። (ማለትም element_KEY)"

msgid "Letters, numbers, underscores, and dashes. (i.e. element-KEY)"
msgstr ""
"፡ ፊደላት፣ ቁጥሮች፣ መስመር መግለጫዎች "
"(underscores) እና ሰረዞች (dashes)። (ማለትም "
"element-KEY)"

msgid "Use Taxonomy Terms as Webform Options in Drupal 8"
msgstr ""
"دрупাল ၈ ውስጥ የታክሶኖሚ ቃላትን እንደ "
"ዌብፎርም አማራጮች ተጠቀም"

msgid ""
"Learn how to create a select element which uses a taxonomy vocabulary "
"instead of the standard options."
msgstr ""
"የመደበኛ አማራጮች ፋንታ የታክሶኖሚ "
"መዝገብ (vocabulary) የሚጠቀም የመምረጫ (select) "
"እቃ እንዴት እንደምትፈጥር ይማሩ።"

msgid "Use Taxonomy Terms as Webform Options in Drupal 8 | WebWash"
msgstr ""
"የTaxonomy መፍታሔ ቃላትን በDrupal 8 ውስጥ እንደ "
"Webform አማራጮች ተጠቀም | WebWash"

msgid "Use Ajax for all webforms"
msgstr "ሁሉንም የድር ቅጾች (webforms) በ Ajax ይጠቀሙ"

msgid "Truncate webform submission tables."
msgstr ""
"የዌብፎርም ማስገቢያ ሠንጠረዦችን "
"አሳጥር።"

msgid "Information message"
msgstr "የመረጃ መልዕክት"

msgid "Webform Entity Print (PDF) Attachment"
msgstr "የድር ቅጽ አካል ማተሚያ (PDF) አባሪ"

msgid "Options limit"
msgstr "የአማራጮች ገደብ"

msgid ""
"The <strong>Options</strong> page displays a summary of the webform's "
"options limits."
msgstr ""
"የ<strong>አማራጮች</strong> ገጹ የድር ፎርሙ "
"(webform) አማራጮች ገደቦቹን ማጠቃለያ "
"ያሳያል።"

msgid ""
"Allows elements with options (i.e. select, checkboxes, and radios) to "
"have option specific submission limits."
msgstr ""
"አማራጮች ያላቸው (ማለትም ምርጫዎች/select፣ "
"ቼክቦክሶች/checkboxes እና ራዲዮዎች/radios) "
"ነገሮች ለእያንዳንዱ አማራጭ ተወሰነ "
"የማስገባት ገደቦች እንዲኖራቸው "
"ይፈቅዳል።"

msgid "Limit reached message"
msgstr "የደረሰ ገደብ መልዕክት"

msgid "Limit reached behavior"
msgstr "የተደረሰ ገደብ ባህሪ"

msgid "@title (@type)"
msgstr "@title（@type）"

msgid "'@element_key' is missing."
msgstr "‘@element_key’ አልተገኘም።"

msgid "@title @type limits"
msgstr "@title @type ገደቦች"

msgid "Do not display a message"
msgstr "መልዕክት አታሳይ"

msgid "Placeholder help"
msgstr "Placeholder ረዳት"

msgid "The following placeholders can be used:"
msgstr "የሚከተሉት ቦታ-ሙላዎች ሊጠቀሙ ይችላሉ፦"

msgid "@name - The element's title."
msgstr "@name - እቃው (element) ርዕስ (title)።"

msgid "Tee shirts in @label are no longer available."
msgstr "@label ላይ ያሉ ቲሸርቶች አሁን አይገኙም።"

msgid ""
"The file's name exceeds the Webform module's 150 characters limit. "
"Please rename the file and try again."
msgstr ""
"የፋይሉ ስም የ Webform ሞጁሉ የ 150 ቁምፊ "
"ገደብን አልፏል።  ದፋይሉን እባክዎ "
"ይሰይሙ እና እንደገና ይሞክሩ።"

msgid "Webform: Experimental modules enabled"
msgstr ""
"የWebform ፕሮግራም፡ ሙከራዊ ሞጁሎች "
"ነቅተዋል"

msgid ""
"Experimental webform modules found: %module_list. <a "
"href=\":url\">Experimental modules</a> are provided for testing "
"purposes only. Use at your own risk."
msgstr ""
"የተገኙ ሙከራዊ የድር-ፎርም ሞጁሎች፦ "
"%module_list. <a href=\":url\">ሙከራዊ ሞጁሎች</a> "
"ለሙከራ ዓላማ ብቻ ይቀርባሉ። በራስዎ "
"ሃላፊነት ይጠቀሙ።"

msgid "Option value attribute names"
msgstr ""
"የជម្រើស (option) արժեք (value) ၏ attribute "
"ስሞች"

msgid "Allow SVG to be filled using CSS"
msgstr "SVG ን በ CSS በመጠቀም እንዲቀለም ይፍቀዱ።"

msgid "Enable SVG panning and zooming"
msgstr ""
"SVG ማስተናገድ (panning) እና ማሳፈር/መጨመር "
"(zooming) ንቁ ያድርጉ"

msgid "Display text and description in a tooltip"
msgstr ""
"በአብራሪ (tooltip) ውስጥ ጽሑፍ እና መግለጫ "
"አሳይ"

msgid "Affect any elements which use these custom options"
msgstr ""
"እነዚህን ተጠቃሚ (custom) አማራጮች የሚጠቀሙ "
"ማንኛውንም ክፍሎች (elements) ላይ ተፅዕኖ "
"ያድርጉ"

msgid "Duplicate '@label' custom options"
msgstr "የ‘@label’ ተደጋጋሚ ባለቤት ምርጫዎች"

msgid ""
"A brief description present to the user when adding this element to a "
"webform."
msgstr ""
"ይህን ክፍል ወደ ዌብፎርም ሲያክሉ "
"ተጠቃሚው ለማየት የተዘጋጀ አጭር መግለጫ።"

msgid ""
"Instructions to present to the user below this element on the editing "
"form."
msgstr ""
"ይህ ኤለመንት ከሚከተለው በማስተካከያ ቅጽ "
"ላይ ለተጠቃሚው የሚታዩ መመሪያዎች።"

msgid "HTML/SVG file URL or path"
msgstr "የHTML/SVG ፋይል ዩአርኤል ወይም መንገድ"

msgid "Allow SVG option elements to be filled using CSS"
msgstr ""
"SVG option ንጥል መረጃዎችን በCSS እንዲሞሉ "
"ፍቀድ"

msgid "If checked, inline fill styles will be removed and replaced using CSS."
msgstr ""
"ከተመረጠ፣ ውስጥ ለውስጥ (inline) የመሙያ "
"ዘይቤዎች ይወገዳሉ እና በ CSS በመተካት "
"ይቀመጣሉ።"

msgid "CSS/JS"
msgstr "CSS/JS"

msgid ""
"Below options are used to enhance and also translate the custom "
"options parsed from the HTML/SVG markup."
msgstr ""
"ከታች ያሉት አማራጮች ከHTML/SVG ማርኩፕ ውስጥ "
"የተተነተኑ የተበጁ አማራጮችን ለማሻሻል "
"እና ለመተርጎም ይጠቅማሉ።"

msgid "Option descriptions are displayed by tooltips."
msgstr ""
"የአማራጭ መግለጫዎች በቶልቲፕስ ተይዞ "
"ይታያሉ።"

msgid "Display option text and description in a tooltip"
msgstr ""
"የአማራጭ ጽሑፍ እና መግለጫ በመጠቆሚያ "
"(tooltip) ውስጥ አሳይ"

msgid ""
"If checked, option text and description will be displayed using a "
"tooltip."
msgstr ""
"ይህ ተሳስቷ ከሆነ፣ የአማራጭ ጽሑፉና "
"መግለጫው በመረጃ መሳሪያ (tooltip) በኩል "
"ይታያሉ።"

msgid ""
"If checked, this custom options element will be available when a user "
"is adding elements to a webform."
msgstr ""
"ካመረጡ (checked) ይህ ተበጅቶ (custom) የተሰራ "
"አማራጮች ክፍል (options element) ተጠቃሚው "
"ወብፎርም (webform) ላይ እቃዎችን ሲጨምር "
"ይገኝ (available) ይሆናል።"

msgid ""
"If checked, this custom options element will be available for entity "
"references when a user is adding elements to a webform."
msgstr ""
"ከተፈቀደ (checked) ከሆነ፣ ይህ ተለመደ (custom) "
"አማራጮች ክፍል ተጠቃሚ ወደ ዌብፎርም "
"አካላት ሲያክል ሲባል ለአካል (entity) "
"ማጣቀሻዎች ይደረስ ይሆናል።"

msgid "Filter by title, description, help, template, or url"
msgstr ""
"በርዕስ፣ መግለጫ፣ እርዳታ፣ ቅንብር "
"አብነት (template) ወይም ዩአርኤል (url) መሠረት "
"ያጣሩ"

msgid ""
"Below options are used to enhance and also translate the custom "
"options."
msgstr ""
"ከታች ያሉት አማራጮች የተበጁ አማራጮችን "
"ለማሻሻል እና በተጨማሪም ለመተርጎም "
"ይጠቅማሉ።"

msgid "The screencast walks through creating custom webform options elements."
msgstr ""
"እዚህ ስክሪንካስት የተለመዱ የዌብፎርም "
"አማራጭ ኤለመንቶችን እንዴት እንደሚፈጠሩ "
"በደረጃ ይመራል።"

msgid "View (token) URL"
msgstr "እይታ (ቶከን) URL"

msgid ""
"The URL that can used to view the webform submission. The webform must "
"be configured to allow users to view a submission using a secure "
"token."
msgstr ""
"የድረ-ገጽ ፎርም (webform) ማስገቢያውን "
"ለማየት የሚቻል ዩአርኤል። የተጠቃሚዎች "
"ማስገቢያን በደህንነት ቶከን (secure token) "
"በመጠቀም እንዲያዩ የ webform ማሰናጃ "
"(configuration) ሊፈቅድ ይገባል።"

msgid "Update (token) URL"
msgstr "የማሻሻያ (ቶከን) ዩአርኤል"

msgid ""
"Omit the '?' to output all values. Output all values as HTML using "
"[webform_submission:values:html]."
msgstr ""
"ሁሉንም እሴቶች ለማውጣት “?” አትጨምር። "
"ሁሉንም እሴቶች በ HTML መልክ እንዲወጡ "
"እነዚህን ተጠቃሚ ማድረግ፡ "
"[webform_submission:values:html]።"

msgid "Allow viewing a submission using token"
msgstr ""
"ቶከንን ተጠቅመው ግብአትን (submission) ማየት "
"እንዲችሉ"

msgid "Allow updating a submission using token"
msgstr ""
"ቶከንን ተጠቅመው ማስገባቱን (submission) "
"ለመዘመን ይፍቀዱ"

msgid "Limit per source entity"
msgstr "በእያንዳንዱ ምንጭ አካል መገደብ"

msgid "The Title of the source entity or webform."
msgstr ""
"دከ መሠረታዊ አካል (source entity) ወይም የድር "
"ፎርም (webform) ርዕስ።"

msgid "All users, custom email addresses, and administrators"
msgstr ""
"ሁሉም ተጠቃሚዎች፣ ተለዋዋጭ ኢሜይል "
"አድራሻዎች እና አስተዳዳሪዎች"

msgid "Edit webform variants"
msgstr "የዌብፎርም ቫሪያንቶችን አርትዕ አድርጉ"

msgid "Allows administrators to create variations of a webform."
msgstr ""
"አስተዳዳሪዎች የዌብፎርሙ ልዩነቶችን "
"እንዲፈጥሩ ያስችላል።"

msgid "Webforms: Variants configuration"
msgstr "ዌብፎርሞች፦ ተለያይቶች ውቅር"

msgid "Select a variant"
msgstr "አንድ ልዩነት (variant) ይምረጡ"

msgid "Add webform variant"
msgstr "ዌብፎርም ቫሪያንት ጨምር"

msgid "Edit webform variant"
msgstr "የድር ቅጽ ቫሪያንትን አርምድም"

msgid "Duplicate webform variant"
msgstr "የድር ፎርም ተለዋጭን ተባዝ (Duplicate) ማድረግ"

msgid "Delete webform variant"
msgstr "የዌብፎርም ተለዋጭ (variant) ሰርዝ"

msgid "Apply webform variant"
msgstr "የዌብፎርም ቫሪያንትን ተግብር"

msgid "View webform variants"
msgstr "የዌብፎርም ቫሪያንቶችን ይመልከቱ"

msgid "Test webform variants"
msgstr "የሙከራ የድር ቅጽ ተለዋጮች"

msgid "Webform plugins: Variants"
msgstr "የዌብፎርም ፕላጊኖች፦ ተለያያቶች"

msgid "Webform variants"
msgstr "የድርፎርም ተለዋጮች"

msgid "Variant plugin ID"
msgstr "የተለዋዋጭ ፕለጊን መታወቂያ (Plugin ID)"

msgid "Variant instance ID"
msgstr "የተለያይ ኢንስታንስ መታወቂያ (ID)"

msgid "Variant element key"
msgstr "የልዩነት አባል ቁልፍ"

msgid "Variants settings"
msgstr "የተለዋዋጭ ሁኔታዎች"

msgid "Filter category"
msgstr "دسته‌بندیを فیلتر کنید"

msgid "Filter state"
msgstr "دሜ ሁኔታን ማጣራት"

msgid "Excluded webform variants"
msgstr "ተገለሉ የዌብፎርም ተለያዮ አብያቶች"

msgid "Webform Variant Example"
msgstr "የዌብፎርም ተለዋዋጭ ምሳሌ"

msgid "Provides an example of webform variants."
msgstr ""
"የዌብፎርም ተለዋጮችን (variants) ለማሳየት "
"ምሳሌ ይሰጣል።"

msgid ""
"If checked, variant information will be displayed onscreen to all "
"users."
msgstr ""
"እንደተምረጡ ከሆነ፣ የተለያዩ (variant) "
"መረጃዎች ለሁሉም ተጠቃሚዎች በመስኮት ላይ "
"ይታያሉ።"

msgid "Example of a webform variant."
msgstr "የዌብፎርም ተለዋጭ (variant) ምثال።"

msgid "Webform [DEPRECATED]"
msgstr "ዌብፎርም [ወደፊት መጠቀም ያልተመከረ]"

msgid ""
"Enter webform information and then click submit, which will redirect "
"you to the appropriate create content form."
msgstr ""
"የዌብፎርም መረጃ ያስገቡ እና ከዚያ ላክ "
"(submit) ይጫኑ፣ ወደሚመጣው ተገδε/የይዘት "
"ፈጠራ ቅጽ ይመራዎታል።"

msgid "Delete all related variants"
msgstr "ከሁሉም ተያያዥ ተለዋዋጮች ሁሉንም ሰርዝ"

msgid "View variants"
msgstr "የተለያዩ አማራጮችን ይመልከቱ"

msgid "Test variants"
msgstr "የሙከራ ተለዋጮች"

msgid "Apply variants"
msgstr "ተለዋጮችን ተግብር"

msgid "There are currently no variants setup for this webform."
msgstr ""
"አሁን ለዚህ ዌብፎርም ምንም ተለዋዋጮች "
"(variants) አልተዘጋጁም።"

msgid ""
"This screencast provides an overview of how to use webform variants to "
"create A/B tests, audience segmentation, and personalization."
msgstr ""
"ይህ ስክሪንካስት የዌብፎርም ቫርያንቶችን "
"በመጠቀም A/B ሙከራዎችን፣ የታለመ ተመልካቾ "
"ክፍፍል (audience segmentation) እና ግላዊ "
"(personalization) ማድረግ እንዴት እንደሚቻል "
"አጠቃላይ እይታ ይሰጣል።"

msgid ""
"Webform module now supports variants, which can be used for A/B tests, "
"segmentation, and personalization"
msgstr ""
"የWebform ሞጁል አሁን ተለዋጮችን (variants) "
"ይደግፋል፤ እነዚህም ለA/B ሙከራዎች፣ "
"ለመከፋፈል (segmentation) እና ለግላዊ ውጤት "
"(personalization) ሊያገለግሉ ይችላሉ።"

msgid "Configuration: Variants"
msgstr "ቅንብር፦ ተለዋጮች"

msgid ""
"The <strong>Variants configuration</strong> page allows administrators "
"to enable/disable variants."
msgstr ""
"የ<strong>ቫሪየንቶች ኮንፊጉሬሽን</strong> ገጹ "
"አስተዳዳሪዎች ቫሪየንቶችን "
"ማንቃት/ማቦዘን እንዲችሉ ያስችላል።"

msgid ""
"<strong>Variants</strong> are used for A/B testing, segmentation, and "
"personalization."
msgstr ""
"<strong>ቫሪያንቶች</strong> ለ A/B ሙከራ፣ "
"ለክፍለ-ተመዝጋቢ (segmentation) እና ለግል ብጁ "
"ዝግጅት (personalization) ያገለግላሉ።"

msgid "Plugins: Variants"
msgstr "የተሰኪዎች፦ ተለዋጮች"

msgid ""
"The <strong>Variants</strong> page allows variations of a webform to "
"be created and managed for A/B testing, segmentation, and "
"personalization."
msgstr ""
"የ <strong>ቫርያንቶች</strong> ገጹ ለ A/B ሙከራ፣ "
"ለክፍልፋይ (segmentation) እና ለግላዊ ማበጀት "
"(personalization) የድረ-ገጽ ፎርም (webform) "
"ልዩነቶችን ለመፍጠር እና ለመቆጣጠር "
"ያስችላል።"

msgid "@total variants"
msgstr "@ውስጥ ያሉ ጠቅላላ ዝርያዎች"

msgid "variants"
msgstr "ቫሪያንቶች"

msgid "No variant available."
msgstr "ምንም ተለዋዋጭ አይገኝም።"

msgid "Enter @none to hide this message."
msgstr "ይህን መልዕክት ለመደበቅ “@none” ያስገቡ።"

msgid "Apply variants?"
msgstr "ተለዋዋጮችን ይተግብሩ?"

msgid "Delete the selected variants"
msgstr ""
"තෝරාගත් වേരიანත් මකා "
"දමන්න"

msgid "Delete all variants"
msgstr "ሁሉንም ተለዋጮች ሰርዝ"

msgid "Do not delete any variants"
msgstr "هیڅ የልዩነት (variant) አይሰርዙ"

msgid "Please select variants to be applied to the webform."
msgstr ""
"ദയവായി വെബ്ഫോം үчүн "
"կիրառിക്കേണ്ട വേരിയന്റുകൾ "
"തിരഞ്ഞെടുക്കുക."

msgid "The selected webform variants have been applied and deleted."
msgstr ""
"নির্বাচት የድር ቅፆች (webform) ተለዋጮች "
"ተተግብረው ተሰርዘዋል።"

msgid "The webform variant %title has been applied and deleted."
msgstr ""
"የ webform ተለዋጭ %title ተተግብሯል እና "
"ተሰርዟል።"

msgid ""
"The selected webform variants have been applied and all variants have "
"been deleted."
msgstr ""
"چُنታ የተመረጡት የድር ፎርም ልዩነቶች "
"(variants) ተተግብረዋል እና ሁሉም ልዩነቶች "
"ተሰርዘዋል።"

msgid ""
"The webform variant %title has been applied and all variants have been "
"deleted."
msgstr ""
"የድረ-ገጽ ቅጽ (webform) ልዩነት %title "
"ተተግብሯል እና ሁሉም ልዩነቶች "
"ተሰርዘዋል።"

msgid "The selected webform variants have been applied."
msgstr ""
"ተመርጠው የተተገበሩት የድረ-ገጽ ቅጽ "
"(webform) ልዩነቶች ተተግብረዋል።"

msgid "The webform variant %title has been applied."
msgstr ""
"የድር ፎርም ተለዋዋጭ (variant) %title "
"ተተግብሯል።"

msgid "The webform variant %name has been deleted."
msgstr "የዌብፎርም ተለዋጭ %name ተሰርዟል።"

msgid "Edit @label variant"
msgstr "@label እንዲለወጥ አርትዕ አድርጉ"

msgid "The webform variant was successfully added."
msgstr ""
"የዌብፎርም ቫሪያንቱ በተሳካ ሁኔታ "
"ታክሏል።"

msgid "The webform variant was successfully updated."
msgstr ""
"የዌብፎርም ተለዋዋጭ (variant) በትክክል "
"ተዘምኗል።"

msgid ""
"Select variants and then click submit, which will redirect you to the "
"@operation form."
msgstr ""
"ተለዋዋጮችን ምረጡ ከዚያም ማስገባት (submit) "
"ን ይጫኑ፣ ይህም ወደ @operation ፎርም "
"ያዞራችኋል።"

msgid "Filter webforms default category"
msgstr "የድረ-ገፅ ቅጾች ነባር ምድብ ማጣሪያ"

msgid ""
"Select the filter webforms default category selected on the <a "
"href=\":href\">webform overview page</a>."
msgstr ""
"د <a href=\":href\">የ webform አጠቃላይ እይታ ገጽ</a> "
"ላይ በሚመረጠው የ“webforms” ነባር ምድብ "
"የተመረጠውን ፊልተር ይምረጡ።"

msgid "Filter webforms default state"
msgstr "የዌብፎርሞች ነባር ሁኔታን ማጣሪያ"

msgid ""
"Select the filter webforms default state selected on the <a "
"href=\":href\">webform overview page</a>."
msgstr ""
"<a href=\":href\">የዌብፎርም አጠቃላይ መግለጫ "
"ገጽ</a> ላይ በሚታየው የዌብፎርም አጣሪ "
"ነባር ሁኔታ (default state) የተመረጠውን "
"ይምረጡ።"

msgid "Form URL path settings"
msgstr "የቅጽ ዩአርኤል መንገድ ቅንጅቶች"

msgid "Select available variants"
msgstr "ይገኙ የሚችሉ ምርጫዎችን ይምረጡ"

msgid "All excluded variants must be manually removed from existing webforms."
msgstr ""
"እስከ ነባር ድር ቅጾች (webforms) ድረስ "
"የተለያዩ ያልተካተቱ ሁሉንም ልዩነቶች "
"(variants) በእጅ መነሳት አለባቸው።"

msgid "Allow element to be populated using query string parameters."
msgstr ""
"ንጥል በኩዌሪ ስትሪንግ (query string) "
"መለኪያዎች በመጠቀም እንዲሞላ ይፍቀድ።"

msgid ""
"Note that the CAPTCHA module disables page caching of pages that "
"include a CAPTCHA challenge."
msgstr ""
"ከ CAPTCHA ፈተና የያዙ ገጾችን የሚያካትተው "
"CAPTCHA ሞጁል የገጽ መሸጎጫ (page caching) "
"እንደሚያቦዝን ግብዣ ያስታውሱ።"

msgid ""
"This is used after a submission has been saved and finalized to the "
"database."
msgstr ""
"இህ ይህ በማስገባት ጊዜ መዝገቡ ወደ ዲታ "
"ቤዝ ተቀምጦ እንደተጠናቀቀ ከተፈፀመ በኋላ "
"ይጠቅማል።"

msgid "Provides a form element for enabling and tracking webform variants."
msgstr ""
"የವೆብፎርም ተለያዮችን (variants) ማንቃት "
"እና መከታተል የሚያስችል ቅጽ አካል "
"ይሰጣል።"

msgid ""
"<strong>ATTENTION DEVELOPERS!!!</strong> Please make sure to download "
"and update the <a href=\":href\">Input Mask</a> library to version "
"5.0.x"
msgstr ""
"<strong>ትኩረት ይስጡ ለገንቢዎች!!!</strong> "
"እባክዎ የ <a href=\":href\">Input Mask</a> "
"ቤተ-መጻሕፍትን ወደ ስሪት 5.0.x "
"እንዲያዘምኑና እንዲያወርዱ ያረጋግጡ።"

msgid ""
"<a href=\":href\">Learn more about updating the Webform module's "
"external libraries</a>"
msgstr ""
"<a href=\":href\">د «Webform» ሞጁል ውጫዊ ቤተ "
"መጽሐፍትን ማዘመን» ላይ ተጨማሪ ይወቁ</a>"

msgid ""
"Learn more about <a "
"href=\"https://www.drupal.org/docs/8/api/form-api\">Form API in Drupal "
"8</a>."
msgstr ""
"دربላ 8 ውስጥ የ <a "
"href=\"https://www.drupal.org/docs/8/api/form-api\">Form API</a> "
"ላይ ተጨማሪ ይወቁ።"

msgid "Do not schedule email if the action should be triggered in the past"
msgstr ""
"ክድር በቀደመ ጊዜ ሊነሳ ከሚገባ ኢሜይሉን "
"አይያዙ/አትቀጠሉ።"

msgid "Given name on card"
msgstr "ካርዱ ላይ የሚታይ ስም"

msgid "Card expiry month"
msgstr "የካርድ ማብቂያ ወር"

msgid "Card expiry year"
msgstr "የካርድ ማብቂያ ዓመት"

msgid "Transaction currency"
msgstr "የግብይት ምንዛሪ"

