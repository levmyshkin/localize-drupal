msgstr "ከመጽሐፍት ቤት"

msgid "Orphaned @type: @summary"
msgstr "የተተወ ዓይነት፡ @summary"

msgid "Validation error on collapsed paragraph @path: @message"
msgstr ""
"በተዘጋ ስእል (collapsed paragraph) @path ላይ "
"የማረጋገጫ ስህተት፦ @message"

msgid ""
"Use <em>Text + Image</em> for adding a text on the left and an image  "
"on the right."
msgstr ""
"ግራ በኩል ጽሑፍ እና ቀኝ በኩል ምስል "
"ለማስገባት የ <em>Text + Image</em> ን ይጠቀሙ።"

msgid ""
"Allow users with \"View unpublished paragraphs\" permission to see "
"unpublished Paragraphs. Disable this if unpublished paragraphs should "
"be hidden for all users, including super administrators."
msgstr ""
"«በያልታተሙ ክፍሎች መመልከት (View unpublished "
"paragraphs)» ፈቃድ ያላቸው ተጠቃሚዎች "
"ያልታተሙ ፓራግራፎችን እንዲያዩ ፍቀድ። "
"ያልታተሙ ፓራግራፎች ለሁሉም ተጠቃሚዎች፣ "
"እንዲሁም ለሱፐር አስተዳዳሪዎች ጭምር "
"መደበቅ ካለባቸው ይህን አሰናክል።"

msgid "Library item summary"
msgstr "د کتاب توکي لنډیز"

msgid "Unknown migration process element type: @type."
msgstr ""
"የማይታወቅ ማይግሬሽን እርምጃ አካል "
"አይነት፦ @type።"

msgctxt "paragraphs"
msgid "Behavior plugins are only supported by the stable paragraphs widget."
msgstr ""
"ባህርይ ፕላጊኖች የሚደገፉት በተረጋጋ "
"የፓራግራፎች ዊጅት ብቻ ነው።"

msgid "Paragraphs Legacy"
msgstr "ነባር (Legacy) አንቀጾች"

msgid "The legacy paragraphs inline form widget."
msgstr ""
"የቀድሞው የፓራግራፎች መስመር ውስጥ "
"መፅሔት (widget)።"

msgid "Paragraphs (stable)"
msgstr "አንቀጾች (የማይቀየሩ)"

msgid "The stable paragraphs inline form widget."
msgstr ""
"ቋሚ አንቀጾች በመስመር ውስጥ መግቢያ "
"የመሳሪያ (inline form widget)።"

msgid "The type of the parent entity"
msgstr "የወላጅ አካል (parent entity) ዓይነት"

msgid "The identifier of the parent entity"
msgstr "የወላጅ አካሉ (parent entity) መለያ (identifier)"

msgid "Allow promoting to library"
msgstr "ወደ ቤተ-መዝገብ (Library) ለማሳደግ ፍቀድ"

msgid ""
"Note: Regular paragraph fields should use the revision based reference "
"fields, entity reference fields should only be used for cases when an "
"existing paragraph is referenced from somewhere else."
msgstr ""
"ማስታወሻ፡ መደበኛ የአንቀጽ መስኮች (regular "
"paragraph fields) የማሻሻያ (revision) በመመረኮዝ "
"የሚያመለክቱ ማጣቀሻ መስኮችን (revision based "
"reference fields) መጠቀም አለባቸው፤ የአካል "
"ማጣቀሻ (entity reference) መስኮች ግን አንድ "
"አካል በሌላ ቦታ ከውስጥ ሲጠቀም በሚፈልጉ "
"ጉዳዮች ብቻ መጠቀም አለባቸው።"

msgid "Create structured content."
msgstr "የተዋቀረ (structured) ይዘት ፍጠር።"

msgid "If selected the conversion will return two paragraphs."
msgstr ""
"ከተመረጠ ልወጣው ሁለት ንዑስ አንቀጾችን "
"ይመልሳል።"

msgid "Convert to Text"
msgstr "ወደ ጽሑፍ ቀይር"

msgid "Convert to Text and User"
msgstr "ጽሑፍ ወደ ጽሑፍ እና ተጠቃሚ ቀይር"

msgid "Convert…"
msgstr "…ይቀይሩ"

msgid "Unable to load paragraph type %type when displaying paragraph %id"
msgstr ""
"የአንቀፅ ዓይነት %type አስተናግድ ላይ ሲታይ "
"አይጫንም (paragraph %id)"

msgid "Error in field %field #@position (@bundle), %subfield : @message"
msgstr ""
"በመስክ %field ውስጥ ስህተት #@position (@bundle), "
"%subfield : @message"

msgid "Error in field %field #@position (@bundle): @message"
msgstr ""
"በመስክ %field ውስጥ ስህተት #@position (@bundle): "
"@message"

msgid "Verbose"
msgstr "በጣም ዝርዝር"

msgid "Display alias changes (except during bulk updates)."
msgstr ""
"የአሊያስ ለውጦችን አሳይ (በቡልክ "
"ዝመናዎች ጊዜ ሳይሆን)።"

msgid "Replace by separator"
msgstr "ለመካከለኛ መለያ (separator) በመተካት"

msgid "Maximum alias length"
msgstr ""
"የአብዮት ተጨማሪ ረጅም ይዞታ (Alias) ከፍተኛ "
"ርዝመት"

msgid "Maximum component length"
msgstr "ከፍተኛው የክፍል ርዝመት"

msgid "Update action"
msgstr "የቅያሪ እርምጃ"

msgid "Strings to Remove"
msgstr "ለማስወገድ የሚፈለጉ ጽሑፎች"

msgid "Pathauto"
msgstr "ፓትሁቶ (Pathauto)"

msgid ""
"Provides a mechanism for modules to automatically generate aliases for "
"the content they manage."
msgstr ""
"ሞጁሎች ያስተዳድሩትን ይዘት በራስሰር "
"ለእነሱ አባባል (alias) እንዲፈጥሩ ምቹ የሆነ "
"መንገድ ይሰጣል።"

msgid "Forum"
msgstr "ፎረም"

msgid "Period"
msgstr "ጊዜ"

msgid "Asterisk"
msgstr "አስትερί스크"

msgid ""
"The automatically generated alias %original_alias conflicted with an "
"existing alias. Alias changed to %alias."
msgstr ""
"ከራስ-ሰር የተፈጠረው አሊያስ %original_alias "
"ከነባር አሊያስ ጋር ግጭት ፈጥሯል። "
"አሊያሱ ወደ %alias ተቀይሯል።"

msgid "Delete aliases"
msgstr "Alias-ዎችን ሰርዝ"

msgid "Automatic alias"
msgstr "ራስሰር አሊያስ"

msgid ""
"Character used to separate words in titles. This will replace any "
"spaces and punctuation characters. Using a space or + character can "
"cause unexpected results."
msgstr ""
"ശీർഷകങ്ങളിൽ വാക്കുകൾ "
"വേർതിരിക്കാൻ "
"ഉപയോഗിക്കുന്ന അക്ഷരം. ഇത് "
"ഏതെങ്കിലും സ്പേസുകളും "
"പങ്ക്ചുവേഷൻ ചിഹ്നങ്ങളും "
"മാറ്റിസ്ഥാപിക്കും. "
"സ്പേസ് അല്ലെങ്കിൽ + അക്ഷരം "
"ഉപയോഗിക്കുന്നത് "
"പ്രതീക്ഷിക്കാത്ത "
"ഫലങ്ങൾക്ക് കാരണമാകാം."

msgid "Character case"
msgstr ""
"የቁምፊ መደበኛ/ትክክለኛ ፅንሰ-ሐሳብ "
"(Character case)"

msgid "Do nothing. Leave the old alias intact."
msgstr ""
"هیڅ کار نአትደርግ። ያለውን የአቤቱ ስም "
"እንደሆነ ይተውት።"

msgid "Create a new alias. Leave the existing alias functioning."
msgstr ""
"አዲስ አሊያስ (alias) ፍጠር። ያለውን አሊያስ "
"እንዲሠራ ተወው።"

msgid "Create a new alias. Delete the old alias."
msgstr ""
"አዲስ አሊያስ ፍጠር። የቀድሞውን አሊያስ "
"ሰርዝ።"

msgid "Transliterate prior to creating alias"
msgstr ""
"አስተዋይ (alias) ለመፍጠር በፊት ቀድሞ ይፃፉ "
"(Transliterate)"

msgid ""
"Filters the new alias to only letters and numbers found in the "
"ASCII-96 set."
msgstr ""
"አዲሱን አሊያስ ወደ ASCII-96 ስብስብ ውስጥ "
"የሚገኙ ፊደሎችና ቁጥሮች ብቻ ይገድባል።"

msgid "No action (do not replace)"
msgstr "ምንም እርምጃ (አትተካ)"

msgid "Delete all aliases. Number of aliases which will be deleted: %count."
msgstr ""
"ሁሉንም አቻ ስሞች (aliases) ሰርዝ። ሰርዝ "
"የሚደረጉ አቻ ስሞች ብዛት፦ %count።"

msgid ""
"Delete aliases for all @label. Number of aliases which will be "
"deleted: %count."
msgstr ""
"@label ለሁሉም አሊያሶችን ሰርዝ። የሚሰረዙ "
"አሊያሶች ብዛት፦ %count ናቸው።"

msgid "Delete aliases now!"
msgstr "አሁኑኑ አሊያሶችን ሰርዝ!"

msgid "All of your path aliases have been deleted."
msgstr ""
"የእርስዎ ሁሉ የመንገድ ቅጥያዎች (path aliases) "
"ተሰርዘዋል።"

msgid "Patterns"
msgstr "የንድፎች"

msgid "Colon"
msgstr "ኮሎን"

msgid "Path pattern"
msgstr "የመንገድ ቅጽ (Pattern)"

msgid "Context definitions"
msgstr "የክፍተት መግለጫዎች"

msgid "Semicolon"
msgstr "ነጥብ-vergül"

msgid "Slash"
msgstr "ስላሽ"

msgid "Punctuation"
msgstr "የማጠራቀሚያ ምልክቶች (ምልክታት)"

msgid "Pathauto Settings"
msgstr "የPathauto ቅንብሮች"

msgid ""
"What should Pathauto do when updating an existing content item which "
"already has an alias?"
msgstr ""
"Pathauto ተግባሩ ከዚህ ቀደም በነበረ አቅጣጫ "
"(alias) ላይ ያለውን የነባር ይዘት እቃ "
"ሲያዘምን ምን ሊያደርግ ይገባዋል?"

msgid "Reduce strings to letters and numbers"
msgstr ""
"ቁጥሮችና ፊደሎች ብቻ እንዲቀሩ መቀነስ "
"(strings)"

msgid ""
"Words to strip out of the URL alias, separated by commas. Do not use "
"this to remove punctuation."
msgstr ""
"URL አብራሪ (alias) ከላይ ለማስወገድ የሚፈለጉ "
"ቃላት፣ በኮማ ተለይተው። ይህን የሚሰራው "
"ሰዋስዋ ምልክቶችን (punctuation) ለማስወገድ "
"አይጠቀሙ።"

msgid "Choose aliases to delete"
msgstr "ለማጥፋት የሚመረጡ አብራሪ ስሞች (alias)"

msgid "All aliases"
msgstr "ሁሉም አሊያሶች"

msgid "Ignoring alias %alias because it is the same as the internal path."
msgstr ""
"%alias ን ችላ በማለት ይህ የውስጥ መንገድ "
"(internal path) እንደሆነ ስለሆነ ነው።"

msgid "Created new alias %alias for %source, replacing %old_alias."
msgstr ""
"%source ን ለ%alias አዲስ ተለዋጭ (alias) ፈጥሯል፣ "
"%old_alias ንም በመተካት።"

msgid "Created new alias %alias for %source."
msgstr "ለ %source አዲስ አሊያስ %alias ፈጥሯል።"

msgid "Administer pathauto"
msgstr "የ pathauto አስተዳድር"

msgid "Notify of Path Changes"
msgstr "የመንገድ ለውጦችን ማሳወቅ"

msgid "Determines whether or not users are notified."
msgstr ""
"ተጠቃሚዎች መረጃ እንዲሰጣቸው ይወስናል "
"ወይም አይወስናል።"

msgid "Bulk updating URL aliases"
msgstr ""
"በአብዛኛው የURL አብዛኛ ስሞችን በጅምላ "
"መዘመን"

msgid "Generated 1 URL alias."
msgid_plural "Generated @count URL aliases."
msgstr[0] ""
"1 የURL አሊያስ ተፈጥሯል።  \n"
"@count የURL "
"አሊያሶች ተፈጥረዋል።"

msgid "Update URL alias"
msgstr "የURL አሊያስን አዘምን"

msgid "Underscore"
msgstr "밑줄"

msgid "No new URL aliases to generate."
msgstr "አዲስ የURL አሊያሶች ለመፍጠር የለም።"

msgid "Double quotation marks"
msgstr "ድርብ ጥቅስ ምልክቶች"

msgid "Single quotation marks (apostrophe)"
msgstr "ትንሽ ነጠላ ጥቅሶች (አፖስትሮፊ)"

msgid "Back tick"
msgstr "የተመረጠ ትንሽ ባክቲክ (Back tick)"

msgid "Hyphen"
msgstr "ሃይፈን"

msgid "Vertical bar (pipe)"
msgstr "እርቁታ ባር (ፓይፕ)"

msgid "Left curly bracket"
msgstr "ግራ ኩርስ ቅንፍ ( { )"

msgid "Left square bracket"
msgstr "ግራ የካሬ ቅንፍ ["

msgid "Right curly bracket"
msgstr "ቀኝ ኩርሊ መደመር (} )"

msgid "Right square bracket"
msgstr "ቀኝ ካሬ ቅንጥብ (])"

msgid "Plus sign"
msgstr "ፕላስ ምልክት"

msgid "Equal sign"
msgstr "እኩል ምልክት ( = )"

msgid "Percent sign"
msgstr "प्रतከኛ ዲያ ምልክት"

msgid "Caret"
msgstr "ካሬት"

msgid "Dollar sign"
msgstr "የዶላር ምልክት ($)"

msgid "Number sign (pound sign, hash)"
msgstr "ቁጥር ምልክት (ፓውንድ ምልክት፣ ሃሽ)"

msgid "At sign"
msgstr "@ ምልክት"

msgid "Exclamation mark"
msgstr "የጩኸት ምልክት (!)"

msgid "Tilde"
msgstr "TilDe"

msgid "Left parenthesis"
msgstr "ግራ የቅንፍ ምልክት ("

msgid "Right parenthesis"
msgstr "ቀኝ ቅንፍ \")\""

msgid "Question mark"
msgstr "? (ጥያቄ ምልክት)"

msgid "Less-than sign"
msgstr "በከነብ ምልክት (<) ነው።"

msgid "Greater-than sign"
msgstr "ከፍተኛው-አቅጣጫ ምልክት (`>` )"

msgid "Backslash"
msgstr "የቀርስር (ባክስլ্যাশ)"

msgid "Generate automatic URL alias"
msgstr "ራስ-ሰር የURL አባል (alias) ፍጠር"

msgid "Uncheck this to create a custom alias below."
msgstr ""
"ከዚህ ውጭ ያለውን ይንዳታ በመንሳት በታች "
"ያለ የተበጁ አሊያስ ለመፍጠር ይረዱ።"

msgid "Joined path"
msgstr "አገናኘ መንገድ"

msgid ""
"The array values each cleaned by Pathauto and then joined with the "
"slash into a string that resembles an URL."
msgstr ""
"የማህደሩ እሴቶች እያንዳንዱ በPathauto "
"ተጠርጥሮ (cleaned) በመቀጠል በስላሽ / "
"ተሳስበው እንደ ዩአርኤል የሚመስል "
"ማስመሰያ ጽሁፍ (string) ይሆናሉ።"

msgid "Selection criteria"
msgstr "የምርጫ መመዘኛዎች"

msgid "Bulk generate"
msgstr "በአብዛኛው በአንድ ጊዜ መፍጠር"

msgid "Selection logic"
msgstr "የመምረጫ ሎጂክ"

msgid "Pattern type"
msgstr "የንድፍ አይነት"

msgid "Delete options"
msgstr "የማጥፋት አማራጮች"

msgid "All of your %label path aliases have been deleted."
msgstr ""
"የእርስዎ %label ማስተካከያ መንገዶች (path "
"aliases) ሁሉ ተሰርዘዋል።"

msgid "See <a href=\":pathauto-help\">Pathauto help</a> for details."
msgstr ""
"ዝርዝሮቹን ለማየት <a href=\":pathauto-help\">Pathauto "
"እገዛ</a> ይመልከቱ።"

msgid ""
"Maximum length of aliases to generate. 100 is the recommended length. "
"@max is the maximum possible length."
msgstr ""
"የማድረጃ አተማዎች (aliases) ለመፍጠር ከፍተኛ "
"ርዝመት። 100 የሚመከር ርዝመት ነው። @max "
"ደግሞ የሚቻለው ከፍተኛ ርዝመት ነው።"

msgid ""
"Maximum text length of any component in the alias (e.g., [title]). 100 "
"is the recommended length. @max is the maximum possible length."
msgstr ""
"የአሊያስ ውስጥ ያለው ማንኛውም ክፍል "
"(ለምሳሌ፣ [title]) ከፍተኛ የጽሑፍ ርዝመት። "
"100 የሚመከር ርዝመት ነው። @max ደግሞ ከፍተኛ "
"የሚቻለው ርዝመት ነው።"

msgid ""
"The <a href=\":url\">Redirect module settings</a> affect whether a "
"redirect is created when an alias is deleted."
msgstr ""
"የ<a href=\":url\">የሪዳይሬክት ሞጁል "
"ማሰናጃዎች</a> ቅንብሮች መጥፋት ሲከሰት "
"አንድ አሊያስ ሲሰረዝ ምን ዓይነት "
"ሪዳይሬክት እንደሚፈጠር ይወስናሉ።"

msgid ""
"Considering installing the <a href=\":url\">Redirect module</a> to get "
"redirects when your aliases change."
msgstr ""
"ඔබගේ alias-ች ሲቀየሩ ማስተላለፊያዎች "
"(redirects) እንዲፈጠሩ ለማግኘት <a "
"href=\":url\">Redirect module</a> መጫን እንደሚያስቡት "
"ግምት ያድርጉ።"

msgid ""
"Uncheck this to create a custom alias below. <a "
"href=\"@admin_link\">Configure URL alias patterns.</a>"
msgstr ""
"ይህንን አይቀል ምልክት ለማንሳት ከታች "
"በተቀርበ ቦታ ላይ ልዩ አሊያስ (alias) "
"ለመፍጠር። <a href=\"@admin_link\">የ URL አሊያስ "
"ቅጦችን ለማዋቀር።</a>"

msgid "Selection condition"
msgstr "የምርጫ ሁኔታ"

msgid ""
"Entity of type @type was not processed. It defines the following "
"patterns: @patterns"
msgstr ""
"@type ዓይነት ያለው አካል አልተሰራም። "
"የሚከተሉትን ንድፎች ይገልጻል፦ @patterns"

msgid ""
"Unrecognized entity bundle @entity:@bundle was not processed. It "
"defines the following patterns: @patterns"
msgstr ""
"ያልተለየ ኢንቲቲ ቡንድል @entity:@bundle "
"ተከናውኗል አልተቀናጀም። የሚከተሉትን "
"ንድፎች ይወስናል፦ @patterns"

msgid "Add Pathauto pattern"
msgstr "Pathauto የጎዳና ስትራቴጂ ጨምር"

msgid "Pathauto pattern config"
msgstr "የPathauto የንድፍ (pattern) ማሰናከያ"

msgid "Pathauto state"
msgstr "Pathauto የሁኔታ መዝገብ"

msgid "Whether an automated alias should be created or not."
msgstr ""
"አውቶሜትድ አሊያስ መፍጠር ይኖርይሆን "
"ወይስ አይኖርይሆን ።"

msgid "Pathauto pattern"
msgstr "የ Pathauto ቅጽ (pattern)"

msgid ""
"Check to which types this pattern should be applied. Leave empty to "
"allow any."
msgstr ""
"මෙම ንድፍ (pattern) ወደ የትኛዎቹ ዓይነቶች "
"እንዲተገበር እንደሚገባ ያረጋግጡ። "
"ለማንኛውም ለመፍቀድ ባዶ ይተዉ።"

msgid ""
"Check to which languages this pattern should be applied. Leave empty "
"to allow any."
msgstr ""
"ይህ ጥቅል (pattern) ለምን ቋንቋዎች "
"እንዲተገበር እንደሚፈልጉ ይመልከቱ። "
"ማንኛውንም ለመፍቀድ ባዶ ይተዉት።"

msgid "@label being aliased"
msgstr "@label የተተካ ስም (alias)"

msgid "Updated alias for %label @id."
msgstr "የ %label @id አትራስ (alias) ዘምኗል።"

msgid "Updated 1 %label URL alias."
msgid_plural "Updated @count %label URL aliases."
msgstr[0] ""
"ተዘምኗል 1 %label ዩአርኤል አብዛኛው "
"ተለዋጭ።  \n"
"ተዘምኗል @count %label ዩአርኤል "
"አብዛኛው ተለዋጮች።"

msgid ""
"When a pattern includes certain characters (such as those with "
"accents) should Pathauto attempt to transliterate them into the "
"US-ASCII alphabet?"
msgstr ""
"ንድፉ አንዳንድ ቁምፊዎችን ይዞ (ለምሳሌ "
"ከማዕከላዊ ምልክቶች ጋር ያሉትን) ከዚያ "
"Pathauto ወደ አሜሪካ ኤስ-ኤኤስ-አስኪ ፊደላት "
"(US-ASCII) እንዲተርጉማቸው መሞከር አለበት?"

msgid ""
"This page provides a list of all patterns on the site and allows you "
"to edit and reorder them."
msgstr ""
"ይህ ገጽ በድረ-ገጹ ላይ ያሉ ሁሉንም ንድፎች "
"(patterns) ዝርዝር ያሳያል እና እነሱን "
"እንዲቀይሩ (edit) እና እንደገና እንዲያደራጁ "
"(reorder) ያስችላል።"

msgid ""
"The %element-title is using the following invalid characters: "
"@invalid-characters."
msgstr ""
"%element-title የሚጠቀምበት የማይፈቀድ "
"ቁምፊዎች ይህን ይዟል፦ @invalid-characters."

msgid "Convert token values to lowercase."
msgstr "የቶከን እሴቶችን ወደ ታችኛ ፊደል ቀይር።"

msgid "Are you sure you want to disable the pattern %label?"
msgstr ""
"“%label” የሚለውን ፓተርን ማቦዘን "
"መፈለጋችሁ እርግጠኛ ነዎት?"

msgid "Disabled patterns are ignored when generating aliases."
msgstr ""
"ማሰናከል የተደረገላቸው ቅጦች አባል "
"ስሞችን በመፍጠር ጊዜ ችላ ይባላሉ።"

msgid "Disabled pattern %label."
msgstr "የተበከለ ዘዴ %label ተክሎ ነው።"

msgid "Are you sure you want to enable the pattern %label?"
msgstr ""
"%label ይህን አግባብ (pattern) ማስቻል "
"በእርግጠኝነት ፈልገዋል?"

msgid "Enabled pattern %label."
msgstr "ንድን መተግበሪያ ንድን  %label አንቃ።"

msgid "Update URL alias of an entity"
msgstr "የአካል ዩአርኤል አታራጭ (URL alias) አዘምን"

msgid ""
"The Pathauto module provides a mechanism to automate the creation of "
"<a href=\"path\">path</a> aliases. This makes URLs more readable and "
"helps search engines index content more effectively.  For more "
"information, see the <a href=\":online\">online documentation for "
"Pathauto</a>."
msgstr ""
"የ Pathauto ሞጁሉ የ <a href=\"path\">path</a> "
"አሊያሶችን በራስ-ሰር ለመፍጠር የሚያስችል "
"ስርዓት ይሰጣል። ይህ URL-ዎችን በቀላሉ "
"ለመነበብ ያስችላል እና የፍለጋ ሞተሮች "
"ይዘትን በብቃት ለመመዝገብ ይረዳል። "
"ለበለጠ መረጃ፣ <a href=\":online\">የ Pathauto "
"ऑንላይን ሰነድ</a>ን ይመልከቱ።"

msgid ""
"Pathauto is accessed from the tabs it adds to the list of <a "
"href=\":aliases\">URL aliases</a>."
msgstr ""
"Pathauto የሚገኘው ተጨምሮ በሚያስቀምጠው "
"ትሮች (tabs) ከ <a href=\":aliases\">URL aliases</a> ዝርዝር "
"ውስጥ ነው።"

msgid "Creating Pathauto Patterns"
msgstr "የPathauto ንድፎችን መፍጠር"

msgid ""
"The <a href=\":pathauto_pattern\">\"Patterns\"</a> page is used to "
"configure automatic path aliasing.  New patterns are created here "
"using the <a href=\":add_form\">Add Pathauto pattern</a> button which "
"presents a form to simplify pattern creation thru the use of <a "
"href=\"token\">available tokens</a>. The patterns page provides a list "
"of all patterns on the site and allows you to edit and reorder them. "
"An alias is generated for the first pattern that applies."
msgstr ""
"የ <a href=\":pathauto_pattern\">\"Patterns\"</a> ገጹ "
"አውቶማቲክ የመንገድ አቤቱ (path aliasing) "
"ለማዋቀር ይጠቅማል። አዳዲስ ፓተርኖች በ <a "
"href=\":add_form\">Add Pathauto pattern</a> ቁልፍ በመጠቀም "
"እዚህ ይፈጠራሉ፣ ይህም ከ <a href=\"token\">available "
"tokens</a> በመጠቀም ቀላል የፓተርን ፍጠራ "
"እንዲያደርጉ ቅጽ (form) ያቀርባል። "
"የፓተርኖች ገጹ በጣቢያው ላይ ያሉ ሁሉንም "
"ፓተርኖች ዝርዝር ይሰጣል እና "
"እንዲያርትዎት እንዲሁም እነሱን እንደገና "
"በቅደም ተከተል እንዲያስደርድሩ "
"ያስችላል። ለመጀመሪያው የሚተገበር "
"(የሚሰራ) ፓተርን አቤቱ ይፈጠራል።"

msgid ""
"The <a href=\":settings\">\"Settings\"</a> page is used to customize "
"global Pathauto settings for automated pattern creation."
msgstr ""
"የ <a href=\":settings\">\"Settings\"</a> ገጹ ለራስ-ሰር "
"የንድፍ ፍጠር የሚያስችሉ የአጠቃላይ Pathauto "
"ቅንብሮችን ለማበጀት ይጠቅማል።"

msgid "Bulk Generation"
msgstr "ብዙ ልኬት ፍጥረት"

msgid ""
"The <a href=\":pathauto_bulk\">\"Bulk Generate\"</a> page allows you "
"to create URL aliases for items that currently have no aliases. This "
"is typically used when installing Pathauto on a site that has existing "
"un-aliased content that needs to be aliased in bulk."
msgstr ""
"የ<a href=\":pathauto_bulk\">\"Bulk Generate\"</a> ገጹ አሁን "
"ምንም URL አሊያስ የሌላቸው ንጥሎች ላይ URL "
"አሊያሶችን ለመፍጠር ይፈቅድልዎታል። ይህ "
"በተለምዶ Pathautoን በድረ-ገጽ ላይ በመጫን "
"ጊዜ የሚጠቀሙት ነው፤ በአብዛኛው ቀድሞ "
"የነበረ ያልተሰየመ (un-aliased) ይዘት አለ እና "
"በብዛት ሊሰየም የሚፈልግ ሲሆን።"

msgid "Delete Aliases"
msgstr "አቋራጭ ስሞችን (Aliases) ሰርዝ"

msgid ""
"The <a href=\":pathauto_delete\">\"Delete Aliases\"</a> page allows "
"you to remove URL aliases from items that have previously been "
"assigned aliases using pathauto."
msgstr ""
"በ <a href=\":pathauto_delete\">\"Delete Aliases\"</a> ገፅ ላይ "
"በቀደም ጊዜ ከ pathauto በመጠቀም አሊያስ "
"የተመደቡ ዕቃዎች ላይ ከURL አሊያሶች "
"ማስወገድ መቻልዎ ይችላሉ።"

msgid ""
"You need to select a pattern type, then a pattern and filter, and a "
"label. Additional types can be enabled on the <a "
"href=\":settings\">Settings</a> page."
msgstr ""
"የንድፍ ዓይነት (pattern type) መምረጥ፣ ከዚያም "
"ንድፉንና ፍለጋ ማጣሪያውን (filter) መምረጥ፣ "
"እና መለያ (label) መጨመር ይኖርብዎታል። "
"ተጨማሪ ዓይነቶች በ <a href=\":settings\">Settings</a> "
"ገጽ ላይ ሊነቁ ይችላሉ።"

msgid "Enabled entity types"
msgstr "የነቃ የአካል ዓይነቶች"

msgid ""
"Enable to add a path field and allow to define alias patterns for the "
"given type. Disabled types already define a path field themselves or "
"currently have a pattern."
msgstr ""
"እዚህ የመንገድ (path) መስክ ለመጨመር እና "
"ለተሰጠው ዓይነት የሚፈቅዱትን የአሊያስ "
"ቅጦች (alias patterns) ለመወሰን ያስችላል። "
"በተሰናከሉ ዓይነቶች ውስጥ እራሳቸው "
"ቀድሞውኑ የመንገድ መስክ ይገልጻሉ ወይም "
"አሁን ያላቸው ቅጥ (pattern) አለ።"

msgid "Broken type"
msgstr "የተበላሸ አይነት"

msgid "AliasType"
msgstr "AliasType"

msgid ""
"Bulk generation can be used to generate URL aliases for items that "
"currently have no aliases. This is typically used when installing "
"Pathauto on a site that has existing un-aliased content that needs to "
"be aliased in bulk."
msgstr ""
"በብዛት መፍጠር (Bulk generation) አሁን "
"የሌላቸውን አድራሻ አባሎች (URL aliases) "
"ለሌላቸው እቃዎች የURL alias ለመፍጠር "
"ሊያገለግል ይችላል። ይህ ብዙውን ጊዜ Pathauto "
"ን በጣቢያ ላይ ሲጭኑ ከፊት ነገር ግን "
"ያልተፈታ (un-aliased) ይዘት ያለበትን እንዲሁም "
"በብዛት በተፈጥሮ መንገድ መስጠት "
"የሚያስፈልግ ሲሆን ነው።"

msgid ""
"It can also be used to regenerate URL aliases for items that have an "
"old alias and for which the Pathauto pattern has been changed."
msgstr ""
"እንዲሁም የቀድሞ አባላት (aliases) ያሉ "
"ነገሮች የURL አባላትን እንደገና ለመፍጠር "
"ይቻላል፤ እንዲሁም Pathauto የሚከተለው ፕላን "
"(pattern) ተቀይሯል የሚባልባቸው ጉዳዮችን "
"ለመልሶ ማመንጨት ይጠቅማል።"

msgid ""
"Note that this will only affect items which are configured to have "
"their URL alias automatically set. Items whose URL alias is manually "
"set are not affected."
msgstr ""
"እዚህ የተጠቀሰው በራስ ሰር URL አሊያስ "
"እንዲመዘን ተዋቅሮ ላሉ እቃዎች ብቻ "
"ይነካል። እስከ አንድ በእጅ የሚዋቀር URL "
"አሊያስ ያላቸው እቃዎች አይነኩም።"

msgid "The %element-title doesn't allow the patterns ending with whitespace."
msgstr ""
"የ%element-title እዚህ ያሉት ከባዶ ቦታ (whitespace) "
"ጋር የሚያበቁ ቅጦችን (patterns) አይፈቅድም።"

msgid "Select the types of paths for which to generate URL aliases"
msgstr ""
"URL አቀማመጦች (aliases) ለማመንጨት ምን "
"ዓይነት የመንገድ (paths) አይነቶችን "
"እንደሚመርጡ ይምረጡ"

msgid "Select which URL aliases to generate"
msgstr "የሚፈጠሩትን የURL አሊያስ (Aliases) ይምረጡ"

msgid "Generate a URL alias for un-aliased paths only"
msgstr ""
"አሊያስ ያልተመደቡ መንገዶች ብቻ ላይ የURL "
"አሊያስ ፍጠር"

msgid ""
"<a href=\":url\">Pathauto settings</a> are set to ignore paths which "
"already have a URL alias. You can only create URL aliases for paths "
"having none."
msgstr ""
"<a href=\":url\">Pathauto የማስተካከያ ቅንብሮች</a> "
"በእርስዎ ላይ ዩአርኤል አብይ (URL alias) "
"ያለባቸውን መንገዶች (paths) ችላ እንዲል "
"ተዘጋጅተዋል። URL አብይ መፍጠር የሚቻለው "
"አሁን አብይ የሌላቸውን መንገዶች (paths) ብቻ "
"ነው።"

msgid "Update the URL alias for paths having an old URL alias"
msgstr ""
"የአሮጌ URL አባላት (alias) ያላቸው መንገዶች የ "
"URL አባል (alias) ያዘምኑ"

msgid "Regenerate URL aliases for all paths"
msgstr ""
"ሁሉንም መንገዶች የURL አሊያሶችን እንደገና "
"አዘጋጅ/ፃፍ"

msgid "A short name to help you identify this pattern in the patterns list."
msgstr ""
"ይህን ቅጥን በቅጦች ዝርዝር ውስጥ "
"ለመለየት የሚረዳ አጭር ስም።"

msgid "Only delete automatically generated aliases"
msgstr ""
"ස්වయංማቲክ የተፈጠሩ አሊያሶችን ብቻ "
"ሰርዝ"

msgid ""
"When checked, aliases which have been manually set are not affected by "
"this mass-deletion."
msgstr ""
"እንዳይመለከት በተመረጠ ጊዜ፣ በእጅ "
"የተዘጋጁ የሚጠቀሙ (aliases) ይህን "
"የጅምላ-መሰረዝ ተግባር አይነኩም።"

msgid "Bulk deleting URL aliases"
msgstr "በጅምላ መሰረዝ የURL አልያሶች"

msgid "All of your automatically generated path aliases have been deleted."
msgstr ""
"ඔබගේ ස්වයංක්‍රීයව ජනනය "
"කරන ලද සියලුම මාර්ග "
"අන්වර්ථනාමයන් (path aliases) මකා "
"දමා ඇත."

msgid ""
"All of your automatically generated %label path aliases have been "
"deleted."
msgstr ""
"ඔබගේ ස්වයංක්‍රීයව ජනනය "
"කරන ලද සියලුම %label path යන "
"අන්වර්ථ නාම මකා දමා ඇත."

msgid "Tokens that are safe to use and do not need to be cleaned."
msgstr ""
"እንዲጸዳ (clean) የማይፈልጉ እና መጠቀም "
"ደህና የሆኑ ቶከኖች።"

msgid "Safe tokens"
msgstr "ደህንነት ያላቸው ቶከኖች"

msgid ""
"List of tokens that are safe to use in alias patterns and do not need "
"to be cleaned. For example urls, aliases, machine names. Separated "
"with a comma."
msgstr ""
"አሊያስ ፓተርኖች ውስጥ ለመጠቀም ደህና "
"የሆኑ እና ማጽዳት (cleaning) አያስፈልጋቸውም "
"የሚሆኑ ቶከኖች ዝርዝር። ለምሳሌ "
"ዩአርኤሎች፣ አሊያሶች፣ ማሽን ስሞች። "
"በኮማ ተለይተው ይጻፉ።"

msgid "Pattern %label saved."
msgstr "“%label” የተቀመጠው ንድን ነው።"

msgid "Duplicate Pathauto pattern"
msgstr "የተባዛ የPathauto ንድፍ (pattern)"

msgid "Choose the action to perform."
msgstr ""
"እባክዎ ሊፈጸም የሚገባውን እርምጃ "
"ይምረጡ።"

msgid ""
"Invalid action argument \"@invalid_action\". Please use one of: "
"@valid_actions"
msgstr ""
"የማይቻል የተግባር አርጉመንት "
"“@invalid_action”። እባክዎ ከእነዚህ አንዱን "
"ይጠቀሙ፦ @valid_actions"

msgid ""
"Invalid type argument \"@invalid_types\". Please choose from the "
"following: @valid_types"
msgstr ""
"የማይፈቀድ ዓይነት ክርክር “@invalid_types” "
"ነው። ከሚከተሉት ውስጥ ይምረጡ፦ @valid_types"

msgid "Generate a URL alias for un-aliased paths only."
msgstr ""
"ማዕከል-ልዩ ስም አልተሰጣቸው መንገዶች "
"ብቻ የURL አልያስ ይፍጠሩ።"

msgid "Update the URL alias for paths having an old URL alias."
msgstr ""
"ከቀድሞ የURL አሊያስ ጋር የተያያዙ "
"መንገዶች (paths) የURL አሊያሱን ይዘምኑ።"

msgid "Regenerate URL aliases for all paths."
msgstr ""
"ሁሉንም መንገዶች የURL አባባሎችን  yen "
"እንደገና ያመንጩ።"

msgid "The name of the pattern's variable."
msgstr "የፓተርኑ ተለዋዋጭ ስም።"

msgid "The value of the pattern's variable."
msgstr "የፓተርኑ ተለዋዋጭ ዋጋ።"

msgid ""
"The <strong>maximum alias length</strong> and <strong>maximum "
"component length</strong> values default to 100 and have a limit of "
"@max from Pathauto. You should enter a value that is the length of the "
"\"alias\" column of the path_alias database table minus the length of "
"any strings that might get added to the end of the URL. The "
"recommended and default value is 100."
msgstr ""
"የ<strong>ከፍተኛ የአሊያስ ርዝመት</strong> እና "
"የ<strong>ከፍተኛ የኮምፖነንት ርዝመት</strong> "
"ዋጋዎች በነባሪ 100 ሲሆኑ ከ Pathauto የ @max "
"ገደብ ያለው ነው። የሚገቡት ዋጋ የ path_alias "
"የዳታቤዝ ሰንጠረዥ ውስጥ “alias” አምድ "
"ርዝመት ላይ በመጨረሻ የሚጨመሩ ማንኛውም "
"ጽሑፎች ርዝመት ተቀንሶ የሚወጣው ርዝመት "
"መሆን አለበት። የሚመከረው እና በነባሪ "
"ዋጋ 100 ነው።"

msgid ""
"<strong>Note:</strong> there is no confirmation. Be sure of your "
"action before clicking the \"Delete aliases now!\" button.<br />You "
"may want to make a backup of the database and/or the path_alias and "
"path_alias_revision tables prior to using this feature."
msgstr ""
"<strong>ማስታወሻ፦</strong> ማረጋገጫ አይኖርም። "
"“Delete aliases now!” የሚለውን ቁልፍ ከመጫንዎ "
"በፊት የሚፈጽሙት እርምጃ መሆኑን ጥርጥር "
"እንዳይኖር ይረጋግጡ።<br />ይህን ባህሪ "
"ከመጠቀምዎ በፊት የዳታቤዝ እና/ወይም "
"የpath_alias እና path_alias_revision ሰንጠረዦች ቅጂ "
"(backup) ማድረግ ሊፈልጉ ይችላሉ።"

msgid "General settings"
msgstr "සාමාಾನ್ಯ සැකසුම්"

msgid "Widget settings"
msgstr "የዊጂት ቅንብሮች"

msgid "reCAPTCHA"
msgstr "reCAPTCHA"

msgid "Secret key"
msgstr "የሚስጥር ቁልፍ"

msgid "Defines which theme to use for reCAPTCHA."
msgstr ""
"reCAPTCHA ለማግኘት የሚውለውን ገጽታ (theme) "
"ይወስናል።"

msgid "Site key"
msgstr "የጣቢያ ቁልፍ"

msgid "@error"
msgstr "@error"

msgid "Image (default)"
msgstr "ምስል (ነባር)"

msgid "Administer the Google No CAPTCHA reCAPTCHA web service."
msgstr "د ګوګل No CAPTCHA reCAPTCHA وېب خدمت اداره کړئ."

msgid "Administer reCAPTCHA"
msgstr "reCAPTCHA እንዲሠራ አስተዳድር"

msgid "Normal (default)"
msgstr "መደበኛ (ነባሪ)"

msgid "Light (default)"
msgstr "ቀላል (በነባሪ)"

msgid "The type of CAPTCHA to serve."
msgstr "ለማቅረብ የ CAPTCHA ዓይነት።"

msgid "Enable fallback for browsers with JavaScript disabled"
msgstr ""
"JavaScript ካልተነቃ ለተጠቃሚ አሳሾች "
"የመመለሻ አማራጭን አንቃ"

msgid ""
"If JavaScript is a requirement for your site, you should "
"<strong>not</strong> enable this feature. With this enabled, a "
"compatibility layer will be added to the captcha to support non-js "
"users."
msgstr ""
"የጃቫስքሪፕት መጠቀም ለጣቢያዎ አስፈላጊ "
"ከሆነ፣ ይህን ባህሪ <strong>አይቻሉ</strong>። "
"እንዲህ ከተነቃ ሲስተሙ የማጣጠሚያ ደረጃ "
"(compatibility layer) ወደ ካፕቻ ይጨምራል "
"ለጃቫስքሪፕት የማይጠቀሙ ተጠቃሚዎች "
"ድጋፍ ለማድረግ።"

msgid "The secret parameter is missing."
msgstr "የሚስጥራዊው መተኪያ (parameter) ጠፍቷል።"

msgid "The secret parameter is invalid or malformed."
msgstr ""
"የእሴት መግለጫ (secret) ፓራሜትሩ ወይም "
"ተሳሳተኛ ነው ወይም በትክክል "
"አልተቀረጸም።"

msgid "The response parameter is missing."
msgstr "የምላሽ መለኪያ (parameter) ጎድሎ ነው።"

msgid "The response parameter is invalid or malformed."
msgstr ""
"የምላሽ መለኪያው ወይም አይተካከለም ወይም "
"ትክክል ያልተሰራ (malformed) ነው።"

msgid ""
"Protect your website from spam and abuse while letting real people "
"pass through with ease."
msgstr ""
"ለእውነተኛ ሰዎች በቀላሉ እንዲያልፉ እድል "
"ስትሰጡ ድረ-ገጽዎን ከስፓም እና ከተሳዳቢ "
"ተግባር ይጠብቁ።"

msgid "The json response is invalid or malformed."
msgstr ""
"የ json ምላሹ ልክ ያልሆነ ወይም ቅርፁ "
"የተዛባ (malformed) ነው።"

msgid ""
"Google <a href=\":url\">reCAPTCHA</a> is a free service to protect "
"your website from spam and abuse. reCAPTCHA uses an advanced risk "
"analysis engine and adaptive CAPTCHAs to keep automated software from "
"engaging in abusive activities on your site. It does this while "
"letting your valid users pass through with ease."
msgstr ""
"Google <a href=\":url\">reCAPTCHA</a> የቤት ጣቢያዎን "
"ከስፓም እና ከተጠቃሚ መጥፎ ተግባር "
"ለመጠበቅ ነፃ አገልግሎት ነው። reCAPTCHA "
"ለራስ-ሰር ሶፍትዌር በጣቢያዎ ላይ አጥፊ "
"ተግባራትን እንዳይፈጽም የሚያግዝ የላቀ "
"የአደጋ ትንታኔ ሞተር እና ተስማሚ (adaptive) "
"CAPTCHAs ይጠቀማል። ይህንን በሚያደርግበት "
"ጊዜም ትክክለኛ ተጠቃሚዎችዎ በቀላሉ "
"እንዲያልፉ ይፈቅዳል።"

msgid "Administer reCAPTCHA settings."
msgstr "የ reCAPTCHA መቼቶችን ያስተዳድሩ።"

msgid "reCAPTCHA settings"
msgstr "د reCAPTCHA ቅንብሮች"

msgid "The size of CAPTCHA to serve."
msgstr "ለመመርጠት የ CAPTCHA መጠን።"

msgid "@info"
msgstr "@info"

msgid "Protects and defends"
msgstr "ይጠብቃል እና ይከላከላል"

msgid ""
"reCAPTCHA is built for security. Armed with state of the art "
"technology, it always stays at the forefront of spam and abuse "
"fighting trends. reCAPTCHA is on guard for you, so you can rest easy."
msgstr ""
"reCAPTCHA ደህንነት ለማረጋገጥ ተገንብቷል። "
"ዘመናዊ ቴክኖሎጂ የታጠቀ ሲሆን፣ ሁሌም "
"በስፓም እና በማብራሪያ/ጥቃት ትግል "
"አዝማሚያዎች ፊት ለፊት ቆይቷል። ይህን "
"እንደ ጠባቂ በእርስዎ ቦታ ላይ ነው "
"የሚጠብቀው፣ ስለዚህ ምቾት ተሰምቶዎ ማረፍ "
"ይችላሉ።"

msgid ""
"You will now find a reCAPTCHA tab in the CAPTCHA administration page "
"available at: Administration > Configuration > People > CAPTCHA module "
"settings > reCAPTCHA"
msgstr ""
"ከአሁን በኋላ በCAPTCHA አስተዳደር ገጹ ላይ "
"የreCAPTCHA ትር እንዳለ ያገኙታል፣ ይህም "
"በዚህ ላይ ነው፦ **Administration > Configuration > People > "
"CAPTCHA module settings > reCAPTCHA**"

msgid ""
"Register your web site at <a "
"href=\":url\">https://www.google.com/recaptcha/admin/create</a>"
msgstr ""
"የእርስዎን ድር ጣቢያ በ <a "
"href=\":url\">https://www.google.com/recaptcha/admin/create</a> ላይ "
"ያስመዝግቡ።"

msgid "Input the site and private keys into the reCAPTCHA settings."
msgstr ""
"የጣቢያውን እና የግል ቁልፎችን ወደ reCAPTCHA "
"ማስተካከያዎች ያስገቡ።"

msgid ""
"Visit the Captcha administration page and set where you want the "
"reCAPTCHA form to be presented: Administration > Configuration > "
"People > CAPTCHA module settings"
msgstr ""
"የ Captcha አስተዳደር ገጹን ይጎብኙ እና reCAPTCHA "
"ቅጹ የት እንዲታይ እንደሚፈልጉ ይወስኑ፦ "
"አስተዳደር > ቅንብሮች > ሰዎች > CAPTCHA ሞጁል "
"ቅንብሮች"

msgid "Local domain name validation"
msgstr "የአካባቢ የዶሜይን ስም ማረጋገጥ"

msgid ""
"Checks the hostname on your server when verifying a solution. Enable "
"this validation only, if <em>Verify the origin of reCAPTCHA "
"solutions</em> is unchecked for your key pair. Provides crucial "
"security by verifying requests come from one of your listed domains."
msgstr ""
"መስፈርቱን ሲያረጋግጡ በሰርቨራዎ ላይ "
"የአስተናጋጅ (hostname) መለያውን ይ "
"ստուգ합니다። ይህን ማረጋገጫ ብቻ "
"ያንቁት፣ በቁልፍ ጥንድዎ ላይ <em>የ reCAPTCHA "
"መፍትሄዎች አመጣጥ (origin) ያረጋግጡ</em> "
"የሚለው ካልተከፈተ/ካልተመረጠ ከሆነ። "
"የጥያቄዎች ከተዘረዘሩ አንዱ የእርስዎ "
"ዶሜይኖች በመጡ መሆኑን በማረጋገጥ ወሳኝ "
"የደህንነት ጥበቃ ይሰጣል።"

msgid "Expected action did not match."
msgstr ""
"අපේक्षित ක්‍රියාව සමඟ "
"නොගැළපේ."

msgid "Expected APK package name did not match."
msgstr ""
"የተጠበቀው የAPK ፓኬጅ ስም ከሚመጣው ጋር "
"አልተመጣጠነም።"

msgid "Did not receive a 200 from the service."
msgstr "ከአገልግሎቱ 200 አልተቀበልንም።"

msgid "The request is invalid or malformed."
msgstr ""
"ጥያቄው የማይፈቀድ ወይም ትክክል ቅርጽ "
"ያልተያዘ ነው።"

msgid "Challenge timeout."
msgstr "የችግኝ (චැሌንጅ) ታይምውት ተፈጥሯል።"

msgid "Could not connect to service."
msgstr "ከአገልግሎቱ ጋር መገናኘት አልተቻለም።"

msgid "Expected hostname did not match."
msgstr "የተጠበቀው ሆስት ስም አልተዛመደም።"

msgid "Score threshold not met."
msgstr "የውጤት ደረጃው አልተሟላም።"

msgid "Not a success, but no error codes received!"
msgstr ""
"موለኛ ስለማይሆን ነው፣ ግን ምንም ስህተት "
"ኮዶች አልተቀበልንም!"

msgid "The challenge response timed out or was already verified."
msgstr ""
"የፈተና መልስ ጊዜው አልፏል ወይም ቀደም "
"ሲል ይህ ተረጋግጧል።"

msgid "Use reCAPTCHA globally"
msgstr "reCAPTCHAን በአጠቃላይ ተጠቀም"

msgid ""
"Enable this in circumstances when \"www.google.com\" is not "
"accessible, e.g. China."
msgstr ""
"ይህን ያብሩ እንዲሁም “www.google.com” "
"አይገኝም በሚሆንባቸው ሁኔታዎች ሲደርስ፣ "
"ለምሳሌ በቻይና።"

msgid "Enable reCAPTCHA and CAPTCHA modules in Administration > Extend"
msgstr ""
"በአስተዳደር (Administration) > Extend ውስጥ reCAPTCHA "
"እና CAPTCHA ሞጁሎችን አንቃ።"

msgid ""
"The site key given to you when you <a href=\":url\" "
"target=\"_blank\">register for reCAPTCHA</a>."
msgstr ""
"reCAPTCHA ን ለመመዝገብ ሲፈጥሩ የሚሰጡት <a "
"href=\":url\" target=\"_blank\">የጣቢያ ቁልፍ</a>።"

msgid ""
"The secret key given to you when you <a href=\":url\" "
"target=\"_blank\">register for reCAPTCHA</a>."
msgstr ""
"reCAPTCHA ለመመዝገብ ሲመዘገቡ <a href=\":url\" "
"target=\"_blank\">በተሰጠዎት ጊዜ የሚሰጥዎት "
"ሚስጥራዊ ቁልፍ</a>።"

msgid "Add another"
msgstr "ሌላ አክል/ጨምር"

msgid "Redirect"
msgstr "የማዞወር (Redirect)"

msgid "Add redirect"
msgstr "ወደ ማዞር ጨምር"

msgid "301 Moved Permanently"
msgstr "301 ለቋሚነት ተዛውሯል (Moved Permanently)"

msgid "307 Temporary Redirect"
msgstr "307 የጊዜያዊ መመራት"

msgid "Status Code"
msgstr "የሁኔታ ኮድ"

msgid "URL redirects"
msgstr "የURL ማዞሪያዎች"

msgid ""
"You are attempting to redirect the page to itself. This will result in "
"an infinite loop."
msgstr ""
"ඔබ පිටුව නැවත තමන් වෙතම "
"හරවා යැවීමට උත්සාහ කරමින් "
"සිටී. මෙය අසීමිත වළල්ලක් "
"(infinite loop) ඇති කරයි."

msgid "300 Multiple Choices"
msgstr "300 ተጠቃሚ መልሶች (Multiple Choice)"

msgid "302 Found"
msgstr "302 የተገኘ (Found)"

msgid "303 See Other"
msgstr "303 ወደ ሌላው መሄጃ (See Other)"

msgid "304 Not Modified"
msgstr "304 ተሻሻልአልተደረገም"

msgid "305 Use Proxy"
msgstr "305 ከፕሮክሲ በኩል ይጠቀሙ"

msgid "Redirect users from one URL to another."
msgstr ""
"ከአንድ ዩአርኤል ወደ ሌላ ዩአርኤል "
"ተጠቃሚዎችን ማዞር።"

msgid "Menu Access Checking"
msgstr "የመነሻ መዳረሻ መፈተሻ"

msgid "All languages"
msgstr "ሁሉም ቋንቋዎች"

msgid ""
"A redirect set for a specific language will always be used when "
"requesting this page in that language, and takes precedence over "
"redirects set for <em>All languages</em>."
msgstr ""
"የተለየ ቋንቋ ለመጠቀም የተዘጋጀ ማዞሪያ "
"(redirect) ይህንን ገጽ በዚያ ቋንቋ ሲጠይቁ "
"ሁልጊዜ ይጠቀማል፣ እና ለ<em>ሁሉም "
"ቋንቋዎች</em> የተዘጋጁ ማዞሪያዎች ከላይ "
"የሚበልጡት ይሆናሉ።"

msgid "Redirect status"
msgstr "ወደ ማዞሪያ ሁኔታ"

msgid "Display a warning message to users when they are redirected."
msgstr ""
"ተጠቃሚዎች ወደሌላ ቦታ ሲመራዱ "
"የማስጠንቀቂያ መልእክት ያሳዩ።"

msgid "Automatically create redirects when URL aliases are changed."
msgstr ""
"URL አተገባበር ስሞች ሲቀየሩ በራስ ሰር "
"ሪዳይሬክቶችን ይፍጠሩ።"

msgid "Default redirect status"
msgstr "ነባሪ የመተላለፊያ ሁኔታ"

msgid "Delete redirect"
msgstr "የማዘዋወር ሰርዝ (Redirect ሰርዝ)"

msgid "Configure behavior for URL redirects."
msgstr "የURL ሪዳይሬክቶች ባህሪን ያስተካክሉ።"

msgid "Resolved"
msgstr "ተፈቷል"

msgid "Status code"
msgstr "የሁኔታ ኮድ"

msgid "Fragment"
msgstr "ቁራጭ"

msgid ""
"You can find more information about HTTP redirect status codes at <a "
"href=\"@status-codes\">@status-codes</a>."
msgstr ""
"HTTP redirect status codes ላይ ተጨማሪ መረጃን በ<a "
"href=\"@status-codes\">@status-codes</a> ላይ ማግኘት "
"ይችላሉ።"

msgid "The redirect has been saved."
msgstr "የዕሳት መልህቅ (redirect) ተቀምጧል።"

msgid "No URL redirects available."
msgstr "የ URL አቅጣጫ መለዋወጫ (redirects) አይገኝም።"

msgid ""
"Enter an internal Drupal path or path alias to redirect (e.g. "
"%example1 or %example2). Fragment anchors (e.g. %anchor) are "
"<strong>not</strong> allowed."
msgstr ""
"ወደ ማስተላለፍ (redirect) የውስጥ የDrupal "
"መንገድ ወይም የመንገድ ተተኪ ስም (path alias) "
"ያስገቡ (ለምሳሌ %example1 ወይም %example2)። "
"የክፍል መለያዎች (fragment anchors) (ለምሳሌ %anchor) "
" <strong>አይፈቀዱም</strong>።"

msgid ""
"The source path %path is likely a valid path. It is preferred to <a "
"href=\"@url-alias\">create URL aliases</a> for existing paths rather "
"than redirects."
msgstr ""
"ከምንጩ መንገድ %path የሚጠቁም መንገድ "
"ትክክለኛ መሆን ይችላል። ለነባር መንገዶች "
"ከመምሪያ (redirects) ይልቅ <a href=\"@url-alias\">URL alias "
"መፍጠር</a> ይመረጣል።"

msgid ""
"The base source path %source is already being redirected. Do you want "
"to <a href=\"@edit-page\">edit the existing redirect</a>?"
msgstr ""
"መሠረታዊው የመነሻ መንገድ %source አስቀድሞ "
"ወደ ሌላ ቦታ ተመልሷል። የ <a "
"href=\"@edit-page\">ነባር ማስተላለፊያውን "
"ይቀይሩ</a> ይፈልጋሉ?"

msgid ""
"Are you sure you want to delete the URL redirect from %source to "
"%redirect?"
msgstr ""
"%source የሚወስደውን URL ማዞሪያ (redirect) ከ "
"%redirect ጋር ለማጥፋት እርግጠኛ ነዎት?"

msgid "Retain query string through redirect."
msgstr ""
"ወደ ማዞሪያ (redirect) ሲደረግ የጥያቄ "
"ሕብረቁልፍ (query string) ይቀመጥ (ይዞር።)"

msgid ""
"For example, given a redirect from %source to %redirect, if a user "
"visits %sourcequery they would be redirected to %redirectquery. The "
"query strings in the redirection will always take precedence over the "
"current query string."
msgstr ""
"ለምሳሌ፣ ከ%source ወደ %redirect የሚደረግ "
"ሪዳይሬክት ካለ፣ አንድ ተጠቃሚ %sourcequery "
"ቢገባ እርሱ ወደ %redirectquery ይመራል። "
"በሪዳይሬክሽኑ ውስጥ ያሉት ኩሪ ስትሪንጎች "
"ሁልጊዜ ከአሁኑ ኩሪ ስትሪንግ በላይ "
"ቅድሚያ ይወስዳሉ።"

msgid "(formerly Global Redirect features)"
msgstr ""
"(ቀድሞ የነበሩ የግLOBAL ሪዳይሬክት "
"ባህሪያት)"

msgid "Allow redirections on admin paths."
msgstr ""
"አስተዳዳሪ (admin) መንገዶች ላይ ወደ ሌሎች "
"ገጾች ማዞሪያዎች (redirections) እንዲፈቀዱ "
"ፍቀድ።"

msgid "Last accessed"
msgstr "መጨረሻ ተደራሽ የተደረገበት ቀን/ሰዓት"

msgid "Filter 404s"
msgstr "404-ዎችን ማጣራት"

msgid "Fix 404 pages"
msgstr "404 ማግኘት ያልቻሉ ገፆችን ያስተካክሉ"

msgid "Add redirects for 404 pages."
msgstr "ለ404 ገጾች መቀያየር (redirects) ያክሉ።"

msgid "Fix 404 pages with URL redirects"
msgstr ""
"404 ማግኘት የማይቻል ገጾችን የURL ወደኋላ "
"(redirect) በመጠቀም ያስተካክሉ"

msgid "Allows users to redirect from old URLs to new URLs."
msgstr ""
"Օգտատերերին հնարավորություն է տալիս "
"հին URL-ներից նոր URL-ներ ուղղորդել "
"(redirect)։"

msgid "Redirect ID"
msgstr "የዳግመ-መለያ መታወቂያ (Redirect ID)"

msgid "Redirect type"
msgstr "የማዞሪያ ዓይነት"

msgid "Hash"
msgstr "ሃሽ (Hash)"

msgid "Redirect module form elements"
msgstr "የሪዳይሬክት ሞጁል ቅጽ አካላት"

msgid "Domain redirects"
msgstr "የዶሜይን መልሶ መመለሻዎች"

msgid "From domain"
msgstr "ከዶሜይን"

msgid "Add URL redirect"
msgstr "URL ወደ ሌላ ገጽ መልክት (redirect) ያክሉ"

msgid "URL Redirects"
msgstr "የURL አቅጣጫ መቀየሪያዎች"

msgid "Redirect settings"
msgstr "የማዞሪያ ማሰናጃዎች"

msgid "Redirect 404"
msgstr "404 ማዞሪያ"

msgid "The user ID of the node author."
msgstr "የኖድ ደራሲ (author) ተጠቃሚ ID።"

msgid "Pages to ignore"
msgstr "እንዳይታለፉ የሚወጡ ገጾች"

msgid "Last Used"
msgstr "የመጨረሻ ጊዜ የተጠቀመበት"

msgid "The record UUID."
msgstr "የመዝገቡ UUID።"

msgid "Edit URL redirect"
msgstr "የ URL ወደ መቀየሪያ አርትዕ ያድርጉ"

msgid "Delete URL redirect"
msgstr "የURL ማዞሪያ (redirect) ሰርዝ"

msgid "Redirect Source formatter"
msgstr "የማስተናገጃ ምንጭ ፎርማተር"

msgid "The redirect ID."
msgstr "የውሸት መቀየሪያ መታወቂያው።"

msgid "The redirect hash."
msgstr "የመቀየሪያው ሃሽ (hash)።"

msgid "The redirect type."
msgstr "የማስተናገጃው አይነት።"

msgid "The redirect language."
msgstr "የወደድ (redirect) ቋንቋው።"

msgid "The redirect status code."
msgstr "የመልሶ ማዞሪያ ሁኔታ ኮዱ።"

msgid "The date when the redirect was created."
msgstr ""
"ወደ አስተላላፊው (redirect) መቼ እንደተፈጠረ "
"ያለው ቀን።"

msgid "The redirect %redirect has been deleted."
msgstr "የማዞሪያው %redirect ተሰርዟል።"

msgid "It is not allowed to create a redirect from the front page."
msgstr ""
"ከመጀመሪያ ገጹ (front page) ላይ ለማዞር (redirect) "
"መፍጠር አይፈቀድም።"

msgid "The anchor fragments are not allowed."
msgstr ""
"መግለጫ መቆለፊያ ክፍሎች (anchor fragments) "
"አልተፈቀዱም።"

msgid "The url to redirect from should not start with a forward slash (/)."
msgstr ""
"ወደማስተላለፍ (redirect) ሊያደርግ የሚገባው "
"ዩአርኤል ከፊት ከተሰጠ ባለስክረት (/) ጋር "
"መጀመር አይገባው።"

msgid "Global redirects"
msgstr "ዓለምአቀፍ አስተካካዮች (Redirects)"

msgid "Check access to the redirected page"
msgstr ""
"ወደተቀየረው ገጽ መድረስ ያለበትን ፍቃድ "
"ያረጋግጡ"

msgid ""
"This helps to stop redirection on protected pages and avoids giving "
"away <em>secret</em> URL's. <strong>By default this feature is "
"disabled to avoid any unexpected behavior</strong>"
msgstr ""
"ይህ በጠበቁ ገፆች ላይ ማዞር (redirection) "
"እንዲቆም ይረዳል እንዲሁም <em>ሚስጥር</em> "
"የሆኑ ዩአርኤሎችን "
"እንዳትገልጥ/እንዳትበቃ ያስባል። "
"<strong>በነባሪነት ይህ ባህሪ የተቋረጠ (disabled) "
"ሆኖ ይቀርባል ምክንያቱም የማይጠበቁ "
"ባህሪዎች እንዳይፈጠሩ</strong>"

msgid "Redirect Source"
msgstr "የማዞሪያ ምንጭ"

msgid "Redirect source"
msgstr "የማዞር ምንጭ"

msgid "Stores a redirect source"
msgstr "የማዞር ምንጭ ያቆያል"

msgid ""
"The Redirect module allows users to redirect from old URLs to new "
"URLs.   For more information, see the <a href=\":online\">online "
"documentation for Redirect</a>."
msgstr ""
"የ Redirect ሞጁሉ ተጠቃሚዎች ከድሮ ዩአርኤሎች "
"ወደ አዳዲስ ዩአርኤሎች እንዲያዞሩ (redirect) "
"ይፈቅዳል። ለተጨማሪ መረጃ <a href=\":online\">ለ "
"Redirect የኦንላይን ሰነዶች</a>ን ይመልከቱ።"

msgid ""
"Redirect is accessed from three tabs that help you manage <a "
"href=\":list\">URL Redirects</a>."
msgstr ""
"የሬዳይሬክቱ መዳረሻ ከሶስት ትሮች "
"በመግባት ይቻላል፣ እነዚህም <a href=\":list\">URL "
"Redirects</a> እንዲተዳደሩ ይረዱዎታል።"

msgid "Manage URL Redirects"
msgstr "የURL ወደኋላ (Redirects) መተካትን ያስተዳድሩ"

msgid ""
"The <a href=\":redirect\">\"URL Redirects\"</a> page is used to setup "
"and manage URL Redirects.  New redirects are created here using the <a "
"href=\":add_form\">Add redirect</a> button which presents a form to "
"simplify the creation of redirects . The URL redirects page provides a "
"list of all redirects on the site and allows you to edit them."
msgstr ""
"የ <a href=\":redirect\">\"URL Redirects\"</a> ገጹ የURL "
"ሪዳይሬክቶች (Redirects) ለማዋቀር እና "
"ለመቆጣጠር ይጠቅማል። አዲስ ሪዳይሬክቶች "
"በ <a href=\":add_form\">Add redirect</a> ቁልፍ በመጠቀም "
"በዚህ ይፈጠራሉ፤ ይህ ቁልፍ ሪዳይሬክቶችን "
"ለመፍጠር የሚያቀላጥፍ ፎርም ያቀርባል። "
"የURL ሪዳይሬክቶች ገጹ በጣቢያው ላይ ያሉ "
"ሁሉንም ሪዳይሬክቶች ዝርዝር ይሰጣል እና "
"እንዲያርሙ ያስችልዎታል።"

msgid ""
"<a href=\":fix_404\">\"Fix 404 pages\"</a> lists all paths that have "
"resulted in 404 errors and do not yet have any redirects assigned to "
"them. This 404 (or Not Found) error message is an HTTP standard "
"response code indicating that the client was able to communicate with "
"a given server, but the server could not find what was requested."
msgstr ""
"<a href=\":fix_404\">\"404 ገጾችን አስተካክል\"</a> "
"እስካሁን ምንም ማዞሪያ (redirect) "
"ያልተመደበላቸው 404 ስህተቶች ያስከተሉ "
"ሁሉንም መንገዶች (paths) ይዘረዝራል። ይህ 404 "
"(ወይም Not Found) ስህተት መልእክት የHTTP "
"መደበኛ ምላሽ ኮድ ሲሆን፣ ደንበኛው (client) "
"ከተቀየረው አገልጋይ (server) ጋር መገናኘት "
"መቻሉን ያሳያል፤ ነገር ግን አገልጋዩ "
"የተጠየቀውን ነገር ማግኘት አልቻለም ማለት "
"ነው።"

msgid ""
"404 (or Not Found) error message is an HTTP standard response code "
"indicating that the client was able to communicate with a given "
"server, but the server could not find what was requested. Please "
"install the <a href=\":extend\">Redirect 404</a> submodule to be able "
"to log all paths that have resulted in 404 errors."
msgstr ""
"የ404 (ወይም Not Found) ስህተት መልእክት የHTTP "
"መደበኛ ምላሽ ኮድ ነው፤ ይህም ደንበኛው "
"(client) ከተገቢው ሰርቨር ጋር መገናኘት ቻለ "
"ነገር ግን ሰርቨሩ የተጠየቀውን ነገር "
"መፈለግ አልቻለም ማለት ነው። 404 ስህተቶች "
"ውጤት የሆኑ ሁሉንም መንገዶች (paths) "
"ለማስመዝገብ እባክዎ <a href=\":extend\">Redirect "
"404</a> ንዑስ-ሞዱል (submodule) ይጫኑ።"

msgid "Configure Global Redirects"
msgstr "Глобал Redirects ቅንብር ያድርጉ"

msgid ""
"The <a href=\":settings\">\"Settings\"</a> page presents you with a "
"number of means to adjust redirect settings."
msgstr ""
"የ <a href=\":settings\">\"Settings\"</a> ገጹ የመቀየር "
"(redirect) ቅንብሮችን ለማስተካከል ብዙ "
"መንገዶችን ያቀርብልዎታል።"

msgid "Delete redirect configuration"
msgstr "የመልሶ ማዞሪያ ማዋቀርን ሰርዝ"

msgid "Redirect bulk form"
msgstr "የብዛት ማዞሪያ ቅፅ"

msgid "Overview for 404 error paths with no redirect assigned yet."
msgstr ""
"ለ404 ስህተት መንገዶች ላይ እስካሁን "
"ማዞሪያ (redirect) ያልተመደበ ማጠቃለያ።"

msgid "The path of the request."
msgstr "የጥያቄው መንገድ።"

msgid "The language of this request."
msgstr "የዚህ ጥያቄ ቋንቋ።"

msgid "The number of requests with that path and language."
msgstr ""
"የዚያን መንገድና ቋንቋ የሚያሳይ ጥያቄዎች "
"ብዛት።"

msgid "The timestamp of the last request with that path and language."
msgstr ""
"በዚያ መንገድ እና ቋንቋ የተደረገው "
"የመጨረሻ ጥያቄ ሰዓት-ማህተም (timestamp)።"

msgid "Whether or not this path has a redirect assigned."
msgstr ""
"ይህ መንገድ መልሶ መመለሻ (redirect) "
"የተመደበለት አለመሆኑን መለየት።"

msgid "Provide operation buttons to handle the 404 path."
msgstr ""
"404 መንገዱን ለመቆጣጠር የክወና ቁልፎችን "
"ይስጡ።"

msgid "404 error database logs to keep"
msgstr ""
"404 የስህተት መዝገቦች የሚጠብቁ (database logs to "
"keep)"

msgid ""
"The maximum number of 404 error logs to keep in the database log. "
"Requires a <a href=\":cron\">cron maintenance task</a>."
msgstr ""
"የተጠቃሚ ምዝገባ (database log) ውስጥ ለመቆየት "
"የሚፈቀድ ከፍተኛው የ404 ስህተት ሎጎች "
"ብዛት። <a href=\":cron\">cron የጥገና ተግባር</a> "
"ያስፈልጋል።"

msgid ""
"Logs 404 errors and allows users to create redirects for often "
"requested but missing pages."
msgstr ""
"404 ስህተቶችን መመዝገብ እና ብዙ ጊዜ "
"የሚፈለጉ ግን የሌሉ ገጾችን ለመልካት "
"ተጠቃሚዎች ማዞሪያዎች (redirects) እንዲፈጥሩ "
"ያስችላል።"

msgid "404 error database logging settings."
msgstr ""
"۴۰၄ ስህተት የውሂብ ጎታ መመዝገብ "
"ቅንብሮች።"

msgid "404 error database logs to keep."
msgstr ""
"404 ስህተት—ለመቀመጥ የሚያስፈልጉ "
"የዳታቤዝ መዝገቦች።"

msgid "Redirect 404 operations"
msgstr "ወደ 404 የሚያዞሩ ክዋኔዎች"

msgid ""
"Resolved the path %path in the database. Please check the ignored list "
"and save the settings."
msgstr ""
"ስርዓተ-መንገዱን %path በዳታቤዝ ውስጥ "
"መፍታት ተሳክቷል። እባክዎ በተተው ዝርዝር "
"(ignored list) ይመልከቱ እና ቅንጅቶቹን "
"ያስቀምጡ።"

msgid "Undefined @langcode"
msgstr "ያልተወሰነ @langcode"

msgid "There are no 404 errors to fix."
msgstr "የማስተካከል 404 ስህተቶች የሉም።"

msgid "Deleted @count redirects."
msgstr "@count ማዘዞች ተሰርዘዋል።"

msgid "Are you sure you want to delete this redirect?"
msgid_plural "Are you sure you want to delete these redirects?"
msgstr[0] ""
"ይህን ማስተላለፊያ (redirect) ማጥፋት "
"እርግጠኛ ነዎት? ይህን በርካታ "
"ማስተላለፊያዎች (redirects) ማጥፋት እርግጠኛ "
"ነዎት?"

msgid "Deleted 1 redirect."
msgid_plural "Deleted @count redirects."
msgstr[0] ""
"1 ማስተላለፊያ (redirect) ተሰርዟል። @count "
"ማስተላለፊያዎች ተሰርዘዋል።"

msgid "Source Options"
msgstr "የምንጭ አማራጮች"

msgid "Redirect Options"
msgstr "የማስተናገጃ አማራጮች"

msgid "Enforce clean and canonical URLs."
msgstr ""
"ንፁህ እና መደበኛ (canonical) ዩአርኤሎችን "
"ያስገድዱ።"

msgid "Administer individual URL redirections"
msgstr ""
"የግለሰብ ዩአርኤል ማዞሪያዎችን "
"ያስተዳድሩ"

msgid "Administer global URL redirection settings"
msgstr ""
"የአጠቃላይ URL ወደ ሌላ አድራሻ "
"ማስተላለፊያ (redirect) ውቅሮችን አስተዳድር"

msgid "Suppress 'page not found' log messages"
msgstr ""
"የ«ገጽ አልተገኘም» መዝገብ መልዕክቶችን "
"አግድ"

msgid ""
"Prevents logging 'page not found' events. Can be safely enabled when "
"redirect_404 module is used, which stores them separately, nothing "
"else relies on those messages."
msgstr ""
"«page not found» የሚሉ ክስተቶችን ለመመዝገብ "
"ይከላከላል። redirect_404 ሞጁሉ ሲጠቀም በደህና "
"መንቃት ይቻላል—እነዚያን በተለየ መዝገብ "
"ውስጥ ያከማቻሉ፤ ከዚያ በላይ ሌላ ነገር "
"በእነዚያ መልዕክቶች ላይ አይመሰረትም።"

msgid "Whether to log 'page not found' messages to the standard log or not."
msgstr ""
"«ገጽ አልተገኘም» መልእክቶችን ወደ "
"መደበኛ ሎግ መመዝገብ ወይም አለመመዝገብ "
"እንደምን።"

msgid "The Redirect domain module allows users to redirect between domains."
msgstr ""
"የ Redirect domain ሞጁሉል ተጠቃሚዎች በማንኛውም "
"የድር ዶሜይኖች መካከል እንዲያደርጉ "
"(redirect) ያስችላል።"

msgid "Manage domain redirects"
msgstr "የዶሜይን ወደ-ማዞሪያዎችን ያስተዳድሩ"

msgid ""
"The domain redirect is accessed through <a href=\":domainlist\">Domain "
"Redirects</a>. The user can add the domain redirects through the "
"domain redirect table which consists of the domain from which it needs "
"to be redirected, the sub path and the complete url destination to "
"which it needs to be redirected. The module also supports the usage of "
"a wildcard redirecting, thus many requests can be handled with one "
"instance of domain redirect."
msgstr ""
"የዶሜይን ማዞር (redirect) ወደ <a "
"href=\":domainlist\">Domain Redirects</a> በመግባት "
"ይደረሳል። ተጠቃሚው የዶሜይን ማዞሮችን "
"በዶሜይን ማዞር ሰንጠረዥ በኩል ማከል "
"ይችላል፤ ይህ ሰንጠረዥ ማዞር የሚፈለግበት "
"ዶሜይን፣ የሚከተለው (sub path) እና ወደት "
"መላክ የሚያስፈልገው ሙሉ ዩአርኤል መዳረሻ "
"(destination) ያካትታል። ሞጁሉ (module) እንዲሁም "
"የ wildcard ማዞር አጠቃቀምን ይደግፋል፤ "
"ስለዚህ ብዙ ጥያቄዎች በአንድ የdomain redirect "
"ነገር ብቻ ሊታከሙ ይችላሉ።"

msgid ""
"The domain redirect table consists of the domain from which it needs "
"to be redirected, the sub path and the complete url destination to "
"which it needs to be redirected."
msgstr ""
"የዶሜይን ማዞሪያ ሰንጠረዥ (domain redirect table) "
"የሚያጠቃልለው ማዞር የሚያስፈልገው "
"ዶሜይን፣ ንዑስ መንገዱ (sub path) እና "
"ወደሚያዞርበት የተሟላ ዩአርኤል (complete url "
"destination) ነው።"

msgid "Example Configuration"
msgstr "የምሳሌ ውቅር"

msgid "Example Redirects"
msgstr "ምሳሌ ማዞርዎች"

msgid "Request: example.com/redirect => Response: redirected.com/example-path"
msgstr ""
"ጥያቄ፡ example.com/redirect => መልስ፡ "
"redirected.com/example-path ተዛውሯል"

msgid "Request: foo.com/any-path => Response: bar.com"
msgstr "ጥያቄ፦ foo.com/any-path ወደ ምላሽ፦ bar.com"

msgid "Redirect Domain"
msgstr "የማዞሪያ ዶሜይን"

msgid "Allows users to redirect between domains."
msgstr ""
"အသုံးပြုသူများကို "
"ဒိုမိန်းများအကြားသို့ "
"ပြန်ညွှန်း (redirect) "
"ပြုလုပ်နိုင်စေသည်။"

msgid "Redirect domains"
msgstr "የዳግም ማዞሪያ ዶሜይኖች"

msgid "Sub path"
msgstr "ఉপ-మාර්్గం"

msgid "No protocol should be included in the redirect domain."
msgstr ""
"የዳግም መመለሻ ዶሜይን (redirect domain) ውስጥ "
"ምንም ፕሮቶኮል መካተት የለበትም።"

msgid "The domain redirects have been saved."
msgstr "የዶሜይን መለወጫዎች ተቀምጠዋል።"

msgid "Note: links open in the current window."
msgstr ""
"ማሳሰቢያ፡ ሊንኮች በአሁኑ መስኮት ውስጥ "
"ይከፈታሉ።"

msgid "- All languages -"
msgstr "- ሁሉም ቋንቋዎች -"

msgid "Ignore redirections on admin paths."
msgstr ""
"አስተዳደር መንገዶች (admin paths) ላይ "
"የሚደረጉ ማዞሪያዎችን (redirections) ችላ በል።"

msgid ""
"Enabling this will automatically redirect to the canonical URL of any "
"page. That includes redirecting to an alias if existing, removing "
"trailing slashes, ensure the language prefix is set and similar "
"clean-up."
msgstr ""
"ይህን ማንቃት በራስ ሰር ለማንኛውም ገጽ "
"ወደ ካኖኒካል ዩአርኤል (canonical URL) "
"እንዲያዞር ያደርጋል። ይህ ከአስቀድሞ "
"የተኖረ አሊያስ ካለ ወደ አሊያሱ ማዞር፣ "
"መጨረሻ ላይ ያሉ ተጨማሪ ቁምፊዎች (trailing "
"slashes) ማስወገድ፣ የቋንቋ ቅድመ ስም (language "
"prefix) መቀናበሩን ማረጋገጥ እና እንደዚሁ "
"ያሉ ማጽዳቶችን ይጨምራል።"

msgid "Daily count"
msgstr "የየቀኑ ብዛት"

msgid "The number of requests with that path and language in a day."
msgstr ""
"በዚያ መንገድ (path) እና ቋንቋ ላይ በአንድ "
"ቀን ውስጥ የሚደረጉ ጥያቄዎች (requests) "
"ብዛት።"

msgid "Redirect loop identified at %path for redirect %rid"
msgstr ""
"በ %path ላይ ለማዛወር  %rid የRedirect ሉፕ "
"(የመዞር ተደጋጋሚ ችግኝ) ተገτοታ "
"ተገኝቷል።"

msgid "Precedence"
msgstr "ቅድሚያ መርሃ ግብር"

msgid ""
"Top-down precedence is used. This means the first matching redirect "
"that is found will be taken. For example, assume these redirect rules:"
msgstr ""
"ላይ-ከታች (top-down) ቅድሚያ ተግባራዊ "
"ይሆናል። ይህም ማለት የሚዛመደውን "
"ማስተናገጃ (redirect) ደንብ ከሚገኝበት "
"መጀመሪያ ጊዜ ጀምሮ ያገኘው ደንብ "
"ይወሰዳል ማለት ነው። ለምሳሌ፣ እነዚህ "
"የማስተናገጃ (redirect) ደንቦችን እንዳስቡ፦"

msgid "The following redirects would actually occur:"
msgstr ""
"የሚከተሉት ማዞሪያዎች ትክክል ተፈጻሚ "
"የሚሆኑት፦"

msgid "Clear all 404 log entries"
msgstr "ሁሉንም የ404 መዝገቦች ሰርዝ"

msgid "Priority"
msgstr "ቅድሚያ"

msgid "default"
msgstr "ትውረ-ነባር"

msgid "Custom links"
msgstr "ብጁ (Custom) ሊንኮች"

msgid "Submission URL"
msgstr "የንብት ዩአርኤል (Submission URL)"

msgid "Search engine"
msgstr "የፍለጊያ ሞተር"

