msgstr "የመስመር መቋረጫዎችን ወደ HTML ቀይር"

msgid "Sticky status"
msgstr "የተለጠፈ ሁኔታ"

msgid "RSS category"
msgstr "RSS ምድብ"

msgid "RSS enclosure"
msgstr "RSS ኢንክሎዘር"

