msgstr "የራስዎን ዌብፎርም ሰርዝ"

msgid "Edit CSS/JS webform assets"
msgstr "CSS/JS የዌብፎርም ንብረቶችን አስተካክል"

msgid ""
"Allows administrators to attach custom CSS and JavaScript to a "
"webform."
msgstr ""
"አስተዳዳሪዎች ወደ ድር ፎርም ተጨማሪ "
"ልማዳዊ CSS እና JavaScript እንዲያያይዙ "
"ያስችላል።"

msgid "Duplicate webform"
msgstr "ድር ቅጹን እንደገና ቅጂ ማባዛት"

msgid "Delete webform"
msgstr "የዌብፎርም ሰርዝ"

msgid "Webforms: Options"
msgstr "የድህረ ቅጾች (Webforms): አማራጮች"

msgid "Add webform options"
msgstr "የዌብፎርም አማራጮች ጨምር"

msgid "Delete webform options"
msgstr "የድረ-ፎርም አማራጮችን ሰርዝ"

msgid "Delete webform submission"
msgstr "የድር ፎርም ማስገባትን ሰርዝ"

msgid "Add webform handler"
msgstr "የዌብፎርም ሃንድለር ጨምር"

msgid "Edit webform handler"
msgstr "የዌብፎርም አስተናጋጅ አርትዕ කරන්න"

msgid "Delete webform handler"
msgstr "የድር ፎርም ስራ አስኪያጅ (webform handler) ሰርዝ"

msgid "Protect all webforms with Honeypot"
msgstr "ሁሉንም የድር ቅጾች በ Honeypot ይጠብቁ"

msgid "Add time limit to all webforms"
msgstr "ሁሉንም ዌብፎርሞች ላይ የጊዜ ገደብ ጨምር"

msgid "Webform default settings"
msgstr "የWebform ነባሪ መቼቶች"

msgid "Display back to webform link."
msgstr "የድር ፎርም ሊንኩን እንደገና አሳይ።"

msgid "Webforms block"
msgstr "ዌብፎርሞች ብሎክ"

msgid "Default webform submission data"
msgstr "የነባር የድር ፎርም ማስገባት ውሂብ"

msgid "Display the referenced webform as a link."
msgstr ""
"የተጠቀሰውን ድር ፎርም እንደ ሊንክ "
"(አገናኝ) አሳይ።"

msgid "Choose a webform to export submissions from."
msgstr ""
"ከውሂብ ጥያቄዎች (submissions) ለመላክ "
"የሚፈልጉትን የድር ፎርም (webform) ይምረጡ።"

msgid "Choose a webform to purge submissions from."
msgstr ""
"ከስር የቀረቡ ማስገቢያዎችን ለመሰረዝ "
"(purge) የሚያገለግል የድረ-ገጽ ፎርም (webform) "
"ይምረጡ።"

msgid "Are you sure you want to delete all submissions from '@title' webform?"
msgstr ""
"'@title' ዌብፎርም ውስጥ ያሉትን ሁሉንም "
"ማቅረቦች ለማጥፋት እርግጠኛ ነዎት?"

msgid ""
"Are you sure you want repair the Webform module's admin settings and "
"webforms?"
msgstr ""
"የWebform ሞጁሉ የአስተዳደር ቅንብሮች እና "
"ዌብፎርሞችን መጠገን እርግጠኛ ነዎት?"

msgid "Webform id required"
msgstr "የዌብፎርም መታወቂያ (ID) ያስፈልጋል"

msgid "Webform @id not recognized."
msgstr "የ Webform @id አይታወቅም።"

msgid "Webform Devel"
msgstr "ዌብፌርም ዴቬል"

msgid "Provides development tools for the Webform module."
msgstr ""
"የ Webform ሞጁሉ ለማቀናበር የሚያገለግሉ "
"የልማት መሳሪያዎችን ይሰጣል።"

msgid "Debug webform submission."
msgstr ""
"የዌብፎርም ግብአት (submission) ማረም (Debug) "
"አድርግ።"

msgid "Webform Examples"
msgstr "የWebform ምሳሌዎች"

msgid "Webform UI"
msgstr "የዌብፎርም ተጠቃሚ መገናኛ"

msgid "Please add elements to this webform."
msgstr ""
"ദയකරിച്ച് ይህን የዌብፎርም ውስጥ "
"አካላት (elements) ያክሉ።"

msgid "The value of the webform element."
msgstr "የዌብፎርም ኤለመንት ዋጋ።"

msgid "Enter custom CSS to be attached to the webform."
msgstr ""
"የድረ-ገጹ ፎርሙ (webform) ጋር ለማያያዝ ብጁ "
"ሲኤስኤስ አስገባ።"

msgid "Enter custom JavaScript to be attached to the webform."
msgstr ""
"የድረ-ገጹ ቅጹ (webform) ጋር ለማያያዝ የተለየ "
"ጃቫስկրipt (JavaScript) አስገባ።"

msgid ""
"<a href=\":href\">Delete this individual element</a> using the webform "
"UI."
msgstr ""
"<a href=\":href\">በዌብፎርም ዩአይ በመጠቀም "
"ይህን ግለሰባዊ ክፍል ሰርዝ</a>።"

msgid ""
"If unchecked, this webform must be attached to a <a "
"href=\":node_href\">node</a> or a <a href=\":block_href\">block</a> to "
"receive submissions."
msgstr ""
"ካልተፈተሸ ይህ ዌብፎርም አስገባዎችን "
"ለመቀበል ከ <a href=\":node_href\">ኖድ</a> ወይም ከ <a "
"href=\":block_href\">ብሎክ</a> ጋር መከፈል አለበት።"

msgid "Webform URL alias"
msgstr "የዌብፎርም ዩአርኤል አሊያስ"

msgid "Webform status"
msgstr "የዌብፎርም ሁኔታ"

msgid "Disable back button for all webforms"
msgstr ""
"ለሁሉም ድር ቅጾች የጀርባ ቁልፍን "
"አሰናክል"

msgid "Add a page for previewing the webform before submitting."
msgstr ""
"സമర్పት ከመቀጠሉ በፊት የዌብፎርሙን "
"ለማስቀድም እይታ የሚያስችል ገጽ ያክሉ።"

msgid ""
"A message to be displayed when authenticated users try to access a "
"confidential webform."
msgstr ""
"ይህ የሚታይ መልዕክት የውስጥ ምስጢራዊ "
"የድር ፎርም (webform) ላይ የማረጋገጡ "
"ተጠቃሚዎች ሲደርሱ ሲሞክሩ ይታያል።"

msgid "Display back to webform link"
msgstr "ወደ ዌብፎርም ሊንኩ መመለሻ አሳይ"

msgid "Webform options"
msgstr "ዌብፎርም አማራጮች"

msgid "The ID of the webform submission entity."
msgstr ""
"የድር ፎርሙ መግቢያ (submission) እኩልነት "
"መታወቂያው (ID)።"

msgid "The IP address of the user that submitted the webform."
msgstr ""
"వեբফორმውን ያስገባው ተጠቃሚ የIP "
"አድራሻ።"

msgid "The associated webform."
msgstr "የተያያዘው የድር ፎርም (webform)።"

msgid ""
"The ID of the entity of which this webform submission was submitted "
"from."
msgstr ""
"ይህ የዌብፎርም ማስገባት የተላከበት ንጥል "
"(entity) መታወቂያ (ID)።"

msgid "Default base path for webform URLs"
msgstr ""
"የድረ-ገጽ ዌብፎርም ዩአርኤሎች የነባር "
"መሰረታዊ መንገድ"

msgid "Filter webforms"
msgstr "የድር ቅጾችን ማጣሪያ"

msgid "The webform handler %name has been deleted."
msgstr "የዌብፎርም እንክር (handler) %name ተሰርዟል።"

msgid ""
"If checked, the above settings will be used as the default "
"configuration for all associated Webform nodes."
msgstr ""
"ካረጋገጠ (checked) ከሆነ፣ ከላይ ያሉት "
"ቅንብሮች ለሁሉም ተያያዥ ዌብፎርም ኖዶች "
"እንደ ነባሪ ውቅር (default configuration) "
"ይውሰዳሉ።"

msgid ""
"Please note that no emails will be sent while generating webform "
"submissions."
msgstr ""
"ദയവായി ശ്രദ്ധിക്കുക: "
"വെബ്ഫോം സമർപ്പണങ്ങൾ "
"സൃഷ്ടിക്കുമ്പോൾ യാതൊരു "
"ഇമെയിലും അയക്കപ്പെടില്ല."

msgid "Restrict submissions to these webforms."
msgstr ""
"እነዚህን የድር ቅጾች (webforms) ብቻ "
"ለማስገባት ውሱን ያድርጉ።"

msgid "Invalid webform name: @name"
msgstr "የድር ቅጽ ስም ልክ አይደለም፦ @name"

msgid ""
"Generate a given number of webform submissions. Optionally delete "
"current submissions."
msgstr ""
"നിർദ്ദിഷ്ട എണ്ണത്തിലുള്ള "
"വെബ്‌ഫോം സമർപ്പണങ്ങൾ "
"സൃഷ്ടിക്കുക. "
"ആവശ്യമെങ്കിൽ നിലവിലെ "
"സമർപ്പണങ്ങൾ "
"ഇല്ലാതാക്കുകയും ചെയ്യാം."

msgid "Display link to the referenced webform."
msgstr ""
"ከተጠቀሰው ድህረ ገጽ ቅጽ (webform) ጋር "
"የሚያገናኝ ሊንክ አሳይ።"

msgid "Enter custom HTML into your webform."
msgstr ""
"የእርስዎን የተበጁ HTML በዌብፎርሙ ውስጥ "
"ያስገቡ።"

msgid ""
"This is the delimiter used in the CSV/TSV file when downloading "
"webform results. Using tabs in the export is the most reliable method "
"for preserving non-latin characters. You may want to change this to "
"another character depending on the program with which you anticipate "
"importing results."
msgstr ""
"ይህ ለ CSV/TSV ፋይል ውስጥ የዌብፎርም "
"ውጤቶችን ሲያወርዱ (download) የሚጠቀሙት ልዩ "
"መለያ/ዲሊሚተር ነው። በላክ (export) ላይ ታብ "
"(tabs) መጠቀም የላቲን ካልሆኑ ባህርያትን "
"ለመጠበቅ በጣም እርግጠኛው ዘዴ ነው። "
"ውጤቶቹን ለማስመጣት እርስዎ "
"እንደሚጠብቁበት ፕሮግራም ላይ ተመስርቶ "
"ይህን ወደሌላ ባህርይ ሊቀይሩት ይችላሉ።"

msgid "Broken/missing webform handler plugin."
msgstr ""
"የተበላሸ/የጠፋ የድር ፎርም እንክብካቤ "
"ፕለጊን።"

msgid "@form webform sent @title email."
msgstr ""
"@form የ webform መልእክት በተላከ @title ኢሜይል "
"ላይ።"

msgid "Sends a webform submission via an email."
msgstr ""
"ኢሜይል በመላክ የድር ፎርም  സമରትን "
"ይልካል።"

msgid ""
"Mitigate SPAM webform submissions using the <a "
"href=\":href_honeypot\">honeypot</a> method."
msgstr ""
"የ<a href=\":href_honeypot\">honeypot</a> ዘዴን በመጠቀም "
"የဝੈብፎርም ጥያቄዎችን በማስግባት "
"የሚፈጠር ስፓም እንዳይቀንስ ያድርጉ።"

msgid ""
"<a href=\":href_honeypot\">Honeypot protection</a> is enabled for all "
"webforms."
msgstr ""
"<a href=\":href_honeypot\">የՀoneypot ጥበቃ</a> ለሁሉም "
"ዌብፎርሞች እንዲነቃ ተደርጓል።"

msgid ""
"<a href=\":href_webform\">Honeypot protection</a> is enabled for all "
"webforms."
msgstr ""
"<a href=\":href_webform\">ሆኒፖት ጥበቃ</a> ለሁሉም "
"የድር ቅጾች (webforms) ተችሏል።"

msgid ""
"<a href=\":href_honeypot\">Time limit</a> is disabled for all "
"webforms."
msgstr ""
"<a href=\":href_honeypot\">የጊዜ ገደብ</a> ለሁሉም "
"ድረ-ቅጾች ተሰናክሏል።"

msgid "<a href=\":href_webform\">Time limit</a> is enabled for all webforms."
msgstr ""
"<a href=\":href_webform\">የጊዜ ገደብ</a> ሁሉም "
"ዌብፎርሞች ላይ ተቀምጧል።"

msgid "all webforms"
msgstr "ሁሉም የዌብፎርሞች"

msgid "@label webform"
msgstr "@label ዌብፎርም"

msgid "Unable to display this webform. Please contact the site administrator."
msgstr ""
"ይህን የድር ፎርም ማሳየት አልተቻለም። "
"እባክዎ የጣቢያውን አስተዳዳሪ ያነጋግሩ።"

msgid "New submission added to [webform:title]."
msgstr ""
"በ [webform:title] ላይ አዲስ ማስገባት "
"ተጨምሯል።"

msgid "A registration webform template."
msgstr ""
"የተመዝገቢያ ዌብፎርም ናሙና ቅንብር "
"(template)።"

msgid "A session evaluation webform template."
msgstr "የስብሰባ ግምገማ ድር ፎርም ንድፍ (template)።"

msgid "Submission values"
msgstr "የግብ እሴቶች"

msgid ""
"The 'format' can be 'value', 'raw', or custom format specifically "
"associated with the element"
msgstr ""
"‘format’ የሚሆነው ‘value’ ወይም ‘raw’ ወይም "
"በተወሰነ አካል ጋር በተያያዘ የራሱ ልዩ "
"ቅርጸ-ቀመር (custom format) ሊሆን ይችላል።"

msgid "Item value"
msgstr "ንጥል ዋጋ"

msgid "Autocomplete values"
msgstr "የራስሰር ሙሌት ዋጋዎች"

msgid "Message close effect"
msgstr "የመልዕክት መዝጊያ ውጤት"

msgid "Message storage"
msgstr "የመልዕክት ማከማቻ"

msgid ""
"Unique ID used to store the message's closed state. Please enter only "
"lower-case letters, numbers, dashes, and underscores."
msgstr ""
"መልእክቱ የተዘጋ ሁኔታ ለማከማቸት "
"የሚያገለግል የልዩ መታወቂያ መለያ። "
"ദእባክዎ ዝቅተኛ ፊደሎች፣ ቁጥሮች፣ "
"መስመር መካከል (dashes) እና መስመር ስር "
"(underscores) ብቻ ያስገቡ።"

msgid "Submission data"
msgstr "የግብዓት መረጃ"

msgid "No response. Please see the recent log messages."
msgstr ""
"ምላሽ አልተሰጠም። እባክዎ የቅርብ "
"የመዝገብ መልዕክቶችን ይመልከቱ።"

msgid "Tokens related to webform submission."
msgstr ""
"የዌብፎርም ማስገቢያ (submission) ጋር ተያያዥ "
"ቶከኖች።"

msgid ""
"For example, to display the Contact webform's 'Subject' element's "
"value you would use the [webform_submission:values:subject] token."
msgstr ""
"ለምሳሌ፣ የ«Contact» የድር ቅጽ (webform) "
"የ«Subject» ክፍሉ ዋጋ ለማሳየት የሚጠቀሙት "
"ቶከን [webform_submission:values:subject] ነው።"

msgid "The source entity that the webform submission was submitted from."
msgstr ""
"ከየትኛው ምልክት (source entity) የዌብፎርም "
"ማስገቢያ (webform submission) እንደቀረበ "
"ያመለክታል።"

msgid "The URL of the webform."
msgstr "የዌብፎርሙ ዩአርኤል።"

msgid "Resets Webform user data and saved state for messages"
msgstr ""
"የዌብፎርም የተጠቃሚ መረጃን እና "
"ለመልእክቶች የተቀመጠውን የሁኔታ ሁኔታ "
"እንደገና ያስጀምራል።"

msgid "Webform development commands"
msgstr "የዌብፎርም ልማት ትዕዛዞች"

msgid "Developer specific commands for the Webform module."
msgstr ""
"د ویبフォーム ماډل لپاره د پراختیاګر "
"ځانګړي امرونه."

msgid ""
"Are you sure you want reset the Webform module's user data and saved "
"state?"
msgstr ""
"የ Webform ሞጁሉ የተጠቃሚ ውሂብ እና የተቀመጠ "
"ሁኔታ (state) ለመመለስ እርግጠኛ ነዎት?"

msgid "Edit webform source code"
msgstr "የዌብፎርም ምንጭ ኮድ አርትዕ ያድርጉ"

msgid ""
"The selected elements will be included in the "
"[webform_submission:values] token. Individual values may still be "
"printed if explicitly specified as a [webform_submission:values:?] in "
"the email body template."
msgstr ""
"የተመረጡ አካሎች በ [webform_submission:values] ቶከን "
"ውስጥ ይካተታሉ። በኢሜይል መልእክት "
"የይዘት እትም (body template) ውስጥ በግልጽ "
"ሁኔታ [webform_submission:values:?] እንደተገለጸ "
"ከሆነ ብቻ ግለሰብ እሴቶች ሊታተሙ "
"ይችላሉ።"

msgid ""
"<p>Submitted on [webform_submission:created]</p>\n"
"<p>Submitted by: "
"[webform_submission:user]</p>\n"
"<p>Submitted values "
"are:</p>\n"
"[webform_submission:values]\n"
""
msgstr ""
"<p>በ[webform_submission:created] ተልኳል</p>\n"
"<p>በ፦ "
"[webform_submission:user] ተልኳል</p>\n"
"<p>ተልከው "
"የተላኩ እሴቶች፦</p>\n"
"[webform_submission:values]"

msgid "[webform_submission:values:message:value]"
msgstr "[webform_submission:values:message:value]"

msgid "Reply-to email"
msgstr "ኢሜይል ለመመለስ የሚሆን አድራሻ"

msgid "The language name of the webform submission."
msgstr "د వెብフォーム സമర్పణ کی ভাষې نوم."

msgid "In draft"
msgstr "በረቂቅ ሁኔታ ውስጥ"

msgid "Is the webform submission in draft."
msgstr ""
"የዌብፎርም ማስገቢያው በረቂቅ (draft) ሁኔታ "
"ነው።"

msgid ""
"The 'items' can be 'comma', 'semicolon', 'and', 'ol', 'ul', or custom "
"delimiter"
msgstr ""
"«items» የሚሆኑት «comma», «semicolon», «and», «ol», "
"«ul» ወይም ማብጠር የሚችል መለያ ናቸው።"

msgid "Prevent duplicate submissions"
msgstr ""
"የተባዛ ማስገባቶችን (duplicate submissions) "
"አስቀምጥ"

msgid "Element multiple values delimiter"
msgstr "የአባል ብዙ እሴቶች መለያያ (delimiter)"

msgid "Default purging"
msgstr "ነባሪ ማጽዳት (ፐርጂንግ)"

msgid "Default days to retain submissions"
msgstr "የአስገባት (submissions) ለማቆየት ነባሪ ቀናት"

msgid "Delete submission configuration"
msgstr "የማስገባት ውቅርን ሰርዝ"

msgid "Star/Flag selected submission configuration"
msgstr "ኮከብ/ባንዲራ የተመረጠ የማስገባት ውቅር"

msgid "Unstar/Unflag selected submission configuration"
msgstr ""
"ተመረጠውን ማስረከቢያ ቅንብር "
"ከ“ኮከብ/ማሳያ ማስታወሻ” አንሳ፣ "
"አታስመር"

msgid ""
"%name cannot be less than %min characters but is currently %length "
"characters long."
msgstr ""
"%name የ %min ቁምፊዎች ከሚያነስ መሆን "
"አይችልም ግን በአሁኑ ጊዜ %length ቁምፊዎች "
"ብቻ ነው።"

msgid ""
"The value %value has already been submitted once for the %name "
"element. You may have already submitted this webform, or you need to "
"use a different value."
msgstr ""
"የ %name ኤለመንት ለ %value ቀደም ሲል አንድ ጊዜ "
"ቀርቧል። ይህንን ዌብፎርም ይሁንአብላ "
"አስገብተው ሊሆን ይችላሉ ወይም የተለየ "
"እሴት መጠቀም ያስፈልግዎታል።"

msgid "Select how a single value is displayed."
msgstr "አንድ ዋጋ እንዴት እንደሚታይ ይምረጡ።"

msgid "Automatically purge"
msgstr "በራስ ሰር ማጥፋት"

msgid "Days to retain submissions"
msgstr "እባክዎ ለተልእኮዎች ማቆያ ቀናት"

msgid "Webform operations bulk form"
msgstr "የዌብፎርም ኦፕሬሽኖች ብዙ ቅጽ"

msgid "Label/Description"
msgstr "መለያ/መግለጫ"

msgid "Enter custom JavaScript to be attached to all webforms."
msgstr ""
"ሁሉንም ዌብፎርሞች ላይ እንዲցተከል "
"የሚያስፈልግ ብጁ ጃቫስکریፕት አስገቡ።"

msgid "Delete submission"
msgstr "የማስገባቱን ሰርዝ"

msgid "Provides a form element that determines whether the user is human."
msgstr ""
"ተጠቃሚው ሰው እንደሆነ የሚወስን የቅጽ "
"አካል ያቀርባል።"

msgid "Provides a form element for a single checkbox."
msgstr ""
"ለአንድ ቼክቦክስ የሚሆን ፎርም አባል "
"ያቀርባል።"

msgid ""
"Provides a form element for a set of checkboxes, with the ability to "
"enter a custom value."
msgstr ""
"በመዋቅር ላይ የሚገኙ ቼክቦክሶች ስብስብ "
"የሚያቀርብ የፎርም አካል ያቀርባል፣ እና "
"ብጁ እሴት ለመግባት ችሎታ አለው።"

msgid "Provides a form element for choosing a color."
msgstr ""
"የቀለም ለመምረጥ የሚያስችል ቅጽ ክፍል (form "
"element) ይሰጣል።"

msgid "Provides a form element for date selection."
msgstr ""
"የቀን ምርጫ ለማድረግ የፎርም አካል "
"ይሰጣል።"

msgid ""
"Provides a form element for date & time selection using select menus "
"and text fields."
msgstr ""
"ቅንጅት ሜኑዎችን እና ጽሑፍ መስኮችን "
"በመጠቀም ለቀን እና ጊዜ ምርጫ ቅጽ አባል "
"ይሰጣል።"

msgid "Provides a form element for date & time selection."
msgstr ""
"የቀን እና የሰዓት ምርጫ ለማድረግ ፎርም "
"አካል ይሰጣል።"

msgid "Provides an interactive element that a user can open and close."
msgstr ""
"օգտատልቭ እንዲከፈት እና እንዲዘጋ "
"የሚቻል መስተጋብራዊ ክፍል ይሰጣል።"

msgid "Provides a form element for entering an email address."
msgstr ""
"የኢሜይል አድራሻ ለመግባት የቅጽ አካል "
"ይሰጣል።"

msgid ""
"Provides a form element to select an entity reference using an "
"autocompletion."
msgstr ""
"አውቶኮम्पਲੀషን በመጠቀም የአካል "
"ማጣቀሻ (entity reference) እንዲመርጥ የሚያስችል "
"የቅጽ ክፍል ይሰጣል።"

msgid "Provides an element for a group of form elements."
msgstr ""
"የቅጽ አካላት ቡድን ውስጥ ለሚኖር አካል "
"የሚሰጥ ነገር።"

msgid "Provides an element for displaying the label for a form element."
msgstr ""
"የቅጽ አካል መለያ (label) ለማሳየት "
"የሚያስችል አካል ይሰጣል።"

msgid "Provides a form element for selecting a language."
msgstr ""
"የቋንቋ ለመምረጥ የሚያስችል ፎርም አካል "
"ይሰጣል።"

msgid ""
"Provides a form element to enter a machine name, which is validated to "
"ensure that the name is unique and does not contain disallowed "
"characters."
msgstr ""
"යන්ትሮል አንድ የማሽን ስም ለመግባት "
"የሚያስችል የቅጽ አካል ይሰጣል፤ ስሙ ልዩ "
"መሆኑን እና የተከለከሉ ቁምፊዎችን "
"እንዳይይዝ ለማረጋገጥ ተፈትሾ ይታያል።"

msgid "Provides a form element for uploading and saving a file."
msgstr ""
"ፋይል ለመስቀል እና ለማስቀመጥ ፎርም "
"አካል ይሰጣል።"

msgid ""
"Provides a form element for numeric input, with special numeric "
"validation."
msgstr ""
"ቁمیණ የመግቢያ ለዕቃ ዓይነት ቅጽ አባል "
"ይሰጣል፣ ከተለየ የቁጥር ማረጋገጫ ጋር።"

msgid "Provides a form element for entering a password, with hidden text."
msgstr ""
"رمزጽሑፍ የሚያስገቡበትን የይለፍ ቃል "
"መግቢያ አካል (form element) ይሰጣል፣ ደብቅ "
"ጽሑፍ ጋር።"

msgid "Provides a form element for double-input of passwords."
msgstr ""
"የይለፍ ቃሎችን ለሁለት ጊዜ መግባት "
"(double-input) የሚያስፈልግ ፎርም አካል "
"ይሰጣል።"

msgid "Provides a form element for a set of radio buttons."
msgstr ""
"ለሬዲዮ ቁልፎች ስብስብ የፎርም አካል "
"ያቀርባል።"

msgid ""
"Provides a form element for input of a number within a specific range "
"using a slider."
msgstr ""
"ለመግባት በተወሰነ ክልል ውስጥ ቁጥር "
"ለመግባት ሊጎበኝ በሚችል ማስተካከያ (slider) "
"የሚሰጥ የፎርም አካል።"

msgid "Provides form element for entering a search phrase."
msgstr "፩፩፩ ፤ ፣ ፊ ፤ ፤"

msgid ""
"Provides a form element for a drop-down menu or scrolling selection "
"box."
msgstr ""
"የመያዣ (drop-down) ሜኑ ወይም የመጠበቂያ "
"ማሸብለያ ምርጫ ሳጥን ለማቅረብ "
"የሚያገለግል የፎርም አካል።"

msgid "Provides an element to render a table."
msgstr ""
"ሰንጠረዥ (table) ለመታየት የሚያስችል አካል "
"ይሰጣል።"

msgid ""
"Provides a form element for a table with radios or checkboxes in left "
"column."
msgstr ""
"ግራ በኩል ባለው አምድ ውስጥ ራዲዮ (radio) "
"ወይም ቼክቦክስ (checkboxes) ለሚኖርበት "
"ሰንጠረዥ የቅጽ አካል ይሰጣል።"

msgid "Provides a form element for input of a single-line text."
msgstr ""
"የአንድ መስመር ጽሑፍ ለመግባት የፎርም "
"አባል ይሰጣል።"

msgid "Provides a form element for input of multiple-line text."
msgstr ""
"ባහු-መስመር ጽሑፍ ለመግባት የመስጫ "
"መስክ አባል ይሰጣል።"

msgid "Provides a form element for input of a URL."
msgstr ""
"ዩአርኤል (URL) መረጃ ለማስገባት የቅጽ አካል "
"ይሰጣል።"

msgid ""
"Provides a form element to collect address information (street, city, "
"state, zip)."
msgstr ""
"አድራሻ መረጃ (ጎዳና፣ ከተማ፣ "
"ግዛት/ክልል፣ ፖስታ ኮድ) ለመሰብሰብ ቅጽ "
"አባል ይሰጣል።"

msgid "Provides a form element for uploading and saving an audio file."
msgstr ""
"የድምጽ ፋይል ለመስቀል እና ለማስቀመጥ "
"የሚያስችል ቅጽ አካል ይሰጣል።"

msgid "Provides a text field element with auto completion."
msgstr ""
"ራስ-ማጠናቀቅ (auto completion) ያለው የጽሑፍ "
"መስክ (text field) አካል ይሰጣል።"

msgid "Provides a group of multiple buttons used for selecting a value."
msgstr ""
"በእሴት ለመምረጥ የሚያገለግሉ ብዙ ቁጥጥር "
"አዝራሮችን ለማሰባሰብ የሚያገለግል ቡድን "
"ይሰጣል።"

msgid ""
"Provides a group of multiple buttons used for selecting a value, with "
"the ability to enter a custom value."
msgstr ""
"ብዙ ቁጥሮች ያሉትን ባለብዙ አዝራሮች "
"ለመምረጥ የሚያገለግል ቡድን ይሰጣል፤ "
"እንዲሁም ብጁ የሆነ እሴት ለመግባት እድል "
"ይኖረዋል።"

msgid "Provides a form element for a set of checkboxes."
msgstr ""
"የመዳረሻ ሳጥኖች (checkboxes) ስብስብ ለመመርጥ "
"ቅጽ አካል ያቀርባል።"

msgid "Provides a form element for uploading and saving a document."
msgstr ""
"ሰነድ ለመስቀል እና ለማስቀመጥ የሚያስችል "
"ፎርም አካል (element) ይሰጣል።"

msgid "Provides a generic form element."
msgstr "የአጠቃላይ ቅጽ ክፍል (form element) ይሰጣል።"

msgid "Provides a form element for double-input of email addresses."
msgstr ""
"የኢሜይል አድራሻዎችን ለሁለት ግቤት "
"የሚሆን ቅጽ አባል ይሰጣል።"

msgid "Provides a form element for multiple email addresses."
msgstr ""
"የብዙ ኢሜይል አድራሻዎች ለመግባት "
"የሚያስችል ቅጽ ክፍል (form element) ይሰጣል።"

msgid ""
"Provides a form element to select multiple entity references using "
"checkboxes."
msgstr ""
"ቼክቦክሶችን ተጠቅመው በብዙ አካል "
"ማጣቀሻዎች ለመምረጥ ቅጽ አካል ይሰጣል።"

msgid ""
"Provides a form element to select a single entity reference using "
"radio buttons."
msgstr ""
"радио ቡቶችን በመጠቀም አንድ ነጠላ "
"እንኳን ማጣቀሻ (entity reference) ለመምረጥ ቅጽ "
"አካል ይሰጣል።"

msgid ""
"Provides a form element to select a single or multiple entity "
"references using a select menu."
msgstr ""
"ከምርጫ ሜኑ በመጠቀም አንድ ወይም ብዙ "
"የአካል ማጣቀሻዎችን (entity references) ለመምረጥ "
"የሚያስችል ፎርም እቃ (form element) ይሰጣል።"

msgid ""
"Provides an element to render custom, dismissible, inline status "
"messages."
msgstr ""
"ተቋማዊ የመታወቂያ መረጃ መልዕክቶችን "
"በመስመር ላይ (inline) ብቁ በራስ እንዲዘጉ "
