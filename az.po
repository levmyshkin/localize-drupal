msgstr ""
"Aşağıdakı şəkilçiləri əlavə edərək qaytarılan dəyəri "
"dəyişdirin."

msgid "<code>:urlencode</code> URL encodes returned value."
msgstr "<code>:urlencode</code> URL qaytarılan dəyəri kodlayır."

