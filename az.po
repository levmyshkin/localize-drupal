msgstr "Vebforma variantını tətbiq edin"

msgid "View webform variants"
msgstr "Vebforma variantlarına baxın"

msgid "Test webform variants"
msgstr "Vebforma variantlarını yoxlayın"

msgid "Webform plugins: Variants"
msgstr "Vebforma plaginləri: Variantlar"

msgid "Webform variants"
msgstr "Vebforma variantları"

msgid "Variant plugin ID"
msgstr "Varyant plugin ID-si"

msgid "Variant instance ID"
msgstr "Varianta aid instansın ID-si"

