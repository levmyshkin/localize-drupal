msgstr "@plugin_id poçt plaqininin təmin etdiyi."

msgid ""
"Entered text will be displayed on the handlers administrative page and "
"replace this handler's default description."
msgstr ""
"Daxil edilən mətn idarəetmə səhifəsində bu handler-in "
"idarəetmə bölməsində göstəriləcək və həmin handler-in "
"standart təsvirini əvəz edəcək."

