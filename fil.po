msgstr ""
"Tanging ang mga administrator ng webform at ang mga user na may "
"nakatalagang pahintunang naipagkaloob ang “Edit webform Twig "
"templates” ang pinapayagang mag-edit ng Twig template na ito."

msgid "Not Pattern"
msgstr "Walang pattern"

