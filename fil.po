msgstr "Ang prepopulasyon ay pinagana para sa lahat ng mga elemento ng form."

msgid "Please note when an element is hidden it will not be required."
msgstr ""
"Pakitandaan na kapag nakatago ang isang elemento, hindi ito magiging "
"kailangan."

msgid "Enable default submission data (YAML)"
msgstr "Paganahin ang default na data ng submission (YAML)"

