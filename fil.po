msgstr "Halimbawa ng isang webform submission handler."

msgid ""
"Inline (Displays message when access is denied to field, nodes, and "
"blocks)"
msgstr ""
"Inline (Ipinapakita ang mensahe kapag tinanggihan ang pag-access sa "
"field, mga node, at mga block)"

msgid ""
"Page (Displays message when access is denied to forms, fields, nodes, "
"and blocks)"
msgstr ""
"Pahina (nagpapakita ng mensahe kapag tinanggihan ang pag-access sa mga "
"form, field, node, at block)"

