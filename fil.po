msgid "Allowed values"
msgstr "Mga pinapayagang halaga"

msgctxt "Validation"
msgid "Bundle"
msgstr "Bundle"

msgid "The entity must be of bundle %bundle."
msgstr "Ang entity ay dapat na kabilang sa bundle na %bundle."

