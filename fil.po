msgstr ""
"Ang screencast na ito ay nagbibigay ng pangkalahatang pagtingin sa mga "
"element, handler, at exporter plugin ng Webform module."

msgid "Why Plugins? | Drupal.org"
msgstr "Bakit Mga Plugin? | Drupal.org"

msgid "Plugins | Drupalize.me"
msgstr "Mga Plugin | Drupalize.me"

msgid ""
"This screencast shows how to translate a webform's title, "
"descriptions, label and messages."
msgstr ""
"Ipinapakita ng screencast na ito kung paano isalin ang pamagat, mga "
"paglalarawan, mga label, at mga mensahe ng isang webform."

