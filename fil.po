msgstr ""
"Huwag paganahin ang mga inline na error sa form para sa lahat ng "
"webform"

msgid ""
"If checked, <a href=\":href\">inline form errors</a>  will be disabled "
"for all webforms."
msgstr ""
"Kapag naka-check, ang <a href=\":href\">mga error sa inline form</a> "
"ay hindi paganahin para sa lahat ng webform."

