msgstr ""
"Nasa ibaba ang mga link at code snippet na maaari mong idagdag sa "
"iyong website para buksan ang form na ito sa isang modal dialog."

msgid "A message to be displayed if submission is locked."
msgstr "Isang mensaheng ipapakita kung naka-lock ang pagsusumite."

