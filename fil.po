msgstr "Mga tuntunin na link"

msgid "Enter the URL or path of the terms of service."
msgstr "Ilagay ang URL o path ng mga tuntunin ng serbisyo."

msgid "Terms link target"
msgstr "Target ng link ng mga tuntunin"

