msgstr ""
"@message Tingnan ang <a href=\":url\">mga pahina ng tulong</a> para sa "
"karagdagang impormasyon kung paano i-install ang plugin."

msgid "The <code>@plugin</code> plugin is not listed as an allowed plugin."
msgstr ""
"Ang plugin na <code>@plugin</code> ay hindi nakalista bilang "
