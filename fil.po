msgstr ""
"Ipadala ang nakaraang pahina ng wizard kapag pinindot ang button na "
"Bumalik ng browser"

msgid "Limit total interval"
msgstr "Limitahan ang kabuuang agwat"

msgid "Limit user interval"
msgstr "Pahigpitin ang pagitan ng user"

msgid "Entity limit total interval"
msgstr "Kabuuang limitasyon sa pagitan ng mga entidad"

