msgstr ""
"Pinapayagan ang pagtingin sa <em>sariling</em> mga pagsusumite para sa "
"lahat ng mga webform."

msgid "Allows updating <em>own</em> submissions for all webforms."
msgstr ""
"Binibigyang-daan ang pag-update ng <em>sariling</em> mga pagsusumite "
"para sa lahat ng mga webform."

msgid "Allows deleting <em>own</em> submissions for all webforms."
msgstr ""
"Pinapahintulutan ang pagtanggal ng <em>sariling</em> mga pagsusumite "
"para sa lahat ng mga webform."

