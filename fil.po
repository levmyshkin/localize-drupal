msgstr ""
"Ang pag-reset ng bokabularyo ay magtatapon ng lahat ng custom na ayos "
"at i-aayos ang mga item nang paalpabeto."

msgid "Reset vocabulary %name to alphabetical order."
msgstr "I-reset ang bokabularyo na %name sa ayos na alpbeto (alphabetical)."

