msgstr "Рецептро амаллаштырыу"

msgid "Themes installed"
msgstr "Темаҳо насб карда шуданд"

msgid "Content created for recipes"
msgstr ""
"Афарма усаçан рецептер өсөн "
"дөйөмләштерелгән йөкмәтке"

msgid "Recipes applied"
msgstr "Рецепттар ғәләп ителде"

msgid "%recipe applied successfully"
msgstr "%recipe уңышлы ҡулланылды"

msgid "Applied %recipe recipe."
msgstr "Колдонулду %recipe рецепт."

msgid "Installed %theme theme."
msgstr "Исталлоҳ %theme темплейт."

msgid "Installed configuration for %recipe recipe."
msgstr ""
"Установлен конфигурация өсөн %recipe "
"рецепц."

msgid "Created content for %recipe recipe."
msgstr "%recipe рецепти үчүн яратылған контент."

