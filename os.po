msgstr "Хӕлдьӕгтӕн."

msgid "Show teaser-style link"
msgstr "Тизер-типа сылка күрһәтеү"

msgid "Link this field to new comments"
msgstr ""
"Маьнги бу ош лӕвёрд — нал "
"адæймагдзыгонтæ дӕттæгдæрæн "
"комментæртæ"

msgid "contact"
msgstr "хәаҿақатҧы (контакт)"

msgid "Contact %user"
msgstr "%user белән байланышыш"

msgid "Unknown language"
msgstr "Номаълум тел"

