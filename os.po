msgid "Content entity type ID"
msgstr "Тип IDм мазмуны实体"

msgid "The ID of the content entity type this moderation state is for."
msgstr ""
"ID-и навъи объекти мундариҷае, ки ин "
"ҳолати идоракунӣ (moderation) барои он "
"пешбинӣ шудааст."

msgid "Content entity ID"
msgstr "Мазмун实体ниң идентификаторы"

msgid "The ID of the content entity this moderation state is for."
msgstr ""
