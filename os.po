msgstr "%type_name: Мазмун блогын төҙәтеү"

msgid "%type_name: Delete content block"
msgstr "%type_name: Мазмун блоки өчериу"

msgid "%type_name: View content block history pages"
msgstr ""
"%type_name: Вёгдукӕн хабардӕнты блокы "
"тарихы барагондыл страницæ"

msgid "%type_name: Revert content block revisions"
msgstr ""
"%type_name: Шараҭыԥқәаи блока аԥхьаӡарақәа "
"рҭахра"

msgid "%type_name: Delete content block revisions"
msgstr ""
"%type_name: Ворианттехи мазмун блокини юк "
"қилиу"

msgid "Edit %label block type"
msgstr "%Dlabel блок төрөн үҙгәртеү"

