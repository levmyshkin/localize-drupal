msgstr "Ҳа, мин %label @entity-type-ты ўчөргүм килә."

msgid "Clear all %label submissions?"
msgstr ""
"Барлық %label тапсырыстарын аустырып "
"тастау керекпи?"

msgid "Remove records from the database"
msgstr ""
"Амбарындағы ёҙмәләрҙе (рекордтарҙы) "
"алып ташлағыҙ"

