msgstr ""
"Енгезілген текс метрономдың алдыңда "
"прогресс барындын алдында күренә."

msgid "The entered text appears above the progress bar."
msgstr ""
"Введённый текст көрүнүп турат "
"прогресс-барҙың өҫтөндә."

msgid "The entered text appears below the progress bar."
msgstr ""
"Выләтылган текс тохум "
"прогрессбајбынын таҫынан астанда "
