msgstr "Капча балллары"

msgid "normal"
msgstr "әдеттәгидәй"

msgid "Code length"
msgstr "Коддун узундугу"

msgid "Font size"
msgstr "Шрифт өлчәме"

msgid "Spam control"
msgstr "Антиспам контроль"

