msgstr ""
"Дастархан рецепттарын аманатлап "
"башлау."

msgid "Recipe installation has encountered an error."
msgstr ""
"Рэцепт инсталляциерта къәтчилик "
"пайда болду."

msgid "Simple configuration update"
msgstr ""
"Ајтестӕн исцӕппӕдты усдзысдзыгон "
"хъуыдытӕ"

msgid "@entity_type @method"
msgstr "@entity_type @method"

msgid "@admin_label (multiple calls)"
msgstr "@admin_label (арматан-арматан саҡырыуҙар)"

