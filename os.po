msgstr "Экспорт итеү һылтанмаһын ҡабыҡлағыҙ"

msgid "Export link text"
msgstr "Экспорт шилтемәһе тексыты"

msgid "@label documents"
msgstr "@label ҳужжатлар"

msgid "Exports results as @label documents"
msgstr ""
"Экспорт итә һөҙөмтәләрҙе @label "
"документтары итеп"

