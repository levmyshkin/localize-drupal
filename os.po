msgstr "Даанкадор йўлдаштарына ҳам ҡарағыҙ"

msgid "Alternative sort"
msgstr "Алтернативным сортировка"

msgid "Alternate sort order"
msgstr "Алтернативной сортировкаһы"

msgid "On empty input"
msgstr "Ары нулын input​е:"

