"Файылдар өҫтәг(мә)"

msgid "Add @type via URL"
msgstr "URL-ы уиты @type өстә."

msgid "Allowed providers: @providers."
msgstr "Дозволени провайдерҳо: @providers."

msgid "Tab order"
msgstr "Амиттар тәртиби"

msgid "Tab order: @order"
msgstr "Рәтрой тәртип: @order"

