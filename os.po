msgstr "Ажурлəу амалҳаракати"

msgid "Strings to Remove"
msgstr "Ачгæе сараніаем нырыӕу үчүн саптар"

msgid "Pathauto"
msgstr "Pathauto — **Pathauto**"

msgid ""
"Provides a mechanism for modules to automatically generate aliases for "
"the content they manage."
msgstr ""
"Аӡыдаррақәа ҳаҭырқәҵаратә "
"механизмуп, урҭ ирыдҳәалоу модульқәа "
"рзы автоматикала алиасқәа адҳәалара "
"имҩаҧаҳҵоит иҵегьы ирыцхоу content иахь."

msgid "Forum"
msgstr "Форум"

msgid "Period"
msgstr "Авасҭа"

msgid "Asterisk"
msgstr "Астериск"

