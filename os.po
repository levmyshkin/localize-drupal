"Select the archive file type for submission file uploads and generated "
"documents."
msgstr ""
"Архив файлынын төрөн һайлағыҙ — "
"тапшырыу өсөн жүктәлгән файлдар һәм "
"барлыҡҡа килтерелгән документтар "
"өсөн."

msgid "Tar archive (*.tar.gz)"
msgstr "Тар-архив (*.tar.gz)"

msgid "ZIP file (*.zip)"
msgstr "ZIP-файл (*.zip)"

