msgstr ""
"асорстав, ахснаба, арундқәа, дурнагани "
"(underscore)"

msgid "letters, numbers, underscores, and dashes"
msgstr ""
"асортифона, асамбарҳо, подчёркивания, "
"и даҳашқәа"

