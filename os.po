msgstr ""
"Ачықтама таблицыг̆о интихоб "
"параметрлериниң чегинин бағаны өсөн "
"тақалып, сарлавҳада көрсетелә."

msgid "Add <span>row</span>"
msgstr "Добав <span>рәт</span>"

msgid "Add <span>element</span>"
msgstr "<span>элемент</span> өҫтәп ҡуйығыҙ"

