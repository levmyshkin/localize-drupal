msgstr ""
"@type төрөнө етип ҡоролған объект "
"эшкәртелмәне. Ул түбәндәге үрнәктәрҙе "
"билдәләй: @patterns"

msgid ""
"Unrecognized entity bundle @entity:@bundle was not processed. It "
"defines the following patterns: @patterns"
msgstr ""
"Номаълум entity bundle @entity:@bundle "
"ишкәртелмәне. Ул түбәндәге үрнәкләрне "
"билгели: @patterns"

