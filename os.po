msgstr ""
"Аҳта мағлүмат индикатору раӈги 2xx-и "
"булмаса, мына мағлүмат күрһәтелә."

msgid "Custom response messages"
msgstr "Хас махсус яуап-хабар мәтинни"

msgid "201 Created"
msgstr "201 Жаңа түзүлдү"

msgid "204 No Content"
msgstr "204 Агуулга юҡ"

