msgstr ""
"Төмен IP жогорку IP адресдарынан "
"диапазонда артық болмауы керек. %ip_range "
"диапазонун түзөтүңүз."

msgid "Add Captcha Point"
msgstr "Каптча нуқтаһын өҫтәргә"

msgid "Overview of the available CAPTCHA challenge types with examples'"
msgstr ""
"Обзор доступных типов вызовов CAPTCHA с "
"примерами"

msgid "CAPTCHA Examples"
msgstr "CAPTCHA-ის мисалдар"

msgid "The default captcha title."
msgstr "Стандартное капча атауы."

msgid "Text Content"
msgstr "Мәтін мазмуны"

msgid "Customize image CAPTCHA text content."
msgstr "Ама фото CAPTCHA текстын тохируулт."

msgid "Refresh button text."
msgstr "Ажыртыу (рефреш) туймаһының тексты."

