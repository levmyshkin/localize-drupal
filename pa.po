msgstr "URL ਦੇ ਪਾਥ (path) ਕੰਪੋਨੈਂਟ।"

msgid "Unaliased URL"
msgstr "Unaliased URL"

msgid "The unaliased URL."
msgstr "ਅਨਅਲਿਆਸਡ URL।"

msgid "The specific value of the array."
msgstr "ਐਰੇ ਦੀ ਖਾਸ ਮੁੱਲ।"

