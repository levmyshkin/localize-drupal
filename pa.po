"\n"
"--  [site:name] ਟੀਮ"

msgid "Module Permissions"
msgstr "ਮੌਡੀਊਲ ਅਧਿਕਾਰ"

msgid "workspace"
msgstr "ਵਰਕਸਪੇਸ"

msgid "Activate Workspace"
msgstr "ਵਰਕਸਪੇਸ ਐਕਟੀਵੇਟ ਕਰੋ"

