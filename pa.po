msgstr "ਮੂਲ ਕੈਪਚਾ ਸਿਰਲੇਖ।"

msgid "Text Content"
msgstr "ਪਾਠ ਸਮੱਗਰੀ"

msgid "Customize image CAPTCHA text content."
msgstr ""
"ਚਿੱਤਰ CAPTCHA ਦੇ ਟੈਕਸਟ ਸਮੱਗਰੀ "
"ਨੂੰ ਕਸਟਮਾਈਜ਼ ਕਰੋ।"

msgid "Refresh button text."
msgstr "ਰਿਫ੍ਰੈਸ਼ ਬਟਨ ਦਾ ਟੈਕਸਟ।"

