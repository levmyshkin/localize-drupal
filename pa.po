msgstr "ਡ੍ਰੈਗ ਅਤੇ ਡ੍ਰੌਪ"

msgid "Edit all"
msgstr "ਸਭ ਨੂੰ ਸੋਧੋ"

msgid "Edit All"
msgstr "ਸਭ ਨੂੰ ਸੋਧੋ"

msgid "Toggle Actions"
msgstr "ਕਾਰਵਾਈਆਂ ਬਦਲੋ"

msgid "Revision from %revision-date has been deleted."
msgstr ""
"%revision-date ਤੋਂ ਆਈ ਰਿਵਿਜ਼ਨ ਹਟਾ "
"ਦਿੱਤੀ ਗਈ ਹੈ।"

msgid "Paragraphs settings"
msgstr "ਪੈਰਾਗ੍ਰਾਫ ਸੈਟਿੰਗਾਂ"

msgid "View unpublished paragraphs"
msgstr ""
"ਅਣਪ੍ਰਕਾਸ਼ਿਤ ਪੈਰਾਗ੍ਰਾਫ "
"ਵੇਖੋ"

