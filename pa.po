msgstr "@subject ਵਾਲੀ ਟਿੱਪਣੀ ਸੋਧੋ"

msgid ""
"Only this translation is published. You must publish at least one more "
"translation to unpublish this one."
msgstr ""
"ਸਿਰਫ਼ ਇਹ ਅਨੁਵਾਦ ਹੀ "
"ਪ੍ਰਕਾਸ਼ਿਤ ਕੀਤਾ ਗਿਆ ਹੈ। ਇਸ "
"ਨੂੰ ਅਨਪ੍ਰਕਾਸ਼ਿਤ ਕਰਨ ਲਈ "
"ਤੁਹਾਨੂੰ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਹੋਰ "
"ਅਨੁਵਾਦ ਪ੍ਰਕਾਸ਼ਿਤ ਕਰਨਾ "
"ਲਾਜ਼ਮੀ ਹੈ।"

msgid "Time interval"
msgstr "ਸਮਾਂ ਅੰਤਰਾਲ"

msgid "Views plugins"
msgstr "Views ਪਲੱਗਇਨਜ਼"

