"ਬਾਕੀਆਂ ਨੂੰ ਬੰਦ ਕਰੋ।"

msgid "Closed mode: @closed_mode"
msgstr "ਬੰਦ ਮੋਡ: @closed_mode"

msgid "Autocollapse: @autocollapse"
msgstr "ਆਟੋ-ਕੋਲੈਪਸ: @autocollapse"

