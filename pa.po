msgstr "ਟੂਲਟਿਪ ਲਈ ਮਿਤੀ ਫਾਰਮੈਟ"

msgid "Tooltip custom date format"
msgstr "ਟੂਲਟਿਪ ਲਈ ਕਸਟਮ ਮਿਤੀ ਫਾਰਮੈਟ"

msgid "Time difference"
msgstr "ਸਮੇਂ ਦਾ ਅੰਤਰ"

msgid "Show as time difference"
msgstr "ਸਮੇਂ ਦੇ ਫ਼ਰਕ ਵਜੋਂ ਦਿਖਾਓ"

