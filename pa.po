msgstr "ਪੇਜ ਲਈ ਚੁਣੀ ਗਈ ਭਾਸ਼ਾ ਕਿਸਮ"

msgid "@code (@title)"
msgstr "@code (@title)"

msgid ""
"The following tokens are available. You may use Twig syntax in this "
