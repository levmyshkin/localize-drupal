msgstr ""
"ਉਹ ਫੀਲਡ ਜੋ ਹਰ ਰੋ ਲਈ OPML URL "
"ਐਟ੍ਰਿਬਿਊਟ ਵਜੋਂ ਵਰਤੀ ਜਾਣੀ "
"ਹੈ।"

msgid ""
"[user:display-name],\n"
"\n"
"Your account on [site:name] has been "
