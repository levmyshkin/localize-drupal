msgstr "302 ਮਿਲਿਆ"

msgid "303 See Other"
msgstr "303 ਹੋਰ ਦੇਖੋ"

msgid "304 Not Modified"
msgstr "304 Not Modified (ਪਰਿਵਰਤਨ ਨਹੀਂ ਹੋਇਆ)"

msgid "305 Use Proxy"
msgstr "305 ਪ੍ਰੌਕਸੀ ਵਰਤੋ"

msgid "Redirect users from one URL to another."
msgstr ""
"ਇੱਕ URL ਤੋਂ ਦੂਜੇ URL ਵੱਲ "
"ਯੂਜ਼ਰਾਂ ਨੂੰ ਰੀਡਾਇਰੈਕਟ "
"ਕਰੋ।"

