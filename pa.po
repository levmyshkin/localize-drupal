msgctxt "Validation"
msgid "Config exists"
msgstr "ਕੰਫਿਗ ਮੌਜੂਦ ਹੈ"

msgid "The '@name' config does not exist."
msgstr ""
"`@name` ਦੀ ਕਨਫ਼ਿਗ ਮੌਜੂਦ ਨਹੀਂ "
"ਹੈ।"

msgctxt "Validation"
msgid "Required config dependency types"
msgstr ""
"ਲੋੜੀਂਦੀਆਂ ਕਨਫਿਗਰੇਸ਼ਨ "
"ਨਿਰਭਰਤਾ ਕਿਸਮਾਂ"

