msgstr "ਮੀਡੀਆ ਪ੍ਰਕਾਸ਼ਿਤ ਕਰੋ"

msgid "Unpublish media"
msgstr "ਮੀਡੀਆ ਨੂੰ ਅਨਪਬਲਿਸ਼ ਕਰੋ"

