msgstr "Vee asseblief indienings uit die %title-webvorm uit."

msgid "%title webform has @total submissions."
msgstr "%title webvorm het @total indienings."

msgid ""
"You may not delete %title webform until you have removed all of the "
"%title submissions."
msgstr ""
"Jy mag nie %title webvorm uitvee voordat jy al die %title-inskrywings "
"verwyder het nie."

msgid ""
"Please make sure to install additional <a "
"href=\":libraries_href\">third-party libraries</a>, <a "
