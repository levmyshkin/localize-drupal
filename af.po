"Drush was unable to download the colorbox library from @remote. "
"@exception"
msgstr ""
"Drush kon nie die colorbox-biblioteek van @remote aflaai nie. "
"@exception"

msgid "Error: unable to unzip colorbox file."
msgstr "Fout: kon nie die Colorbox-lêer uitpak nie."

msgid "The colorbox library has been successfully downloaded to @path."
msgstr "Die Colorbox-biblioteek is suksesvol afgelaai na @path."

msgid "Drush was unable to load the colorbox library"
msgstr "Drush kon nie die colorbox-biblioteek laai nie."

msgid ""
"You can find new features in the <a href=\"@url_colorbox_load\" "
"target=\"blank\">Colorbox Load</a> and <a "
"href=\"@url_colorbox_inline\" target=\"blank\">Colorbox Inline</a>"
msgstr ""
"Jy kan nuwe kenmerke vind in die <a href=\"@url_colorbox_load\" "
"target=\"blank\">Colorbox Load</a> en <a href=\"@url_colorbox_inline\" "
"target=\"blank\">Colorbox Inline</a>"

