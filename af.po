msgstr "‘n Vlag wat die status van die webvorminskrywing aandui."

msgid "Administrative notes about the webform submission."
msgstr "Administratiewe notas oor die webvorm-insending."

msgid "The serial number of the webform submission entity."
msgstr "Die reeksnommer van die webvorminskrywing-entiteit."

