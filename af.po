msgstr "Verwerk %path."

msgid "You need to provide at least one installed project's machine_name."
msgstr ""
"Jy moet ten minste een geïnstalleerde projek se *machine_name* "
"verskaf."

msgid "Starting the analysis. This may take a while."
msgstr "Begin met die ontleding. Dit kan ’n rukkie neem."

msgid "Scanned on @date"
msgstr "Geskandeer op @date"

