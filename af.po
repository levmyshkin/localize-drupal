msgstr "„@field“-veld"

msgid ""
"The <a href=\":rest-docs\">RESTful Web Services</a> and <a "
"href=\":jsonapi-docs\">JSON:API</a> modules serve similar purposes. <a "
"href=\":comparison\">Read the comparison of the RESTFul Web Services "
