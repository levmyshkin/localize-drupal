msgstr ""
"Die “Lêer”-element is nie beskikbaar nie omdat daar geen "
"stroomomskakelaars beskikbaar is nie."

msgid "Provides a form element for time selection."
msgstr "Verskaf ’n vormelement vir tydkeuse."

msgid "Provides a form element for uploading and saving a video file."
msgstr "Verskaf ’n vormelement om ’n videolêer op te laai en te stoor."

msgid "Disable system tray"
msgstr "Skakel stelselbakkie af"

