msgid "Extension is available"
msgstr "Uitbreiding is beskikbaar"

msgid "Module '@name' is not available."
msgstr "Module “@name” is nie beskikbaar nie."

msgid "Theme '@name' is not available."
msgstr "Teme '@name' is nie beskikbaar nie."

msgid "Profile '@name' is not available."
msgstr "Profiel “@name” is nie beskikbaar nie."

