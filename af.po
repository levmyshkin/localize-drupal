msgstr "Herleidingsinstellings"

msgid "Redirect 404"
msgstr "Herlei 404"

msgid "The user ID of the node author."
msgstr "Die gebruiker-ID van die nodeskrywer."

msgid "Pages to ignore"
msgstr "Bladsye om te ignoreer"

