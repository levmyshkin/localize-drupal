msgstr "Eenvoudige XML-sitemap PHP-uitbreidings"

msgid ""
"In order to be able to generate sitemaps, the Simple XML Sitemap "
"module requires the <em>xmlwriter</em> PHP extension to be enabled."
msgstr ""
"Om webwerpskaarte te kan genereer, vereis die Simple XML "
"Sitemap-module dat die <em>xmlwriter</em> PHP-uitbreiding geaktiveer "
"is."

msgid "Include a stylesheet in the sitemaps for humans"
msgstr "Sluit ’n styleblad in die sitemaps vir mense in"

msgid "Simple XML Sitemap (Views)"
msgstr "Eenvoudige XML-sitemap (Aansigte)"

