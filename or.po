msgstr ""
"ଉଦାହରଣ: ଅନୁକୂଳ "
"ବିକଳ୍ପଗୁଡ଼ିକ"

msgid "Example of a custom options element."
msgstr ""
"କଷ୍ଟମ୍ ଅପ୍ସନ୍ ଏଲିମେଣ୍ଟର "
"ଉଦାହରଣ।"

msgid ""
"states:\n"
"  '#type': 'webform_options_custom:us_states'\n"
"  '#title': "
"'U.S. States'\n"
"  '#required': true\n"
"button:\n"
"  '#type': "
"'webform_options_custom:buttons'\n"
"  '#title': 'Buttons'\n"
"  "
"'#required': true\n"
"  '#options':\n"
"    one: One -- This is the number "
"1.\n"
"    two: Two -- This is the number 2.\n"
"    three:  Three -- This "
"is the number 3.\n"
""
msgstr ""
"```yaml\n"
"states:\n"
"  '#type': 'webform_options_custom:us_states'\n"
"  "
"'#title': 'ଆମେରିକା ରାଜ୍ୟଗୁଡିକ'\n"
"  "
"'#required': true\n"
"button:\n"
"  '#type': "
"'webform_options_custom:buttons'\n"
"  '#title': "
"'ବଟନ୍‌ଗୁଡିକ'\n"
"  '#required': true\n"
"  "
"'#options':\n"
"    one: One -- ଏହା ସଂଖ୍ୟା 1।\n"
"    "
"two: Two -- ଏହା ସଂଖ୍ୟା 2।\n"
"    three:  Three -- "
"ଏହା ସଂଖ୍ୟା 3।\n"
"```"

