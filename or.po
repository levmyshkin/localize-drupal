msgstr "hoverIntent ଆଚରଣ"

msgid "hoverIntent timeout"
msgstr "hoverIntent ଟାଇମଆଉଟ୍"

msgid "Hide Toolbar (Alt+p)"
msgstr "ଟୁଲବାର୍ ଲୁଚାନ୍ତୁ (Alt+p)"

