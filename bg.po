msgstr "Модулът „@name“ не е наличен."

msgid "Theme '@name' is not available."
msgstr "Тема „@name“ не е налична."

msgid "Profile '@name' is not available."
msgstr "Профилът „@name“ не е наличен."

msgid "Positive or zero"
msgstr "Положително или нула"

