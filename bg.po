msgstr "Уебформата е @webforms или @last"

msgid "The webform is @webform"
msgstr "Уебформата е @webform"

msgid "Advanced HTML/Text"
msgstr "Разширен HTML/Текст"

msgid "Telephone settings"
msgstr "Телефонни настройки"

