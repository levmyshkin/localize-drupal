msgstr ""
"Инструментът за изображения „@toolkit“ "
"не успя да обработи „@operation“ за "
"изображението „@image“. Съобщена "
"грешка: @class - @message"

msgctxt "Validation"
msgid "Plugin exists"
msgstr "Плъгинът съществува"

msgid "The '@plugin_id' plugin does not exist."
msgstr "Плъгинът „@plugin_id“ не съществува."

msgid "The '@plugin_id' plugin must implement or extend @interface."
msgstr ""
"Плъгинът „@plugin_id“ трябва да "
"имплементира или да разширява "
"интерфейса „@interface“."

msgid "Optimized assets files"
msgstr "Оптимизирани файлове с ресурси"

