msgstr "Деактивиран формат на JavaScript: @date_format"

msgid "Tooltip date format: @date_format"
msgstr "Формат на датата в подсказката: @date_format"

msgid "Reference type: @entity_type"
msgstr "Тип на препратка: @entity_type"

