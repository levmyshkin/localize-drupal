msgstr ""
"Публикувай данните, когато <b>се "
"създава черновикът.</b>"

msgid "draft updated"
msgstr "draft updated → **черновикът е актуализиран**"

msgid "Post data when <b>draft is updated.</b>"
msgstr ""
"Изпращайте данните, когато "
"<b>черновата е обновена.</b>"

