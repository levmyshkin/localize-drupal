msgstr ""
"Предоставя елемент на формуляр за "
"показване на телефонен номер с тип и "
"вътрешен номер."

msgid "Term reference settings"
msgstr "Настройки на препратките към термини"

msgid "Phone type"
msgstr "Тип телефон"

