msgstr ""
"विजार्ड/कार्डले सबै "
"तत्वहरू लुकाउने लेबल"

msgid "Webform Cards"
msgstr "वेबफर्म कार्डहरू"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"छिटो क्लाइन्टसाइड "
"मल्टिस्टेप फाराम "
"पेजिनेसनका लागि ‘कार्ड’ "
"कन्टेनर एलिमेन्ट उपलब्ध "
"गराउँछ।"

