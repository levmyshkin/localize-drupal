msgid "Mark a field as required in a Collection constraint"
msgstr ""
"कलेक्शन बाध्यतामा कुनै "
"फिल्डलाई अनिवार्य (required) "
"भनेर चिन्ह लगाउनुहोस्"

msgctxt "Validation"
msgid "Serialized"
msgstr "Serialised"

