msgstr "हरेक @increment मिनेटमा"

msgid "every @increment hours"
msgstr "हरेक @increment घण्टामा"

msgid "every @increment days"
msgstr "हरेक @increment दिनमा"

msgid "every @increment weeks"
msgstr "हरेक @increment हप्तामा"

msgid "every year"
msgstr "हरेक वर्ष"

