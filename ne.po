msgid ""
"AL: Alabama\n"
"AK: Alaska\n"
"AS: 'American Samoa'\n"
"AZ: Arizona\n"
"AR: "
"Arkansas\n"
"AE: 'Armed Forces (Canada, Europe, Africa, or Middle "
