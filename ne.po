msgstr ""
"वेबफर्मका तस्बिरहरू "
"सम्पादन गर्नुहोस्"

msgid "Duplicate webform images"
msgstr ""
"वेबफर्म छविहरू नक्कल "
"गर्नुहोस्"

msgid "Delete webform images"
msgstr ""
"वेबफर्मका छविहरू "
"मेटाउनुहोस्"

msgid "Images (YAML)"
msgstr "छविहरू (YAML)"

msgid "Duplicate '@label' images"
msgstr "'@label' को डुप्लिकेट छविहरू"

msgid "Maximum @max characters"
