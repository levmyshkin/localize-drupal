msgstr ""
"यो भेरिएन्ट हाल प्रयोगमा "
"छ। भेरिएन्ट प्रकार "
"परिवर्तन गर्न सकिँदैन।"

msgid "Prepopulate this variant"
msgstr ""
"यो भेरियन्ट "
"पूर्व-भरिनुहोस्"

msgid "Randomly load variant"
msgstr ""
"विकल्पलाई अनियमित रूपमा "
"लोड गर्नुहोस्"

