msgstr ""
"reCAPTCHA का लागि <a href=\":url\" "
"target=\"_blank\">दर्ता गर्दा "
"तपाईंलाई दिइएको साइट की</a>।"

msgid ""
"The secret key given to you when you <a href=\":url\" "
"target=\"_blank\">register for reCAPTCHA</a>."
msgstr ""
"reCAPTCHA का लागि <a href=\":url\" "
"target=\"_blank\">दर्ता गर्दा</a> "
