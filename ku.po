msgid "Draft updated URL"
msgstr "URL-ی نوێ ڕاگرتن / نوێکردن (پیشکەش بکە)"

msgid "Draft updated custom data"
msgstr "فراهمکردنی داتاى تایبەتی نوێکراو"

msgid "Element key pattern"
msgstr "الێمانتەری کێ/کۆد پاتێرنی کلیل"

msgid "@expected values expected and only @found found."
msgstr ""
"بەخوازەوەکان لەگەڵ @expected تەنها @expected "
