msgstr "نکته‌های Captcha"

msgid "normal"
msgstr "عادی"

msgid "Code length"
msgstr "Length کۆد"

msgid "Font size"
msgstr "قەبارەی فونت"

msgid "Spam control"
msgstr "کنترۆڵی هەڵبژاردنی هرزنامه"

