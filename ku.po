msgstr ""
"تەنها وۆرک‌سپێیسە سەرەکییەکان "
"دەتوانرێت بڵاوکرێنەوە."

msgid "Merge into @target_label"
msgstr "بە @target_label یەکپارچه بکەرەوە"

