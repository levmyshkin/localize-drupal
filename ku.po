msgstr ""
"کاتێک بۆ بەردەوامبوون تا پێشەکی "
"دابنانی ناردنەوەی دواتر"

msgid "Remaining number of submissions"
msgstr ""
"ڕەسەمی ژمارەی ناردنەکان لە ماوەدا "
"مانەوە"

msgid "The remaining number of submissions for the webform."
msgstr ""
"ڕێژەی مانەوەی دەرچوونەکان بۆ "
"وێبسەرچاوە (Webform)."

msgid "Per user wait time before next submission"
msgstr ""
"بۆ ماوەی انتظار بەکارهێنەر لە پێش "
