msgstr ""
"URL-é رێکلامی سەرەکی لە ماڵپەڕەکە بەبێ "
"پروتۆکۆل."

msgid "Short format"
msgstr "فۆرماتی کورت"

msgid "Medium format"
msgstr "فۆرماتی مامناوەندی"

msgid "Long format"
msgstr "فۆرماتی درێژ"

msgid "Time-since"
msgstr "وەکاتەوە (Time-since)"

msgid "Raw timestamp"
msgstr "کاتمۆری خاو"

