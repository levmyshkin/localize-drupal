msgstr ""
"ڤەشارت %label گۆڕان/ترانزیشن (transition) "
"ئاساوە کرایە."

msgid "Embed media"
msgstr "جیھاندنەوەی مێدیا"

msgid "Warnings found"
msgstr "ئاگاھدارىیەکان دەرکەوتن"

msgid "Errors found"
msgstr "کێشان دۆزرانەوە"

