msgstr ""
"ئێستا تۆ لە کاربردنی دواکەوتووەوە "
"(shortcut)ی `%set_name` بەکاردەهێنیت."

msgid "%user is now using the %set_name shortcut set."
msgstr ""
"%user ئێستا لە کاربەریی %set_name شورتکاتەکە "
"دایە."

