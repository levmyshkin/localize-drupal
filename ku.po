msgstr ""
"Qurğunun adının bir hissəsini daxil edin تا بتوانید بر "
"اساس آن فیلتر کنید."

msgid ""
"The %title (@type) is a root element that can not be used as child to "
"another element"
msgstr ""
"%title (@type) ئەو ڕەخنەیە کە وەک بەشی سەرەکی "
"(root) دەست نیشان کراوە و ناتوانرێت وەک "
"وەڵامەدی (child) بۆ یەکەی تر "
"بەکاربهێنرێت."

msgid "Total submissions limit message"
msgstr ""
"پەیامی سنەدی هەڵسەنگاندنی کۆتایی بۆ "
"دابەشكردنەكان"

msgid "Per user submission limit message"
msgstr "پیام حد مجاز برای ارسال هر کاربر"

msgid "Default total submissions limit message"
msgstr ""
"پەیامی سەقفە «دەستەواژەی جەم»ی ئاسایی "
"بۆ داوای تۆمارکردن"

msgid "Default per user submission limit message"
msgstr ""
"مەسڵەی دژکردنی فەرشکراوی "
"هەڵسەنگاندنی سەقف بۆ هەر نێردراوی "
"بەکارهێنەر"

msgid ""
"An <a href=\":href\">inputmask</a> helps the user with the element by "
"ensuring a predefined format."
msgstr ""
"An <a href=\":href\">inputmask</a> بۆ کاربر یارمەتی "
"دەدات لە ڕێگای دڵنیابوون لە "
"چارچێوەیەکی پێشکەشکراو بۆ the element."

msgid "Email multiple"
msgstr "ئیمەیل چەندتا بۆ هەمان کات"

msgid ""
"A <a href=\":href\">regular expression</a> that the element's value is "
"checked against."
msgstr ""
"<p>یک <a href=\":href\">رێگولار اکسپرشن</a> که "
"مقدارِ ئه‌ڵێمانه‌که لە بەرامبەری "
"تێدا دەپشکنرێت.</p>"

msgid "The maximum number of matches to be displayed."
msgstr ""
"بیشترین ژمارەی ڕیکلامەکان (تطبیق‌ها) "
"کە دەبێت نیشان بدرێت."

msgid ""
"The minimum number of characters a user must type before a search is "
"performed."
msgstr ""
"بەوپێیەی کەمترین ژمارەی دەقەکان "
"(کاراکتەر) کە دەبێت کاربەر پیشان بدات "
"تا جستجو ئەنجام بدرێت."

msgid "Limit entered value to a maximum number of characters or words."
msgstr ""
"مقدارێکی واردکراوەکە بە بیشترین "
"ژمارەی ڕەقەمەکان یان وشەکان مەحدود "
"بکە."

msgid ""
"If checked, all <a href=\":details_href\">Details</a> element's "
"open/close state will be saved using <a "
"href=\":local_storage_href\">Local Storage</a>."
msgstr ""
"ئەگەر چەک بکرێت، هەموو دۆخی "
"دەربوون/داخستنی توکەڵەکانی <a "
"href=\":details_href\">Details</a> بە یارمەتی <a "
"href=\":local_storage_href\">Local Storage</a> ذخیره "
"دەکرێت."

msgid ""
"Please check the formats that are available for this element. Leave "
"blank to allow all available formats."
msgstr ""
"لطفاً فۆرماتەکانی لە بەرچاوت داوە بە "
"دەستنیشان بکە بۆ ئەم ئێڵێمانە. بەخێڵی "
"بەجێهێڵە بۆ ئەوەی هەموو فۆرماتە "
"دابەزکراوەکان بەکاربێت."

msgid "If checked, the 'About text formats' link will be hidden."
msgstr ""
"ئەگەر چەک کرابێت، لینکـی «About text formats» "
"پەنهان دەکرێت."

msgid "@title placeholder"
msgstr "@title لەجێگای نووسین"

