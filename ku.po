msgstr "Rêza 3 ya navnîşanê"

msgid "Default elements"
msgstr "ئاسانییە هەڵسەنگاوەکان"

msgid "The elements have been unexpectedly altered. Please try again"
msgstr ""
"پەرهەکان بە شێوەیەکی ناخوێندەوە "
"گۆڕاوە. تکایە دووبارە هەوڵ بدە."

msgid ""
"There has been error validating the elements. You may need to edit the "
"<a href=\":href\">YAML source</a> to resolve the issue."
msgstr ""
"پێوەندی هەیە لە هەڵسەنگاندنی "
"تەنەکەکان؛ بەهۆی ئەوە دەتوانیت پێویست "
"بکات <a href=\":href\">سەرچاوەی YAML</a> دەستکاری "
"بکەیت بۆ چارەسەری مەسەلەکە."

msgid "Leaving blank will use the default maxlength."
msgstr ""
"خالی گذاشتن بەکارهێنان بە Maxlength ـی "
"بنەڕەتی دەکات."

msgid "Leaving blank will use the default rows."
msgstr ""
"جێهێشتن بەتاڵ بەکارهێنانى سطرى "
"پێشبڕکراو دەکات."

msgid "Specifies the minimum value."
msgstr "بەهاى کەمینە دیار دەکات."

msgid "Specifies the maximum value."
msgstr "بەڕێزکردنەوەی بیشترین بەهای ڕوو."

msgid ""
"The placeholder will be shown in the element until the user starts "
"entering a value."
msgstr ""
"پێش‌ساز (placeholder) تا زمانی نیشان داده "
"می‌شود که کاربر دەست بە واردکردنی "
"بە‌کارهێنانی/تەنهاوای (value) بکات."

msgid "Contents should be visible (open) to the user."
msgstr ""
"محتوا بایستی برای کاربر قابل مشاهده "
"(کراوە) باشد."

msgid "Private elements are shown only to users with results access."
msgstr ""
"ئەندامە تایبەتییەکان تەنها بۆ "
"بەکارهێنەرانی پیشان دەدرێت کە "
"دەستگەیشتن بە ڕەخسەکان هەیە."

msgid ""
"The label to show for the initial option denoting no selection in a "
"select element."
msgstr ""
"بەڵگە/ناوی کە بۆ هەڵبژاردەی یەکەم کە "
"مانای هەڵنەبژاردن لە ناوەڕۆکی select ـدا "
"دەهێنێت نیشان بدرێت."

msgid ""
"The value for the initial option denoting no selection in a select "
"element, which is used to determine whether the user submitted a value "
"or not."
msgstr ""
"بەهای پەرەی سەرەتایی کە بۆ خیارەش «هیچ "
"هەڵبژاردن» لە یەک لەکێکی سِلێکت دێت، "
"کە لەوەدا بەکاردێت بزانرێت کە "
"بەکارهێنەر بەهایەک ناردووەتەوە یان "
"نا."

msgid "Other placeholder"
msgstr "بەشێوەی هەڵگری تر"

msgid "These properties and callbacks are not allowed: @properties"
msgstr ""
"ئەم خاسەتەکان و کۆڵبەندییەکان "
"ڕێگەپێدراون نییە: @properties"

msgid ""
"Option groups can be created by using just the group name followed by "
"indented group options."
msgstr ""
"دەستنیشانەکان دەتوانرێن بە "
"بەکارهێنانی ناوی گروپەکە و دوای ئەوە "
"هەڵبژاردەکانی گروپی داماڵراو دروست "
"بکرێن."

msgid "Completed @feedback submissions (@rate submissions/min)"
msgstr ""
"تێپەڕبوونى دابەشکردنەوەکان @feedback ( @rate "
"دابەشکردنەوە لە ڕێژەی/دەم )"

msgid "Date part and order"
msgstr "بەشی توێژە و ڕێکخستنی ڕێژەکانی داتـا"

msgid "Date text parts"
msgstr "بەشەکانی تێکستی ڕێکەوت"

msgid ""
"A description of the range of years to allow, like '1900:2050', "
"'-3:+3' or '2000:+3', where the first value describes the earliest "
"year and the second the latest year in the range."
msgstr ""
"بەشێوەیەکی ڕوون بڕیاربدە لەسەر "
"بەڕێوەبردنی کاتێکی ساڵان، وەک '1900:2050'، "
"'-3:+3' یان '2000:+3'؛ لە کەسەی یەکەمدا ساڵی "
"دەرەوەی تر (زۆرترین دوا) دەربڕاوە و لە "
"کەسەی دووەمدا ساڵی دوایی‌ترین لە "
"ماوەکەدا."

msgid "Date increment"
msgstr "زیادکردن بۆ رێکەوتە"

msgid "The increment to use for minutes and seconds"
msgstr ""
"ئەو زیادکردنەی کە بۆ دقایق و کاتژمێر "
"(سەعاتەکان) بەکاردەهێت"

msgid "Email confirm"
msgstr ""
"ئیمەیڵ تێگەیشتن / یەکپارچه‌کردن "
"(تاییدکردنی ئیمەیڵ)"

msgid "Radios other"
msgstr "Radio yên din"

msgid "Composite element item format"
msgstr "فۆڕماتی هەڵبژاردەی یەکەی پێکهاتەیی"

