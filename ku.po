msgstr "تەلەفۆن — ژمارەی وەکالەت (کار)"

msgid "Telephone - mobile"
msgstr "تێلەفۆن - مۆبایل"

msgid "Telephone - fax"
msgstr "تەلەفۆن - فاکس"

msgid "Telephone - pager"
msgstr "Telefon - پیجر"

msgid "Telephone country code"
msgstr "کۆدی وڵات بۆ تەلەفۆن"

msgid "Telephone national code"
msgstr "کۆدی نیشتەمانەیی تەلەفۆن"

msgid "Telephone area code"
msgstr "کودێ ناوچەی تەلەفون"

msgid "Telephone local number"
msgstr "شماره‌ تلفنی محلی"

msgid "Telephone local prefix"
msgstr "پێش‌شماره‌ی ناوەندی (محلی)"

msgid "Telephone local suffix"
msgstr "پسوندی ناوچەیی بۆ تێلەفون"

msgid "Telephone extension"
msgstr "پارێزەی تەلەفون"

