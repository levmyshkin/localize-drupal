msgstr ""
"@label کە وەک ئەوەی یەکێکی تر ناسراوە "
"(aliased)"

msgid "Updated alias for %label @id."
msgstr ""
"ڕێکخستنی نوێ بۆ ناسنامەی دروستکراو "
"(alias) بۆ %label @id."

msgid "Updated 1 %label URL alias."
msgid_plural "Updated @count %label URL aliases."
msgstr[0] ""
"١ بۆزرایش کراوەی ١ %label بەئالیاسی URL.  "
"\n"
"%label بەئالیاسەکان لە  @count بۆزرایش "
"کراون."

