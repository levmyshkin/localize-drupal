msgstr ""
"<a href=\":update_status_report\">هرچه زودتر بروز "
"رسانی بۆ یک نسخهٔ جزئیِ پشتیبانی‌شده "
"انجام بده</a> تا به دریافت "
"به‌روزرسانی‌های امنیتی ادامه بدی."

msgid "Manages breakpoints and breakpoint groups for responsive designs."
msgstr ""
