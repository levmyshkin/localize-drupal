msgid "The text for the button that will proceed to the preview page."
msgstr ""
"முன்னோட்டப் "
"பக்கத்திற்குச் செல்லும் "
"பொத்தானுக்கு இருக்கும் "
"உரை."

msgid "The text for the button to go backwards from the preview page."
msgstr ""
"முன்னோட்டப் பக்கம் "
"இருந்து பின்செல்வதற்கான "
"பொத்தானின் உரை."

msgid "A message to be displayed on the preview page."
msgstr ""
"முன்னோட்டப் பக்கத்தில் "
"காட்டப்பட வேண்டிய ஒரு "
"செய்தி."

msgid "Submitted to: Entity title"
msgstr ""
"சமர்ப்பிக்கப்பட்டது: Entity "
"title"

msgid "Submitted to: Entity URL"
msgstr "சமர்ப்பிக்கப்பட்டது: Entity URL"

msgid "Default preview button label"
msgstr ""
"இயல்புநிலை முன்னோட்ட "
"பொத்தான் குறிச்சொல்"

msgid "Column options"
msgstr "நெடுவரிசை விருப்பங்கள்"

msgid "The selected columns will be included in the export."
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட "
"நெடுவரிசைகள் "
"ஏற்றுமதியில் "
"சேர்க்கப்படும்."

msgid "Number of submissions"
msgstr ""
"சமர்ப்பிப்புகளின் "
"எண்ணிக்கை"

msgid "Date list"
msgstr "தேதி பட்டியல்"

msgid "Entity autocomplete"
msgstr "என்டிட்டி தானாக பூரணம்"

msgid "Default base path"
msgstr "இயல்புநிலை அடிப்படை பாதை"

msgid "Default form exception message"
msgstr ""
"இயல்புநிலைய படிவ தவறுக் "
"குறிப்பு செய்தி"

msgid "Default draft button label"
msgstr ""
"இயல்பு வரைவு பொத்தான் "
"குறியீடு"

msgid "Default draft save message"
msgstr ""
"பெயரிடுங்கள் வரைவு "
"சேமிப்பு செய்தி"

msgid "Default draft load message"
msgstr ""
"இயல்புநிலையான முன்னூறல் "
"ஏற்றும் செய்தி"

msgid "Default confirmation message"
msgstr ""
"முன்னிருத்த "
"உறுதிப்படுத்தல் 메시지"

msgid "Default limit total message"
msgstr ""
"இயல்புநேர வரம்பு மொத்த "
"செய்தி"

msgid "Default limit user message"
msgstr "பொது வரம்பு பயனர் செய்தி"

msgid "Enable page"
msgstr "பக்கம் இயக்கவும்"

msgid "Page submit URL alias"
msgstr ""
"பக்கம் சமர்ப்பிக்கும் URL "
"மாற்றுப்பெயர்"

msgid "Page confirm URL alias"
msgstr ""
"பக்கம் உறுதிப்படுத்தும் "
"URL மாற்று பெயர்"

msgid "Form closed message"
msgstr "வடிவம் மூடியது செய்தி"

msgid "Form exception message"
msgstr "பற்றாக்குறி செய்திகள்"

msgid "Limit total submissions"
msgstr ""
"மொத்த சமர்ப்பிப்புகளில் "
"கட்டுப்பாடு வைக்கவும்"

msgid "Limit total message"
msgstr "மொத்த செய்தி அளவை வரையறு"

msgid "Limit user submissions"
msgstr ""
"பயனர் சமர்ப்பிப்புகளை "
"வரையறுக்கவும்"

msgid "Limit user message"
msgstr "பயனர் மெசேஜ் வரம்பிடுக"

msgid "Draft saved message"
msgstr ""
"வரைவுத் தொகுப்பு "
"சேமிக்கப்பட்ட செய்தி"

msgid "Message to be displayed when a draft is saved."
msgstr ""
"ஒரு வரைவைச் சேமித்தபோது "
"காண்பிக்கப்படும் செய்தி."

msgid "Draft loaded message"
msgstr ""
"வரையறுப்பு ஏற்றப்பட்டது "
"செய்திகள்"

msgid "Message to be displayed when a draft is loaded."
msgstr ""
"ஒரு வரைபடம் "
"ஏற்றப்படும்போது "
"காட்சியளிக்க வேண்டிய "
"செய்தி."

msgid "Is draft"
msgstr "வரைவு உள்ளது"

msgid "The submission language code."
msgstr ""
"சமர்ப்பிப்பு மொழி "
"குறியீடு."

msgid "Default closed message"
msgstr ""
"டிபால்ட் மூடப்பட்ட "
"செய்தி"

msgid "Default submit button label"
msgstr ""
"சாதாரணச் சமர்ப்பிக்கும் "
"பொத்தான் லேபிள்"

msgid "Completed and draft submissions"
msgstr ""
"முழுமையான மற்றும் "
"முயற்சி சமர்ப்பிப்புகள்"

msgid "Completed submissions only"
msgstr ""
"முடிக்கப்பட்ட இரசீது "
"மட்டுமே"

msgid "Number of submissions?"
msgstr ""
"சமர்ப்பிப்புக்களின் "
"எண்ணிக்கை?"

msgid "Deleted existing submissions."
msgstr ""
"இருந்து உள்ள "
"சமர்ப்பணங்கள் "
"நீக்கப்பட்டன."

msgid "1 submissions created."
msgid_plural "Finished creating @count submissions"
msgstr[0] ""
"1 சமர்ப்பிப்புகள் "
"உருவாக்கப்பட்டன.  \n"
"@count "
"சமர்ப்பிப்புகள் "
"உருவாக்குதல் முடிந்தது."

msgid "Batch export size"
msgstr "தொகுதி ஏற்றுமதி அளவு"

msgid "Batch update size"
msgstr "பேட்ச் மேம்படுத்தல் அளவு"

msgid "Batch delete size"
msgstr "தொகுதி நீக்கும் அளவு"

msgid ""
"Automatically save as draft when previewing and when there are "
"validation errors."
msgstr ""
"முன்னோட்டம் "
"பார்க்கும்போது மற்றும் "
"சரிபார்ப்பு பிழைகள் "
"இருந்தால் தானாகவே வரைவு "
"சேமிக்கப்படும்."

msgid ""
"Enter a <a href=\":form_api_href\">Form API (FAPI)</a> and/or a <a "
"href=\":render_api_href\">Render Array</a> as <a "
"href=\":yaml_href\">YAML</a>."
msgstr ""
"<a href=\":form_api_href\">Form API (FAPI)</a> "
"மற்றும்/அல்லது <a "
"href=\":render_api_href\">Render Array</a> ஐ <a "
"href=\":yaml_href\">YAML</a> ஆக உள்ளிடுக."

msgid "To email"
msgstr "மின்னஞ்சல் அனுப்ப"

msgid "Default submission data"
msgstr ""
"இயல்பான சமர்ப்பிப்பு "
"தரவு"

msgid "No messages are available."
msgstr "செய்திகள் இல்லை."

msgid "Resend message"
msgstr ""
"செய்தியை மீண்டும் "
"அனுப்பு"

msgid "Successfully re-sent %label."
msgstr ""
"%label ஐ வெற்றிகரமாக மீண்டும் "
"அனுப்பியது."

msgid "No more submissions are permitted."
msgstr ""
"மேலும் சமர்ப்பிப்புகள் "
"அனுமதிக்கப்படும் இல்லை."

msgid "Thank you for applying."
msgstr ""
"விண்ணப்பிக்க வந்ததற்கு "
"நன்றி."

