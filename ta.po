msgid "Broken/missing handler"
msgstr ""
"தடைபட்ட/காணாமற்பட்ட "
"கைார்க்கின்றவர்"

msgid "Current date"
msgstr "தற்போதைய தேதி"

msgid "Current node's creation time"
msgstr ""
"தற்போதைய நோடின் உருவாக்க "
"நேரம்"

msgid "Current node's update time"
msgstr ""
"நிகழ்கால நோட்டின் "
"மேம்படுத்திய நேரம்"

msgid "Do not display items with no value in summary"
msgstr ""
"செங்கட்டில் மதிப்பு "
"இல்லாத கூறுகளை காட்ட "
"வேண்டாம்"

msgid "Invalid input"
msgstr "தவறான உள்ளீடு"

msgid "Fail basic validation if any argument is given"
msgstr ""
"எது காரணமாக இருந்தாலும் "
"எந்தவொரு அArguments "
"வழங்கப்பட்டாலும் "
"அடிப்படை சரிபார்ப்பில் "
"தோல்வியடையவும்"

msgid ""
"By checking this field, you can use this to make sure views with more "
"arguments than necessary fail validation."
msgstr ""
"இந்த புலத்தை தேர்வு "
"செய்வதன் மூலம், "
"தேவையானதைவிட அதிகமான "
"வாதங்கள் கொண்ட பார்வைகள் "
"சரிபார்ப்பில் தேர்ச்சி "
"பெறாமையை உறுதிப்படுத்த "
"இது பயன்படுத்தலாம்."

msgid "Glossary mode"
msgstr "அகராதி முறையை"

msgid "Character limit"
msgstr "எழுத்து வரம்பு"

msgid "No transform"
msgstr "மாற்றமில்லை"

msgid "Upper case"
msgstr "மேல் அகரவரிசை"

msgid "Capitalize each word"
msgstr ""
"எல்லா வார்த்தைகளையும் "
"பெரிய அகரமுதலெழுத்துகளாக "
"எழுதுக"

msgid "Case in path"
msgstr "பாதையில் நிலை"

msgid "Transform spaces to dashes in URL"
msgstr ""
"URL இல் இடங்களை "
"குறிக்கோள்களாக மாற்றவும்"

msgid "Exclude from display"
msgstr ""
"காண்பிப்பில் இருந்து "
"விலக்கு"

msgid "Link path"
msgstr "இணைப்பு பாதை"

msgid ""
"The Drupal path or absolute URL for this link. You may enter data from "
"this view as per the \"Replacement patterns\" below."
msgstr ""
"இந்த இணைப்புக்கு Drupal பாதை "
"அல்லது முழு URL. கீழே உள்ள "
"\"மாற்றவியல்கள்\" படி "
"நீங்கள் இந்த "
"பார்வையிலிருந்து தரவை "
"உள்ளிடலாம்."

msgid "The CSS class to apply to the link."
msgstr ""
"இணைப்புக்கு "
"பொருந்தக்கூடிய CSS வகுப்பு."

msgid "Prefix text"
msgstr "முன்புற எழுத்து"

msgid "Any text to display before this link. You may include HTML."
msgstr ""
"இந்த இணைப்புக்குக் முன் "
"காட்ட வேண்டிய எந்தவொரு "
"உரையும். நீங்கள் HTML-ஐச் "
"சேர்க்கலாம்."

msgid "Suffix text"
msgstr "எழுத்தடை இறுதி உரை"

msgid "Any text to display after this link. You may include HTML."
msgstr ""
"இந்த இணைப்புக்கு பின் "
"காட்ட வேண்டிய எந்தவொரு "
"உரையும். நீங்கள் HTML "
"சேர்க்கலாம்."

msgid "Trim only on a word boundary"
msgstr ""
"வார்த்தை எல்லையின் மேல் "
"மட்டும்தான் குறைக்கவும்"

msgid ""
"If checked, this field be trimmed only on a word boundary. This is "
"guaranteed to be the maximum characters stated or less. If there are "
"no word boundaries this could trim a field to nothing."
msgstr ""
"தேர்ந்தெடுக்கப்பட்டிருந்தால், "
"இந்த поле சொல் எல்லையில் "
"மட்டுமே குறைக்கப்படும். "
"இது குறிப்பிடப்பட்ட "
"அதிகபட்ச எழுத்துக்களை "
"அல்லது அதற்கு குறைவாக "
"இருப்பதை "
"உறுதிப்படுத்தும். சொல் "
"எல்லைகள் "
"இல்லாதிருந்தால், இந்த "
"குறைப்பு поле வெறுமனே "
"ஆகும்."

msgid "Strip HTML tags"
msgstr "HTML குறிச்சொற்களை நீக்கு"

msgid "Field can contain HTML"
msgstr "புலம் HTML உட்படக்கூடும்"

msgid "File size display"
msgstr ""
"கோப்பு அளவு "
"காட்சிப்படுத்துதல்"

msgid "Formatted (in KB or MB)"
msgstr ""
"படிவமைக்கப்பட்டது (கே.பி "
"அல்லது எம்.பி இல்)"

msgid "Raw bytes"
msgstr "மூல பைட்கள்"

msgid "If checked, true will be displayed as false."
msgstr ""
"சேகரிக்கப்பட்டால், true "
"என்பது false என்று "
"காட்டப்படும்."

msgid "Time ago (with \"ago\" appended)"
msgstr ""
"காலம்திற் முன்பு (முன்பு "
"என்ற வார்த்தையுடன்)"

msgid "Time span (with \"ago/hence\" appended)"
msgstr ""
"நாட்கள் (இடையில் "
"\"முன்/பின்னர்\" "
"சேர்க்கப்பட்டது)"

msgid "Round"
msgstr "முழுகை"

msgid "If checked, the number will be rounded."
msgstr ""
"சரிபார்க்கப்பட்டால், "
"எண்ணிக்கை "
"வட்டமாக்கப்படும்."

msgid "Specify how many digits to print after the decimal point."
msgstr ""
"தசம புள்ளிக்குப் பிறகு "
"எத்தனை இலக்கங்களை அச்சிட "
"வேண்டும் مشخصி செய்யவும்."

msgid "What single character to use as a decimal point."
msgstr ""
"தசமக் குறியாக எந்த ஒரு "
"எழுத்தைப் பயன்படுத்த "
"வேண்டும் என்பதை."

msgid "What single character to use as the thousands separator."
msgstr ""
"ஆயிரக்கணக்கான பிரிவாளர் "
"ஆக எந்த ஒரே எழுத்தை "
"பயன்படுத்துவது."

msgid "Text to put before the number, such as currency symbol."
msgstr ""
"எண் முன்னர் இடப்பட "
"வேண்டிய எழுத்துக்கள், "
"உதாரணமாக நாணயச் சின்னம்."

msgid "Text to put after the number, such as currency symbol."
msgstr ""
"எண் பின்னர் வைக்க வேண்டிய "
"உரை, உதாரணமாக பண "
"மதிப்பீட்டு சின்னம்."

msgid "Simple separator"
msgstr "எளிய பிரிவாக்கி"

msgid "Display as link"
msgstr ""
"இணைப்பாக "
"காட்சியமைக்கவும்"

msgid "Operator identifier"
msgstr "செயல் குறியீட்டாளர்"

msgid "This will appear in the URL after the ? to identify this operator."
msgstr ""
"?க்கு பிறகு இந்த இயக்கியை "
"அடையாளங்காண URL இல் இதுவாக "
"தோன்றும்."

msgid "Filter identifier"
msgstr "ஃபில்டர் அடையாளம்"

msgid ""
"This exposed filter is optional and will have added options to allow "
"it not to be set."
msgstr ""
"இந்த வெளிப்படுத்தப்பட்ட "
"வடிகட்டி விருப்பமானது "
"ஆகும் மற்றும் அதை "
"அமைக்கப்பட வேண்டாமென்று "
"அனுமதிக்க கூடுதல் "
"விருப்பங்களுடன் "
"இருக்கும்."

msgid "Remember"
msgstr "நினைவில் வையுங்கள்"

msgid "Remember the last setting the user gave this filter."
msgstr ""
"பயனர் இறுதியாக இந்த "
"வடிகட்டிக்கு கொடுத்த "
"அமைப்பை நினைவில் "
"வையுங்கள்."

msgid "The identifier is required if the filter is exposed."
msgstr ""
"ஐடியென்டிபையர் தேவையானது "
"என்றால் தான் வடிகட்டி "
"வெளிப்படுத்தப்பட்டிருக்கும்."

msgid "This identifier is not allowed."
msgstr ""
"இந்த அடையாளம் "
"அனுமதிக்கப்படவில்லை."

msgid "- Any -"
msgstr "- எந்தவொரு -"

msgid "exposed"
msgstr "திறந்த"

msgid "Value type"
msgstr "மதிப்புகளின் வகை"

msgid ""
"A date in any machine readable format. CCYY-MM-DD HH:MM:SS is "
"preferred."
msgstr ""
"எந்த இயந்திரம் "
"வாசிக்கக்கூடிய "
"வடிவத்திலும் ஒரு தேதி. "
"CCYY-MM-DD HH:MM:SS என்பது "
"விருப்பமாகும்."

msgid "Invalid date format."
msgstr "தவறான தேதிக்கான வடிவம்."

msgid "Limit list to selected items"
msgstr ""
"பட்டியலை "
"தேர்ந்தெடுக்கப்பட்ட "
"பொருட்களுக்கு மட்டும் "
"வரையறுக்கவும்"

msgid ""
"If checked, the only items presented to the user will be the ones "
"selected here."
msgstr ""
"தேர்ந்தெடுக்கப்பட்டிருப்பின், "
"பயனருக்கு காட்சி "
"அளிக்கப்படும் தனி "
"பொருட்கள் இங்கே "
"தேர்ந்தெடுக்கப்பட்டவையே "
"ஆகும்."

msgid "not in"
msgstr "இல்லை"

msgid "<>"
msgstr "<>"

msgid "Is all of"
msgstr "அனைத்தும்"

msgid "Is none of"
msgstr "ஏதுமில்லை"

msgid "not"
msgstr "இல்லை"

msgid "<"
msgstr "<"

msgid "<="
msgstr "<="

msgid ">="
msgstr ">="

msgid ">"
msgstr ">"

msgid "Is between"
msgstr "இடையில் உள்ளது"

msgid "between"
msgstr "இடையில்"

msgid "Is not between"
msgstr "இது இடையில் இல்லை"

msgid "not between"
msgstr "மற்றும் இடையில் இல்லை"

msgid "Min"
msgstr "மின்"

msgid "And max"
msgstr "மற்றும் அதிகபட்சம்"

msgid "And"
msgstr "மற்றும்"

msgid "Contains any word"
msgstr "ஏதேனும் வார்த்தை கொண்டது"

msgid "has word"
msgstr "சொல் உள்ளது"

msgid "Contains all words"
msgstr ""
"அனைத்து சொற்களையும் "
"கொண்டுள்ளது"

msgid "has all"
msgstr "அனைத்தையும் கொண்டுள்ளது"

msgid "begins"
msgstr "தொடங்குகிறது"

msgid "ends"
msgstr "அன முடிகிறது"

msgid "!has"
msgstr "!உள்ளதில்லை"

msgid "Require this relationship"
msgstr "இந்த தொடர்பு அவசியம்"

msgid "asc"
msgstr "asc"

msgid "desc"
msgstr "விளக்கம்"

msgid ""
"The granularity is the smallest unit to use when determining whether "
"two dates are the same; for example, if the granularity is \"Year\" "
"then all dates in 1999, regardless of when they fall in 1999, will be "
"considered the same date."
msgstr ""
"கிரானுலாரிட்டி என்பது "
"இரண்டு தேதிகள் ஒரேதே என "
"கணக்கிடும் போது "
"பயன்படுத்தும் மிகக் "
"குறைந்த அலகாகும்; "
"எடுத்துக்காட்டாக, "
"கிரானுலாரிட்டி \"ஆண்டு\" "
"என்றால், 1999 ஆம் ஆண்டில் "
"எந்த நாளில் இருந்தாலும் "
"அத்தேதிகள் எல்லாம் "
"ஒரேதேடியிலெனக் "
"கருதப்படும்."

msgid "Broken"
msgstr "தகர்ந்தது"

msgid "Displays"
msgstr "காட்டுகிறது"

msgid "These queries were run during view rendering:"
msgstr ""
"இந்தக் கேள்விகள் "
"காட்சிப்படுத்தும் போது "
"இயக்கப்பட்டன:"

msgid "This display has no path."
msgstr ""
"இந்த காட்சிக்கு பாதை "
"இல்லை."

msgid "Query build time"
msgstr "குவரி கட்டும் நேரம்"

msgid "@time ms"
msgstr "@time மிவி"

msgid "Query execute time"
msgstr "குளோரி செயல்படும் நேரம்"

msgid "View render time"
msgstr "காண்க ரெண்டர் நேரம்"

msgid "No query was run"
msgstr "வேண்டுகோள்கள் ஓடவில்லை"

msgid "Unable to preview due to validation errors."
msgstr ""
"சரிபார்ப்பு பிழைகள் "
"காரணமாக முன்னோட்டம் "
"காட்ட முடியவில்லை."

msgid "View name"
msgstr "நோக்குமுறை பெயர்"

msgid "Break lock"
msgstr "பூட்டை உடை"

msgid "The lock has been broken and you may now edit this view."
msgstr ""
"கதவை உடைத்துவிட்டது, "
"இப்போது நீங்கள் இந்த "
"காட்சியை தொகுக்கும் "
"முடியும்."

msgid "Go to the real page for this display"
msgstr ""
"இந்த காட்சிக்கான "
"உண்மையான பக்கத்துக்கு "
"செல்லவும்"

msgid "Missing style plugin"
msgstr "மறைந்த ஸ்டைல் பிளகின்"

msgid "Change settings for this style"
msgstr ""
"இந்த stைலுக்கான அமைப்புகளை "
"மாற்றவும்"

msgid "View analysis"
msgstr "பகுப்பாய்வை காண்க"

msgid "Rearrange @type"
msgstr "@typeஐ மறுசீரமைக்கவும்"

msgid "Broken field @id"
msgstr "உடைந்த புலம் @id"

msgid "There are no @types available to add."
msgstr ""
"சேர்ப்பதற்கு எந்த "
"@typesகளும் கிடைக்கவில்லை"

msgid "Configure extra settings for @type %item"
msgstr ""
"@type %item க்கான கூடுதல் "
"அமைப்புகளை கட்டமைக்கவும்"

msgid "Clear Views' cache"
msgstr ""
"Views-இன் cache-ஐ சுத்தம் "
"செய்யுங்கள்"

msgid "Add Views signature to all SQL queries"
msgstr ""
"எல்லா SQL கேள்விகளுக்கும் "
"Views கையொப்பத்தை "
"சேர்க்கவும்"

msgid "Show other queries run during render during live preview"
msgstr ""
"இழையின் நேரடி "
"முன்னோட்டத்தின் போது "
"இயக்கப்பட்ட பிற "
"வினாக்களையும் காட்டு"

msgid ""
"Drupal has the potential to run many queries while a view is being "
"rendered. Checking this box will display every query run during view "
"render as part of the live preview."
msgstr ""
"Drupal ஒரு காணொளி "
"உருவாக்கப்படும்போது பல "
"கேள்விகளை இயக்கும் திறன் "
"கொண்டது. இந்த பெட்டியை "
"தேர்ந்தெடுப்பதன் மூலம் "
"காணொளி உருவாக்கத்தின் "
"போது இயங்கும் ஒவ்வொரு "
"கேள்வியையும் நேரடி "
"முன்னோட்டத்தில் "
"காண்பிக்கும்."

msgid "View analysis can find nothing to report."
msgstr ""
"View பகுப்பாய்வில் எதையும் "
"அறிக்கை செய்ய எதுவும் "
"கிடைக்கவில்லை."

msgid ""
"This view has only a default display and therefore will not be placed "
"anywhere on your site; perhaps you want to add a page or a block "
"display."
msgstr ""
"இந்த பார்வைக்கு "
"இயல்புநிலை "
"காட்சிப்படுத்தல் மட்டுமே "
"உள்ளது, ஆகையால் இது உங்கள் "
"தளத்தில் எங்கும் "
"அமைக்கப்படாது; நீங்கள் "
"ஒரு பக்கம் அல்லது ஒரு "
"பிளாக் "
"காட்சிப்படுத்தலைச் "
"சேர்ந்த சேர்க்க "
"விரும்புகிறீர்களாகலாம்."

msgid "Reduce duplicates"
msgstr "பிரதிகள் குறைக்கவும்"

msgid "Default settings for this view."
msgstr ""
"இந்த பார்வைக்கான "
"இயல்புநிலைகள்."

msgid "Display the view as a page, with a URL and menu links."
msgstr ""
"எந்தவொரு URL மற்றும் மெனு "
"இணைப்புகளுடன் அந்த "
"காட்சியை ஒரு பக்கமாகக் "
"காட்டு."

msgid "Display the view as a block."
msgstr ""
"காட்சி வழுவைப் பகுதியாக "
"காட்டு."

msgid ""
"Attachments added to other displays to achieve multiple views in the "
"same view."
msgstr ""
"அதே காட்சியில் பல "
"காட்சிகளை பெற மற்ற "
"காட்சிகளுக்கு இணைப்புகள் "
"சேர்க்கப்பட்டன."

msgid "Display the view as a feed, such as an RSS feed."
msgstr ""
"காட்சி ஒரு ஃபீட்டாகக் "
"காட்டவும், உதாரணமாக RSS "
"ஃபீடு."

msgid "Displays rows one after another."
msgstr ""
"ஒரு வரியின் பிறகு மற்றொரு "
"வரி தொடர்ச்சியாக "
"காண்பிக்கிறது."

msgid "HTML List"
msgstr "HTML பட்டியல்"

msgid "Displays rows in a grid."
msgstr ""
"ஒரு கிரிட் வடிவத்தில் "
"வரிசைகள் காட்டு "
"தொடங்குகிறது."

msgid "Displays rows in a table."
msgstr ""
"ஒரு அட்டவணையில் வரிசைகளை "
"காட்டு."

msgid "Displays the default summary as a list."
msgstr ""
"இயல்புநிலை சுருக்கத்தை "
"பட்டியலாகக் காட்டுகிறது."

msgid ""
"Displays the summary unformatted, with option for one after another or "
"inline."
msgstr ""
"சுருக்கத்தை "
"வடிவமைக்காமல் "
"காட்டுகிறது, ஒன்றுக்குப் "
"பின் ஒன்றாகவோ அல்லது "
"வரிசையாகவோ தெரிவு "
"செய்யும் விருப்பத்துடன்."

msgid "Generates an RSS feed from a view."
msgstr ""
"ஒரு பார்வையிலிருந்து RSS "
"பீடை உருவாக்குகிறது."

msgid "Displays the fields with an optional template."
msgstr ""
"விருப்பமான "
"வார்ப்புருவுடன் புலங்களை "
"காட்சியிடுகிறது."

msgid "Will be available to all users."
msgstr ""
"எல்லா பயனர்களுக்கும் "
"கிடைக்கும்தாக இருக்கும்."

msgid "Access will be granted to users with any of the specified roles."
msgstr ""
"அணுகல் குறிப்பிடப்பட்ட "
"எந்தவொரு "
"பங்களிப்பாளர்களுக்கும் "
"வழங்கப்படும்."

msgid "No caching of Views data."
msgstr ""
"Views தரவுகளுக்கு எந்த "
"காசேிங் இல்லை."

msgid "Time-based"
msgstr ""
"நேரத்தை அடிப்படையாக "
"கொண்ட"

msgid "Simple time-based caching of data."
msgstr ""
"தரவுகளை நேர "
"அடிப்படையிலான எளிய கேஷ் "
"சேமிப்பு."

msgid "sort criteria"
msgstr "வரிசைப்படுத்தும் விதிகள்"

msgid "Sort criterion"
msgstr ""
"ஒழுங்குபடுத்தும் "
"நிபந்தனை"

msgid "sort criterion"
msgstr "வரிசை அளவுகோல்"

msgid "The title of the comment."
msgstr "கருத்தின் தலைப்பு."

msgid ""
"The name of the comment's author. Can be rendered as a link to the "
"author's homepage."
msgstr ""
"கருத்தாய்த் தேர்வாளரின் "
"பெயர். எழுத்தாளரின் "
"முகப்புப் பக்கத்துக்கு "
"இணைப்பாக காட்டப்படலாம்."

msgid ""
"The website address of the comment's author. Can be rendered as a "
"link. Will be empty if the author is a registered user."
msgstr ""
"கருத்து எழுத்தாளரின் "
"வலைத்தளம். இது ஒரு "
"இணைப்பாக காட்டப்படலாம். "
"எழுத்தாளர் பதிவு செய்த "
"பயனர் என்றால் இது காலியாக "
"இருக்கும்."

msgid "Post date"
msgstr "பதிவு தேதி"

msgid "Node link"
msgstr "கிளைப்பு இணைப்பு"

msgid "The User ID of the comment's author."
msgstr ""
"கருத்துரையின் ஆசிரியரின் "
"பயனர் ஐடி."

msgid "Parent CID"
msgstr "பெற்றோர் CID"

msgid "Last comment time"
msgstr "பிறந்த கருத்து நேரம்"

msgid "Date and time of when the last comment was posted."
msgstr ""
"கடைசி கருத்து பதிவு "
"செய்யப்பட்ட தேதி மற்றும் "
"நேரம்."

msgid "Last comment author"
msgstr "கடைசி கருத்து எழுத்தாளர்"

msgid "The name of the author of the last posted comment."
msgstr ""
"கடந்தயமான பதிவுசெய்த "
"கருத்தின் ஆசிரியரின் "
"பெயர்."

msgid "Comment count"
msgstr "மொத்த கருத்துகள்"

msgid "Updated/commented date"
msgstr ""
"புதுப்பிக்கப்பட்ட/கருத்துசெய்யப்பட்ட "
"தேதி"

msgid "The number of new comments on the node."
msgstr ""
"node-ல் உள்ள புதிய "
"கருத்துக்களின் "
"எண்ணிக்கை."

msgid "Comment status"
msgstr "கருத்து நிலை"

msgid "User posted or commented"
msgstr ""
"பயனர் பதிவு செய்தார் "
"அல்லது கருத்து "
"தெரிவித்தார்"

msgid "Display the comment as RSS."
msgstr ""
"கருத்தை RSS ஆக "
"காட்சிப்படுத்து."

msgid "Provide a simple link to the user contact page."
msgstr ""
"பயனர் தொடர்பு "
"பக்கத்திற்கு எளிய ஒரு "
"இணைப்பை வழங்கவும்."

msgid "Created year + month"
msgstr ""
"உருவாக்கப்பட்ட ஆண்டு + "
"மாதம்"

msgid "Created year"
msgstr "உருவாக்கப்பட்டது ஆண்டு"

msgid "Created month"
msgstr "உருவாக்கப்பட்டது மாதம்"

msgid "Created day"
msgstr "உருவாக்கப்பட்டது நாள்"

msgid "Created week"
msgstr "உருவாக்கப்பட்டது வாரம்"

msgid "Updated year + month"
msgstr ""
"புதுப்பிக்கப்பட்ட ஆண்டு + "
"மாதம்"

msgid "Updated year"
msgstr "புதுப்பிக்கப்பட்ட ஆண்டு"

msgid "Updated month"
msgstr "புதுப்பிக்கப்பட்ட மாதம்"

msgid "Updated day"
msgstr "புதுப்பிக்கப்பட்ட நாள்"

msgid "Updated week"
msgstr "புதுப்பிக்கப்பட்ட வாரம்"

msgid "Provide a simple link to revert to the revision."
msgstr ""
"மறுஇடத்தில் திரும்ப.simple "
"குறுக்கு இணைப்பை "
"வழங்கவும்."

msgid "Filter by access."
msgstr ""
"அணுக்கத்தைப் பொறுத்து "
"வடிகட்டவும்."

msgid "Has new content"
msgstr "புதிய உள்ளடக்கம் உள்ளது"

msgid ""
"Display %display has no access control but does not contain a filter "
"for published nodes."
msgstr ""
"காட்சி %display-க்கு அணுகல் "
"கட்டுப்பாடு இல்லை ஆனால் "
"அது வெளியிடப்பட்ட "
"நோட்களுக்கு ஒரு "
"வடிகட்டியை "
"கொண்டிருக்காது."

msgid ""
"The score of the search item. This will not be used if the search "
"filter is not also present."
msgstr ""
"தேடல் பொருளின் மதிப்பெண். "
"தேடல் வடிகட்டியும் "
"இல்லையெனில் இது "
"பயன்படுத்தப்படாது."

msgid "Files maintained by Drupal and various modules."
msgstr ""
"Drupal மற்றும் பல்வேறு "
"மாட்யூல்கள் பராமரி "
"செய்படும் கோப்புகள்."

msgid "Taxonomy terms are attached to nodes."
msgstr ""
"வருமுறைத் தாள்கள் "
"நோட்களுக்கு "
"இணைக்கப்பெறுகின்றன."

msgid "Filter the results of \"Taxonomy: Term\" to a particular vocabulary."
msgstr ""
"\"Taxonomy: Term\" என்பதன் முடிவுகளை "
"ஒரு குறிப்பிட்ட சொல் "
"தொகுப்புக்குள் "
"வடிகட்டவும்."

msgid ""
"Display all taxonomy terms associated with a node from specified "
"vocabularies."
msgstr ""
"குறிக்கப்பட்ட "
"சொற்பிரகரங்களிலிருந்து "
"ஒரு நோட்டுடன் தொடர்புடைய "
"அனைத்து வர்க்க "
"வினாக்களையும் காட்டு."

msgid ""
"The parent term of the term. This can produce duplicate entries if you "
"are using a vocabulary that allows multiple parents."
msgstr ""
"தொற்றறையின் பெற்ற terms. "
"நீங்கள் பல பெற்ற term-களை "
"அனுமதிக்கும் சொற்பொருள் "
"தொகுப்பைப் "
"பயன்படுத்தினால் இது நகல் "
"பதிவுகளை உருவாக்கலாம்."

msgid "The user ID"
msgstr "பயனர் ஐடி"

msgid "The user or author name."
msgstr ""
"பயனர் அல்லது ஆசிரியர் "
"பெயர்."

msgid ""
"Email address for a given user. This field is normally not shown to "
"users, so be cautious when using it."
msgstr ""
"கொடுக்கப்பட்ட பயனருக்கான "
"மின்னஞ்சல் முகவரி. இந்த "
"புலம் சாதாரணமாக "
"பயனர்களுக்கு "
"காட்டப்படாது, ஆகவே இதை "
"பயன்படுத்தும்போது கவனமாக "
"இருங்கள்."

msgid "User ID from URL"
msgstr "URL இலிருந்து பயனர் ஐடி"

msgid "User ID from logged in user"
msgstr ""
"புகுபதிகை செய்யப்பட்ட "
"பயனரின் பயனர் ஐ.டி."

msgid "Randomize the display order."
msgstr ""
"காட்சிப்படுத்தும் "
"வரிசையை சீர்மாறாக்கவும்."

msgid "Null"
msgstr ""
"நீங்கள் வழங்கிய உரையில் "
"மொழிபெயர்க்க வேண்டிய "
"பகுதி \"Null\" ஆகும், இது "
"கொள்ளளவு அல்லது பொருள் "
"இல்லாமல் சொல்கிறது. இதை "
"தமிழில் \"இல்லை\" அல்லது "
"\"நுண்ணிய பயனில்லை\" எனக் "
"கூறலாம். \n"
"\n"
"எனவே, உங்கள் "
"குறிப்பிட்ட உரையின் "
"தமிழில் "
"மொழிபெயர்ப்பு:\n"
"\n"
"Null -> "
"\"இல்லை\""

msgid "Provide custom text or link."
msgstr ""
"தனிப்பயன் உரை அல்லது "
"இணைப்பை வழங்குக."

msgid "View result counter"
msgstr "முடிவுக்கணக்கை காண்க"

msgid "Displays the actual position of the view result"
msgstr ""
"காட்சிப் பயிரின் "
"உண்மையான நிலையை "
"காட்டுகிறது"

msgid "No user"
msgstr "பயனர் இல்லை"

msgid "Show teaser-style link"
msgstr ""
"டீசர்-உடையான இணைப்பை "
"காட்டு"

msgid "Link this field to new comments"
msgstr ""
"இந்தப் புலத்தை புதிய "
"கருத்துக்களுக்கு "
"இணைக்கவும்"

msgid "contact"
msgstr "தொடர்பு"

msgid "Contact %user"
msgstr "தொடர்பு கொள்ள %user"

msgid "Unknown language"
msgstr "அறியப்படாத மொழி"

msgid "Check for new comments as well"
msgstr ""
"புதிய கருத்துக்களும் "
"உள்ளது என்று "
"சரிபார்க்கவும்"

msgid "Alternative sort"
msgstr "மாற்றுப்பார்வை வரிசை"

msgid "Alternate sort order"
msgstr ""
"மாற்று வரிசைப்படுத்தல் "
"ஒழுங்கு"

msgid "On empty input"
msgstr "காலியான உள்ளீட்டில்"

msgid "Show None"
msgstr "எதையும் காட்ட வேண்டாம்"

msgid ""
"Search for either of the two terms with uppercase <strong>OR</strong>. "
"For example, <strong>cats OR dogs</strong>."
msgstr ""
"<strong>OR</strong> பயன்படுத்து "
"முன்பட்ட இரு சொற்களில் "
"எதையாவது தேடவும். "
"உதாரணமாக, <strong>cats OR dogs</strong>."

msgid "Display score"
msgstr "மதிப்பெண்களை காட்டு"

msgid "Link this field to download the file"
msgstr ""
"இந்த புலத்துடன் இணைத்து "
"கோப்பை பதிவிறக்கவும்"

msgid ""
"The depth will match nodes tagged with terms in the hierarchy. For "
"example, if you have the term \"fruit\" and a child term \"apple\", "
"with a depth of 1 (or higher) then filtering for the term \"fruit\" "
"will get nodes that are tagged with \"apple\" as well as \"fruit\". If "
"negative, the reverse is true; searching for \"apple\" will also pick "
"up nodes tagged with \"fruit\" if depth is -1 (or lower)."
msgstr ""
"அழுத்தம் தகுந்த "
"அடிப்படையில், "
"விகிதாசாரத்தில் "
"குறிக்கப்பட்ட சொற்களுடன் "
"டேக் செய்யப்பட்ட "
"கட்டங்களுடன் பொருந்தும். "
"உதாரணமாக, \"பழம்\" என்ற சொல் "
"மற்றும் அதன் கீழ் சொல் "
"\"ஆப்பிள்\" இருந்தால், "
"மற்றும் அழுத்தம் 1 (அല്ലது "
"அதற்கு மேலான) என்றால், "
"\"பழம்\" என்ற சொல்லுக்கான "
"வடிகட்டல் \"ஆப்பிள்\" "
"மற்றும் \"பழம்\" என்று டேக் "
"செய்யப்பட்ட கட்டங்களை "
"பெறும். எதிர்மறையானால், "
"இது எதிர்மறையாகும்; "
"\"ஆப்பிள்\" என்பதற்கு தேடல் "
"செய்யும்போது, அழுத்தம் -1 "
"(அல்லது அதற்கு குறைவான) "
"என்றால் \"பழம்\" என்று டேக் "
"செய்யப்பட்ட "
"கட்டங்களையும் பெறும்."

msgid "Link this field to its term page"
msgstr ""
"இந்த ஃபீல்டை அதன் பாைஜ் "
"பக்கத்துடன் இணைக்கவும்"

msgid "Limit terms by vocabulary"
msgstr ""
"பொருத்தமான சொல் "
"தொகுப்புகளால் வரையறு"

msgid "Select which vocabulary to show terms for in the regular options."
msgstr ""
"சாதாரண விருப்பங்களில் "
"எந்த சொற்களின் அகராதியை "
"காட்ட வேண்டுமో "
"தேர்ந்தெடுக்கவும்."

msgid "Dropdown"
msgstr "தடவுச்சீட்டு பட்டி"

msgid "Show hierarchy in dropdown"
msgstr ""
"உருப்படியில் வரிசை "
"காட்டவும்"

msgid "Select terms from vocabulary @voc"
msgstr ""
"வொகாபுலரி @voc இல் இருந்து "
"சொற்களை "
"தேர்ந்தெடுக்கவும்"

msgid "Select terms"
msgstr ""
"விருப்ப வார்த்தைகள் "
"தேர்வு செய்க"

msgid "Is the logged in user"
msgstr "உள்நுழைந்த பயனர்"

msgid "Usernames"
msgstr "பயனர் பெயர்கள்"

msgid "Enter a comma separated list of user names."
msgstr ""
"பயனர் பெயர்களின் "
"வெருவிரல் பட்டியலை "
"உள்ளிடுக."

msgid "Also look for a node and use the node author"
msgstr ""
"மேலும் ஒரு நோடைத் தேடவும் "
"மற்றும் நோட்டு "
"ஆசிரியரைப் "
"பயன்படுத்தவும்"

msgid "Restrict user based on role"
msgstr ""
"பользувачின் பங்கு "
"அடிப்படையில் பயனர் "
"வரம்பிடு"

msgid "Restrict to the selected roles"
msgstr ""
"தேர்ந்தெடுத்த "
"வேடிக்கைகளுக்கு "
"மட்டுப்படுத்துக"

msgid "If no roles are selected, users from any role will be allowed."
msgstr ""
"ஒரு வேட்புமன்றமும் "
"தேர்ந்தெடுக்கப்படவில்லை "
"என்றால், எந்த "
"வேட்புமன்றம் இருந்தும் "
"பயனர்கள் "
"அனுமதிக்கப்படும்."

msgid "Unrestricted"
msgstr "அவர்த்தனமற்ற"

msgid "No role(s) selected"
msgstr ""
"எந்த பங்கு(களும்) "
"தேர்வுசெய்யப்படவில்லை"

msgid "You must select at least one role if type is \"by role\""
msgstr ""
"\"by role\" என்ற வகை ஆகில், "
"குறைந்தது ஒரு "
"பாத்திரத்தை தேர்வு செய்ய "
"வேண்டும்."

msgid "PHP validate code"
msgstr "PHP சரிபார்ப்பு குறியீடு"

msgid "Never cache"
msgstr "எந்தவிதம் சேமிப்பதில்லை"

msgid "Query results"
msgstr "வினவல் முடிவுகள்"

msgid "The length of time raw query results should be cached."
msgstr ""
"கச்சா கேள்வி முடிவுகள் "
"எவ்வளவு நேரம் கேச் "
"செய்யப்பட வேண்டும்."

msgid "Rendered output"
msgstr ""
"மொழிபெயர்க்கப்பட்ட "
"வெளியீடு"

msgid "The length of time rendered HTML output should be cached."
msgstr ""
"ரெண்டர் செய்யப்பட்ட HTML "
"வெளியீட்டுகள் எவ்வளவு "
"காலம் கேஷ் செய்யப்பட "
"வேண்டும்."

msgid "Broken field"
msgstr "இறக்கப்பட்ட புலம்"

msgid "Change the title that this display will use."
msgstr ""
"இந்த காட்சியில் "
"பயன்படுத்தப்படும் "
"தலைப்பை மாற்றவும்."

msgid "Use AJAX"
msgstr "AJAX பயன்படுத்தவும்"

msgid "Change whether or not this display will use AJAX."
msgstr ""
"இந்த காட்சிப் பகுதியின் AJAX "
"பயன்படுத்தும் அல்லது "
"பயன்படுத்தாததை "
"மாற்றவும்."

msgid "Mini"
msgstr "சிறிய"

msgid "Change this display's pager setting."
msgstr ""
"இந்த காட்சியின் பேஜர் "
"அமைப்பை மாற்றுக."

msgid "Specify whether this display will provide a \"more\" link."
msgstr ""
"இந்த காட்சிப்படுத்தல் "
"\"மேலும்\" என்ற இணைப்பை "
"வழங்குமா என்பதைக் "
"குறிப்பிடவும்."

msgid "Specify access control type for this display."
msgstr ""
"இந்த காட்சி için அணுகல் "
"கட்டுப்பாட்டு வகையை "
"குறிப்பிடுக."

msgid "Change settings for this access type."
msgstr ""
"இந்த அணுகல் வகைக்கான "
"அமைப்புகளை மாற்றவும்."

msgid "Specify caching type for this display."
msgstr ""
"இந்த காட்சி க்கான "
"கேச்சிங் வகையை "
"குறிப்பிடவும்."

msgid "Change settings for this caching type."
msgstr ""
"இந்த கேச்சிங் வகைக்கு "
"அமைப்புகளை மாற்றவும்."

msgid "Link display"
msgstr "கண்ணோட்ட இணைப்பு"

msgid "Exposed form in block"
msgstr ""
"ப்ளாக்கில் "
"வெளிப்படுத்தப்பட்ட "
"படிவம்"

msgid "Allow the exposed form to appear in a block instead of the view."
msgstr ""
"வியூவில் காட்டுமாறாக, "
"வெளிப்படுத்தப்பட்ட "
"படிவம் ஒரு பிளாகில் தோன்ற "
"அனுமதிக்கவும்."

msgid "The title of this view"
msgstr "இந்த பார்வையின் தலைப்பு"

msgid ""
"This title will be displayed with the view, wherever titles are "
"normally displayed; i.e, as the page title, block title, etc."
msgstr ""
"இந்த தலைப்பு பார்வை "
"வழங்கப்படும் இடங்களில், "
"பொதுவாக தலைப்புகள் "
"காட்டப்படும் இடங்களில் "
"காட்டப்படும்; உதாரணமாக, "
"பக்க தலைப்பு, கட்டிடம் "
"தலைப்பு மற்றும் பிற "
"இடங்களில்."

msgid ""
"Unless you're experiencing problems with pagers related to this view, "
"you should leave this at 0. If using multiple pagers on one page you "
"may need to set this number to a higher value so as not to conflict "
"within the ?page= array. Large values will add a lot of commas to your "
"URLs, so avoid if possible."
msgstr ""
"நீங்கள் இந்த பார்வை "
"தொடர்புடைய பேஜர்கள் "
"குறித்த பிரச்சனைகளை "
"எதிர்கொள்ளவில்லை "
"என்றால், இதை 0 ஆகவே விட "
"வேண்டும். ஒரு பக்கத்தில் "
"பல பேஜர்கள் "
"பயன்படுத்தும்போது, ?page= "
"வரிசையில் மோதல் "
"ஏற்படாமல் இதனை அதிகமான "
"மதிப்பாக அமைக்க வேண்டி "
"வரும். பெரிய மதிப்புகள் "
"உங்கள் URL-களில் நிறைய "
"காமாக்கள் சேர்க்கும், "
"ஆகையால் சாத்தியமானால் "
"தவிர்க்கவும்."

msgid "Add a more link to the bottom of the display."
msgstr ""
"காட்டியின் கீழே மேலும் "
"இணைப்பைச் சேர்க்கவும்."

msgid "Create more link"
msgstr "மேலும் இணைப்பு உருவாக்கு"

msgid "The text to display for the more link."
msgstr ""
"மேலும் இணைப்பிற்கான "
"காட்ட-text."

msgid ""
"This will make the view display only distinct items. If there are "
"multiple identical items, each will be displayed only once. You can "
"use this to try and remove duplicates from a view, though it does not "
"always work. Note that this can slow queries down, so use it with "
"caution."
msgstr ""
"இது பார்வையில் "
"தனித்துவமான பொருட்களே "
"மட்டும் காட்டப்படும். ஒரே "
"மாதிரியான பல பொருட்கள் "
"இருந்தால், அவை "
"ஒவ்வொன்றும் ஒருமுறை "
"மட்டும் காட்டப்படும். இது "
"ஒரு பார்வையில் "
"நகல்பொருட்களை நீக்க "
"முயற்சிக்க "
"பயன்படுத்தலாம், ஆனாலும் "
"இது எப்போதும் வேலை "
"செய்யாது. இது வினவிகளை "
"மெதுவாக்கும் என்பதால், "
"கவனமாக பயன்படுத்தவும்."

msgid "Access restrictions"
msgstr "அணுகல் வரம்புகள்"

msgid "Access options"
msgstr "அணுகல் விருப்பங்கள்"

msgid "Caching options"
msgstr "காட்சிங் விருப்பங்கள்"

msgid "Display even if view has no result"
msgstr ""
"விளைவுகள் எதுவும் "
"இல்லாவிடியிலும் "
"காட்சிப்படுத்து"

msgid "How should this view be styled"
msgstr ""
"இந்த பார்வையை எப்படி "
"வடிவமைக்க வேண்டும்?"

msgid ""
"If the style you choose has settings, be sure to click the settings "
"button that will appear next to it in the View summary."
msgstr ""
"நீங்கள் "
"தேர்ந்தெடுத்துள்ள ஸ்டைல் "
"குறிப்பிடும் அமைப்புகள் "
"இருந்தால், View summary-இல் "
"அதற்குப் பக்கத்தில் "
"தோன்றும் அமைப்புகள் "
"பொத்தானை நிச்சயமாக "
"கிளிக் செய்யவும்."

msgid "Style options"
msgstr "முறை வகைகள்"

msgid "Row style options"
msgstr "வரிசை வடிவமைப்பு אפשרויות"

msgid "Which display to use for path"
msgstr ""
"பாதைக்கு எந்த காட்சியை "
"பயன்படுத்த வேண்டும்"

msgid ""
"Which display to use to get this display's path for things like "
"summary links, rss feed links, more links, etc."
msgstr ""
"இந்தக் காட்டுதலின் "
"பாதையை பெற எந்தக் "
"காட்டுதலை "
"பயன்படுத்துவது, "
"எடுத்துக்காட்டாக சுருக்க "
"இணைப்புகள், RSS உணவு "
"இணைப்புகள், மேலும் "
"இணைப்புகள் "
"போன்றவற்றிற்காக."

msgid "Put the exposed form in a block"
msgstr ""
"காண்பிக்கப்படும் "
"படிவத்தை ஒரு பிராக்கில் "
"வைக்கவும்"

msgid ""
"If set, any exposed widgets will not appear with this view. Instead, a "
"block will be made available to the Drupal block administration "
"system, and the exposed form will appear there. Note that this block "
"must be enabled manually, Views will not enable it for you."
msgstr ""
"கொடுக்கப்பட்டால், "
"ஏதேனும் "
"வெளிப்படுத்தப்பட்ட "
"விழட்கள் இந்த பார்வையில் "
"காணப்படமாட்டாது. அதன் "
"பதிலாக, ஒரு தொகுதி Drupal "
"தொகுதி நிர்வாக "
"அமைப்பிற்கு கிடைக்கும், "
"மற்றும் "
"வெளிப்படுத்தப்பட்ட "
"படிவம் அங்கே தோன்றும். "
"இந்த தொகுதியை கையால் "
"இயக்கவேண்டியதும் "
"கவனிக்கவும், Views அதை தானாக "
"இயக்கவல்லது இல்லை."

msgid ""
"Display \"@display\" uses fields but there are none defined for it or "
"all are excluded."
msgstr ""
"Display \"@display\" க்கான புலங்கள் "
"பயன்படுத்தப்படுகின்றன, "
"ஆனால் அவற்றில் ஏதாவது "
"வரையறுக்கப்படவில்லை "
"அல்லது அனைத்தும் "
"விலக்கப்பட்டுள்ளன."

msgid "Display \"@display\" uses a path but the path is undefined."
msgstr ""
"Display \"@display\" ஒரு பாதையை "
"பயன்படுத்துகிறது ஆனால் "
"அந்த பாதை "
"வரையறுக்கப்படவில்லை."

msgid "Display \"@display\" has an invalid style plugin."
msgstr ""
"\"display\" \"@display\" ஒரு தவறான ஸ்டைல் "
"பிளக்கின் உள்ளது."

msgid "Exposed form: @view-@display_id"
msgstr ""
"வெளிப்படுத்தப்பட்ட "
"படிவம்: @view-@display_id"

msgid "Attachment settings"
msgstr "இணைப்பு அமைப்புகள்"

msgid "Inherit exposed filters"
msgstr ""
"பரப்பப்பட்ட வடிகட்டிகள் "
"கொள்முதல் செய்க"

msgid "Multiple displays"
msgstr "பல காட்சிகள்"

msgid ""
"Should this display inherit its exposed filter values from the parent "
"display to which it is attached?"
msgstr ""
"இந்த காட்சி அதற்குக் "
"இணைக்கப்பட்டுள்ள "
"பெற்ற.kாட்சி இருந்து அதன் "
"வெளியிட்ட வடிகட்டி "
"மதிப்புகளை பெற வேண்டுமா?"

msgid "Attach before or after the parent display?"
msgstr ""
"பெற்ற(display) முன்பாக அல்லது "
"பின்பாக இணைக்க வேண்டுமா?"

msgid "Select which display or displays this should attach to."
msgstr ""
"இந்தக் காட்டலை அல்லது "
"காட்சிகளைக் எதற்கெல்லாம் "
"இணைக்க வேண்டும் என்பதை "
"தேர்வு செய்க."

msgid "@view: @display"
msgstr "@view: @display"

msgid "Block admin description"
msgstr "கட்டம் நிர்வாக விவரம்"

msgid "Using the site name"
msgstr ""
"தளத்தின் பெயரை "
