msgstr ""
"காட்சிப்படுத்தும் "
"பிளக்கின்"

msgid "Boolean sort"
msgstr "பூலியன் வரிசைப்படுத்தல்"

msgid "Date sort"
msgstr "தேதி ஒழுங்குபடுத்துதல்"

