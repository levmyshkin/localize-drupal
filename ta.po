msgid "The {filter_format}.format of the string"
msgstr ""
"{filter_format}.எழுத்தரகத்தின் "
"வடிவம்"

msgid "Plural index number"
msgstr "பலமொழி குறி எண்"

msgid "@entity fields"
msgstr "@entity புலங்கள்"

msgid "Language for this term."
msgstr "இந்த வார்த்தைக்கு மொழி."

msgid "Term name translation."
msgstr ""
"வாக்கு பெயர் "
"மொழிபெயர்ப்பு."

msgid "Term description translation."
