msgstr "தனிப்பயன் உரை: @true_label / @false_label"

msgid "Display: @true_label / @false_label"
msgstr "காட்டு: @true_label / @false_label"

msgid ""
"See <a href=\"http://php.net/manual/function.date.php\" "
"target=\"_blank\">the documentation for PHP date formats</a>."
msgstr ""
"பார்க்கவும் <a "
"href=\"http://php.net/manual/function.date.php\" target=\"_blank\">PHP "
"தேதி வடிவம் தொடர்புடைய "
"ஆவணங்கள்</a>."

