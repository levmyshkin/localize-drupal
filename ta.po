msgstr "%label நிலை உருவாக்கப்பட்டது."

msgid "Are you sure you want to delete %state from %workflow?"
msgstr ""
"நீங்கள் %workflow இல் இருந்து %state "
"ஐ அழிக்க "
"விரும்புகிறீர்களா?"

msgid "State %label deleted."
msgstr "மாநிலம் %label நீக்கப்பட்டது."

msgid "Saved %label state."
msgstr "%label நிலை சேமிக்கப்பட்டது."

