msgid "Content Block"
msgstr "உள்ளடக்கக் கட்டம்"

msgid ""
"This theme is not compatible with Drupal @core_version. Check that the "
".info.yml file contains a compatible 'core' or "
"'core_version_requirement' value."
msgstr ""
"இந்த தீம் Drupal @core_version உடன் "
"இணக்கமானதல்ல. .info.yml "
"கோப்பில் இணக்கமான 'core' "
"அல்லது 'core_version_requirement' மதிப்பு "
"உள்ளது என்பதைக் "
"சரிபார்க்கவும்."

msgid ""
"Drupal Core (@core_requirement) (<span "
"class=\"admin-missing\">incompatible with</span> version "
"@core_version)"
msgstr ""
"Drupal மூலக் கோப்பு (@core_requirement) (<span "
"class=\"admin-missing\">பதிப்புடன் "
"பொருந்தவில்லை</span> @core_version)"

msgid "Additional Resources"
msgstr "மேலும் ресурces"

msgid "A clean, accessible, and powerful Drupal administration theme."
msgstr ""
"ஒரு சுத்தமான, அணுகக்கூடிய "
"மற்றும் சக்திவாய்ந்த Drupal "
"நிர்வாகத் தலைப்பு."

msgid "Status Details"
msgstr "நிலை விவரங்கள்"

msgid "Maximum number of autocomplete suggestions."
msgstr ""
"ஆட்டோகம்ப்ளீட் "
"பரிந்துரைகளின் அதிகபட்ச "
"எண்ணிக்கை."

msgid ""
"Failed to connect to your database server. The server reports the "
"following message: %error.<ul><li>Is the database server "
"running?</li><li>Does the database exist or does the database user "
"have sufficient privileges to create the database?</li><li>Have you "
"entered the correct database name?</li><li>Have you entered the "
"correct username and password?</li><li>Have you entered the correct "
"database hostname and port number?</li></ul>"
msgstr ""
"உங்கள் தரவுத்தள "
"சேவையகத்துடன் இணைக்க "
"முடியவில்லை. சேவையகம் "
"பின்வரும் செய்தியைக் "
"கூறுகிறது: %error.<ul><li>தரவுத்தள "
"சேவையகம் "
"ஓடிக்கொண்டிருக்கிறதா?</li><li>தரவுத்தளம் "
"உள்ளது அல்லது தரவுத்தள "
"பயனருக்கு தரவுத்தளத்தை "
"உருவாக்க போதுமான "
"அனுமதிகள் "
"உள்ளதா?</li><li>நீங்கள் சரியான "
"தரவுத்தள பெயரை "
"உள்ளிடவா?</li><li>நீங்கள் "
"சரியான பயனர்பெயர் "
"மற்றும் கடவுச்சொல்லை "
"உள்ளிடவா?</li><li>நீங்கள் "
"சரியான தரவுத்தள ஹோஸ்ட் "
"பெயர் மற்றும் போர்டு "
"எண்ணை உள்ளிடவா?</li></ul>"

msgid ""
"Failed to connect to your database server. The server reports the "
"following message: %error.<ul><li>Is the database server "
"running?</li><li>Does the database exist, and have you entered the "
"correct database name?</li><li>Have you entered the correct username "
"and password?</li><li>Have you entered the correct database hostname "
"and port number?</li></ul>"
msgstr ""
"உங்கள் தரவுத்தள "
"சர்வருடன் இணைக்க "
"முடியவில்லை. சர்வர் "
"பின்வரும் செய்தியை "
"தெரிவித்துள்ளது: "
"%error.<ul><li>தரவுத்தள சர்வர் "
"இயக்கமாக "
"உள்ளதா?</li><li>தரவுத்தளம் "
"உள்ளது மற்றும் நீங்கள் "
"சரியான தரவுத்தள பெயரை "
"உள்ளிடியுள்ளீர்களா?</li><li>சரியான "
"பயனர் பெயர் மற்றும் "
"கடவுச்சொல்லை நீங்கள் "
"உள்ளிடியுள்ளீர்களா?</li><li>சரியான "
"தரவுத்தள ஹோஸ்ட்னேம் "
"மற்றும் போர்ட் எண்ணை "
"நீங்கள் "
"உள்ளிடியுள்ளீர்களா?</li></ul>"

msgid ""
"Failed to open or create database file %database. The database engine "
"reports the following message when attempting to create the database: "
"%error."
msgstr ""
"%database என்ற தரவுத்தளம் "
"கோப்பைத் திறக்க அல்லது "
"உருவாக்க முடியவில்லை. "
"தரவுத்தள இயந்திரம் "
"தரவுத்தளத்தை உருவாக்க "
"முயற்சிக்கும்போது "
"பின்வரும் செய்தி "
"தெரிவிக்கின்றது: %error."

msgid ""
"Failed to connect to database. The database engine reports the "
"following message: %error.<ul><li>Does the database file "
"exist?</li><li>Does web server have permission to write to the "
"database file?</li>Does the web server have permission to write to the "
"directory the database file should be created in?</li></ul>"
msgstr ""
"தரவுத்தளத்துடன் இணைக்க "
"முடியவில்லை. தரவுத்தள "
"இயந்திரம் பின்வரும் "
"செய்தியினை "
"தெரிவித்துள்ளது: "
"%error.<ul><li>தரவுத்தளப் கோப்பு "
"உள்ளதா?</li><li>வெப் சர்வர் "
"தரவுத்தளக் கோப்பில் எழுத "
"அனுமதி "
"உள்ளதா?</li><li>தரவுத்தளக் "
"கோப்பு உருவாக்க வேண்டிய "
"அடைவில் வெப் சர்வருக்கு "
"எழுத அனுமதி உள்ளதா?</li></ul>"

msgid ""
"The number of suggestions that will be listed. Use <em>0</em> to "
"remove the limit."
msgstr ""
"பட்டியலிடப்படும் "
"பரிந்துரைகளின் "
"எண்ணிக்கை. வரம்பை நீக்க "
"<em>0</em> பயன்படுத்தவும்."

msgid "Autocomplete suggestion list size: @size"
msgstr "Autocomplete suggestion list size: @size"

