msgstr "பின்புல நிறம்"

msgid "Text color"
msgstr "எழுத்தின் நிறம்"

msgid "Captcha Points"
msgstr "கேப்ட்சா புள்ளிகள்"

msgid "normal"
msgstr "சாதாரண"

msgid "Code length"
msgstr "கோட் நீளம்"

