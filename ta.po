msgstr "MSApplication - அறிவிப்பு"

msgid "MSApplication - Square logo, 150px x 150px"
msgstr "MSApplication - சதுர லோகோ, 150px x 150px"

msgid "MSApplication - Square logo, 310px x 310px"
msgstr "MSApplication - சதுர குறியீடு, 310px x 310px"

msgid "MSApplication - Square logo, 70px x 70px"
msgstr "MSApplication - சதுர லோகோ, 70px x 70px"

msgid "MSApplication - Wide logo, 310px x 150px"
msgstr "MSApplication - விசாலமான லோகோ, 310px x 150px"

