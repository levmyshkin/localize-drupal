msgid "Mode of operation"
msgstr "செயற்பாட்டு முறை"

msgid "Configuration Ignore settings"
msgstr ""
"கட்டமைப்பு தவிர்க்கும் "
"அமைப்புகள்"

msgid "Ignore certain configuration during imports and exports"
msgstr ""
"இறக்குமதி மற்றும் "
"ஏற்றுமதி செய்யும்போது "
"சில கட்டமைப்புகளை "
"புறக்கணிக்கவும்"

msgid "Operational mode"
msgstr "செயல்பாட்டுத் தளம்"

msgid "lists for import and export ignoring"
msgstr ""
"நீக்கிப் பார்த்து "
"இறக்குமதி மற்றும் "
"ஏற்றுமதிக்கான "
"பட்டியல்கள்"

msgid "List of ignored configurations on import"
msgstr ""
"இறக்குமதியில் "
"புறக்கணிக்கப்பட்ட "
"கட்டமைப்புகளின் பட்டியல்"

msgid "List of ignored configurations on export"
msgstr ""
"ஏற்றுமதியில் "
"புறக்கணிக்கப்பட்ட "
"கட்டமைப்புகளின் பட்டியல்"

msgid "Settings for advanced ignoring"
msgstr ""
"மேம்பட்ட "
"புறக்கணிப்புக்கான "
"அமைப்புகள்"

msgid "List of created ignored configurations"
msgstr ""
"உருவாக்கப்பட்ட "
"புறக்கணிக்கப்பட்ட "
"அமைப்புகளின் பட்டியல்"

msgid "List of updated ignored configurations"
msgstr ""
"புதுப்பிக்கப்பட்ட "
"புறக்கணிக்கப்பட்ட "
"கட்டமைப்புகளின் பட்டியல்"

msgid "List of deleted ignored configurations"
msgstr ""
"நீக்கப்பட்ட "
"புறக்கணிக்கப்பட்ட "
"கட்டமைப்புகளின் பட்டியல்"

msgid ""
"This setting controls how complicated the configuration is. If you do "
"not have a use-case for a more advanced set-up the recommendation is "
"to keep it simple."
msgstr ""
"இந்த அமைப்பு "
"கட்டமைப்பின் "
"சிக்கல்முறையை "
"கட்டுப்படுத்துகிறது. "
"நீங்கள் ஒரு மேலதிக "
"அமைப்புக்கு பயன்பாடு "
"இல்லையெனில், அதை எளிதாக "
"வைத்திருப்பதையே "
"பரிந்துரைக்கப்படுகிறது."

msgid "The configuration ignored in all cases"
msgstr ""
"அனைத்து நிலையில் உள்ள "
"கட்டமைப்பும் "
"புறக்கணிக்கப்பட்டது"

msgid ""
"One configuration name per line.<br />\n"
"Examples: "
"<ul>\n"
"<li>user.settings</li>\n"
"<li>views.settings</li>\n"
"<li>contact.settings</li>\n"
"<li>webform.webform.* "
"(will ignore all config entities that starts with "
"<em>webform.webform</em>)</li>\n"
"<li>*.contact_message.custom_contact_form.* "
"(will ignore all config entities that starts with "
"<em>.contact_message.custom_contact_form.</em> like fields attached to "
"a custom contact form)</li>\n"
"<li>* (will ignore "
"everything)</li>\n"
"<li>~webform.webform.contact (will force import for "
"this configuration, even if ignored by a "
"wildcard)</li>\n"
"<li>user.mail:register_no_approval_required.body "
"(will ignore the body of the no approval required email setting, but "
"will not ignore other user.mail "
"configuration.)</li>\n"
"<li>language.*|* (will ignore all language "
"collections)</li>\n"
"<li>language.fr|* (will ignore all fr language "
"collection)</li>\n"
"<li>language.fr|field.field.* (will ignore all fr "
"field "
"translations)</li>\n"
"<li>~language.fr|field.field.media.file.field_media_file "
"(will force import for certain field "
"translation)</li>\n"
"<li>language.*|system.site:name (will ignore just "
"the site name but in all translations)</li>\n"
"</ul>"
msgstr ""
"ஒன்று கட்டமைப்பு பெயரும் "
"வரிசைப்படி.<br "
"/>\n"
"உதாரணங்கள்: "
"<ul>\n"
"<li>user.settings</li>\n"
"<li>views.settings</li>\n"
"<li>contact.settings</li>\n"
"<li>webform.webform.* "
"(இது <em>webform.webform</em> எனத் "
"தொடங்கும் அனைத்து "
"கட்டமைப்பு "
"உறுப்புகளையும் "
"புறக்கணிக்கும்)</li>\n"
"<li>*.contact_message.custom_contact_form.* "
"(இது <em>.contact_message.custom_contact_form.</em> எனத் "
"தொடங்கும் அனைத்து "
"கட்டமைப்பு "
"உறுப்புகளையும் "
"புறக்கணிக்கும், உதாரணமாக "
"தனிப்பயன் தொடர்பு "
"படிவத்துடன் இணைக்கப்பட்ட "
"புலங்கள்)</li>\n"
"<li>* "
"(எல்லாவற்றையும் "
"புறக்கணிக்கும்)</li>\n"
"<li>~webform.webform.contact "
"(இக் கட்டமைப்பிற்கு "
"இறக்குமதி செய்ய "
"பயனுள்ளதாகும், "
"கோட்பாட்டு எழுத்து மூலம் "
"புறக்கணிக்கப்பட்டாலும் "
"கூட)</li>\n"
"<li>user.mail:register_no_approval_required.body "
"(அங்கீகாரம் தேவையற்ற "
"மின்னஞ்சல் அமைப்பின் "
"உட்பொருளை "
"புறக்கணிக்கும், ஆனால் "
"மற்ற user.mail கட்டமைப்புகளை "
"புறக்கணிக்காது)</li>\n"
"<li>language.*|* "
"(எல்லா மொழி "
"சேமிப்புகளையும் "
"புறக்கணிக்கும்)</li>\n"
"<li>language.fr|* "
"(பிரான்ஸ் மொழி "
"சேமிப்புகளை மட்டும் "
"புறக்கணிக்கும்)</li>\n"
"<li>language.fr|field.field.* "
"(பிரான்ஸ் மொழி புல "
"மொழிபெயர்ப்புகளை "
"புறக்கணிக்கும்)</li>\n"
"<li>~language.fr|field.field.media.file.field_media_file "
"(குறிப்பிட்ட புல "
"மொழிபெயர்ப்பிற்கு "
"வலியுறுத்தி இறக்குமதி "
"செய்வது)</li>\n"
"<li>language.*|system.site:name "
"(அனைத்து "
"மொழிபெயர்ப்புகளிலும் "
"உள்ள தளத்தின் பெயரை "
"மட்டும் "
"புறக்கணிக்கும்)</li>\n"
"</ul>"

msgid "Select theme"
msgstr "தீம் தேர்வு செய்யவும்"

msgid "Edit context"
msgstr "செயல்திட்டத்தை திருத்து"

msgid "Reaction"
msgstr "விவரம்"

msgid "404"
msgstr "404"

msgid "Context (any)"
msgstr "Context (எந்தவிதமானதும்)"

msgid "Context (all)"
msgstr "சூழல் (எல்லா)"

msgid "Update block"
msgstr "பிளாக் புதுப்பு"

msgid "The condition %name has been removed."
msgstr "நிலைகள் %name அகற்றப்பட்டது."

msgid "Are you sure you want to delete the %label condition?"
msgstr ""
"நீங்கள் %label நிலையை நீக்க "
"விரும்புகிறீர்களா?"

msgid "Are you sure you want to delete the %label context?"
msgstr ""
"நீங்கள் %label context ஐ நீக்க "
"விரும்புகிறீர்களா?"

msgid "Are you sure you want to %status the %label context?"
msgstr ""
"நீங்கள் நிச்சயமாக %label "
"சூழலை %status செய்ய "
"விரும்புகிறீர்களா?"

msgid "Are you sure you want to remove the %reaction reaction."
msgstr ""
"நீங்கள் %reaction प्रतिक्रिया ஐ "
"அகற்ற விரும்புகிறீர்களா "
"என உறுதியாக உள்ளீர்களா?"

msgid "Request path exclusion"
msgstr "அறிவுரை பாதை விலக்கு"

msgid "Configure filters"
msgstr "வடிகட்டிகளை அமைக்கவும்"

msgid "Entity view (@label)"
msgstr "உலக செயல் பார்வை (@label)"

msgid "Label of the context"
msgstr ""
"சுற்றுப் پیرுமிடத்தின் "
"லேபில்"

msgid "Select entity"
msgstr "அமைப்பை தேர்ந்தெடு"

msgid ""
"A unique machine-readable name for this @entity_type. It must only "
"contain lowercase letters, numbers, and underscores."
msgstr ""
"இந்த @entity_type க்கான "
"தனித்துவமான இயந்திரம் "
"வாசிக்கக்கூடிய பெயர். இது "
"சிறிய எழுத்துக்கள், "
"எண்கள் மற்றும் "
"அண்டர்ஸ்கோர்களையே "
"கொண்டிருக்க வேண்டும்."

msgid "Entity Mask"
msgstr "என்டிடி மாஸ்க்"

msgid ""
"Allows an entity type to borrow the fields and display configuration "
"of another entity type."
msgstr ""
"ஒரு ஐடிட்டி வகை மற்றொரு "
"ஐடிட்டி வகையின் புலங்கள் "
"மற்றும் காட்சி அமைப்பினை "
"கடன் வாங்க அனுமதிக்கும்."

msgid "Chaos Tools Views"
msgstr "கோஸ் டூல்ஸ் வியூஸ்"

msgid ""
"This suite is primarily a set of APIs and tools to improve the "
"developer experience. It also contains a module called the Page "
"Manager whose job is to manage pages. In particular it manages panel "
"pages, but as it grows it will be able to manage far more than just "
"Panels."
msgstr ""
"இந்த தொகுப்பு முதன்மையாக "
"டெவலப்பர் அனுபவத்தை "
"மேம்படுத்த API களும் "
"கருவிகளும் கொண்டுள்ளது. "
"அதிலும் ஒரு Page Manager என்ற "
"மொடியூல் உள்ளது, அதன் வேலை "
"பக்கங்களை "
"நிர்வகிப்பதாகும். "
"குறிப்பாக இது panel "
"பக்கங்களை "
"நிர்வகிக்கிறது, ஆனால் அது "
"வளர்ச்சியடைவதற்கு "
"மிகவும் "
"பன்முகப்படுத்தப்பட்ட "
"பக்கங்களை "
"நிர்வகிக்கக்கூடிய "
"வகையில் "
"வடிவமைக்கப்படும்."

msgid ""
"Plugins -- tools to make it easy for modules to let other modules "
"implement plugins from .inc files."
msgstr ""
"பிளக்கின்கள் -- .inc "
"கோப்புகளிலிருந்து "
"பிளக்கின்களை செயல்படுத்த "
"மற்ற மொடியூல்கள் "
"பயன்படுத்த எளிதாக்கும் "
"கருவிகள்."

msgid ""
"Exportables -- tools to make it easier for modules to have objects "
"that live in database or live in code, such as \"default views\"."
msgstr ""
"Exportables -- தரவுத்தளத்தில் "
"அல்லது குறியீட்டில் "
"வாழும் பொருட்கள் "
"இருக்கும் "
"மாட்யூல்களுக்கு "
"உதவுவதற்கான கருவிகள், "
"உதாரணத்திற்கு \"இயல்பான "
"காட்சிகள்\" போன்றவை."

msgid ""
"AJAX responder -- tools to make it easier for the server to handle "
"AJAX requests and tell the client what to do with them."
msgstr ""
"AJAX பதில் வழங்கி -- AJAX "
"கோரிக்கைகளை சர்வர் "
"எளிதில் கையாள மற்றும் "
"கிளையண்டுக்கு அவற்றுடன் "
"என்ன செய்ய வேண்டும் "
"என்பதை தெரிவிக்க உதவும் "
"கருவிகள்."

msgid "Form tools -- tools to make it easier for forms to deal with AJAX."
msgstr ""
"படிவ கருவிகள் -- AJAX கையாள "
"படிவங்கள் எளிதாகச் "
"செய்யக் உதவும் கருவிகள்."

msgid ""
"Object caching -- tool to make it easier to edit an object across "
"multiple page requests and cache the editing work."
msgstr ""
"ஒப்ஜெக்ட் கேச்சிங் -- பல "
"பக்க கோரிக்கைகள் "
"முறையில் ஒரு ஒப்ஜெக்டை "
"எளிதாக திருத்தவும், "
"திருத்திய பணியை கேச் "
"செய்யவும் உதவும் கருவி."

msgid ""
"Contexts -- the notion of wrapping objects in a unified wrapper and "
"providing an API to create and accept these contexts as input."
msgstr ""
"Contexts -- பொருட்களை ஒரே "
"வடிவத்தில் சுருள் போல "
"மூடும் கருத்து மற்றும் "
"இந்த contexts-ஐ உள்ளீடாக "
"உருவாக்கி ஏற்றுக்கொள்ள "
"API-ஐ வழங்குவது."

msgid ""
"Modal dialog -- tool to make it simple to put a form in a modal "
"dialog."
msgstr ""
"மோடல் டைலாக் -- ஒரு மாடல் "
"டைலாக்கில் ஒரு படிவத்தை "
"எளிதாக இடுவதற்கான கருவி."

msgid ""
"Dependent -- a simple form widget to make form items appear and "
"disappear based upon the selections in another item."
msgstr ""
"Dependent -- ஒரு எளிய படிவ விகெட், "
"மற்றொரு உருப்படியில் "
"உள்ள தேர்வுகளின் "
"அடிப்படையில் படிவ "
"உருப்படிகள் தோன்றவும் "
"மறையவும் செய்ய."

msgid ""
"Content -- pluggable content types used as panes in Panels and other "
"modules like Dashboard."
msgstr ""
"உள்ளடக்கம் -- Panels மற்றும் "
"Dashboard போன்ற மற்ற "
"தொகுதிகளில் பக்கங்களாக "
"பயன்படுத்தப்படும் "
"இணைக்கக்கூடிய உள்ளடக்கம் "
"வகைகள்."

msgid "Form wizard -- an API to make multi-step forms much easier."
msgstr ""
"Form wizard -- பல கூட்ட கட்ட-form-ஐ "
"எளிதாக செய்ய ஒரு API."

msgid ""
"CSS tools -- tools to cache and sanitize CSS easily to make user-input "
"CSS safe."
msgstr ""
"CSS கருவிகள் -- பயனர் உள்ளீடு "
"செய்யப்பட்ட CSS-ஐ "
"பாதுகாப்பாக மாற்றும் படி "
"CSS-ஐ எளிதாக கேஷ் செய்து "
"சுத்தப்படுத்தும் "
"கருவிகள்."

msgid "Exposed filter values"
msgstr ""
"புகுபடுத்தப்பட்ட "
"வடிகட்டி மதிப்புகள்"

msgid ""
"If a value is set for an exposed filter, it will be removed from the "
"block display."
msgstr ""
"ஒரு வெளிப்படுத்தப்பட்ட "
"வடிகட்டிற்காக மதிப்பு "
"அமைக்கப்பட்டிருந்தால், "
"அது பிளாக் "
"காட்சியிலிருந்து "
"அகற்றப்படும்."

msgid "Expose filter value to user"
msgstr ""
"பயனருக்கு فل்டர் மதிப்பை "
"வெளிப்படுத்துக"

msgid ""
"Expose this filter value to visitors? If so, the value set here will "
"be the default."
msgstr ""
"இந்த வடிகட்டும் மதிப்பை "
"பயனர்களுக்கு காட்டவா? "
"அதனால், இங்கு அமைத்த "
"மதிப்பு "
"முன்பமைக்கப்பட்டதாக "
"இருக்கும்."

msgid "Expose filter operator to user"
msgstr ""
"பயனருக்கு வடிகட்டும் "
"செயல் செயற்பாட்டை "
"வெளிப்படுத்தவும்"

msgid ""
"Expose this filter's operator to visitors? If so, the operator set "
"here will be the default."
msgstr ""
"இந்த அறதியை பயணிகளுக்கு "
"வெளிப்படுத்தவா? "
"அப்படியானால், இங்கே "
"அமைக்கப்பட்ட அறதி "
"இயந்திரம் முதன்மையாக "
"இருக்கும்."

msgid "Disable filter: @handler"
msgstr ""
"வடிகட்டியை செயலிழக்க "
"செய்யவும்: @handler"

msgid "Update Status"
msgstr "நிலையை புதுப்பிக்கவும்"

msgid "Administer blocks"
msgstr "கட்டங்களை நிர்வகிக்கவும்"

msgid "Creating content"
msgstr "உள்ளடக்க உருவாக்கம்"

msgid "Configuration files"
msgstr "காத்திருப்பு கோப்புகள்"

msgid "Default moderation state"
msgstr ""
"இயல்புநிலை பராமரிப்பு "
"நிலை"

msgid "Theme files"
msgstr "தீம் கோப்புகள்"

msgid "Customize field and label wrapper HTML"
msgstr ""
"புலமும் லேபிள் ரேப்பர் "
"HTML-ஐ தனிப்பயன் செய்யவும்"

msgid "Module files"
msgstr "மொட்யூல் கோப்புகள்"

msgid "@label has been removed."
msgstr "@label நீக்கப்பட்டது."

msgid "Link text not trimmed"
msgstr ""
"இணைப்பு உரை "
"குறைக்கப்படவில்லை"

msgid "Translations directory"
msgstr "மொழிபெயர்ப்பு உறை"

msgid "The parents of this term."
msgstr ""
"இந்த சொற்றொடரின் மூல "
"சொற்கள்."

msgctxt "Sort order"
msgid "Order"
msgstr "வரிசை"

msgid "Entity links"
msgstr "என்டிட்டி லிங்குகள்"

msgid "About text formats"
msgstr "உரை வடிவமைப்புகள் பற்றி"

msgid "One or more names separated by , or +"
msgstr ""
"ஒரு அல்லது அதற்கும் "
"மேற்பட்ட பெயர்கள் , அல்லது "
"+ கொண்டு பிரிக்கப்பட்டவை"

msgid "Title field required"
msgstr "தலைப்பு புலம் அவசியம்"

msgid "Boolean string"
msgstr "பூலியன் ஸ்ட்ரிங்"

msgid "OPML Feed"
msgstr "OPML சேவை"

msgid "Entity Reference reference access"
msgstr ""
"என்டிட்டி ரெஃபரன்ஸ் "
"ரெஃபரன்ஸ் அணுகல்"

msgctxt "Validation"
msgid "Email"
msgstr "மின்னஞ்சல்"

msgid "Duplicate responsive image style"
msgstr ""
"பிறகு பதிப்பு "
"பதிலளிக்கும் பட ஸ்டைல்"

msgid "Translate interface text"
msgstr ""
"இணையதள இடைமுக உரையை "
"மொழிபெயர்க்கவும்"

msgid ""
"The maximum number of messages to keep in the database log. Requires a "
"<a href=\":cron\">cron maintenance task</a>."
msgstr ""
"தரவுத்தள பதிவு(Log)ல் "
"வைக்கப்படும் அதிகபட்ச "
"செய்திகளின் எண்ணிக்கை. <a "
"href=\":cron\">cron பராமரிப்பு பணியை</a> "
"தேவையாக்கிறது."

msgid "Deprecated: Use account-name or display-name instead."
msgstr ""
"பழுதடைந்தது: பதிலாக account-name "
"அல்லது display-name ஐ "
"பயன்படுத்தவும்."

msgid "Workspaces"
msgstr "பணிப்பரப்புகள்"

msgid "Use custom display settings for the following @display_context modes"
msgstr ""
"பின்வரும் @display_context "
"முறைகளுக்கு தனிப்பயன் "
"காட்சிப் அமைப்புகளை "
"பயன்படுத்தவும்"

msgid "Supported entity types"
msgstr ""
"ஆதரிக்கப்பட்ட உயிரின "
"வகைகள்"

msgid "The theme settings variable value."
msgstr ""
"தீம் அமைப்புகள் மாறி "
"மதிப்பு."

msgid "Use audio files for reusable media."
msgstr ""
"மீண்டும் "
"பயன்படுத்தக்கூடிய "
"மீடியாவிற்கு ஒலி "
"கோப்புகளை "
"பயன்படுத்தவும்."

msgid "contact message"
msgstr "தொடர்பு செய்தி"

msgid "Allowed media types, in display order"
msgstr ""
"காட்டு வரிசையில் "
"அனுமதிக்கப்பட்ட மீடியா "
"வகைகள்"

msgid ""
"Vendor filesystem \"@vendor\" has insufficient space. There must be at "
"least @space megabytes free."
msgstr ""
"Vendor filesystem \"@vendor\" என்பதிலுள்ள "
"இடம் போதுமானது இல்லை. "
"குறைந்தபட்சம் @space "
"மெகಾಬைட்டுகள் காலியாக "
"இருக்க வேண்டும்."

msgid "Plays inline"
msgstr "இன்லைனில் ஒளிபரப்புகிறது"

msgid ""
"You can embed media items (using the <code>&lt;drupal-media&gt;</code> "
"tag)."
msgstr ""
"நீங்கள் மீடியா பொருட்களை "
"<code>&lt;drupal-media&gt;</code> "
"குறிச்சொல்லைப் "
"பயன்படுத்தி இணைக்கலாம்."

msgid "Logs system events in the database."
msgstr ""
"தரவுத்தளத்தில் சிஸ்டம் "
"நிகழ்வுகளை "
"பதிவுசெய்கிறது."

msgid "Check <em>Make this the default form</em> and click <em>Save</em>."
msgstr ""
"<em>இதை இயல்புநிலை படிவமாக "
"அமைக்கவும்</em> என்பதைக் "
"குறிக்கவும் மற்றும் "
"<em>சேமிக்கவும்</em> கிளிக் "
"செய்யவும்."

msgid "Online documentation for the RESTful Web Services module"
msgstr ""
"RESTful Web Services module க்கான "
"ஆன்லைன்ஆவணத் தொகுப்பு"

msgid ""
"The core Media Library module provides the media library and the Media "
"library field widget. With this module installed, the Media library "
"field widget becomes the default widget for editing Media reference "
"fields."
msgstr ""
"கர்நிலை மீடியா நூலக "
"தொகுப்பு மீடியா "
"நூலகத்தையும் மீடியா "
"நூலகப் புல-widget-ஐ "
"வழங்குகிறது. இந்த "
"தொகுப்பு "
"நிறுவப்பட்டவுடன், மீடியா "
"நூலகப் புல-widget மீடியா "
"குறிப்பு புலங்களைக் "
"கையாளும் இயல்புநிலை widget ஆக "
"மாறும்."

msgid ""
"<em>Threading</em>: whether or not the comments are collected by "
"threads, with people able to reply to particular comments instead of "
"to the content entity itself."
msgstr ""
"<em>த்ரெடிங்</em>: "
"கருத்துக்கள் "
"த்ரெட்களின்படி "
"சேகரிக்கப்படுகிறதா "
"இல்லையா என்பதைக் "
"குறிக்கும், இதில் நபர்கள் "
"குறிப்பிட்ட "
"கருத்துக்களுக்கு பதில் "
"அளிக்க முடியும், உள்ளடக்க "
"அலகுக்கே அல்ல."

msgid ""
"Follow the steps in @search_index_topic to make sure that the search "
"index is updated."
msgstr ""
"@search_index_topic இல் உள்ள படிகளின் "
"படி பின்பற்றவும், தேடல் "
"индெக்ஸ் "
"புதுப்பிக்கப்பட்டுள்ளதாக "
"உறுதிப்படுத்த."

msgid "The vendor directory \"@dir\" is not writable."
msgstr ""
"விற்பனையாளர் அடைவு \"@dir\" "
"எழுத இயலுமாறு இல்லை."

msgid ""
"The CKEditor 5 \"%cke5_media_plugin_label\" plugin's "
"\"%cke5_allow_view_mode_override_label\" setting should be in sync "
"with the \"%filter_media_plugin_label\" filter's "
"\"%filter_media_allowed_view_modes_label\" setting: when checked, two "
"or more view modes must be allowed by the filter."
msgstr ""
"CKEditor 5 \"%cke5_media_plugin_label\" பிளகினின் "
"\"%cke5_allow_view_mode_override_label\" அமைப்பு "
"\"%filter_media_plugin_label\" வடிகட்டியின் "
"\"%filter_media_allowed_view_modes_label\" "
"அமைப்புடன் "
"ஒத்திசைக்கப்பட வேண்டும்: "
"தேர்ந்தெடுக்கப்பட்டபோது, "
"இரண்டு அல்லது அதற்கு "
"மேற்பட்ட காட்சிப்பட "
"வடிவங்கள் வடிகட்டியால் "
"அனுமதிக்கப்பட வேண்டும்."

msgid "Allowed entity types"
msgstr ""
"அனுமதிக்கப்பட்ட "
"அமைப்புகள் வகைகள்"

msgid ""
"The Drupal application's codebase must be writable in order to use "
"Automatic Updates. This includes Drupal core, modules, themes and the "
"Composer dependencies in the <code>vendor</code> directory. This makes "
"Automatic Updates incompatible with some hosting platforms."
msgstr ""
"Drupal செயலியின் குறியீட்டு "
"அடிப்படை தானாக "
"புதுப்பிப்புகளை "
"பயன்படுத்த writable ஆக இருக்க "
"வேண்டும். இதில் Drupal கோர், "
"மொட்யூல்கள், தீம்கள் "
"மற்றும் <code>vendor</code> "
"அடைப்பகத்தில் உள்ள Composer "
"சார்புகள் அடங்கும். "
"இதனால் தானாக "
"புதுப்பிப்புகள் சில "
"ஹோஸ்டிங் தளங்களுடன் "
"பொருந்தாமையாகிறது."

msgid ""
"Staged changes failed to apply, and the site is in an indeterminate "
"state. It is strongly recommended to restore the code and database "
"from a backup."
msgstr ""
"மாற்றங்கள் முறையாக "
"பூர்த்தி "
"செய்யப்படவில்லை, மற்றும் "
"தளம் ஒரு "
"தீர்மானிக்கப்படாத "
"நிலையில் உள்ளது. "
"கோட்பாட்டிலும் "
"தரவுத்தளத்திலும் இருந்து "
"காப்புகளைக் மீட்டமைக்க "
"பரிந்துரைக்கப்படுகிறது."

msgid ""
"Post-apply tasks are running in the same request during which staged "
"changes were applied to the active code base. This can result in "
"unpredictable behavior."
msgstr ""
"Post-apply பணிகள் நடவடிக்கை "
"எடுத்து உள்ள நேரத்திலேயே "
"ஒன்று கேட்கப்பட்டு "
"செயல்படும், அப்போது "
"நிலைத்த மாற்றங்கள் "
"செயலில் உள்ள குறியீடு "
"அடிப்படையில் "
"பயன்படுத்தப்பட்டிருக்கிறது. "
"இதனால் எதிர்பாராத நடத்தை "
"ஏற்படலாம்."

msgid ""
"API module providing functionality to stage package installs and "
"updates with Composer."
msgstr ""
"API முறைமையை வழங்கும் "
"தொகுப்பு நிறுவல்கள் "
"மற்றும் புதியதாக்கல்களை "
"Composer உடன் நிலைமையாக்கும் "
"செயல்பாடுகளை."

msgid "There is not enough disk space to create a stage directory."
msgstr ""
"ஒரு ஸ்டேஜ் கோப்புறை "
"உருவாக்கக்கான திடக் "
"கோப்பு இருப்பிடம் "
"போதவில்லை."

msgid ""
"The stage directory has @stage_count instances of @stage_info_file as "
"compared to @active_count in the active directory. This likely "
"indicates that a duplicate extension was installed."
msgstr ""
"படிகைப் பொருத்தகத்தில் "
"@active_count இருக்கும் நேர்மறைக் "
"கோப்பகத்துடன் "
"ஒப்பிடுகையில், @stage_count "
"எண்ணிக்கையான @stage_info_file "
"இன்ஸ்டன்சுகள் உள்ளன. இது, "
"ஒன்றுகூடிய நீட்டிப்பு "
"நிறுவப்பட்டுள்ளதாகக் "
"குறிக்கக்கூடும்."

msgid ""
"The stage directory has @stage_count instances of @stage_info_file. "
"This likely indicates that a duplicate extension was installed."
msgstr ""
"படர்க்கை அடைவு @stage_count @stage_info_file "
"நிகழ்வுகளை கொண்டுள்ளது. "
"இது இரட்டிப்பு நீட்சி "
"நிறுவப்பட்டிருப்பதைச் "
"சுட்டுகிறது."

msgid "The stage root directory will not able to be created at \"@dir\"."
msgstr ""
"\"@dir\" இல் நிலை வேர் இயக்கக "
"கோப்புறை உருவாக்க "
"முடியாது."

msgid "The stage root directory \"@dir\" is not writable."
msgstr ""
"நிலையில் ரூட் அடைவு \"@dir\" "
"எழுதக்கூடியதல்ல."

msgid ""
"It only allows supported Composer plugins. If you have any, see <a "
"href=\"#package-manager-faq-unsupported-composer-plugin\">What if it "
"says I have unsupported Composer plugins in my codebase?</a>."
msgstr ""
"அது மட்டுமே ஆதரவு "
"வழங்கப்படும் Composer "
"பிளக்கின்களை "
"அனுமதிக்கிறது. உங்களிடம் "
"ஏதேனும் இருந்தால், <a "
"href=\"#package-manager-faq-unsupported-composer-plugin\">எனது "
"கோடைஷட்டில் ஆதரவு இல்லாத "
"Composer பிளக்கின்கள் உள்ளன "
"என்று கூறின் என்ன செய்ய "
"வேண்டும்?</a> என்பதைப் "
"பார்க்கவும்."

msgid ""
"If <code>cweagans/composer-patches</code> is installed, it must be "
"defined as a dependency of the main project (i.e., it must be listed "
"in the <code>require</code> or <code>require-dev</code> section of "
"<code>composer.json</code>). You can run the following command in your "
"site root to add it as a dependency of the main project:"
msgstr ""
"இ<code>cweagans/composer-patches</code> "
"நிறுவியிருந்தால், அதை "
"முதன்மை திட்டத்தின் "
"சார்பாக வரையறுக்க "
"வேண்டும் (உதாரணமாக, "
"<code>composer.json</code>இல் <code>require</code> "
"அல்லது <code>require-dev</code> "
"பகுதியில் "
"பட்டியலிடப்பட்டிருக்க "
"வேண்டும்). இதை முதன்மைப் "
"프로젝트 சார்பாகக் சேர்க்க, "
"உங்கள் தளத்தின் ரூட் "
"கோப்பகத்தில் பின்வரும் "
"கட்டளையை இயக்கலாம்:"

msgid "Cannot claim the stage because no stage has been created."
msgstr ""
"இடம் உருவாக்கப்படாத "
"காரணத்தால் மேடை "
"பெற்றுக்கொள்ள "
"முடியவில்லை."

msgid ""
"All composer plugins are allowed because "
"<code>config.allow-plugins</code> is configured to <code>true</code>. "
"This is an unacceptable security risk."
msgstr ""
"எல்லா composer பிளக்கின்களும் "
"அனுமதிக்கப்படுகின்றன, "
"ஏனெனில் <code>config.allow-plugins</code> "
"<code>true</code> ஆக "
"அமைக்கப்பட்டுள்ளது. இது "
"ஏற்றுக்கொள்ள முடியாத "
"பாதுகாப்பு ஆபத்தாகும்."

msgctxt "Validation"
msgid "Extension exists"
msgstr "விரிவாக்கம் உள்ளது"

msgid ""
"The breakpoint group typically only needs a single breakpoint with an "
"empty media query in order to do <em>viewport sizing.</em> Multiple "
"breakpoints are used for changing the crop or aspect ratio of images "
"at different viewport sizes, which is often referred to as <em>art "
"direction.</em> A new breakpoint group should be created for each "
"aspect ratio to avoid content shift. Once you select a breakpoint "
"group, you can choose which breakpoints to use for the responsive "
"image style. By default, the option <em>do not use this "
"breakpoint</em> is selected for each breakpoint. See the <a "
"href=\":breakpoint_help\">help page of the Breakpoint module</a> for "
"more information."
msgstr ""
"பிரேக்பாயிண்ட் குழு "
"பொதுவாக <em>viewport sizing</em> செய்ய "
"ஒரு காலியான மீடியா "
"கேள்வியுடன் ஒரு "
"பிரேக்பாயிண்ட் மட்டும் "
"தேவைப்படுகிறது. வேறு வேறு "
"viewport அளவுகளில் படங்களின் crop "
"அல்லது aspect ratio மாற்றுவதற்கு "
"பல பிரேக்பாயிண்ட் கள் "
"பயன்படுத்தப்படுகின்றன, "
"இதை பொதுவாக <em>art direction</em> என்று "
"சொல்வார்கள். உள்ளடக்க "
"மாற்றத்தை தவிர்க்க "
"ஒவ்வொரு aspect ratio க்கும் புதிய "
"பிரேக்பாயிண்ட் குழு "
"உருவாக்கப்பட வேண்டும். "
"நீங்கள் ஒரு "
"பிரேக்பாயிண்ட் குழு "
"தேர்ந்தெடுத்தவுடன், அந்த "
"பதில்வாக்கு பட பாணிக்க "
"எந்த பிரேக்பாயிண்ட் களை "
"பயன்படுத்தவேண்டும் "
"என்பதைக் தேர்வு "
"செய்யலாம். இயல்பாக, "
"ஒவ்வொரு "
"பிரேக்பாயிண்டுக்கும் <em>do "
"not use this breakpoint</em> எனும் "
"விருப்பம் "
"தேர்ந்தெடுக்கப்பட்டுள்ளது. "
"மேலும் தகவலுக்கு <a "
"href=\":breakpoint_help\">Breakpoint மொடியூலின் "
"உதவி பக்கம்</a> பார்க்கவும்."

msgid ""
"Composer must be configured for secure downloads. This means that <a "
"href=\":disable-tls\">the <code>disable-tls</code> option</a> must be "
"<code>false</code>, and <a href=\":secure-http\">the "
"<code>secure-http</code> option</a> must be <code>true</code> in the "
"<code>config</code> section of your <code>composer.json</code> file. "
"If these options are not set in your <code>composer.json</code>, "
"Composer will behave securely by default. To set these values at the "
"command line, run the following commands:"
msgstr ""
"Composer பாதுகாப்பான "
"பதிவிறக்கங்களுக்காக "
"கட்டமைக்கப்பட்டிருக்க "
"வேண்டும். இதன் பொருள் <a "
"href=\":disable-tls\"> <code>disable-tls</code> "
"விருப்பம்</a> <code>false</code> ஆகும், "
"மேலும் <a href=\":secure-http\"> <code>secure-http</code> "
"விருப்பம்</a> <code>true</code> ஆகும் "
"என்பதுதான் உங்கள் "
"<code>composer.json</code> கோப்பின் "
"<code>config</code> பிரிவில் இருக்க "
"வேண்டும். இந்த "
"விருப்புகள் உங்கள் "
"<code>composer.json</code> கோப்பில் "
"அமைக்கப்படாவிட்டால், Composer "
"இயல்பாகவே பாதுகாப்பாக "
"செயல்படுகிறது. இந்த "
"மதிப்புகளை கட்டளை "
"வரியில் அமைக்க, "
"கீழ்காணும் கட்டளைகளை "
"இயக்குங்கள்:"

msgid "Problem detected in lock file during stage operations."
msgid_plural "Problems detected in lock file during stage operations."
msgstr[0] ""
"நிலைபடி செயல்பாடுகளின் "
"போது பூட்டு கோப்பில் பிழை "
"கண்டறியப்பட்டது. நிலைபடி "
"செயல்பாடுகளின் போது "
"பூட்டு கோப்பில் பிழைகள் "
"கண்டறியப்பட்டன."

msgid ""
"The stage directory is not protected by PHP-TUF, which is required to "
"use Package Manager securely."
msgstr ""
"பேக்கேஜ் மேனேஜரை "
"பாதுகாப்பாக பயன்படுத்த "
"PHP-TUF தேவைப்படுகிறது, ஆனால் "
"ஸ்டேஜ் கோப்புறை அதை எந்த "
"பாதுகாப்பும் "
"வழங்கவில்லை."

msgid ""
"There appear to be no pending Composer operations because the active "
"lock file (@active_file) and the staged lock file (@staged_file) are "
"identical."
msgstr ""
"செயலில் உள்ள பூட்டு "
"கோப்பு (@active_file) மற்றும் "
"நிலுவையில் உள்ள பூட்டு "
"கோப்பு (@staged_file) இணையாக "
"உள்ளதால், இடைக்கால Composer "
"செயல்பாடுகள் எதுவும் "
"இல்லை போன்றது."

msgid "The field %field has been deleted from the %type %source_label."
msgstr ""
"%type %source_label இல் இருந்து %field "
"புலம் நீக்கப்பட்டுள்ளது."

msgid "Stage directory cleaner"
msgstr ""
"மாடி அடைவு தூய்மை "
"செய்பவர்"

msgid ""
"Include unrecognized files and directories in the project root in "
"staging operations"
msgstr ""
"மறுக்கப்படாத கோப்புகள் "
"மற்றும் அடைவை திட்ட "
"மூலத்தில் கட்டமைப்பு "
"செயல்களில் சேர்க்கவும்"

msgid "Rebuild content access permissions"
msgstr ""
"உள்ளடக்க அணுகல் "
"அனுமதிகளை மீண்டும் "
"உருவாக்கு"

msgid ""
"The @name config object does not contain any translatable values, so "
"it should not specify a language code."
msgstr ""
"@name கான்க் பொருள் "
"மொழிபெயர்க்கக்கூடிய "
"மதிப்புகளை bevatten "
"செய்யவில்லை, எனவே அது ஒரு "
"மொழி குறியீட்டை "
"குறிப்பிடக்கூடாது."

msgid ""
"Path of a file to which Composer Stager process output should be "
"logged"
msgstr ""
"கம்போஸர் ஸ்டேஜர் "
"செயல்முறை வெளியீடு பதிவு "
"செய்யப்பட வேண்டிய "
"கோப்பின் பாதை"

msgid "TUF is not enabled for the <code>@url</code> repository."
msgstr ""
"<code>@url</code> கோப்பகத்துக்காக TUF "
"இயக்கு செய்யப்படவில்லை."

msgid ""
"The Layout Builder Expose All Field Blocks module is a Feature Flag "
"module which exposes all fields on all bundles as field blocks for use "
"in Layout Builder."
msgstr ""
"Layout Builder Expose All Field Blocks மாட்யூல் "
"என்பது ஒரு Feature Flag மாட்யூல் "
"ஆகும், இது Layout Builder இல் "
"பயன்படுத்துவதற்காக "
"அனைத்து பண்டில்களில் "
"உள்ள அனைத்துப் "
"புலங்களையும் புலக் "
"கட்டுகளாக "
"வெளிப்படுத்துகிறது."

msgid ""
"For example, if Layout Builder is enabled on a Node bundle (Content "
"type), and that bundle's display is using field blocks from the User "
"entity (e.g. the Author's name), but Layout Builder is not enabled for "
"the User bundle, then that field block would no longer exist after "
"uninstalling this module."
msgstr ""
"உதாரணமாக, ஒரு Node பண்டிலில் "
"(உள்ளடக்கு வகை) Layout Builder "
"இயக்கப்பட்டிருக்கும்போது, "
"அந்த பண்டிலின் காட்சி User "
"இடைமுகத் தளத்திலிருந்து "
"வரும் புலம் தொகுதிகளை "
"(உதா. எழுத்தாளரின் பெயர்) "
"பயன்படுத்தினால், ஆனால் Layout "
"Builder User பண்டிலுக்கு "
"இயக்கப்படவில்லை என்றால், "
"இந்த மொட்யூலை அகற்றிய "
"பிறகு அந்த புல தொகுதி enää "
"இருக்காது."

msgid ""
"You can <em>only</em> add workflows on the <a "
"href=\":workflows\">Workflows page</a>, after you have installed a "
"module that leverages the API such as the <a "
"href=\":moderation\">Content Moderation module</a>."
msgstr ""
"நீங்கள் <em>மட்டும்</em> <a "
"href=\":workflows\">Workflows பக்கத்தில்</a> "
"மட்டுமே workflows ஐ சேர்க்கலாம், "
"API யை பயன்படுத்தும் ஒரு module "
"ஐ நிறுவித்த பின்னர், "
"உதாரணமாக <a "
"href=\":moderation\">உள்ளடக்கக் "
"கட்டுப்பாட்டு module</a>."

msgid ""
"You can <em>only</em> add workflows on the <a "
"href=\":workflows\">Workflows page</a>, after you have installed a "
"module that leverages the API such as the Content Moderation module."
msgstr ""
"நீங்கள் <em>அதிக</em> பணி "
"நடவடிக்கைகளை <a href=\":workflows\">பணி "
"நடவடிக்கைகள் "
"பக்கம்</a>யில் மட்டும் "
"சேர்க்க முடியும், APIயை "
"பயன்படுத்தும் ஒரு "
"தொகுதியை, உதாரணத்திற்கு "
"உள்ளடக்க மதிப்பீடு "
"தொகுதியை நிறுவிய பிறகு."

msgid ""
"A workflow requires at least two states. States can be added when you "
"add or edit a workflow on the <a href=\":workflows\">Workflows "
"page</a>."
msgstr ""
"ஒரு வேலைநடை குறைந்தது "
"இரண்டு நிலைகளைப் பெறு "
"வேண்டும். நீங்கள் <a "
"href=\":workflows\">வேலைநடைகள் "
"பக்கம்</a>வில் ஒரு வேலைநடை "
"சேர்க்கும்போது அல்லது "
"திருத்தும்போது நிலைகள் "
"சேர்க்கப்படலாம்."

msgid ""
"A transition defines in which state an item can be save as next. It "
"has one destination state, but can have several states <em>from</em> "
"which the transition can be applied. Transitions can be added when you "
"add or edit a workflow on the <a href=\":workflows\">Workflows "
"page</a>."
msgstr ""
"பரிமாற்றம் என்பது ஒரு "
"பொருள் அடுத்த கட்டமாக "
"எந்த நிலையில் "
"சேமிக்கப்படும் என்பதை "
"வரையறுக்கிறது. அதற்கு ஒரு "
"இலக்கு நிலை இருக்கும், "
"ஆனால் பரிமாற்றம் "
"பொருந்தக்கூடிய பல "
"<em>முதல்</em> நிலைகள் "
"இருக்கலாம். நீங்கள் <a "
"href=\":workflows\">ஏற்பாடுகள் "
"பக்கம்</a>ல் ஒரு பணியாளரைச் "
"சேர்க்கையோ அல்லது "
"தொகுப்பதோ செய்யும்போது, "
"பரிமாற்றங்களை "
"சேர்க்கலாம்."

msgid ""
"The UploadProgress PHP extension must be enabled to configure the "
"progress indicator. Check the <a href=\":status\">status report</a> "
"for more information."
msgstr ""
"UploadProgress PHP நீட்சியை "
"செயல்படுத்த வேண்டும் "
"முன்னேற்ற குறியீட்டியை "
"அமைக்க. மேலதிக "
"விவரங்களுக்கு <a "
"href=\":status\">நிலையின் "
"அறிக்கையை</a> "
"சரிபார்க்கவும்."

msgid "Whether or not to enable TLS opportunistically (defaults to true)."
msgstr ""
"TLS ஐ வாய்ப்புக்கேற்ப "
"இயலுமைப்படுத்தவா இல்லையா "
"(இயல்புநிலை மதிப்பு true)."

msgid "Whether or not to enforce TLS (defaults to false)."
msgstr ""
"TLS ஐ அமલ்படுத்த வேண்டுமா "
"இல்லையா (இயல்பாக false)."

msgid "Bind to a specific IPv4 or IPv6 address (no default)."
msgstr ""
"குறிப்பிட்ட IPv4 அல்லது IPv6 "
"முகவரிக்கு பிணைக்கவும் "
"(முன்னமைவு இல்லை)."

msgid "Installed %module module."
msgid_plural "Installed %module modules."
msgstr[0] ""
"%module மொட்யூல் "
"நிறுவப்பட்டுள்ளது.  \n"
"%module "
"மொட்யூல்கள் "
"நிறுவப்பட்டுள்ளன."

msgid "Set property of a config entity"
msgstr ""
"ஒரு config எண்டிட்டியின் "
"பண்பை அமைக்கவும்"

msgid "This value is not a valid extension name."
msgstr ""
"இந்த மதிப்பு "
"செல்லுபடியான நீட்டிப்பு "
"பெயர் அல்ல."

msgid "Menu link depth"
msgstr "மேனு இணைப்பு ஆழம்"

msgid "Preprocess callback is not valid: %error."
msgstr "Preprocess callback செல்லாதது: %error."

msgid "IdenticalTo"
msgstr "IdenticalTo -> ஒரேபோல்"

msgctxt "Validation"
msgid "At least one of"
msgstr "குறைந்தபட்சம் ஒன்று"

msgctxt "Validation"
msgid "Call a method on a service"
msgstr ""
"ஒரு சேவையில் ஒரு முறைமையை "
"அழைக்கவும்"

msgid "Plays Inline"
msgstr "இணைப்புக்குள் இயங்கும்"

msgid "Plays Inline: %playsinline"
msgstr "டிஸ்ப்ளேஸ் இன்லைன்: %playsinline"

msgid ""
"The core Language module lets you add new languages to your site, "
"provides the <em>Language switcher</em> block, and provides the "
"ability to configure block visibility by language; the block and block "
"visibility settings are only available if you have multiple languages "
"configured. The core Content Translation, Configuration Translation, "
"and Interface Translation modules let you translate content, "
"configuration, and the built-in user interface, respectively. The core "
"Locale module manages automatic downloads of community-provided "
"translations of default configuration and user-interface text if the "
"core Update Status module is installed. See the related topics listed "
"below for specific tasks."
msgstr ""
"மூல Language மெருகூட்டல் "
"உங்கள் தளத்தில் புதிய "
"மொழிகளைச் சேர்க்க "
"அனுமதிக்கிறது, <em>Language switcher</em> "
"பிளாக்கை வழங்குகிறது, "
"மற்றும் மொழியின்படி "
"பிளாக் காண்பிப்பை "
"அமைக்கக்கூடிய திறனையும் "
"வழங்குகிறது; பிளாகும் "
"பிளாக் காண்பிப்பு "
"அமைப்புகளும் பல மொழிகள் "
"அமைக்கப்பட்டிருந்தால் "
"மட்டுமே கிடைக்கும். மூல "
"Content Translation, Configuration Translation, மற்றும் "
"Interface Translation மெருகூட்டல்கள் "
"தாங்கள்தான் உள்ளடக்கம், "
"அமைப்புகள், மற்றும் மூல "
"பயனர் இடைமுகத்தை முறையே "
"மொழிபெயர்க்க "
"அனுமதிக்கின்றன. மூல Locale "
"மெருகூட்டல், மூல Update Status "
"மெருகூட்டல் "
"நிறுவப்பட்டிருந்தால், "
"அடிப்படை அமைப்பு மற்றும் "
"பயனர் இடைமுக உரையின் "
"சமூகத்தால் வழங்கப்படும் "
"மொழிபெயர்ச்சிகளை தானாக "
"பதிவிறக்கம் செய்ய "
"நிர்வகிக்கிறது. "
"குறிப்பிட்ட பணிகளுக்கு "
"கீழே கொடுக்கப்பட்ட "
"தொடர்புடைய "
"தலைப்புக்களைப் "
"பார்வையிடவும்."

msgid ""
"Wait for the translation system to be updated. Also, if you have the "
"core Update Status module installed and translations are available for "
"your language, wait for translations to be downloaded. You should be "
"returned to the <em>Languages</em> page when this completes."
msgstr ""
"மொழிபெயர்ப்பு முறைமை "
"புதுப்பிக்கப்படுவதை "
"காத்திருக்கவும். மேலும், "
"நீங்கள் கோர் Update Status "
"மோடியூலை "
"நிறுவியிருந்தால் மற்றும் "
"உங்கள் மொழிக்கான "
"மொழிபெயர்ப்புகள் "
"கிடைக்கும் என்றால், "
"மொழிபெயர்ப்புகள் "
"பதிவிறக்கம் "
"செய்யப்படுவதை "
"காத்திருக்கவும். இது "
"முடிந்ததும் நீங்கள் "
"<em>மொழிகள்</em> பக்கத்திற்கு "
"திருப்பி "
"அனுப்பப்படுவீர்கள்."

msgid "Ignoring already imported translation for %project."
msgstr ""
"%projectக்காக ஏற்கனவே "
"இறக்குமதி செய்யப்பட்ட "
"மொழிபெயர்ப்பை "
"புறக்கணிக்கிறது."

msgid ""
"Obsolete. All the functionality has been moved to the navigation "
"module."
msgstr ""
"பழையது. அனைத்து "
"செயல்பாடுகளும் "
"வழிசெலுத்தல் தொகுப்ப "
"module-க்கு "
"நகர்த்தப்பட்டுள்ளன."

msgid ""
"Forms and links inside the content of the layout builder tool are "
"disabled in Edit mode."
msgstr ""
"லேஅவுட் பில்டர் "
"கருவியின் உள்ளடக்கத்தில் "
"உள்ள படிவங்கள் மற்றும் "
"இணைப்புகள் தொகுத்தல் "
"முறையில் "
"முடக்கப்பட்டுள்ளன."

msgid "@state_label (@active_state_label available)"
msgstr "@state_label (@active_state_label கிடைக்கும்)"

msgid "Page Context"
msgstr "பக்கத்தின் பின்னணி"

msgid "Administrative top bar"
msgstr "நிர்வாக செயல்தட்டம்"

msgid "This filter has no effect because the %module module controls access."
msgid_plural ""
"This filter has no effect because these modules control access: "
"%modules."
msgstr[0] ""
"இந்த வடிகட்டல் எந்த "
"விளைவையும் ஏற்படுத்தாது, "
"ஏனெனில் %module மொட்யூல் "
"அணுகலை "
"கட்டுப்படுத்துகிறது.  "
"\n"
"இந்த வடிகட்டல் எந்த "
"விளைவையும் ஏற்படுத்தாது, "
"ஏனெனில் இந்த ਮொட்யூல்கள் "
"அணுகலை "
"கட்டுப்படுத்துகின்றன: "
"%modules."

msgid "Content status filter"
msgstr "உள்ளடக்க நிலை வடிகட்டி"

msgid "Redundant filters detected"
msgstr ""
"மீண்டும் "
"பயன்படுத்தப்பட்ட "
"வடிகட்டிகள் "
"கண்டறியப்பட்டன"

msgid ""
"The %view view uses the %status_filter filter but it has no effect "
"because the following module(s) control access: %modules. Review and "
"consider removing the filter."
msgid_plural ""
"The following views use the %status_filter filter but it has no effect "
"because the following module(s) control access: %modules. Review and "
"consider removing the filter from these views: @views"
msgstr[0] ""
"%view கான %status_filter வடிகட்டியைப் "
"பயன்படுத்துகிறது, ஆனால் "
"%modules என்ற பின்வரும் "
"முறை(கள்) அணுகலை "
"கட்டுப்படுத்தும் "
"என்பதால் அதன் தாக்கம் "
"காணப்படவில்லை. "
"தயவுசெய்து இந்த "
"வடிகட்டியை மறுபரிசீலனை "
"செய்து தேவையில்லாதால் "
"அகற்ற பரிந்துரைக்கவும்.  "
"\n"
"பின்வரும் காண்வுகள் "
"%status_filter வடிகட்டியைப் "
"பயன்படுத்துகின்றன ஆனால் "
"%modules என்ற பின்வரும் "
"முறை(கள்) அணுகலை "
"கட்டுப்படுத்தும் "
"என்பதால் அவற்றிற்கு எந்த "
"தாக்கமும் இல்லை. இந்த "
"காண்வுகளிலிருந்து (@views) "
"அந்த வடிகட்டியை அகற்ற "
"மறுபரிசீலனை செய்யவும்."

msgid "Direct-write is enabled. Skipping sandboxing."
msgstr ""
"டிரக்ட்-ரைட் இயக்கு "
"செய்யப்பட்டு உள்ளது. "
"சாந்திரமிடல் "
"தவிர்க்கப்படுகிறது."

msgid ""
"Direct-write is enabled. Changes have been made to the running code "
"base."
msgstr ""
"Direct-write "
"செயல்படுத்தப்பட்டுள்ளது. "
"இயக்கத்தில் உள்ள "
"குறியீடு அடிப்படையில் "
"மாற்றங்கள் "
"செய்யப்பட்டுள்ளன."

msgid ""
"Direct-write mode is enabled, which means that changes will be made "
"without sandboxing them first. This can be risky and is not "
"recommended for production environments. For safety, your site will be "
"put into maintenance mode while dependencies are updated."
msgstr ""
"Direct-write முறையை இயக்கி உள்ளது, "
"அதாவது மாற்றங்கள் "
"முதலில் சாண்ட்பாக்சிங் "
"செய்யாமல் நேரடியாக "
"செய்யப்படும். இது "
"ஆபத்தானதாக "
"இருக்கக்கூடும் மற்றும் "
"உற்பத்தி சூழல்களுக்கு "
"பரிந்துரைக்கப்படவில்லை. "
"பாதுகாப்புக்காக, உங்கள் "
"தளம் சார்புகள் "
"புதுப்பிக்கப்படும்போது "
"பராமரிப்பு முறையில் "
"வைக்கப்படும்."

msgid "The sandbox directory is a subdirectory of the active directory."
msgstr ""
"sandbox அடைவகம் active அடைவகத்தின் "
"ஒரு உப அடைவகம் ஆகும்."

msgid "The pg_trgm PostgreSQL extension is present."
msgstr ""
"pg_trgm PostgreSQL விரிவாக்கம் "
"உள்ளது."

msgid "%profile_name (%profile%version)"
msgstr "%profile_name (%profile% பதிப்பு)"

msgid ""
"Drupal is unable to generate highly randomized numbers, which means "
"certain security features like password reset URLs are not as secure "
"as they should be. Instead, only a slow, less-secure fallback "
"generator is available. The most likely cause is that open_basedir "
"restrictions are in effect and /dev/urandom is not on the allowed "
"list. See the <a href=\":drupal-php\">system requirements</a> page for "
"more information. %exception_message"
msgstr ""
"Drupal மிகவும் சீரற்ற "
"எண்ணுகளை உருவாக்க "
"முடியாமல் இருக்கும், இதன் "
"காரணமாக கடவுச்சொல் "
"மீட்டமைப்பு URL போன்ற சில "
"பாதுகாப்பு அம்சங்கள் "
"அவற்றாக இருக்க வேண்டிய "
"அளவுக்கு பாதுகாப்பாக "
"இருக்காது. அதன் மாற்றாக, "
"மெதுவான மற்றும் குறைந்த "
"பாதுகாப்பு கொண்ட பதிலடி "
"உருவாக்கி மட்டும் "
"கிடைக்கும். மிகுந்த "
"சாத்தியமான காரணம் open_basedir "
"கட்டுப்பாடுகள் அமலில் "
"உள்ளதால் /dev/urandom "
"அனுமதிக்கப்பட்ட "
"பட்டியலில் "
"சேர்க்கப்படவில்லை என்பதே "
"ஆகும். மேலும் தகவலுக்கு <a "
"href=\":drupal-php\">சிஸ்டம் தேவைகள்</a> "
"பக்கத்தை பார்க்கவும். "
"%exception_message"

msgid ""
"Update notifications are not enabled. It is <strong>highly "
"recommended</strong> that you install the Update Status module from "
"the <a href=\":module\">module administration page</a> in order to "
"stay up-to-date on new releases. For more information, <a "
"href=\":update\">Update status handbook page</a>."
msgstr ""
"புதுப்பிப்பு "
"அறிவிப்புகள் "
"இயல்பாக்கப்படவில்லை. "
"புதிய வெளியீடுகளில் "
"தொடர்ந்து ενηதியாக இருக்க "
"<strong>மிகவும் "
"பரிந்துரைக்கப்படுகிறது</strong> "
"நீங்கள் <a href=\":module\">module "
"நிர்வாகப் பக்கம்</a> "
"இலிருந்து Update Status மொட்யூலை "
"நிறுவலாக வேண்டும். மேலும் "
"தகவலுக்கு, <a href=\":update\">Update status "
"handbook பக்கம்</a> ஐ பாருங்கள்."

msgid ""
"If you have the core Update Status module installed, in the "
"<em>Manage</em> administrative menu, navigate to <em>Reports</em> &gt; "
"<em>Available updates</em> to see a report of the updates that are "
"available for your site software. If <em>Last checked</em> is far in "
"the past, click <em>Check manually</em> to update the report. Scan the "
"report; if the core software or any modules or themes have security "
"updates available, you should update them as soon as possible."
msgstr ""
"நீங்கள் கோர் Update Status "
"மொட்யூலை நிறுவி "
"இருக்குமானால், <em>Manage</em> "
"நிர்வாக மெனுவில், <em>Reports</em> &gt; "
"<em>Available updates</em> என்பதில் "
"சென்றடைந்து உங்கள் தள "
"மென்பொருளுக்கு "
"கிடைக்கும் "
"புதுப்பிப்புகளின் "
"அறிக்கையைப் பார்க்கவும். "
"<em>Last checked</em> மிக தொலைவில் "
"இருந்தால், அறிக்கையை "
"புதுக்க <em>Check manually</em> என்பதைக் "
"கிளிக் செய்யவும். "
"அறிக்கையை பரிசோதித்து; "
"கோர் மென்பொருள் அல்லது "
"எந்த மொட்யூல்கள் அல்லது "
"தீம்களுக்காகவும் "
"பாதுகாப்பு "
"புதுப்பிப்புகள் "
"கிடைத்துள்ளன என்றால், "
"அவற்றை உடனடியாக "
"புதுப்பிக்க வேண்டும்."

msgid ""
"Regularly review available updates and update as required to maintain "
"a secure and current site. Always run the <a "
"href=\":update-php\">update script</a> each time a module is updated. "
"Install the <a href=\":update-status\">Update Status module</a> to see "
"a report of available releases for Drupal Core and contributed modules "
"and themes."
msgstr ""
"பாதுகாப்பான மற்றும் "
"புதுப்பிக்கப்பட்ட தளத்தை "
"பராமரிக்க தேவையெனில் "
"கிடைக்கும் "
"புதுப்பிப்புகளை "
"பின்முறையாக பரிசீலித்து "
"புதுப்பிக்கவும். ஒரு "
"மொட்டுள் "
"புதுப்பிக்கப்படும்போது "
"ஒவ்வொரு முறையும் <a "
"href=\":update-php\">புதுப்பிப்பு "
"ஸ்கிரிப்ட்</a> இயக்கவும். Drupal "
"Core மற்றும் பங்களிப்பு "
"மொட்டுள் மற்றும் "
"தீம்களுக்கு கிடைக்கும் "
"வெளியீடுகளின் அறிக்கையை "
"பார்க்க <a "
"href=\":update-status\">புதுப்பிப்பு "
"நிலை மொட்டுள்</a> நிறுவவும்."

msgid "Update Status settings"
msgstr ""
"நிலையின் அமைப்புகளை "
"புதுப்பிக்கவும்"

msgid ""
"The Update Status module periodically checks for new versions of your "
"site's software (including contributed modules and themes), and alerts "
"administrators to available updates. The Update Status system is also "
"used by some other modules to manage updates and downloads; for "
"example, the Interface Translation module uses the Update Status to "
"download translations from the localization server. Note that whenever "
"the Update Status system is used, anonymous usage statistics are sent "
"to Drupal.org. If desired, you may uninstall the Update Status module "
"from the <a href=\":modules\">Extend page</a>; if you do so, "
"functionality that depends on the Update Status system will not work. "
"For more information, see the <a href=\":update\">online documentation "
"for the Update Status module</a>."
msgstr ""
"உங்கள் site's மென்பொருள் "
"(பங்களிக்கப்பட்ட "
"மொட்யூல்கள் மற்றும் "
"தீம்களும் அடங்கும்) புதிய "
"பதிப்புகளுக்கான "
"புதுப்பிப்புகளை Update Status "
"மொட்யூல் காலக்கெடுவுடன் "
"சரிபார்க்கிறது மற்றும் "
"நிர்வாகிகளை "
"கிடைக்கக்கூடிய "
"புதுப்பிப்புகள் பற்றி "
"அறிவிக்கிறது. Update Status "
"அமைப்பு சில பிற "
"மொட்யூல்கள் மூலம் "
"புதுப்பிப்புகள் மற்றும் "
"பதிவிறக்கங்களை "
"நிர்வகிக்கவும் "
"பயன்படுத்தப்படுகிறது; "
"எடுத்துக்காட்டாக, Interface "
"Translation மொட்யூல் "
"மொழிபெயர்ப்புகளை localization "
"சர்வரிலிருந்து பதிவிறக்க "
"Update Status ஐ பயன்படுத்துகிறது. "
"Update Status அமைப்பு "
"பயன்படுத்தப்படும் போது, "
"பெயரளாவும் பயிற்றின் "
"தரவுகள் Drupal.org க்கு "
"அனுப்பப்படுகின்றன என்பதை "
"கவனிக்கவும். "
"வேண்டுமானால், நீங்கள் <a "
"href=\":modules\">Extend "
"பக்கம்</a>இலிருந்து Update Status "
"மொட்யூலை அகற்றலாம்; ஆனால் "
"அப்படிச் செய்தால் Update Status "
"அமைப்பில் சார்ந்த பணிகள் "
"செயல்படாது. மேலும் "
"தகவலுக்கு, <a href=\":update\">Update Status "
"மொட்யூலுக்கான ஆன்லைன் "
"வழிகாட்டியைக்</a> காணவும்."

msgid ""
"The <a href=\":update-report\">Available updates report</a> displays "
"core, contributed modules, and themes for which there are new releases "
"available for download. On the report page, you can also check "
"manually for updates. You can configure the frequency of update "
"checks, which are performed during cron runs, and whether "
"notifications are sent on the <a href=\":update-settings\">Update "
"Status settings page</a>."
msgstr ""
"<a href=\":update-report\">கிடைக்கும் "
"புதுப்பிப்புகள் "
"அறிக்கை</a> இணைப்பில், மையக் "
"கோடுகள், பங்களிப்பு "
"தொகுதிகள், மற்றும் புதிய "
"வெளியீடுகள் பதிவிறக்கம் "
"செய்ய கிடைக்கும் "
"தீம்களைக் காணலாம். "
"அறிக்கை பக்கத்தில், "
"நீங்கள் புதுப்பிப்புகளை "
"கைமுறையாகச் சோதிக்கவும் "
"முடியும். புதுப்பிப்பு "
"சோதனைகள் எத்தனை அடிக்கடி "
"இயங்க வேண்டும் என்பதை "
"நீங்கள் <a "
"href=\":update-settings\">புதுப்பிப்பு "
"நிலை அமைவுகள் பக்கம்</a>ல் "
"அமைக்கலாம், மேலும் "
"அறிவிப்புகள் "
"அனுப்பப்படுமா எனவும் "
"அதில் முடிவு செய்யலாம்."

msgid ""
"The core User module allows users to register, log in, and log out, "
"and administrators to manage user roles and permissions. Depending on "
"which modules you have installed on your site, the related topics "
"below will help you with tasks related to managing user accounts and "
"visitors."
msgstr ""
"முக்கிய User முறைமை "
"பயனர்களுக்கு பதிவுசெய்ய, "
"உள்நுழைய, மற்றும் வெளியேற "
"அனுமதிக்கிறது, மேலும் "
"நிர்வாகிகளுக்கு பயனர் "
"பத்திரங்கள் மற்றும் "
"அனுமதிகளை நிர்வகிக்க "
"உதவுகிறது. உங்கள் "
"தளத்தில் நிறுவியுள்ள "
"முறைமைகள் பொறுத்து, கீழே "
"உள்ள தொடர்புடைய "
"தலைப்புகள் பயனர் "
"கணக்குகள் மற்றும் பரிசு "
"விருந்தினர்களை "
"நிர்வகிக்கும் பணிகளில் "
"உங்களுக்கு உதவும்."

msgid "Table class"
msgstr "அட்டவணை வகுப்பு"

msgid "@label view mode"
msgstr "@label பார்வை முறை"

msgid "How should each row in this view be output"
msgstr ""
"இந்த பார்வையில் ஒவ்வொரு "
"வரிசையும் எப்படி "
"வெளியிடப்பட வேண்டும்?"

msgid ""
"If neither the row nor the style plugin supports fields, this field "
"allows to enable them, so you can for example use group by."
msgstr ""
"ஒரு வரிசையும் அல்லது "
"ஸ்டைல் பிளகினும் "
"புலங்களை ஆதரிக்கவில்லை "
"என்றால், இந்த புலம் அவற்றை "
"இயக்கு உங்களுக்கு "
"அனுமதிக்கிறது, எனவே "
"நீங்கள் உதாரணத்திற்கு "
"குழு பிரிப்பை "
"பயன்படுத்தலாம்."

msgid "Table CSS classes"
msgstr "அட்டவணை CSS வகுப்புகள்"

msgid ""
"Classes to provide on the table. Separate multiple classes with a "
"space. Example: classA classB"
msgstr ""
"மேசைக்கு வழங்குவதற்கான "
"வகுப்புகள். பல வகுப்புகளை "
"இடைவெளியுடன் "
"பிரிக்கவும். உதாரணம்: classA "
"classB"

msgid "output as"
msgstr "output as"

msgid "This site is intended for demonstration purposes."
msgstr ""
"இந்த தளம் காணொளி "
"தொடங்குவதற்கான "
"நோக்கத்தின்போது "
"உருவாக்கப்பட்டுள்ளது."

msgid "Add component(s) to layout"
msgstr ""
"விருத்தம் "
"நடைமுறைபடுத்துவதற்கு "
"கூறு(களை) வடிவமைப்பில் "
"சேர்க்கவும்"

msgid ""
"The %field date is invalid. Date should be in the %min-%max year "
"range."
msgstr ""
"%field தேதி தவறானது. தேதி %min-%max "
"ஆண்டு வரம்பில் இருக்க "
"வேண்டும்."

msgid "Composer was found at %path, but could not be made read-only."
msgstr ""
"Composer %path இல் "
"கண்டுபிடிக்கப்பட்டது, "
"ஆனால் அதனை படிக்கக்கூடிய "
"நிலைமையாக்க முடியவில்லை."

msgid ""
"If the <code>composer</code> executable's path cannot be automatically "
"determined, you will need to add Composer to your project by running "
"the following command: <code>composer require "
"\"composer/composer:@version\"</code>:"
msgstr ""
"உங்கள் <code>composer</code> executable பாதை "
"தானாக கண்டறிய "
"முடியாவிட்டால், "
"கீழ்காணும் கட்டளையை "
"இயக்கி உங்கள் "
"திட்டத்தில் Composer ஐ சேர்க்க "
"வேண்டும்: <code>composer require "
"\"composer/composer:@version\"</code>:"

msgid ""
"The version of the <code>composer</code> executable must satisfy "
"<code>@version</code>. See the <a href=\":url\">the Composer "
"documentation</a> for more information, or use this command to add "
"Composer to your project: <code>composer require "
"\"composer/composer:@version\"</code>"
msgstr ""
"<code>composer</code> இயங்குதளத்தின் "
"பதிப்பு <code>@version</code> "
"என்பதற்கு ஏற்ப இருக்க "
"வேண்டும். மேலும் "
"தகவலுக்கு <a href=\":url\">கம்போசர் "
"ஆவணத்தை</a> பார்க்கவும், "
"அல்லது உங்கள் "
"திட்டத்தில் Composer சேர்க்க "
"இந்த கட்டளையை "
"பயன்படுத்தவும்: <code>composer require "
"\"composer/composer:@version\"</code>"

msgid ""
"The path to Composer is set in configuration, which is no longer "
"supported. To fix this, add <code>composer/composer</code> to your "
"project's dependencies by running <code>composer require "
"'composer/composer:@version'</code>, <em>or</em> add the following "
"line to <code>settings.php</code>: "
"<code>$settings['package_manager_composer_path'] = "
"'@composer_path';</code>. See <a href=\":url\">this change record</a> "
"for more information."
msgstr ""
"கொண்போஸரை (Composer) செல்லும் "
"பாதை அமைப்புகளில் "
"குறிப்பிடப்பட்டுள்ளது, "
"இது இப்போது "
"ஆதரிக்கப்படுவதில்லை. "
"இதனை சரி செய்ய, <code>composer require "
"'composer/composer:@version'</code> என இயக்கி "
"<code>composer/composer</code> ஐ உங்கள் "
"திட்டத்தின் சார்புகளில் "
"சேர்க்கவும், <em>அல்லது</em> "
"<code>settings.php</code> இல் கீழ்காணும் "
"வரியைச் சேர்க்கவும்: "
"<code>$settings['package_manager_composer_path'] = "
"'@composer_path';</code>. மேலும் "
"தகவலுக்கு <a href=\":url\">இந்த "
"மாற்ற பதிவு</a> ஐப் "
"பார்க்கவும்."

msgid "Path to <code>rsync</code> is configured"
msgstr ""
"<code>rsync</code>க்கு பாதை "
"அமைக்கப்பட்டுள்ளது"

msgid ""
"The path to <code>rsync</code> is set in configuration, which is no "
"longer supported. To fix this, add the following line to "
"<code>settings.php</code>: "
"<code>$settings['package_manager_rsync_path'] = '@rsync_path';</code>. "
"See <a href=\":url\">this change record</a> for more information."
msgstr ""
"<code>rsync</code> இற்கு பாதை அமைவு "
"கோப்பில் "
"குறிப்பிடப்பட்டுள்ளது, "
"ஆனால் இது இனிமேல் "
"ஆதரிக்கப்படாது. இதை "
"சரிசெய்வதற்கு, பின்கூறிய "
"வரியை <code>settings.php</code>-இல் "
"சேர்க்கவும்: "
"<code>$settings['package_manager_rsync_path'] = '@rsync_path';</code>. "
"மேலதிகத் தகவலுக்கு <a "
"href=\":url\">இந்த மாற்றக் "
"குறிப்பினைப் "
"பார்க்கவும்</a>."

msgid ""
"A unique machine-readable name. Can only contain lowercase letters, "
"numbers, and hyphens."
msgstr ""
"ஒரு தனித்துவமான "
"இயந்திரம் வாசிக்கக்கூடிய "
"பெயர். இது சிறிய "
"எழுத்துக்கள், எண்கள் "
"மற்றும் "
"குறுக்கெழுத்துக்களை "
"மட்டுமே கொண்டிருக்கலாம்."

msgid "One entity was exported to @dir."
msgid_plural "@count entities were exported to @dir."
msgstr[0] ""
"ஒரு உருவகம் @dir-க்கு "
"ஏற்றுமதி செய்யப்பட்டது.  "
"\n"
"@count உருவகங்கள் @dir-க்கு "
"ஏற்றுமதி "
"செய்யப்பட்டுள்ளன."

msgid ""
"Failed to export reference to @target_type %missing_id referenced by "
"%field on @entity_type %label because the referenced @target_type does "
"not exist."
msgstr ""
"@entity_type %label இல் உள்ள %field மூலம் "
"குறிப்பிடப்பட்ட @target_type %missing_id "
"க்கு குறிப்பு ஏற்றுமதி "
"செய்ய முடியவில்லை, "
"ஏனென்றால் "
"குறிப்பிடப்பட்ட @target_type "
"இல்லை."

msgid "View @entity_label"
msgstr "@entity_label ஐப் பார்"

msgid "View @entity_bundle @entity_id"
msgstr ""
"@entity_bundle @entity_id ஐ "
"எழுத்துச்சொல்ல்களைப் "
"பார்க்க"

msgid "Maintenance mode enabled."
msgstr ""
"பராமரிப்பு நிலை "
"இயக்கப்பட்டுள்ளது."

msgid "Maintenance mode disabled."
msgstr ""
"பராமரிப்பு முறைமை "
"முடக்கப்பட்டது."

msgctxt "Validation"
msgid "Extension is available"
msgstr "விருப்பவகை கிடைக்கிறது"

msgid "Module '@name' is not available."
msgstr ""
"'@name' என்ற மாடுல் "
"கிடைக்கவில்லை."

msgid "Theme '@name' is not available."
msgstr "தீம் '@name' கிடைக்கவில்லை."

msgid "Profile '@name' is not available."
msgstr "போலி '@name' கிடைக்கவில்லை."

msgid "Positive or zero"
msgstr "நெகடிவ் அல்லது பூஜ்ஜியம்"

msgctxt "Validation"
msgid "Valid sequence keys"
msgstr ""
"செல்லுபடியான வரிசை "
"விசைகள்"

msgid "The keys of the sequence do not match the given constraints."
msgstr ""
"ஒருமுறைசிரிப்பு விசைகள் "
"கொடுக்கப்பட்ட "
"கட்டுப்பாடுகளுடன் "
"பொருந்தவில்லை."

msgid "Block Content storage body field"
msgstr ""
"பிளாக் உள்ளடக்க சேமிப்பு "
"גוף துறை"

msgid "When enabled, this module adds a default block content body field."
msgstr ""
"செயல்படுத்தப்பட்டால், "
"இந்த மொகியூல் ஒரு "
"இயல்புநிலை தொகுதி "
"உள்ளடக்க உடல் புலத்தை "
"சேர்க்கும்."

msgid ""
"The Block Content module manages the creation, editing, and deletion "
"of content blocks. Content blocks are field-able content entities "
"managed by the <a href=\":field\">Field module</a>. For more "
"information, see the <a href=\":block-content\">online documentation "
"for the Block Content module</a>."
msgstr ""
"Block Content அம்சம் உள்ளடக் "
"குறுக்கெழுத்துக்களை "
"உருவாக்கல், திருத்தல் "
"மற்றும் நீக்கத்தை "
"நிர்வகிக்கிறது. உள்ளடக் "
"குறுக்கெழுத்துக்கள் <a "
"href=\":field\">Field module</a> மூலம் "
"நிர்வகிக்கப்படும் "
"புலங்கள் கொண்ட உள்ளடக் "
"இயக்கங்கள் ஆகும். மேலும் "
"தகவலுக்காக, <a href=\":block-content\">Block "
"Content module இணைய ஆவணத்தை</a> "
"பார்க்கவும்."

msgid ""
"Users with the <em>Administer block types</em> permission can create "
"and edit block types with fields and display settings, from the <a "
"href=\":types\">Block types</a> page under the Structure menu. For "
"more information about managing fields and display settings, see the "
"<a href=\":field-ui\">Field UI module help</a> and <a "
"href=\":field\">Field module help</a>."
msgstr ""
"<em>Administer block types</em> அனுமதி பெற்ற "
"பயனர்கள், <a href=\":types\">Block types</a> "
"பக்கத்தில் உள்ள "
"கட்டமைப்பு மெனுவின் கீழ் "
"ப்ளாக் வகைகளை "
"புலங்களுடன் மற்றும் "
"காட்சிப் "
"პარாமீட்டர்களுடன் "
"உருவாக்கி தொகுக்க "
"முடியும். புலங்களின் "
"மற்றும் காட்சிப் "
"პარாமீட்டர்களின் "
"மேலாண்மை பற்றி மேலதிக "
"தகவலுக்கு, <a href=\":field-ui\">Field UI module "
"help</a> மற்றும் <a href=\":field\">Field module "
"help</a> என்பதைக் காணவும்."

msgid ""
"Users with the <em>Administer block content</em> or <em>Create new "
"content block</em> permissions for an individual block type are able "
"to add content blocks. These can be created on the <a "
"href=\":add-content-block\">Add content block page</a> or on the "
"<em>Place block</em> modal on the <a href=\":block-layout\">Block "
"Layout page</a> and are reusable across the entire site. Content "
"blocks created in Layout Builder for a content type or individual node "
"layouts are not reusable and also called inline blocks."
msgstr ""
"ஒரு தனித்தனி தொகுதி "
"வகைக்கு <em>Administer block content</em> "
"அல்லது <em>Create new content block</em> "
"அனுமதிகள் உள்ள பயனர்கள் "
"உள்ளடக்க தொகுதிகளை "
"சேர்க்க முடியும். இவற்றை <a "
"href=\":add-content-block\">Add content block பக்கம்</a> "
"அல்லது <a href=\":block-layout\">Block Layout "
"பக்கத்தில்</a> உள்ள <em>Place block</em> "
"மொடலில் உருவாக்கிக்கொள்ள "
"முடியும் மற்றும் இவை முழு "
"தளத்தில் மீண்டும் "
"பயன்படுத்தக்கூடியவை. Layout "
"Builder-ல் உள்ளடக்க வகைக்கு "
"அல்லது தனித்தனி நோட் "
"வடிவமைப்புகளுக்காக "
"உருவாக்கப்பட்ட உள்ளடக்க "
"தொகுதிகள் மீண்டும் "
"பயன்படுத்தக்கூடியவை அல்ல "
"மற்றும் இவைகளை inline blocks "
"என்றும் அழைக்கின்றனர்."

msgid "Allow list style type"
msgstr ""
"பட்டியல் வகை மாதிரியை "
"அனுமதி அளி்"

msgid "Allow the user to choose a list style type"
msgstr ""
"பயனருக்கு பட்டியல் "
"ஸ்டைல் வகையைத் "
"தேர்வுசெய்ய "
"அனுமதிக்கவும்"

msgid ""
"Available list style types for ordered lists: letters and Roman "
"numerals instead of only numbers. Available list style types for "
"unordered lists: circles and squares instead of only discs."
msgstr ""
"வரிசைப்படுத்தப்பட்ட "
"பட்டியல்களுக்கு "
"பயன்படுத்தக்கூடிய "
"பட்டியல் அமைப்புத் "
"வகைகள்: எண்களுக்குப் "
"பதிலாக எழுத்துக்கள் "
"மற்றும் ரோமானிய எண்ணுகள். "
"வரிசைப்படுத்தப்படாத "
"பட்டியல்களுக்கு "
"பயன்படுத்தக்கூடிய "
"பட்டியல் அமைப்புத் "
"வகைகள்: வட்டங்கள் மற்றும் "
"சதுரங்கள், க்கு பதிலாக "
"மட்டுமல்லாத "
"வட்டக்கோள்கள்."

msgid "Add new comment to %label"
msgstr ""
"%labelக்கு புதிய கருத்தைச் "
"சேர்க்கவும்"

msgid "The file (%uri) associated with file entity %name does not exist."
msgstr ""
"எ ஆவண (%uri) %name என்ற கோப்பு "
"அதிரககுடன் "
"இணைக்கப்பட்டுள்ளதில்லை."

msgid ""
"The core Node, Comment, Content Block, Custom Menu Links, User, File, "
"Image, Media, and Taxonomy modules all provide content entity types."
msgstr ""
"முக்கியமான Node, Comment, Content Block, Custom "
"Menu Links, User, File, Image, Media, மற்றும் Taxonomy "
"மொடியூல்கள் எல்லாவும் "
"உள்ளடக்க இருப்பு வகைகள் "
"வழங்குகின்றன."

msgid "Discard unsaved changes"
msgstr ""
"சேமிக்காத மாற்றங்களை "
"மறுவிடு"

msgid ""
"Any unsaved changes to the layout for %label will be discarded. This "
"action cannot be undone."
msgstr ""
"%label க்கான அமைப்பில் "
"எந்தவொரு சேமிக்கப்படாத "
"மாற்றங்களும் "
"நீக்கப்படும். இந்த செயல் "
"மாற்றமடைய முடியாது."

msgid ""
"Any unsaved changes to the layout will be discarded. This action "
"cannot be undone."
msgstr ""
"வடிவமைப்பில் "
"சேமிக்கப்படாத எந்த "
"மாற்றங்களும் "
"நீக்கப்படும். இந்த செயலை "
"மீண்டும் பின்கொள்வதற்கான "
"வாய்ப்பு இல்லை."

msgid "Revert to the default layout"
msgstr ""
"இயல்புநிலையான "
"அமைப்புக்கு திரும்பி "
"செல்லவும்"

msgid ""
"The layout for %label will be reverted to its default state. All "
"layout modifications and inline blocks wil be reset."
msgstr ""
"%labelக்கான அமைப்பு அதன் "
"இயல்புநிலைக்கு மறு "
"அமைக்கப்படும். அனைத்து "
"அமைப்பு திருத்தங்களும் "
"மற்றும் நேரடி "
"தொகுதிகளும் "
"மீட்டமைக்கப்படும்."

msgid ""
"The layout will be reverted to its default state. All layout "
"modifications and inline blocks will be reset."
msgstr ""
"அடுக்கு அதன் தலையங்க "
"நிலைக்கு "
"மீட்டமைக்கப்படும். "
"அனைத்து அடுக்கு "
"மாற்றங்களும் மற்றும் "
"வரிசை உள்ளமைக்கப்பட்ட "
"பிளாக்குகளும் "
"மீட்டமைக்கப்படும்."

msgid "Database driver for MySQLi."
msgstr ""
"MySQLi க்கான தரவுத்தளம் "
"இயக்கி."

msgid "@parent via mysqli (Experimental)"
msgstr ""
"@parent மூலம் mysqli (சோதனை "
"நிலையில்)"

msgid ""
"The MySQLi module provides the connection between Drupal and a MySQL, "
"MariaDB or equivalent database using the mysqli PHP extension. For "
"more information, see the <a href=\":mysqli\">online documentation for "
"the MySQLi module</a>."
msgstr ""
"MySQLi மாடியூல் Drupal மற்றும் MySQL, "
"MariaDB அல்லது இணையான "
"தரவுத்தளத்துக்கு mysqli PHP "
"விரிவாக்கத்தை "
"பயன்படுத்தி தொடர்பை "
"வழங்குகிறது. மேலதிக "
"தகவலுக்கு, <a href=\":mysqli\">MySQLi "
"மாடியூலுக்கான ஆன்லைன் "
"ஆவணத்தை</a> பார்க்கவும்."

msgid ""
"Trigger a content access permission rebuild. This can be a potentially "
"long and disruptive process."
msgstr ""
"உள்ளடக்க அணுகல் அனுமதியை "
"மீட்டமைக்க ஒரு "
"நடவடிக்கையைத் தூக்கு. இது "
"ஒரே நேரத்தில் நீண்ட "
"மற்றும் இடையூறான செயலாக "
"இருக்கக்கூடும்."

msgid "Administer node published status"
msgstr ""
"நோடு வெளியீட்டு நிலையை "
"நிர்வகிக்கவும்"

msgid "Edit the published status of a node across all content types."
msgstr ""
"அனைத்தும் உள்ளடக்க "
"வகைகளிலும் ஒரு நோட்டின் "
"வெளியீட்டு நிலையைத் "
"திருத்தவும்."

msgid "Node storage body field"
msgstr "நோட் சேமிப்பு உடல் புலம்"

msgid "When enabled, this module adds a default node body field."
msgstr ""
"இணையமைக்கப்பட்டபோது, "
"இந்த தொகுதி ஒரு "
"இயல்புநிலை நோட் உடல் 필்ட் "
"சேர்க்கிறது."

msgid ""
"The content could not be saved. Contact the site administrator if the "
"problem persists."
msgstr ""
"உள்ளடக்கம் "
"சேமிக்கப்படவில்லை. "
"பிரச்சனை தொடர்ந்தால், தள "
"நிர்வாகியை தொடர்பு "
"கொள்ளவும்."

msgid ""
"%type saving node form: @message in %function (line %line of %file) "
"@backtrace_string."
msgstr ""
"%type சேமிக்கும் நோட் படிவம்: "
"@message %function இல் ( %file இன் %line "
"வரிசையில்) @backtrace_string."

msgid "Current node 'changed' time"
msgstr ""
"தற்போதைய நோடை 'மாற்றிய' "
"நேரம்"

msgid "Current node 'created' time"
msgstr ""
"தற்போதைய நோட் 'உருவாக்கிய' "
"நேரம்"

msgid "You must install the following module to install @module:"
msgid_plural "You must install the following modules to install @module:"
msgstr[0] ""
"நீங்கள் @module ஐ நிறுவ, "
"கீழ்காணும் தொகுதியை "
"நிறுவ வேண்டும்:  \n"
"நீங்கள் "
"@module ஐ நிறுவ, கீழ்காணும் "
"தொகுதிகளைக் நிறுவ "
"வேண்டும்:"

msgid "You must install the following theme to install @theme:"
msgid_plural "You must install the following themes to install @theme:"
msgstr[0] ""
"@theme ஐ நிறுவ நீங்கள் "
"கீழ்காணும் தீத்தை நிறுவ "
"வேண்டும்:  \n"
"@theme ஐ நிறுவ "
"நீங்கள் கீழ்காணும் "
"தீங்கள் அனைத்தையும் "
"நிறுவ வேண்டும்:"

msgid ""
"The User module could not send an email for the operation \"%op\" "
"because the user account %account does not have an email address."
msgstr ""
"User மொட்யூல் \"%op\" என்ற "
"செயலுக்கான மின்னஞ்சலை "
"அனுப்ப முடியவில்லை, "
"ஏனெனில் %account என்ற பயனர் "
"கணக்கிற்கு மின்னஞ்சல் "
"முகவரி இல்லை."

msgid "The initial record number in the set."
msgstr ""
"குழுவில் உள்ள முதல் "
"பதிவின் எண்."

msgid "The last record number in the set."
msgstr ""
"அறிகுறி தொகுதியில் உள்ள "
"கடைசி பதிவின் எண்."

msgid "The total records in the set."
msgstr ""
"அமைப்பில் மொத்த "
"பதிவுகளின் எண்ணிக்கை."

msgid "The current page number."
msgstr "தற்போதைய பக்கம் எண்."

msgid "The current page record count."
msgstr ""
"தற்போதைய பக்கம் "
"பதிவுகளின் எண்ணிக்கை."

msgid "Include tokens from the first row"
msgstr ""
"முதலை வரிசையிலிருந்து "
"டோக்கன்களை சேர்க்கவும்"

msgid ""
"Enable this to use tokens from fields in the first result row, if "
"present. Global tokens (e.g., site name) and contextual argument "
"tokens are always available."
msgstr ""
"இதை இயக்கு, முதல் முடிவு "
"வரியில் உள்ள புலங்களில் "
"இருந்தால், டோக்கன்களை "
"பயன்படுத்த. உலகளாவிய "
"டோக்கன்கள் (எ.கா., தளத்தின் "
"பெயர்) மற்றும் சூழல் "
"சார்ந்த வாத டோக்கன்கள் "
"எப்போதும் "
"கிடைக்கக்கூடியவை."

msgid "Workspace selection handler settings"
msgstr ""
"வேலைப்பகுதியில் தேர்வு "
"கைமுறை அமைப்புகள்"

msgid "The workspace provider to filter by."
msgstr ""
"வடிகட்ட பயன்படுத்த உள்ள "
"பணிப்பகுதி வழங்கியவர்."

msgid "The workspace provider."
msgstr "வொர்க்ஸ்பேஸ் வழங்குநர்."

msgid ""
"An intentionally plain theme to demonstrate and test default HTML and "
"CSS. Stark should not be used as a base theme. Instead, build a custom "
"theme using the <a "
"href=\"https://www.drupal.org/docs/develop/theming-drupal\">Theming "
"Guide</a> as a reference."
msgstr ""
"விருப்பத்தேர்வாக மிகவும் "
"எளிய தீமை, இயல்புநிலை HTML "
"மற்றும் CSS-ஐ காட்டு மற்றும் "
"சோதிக்க "
"உருவாக்கப்பட்டது. Stark-ஐ "
"அடிப்படை தீமையாக "
"பயன்படுத்தக் கூடாது. அதை "
"பதிலாக, <a "
"href=\"https://www.drupal.org/docs/develop/theming-drupal\">தீமிங் "
"கையேடு</a>-ஐ குறிப்பு olarak "
"பயன்படுத்தி தனிப்பயன் "
"தீமை உருவாக்குங்கள்."

msgid "Local files stored under a module's directory."
msgstr ""
"ஒரு மோடியூல் "
"கோப்புறையின் கீழ் "
"சேமிக்கப்பட்ட உள்ளூர் "
"கோப்புகள்."

msgid "Local files stored under a theme's directory."
msgstr ""
"ஒரு தீமின் கோப்பகத்தின் "
"உள்கட்டில் சேமிக்கப்பட்ட "
"உள்ளூர் கோப்ப файல்கள்."

msgctxt "Validation"
msgid "Sequentially validate multiple constraints"
msgstr ""
"பல கட்டுப்பாடுகளை "
"தொடர்ச்சியாக "
"சரிபார்க்கவும்"

msgid "Block content selection"
msgstr "பிளாக் உள்ளடக்கம் தேர்வு"

msgid "by @owner on @creation-datetime"
msgstr "@creation-datetime அன்று @owner என்பவரால்"

msgid "by @owner"
msgstr "படிமை @owner"

msgid "on @creation-datetime"
msgstr "on @creation-datetime"

msgid "Included %bundles"
msgstr "சேர்க்கப்பட்டது %bundles"

msgid "Single"
msgid_plural "Limited to @count"
msgstr[0] ""
"ஒற்றை  \n"
"@countக்கு "
"வரையறுக்கப்பட்டது"

msgid ""
"Updates entity links with <code>data-entity-type</code> and "
"<code>data-entity-uuid</code> attributes to point to the latest entity "
"URL aliases."
msgstr ""
"<code>data-entity-type</code> மற்றும் "
"<code>data-entity-uuid</code> பண்புகளை கொண்ட "
"நிறுவல் இணைப்புகளை புதிய "
"நிறுவல் URL "
"மாற்றிச்செய்திகளுக்குக் "
"குறிக்க புதுப்பிக்கிறது."

msgid "Media with link target selection"
msgstr ""
"இணையதள இலக்குகளைத் "
"தேர்ந்தெடுக்கும் ஊடகம்"

msgid "Administrative sidebar"
msgstr "நிர்வாக பக்கவாரி"

msgctxt "Validation"
msgid "Validate mapping as a Collection"
msgstr ""
"மாற்றுத்தளத்தை ஒரு "
"சேகரிப்பாக "
"சரிபார்க்கவும்"

msgctxt "Validation"
msgid "Mark a field as optional in a Collection constraint"
msgstr ""
"ஒரு தொகுப்பு "
"கட்டுப்பாட்டில் ஒரு "
"புலத்தைக் விருப்பமானதாக "
"குறிக்கவும்"

msgctxt "Validation"
msgid "Mark a field as required in a Collection constraint"
msgstr ""
"ஒரு தொகுப்பு "
"கட்டுப்பாட்டில் ஒரு "
"புலத்தை தேவையானதாக "
"குறியிடுங்கள்"

msgctxt "Validation"
msgid "Serialized"
msgstr "நெறிமுறை சீரமைக்கப்பட்ட"

msgid "This value should be a serialized object."
msgstr ""
"இந்த மதிப்பு "
"சீரமைக்கப்பட்ட பொருள் "
"(serialized object) ஆக இருக்க "
"வேண்டும்."

msgid "This value should be a string, \"{type}\" given."
msgstr ""
"இந்த மதிப்பு ஒரு தொடர் "
"வரியாக இருக்க வேண்டும், "
"\"{type}\" வழங்கப்பட்டது."

msgid ""
"The phpinfo() function is disabled. See <a href=\":url\" "
"target=\"_blank\">PHP documentation</a>."
msgstr ""
"phpinfo() செயல்பாடு "
"முடக்கப்பட்டுள்ளது. "
"பார்க்கவும் <a href=\":url\" "
"target=\"_blank\">PHP ஆவணங்கள்</a>."

msgid ""
"Display \"@display\" needs a selected search fields to work properly. "
"See the settings for the Entity Reference Revisions list format."
msgstr ""
"\"@display\" காட்சி சரியான "
"முறையில் செயல்பட "
"தேர்ந்தெடுக்கப்பட்ட "
"தேடல் புலங்கள் தேவை. Entity "
"Reference Revisions பட்டியல் "
"வடிவமைப்பின் அமைப்புகளை "
"பார்க்கவும்."

msgid ""
"Display \"@display\" uses field %field as search field, but the field "
"is no longer present. See the settings for the Entity Reference "
"Revisions list format."
msgstr ""
"\"display \"@display\" %field என்ற புலத்தை "
"தேடல் புலமாக "
"பயன்படுத்துகிறது, ஆனால் "
"அந்த புலம் இனிமேல் இல்லை. "
"Entity Reference Revisions பட்டியல் "
"வடிவத்தின் அமைப்புகளைப் "
"பார்த்து சரிபார்க்கவும்."

msgid "Entity Reference Revisions Source"
msgstr ""
"அமைப்பு குறிப்பு "
"திருத்தங்கள் மூலம்"

msgid ""
"Allow to access to the Entity Reference Revisions orphan deletion "
"form."
msgstr ""
"Entity Reference Revisions ஒற்றை நீக்கம் "
"படிவத்திற்கு அணுக அனுமதி "
"அளிக்கவும்."

msgid ""
"Checked @entity_type revisions for orphans: @current of @total in "
"@interval (@deletions deleted)"
msgstr ""
"@entity_type திருத்தங்களுக்கும் "
"பராமரிக்கப்பட்டன "
"எர்பன்களுக்கு: @interval இல் @total "
"இல் இருந்து @current (@deletions "
"நீக்கப்பட்டது)"

msgid ""
"Delete orphaned composite entities revisions that are no longer "
"referenced. If there are no revisions left, the entity will be deleted "
"as long as it is not used."
msgstr ""
"டெல்லி செய்யப்பட்ட "
"தனியாகவே இருந்த கம்பிர "
"அலகுகளின் திருத்தங்களை "
"நீக்கவும், அவை இனிவரும் "
"மேற்கோள்கள் இல்லாதவையாக "
"இருக்கும். எதுவும் "
"திருத்தங்கள் "
"இல்லையெனில், அலகு "
"பயன்படுத்தப்படாமல் "
"இருந்தால் அது "
"நீக்கப்படும்."

msgid "Select the entity types to check for orphans"
msgstr ""
"அனாதை காண கீழ்க்காணும் "
"என்டிடி வகைகளை "
"தேர்ந்தெடுக்கவும்"

msgid "Entity Reference Revisions Orphan Purger"
msgstr ""
"என்டிட்டி ரெபரன்ஸ் "
"ரிவிஷன்ஸ் ஆர்கண் பர்ஜர்"

msgid "Other (revisions)"
msgstr "மற்றவை (திருத்தங்கள்)"

msgid "Display the label of the referenced entity revisions."
msgstr ""
"குறிப்பிட்ட "
"நிலையிடப்பட்ட அலகு "
"திருத்தங்களின் லேபிளை "
"காட்சியிடுக."

msgid "@entity_type (revisions)"
msgstr "@entity_type (திருத்தங்கள்)"

msgid ""
"If you want to use the Field Group accordion formatter, you will need "
"to install the <a href=\":link\" target=\"_blank\">jQuery UI "
"Accordion</a> module."
msgstr ""
"Field Group ஆகார்டியன் "
"ஃபார்மாட்டரை பயன்படுத்த "
"விரும்பினால், <a href=\":link\" "
"target=\"_blank\">jQuery UI Accordion</a> மாட்யூலை "
"நிறுவ வேண்டியிருக்கும்."

msgid ""
"Fieldgroup will, as the name implies, group fields together. All "
"fieldable entities will have the possibility to add groups to wrap "
"their fields together. Fieldgroup comes with default HTML wrappers "
"like vertical tabs, horizontal tabs, fieldsets or div wrappers."
msgstr ""
"Fieldgroup என்பது பெயர் போலவே "
"புலங்களை ஒன்றாக "
"சேர்க்கும். அனைத்து "
"புலங்கள் கொண்ட "
"குடும்பங்களும் தங்களுடைய "
"புலங்களை ஒன்றாக "
"விழுங்கக் குழுக்களை "
"சேர்க்கும் வாய்ப்பு "
"கொண்டிருக்கும். Fieldgroup, "
"கிளையில் கிடைக்கும் "
"இயல்புநிலை HTML பாக்கிகள் "
"போன்ற உயர் முனையில் அட்டை, "
"பாத்திர அட்டை, புல செட் "
"அல்லது div பாக்கிகள் "
"போன்றவை கொண்டுள்ளது."

msgid ""
"The field group project is a follow-up on the field group module in <a "
"href=\"@link-cck\">CCK</a>. The release will only exist for Drupal 7 "
"release and higher, so since the existence of the Fields API in "
"core.</br>By moving field group to a separate module, this may open "
"some new perspectives."
msgstr ""
"field group திட்டம் <a href=\"@link-cck\">CCK</a> "
"இல் உள்ள field group மூடியின் "
"தொடர்ச்சியாகும். இது Drupal 7 "
"மற்றும் அதற்கு மேலான "
"பதிப்புகளுக்கு மட்டுமே "
"கிடைக்கும், ஏனெனில் Fields API "
"இன் அத்தாட்சிகள் "
"முக்கியமாக உள்ளது.</br>field group ஐ "
"தனித்த module ஆக "
"நகர்த்துவதனால், சில புதிய "
"பார்வைகள் உருவாக்கப்பட "
"வாய்ப்பு உள்ளது."

msgid ""
"For more information about this module feel free to visit the <a "
"href=\"@link\">module page</a>."
msgstr ""
"மேலும் இந்த மட்யூல் "
"தொடர்பான தகவலுக்கு <a "
"href=\"@link\">மட்யூல் பக்கம்</a> "
"பார்வையிட தயங்க வேண்டாம்."

msgid "Output the label as html"
msgstr "லேபலை html ஆக வெளியிடவும்"

msgid "jQuery UI Accordion is deprecated"
msgstr ""
"jQuery UI Accordion இனி "
"பயன்படுத்தப்படுவது "
"நிறுத்தப்பட்டுள்ளது"

msgid "This module is deprecated, as the Jquery UI library is EOL."
msgstr ""
"இந்த மொடயம் காலாவதியானது, "
"ஏனெனில் Jquery UI நூலகம் EOL "
"ஆகிவிட்டது."

msgid "Field Group: Accordion formatter (Deprecated)"
msgstr ""
"புலம் குழு: அக்கார்டியன் "
"வடிவமைப்பான் "
"(பயன்பாட்டில் இருந்து "
"நீக்கப்பட்டது)"

msgid ""
"Provides the option to render groups as accordion. This module is "
"deprecated as Jquery UI is EOL."
msgstr ""
"இது குழுக்களை "
"அக்கார்டியன் போல "
"காட்டும் விருப்பத்தை "
"வழங்குகிறது. Jquery UI "
"முடிவடைந்ததால் இந்த "
"மொடியூல் பழையதாகும்."

msgid "Accordion (Deprecated)"
msgstr "Accordion (பழுது புறப்பட்ட)"

msgid "Accordion Item (Deprecated)"
msgstr ""
"அகார்டியன் உருப்படி "
"(பழையதாகிவிட்டது)"

msgid "Allow HTML in label"
msgstr "லேபலில் HTML அனுமதிக்கவும்"

msgid "Allow HTML in label: @label_as_html"
msgstr "லேபலில் HTML அனுமதி: @label_as_html"

msgid "Extra CSS classes: @classes"
msgstr "கூடுதல் CSS வகுப்புகள்: @classes"

msgid ""
"Allows using (XSS-filtered) HTML in the label (e.g. icons). Note, that "
"some elements might not have labels by default, but that can differ "
"per theme."
msgstr ""
"லேபிலில் (எ.கா. ஐகான்கள்) "
"(XSS-ஃபில்டரிடப்பட்ட) HTML "
"பயன்படுத்த "
"அனுமதிக்கிறது. "
"கவனிக்கவும், சில "
"கூறுகளில் இயல்பாக "
"லேபில்கள் இருக்காது, "
"ஆனால் அது ஒவ்வொரு "
"தாளுக்கும் "
"வேறுபடக்கூடும்."

msgid "Preset accent color"
msgstr ""
"முன்பிரிக்கப்பட்ட "
"சிறப்பு நிறம்"

msgid "Preset focus color"
msgstr "முன்கூட்டிய கவனம் நிறம்"

msgid "Focus color"
msgstr "மைய நிறம்"

msgid "View @bundle"
msgstr "@bundle ஐ பார்வையிடுக"

msgid "The darkmode"
msgstr "இருண்டமை"

msgid "Display help icon to toggle form description"
msgstr ""
"வழிகாட்டு உதவி ஐகானை "
"காட்டவும், படிவ "
"விளக்கத்தை மாற்றுவதற்கு"

msgid ""
"This setting is overridden by the <a href=\":editUrl\">current "
"user</a>. @title: %value"
msgstr ""
"இந்த அமைப்பை <a "
"href=\":editUrl\">தற்போதைய பயனர்</a> "
"மாற்றியிருக்கிறார். @title: %value"

msgid "Secondary toolbar in Frontend"
msgstr ""
"முன்னணி பகுதியில் "
"இரண்டாவது கருவிப்பட்டை"

msgid "Navigation (Drupal Toolbar)"
msgstr ""
"நெவிகேஷன் (Drupal "
"கருவிப்பட்டை)"

msgid "Show Secondary Toolbar in Frontend"
msgstr ""
"முன் சேவையகத்தில் "
"இரண்டாம் கருவித்தட்டு "
"காண்பி"

msgid "Show the secondary toolbar in the Frontend (when logged in to Drupal)."
msgstr ""
"Frontend இல் (Drupal இல் "
"உள்நுழைந்தபோது) இரண்டாம் "
"நிலை கருவிகளைத் "
"தொடர்ந்து காட்டு."

msgid "Enable form description toggle"
msgstr ""
"படிவ விளக்கம் மாறும் "
"விருப்பத்தை இயக்கு"

msgid ""
"@title <span class=\"page-title__language\">(@language "
"translation)</span>"
msgstr ""
"@title <span class=\"page-title__language\">(@language "
"மொழிபெயர்ப்பு)</span>"

msgid "Layout density"
msgstr "வடிவமைப்பு அடர்த்தி"

msgid "Hide sidebar panel"
msgstr ""
"பக்கவலது பட்டியலை "
"மறைத்தல்"

msgid "Show sidebar panel"
msgstr "பக்கவிளக்கு குழியை காண்க"

msgid "Close sidebar panel"
msgstr ""
"பக்கவாசல் போர்ட்டை "
"மூடவும்"

msgid "Changes the layout density for tables in the admin interface."
msgstr ""
"இயலிப்புரை முகப்பில் "
"அட்டவணைகளின் அமைப்பு "
"அடர்த்தியை மாற்றுகிறது."

msgid "Custom Focus color"
msgstr "தனிப்பயன் கவனம் நிறம்"

msgid "Increase contrast"
msgstr ""
"தொண்டர்மையை "
"அதிகரிக்கவும்"

msgid "Create Navigation"
msgstr "நேவிகேஷன் உருவாக்குக"

msgid "Content Navigation"
msgstr "உள்ளடக்க பயணமாற்றம்"

msgid "New Drupal Navigation, Test integration"
msgstr ""
"புதிய Drupal நெவிகேஷன், சோதனை "
"ஒருங்கிணைப்பு"

msgid "Top Menus"
msgstr "முக்கிய மெனுக்கள்"

msgid "Sticky action buttons"
msgstr ""
"அடிக்கடி பயன்படும் செயல் "
"பொத்தான்கள்"

msgid ""
"This setting is currently deactivated as it is overwritten by the "
"navigation module."
msgstr ""
"இந்த அமைப்பு தற்போது "
"செயலிழக்கவிடப்பட்டுள்ளது, "
"ஏனெனில் இது நெவிகேஷன் "
"மொடியூல் மூலம் "
"மீட்கப்பட்டது."

msgid "Enable sticky action buttons"
msgstr ""
"பிடிவட்டு செயல்பாட்டு "
"பொத்தான்களை இயக்கு"

msgid "Displays all actions of the form in the sticky header."
msgstr ""
"படிவத்தின் அனைத்து "
"நடவடிக்கைகளையும் "
"ஒட்டிச்சட்டத் தலைப்பில் "
"வெளிப்படுத்துகிறது."

msgid "Delete @bundle"
msgstr "@bundle ஐ நீக்கு"

msgid "Edit @bundle"
msgstr "@bundle தொகுப்பை திருத்துக்"

msgid "Reset @bundle"
msgstr "@bundle ஐ மீட்டமைக்கவும்"

msgid "Cancel @bundle"
msgstr "@bundle ஐ ரத்து செய்"

msgid "Clone @bundle"
msgstr "@bundle ஐ நகலெடு"

msgid ""
"Admin theme with a strong focus on improving the Editorial Experience. "
"Learn more about Gin’s <a "
"href=\"https://www.drupal.org/docs/contributed-themes/gin-admin-theme/specific-settings-within-gin\" "
"target=\"_blank\">Settings</a> and how to customize Gin in our <a "
"href=\"https://www.drupal.org/docs/contributed-themes/gin-admin-theme/custom-theming\" "
"target=\"_blank\">Custom theming guide</a>."
msgstr ""
"மூல நிரலாசிரியர் "
"அனுபவத்தை மேம்படுத்தும் "
"வலுவான கவனம் கொண்ட "
"நிர்வாக தீம்.  Gin இன் <a "
"href=\"https://www.drupal.org/docs/contributed-themes/gin-admin-theme/specific-settings-within-gin\" "
"target=\"_blank\">அமைப்புகள்</a> "
"மற்றும் Gin ஐ எப்படி "
"தனிப்பயனாக்குவது என்பதை "
"எங்கள் <a "
"href=\"https://www.drupal.org/docs/contributed-themes/gin-admin-theme/custom-theming\" "
"target=\"_blank\">தனிப்பயன் தீமிங் "
"வழிகாட்டி</a> மூலம் "
"அறியுங்கள்."

msgid "Slide effect"
msgstr "ஸ்லைடு பாதிப்பு"

msgid "Reset on end"
msgstr "முடிவில் மீட்டமைக்கவும்"

msgid "Reset the playback to the start once playback is complete."
msgstr ""
"பிளேபேக் முடிந்தவுடன் "
"அதை துவக்கத்தில் "
"மீட்டமைக்கவும்."

msgid "Plyr settings"
msgstr "Plyr அமைப்புகள்"

msgid "Gallery (video grouping)"
msgstr "கேலரி (வீடியோ குழுமம்)"

msgid "Text that launches a modal window."
msgstr ""
"மோடல் ஜன்னலைத் திறக்கும் "
"உரை."

msgid "Link text: @link_text."
msgstr "இணைப்பு உரை: @link_text."

msgid "Thumbnail image style: @image_style."
msgstr "சிறு படக்காட்சி வகை: @image_style."

msgid ""
"For more information about the deprecation of jQuery UI, see this <a "
"href=\":change-record\">change record</a>"
msgstr ""
"jQuery UI பயன்பாட்டின் "
"பாவனையிழப்பை பற்றி "
"மேலும் தகவலுக்கு, இந்த <a "
"href=\":change-record\">மாற்றத்தைப் "
"பதிவேட்டு</a> காணவும்."

msgid ""
"Drupal 8 includes jQuery UI in core, however it is no longer actively "
"maintained and has been marked deprecated. This module provides the "
"jQuery UI asset library for any themes and modules that require it."
msgstr ""
"Drupal 8 உடன் jQuery UI கோர் "
"பகுதியில் "
"சேர்க்கப்பட்டுள்ளது, அதே "
"சமயம் இது இனி முறையாக "
"பராமரிக்கப்படாமல், "
"பழுதடைந்ததாக "
"குறிக்கப்பட்டுள்ளது. "
"இந்த மொட்யூல் இதனை "
"தேவையான எந்த திம்கள் "
"மற்றும் மொட்யூல்கள் "
"பயன்படுத்த முடியுமாறு jQuery "
"UI சொத்துக்களின் நூலகத்தை "
"வழங்குகிறது."

msgid ""
"Visit the <a href=\":project_link\">jQuery UI project page</a> on "
"Drupal.org for more information about this module."
msgstr ""
"மேலும் தகவலுக்கு இந்த "
"மொட்யூல் குறித்து <a "
"href=\":project_link\">Drupal.org இல் உள்ள jQuery UI "
"திட்டப் பக்கத்திற்கு</a> "
"செல்லவும்."

msgid "Provides jQuery UI library."
msgstr "jQuery UI நூலகத்தை வழங்குகிறது."

msgid "Drag"
msgstr "டிராக்"

msgid "Layout Options"
msgstr "கட்டமைப்பு விருப்பங்கள்"

msgid "Create new @type"
msgstr "புதிய @type உருவாக்கு"

msgid "Empty Message"
msgstr "காலியான செய்தி"

msgid "Choose component"
msgstr ""
"கட்பொறியை "
"தேர்ந்தெடுக்கவும்"

msgid "Layout builder for paragraphs."
msgstr ""
"வரிகளுக்கான லேஔட்டுப் "
"பிற்படுத்தி."

msgid ""
"Allow access to the 'Layout plugin configuration' form when "
"creating/editing a Layout"
msgstr ""
"Layout "
"உருவாக்கும்/திருத்தும் "
"போது 'Layout plugin configuration' "
"படிவத்திற்கு அணுகலை "
"அனுமதிக்கவும்"

msgid "Modal autoresize"
msgstr ""
"மோடல் தானாக அளவை "
"மாற்றுதல்"

msgid "Modal Settings"
msgstr "மோடல் அமைப்புகள்"

msgid "Show Paragraph Labels"
msgstr "பத்தி லேபிள்களை காட்டுக"

msgid "Preview view mode"
msgstr ""
"முன் பார்வை காட்டு "
"முறையில்"

msgid "Show Layout Labels"
msgstr ""
"மொழிபெயர் விளக்கக் "
"குறியீடுகளை காட்டவும்"

msgid "Provide layout integration for paragraph fields."
msgstr ""
"பத்திக்குச் "
"செல்லுபடியாகும் "
"புலங்களுக்கு அமைப்பை "
"ஒருங்கிணைக்கவும்."

msgid "Layout Paragraphs"
msgstr "அமைப்பு பிரவாகம்"

msgid "Field widget and formatter for using layouts with paragraph fields."
msgstr ""
"பத்தி புலங்களுடன் "
"அமைப்புகளை "
"பயன்படுத்துவதற்கான புல "
"விருதகம் மற்றும் "
"வடிவமைப்பாளர்."

msgid "Layout Paragraphs settings"
msgstr ""
"படிவமைப்பு பத்திகள் "
"அமைப்புகள்"

msgid "Edit Layout Paragraphs Plugin Config"
msgstr ""
"விண்ணப்ப அமைப்பு பகுதி "
"தொகுப்பமைப்பைத் "
"திருத்தவும்"

msgid "Layout Paragraphs general settings"
msgstr ""
"அமைப்பு பத்தியொன்றுகளின் "
"பொதுவான அமைப்புகள்"

msgid "The Layout Paragraphs settings have been saved."
msgstr ""
"Layout Paragraphs அமைப்புகள் "
"சேமிக்கப்பட்டுள்ளன."

msgid "Renders paragraphs with layout."
msgstr ""
"வடிவமைப்புடன் பத்திகள் "
"காட்டப்படுகின்றன."

msgid "Maximum nesting depth"
msgstr "அதிகபட்ச உள்ளடக்க ஆழம்"

msgid "Choosing 0 will prevent nesting layouts within other layouts."
msgstr ""
"0 ஐ தேர்ந்தெடுப்பது ஒரே "
"அமைப்புக்குள் மற்ற "
"அமைப்புகளை இணைப்பதை "
"தடுக்கும்."

msgid "Require paragraphs to be added inside a layout"
msgstr ""
"ஒரு அடுக்கமைப்புக்குள் "
"பராகிராப்களைச் சேர்க்க "
"வேண்டும்"

msgid "Maximum nesting depth: @max_depth"
msgstr ""
"அதிகபட்ச நெஸ்டிங் ஆழம்: "
"@max_depth"

msgid "Paragraphs <b>must be</b> added within layouts."
msgstr ""
"புள்ளிகள் <b>கட்டாயமாக</b> "
"வடிவமைப்புகளின் உள்ளே "
"சேர்க்கப்பட வேண்டும்."

msgid "Layouts are optional."
msgstr ""
"அமைப்புகள் "
"விருப்பமானவையாகும்."

msgid "Available Layouts"
msgstr "இயல்பில் உள்ள கட்டளைகள்"

msgid "You must select at least one layout."
msgstr ""
"நீங்கள் குறைந்தது ஒரு "
"கட்டமைப்பைத் "
"தேர்ந்தெடுக்க வேண்டும்."

msgid "Integrates paragraphs with layout discovery and layout API."
msgstr ""
"பகுதிகளை அமைப்புக் கண்டு "
"பிடிப்பு மற்றும் "
"அமைப்புக்கான API உடன் "
"இணைக்கிறது."

msgid "Configure site-wide settings for Layout Paragraphs field widgets."
msgstr ""
"Layout Paragraphs புலம் விச்சடுகளைத் "
"தளம் முழுவதும் "
"அமைக்கவும்."

msgid "Layout Sections"
msgstr "அமைப்பு பிரிவுகள்"

msgid "Layout Paragraphs Labels"
msgstr "லேஔட் பத்திகள் லேபிள்கள்"

msgid "Layout Paragraphs Sections"
msgstr "பாடம் பத்திகள் பிரிவுகள்"

msgid "Choose at least one paragraph type to use as a Layout Section."
msgstr ""
"Layout Section ஆக பயன்படுத்த "
"குறைந்தது ஒரு பத்திப் "
"பிரிவு வகையைத் "
"தேர்ந்தெடுக்கவும்."

msgid "Use as a Layout Section"
msgstr ""
"ஒரு அமைப்பு பகுதியை போல "
"பயன்படுத்தவும்"

msgid "Available Layouts for @label Paragraphs"
msgstr ""
"@label பதிவுகளுக்கான "
"கிடைக்கும் அலங்கார "
"வடிவங்கள்"

msgid "Layout Paragraphs format settings"
msgstr ""
"அமைப்பு பத்திகள் "
"வடிவமைப்பு அமைப்புகள்"

msgid "Layout Paragraphs display format settings"
msgstr ""
"அமைப்பு பத்திகள் "
"காட்சிப்படுத்தும் "
"வடிவமைப்பு அமைப்புகள்"

msgid "Layout Paragraphs Section settings"
msgstr ""
"மேடைகளின் பத்திகள் "
"பிரிவு அமைப்புகள்"

msgid "Move items from \"@region\" to"
msgstr ""
"\"@region\" இல் இருந்து "
"உருப்படிகளை நகர்த்தவும்"

msgid "Move Orphaned Items"
msgstr ""
"ஒரே வாழ் பொருட்களை "
"நகர்த்து"

msgid "Choose where to move items for missing regions."
msgstr ""
"இறந்த பகுதிகளுக்கான "
"பொருட்களை எங்கே நகர்த்த "
"வேண்டுமானால் "
"தேர்ந்தெடுக்கவும்."

msgid ""
"You are in translation mode. You cannot add or remove items while "
"translating. Reordering items will affect all languages."
msgstr ""
"நீங்கள் மொழிபெயர்ப்பு "
"முறையில் உள்ளீர்கள். "
"மொழிபெயர்க்கும் போது "
"பொருட்களை சேர்க்கவும் "
"அகற்றவும் முடியாது. "
"பொருட்களை மறுவமைத்தல் "
