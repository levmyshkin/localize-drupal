msgstr ""
"Эгер бул маани алынса, фильтр этибарга "
"алынбайт; башкача айтканда, «бардык "
"маанилер»"

msgid "When the filter value <em>IS</em> in the URL or a default is provided"
msgstr ""
"URLдагы <em>СЕ</em> фильтр мааниси же "
"демейки маани берилгенде"

