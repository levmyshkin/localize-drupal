msgstr "%workflow workflow'ида %state деген маани жок"

msgctxt "Validation"
msgid "Datetime format valid for datetime type."
msgstr "Дата жана убакыт үчүн формат жарактуу."

msgid "The field type."
msgstr "Өріс түрү."

