msgstr ""
"Креирана е датотека за JavaScript превод за "
"јазикот %language."

msgid ""
"An error occurred during creation of the JavaScript translation file "
"for the language %language."
msgstr ""
"Се појави грешка при креирањето на "
"датотеката за JavaScript превод за јазикот "
"%language."

msgid "Standard PHP"
msgstr "Стандарден PHP"

msgid "PHP Mbstring Extension"
msgstr "PHP екстензија mbstring"

msgid "Unicode library"
msgstr "Unicode библиотека"

msgid ""
"The block %info was assigned to the invalid region %region and has "
