msgid "GD2 image manipulation toolkit"
msgstr "GD2 алатка за манипулација со слики"

msgid ""
"Define the image quality for JPEG manipulations. Ranges from 0 to 100. "
"Higher values mean better image quality but bigger files."
msgstr ""
"Дефинирајте го квалитетот на сликата "
"за манипулации со JPEG. Опсегот е од 0 до "
"100. Поголемите вредности значат "
"подобар квалитет на сликата, но и "
"поголеми датотеки."

msgid "Right to left"
msgstr "Право кон лево"

msgid "Left to right"
msgstr "Лево кон десно"

