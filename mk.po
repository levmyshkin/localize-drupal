"Drush was unable to download the colorbox library from @remote. "
"@exception"
msgstr ""
"Drush не успеа да ја преземе "
"библиотеката colorbox од @remote. @exception"

msgid "Error: unable to unzip colorbox file."
msgstr ""
"Грешка: не успеав да го отпакувам "
"пакетот Colorbox."

msgid "The colorbox library has been successfully downloaded to @path."
msgstr ""
"Библиотеката colorbox е успешно преземена "
"во @path."

