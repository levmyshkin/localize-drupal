msgstr ""
"Следниот број на поднесување е "
"оневозможен"

msgid "is filled"
msgstr "се пополнува"

msgid "is checked"
msgstr "е означено"

msgid "is between"
msgstr "е помеѓу"

msgid "is not between"
msgstr "не е меѓу"

