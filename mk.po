"страницата без протоколот."

msgid "Short format"
msgstr "Краток формат"

msgid "Medium format"
msgstr "Среден формат"

msgid "Long format"
msgstr "Долг формат"

msgid "Time-since"
msgstr "Време-помеѓу"

