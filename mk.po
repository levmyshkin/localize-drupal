"корисникот за прикажување "
"администраторски страници."

msgid "The name of this user."
msgstr "Името на овој корисник."

msgid "The password of this user (hashed)."
msgstr "Лозинката на овој корисник (хаширана)."

msgid "The email of this user."
msgstr "Е-поштата на овој корисник."

msgid "The timezone of this user."
msgstr "Временската зона на овој корисник."

