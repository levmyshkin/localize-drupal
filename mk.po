msgstr ""
"Поврзете јазли со поимите од "
"таксономијата, наведувајќи која(и) "
"речник(ци) да се користат. Оваа врска "
"ќе предизвика дупликат записи доколку "
"има повеќе термини."

msgid "Taxonomy term ID"
msgstr "ID на таксономски термин"

msgid "Taxonomy term name"
msgstr "Име на таксономски термин"

