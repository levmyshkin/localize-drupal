"Elements contain a duplicate element key %name found on line "
"@line_numbers."
msgid_plural ""
"Elements contain a duplicate element key %name found on lines "
"@line_numbers."
msgstr[0] ""
"Елементите содржат дупликат клуч на "
"елементот %name што е пронајден на редот "
"@line_numbers.  \n"
"Елементите содржат "
"дупликат клуч на елементот %name што е "
"пронајден на линиите @line_numbers."

msgid "Generate %title submissions"
msgstr "Генерирајте записи за %title"

