msgstr ""
"Дали Colorbox треба да се прикаже во "
"фиксирана позиција во видливиот дел "
"од прозорецот на посетителот или во "
"однос на документот."

msgid "Mobile detection"
msgstr "Мобилна детекција"

msgid "Content image style of first image: @style"
msgstr "Слика од стилот на првата слика: @style"

msgid "Node style first"
msgstr "Прво стил на јазол"

msgid "Colorbox is already present at @path. No download required."
msgstr ""
"Colorbox е веќе присутен на @path. Не е "
"потребно преземање."

