msgstr "<sub>Пот</sub>скриптирано"

msgid "<abbr title=\"Abbreviation\">Abbrev.</abbr>"
msgstr "<abbr title=\"Кратенка\">Крат.</abbr>"

msgid "<acronym title=\"Three-Letter Acronym\">TLA</acronym>"
msgstr ""
"<acronym title=\"Три-словорозна "
"кратенка\">TLA</acronym>"

msgid "Block quoted"
msgstr "Цитирана блок-вредност"

msgid "Quoted inline"
msgstr "„Цитирано вметнато“"

