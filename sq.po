msgid "Webform Cards"
msgstr "Kartat e Webform-it"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"Siguron një element kontenier “Card” për paginim të shpejtë "
"në anën e klientit për formularë shumëhapestësh."

msgid "Convert wizard pages to cards"
msgstr "Shndërro faqet e magjistarit në karta"

msgid "Convert @title wizard pages to cards"
msgstr "Konverto faqet e magjistarit @title në karta"

msgid ""
"Please make sure to test the converted webform on a staging server "
"before using cards in production."
msgstr ""
"Ju lutemi sigurohuni që ta testoni formularin web të konvertuar në "
"një server testues (staging) përpara se të përdorni kartat në "
"prodhim."

