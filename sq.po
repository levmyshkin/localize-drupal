msgstr "Lloj hartimi i imazheve me përgjegjshmëri (responsive)"

msgid "Sizes attribute"
msgstr "Atributi i madhësisë"

msgid "Image styles to be used when using the 'sizes' attribute"
msgstr ""
"Stilet e imazhit që do të përdoren kur përdoret atributi "
"„sizes“"

msgid "<em>Duplicate responsive image style</em> @label"
msgstr "<em>Kopjo stilin e imazhit responsive</em> @label"

