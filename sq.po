msgstr ""
"Ju lutemi, sigurohuni që të bëni një kopje rezervë të faqes suaj "
"të internetit përpara se të përditësoni modulin Webform."

msgid "Edit webform Twig templates"
msgstr "Ndrysho shabllonet Twig të webform-it"

msgid "Add @label element"
msgstr "Shto elementin @label"

msgid "Enter a <a href=\":href\">regular expression</a>"
