msgstr ""
"Tekst për t’u përdorur për formën njëjës, @count do të "
"zëvendësohet me vlerën."

msgid "Contains US ASCII characters only"
msgstr "Përmban vetëm karaktere ASCII të SHBA-së."

msgid "Checkout complete! Thank you for your purchase."
msgstr "Blerja u përfundua! Faleminderit për blerjen."

msgid "Resolving missing content"
msgstr "Zgjidhja e përmbajtjes që mungon"

