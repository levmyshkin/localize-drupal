msgstr "çdo @increment minuta"

msgid "every @increment hours"
msgstr "çdo @increment orë"

msgid "every @increment days"
msgstr "çdo @increment ditë"

msgid "every @increment weeks"
msgstr "çdo @increment javë"

msgid "every year"
msgstr "çdo vit"

