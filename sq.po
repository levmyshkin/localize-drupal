msgid "The status of the file, temporary (FALSE) and permanent (TRUE)."
msgstr "Statusi i skedarit: i përkohshëm (FALSE) dhe i përhershëm (TRUE)."

msgid "Web page addresses and email addresses turn into links automatically."
msgstr ""
"Adresat e faqeve të internetit dhe adresat e emailit kthehen "
"automatikisht në lidhje."

msgid "Background color must be a hexadecimal color value."
msgstr ""
"Ngjyra e sfondit duhet të jetë një vlerë ngjyre në format "
