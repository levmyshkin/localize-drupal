msgstr "UUID-ja e lidhjes së menysë së përmbajtjes."

msgid "The content menu link bundle."
msgstr "Lidhja e grupit të menysë së përmbajtjes."

msgid ""
"The menu name. All links with the same menu name (such as \"tools\") "
"are part of the same menu."
msgstr ""
"Emri i menysë. Të gjitha lidhjet me të njëjtin emër menuje (si "
"p.sh. “tools”) i përkasin të njëjtës meny."

msgid "Parent plugin ID"
msgstr "ID e plugin-it prind"

msgid ""
"The ID of the parent menu link plugin, or empty string when at the top "
"level of the hierarchy."
msgstr ""
"ID-ja e plugin-it të lidhjes së menysë prind, ose një varg i "
"zbrazët kur është në nivelin më të lartë të hierarkisë."

