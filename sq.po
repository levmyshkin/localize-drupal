msgid ""
"<strong>ATTENTION DEVELOPERS!!!</strong> The webform submission form's "
" BASE_FORM_ID and FORM_ID have changed."
msgstr ""
"<strong>VËMENDJE ZHVILLUES!!!</strong> Formulari i aplikimit "
"(webform) ka ndryshuar **BASE_FORM_ID** dhe **FORM_ID**."

msgid ""
"Please make sure to update all webform related "
"<code>hook_form_BASE_FORM_ID_alter()</code> and "
"<code>hook_form_FORM_ID_alter()</code> hooks."
msgstr ""
"Ju lutemi sigurohuni që të përditësoni të gjitha hook-et "
"<code>hook_form_BASE_FORM_ID_alter()</code> dhe "
"<code>hook_form_FORM_ID_alter()</code> që lidhen me webform."

