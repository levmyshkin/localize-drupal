msgstr "Nuk jemi në gjendje ta përfundojmë kërkesën aktuale."

msgid "Do you want to reload the current page?"
msgstr "Dëshiron të rifreskosh faqen aktuale?"

msgid "Provides a more slideout element."
msgstr "Ofron një element më “të rrëshqitshëm”."

msgid "Custom error response redirect URL"
msgstr "URL e ridrejtimit për përgjigje me gabim të personalizuar"

