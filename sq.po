msgstr "Fusha %field_name duhet të instalohet."

msgid "The %field_name field needs to be updated."
msgstr "Fusha %field_name duhet të përditësohet."

msgid "The %field_name field needs to be uninstalled."
msgstr "Fusha %field_name duhet të çinstalohet."

