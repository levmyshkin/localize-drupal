msgid ""
"\n"
"        <p>You can align images, videos, blockquotes and so on to "
"the left, right or center. Examples:</p>\n"
"        <ul>\n"
"          "
"<li>Align an image to the left: <code>&lt;img src=\"\" "
"data-align=\"left\" /&gt;</code></li>\n"
"          <li>Align an image "
"to the center: <code>&lt;img src=\"\" data-align=\"center\" "
"/&gt;</code></li>\n"
"          <li>Align an image to the right: "
"<code>&lt;img src=\"\" data-align=\"right\" /&gt;</code></li>\n"
"       "
"   <li>… and you can apply this to other elements as well: "
"<code>&lt;video src=\"\" data-align=\"center\" /&gt;</code></li>\n"
"    "
"    </ul>"
msgstr ""
"<p>Mund t’i rreshtoni imazhet, videot, citatet bllok (blockquotes) "
"dhe të tjera majtas, djathtas ose në qendër. Shembuj:</p>\n"
"        "
"<ul>\n"
"          <li>Rreshtoni një imazh majtas: <code>&lt;img "
"src=\"\" data-align=\"left\" /&gt;</code></li>\n"
"          "
"<li>Rreshtoni një imazh në qendër: <code>&lt;img src=\"\" "
"data-align=\"center\" /&gt;</code></li>\n"
"          <li>Rreshtoni një "
"imazh djathtas: <code>&lt;img src=\"\" data-align=\"right\" "
"/&gt;</code></li>\n"
"          <li>… dhe këtë mund ta zbatoni edhe "
"te elementë të tjerë: <code>&lt;video src=\"\" "
"data-align=\"center\" /&gt;</code></li>\n"
"        </ul>"

msgid "Align images"
msgstr "Rreshto imazhet"

msgid ""
"Uses a <code>data-align</code> attribute on <code>&lt;img&gt;</code> "
"tags to align images."
msgstr ""
"Përdor një atribut <code>data-align</code> në etiketat "
"<code>&lt;img&gt;</code> për të rreshtuar imazhet."

msgid ""
"\n"
"        <p>You can caption images, videos, blockquotes, and so on. "
"Examples:</p>\n"
"        <ul>\n"
"            <li><code>&lt;img src=\"\" "
"data-caption=\"This is a caption\" /&gt;</code></li>\n"
"            "
"<li><code>&lt;video src=\"\" data-caption=\"The Drupal Dance\" "
"/&gt;</code></li>\n"
"            <li><code>&lt;blockquote "
"data-caption=\"Dries Buytaert\"&gt;Drupal is "
"awesome!&lt;/blockquote&gt;</code></li>\n"
"            "
"<li><code>&lt;code data-caption=\"Hello world in "
"JavaScript.\"&gt;alert(\"Hello world!\");&lt;/code&gt;</code></li>\n"
"  "
"      </ul>"
msgstr ""
"<p>Mund të vendosni titra (caption) për imazhe, video, citate blloku "
"dhe të tjera. Shembuj:</p>\n"
"<ul>\n"
"    <li><code>&lt;img src=\"\" "
"data-caption=\"Ky është një titër\" /&gt;</code></li>\n"
"    "
"<li><code>&lt;video src=\"\" data-caption=\"Kërcimi i Drupal-it\" "
"/&gt;</code></li>\n"
"    <li><code>&lt;blockquote data-caption=\"Dries "
"Buytaert\"&gt;Drupal është i "
"mrekullueshëm!&lt;/blockquote&gt;</code></li>\n"
"    "
"<li><code>&lt;code data-caption=\"Përshëndetje, botë në "
"JavaScript.\"&gt;alert(\"Përshëndetje, "
"botë!\");&lt;/code&gt;</code></li>\n"
"</ul>"

msgid "Caption images"
msgstr "Titrat e imazheve"

msgid ""
"Uses a <code>data-caption</code> attribute on <code>&lt;img&gt;</code> "
"tags to caption images."
msgstr ""
"Përdor një atribut <code>data-caption</code> te etiketat "
"<code>&lt;img&gt;</code> për të vendosur titrat e figurave."

