msgstr ""
"Drejtoria aktive nuk është e mbrojtur nga PHP-TUF, e cila kërkohet "
"për përdorimin e sigurt të Menaxherit të Paketave."

msgid "The <code>@plugin</code> plugin is not installed."
msgstr "Shtojca <code>@plugin</code> nuk është e instaluar."

msgid ""
"@message See <a href=\":url\">the help page</a> for more information "
