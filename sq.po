msgid "Interface text"
msgstr "Tekst i ndërfaqes"

msgid ""
"Order of language detection methods for interface text. If a "
"translation of interface text is available in the detected language, "
"it will be displayed."
msgstr ""
"Rendi i metodave të zbulimit të gjuhës për tekstin e ndërfaqes. "
"Nëse ekziston një përkthim i tekstit të ndërfaqes në gjuhën e "
"zbuluar, ai do të shfaqet."

msgid "Inaccessible"
msgstr "E paarritshme"

