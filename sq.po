msgid "File Extension"
msgstr "Zgjerimi i skedarit"

msgctxt "Validation"
msgid "File Extension Secure"
msgstr "Zgjatje skedari e sigurt"

msgctxt "Validation"
msgid "File Image Dimensions"
msgstr "Dimensionet e imazhit të skedarit"

msgctxt "Validation"
msgid "File Is Image"
msgstr "Skedari është imazh"

