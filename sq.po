msgstr ""
"URL-ja “tokenized” për fshirjen e një dorëzimi do të jetë e "
"disponueshme kur shihni informacionin e një dorëzimi dhe mund të "
"futet në një email duke përdorur tokenin "
"[webform_submission:token-delete-url]."

msgid ""
"Use the <a "
"href=\"https://github.com/wikimedia/composer-merge-plugin\">Composer "
