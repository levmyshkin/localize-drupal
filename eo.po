msgstr ""
"Se markite, informoj pri la varianto estos montrataj sur la ekrano al "
"ĉiuj uzantoj."

msgid "Example of a webform variant."
msgstr "Ekzemplo de retformulara variaĵo."

msgid "Webform [DEPRECATED]"
msgstr "Retumformo [MALREKOMENDATA]"

