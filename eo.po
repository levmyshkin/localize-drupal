msgstr "pri la stato de la modulo @name"

msgid "The following module is experimental: @modules."
msgid_plural "The following modules are experimental: @modules."
msgstr[0] "La sekva modulo estas eksperimenta: @modules."
msgstr[1] "La sekvaj moduloj estas eksperimentaj: @modules."

