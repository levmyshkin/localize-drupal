msgstr "Redirekta domajno"

msgid "Allows users to redirect between domains."
msgstr "Permesas al uzantoj alidirekti inter domajnoj."

msgid "Redirect domains"
msgstr "Alidirektaj domajnoj"

msgid "Sub path"
msgstr "Suba vojo"

msgid "No protocol should be included in the redirect domain."
msgstr "En la alidoma reto (redirect domain) ne estu inkluzivita protokolo."

msgid "The domain redirects have been saved."
msgstr "La domajnaj alidirektoj estis konservitaj."

msgid "Note: links open in the current window."
msgstr "Noto: ligiloj malfermiĝas en la nuna fenestro."

msgid "- All languages -"
msgstr "- Ĉiuj lingvoj -"

msgid "Ignore redirections on admin paths."
msgstr "Ignori alidirektojn ĉe administraciaj vojoj."

