"URL with message (redirects to a custom path or URL and displays the "
"confirmation message at the top of the page)"
msgstr ""
"URL kun mesaĝo (redirktas al kutima vojo aŭ URL kaj montras la "
"konfirman mesaĝon ĉe la supro de la paĝo)"

msgid "Autofocus the first element"
msgstr "Aŭtomate fokusu la unuan elementon"

