msgid ""
"%submission: Email <b>not sent</b> for %handler handler because a "
"<em>To</em>, <em>CC</em>, or <em>BCC</em> email was not provided."
msgstr ""
"%submission: Retpoŝto <b>ne sendita</b> por %handler manipulilo, ĉar "
"retpoŝta adreso <em>To</em>, <em>CC</em> aŭ <em>BCC</em> ne estis "
"provizita."

msgid ""
"%submission: Email <b>not scheduled</b> for %handler handler because "
"%send is not a valid date/token."
msgstr ""
"%submission: Retpoŝto <b>ne planita</b> por %handler ĉar %send ne "
"estas valida dato/ĵetono."

msgid ""
"%submission: Email <b>@action</b> by %handler handler to be sent on "
"%date."
msgstr ""
"%submission: Retpoŝto <b>@action</b>, de %handler sendota de %handler "
"al %date."

