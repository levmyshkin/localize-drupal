"jenajn liniojn: <pre><code>@htaccess</code></pre>"

msgid "Entry @human_index: @validation_error_message"
msgstr "Enskribo @human_index: @validation_error_message"

msgid "Symfony mailer (Experimental)"
msgstr "Symfony retpoŝtilo (Eksperimenta)"

msgid "The email address %mail is not valid. Use the format user@example.com."
msgstr "La retadreso %mail ne estas valida. Uzu la formaton user@example.com."

msgid "You cannot use an external URL. Enter a relative path."
msgstr "Vi ne povas uzi eksteran URL-n. Enigu relativan vojon."

