msgstr "Sendu la retejon (sitemap) al la sekvaj serĉiloj"

msgid "Do not submit more often than every"
msgstr "Ne sendu pli ofte ol ĉiuj"

msgid "Only submit if the sitemap has been updated since the last submission."
msgstr ""
"Sendu nur se la retejo-mapoj estis ĝisdatigitaj post la lasta "
"sendado."

msgid "Custom submission URLs"
msgstr "Propraj submetaj URL-oj"

msgid "Submitted the sitemap to %url and received response @code."
msgstr "Sukcesis sendi la retejan mapon al %url kaj ricevis respondon @code."

