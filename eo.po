msgstr "La titolo montrata sur la antaŭrigarda paĝo."

msgid "Allow this webform to be used as a template"
msgstr "Permesi, ke ĉi tiu retformularo estu uzata kiel ŝablono"

msgid "Disable saving of submissions"
msgstr "Malŝalti konservadon de senditaĵoj"

msgid "Allow users to post submissions from a dedicated URL"
msgstr "Permesu al uzantoj sendi kontribuaĵojn el diligenta URL"

