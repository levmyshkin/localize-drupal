msgstr "montritaj nur senditaj kontribuoj"

msgid "both form and viewed submission"
msgstr "kaj formularo kaj vidita senditaĵo"

msgid ""
"The next submission number was increased to @min to make it higher "
"than existing submissions."
msgstr ""
"La sekva sendnumero estis pliigita al @min por ke ĝi estu pli alta ol "
"la ekzistantaj senditaj kontribuoj."

