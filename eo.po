msgstr "Sorcisto finiĝa etikedo"

msgid "Default wizard end label"
msgstr "Defaŭlta finetikedo de la sorĉisto"

msgid "Address line 3"
msgstr "Adreso-linio 3"

msgid "Default elements"
msgstr "Defaŭltaj elementoj"

msgid "The elements have been unexpectedly altered. Please try again"
msgstr "La elementoj estis neatendite ŝanĝitaj. Bonvolu provi denove."

msgid ""
"There has been error validating the elements. You may need to edit the "
"<a href=\":href\">YAML source</a> to resolve the issue."
msgstr ""
"Okazis eraro dum validigo de la elementoj. Eble vi devos redakti la <a "
"href=\":href\">YAML-fonton</a> por solvi la problemon."

msgid "Leaving blank will use the default maxlength."
msgstr "Lasante ĝin malplena, estos uzata la defaŭlta maksimuma longo."

msgid "Leaving blank will use the default rows."
msgstr "Lasante ĝin malplena, vi uzos la defaŭltan nombron da vicoj."

