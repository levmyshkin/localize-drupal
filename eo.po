msgstr ""
"Uzu taksonomiajn terminojn kiel opciojn en Webform en Drupal 8 | "
"WebWash"

msgid "Use Ajax for all webforms"
msgstr "Uzu Ajax-on por ĉiuj retformularoj."

msgid "Truncate webform submission tables."
msgstr "Trunkigi retformularajn submettabelojn."

