msgstr "Permesoj de uzantrolo: \"@role\":"

msgid ""
"<a href=\":url\">Invalid permissions will trigger runtime exceptions "
"in Drupal 10.</a> Permissions should be defined in a permissions.yml "
"file or a permission callback."
msgstr ""
"<a href=\":url\">Nevalidaj permesoj kaŭzos rultempajn esceptojn en "
"Drupal 10.</a> Permesoj devus esti difinitaj en dosiero "
"permissions.yml aŭ per permes-kalbacko."

msgid ""
"Upgrades to Drupal 10 are supported from Drupal 9.4.x and Drupal "
"9.5.x. It is suggested to update to the latest Drupal 9 version "
"available. <a href=\":platform\">Several hosting platform requirements "
"have been raised for Drupal 10</a>."
msgstr ""
"Ĝisdatigoj al Drupal 10 estas subtenataj de Drupal 9.4.x kaj Drupal "
"9.5.x. Estas rekomendite ĝisdatigi al la plej nova disponebla versio "
"de Drupal 9. <a href=\":platform\">Oni levis plurajn postulojn por "
"gastigaj platformoj por Drupal 10</a>."

msgid "Version @version."
msgstr "Versio @version."

msgid "Version @current does not allow to upgrade and @new is available."
msgstr "Versio @current ne permesas ĝisdatigon kaj @new estas disponebla."

msgid "Drupal core should be at least 9.4.x"
msgstr "Drupal-kerno devus esti almenaŭ 9.4.x."

msgid "Language:"
msgstr "Lingvo:"

