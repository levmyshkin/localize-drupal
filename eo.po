msgstr "Ignori Agordon"

msgid "Config Ignore Settings"
msgstr "Agordoj por ignori la agordojn"

msgid "List of ignored configurations"
msgstr "Listo de ignoritaj agordoj"

msgid "Configuration entity names to ignore"
msgstr "Nomi de agordaj entoj por ignori"

msgid "Mode of operation"
msgstr "Reĝimo de funkciado"

msgid "Configuration Ignore settings"
msgstr "Agordaj ignoraj agordoj"

msgid "Ignore certain configuration during imports and exports"
msgstr "Ignori iujn agordojn dum importado kaj eksportado"

msgid "Operational mode"
msgstr "Operacia reĝimo"

msgid "lists for import and export ignoring"
msgstr "listoj por importado kaj eksportado ignorante"

msgid "List of ignored configurations on import"
msgstr "Listo de ignoritaj agordoj dum enporto"

msgid "List of ignored configurations on export"
msgstr "Listo de ignorataj agordoj dum eksportado"

msgid "Settings for advanced ignoring"
msgstr "Agordoj por altnivela ignorado"

