msgstr ""
"Malmrekomenditaj aŭ obskuritaj kernaj kromprogramoj instalitaj. Ili "
"estos forigitaj en la venonta grava versio."

msgid ""
"When using PostgreSQL, minimum version is 12 <a href=\":trgm\">with "
"the pg_trgm extension</a> created."
msgstr ""
"Uzante PostgreSQL, la minimuma versio estas 12 <a href=\":trgm\">kun "
"la etendaĵo pg_trgm</a> kreita."

msgid "Has pg_trgm extension."
msgstr "Havas la etendon pg_trgm."

msgid "No pg_trgm extension."
msgstr "Neniu etendaĵo **pg_trgm**."

