msgstr[0] "Montru"
msgstr[1] "Montras"

msgid "Unformatted list"
msgstr "Nesformatigita listo"

msgid "Contextual filters"
msgstr "Kontekstaj filtriloj"

msgid "contextual filters"
msgstr "kontekstaj filtriloj"

msgid "Contextual filter"
msgstr "Kunteksta filtrilo"

