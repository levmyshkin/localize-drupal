msgid "Telephone - mobile"
msgstr "ടെലിഫോൺ - മൊബൈൽ"

msgid "Telephone - fax"
msgstr "ദൂരഫോൺ - ഫാക്‌സ്"

msgid "Telephone - pager"
msgstr "ടെലിഫോൺ - പേജർ"

