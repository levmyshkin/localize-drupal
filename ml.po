"ചെയ്യുക"

msgid "Required for @title"
msgstr "@title కోసం നിർബന്ധമായത്"

msgid "Parent element @title"
msgstr "മാതൃ ഘടകം @title"

msgid "@label is archived"
msgstr ""
"@label ആർക്കൈവ് "
"ചെയ്‌തിരിക്കുന്നു"

