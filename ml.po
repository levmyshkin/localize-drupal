msgstr "ചിത്രത്തിന്റെ src നൽകുക…"

msgid "more images"
msgstr "കൂടുതൽ ചിത്രങ്ങൾ"

msgid "@count result for @label"
msgid_plural "@count results for @label"
msgstr[0] ""
"@label-നുള്ള @count ഫലം  \n"
"@label-നുള്ള "
"@count ഫലങ്ങൾ"

msgid "Custom number of days…"
msgstr ""
"ദിവസങ്ങളുടെ ഇഷ്ടാനുസൃത "
"എണ്ണം…"

msgid "Parent %parent_key key is not valid."
msgstr ""
"പാരന്റ് %parent_key എന്ന കീ "
"സാധുവല്ല."

msgid "There has been error validating the elements."
msgstr ""
"ഘടകങ്ങൾ "
"പരിശോധിക്കുന്നതിനിടെ "
