msgstr ""
"ഏതെങ്കിലും സമർപ്പണങ്ങൾ "
"കാണുക"

msgid "Update any submissions"
msgstr ""
"ഏതെങ്കിലും സമർപ്പണങ്ങൾ "
"അപ്ഡേറ്റ് ചെയ്യുക"

msgid "Delete any submissions"
msgstr ""
"ഏതെങ്കിലും സമർപ്പണങ്ങൾ "
"നീക്കം ചെയ്യുക"

msgid "View own submissions"
msgstr ""
"നിങ്ങളുടെ സ്വന്തം "
"സമർപ്പണങ്ങൾ കാണുക"

msgid "Update own submissions"
msgstr ""
"സ്വന്തം സമർപ്പണങ്ങൾ "
"പുതുക്കുക"

msgid "Delete own submissions"
msgstr ""
"സ്വന്തമായി ചെയ്ത "
