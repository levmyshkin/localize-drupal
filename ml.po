msgstr ""
"വെബ്ഫോം മോഡ്യൂൾ കോൺഫിഗർ "
"ചെയ്യുന്നു"

msgid "Understanding webform plugins"
msgstr ""
"വെബ്‌ഫോം പ്ലഗിനുകൾ "
"മനസ്സിലാക്കുക"

msgid "Translating webforms"
msgstr ""
"വെബ്‌ഫോമുകൾ വിവർത്തനം "
"ചെയ്യുന്നു"

