"നിലവിലെ സ്ഥിതി `@state` ആണ്"

msgid "known accessibility issues"
msgstr ""
"അറിയപ്പെടുന്ന "
"ആക്സസിബിലിറ്റി "
"പ്രശ്നങ്ങൾ"

msgid "jQuery: Text Counter"
msgstr "jQuery: ടെക്സ്റ്റ് കൗണ്ടർ"

msgid ""
"A jQuery plugin for counting and limiting characters/words on text "
"input, or textarea, elements."
msgstr ""
"ടെക്സ്റ്റ് ഇൻപുട്ട് "
"അല്ലെങ്കിൽ ടെക്സ്റ്റ് "
"ഏരിയ (textarea) എലമെന്റുകളിൽ "
"ഉള്ള "
"അക്ഷരങ്ങളുടെ/വാക്കുകളുടെ "
"എണ്ണം എണ്ണുകയും പരിധി "
"നിശ്ചയിക്കുകയും "
"ചെയ്യുന്നതിനുള്ള ഒരു jQuery "
"പ്ലഗിൻ."

msgid "Edit @label notes"
msgstr ""
"@label നോട്ടുകൾ എഡിറ്റ് "
"ചെയ്യുക"

msgid "Add notes to @label"
msgstr ""
"@label-ലേക്ക് കുറിപ്പുകൾ "
"ചേർക്കുക"

msgid "You may use tokens."
msgstr ""
"നിങ്ങൾക്ക് ടോകണുകൾ "
"ഉപയോഗിക്കാം."

msgid "Adding module dependency to @file…"
