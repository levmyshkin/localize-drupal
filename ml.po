"ഒരു കീവർഡ് നൽകുക."

msgid "handler"
msgstr "ഹാൻഡ്ലർ"

msgid "handlers"
msgstr "ഹാൻഡ്‌ലറുകൾ"

msgid "Exported @count of @total submissions…"
msgstr ""
"@total സമർപ്പണങ്ങളിൽ നിന്ന് "
"@count എണ്ണം എക്സ്പോർട്ട് "
"ചെയ്തു…"

msgid "@label flagged/starred."
