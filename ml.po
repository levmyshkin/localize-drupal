msgstr ""
"[@element_key] എൻ‌റ്റിറ്റി (@entity_id) "
"കണ്ടെത്താനായില്ല."

msgid "[@element_key] YAML is not valid. @error"
msgstr "[@element_key] YAML സാധുവല്ല. @error"

