msgstr ""
"സ്റ്റേറ്റ് API വഴി സന്ദേശം "
"അടച്ചത് "
"പുനഃസജ്ജീകരിക്കുന്നു…"

msgid "Resetting message closed via User Data…"
msgstr ""
"ഉപയോക്തൃ ഡാറ്റ വഴി അടച്ച "
"സന്ദേശം "
"പുനഃസജ്ജമാക്കുന്നു…"

