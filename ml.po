"%recipe വിജയകരമായി "
"പ്രയോഗിച്ചു"

msgid "Applied %recipe recipe."
msgstr "പ്രയോഗിച്ച %recipe രസിപ്പി."

msgid "Installed %theme theme."
msgstr "ഇൻസ്റ്റാൾ ചെയ്തത് %theme തീം."

msgid "Installed configuration for %recipe recipe."
msgstr ""
"%recipe റിസിപ്പിക്കായി "
"ഇൻസ്റ്റാൾ ചെയ്ത "
"കോൺഫിഗറേഷൻ."

msgid "Created content for %recipe recipe."
