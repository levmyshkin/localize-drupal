msgstr ""
"@language എന്നതിനുള്ള "
"വിവർത്തനം"

msgid "Use site name"
msgstr "സൈറ്റ് നാമം ഉപയോഗിക്കുക"

msgid "Use site slogan"
msgstr ""
"സൈറ്റ് മുദ്രാവാക്യം "
"ഉപയോഗിക്കുക"

msgid "File status"
msgstr "ഫയൽ നില"

msgid "Reduce"
msgstr "കുറയ്ക്കുക"

msgid "Easy"
msgstr "എളുപ്പം"

msgid "Breakpoint"
msgstr "ബ്രേക്ക്‌പോയിന്റ്"

msgid "Displaying @start - @end of @total"
msgstr ""
"@start - @end ൽ നിന്ന് @total വരെ "
"പ്രദർശിപ്പിക്കുന്നു"

msgid "Needs to be updated"
msgstr "അപ്‌ഡേറ്റ് ചെയ്യേണ്ടതാണ്"

msgid "Does not need to be updated"
msgstr "അപ്ഡേറ്റ് ചെയ്യേണ്ടതില്ല"

