msgstr "@id-ന്‍റെ ഭാരം"

msgid "Group for @id"
msgstr "@id-യുടെ ഗ്രൂപ്പ്"

msgid "Remove @id"
msgstr "@id നീക്കം ചെയ്യുക"

msgid "PHP date format"
msgstr "PHP തീയതി ഫോർമാറ്റ്"

msgid "@group: @title"
msgstr "@group: @title"

msgid "Registering module"
msgstr ""
"മോഡ്യൂൾ രജിസ്റ്റർ "
