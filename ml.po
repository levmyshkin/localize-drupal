msgid "Entity Print | Drupal.org"
msgstr "എന്റിറ്റി പ്രിന്റ് | Drupal.org"

msgid "Webform module now supports printing PDF documents | jrockowitz.com"
msgstr ""
"Webform മോഡ്യൂൾ ഇപ്പോൾ PDF "
"ഡോക്യുമെന്റുകൾ പ്രിന്റ് "
