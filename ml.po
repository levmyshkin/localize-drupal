msgstr ""
"ഈ ഫീൽഡ് ഒരു കസ്റ്റം "
"ലിങ്കായി ഔട്ട്പുട്ട് "
"ചെയ്യുക"

msgid "Trim this field to a maximum number of characters"
msgstr ""
"ഈ ഫീൽഡ് പരമാവധി "
"അക്ഷരങ്ങളുടെ എണ്ണത്തിൽ "
"മുറിച്ചുരുക്കുക"

