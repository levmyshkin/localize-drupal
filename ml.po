msgstr "@admin_label (ഒന്നിലധികം കോളുകൾ)"

msgid ""
"A backup checkpoint was not created because nothing has changed since "
"the \"{active}\" checkpoint was created."
msgstr ""
"\"{active}\" ചെക്ക്‌പോയിന്റ് "
"സൃഷ്ടിച്ചതിന് ശേഷം "
"മാറ്റങ്ങളൊന്നും "
"ഉണ്ടായിട്ടില്ലാത്തതിനാൽ "
"ഒരു ബാക്കപ്പ് "
"ചെക്ക്‌പോയിന്റ് "
"സൃഷ്ടിച്ചിട്ടില്ല."

msgid ""
"File entity %name was imported, but the associated file (@path) was "
