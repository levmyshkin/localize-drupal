msgstr "%label-നുള്ള വിവർത്തനങ്ങൾ"

msgid "@language (original)"
msgstr "@language (original)"

msgid "Enter label"
msgstr "ലേബൽ നൽകുക"

msgid "Enter a part of the label or description to filter by."
msgstr ""
"ഫിൽട്ടർ ചെയ്യുന്നതിനായി "
"ലേബലിലോ വിവരണത്തിലോ ഉള്ള "
"ഒരു ഭാഗം നൽകുക."

msgid "Enter field or @bundle"
msgstr "ഫീൽഡ് നൽകുക അല്ലെങ്കിൽ @bundle"

msgid "Enter a part of the field or @bundle to filter by."
msgstr ""
"ഫീൽഡിലെ ഒരു ഭാഗമോ "
"അല്ലെങ്കിൽ @bundle-ലോ നൽകിയാണ് "
"ഫിൽട്ടർ ചെയ്യേണ്ടത്."

