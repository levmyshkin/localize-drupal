msgid "Number of new comments"
msgstr "പുതിയ കമന്റുകളുടെ എണ്ണം"

msgid "Lists (Views)"
msgstr "ലിസ്റ്റുകൾ (Views)"

msgid "Simple configuration"
msgstr "ലളിതമായ ക്രമീകരണം"

