msgid "Content moderation state"
msgstr ""
"ഉള്ളടക്ക "
"നിയന്ത്രണത്തിന്റെ നില"

msgid "content moderation state"
msgstr "ഉള്ളടക്ക മോദറേഷൻ സ്ഥിതി"

