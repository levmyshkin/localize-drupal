msgstr ""
"ഡെമോ: മേഖലാ കോൺടാക്റ്റ്: "
"മാനേജർ: ഉപയോക്താക്കൾ"

msgid "This email is sent to managers users."
msgstr ""
"ഈ ഇമെയിൽ മാനേജർ "
"ഉപയോക്താക്കൾക്ക് "
"അയയ്ക്കുന്നു."

msgid "Manager: Email addresses: Email"
msgstr ""
"മാനേജർ: ഇമെയിൽ വിലാസങ്ങൾ: "
"ഇമെയിൽ"

msgid "Demo: Region Contact: Manager: Email addresses"
msgstr ""
"ഡെമോ: മേഖല: "
