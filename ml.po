msgstr ""
"പഴയ വെബ്‌ഫോം കോൺഫിഗറേഷൻ "
"ഫയലുകൾ പരിചരിച്ച് നീക്കം "
"ചെയ്യുക."

msgid "Repair webform submission storage schema"
msgstr ""
"വെബ്‌ഫോം സബ്മിഷൻ "
"സ്റ്റോറേജ് സ്കീമ "
"പരിഹരിക്കുക"

