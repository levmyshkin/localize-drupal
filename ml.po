msgstr "മാർ"

msgctxt "Abbreviated month name"
msgid "Apr"
msgstr "ഏപ്രിൽ"

msgctxt "Abbreviated month name"
msgid "May"
msgstr "മേയ്"

msgctxt "Abbreviated month name"
msgid "Jun"
msgstr "ജൂൺ"

msgctxt "Abbreviated month name"
msgid "Jul"
msgstr "ജൂലൈ"

msgctxt "Abbreviated month name"
msgid "Aug"
msgstr "ഓഗസ്റ്റ്"

msgctxt "Abbreviated month name"
msgid "Sep"
msgstr "സെപ്‌റ്റംബർ"

msgctxt "Abbreviated month name"
msgid "Oct"
msgstr "ഒക്ടോബർ"

msgctxt "Abbreviated month name"
msgid "Nov"
msgstr "നവംബർ"

msgctxt "Abbreviated month name"
msgid "Dec"
msgstr "ഡെക്"

