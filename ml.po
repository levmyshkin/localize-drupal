msgid "Apple Mobile: Web App Title"
msgstr ""
"ആപ്പിൾ മൊബൈൽ: വെബ് ആപ്പ് "
"തലക്കെട്ട്"

msgid "Mobile: Cleartype"
msgstr "മൊബൈൽ: ക്ലിയർടൈപ്പ്"

