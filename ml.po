msgstr ""
"ബ്രൗസർ ഭാഷ കണ്ടെത്തൽ "
"കോൺഫിഗറേഷൻ"

msgid "A Gettext Portable Object file."
msgstr "ഒരു Gettext Portable Object ഫയൽ."

msgid "Treat imported strings as custom translations"
msgstr ""
"ഇറക്കുമതി ചെയ്ത "
"സ്ട്രിംഗുകൾ കസ്റ്റം "
"വിവർത്തനങ്ങളായി "
"പരിഗണിക്കുക"

msgid "Overwrite non-customized translations"
msgstr ""
"കസ്റ്റമൈസ് ചെയ്യാത്ത "
"(non-customized) പരിഭാഷകൾ "
"മറികടക്കുക"

