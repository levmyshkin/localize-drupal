msgstr "<em>Sumber media tidak boleh diubah selepas jenis media dicipta.</em>"

msgid "Use video files for reusable media."
msgstr "Gunakan fail video untuk media yang boleh diguna semula."

msgid ""
"The destination system contains data which was not created by a "
