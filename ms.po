msgstr "Import pemetaan"

msgid "Importing submissions"
msgstr "Mengimport penghantaran"

msgid "Imported @count of @total submissions…"
msgstr "Diimport @count daripada @total penghantaran…"

msgid ""
"Submission import completed. (total: @total; created: @created; "
"updated: @updated; skipped: @skipped)"
msgstr ""
"Import penyerahan telah selesai. (jumlah: @total; dibuat: @created; "
"dikemas kini: @updated; dilangkau: @skipped)"

