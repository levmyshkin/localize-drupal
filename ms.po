msgstr ""
"Hantar semula secara automatik ke halaman seterusnya apabila halaman "
"telah siap."

msgid "Display show/hide all elements link"
msgstr "Paparkan pautan tunjuk/sembunyikan semua elemen"

msgid "Default wizard show all elements label"
msgstr "Wizard lalai menunjukkan semua label elemen"

msgid "Default wizard hide all elements label"
msgstr "Label wizard lalai sembunyikan semua elemen"

msgid "@start of @end"
msgstr "@start of @end"

msgid "Current card"
msgstr "Kad semasa"

