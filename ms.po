msgstr "Akses dihentikan: tindakan penyerahan ditolak"

msgid "Submission access denied title"
msgstr "Tajuk: Akses penghantaran ditolak"

msgid "Submission access denied message"
msgstr "Mesej akses penyerahan dinafikan"

