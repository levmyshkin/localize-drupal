"sebagai entiti sumber bagi penghantaran webform tersebut."

msgid "Open value"
msgstr "Buka nilai"

msgid "Close value"
msgstr "Nilai tutup"

msgid "Default submission data (YAML)"
msgstr "Data penghantaran lalai (YAML)"

