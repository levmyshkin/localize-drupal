msgstr "Klik <em>Simpan</em>."

msgid "Defines a field type for telephone numbers."
msgstr "Mentakrifkan jenis medan untuk nombor telefon."

msgid "simple configuration"
msgstr "konfigurasi ringkas"

msgid "The date the file created."
msgstr "Tarikh fail dicipta."

msgid "The timestamp that the file was created."
msgstr "Cap masa fail tersebut dicipta."

