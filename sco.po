"No sitemap types have been defined yet. <a href=\"@url\">Add a new "
"one</a>."
msgstr ""
"Chaidh ròpaichean làraich (sitemaps) sam bith a mhìneachadh "
"fhathast. <a href=\"@url\">Cuir fear ùr ris</a>."

msgid "sitemap"
msgstr "saitemap"

msgid "sitemap type"
msgstr "sitemap type → **tippaind de phàirt-laoich**"

msgid "sitemap types"
msgstr "saitemap-tíopid"

msgid ""
"At least one sitemap needs to be defined for a bundle to be "
"indexable.<br>Sitemaps can be configured <a href=\"@url\">here</a>."
msgstr ""
"Minimum one sitemap maun be defined for a bundle tae be "
"indexable.<br>Sitemaps can be configured <a href=\"@url\">here</a>."

msgid "Sitemap type %label has been updated."
msgstr "Táipisite mapa na làraich %label air ùrachadh."

