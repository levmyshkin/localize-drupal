msgstr "Inställingar for skjema-wizard/kort"

msgid "Default wizard/cards previous page button label"
msgstr "Label airson putan na duilleige roimhe sa bhùthag/wizard bunaiteach"

msgid "Default wizard/cards next page button label"
msgstr "Vaillie wizard/card næxt-page knap-læbel"

