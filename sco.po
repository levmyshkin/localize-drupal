"met Drupal @version nie."
msgstr[1] ""
"%archive_file bevat weergawes van modules of temas wat nie versoenbaar "
"is met Drupal @version nie: %names"

msgid ""
"See the <a href=\":available_updates\">available updates</a> page for "
"more information."
msgstr ""
"Seas an <a href=\":available_updates\">riaghladh nan ùrachaidhean a "
"tha ri fhaighinn</a> airson barrachd fiosrachaidh."

msgid "Check for updates of uninstalled modules and themes"
msgstr ""
