msgstr "%vocabulary: Dèan an ath-leasachadh de dh’atharrachaidhean air ais"

msgid ""
"To revert a revision you also need permission to edit the taxonomy "
"term."
msgstr ""
"Gum bu toin tu turn an ath-sgrìobhadh air ais feumaidh tu cead a "
"bhith agad te deasaichidh an teirm tacsonamaidh."

msgid "%vocabulary: Delete term revisions"
msgstr "%vocabulary: Skuirbain ath-chlàraidhean an teirmidh"

