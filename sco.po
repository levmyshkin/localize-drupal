msgstr ""
"Daar was doo nae overridden Metatag-innteachments a dh’fheumadh "
"ùrachadh airson an dàta a stòradh a’ cleachdadh JSON."

msgid ""
"Processed @processed of @total updating Metatag records with the "
"Publisher or Name meta tags."
msgstr ""
"@processed as processed av @total a dreiching Metatag-rekordar med dei "
"Publisher- eller Name-meta-tagane."

msgid "There were no Metatag records to update."
msgstr "Cha robh ginne Metatag-recorda ri ùrachadh."

msgid "Removed meta tags from the @config Metatag configuration."
msgstr "Fjernet meta-tags fan @config Metatag-rèitean."

msgid "Metatag: Google Plus is not enabled, nothing to do."
msgstr "Metaetikett: Google Plus ei’l enabled, niks to do."

msgid "Metatag: Google Plus has been uninstalled."
msgstr "Metatag: Tha Google Plus air a dhì-stàladh."

msgid ""
"Corrected the Twitter Card \"type\" value in the @config Metatag "
