msgstr "Eksen dīn komplett saït-stèupachadh"

msgid "Click <em>Export</em> and save the archive file."
msgstr "Cliog <em>Eksport</em> agus aontaich an druim-luathidh-faidhle."

msgid ""
"Select the <em>Configuration type</em> that you want to export, and "
"then select the specific <em>Configuration name</em> to export."
msgstr ""
"Vel <em>týpa na <strong>stillinga</strong></em> a that t’fheàrr "
