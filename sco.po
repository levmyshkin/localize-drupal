msgstr "Administreer bildstilar"

msgid "No defined styles"
msgstr "Níl stoidhlichean difinichte"

msgid "Error generating image."
msgstr "Mearachd a’ cruthachadh na h-ìomhaighe."

msgid "Unable to generate the derived image located at %path."
msgstr "Nechod eanr iad an derivéiert bild a tha suidhichte aig %path."

msgid "Failed to create style directory: %directory"
msgstr "Misluk’t to create style directory: %directory"

