"seo</a>."

msgid "No sitemaps have been defined yet. <a href=\"@url\">Add a new one</a>."
msgstr ""
"Chaidh sitemaps sam bith a mhìneachadh fhathast. <a "
"href=\"@url\">Cuir fear ùr ris</a>."

msgid "Sitemap type"
msgstr "Said: soidse mappa"

