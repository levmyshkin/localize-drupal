msgstr ""
"Palise aise, set up vähemalt aon <a "
"href=\"@sitemaps_url\">sitemap</a> tae be o’ a <a "
"href=\"@types_url\">type</a> that implements the views URL generator."

msgid "Included in sitemaps: "
msgstr "Ingesmait sa Sitemaps:"

msgid "Excluded from all sitemaps"
msgstr "Uitgeslùte õlle site-mapaïns bhoireann"

