msgstr ""
"Nàm an request-/session-paramadair a thèid a chleachdadh gus an "
"cànan a thèid iarraidh a dhearbhadh."

msgid "Filter translatable strings"
msgstr "Filterable strings a mheladh"

msgid "Date type"
msgstr "Dàta seòrsa"

msgid ""
"Determine the language from a request/session parameter. Example: "
