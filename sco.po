msgid "Webform Cards"
msgstr "Webform Cairtean"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"Biedt e Glasgow “Card”-container-element for vinnige clientside "
"multistep skjema-paginering."

