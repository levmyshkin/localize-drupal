msgstr "Cuir til ìomhaigh-buaidh"

msgid "Detection method"
msgstr "Opsporingsmetòd"

msgid "Part of the URL that determines language"
msgstr "Pàirt den URL a bhios a’ dearbhadh a’ chànain"

msgid "Request/session parameter"
msgstr "Forespørsle-/sesjonsparameter"

