msgstr ""
"ID sitemap bakal dadi bagéan saka URL lan mung bisa ngemot aksara "
"cilik, angka, tanda strip, lan garis ngisor."

msgid ""
"The sitemap's type defines its looks and content. Sitemaps types can "
"be configured <a href=\"@url\">here</a>."
msgstr ""
"Tipe sitemap nemtokake tampilan lan isine. Tipe sitemap bisa "
"dikonfigurasi <a href=\"@url\">ing kene</a>."

msgid "Sitemap %label has been updated."
msgstr "Sitemap %label wis dianyari."

msgid "Sitemap %label has been created."
msgstr "Sitemap %label wis digawe."

msgid ""
"Sitemaps of this type will be built according to the sitemap generator "
"plugin chosen here."
msgstr ""
"Sitemaps jinis iki bakal dibangun miturut plugin pembuat sitemap sing "
"dipilih ing kene."

msgid ""
"Sitemaps of this type will be populated with URLs generated by these "
"URL generator plugins."
msgstr ""
"Sitemap jinis iki bakal diisi karo URL sing digawe dening plugin "
"generator URL iki."

msgid ""
"Processing items from the queue.<br>Each sitemap gets published after "
"all of its items have been processed."
msgstr ""
"Nganggo item saka antrean.<br>Saben sitemap diterbitake sawise kabeh "
"item wis diproses."

msgid "Indexed bundles"
msgstr "Bundel sing diindeks"

msgid "No supported entity types available."
msgstr "Ora ana jinis entitas sing didhukung sing kasedhiya."

msgid "%bundle_label <span class=\"description\">(sitemaps: %sitemaps)</span>"
msgstr ""
"%bundle_label <span class=\"description\">(peta situs: "
"%sitemaps)</span>"

