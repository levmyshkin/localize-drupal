msgstr ""
"Berkas gambar ora sah utawa jinis gambar ora diijini. Jinis sing "
"diijini: %types"

msgid ""
"The image was resized to fit within the maximum allowed dimensions of "
"%dimensions pixels. The new dimensions of the resized image are "
"%new_widthx%new_height pixels."
msgstr ""
"Gambar wis diowahi ukurane supaya pas ing wates maksimum sing diijini "
"yaiku %dimensions piksel. Ukuran anyar saka gambar sing wis diowahi "
"yaiku %new_widthx%new_height piksel."

msgid ""
"The image was resized to fit within the maximum allowed height of "
"%height pixels. The new dimensions of the resized image are "
"%new_widthx%new_height pixels."
msgstr ""
"Gambar wis diukur ulang supaya pas ing jero dhuwur maksimal sing "
"diidinake, yaiku %height piksel. Ukuran anyar saka gambar sing wis "
"diukur ulang yaiku %new_widthx%new_height piksel."

msgid ""
"The image was resized to fit within the maximum allowed width of "
"%width pixels. The new dimensions of the resized image are "
"%new_widthx%new_height pixels."
msgstr ""
"Gambar kasebut diowahi ukurane supaya pas ing jero ambang maksimal "
"ambane %width piksel. Dimensi anyar saka gambar sing wis diowahi "
"ukurane yaiku %new_widthx%new_height piksel."

msgid "One or more files could not be uploaded."
msgstr "Siji utawa luwih file ora bisa diunggah."

msgid "Media display format settings"
msgstr "Setelan format tampilan media"

msgid "Show playback controls"
