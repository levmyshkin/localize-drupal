"Select the filter webforms default state selected on the <a "
"href=\":href\">webform overview page</a>."
msgstr ""
"Pilih kahanan default filter webforms sing wis dipilih ing <a "
"href=\":href\">kaca ringkesan webform</a>."

msgid "Form URL path settings"
msgstr "Setelan jalur URL formulir"

msgid "Select available variants"
msgstr "Pilih varian sing kasedhiya"

