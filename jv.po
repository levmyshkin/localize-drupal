msgid "CKEditor 5 enabled configurable plugins"
msgstr "CKEditor 5 ngaktifake plugin sing bisa dikonfigurasi"

msgid ""
"Configuration for the enabled plugin \"%plugin_label\" (%plugin_id) is "
"missing."
msgstr ""
"Konfigurasi kanggo plugin \"%plugin_label\" (%plugin_id) sing "
"diaktifake ora kasedhiya."

msgctxt "Validation"
msgid "CKEditor 5 fundamental text format compatibility"
msgstr "Kompatibilitas format teks dhasar CKEditor 5"

msgid ""
"CKEditor 5 only works with HTML-based text formats. The "
"\"%filter_label\" (%filter_plugin_id) filter implies this text format "
"is not HTML anymore."
msgstr ""
"CKEditor 5 mung bisa digunakake karo format teks adhedhasar HTML. "
"Filter \"%filter_label\" (%filter_plugin_id) nuduhake manawa format "
"teks iki ora HTML maneh."

msgid ""
"CKEditor 5 needs at least the &lt;p&gt; and &lt;br&gt; tags to be "
"allowed to be able to function. They are not allowed by the "
"\"%filter_label\" (%filter_plugin_id) filter."
msgstr ""
"CKEditor 5 mbutuhake paling ora tag &lt;p&gt; lan &lt;br&gt; supaya "
"bisa digunakake. Tag-tag iki ora diijini déning saringan "
"\"%filter_label\" (%filter_plugin_id)."

msgid ""
"The current CKEditor 5 build requires the following elements and "
"attributes: <br><code>@list</code><br>The following elements are not "
"supported: <br><code>@diff</code>"
msgstr ""
"Build CKEditor 5 saiki mbutuhake unsur lan atribut kaya ing ngisor "
"iki: <br><code>@list</code><br>Unsur-unsur ing ngisor iki ora "
"didhukung: <br><code>@diff</code>"

msgid ""
"The current CKEditor 5 build requires the following elements and "
"attributes: <br><code>@list</code><br>The following elements are "
"missing: <br><code>@diff</code>"
msgstr ""
"Versi CKEditor 5 saiki mbutuhake unsur lan atribut kaya ing ngisor "
"iki: <br><code>@list</code><br>Unsur sing kurang yaiku: "
"<br><code>@diff</code>"

