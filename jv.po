msgstr "Watesi (pesen saben interval)"

msgid "Interval (seconds)"
msgstr "Interval (detik)"

msgid ""
"Ideal when date and time needs to be input by users, like event dates "
"and times"
msgstr ""
"Cocok nalika tanggal lan wektu perlu diinput dening pangguna, kaya "
"tanggal lan wektu acara"

msgid "Date or date and time stored in a readable string format"
msgstr ""
"Tanggal utawa tanggal lan wektu disimpen ing format string sing bisa "
"diwaca"

msgid "Easy to read and understand for humans"
msgstr "Gampang diwaca lan dipahami kanggo manungsa"

