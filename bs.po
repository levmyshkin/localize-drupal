msgstr "URI veze dostupna je korisniku."

msgid "The path '@uri' is inaccessible."
msgstr "Putanja „@uri“ nije dostupna."

msgid "The path '@uri' is invalid."
msgstr "Putanja „@uri“ nije ispravna."

msgid "Indicates whether the menu link should be rediscovered"
msgstr "Označava da li se stavka izbornika treba ponovno otkriti."

