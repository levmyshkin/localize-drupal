msgstr ""
"Anonimni korisnik ne postoji. Pogledajte <a href=\":url\">vrati "
"anonimni (ID korisnika 0) zapis</a> za više informacija."

msgid "Are you sure you want to log out?"
msgstr "Jeste li sigurni da se želite odjaviti?"

msgid "View %view depends on role %role, but the role does not exist."
msgstr "Pogled %view zavisi od uloge %role, ali uloga ne postoji."

