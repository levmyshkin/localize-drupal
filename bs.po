msgstr "Poruke o greškama u odgovoru"

msgid ""
"<strong>ATTENTION DEVELOPERS!!!</strong> The webform submission form's "
" BASE_FORM_ID and FORM_ID have changed."
msgstr ""
"<strong>PAŽNJA PROGRAMERI!!!</strong> ID-ovi BASE_FORM_ID i FORM_ID u "
"obrascu za slanje webform podataka su promijenjeni."

msgid ""
"Please make sure to update all webform related "
"<code>hook_form_BASE_FORM_ID_alter()</code> and "
"<code>hook_form_FORM_ID_alter()</code> hooks."
msgstr ""
"Molimo vas da ažurirate sve webform povezane hookove "
"<code>hook_form_BASE_FORM_ID_alter()</code> i "
"<code>hook_form_FORM_ID_alter()</code>."

