msgstr ""
"Aktivni direktorij nije zaštićen pomoću PHP-TUF-a, što je "
"neophodno za bezbjedno korištenje upravitelja paketa."

msgid "The <code>@plugin</code> plugin is not installed."
msgstr "Plugin <code>@plugin</code> nije instaliran."

msgid ""
"@message See <a href=\":url\">the help page</a> for more information "
"on how to install the plugin."
msgstr ""
"@message Pogledajte <a href=\":url\">stranicu s uputama</a> za više "
"informacija o tome kako instalirati dodatak."

msgid "The <code>@plugin</code> plugin is not listed as an allowed plugin."
msgstr "Dodatak <code>@plugin</code> nije naveden kao dopušteni dodatak."

msgid ""
"@message See <a href=\":url\">the help page</a> for more information "
"on how to configure the plugin."
msgstr ""
"@message Pogledajte <a href=\":url\">stranicu s uputama</a> za više "
"informacija o tome kako da konfigurišete dodatak."

msgid ""
"@message See <a href=\":url\">the help page</a> for more information "
"on how to set up this repository."
msgstr ""
"@message Pogledajte <a href=\":url\">stranicu s uputama</a> za više "
"informacija o tome kako postaviti ovaj repozitorij."

msgid ""
"@message See the <a href=\":url\">Package Manager help</a> for more "
