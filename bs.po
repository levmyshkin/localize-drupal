msgstr ""
"Možete koristiti tokene polja prema „Obrascima zamjene” koji se "
"koriste u „Prepiši izlaz ovog polja” za sva polja."

msgid "This @entity_type_label can only be deleted in the Live workspace."
msgstr "Ovaj @entity_type_label može se obrisati samo u Live radnom prostoru."

msgid "Save and switch"
msgstr "Sačuvaj i pređi"

