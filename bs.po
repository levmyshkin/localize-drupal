msgstr "Putanja do Comporera je podešena"

msgid "jQuery UI Autocomplete"
msgstr "jQuery UI automatsko dopunjavanje"

msgid "Complete drag & drop"
msgstr "Kompletan drag & drop"

msgid "Altered"
msgstr "Promijenjeno"

msgid ""
"Value stored in the database. Leave blank to store an empty string in "
