msgstr "Postavke varijanti"

msgid "Filter category"
msgstr "Filtriraj kategoriju"

msgid "Filter state"
msgstr "Filter stanje"

msgid "Excluded webform variants"
msgstr "Izuzete varijante web-obrasca"

