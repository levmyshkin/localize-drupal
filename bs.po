msgstr[0] "Već 1 blokirana prijava formulara"
msgstr[1] "Već @count blokiranih prijava formulara"

msgid "Presolved image CAPTCHA example, generated with the current settings."
msgstr ""
"Primjer prethodno riješenog CAPTCHA-a za sliku, generiran trenutnim "
"postavkama."

msgid "extra large"
msgstr "ekstra velikо"

