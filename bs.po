msgstr "Sljedeća stranica"

msgid ""
"Randomize the rotation angle for each image. The angle specified above "
"is used as a maximum."
msgstr ""
"Nasumično odredite ugao rotacije za svaku sliku. Ugao naveden iznad "
"koristi se kao maksimalna vrijednost."

msgid "Diego Garcia"
msgstr "Diego Garcia"

msgid "Lower case"
msgstr "Mala slova"

msgid "Multiple roles"
msgstr "Više uloga"

msgid "Unordered list - use the &lt;li&gt; to begin each list item"
msgstr ""
"Neuređena lista — koristite oznaku <code>&lt;li&gt;</code> da biste "
"započeli svaku stavku liste."

