msgid_plural "Request response code is one of the following: @codes"
msgstr[0] ""
"Kôd odgovora zahtjeva je: @codes  \n"
"Kôd odgovora zahtjeva je jedan "
"od sljedećih: @codes"

msgid "Creates a new transparent object and sets it for the image."
msgstr "Kreira novi transparentni objekt i postavlja ga za sliku."

