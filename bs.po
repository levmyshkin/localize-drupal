msgstr "@field_name: @label"

msgid "Boolean settings"
msgstr "Booleanske postavke"

msgid "On label"
msgstr "Na oznaku"

msgid "Off label"
msgstr "Van odobrene indikacije"

msgid "Updating translations for JavaScript and default configuration."
msgstr "Ažuriranje prijevoda za JavaScript i podrazumijevanu konfiguraciju."

