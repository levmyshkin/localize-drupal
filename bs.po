"The %field_type_label field type is used in the following field: "
"@fields"
msgid_plural ""
"The %field_type_label field type is used in the following fields: "
"@fields"
msgstr[0] "Tip polja %field_type_label koristi se u sljedećem polju: @fields"
msgstr[1] "Tip polja %field_type_label koristi se u sljedećim poljima: @fields"

