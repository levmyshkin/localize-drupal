msgid "This option adds randomly colored point noise."
msgstr "Ova opcija dodaje nasumičnu šumu tačaka nasumičnih boja."

msgid "Add line noise"
msgstr "Dodajte šum linije"

msgid "This option enables lines randomly drawn on top of the text code."
msgstr "Ova opcija omogućava nasumično crtane linije iznad koda teksta."

msgid "Noise level"
