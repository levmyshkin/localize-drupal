msgstr ""
"પ્રતિસાદી ગ્રિડમાં "
"પંક્તિઓ દર્શાવે છે."

msgid "Insert Media"
msgstr "મીડિયા દાખલ કરો"

msgid "Edit {{ name }}"
msgstr "{{ name }} ને સંપાદિત કરો"

