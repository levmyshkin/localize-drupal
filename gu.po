msgid "has word"
msgstr "શબ્દ “has”"

msgid "Contains all words"
msgstr "બધી જ શબ્દો સમાવે છે"

msgid "has all"
msgstr "બધું છે"

msgid "begins"
msgstr "શરૂ થાય છે"

msgid "ends"
msgstr "અંતમાં"

