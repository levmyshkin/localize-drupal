msgstr "કૅપ્ચા ફરીથી લોડ કરો"

msgid "Overlay close"
msgstr "ઓવરલે બંધ કરો"

msgid "Custom (with tokens)"
msgstr "કસ્ટમ (ટોકન્સ સાથે)"

