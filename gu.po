msgid "One or more names separated by , or +"
msgstr ""
", અથવા + દ્વારા અલગ કરેલ એક "
"અથવા વધુ નામો"

msgid "Title field required"
msgstr "શીર્ષક ક્ષેત્ર આવશ્યક છે"

msgid "Boolean string"
msgstr "બૂલિયન સ્ટ્રિંગ"

