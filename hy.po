"օրինակ։"

msgid ""
"Inline (Displays message when access is denied to field, nodes, and "
"blocks)"
msgstr ""
"Ներսի (Ցուցադրում է հաղորդագրություն, "
"երբ մուտք է մերժվում դաշտերին, "
"հանգույցներին և բլոկներին)"

msgid ""
"Page (Displays message when access is denied to forms, fields, nodes, "
"and blocks)"
msgstr ""
"Էջ (Ցույց է տալիս հաղորդագրություն, "
"երբ մուտքը մերժվում է ձևերի, դաշտերի, "
"հանգույցների և բլոկների համար)"

msgid ""
"Login (Redirects to user login form and displays message. Field, "
"nodes, and block only display the message.)"
msgstr ""
"Մուտք (Փոխանցվում է օգտվողի մուտքի ձևի "
"և ցուցադրվում է հաղորդագրություն. "
"Տիրույթը, հանգույցները և բլոկը միայն "
"ցուցադրում են հաղորդագրությունը.)"

msgid ""
"When this container is hidden all this container's subelement values "
"will be cleared."
msgstr ""
"Երբ այս կոնտեյները թաքնվում է, այս "
"կոնտեյների բոլոր ենթաիրըակի "
"արժեքները կվերացվեն։"

msgid "When this element is hidden, this element's value will be cleared."
msgstr ""
"Երբ այս տարրը թաքնված է, այս տարրի "
"արժեքը կմաքրվի։"

