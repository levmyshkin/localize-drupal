msgstr "Հղում՝ հեռացնելու համար @entity_type_label"

msgid "Provide a delete link to the @entity_type_label."
msgstr ""
"Ապա ներկայացրեք ջնջելու հղում "
"@entity_type_label-ի համար:"

msgctxt "View entity type"
msgid "View"
