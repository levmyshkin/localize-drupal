"@entity_type_label:"

msgid "Link to edit @entity_type_label"
msgstr "Հղում՝ խմբագրելու համար @entity_type_label"

msgid "Provide an edit link to the @entity_type_label."
msgstr ""
"Խնդրեցեք խմբագրման հղում տրամադրել "
"@entity_type_label-ին:"

