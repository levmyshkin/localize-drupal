msgstr ""
"Հրապարակեք տվյալները, երբ "
"<b>ներկայացումը ավարտվի</b>:"

msgid "Post data when <b>submission is updated</b>."
msgstr ""
"Դասագրի տվյալներ, երբ <b>ներկայացումը "
"թարմացվի</b>:"

msgid "Post data when <b>submission is deleted</b>."
msgstr ""
"Պահպանեք տվյալները, երբ <b>հաղորդումը "
"ջնջվում է</b>:"

msgid "draft created"
msgstr "նախագիծ ստեղծված է"

msgid "Post data when <b>draft is created.</b>"
msgstr ""
"Դատի տվյալներ, երբ <b>ստեղծվում է "
"նախագծի նախագիծը։</b>"

msgid "draft updated"
msgstr "նախատիպը թարմացված է"

msgid "Post data when <b>draft is updated.</b>"
msgstr ""
"Դասակարգել տվյալները, երբ "
"<b>մասագրությունը թարմացվում է։</b>"

