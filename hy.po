msgid "XML Sitemap Custom"
msgstr "XML Կայքի Նկարագիր Անհատական"

msgid "Use a relative path with a slash in front. For example, \"/about\"."
msgstr ""
"Օգտագործեք հարաբերական ուղի, որի "
"առաջատակում անիվ է դրված։ Օրինակ՝ "
"\"/about\"։"

msgid "XML Sitemap Engines"
msgstr "XML կայքէջ քարտեզի շարժիչներ"

