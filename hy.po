msgstr ""
"Ժամանակավոր տեղական ֆայլեր  "
"վերբեռնման և նախադիտման համար:"

msgid "Update modules"
msgstr "Թարմացնել մոդուլները"

msgid "Update themes"
msgstr "Թարմացնել թեմաները"

msgid "SSH"
msgstr "SSH"

msgid ""
"Your password is not saved in the database and is only used to "
