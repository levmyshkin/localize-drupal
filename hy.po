msgid "Serialized configuration object data."
msgstr ""
"Սերիալացված կոնֆիգուրացիոն օբյեկտի "
"տվյալներ։"

msgid "Find and manage media."
msgstr "գտնել և կառավարել մեդիան։"

msgid "Media thumbnail field display format settings"
msgstr ""
"Մեդիայի մանրապատկերի դաշտի ցուցման "
"ձևաչափի կարգավորումներ"

