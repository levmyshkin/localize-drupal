msgstr "Կիրառեք կայքը սպասարկման ռեժիմում"

msgid "View site reports"
msgstr "Դիտել կայքի հաշվետվություններ"

msgid "Public files"
msgstr "Հանրային ֆայլեր"

msgid "Public local files served by the webserver."
