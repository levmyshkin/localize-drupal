msgstr "Վերակառուցելի չեն որևէ կապի տեսակներ։"

msgid "Status Override"
msgstr "Կարգավիճակի գերազանցում"

msgid "Sub-type"
msgstr "Ենթատեսակ"

msgid "Priority Override"
msgstr "Առավելության վերափոխում"

