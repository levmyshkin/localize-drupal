msgstr "Միջնորդամիջոց աղբյուր"

msgid "Region: @region"
msgstr "Տարածք՝ @region"

msgid "Navigation menu"
msgstr "Նավիգացիոն մենյու"

msgid "The field ID."
msgstr "Աճյունակի ID-ն։"

msgid "Last upgrade: @date"
msgstr "Վերջին արդիականացում՝ @date"

msgid "Is front page"
msgstr "Արդյո՞ք ուղեցույցի էջ է"

