"енгізіңіз."

msgid "Promote selected content to front page"
msgstr ""
"Таңдалған контентті басты бетке "
"шығару"

msgid "Demote selected content from front page"
msgstr ""
"Таңдалған контентті басты беттен "
"төмендету"

