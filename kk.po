msgstr "URL-ді қайта бағыттау қосу"

msgid "URL Redirects"
msgstr "URL мекенжайларын қайта бағыттау"

msgid "Redirect settings"
msgstr "Қайта бағыттау баптаулары"

msgid "Redirect 404"
msgstr "404-ке қайта бағыттау"

