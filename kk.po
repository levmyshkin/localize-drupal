"  '#title': "
"'U.S. States'\n"
"  '#required': true\n"
"button:\n"
"  '#type': "
"'webform_options_custom:buttons'\n"
"  '#title': 'Buttons'\n"
"  "
"'#required': true\n"
"  '#options':\n"
"    one: One -- This is the number "
"1.\n"
"    two: Two -- This is the number 2.\n"
"    three:  Three -- This "
"is the number 3.\n"
""
msgstr ""
"```yaml\n"
"states:\n"
"  '#type': 'webform_options_custom:us_states'\n"
"  "
"'#title': 'АҚШ штаттары'\n"
"  '#required': true\n"
"button:\n"
" "
" '#type': 'webform_options_custom:buttons'\n"
"  '#title': "
"'Түймелер'\n"
"  '#required': true\n"
"  '#options':\n"
"    one: "
"Бір -- Бұл 1 саны.\n"
"    two: Екі -- Бұл 2 "
"саны.\n"
"    three: Үш -- Бұл 3 саны.\n"
"```"

