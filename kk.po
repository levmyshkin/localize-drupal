msgstr "Шешілді"

msgid "Status code"
msgstr "Күй коды"

msgid "Fragment"
msgstr "Фрагмент"

msgid ""
"You can find more information about HTTP redirect status codes at <a "
"href=\"@status-codes\">@status-codes</a>."
msgstr ""
"HTTP қайта бағыттау (redirect) күй кодтары "
