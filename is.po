msgid "Datetime format valid for datetime type."
msgstr "Dagsetningasnið sem gildir fyrir datetime-gerð."

msgid "The field type."
msgstr "Gerð reitsins."

msgid "The field status."
msgstr "Stöðufærsla."

msgid "The field storage type."
msgstr "Tegund gagnageymslu sviðsins."

