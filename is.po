msgid "Extension is available"
msgstr "Viðbótin er fáanleg"

msgid "Module '@name' is not available."
msgstr "Einingin „@name“ er ekki til staðar."

msgid "Theme '@name' is not available."
msgstr "Þemað „@name“ er ekki tiltækt."

msgid "Profile '@name' is not available."
msgstr "Prófíllinn „@name“ er ekki tiltækur."

