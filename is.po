msgstr "<strong>@title</strong> (Uppsett)"

msgid ""
"The <a href=\":homepage_href\">@title</a> library is installed by the "
"<b><a href=\":module_href\">@module</a></b> module."
msgstr ""
"<a href=\":homepage_href\">@title</a> bókasafnið er sett upp af "
"<b><a href=\":module_href\">@module</a></b>-einingunni."

