msgstr "Býður upp á láréttan línuhluta."

msgid "Example settings"
msgstr "Dæmi um stillingar"

msgid ""
"Duplicate key found. The %key key must only be assigned on one "
"element."
msgstr ""
"Tvítekið lykilatriði fannst. %key-lyklinum má aðeins úthluta á "
"eitt frumefni."

