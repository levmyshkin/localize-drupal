msgstr ""
"Þessi myndbandsleiðsögn fer yfir hvernig setja á vefeyðublað "
"(webform) á vefsíðu sem kubb (block)."

msgid "Working with blocks | Drupal.org"
msgstr "Að vinna með blokkir | Drupal.org"

msgid "Blocks | Drupalize.me"
msgstr "Blokkir | Drupalize.me"

msgid ""
"This screencast offers an overview of the Webform module's element, "
