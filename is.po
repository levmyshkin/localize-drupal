msgstr "Sýning á svæðisbundnu sambandsformi."

msgid "Employee: Email"
msgstr "Starfsmaður: Netfang"

msgid "Demo: Region Contact: Employee"
msgstr "Kynning: Samsvörun tengiliðir: Starfsmaður"

msgid "Manager: Email"
msgstr "Stjórnandi: Tölvupóstur"

