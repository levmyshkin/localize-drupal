msgstr "Hvar er Drupal-samfélagið? | Drupal.org"

msgid "Contributing to Drupal | Drupalize.me"
msgstr "Að leggja af mörkum til Drupal | Drupalize.me"

msgid "Concept: The Drupal Project | Drupalize.me"
msgstr "Hugtak: Drupal-verkefnið | Drupalize.me"

