msgstr ""
"Þetta er notað fyrir „Fyrri síða“-hnappinn innan stýrðu "
"ferlanna (wizard/cards)."

msgid "Wizard/cards next page button label"
msgstr "Vísir/spjald næsta síðunnar hnappalabel"

