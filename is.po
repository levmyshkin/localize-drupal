msgstr "Skipun sem á að keyra fyrir sendmail-útflutning (transport)"

msgid "SMTP options"
msgstr "SMTP-vorstillingar"

msgid "TLS Peer Verification (defaults to true)"
msgstr "Staðfesting TLS jafningja (sjálfgefið er true)"

msgid "TLS Peer Fingerprint (no default)"
msgstr "TLS jafningja fingrafar (engin sjálfgefin stilling)"

msgid ""
"Domain name or IP address that represents the identity of the client "
