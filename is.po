msgstr "Sjálfgefið staðfestingarmerki afturábak"

msgid "Confirmation back link CSS classes"
msgstr "Staðfesting afturhlekja CSS-flokkar"

msgid "Wizard start attributes"
msgstr "Færibreytur fyrir upphafshjálp (Wizard start)"

