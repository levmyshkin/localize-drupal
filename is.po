msgstr "Titill, heiti/merking einingar"

msgid "URL, an entity's URL"
msgstr "URL, vefslóð einingar"

msgid "Replace file upload input with an upload button"
msgstr "Skiptu út skráaútsendingu með innsláttarsviði fyrir hlaðahnapp"

