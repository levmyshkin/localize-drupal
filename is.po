msgstr "Sýna merki ef innihald er nýtt eða uppfært."

msgid "Show only content that is new or updated."
msgstr "Sýna aðeins efni sem er nýtt eða uppfært."

msgid "Display the content with standard node view."
msgstr "Sýna innihaldið með venjulegri node-skoðun."

msgid "Content ID from URL"
msgstr "Innihaldsskilríki (Content ID) úr slóð (URL)"

msgid ""
"Content that is associated with this file, usually because this file "
