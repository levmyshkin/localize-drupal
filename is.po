msgstr "Engar nýjar URL-tilvísanir til að búa til."

msgid "Double quotation marks"
msgstr "Hástafir innan tvöfaldra gæsalappa"

msgid "Single quotation marks (apostrophe)"
msgstr "Ein gæsalöpp (upphafs- og lokkomma)"

