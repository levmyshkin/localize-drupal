msgstr "Núverandi vefeyðublað"

msgid "Question description"
msgstr "Lýsing á spurningu"

msgid "Compact, with the option values delimited by commas in one column."
msgstr "Þétt, með valkostagildi afmörkuð með kommum í einni dálk."

