msgstr "<strong>@title @version</strong> (Uppsett)"

msgid ""
"<span class=\"color-warning\"><strong>@title @version</strong> "
"(CDN).</span>"
msgstr ""
"<span class=\"color-warning\"><strong>@title @version</strong> "
"(CDN).</span>"

