msgstr ""
"Hámarksfjöldi skilaboða til að senda áður en flutningur er "
"hafinn aftur (sjálfgefið er 100 skilaboð)"

msgid ""
"Number of seconds to sleep between stopping and re-starting the "
"transport (defaults to no delay)"
msgstr ""
"Fjöldi sekúndna til að sofa á milli stöðvunar og endurræsingar "
"sendingar (sjálfgefið: engin tafð)"

msgid ""
"The minimum number of seconds between two messages required to ping "
"the server (defaults to 100 seconds)"
msgstr ""
"Lágmarksfjöldi sekúndna á milli tveggja skilaboða sem þarf til "
"að pinga netþjóninn (sjálfgefið er 100 sekúndur)"

msgid "The number of messages to send per second (defaults to no limit)"
msgstr ""
"Fjöldi skilaboða sem á að senda á hverri sekúndu (sjálfgefið: "
"engin takmörkun)"

