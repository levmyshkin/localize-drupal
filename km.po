msgstr "កំណត់តម្លៃដែលបានបញ្ចូលជាចំនួនអក្សរឬពាក្យអតិបរមា។"

msgid ""
"If checked, all <a href=\":details_href\">Details</a> element's "
"open/close state will be saved using <a "
"href=\":local_storage_href\">Local Storage</a>."
msgstr ""
"ប្រសិនបើបានជ្រើសរើស, "
"សភាពបើក/បិទ របស់ធាតុ <a "
"href=\":details_href\">ព័ត៌មានលម្អិត</a> "
"ទាំងអស់នឹងត្រូវបានរក្សាទុកដោយប្រើ "
"<a "
"href=\":local_storage_href\">ឃ្លាំងក្នុងស្រុក</a> "
"។"

