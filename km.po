msgstr "កំពុងដំណើរការធាតុពីកុងតឺន័រជួរ។<br>ផែនទីសាយតំណានជាមួយនឹងធាតុទាំងអស់របស់វាត្រូវបានផ្សាយបន្ទាប់ពីបានដំណើរការពេញលេញ។"

msgid "Indexed bundles"
msgstr "កញ្ចប់ដែលបានសូមរៀបចំនូវកំណត់ត្រា"

msgid "No supported entity types available."
msgstr "ប្រភេទអង្គភាពដែលគាំទ្រមិនមាន។"

msgid "%bundle_label <span class=\"description\">(sitemaps: %sitemaps)</span>"
msgstr ""
"%bundle_label <span "
"class=\"description\">(ផែនទីគេហទំព័រ: "
"%sitemaps)</span>"

msgid "Configure %label entity type"
msgstr ""
"កំណត់រចនាសម្ព័ន្ធប្រភេទអង្គភាព "
"%label"

msgid "IndexNow notification enabled"
msgstr ""
"ការជូនដំណឹង IndexNow "
"ត្រូវបានបើកដំណើរការ"

msgid "IndexNow notification disabled"
msgstr "ការជូនដំណឹង IndexNow បានបិទហើយ"

msgid "IndexNow"
msgstr "IndexNow"

msgid "Simple XML Sitemap IndexNow"
msgstr ""
"Simple XML Sitemap "
"IndexNow\n"
"\n"
"(ខ្មែរដែលធម្មតាសម្រាប់បច្ចេកទេស "
"និងប្រើដូចដើមបន្ទាប់ពីឈ្មោះឧបករណ៍សម្រាប់ប្រព័ន្ធ "
"CMS មិន​ត្រូវ​បំផ្លាញ "
"ឬ​ប្រែ​ជាភាសាផ្សេង)"

