msgstr "រៀងរាល់ @increment ថ្ងៃ"

msgid "every @increment weeks"
msgstr "រៀងរាល់ @increment សប្តាហ៍"

msgid "every year"
msgstr "រៀងរាល់ឆ្នាំ"

