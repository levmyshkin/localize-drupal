msgstr ""
"ឈ្មោះប្រើប្រាស់បានធ្វើបច្ចុប្បន្នភាពសម្រាប់ "
"%label @id។"

msgid "Updated 1 %label URL alias."
msgid_plural "Updated @count %label URL aliases."
msgstr[0] ""
"បានធ្វើបច្ចុប្បន្នភាពឈ្មោះបណ្ដាញ "
"URL %label 1។  "
"\n"
"បានធ្វើបច្ចុប្បន្នភាពឈ្មោះបណ្ដាញ "
"URL %label @count។"

msgid ""
"When a pattern includes certain characters (such as those with "
"accents) should Pathauto attempt to transliterate them into the "
"US-ASCII alphabet?"
msgstr ""
"នៅពេលមួយទំរង់មានអក្សរតិចតួចខ្លះ "
"(ដូចជាអក្សរដែលមានសំឡេងបន្ថែម) "
"តើ Pathauto "
"ត្រូវព្យាយាមបម្លែងអក្សរទាំងនោះទៅជាអក្សរចំណាំ "
"US-ASCII ឬមែន?"

msgid ""
"This page provides a list of all patterns on the site and allows you "
"to edit and reorder them."
msgstr ""
"ទំព័រនេះផ្តល់ជាតារាងនៃគំរូទាំងអស់លើវេបសាយ "
"ហើយអនុញ្ញាតឲ្យអ្នកកែប្រែ "
"និងប្តូរតម្រៀបពួកវា។"

msgid ""
"The %element-title is using the following invalid characters: "
"@invalid-characters."
msgstr ""
"%element-title "
"កំពុងប្រើតួអក្សរមិនត្រឹមត្រូវដូចខាងក្រោម: "
"@invalid-characters។"

msgid "Convert token values to lowercase."
msgstr ""
"បម្លែងតម្លៃ token "
"ទៅអក្សរតូច។"

msgid "Are you sure you want to disable the pattern %label?"
msgstr ""
"តើអ្នកប្រាកដជាចង់បិទបំណុលគំរូ "
"%label មែនទេ?"

msgid "Disabled patterns are ignored when generating aliases."
msgstr "លំនាំដែលបានបិទការប្រើប្រាស់ត្រូវបានរំលងនៅពេលបង្កើតឈ្មោះអлийាស។"

msgid "Disabled pattern %label."
msgstr "លាក់លំនាំ %label។"

msgid "Are you sure you want to enable the pattern %label?"
msgstr ""
"តើ​អ្នក​ប្រាកដ​ឬ​មិន​ចង់​បើក​ប្រើ​តម្រង "
"%label?"

msgid "Enabled pattern %label."
msgstr ""
"គំរូ %label "
"ត្រូវបានបើកใช้งาน។"

msgid "Update URL alias of an entity"
msgstr ""
"ធ្វើបច្ចុប្បន្នភាពឈ្មោះប្ដូរជ "
"URl របស់អង្គភាពមួយ"

msgid ""
"The Pathauto module provides a mechanism to automate the creation of "
"<a href=\"path\">path</a> aliases. This makes URLs more readable and "
"helps search engines index content more effectively.  For more "
"information, see the <a href=\":online\">online documentation for "
"Pathauto</a>."
msgstr ""
"ម៉ូឌុល Pathauto "
"ផ្ដល់មេកានិចមួយសម្រាប់ស្វ័យប្រវត្តិបង្កើត "
"<a href=\"path\">ផ្លូវ​ចរន្ត</a> "
"ជំនួស។ វាធ្វើឲ្យ URL "
"កាន់តែងាយស្រួលក្នុងការអាន "
"និងជួយឲ្យម៉ាស៊ីនស្វែងរកអាចធ្វើការបញ្ជីមាតិកាបានប្រសើរជាងមុន។ "
"សម្រាប់ព័ត៌មានបន្ថែម "
"សូមមើល <a "
"href=\":online\">ឯកសារបណ្ដាញសម្រាប់ "
"Pathauto</a>។"

msgid ""
"Pathauto is accessed from the tabs it adds to the list of <a "
"href=\":aliases\">URL aliases</a>."
msgstr ""
"Pathauto ត្រូវបាន truy cập từ tab "
"ដែលវាបន្ថែមទៅក្នុងបញ្ជី "
"<a href=\":aliases\">ឈ្មោះ URL ជំនួស</a>។"

msgid "Creating Pathauto Patterns"
msgstr "បង្កើត​គន្លង Pathauto"

msgid ""
"The <a href=\":pathauto_pattern\">\"Patterns\"</a> page is used to "
"configure automatic path aliasing.  New patterns are created here "
"using the <a href=\":add_form\">Add Pathauto pattern</a> button which "
"presents a form to simplify pattern creation thru the use of <a "
"href=\"token\">available tokens</a>. The patterns page provides a list "
"of all patterns on the site and allows you to edit and reorder them. "
"An alias is generated for the first pattern that applies."
msgstr ""
"ទំព័រ <a "
"href=\":pathauto_pattern\">\"រចនាសម្ព័ន្ធ\"</a> "
"ត្រូវបានប្រើសម្រាប់កំណត់ការបង្កើតឈ្មោះផ្លូវជំនួសដោយស្វ័យប្រវត្តិ។ "
"រចនាសម្ព័ន្ធថ្មីៗ "
"ត្រូវបានបង្កើតនៅទីនេះតាមរយៈប៊ូតុង "
"<a "
"href=\":add_form\">បន្ថែមរចនាសម្ព័ន្ធ "
"Pathauto</a> "
"ដែលបង្ហាញតម្រងសម្រាប់ធ្វើឱ្យការបង្កើតរចនាសម្ព័ន្ធកាន់តែងាយស្រួលជាមួយនឹងការប្រើប្រាស់ "
"<a href=\"token\">សញ្ញាលេខ Token "
"មានស្រាប់</a>។ "
"ទំព័ររចនាសម្ព័ន្ធផ្តល់នូវបញ្ជីររាល់រចនាសម្ព័ន្ធទាំងអស់នៅលើគេហទំព័រ "
"និងអនុញ្ញាតឱ្យអ្នកកែសម្រួល "
"និងរៀបចំចំណាត់ថ្នាក់របស់វា។ "
"ឈ្មោះផ្លូវជំនួសត្រូវបានបង្កើតសម្រាប់រចនាសម្ព័ន្ធដំបូងដែលមានប្រសិទ្ធភាព។"

msgid ""
"The <a href=\":settings\">\"Settings\"</a> page is used to customize "
"global Pathauto settings for automated pattern creation."
msgstr ""
"ទំព័រ <a href=\":settings\">\"ការកំណត់\"</a> "
"ត្រូវបានប្រើសម្រាប់ការ​កំណត់តម្លៃ​ផ្លូវ​សកល "
"Pathauto "
"ដើម្បីបង្កើត​គំរូ​អូតូម៉ាទិច។"

msgid "Bulk Generation"
msgstr "ការបង្កើតជាច្រើន"

msgid ""
"The <a href=\":pathauto_bulk\">\"Bulk Generate\"</a> page allows you "
"to create URL aliases for items that currently have no aliases. This "
"is typically used when installing Pathauto on a site that has existing "
"un-aliased content that needs to be aliased in bulk."
msgstr ""
"ទំព័រ <a "
"href=\":pathauto_bulk\">\"បង្កើតចំហៀងបែបច្រើន\"</a> "
"អនុញ្ញាតឱ្យអ្នកបង្កើតឈ្មោះ "
"URL "
"ជំនួសសម្រាប់ធាតុដែលពេលនេះមិនមានឈ្មោះជំនួសឡើយ។ "
"នេះជាការប្រើប្រាស់ធម្មតា "
"នៅពេលដំឡើង Pathauto "
"នៅលើគេហទំព័រដែលមានមាតិកាមិនទាន់មានឈ្មោះជំនួស "
"និងត្រូវការបង្កើតជាមាឌ។"

msgid "Delete Aliases"
msgstr "លុបឈ្មោះជំនួស"

msgid ""
"The <a href=\":pathauto_delete\">\"Delete Aliases\"</a> page allows "
"you to remove URL aliases from items that have previously been "
"assigned aliases using pathauto."
msgstr ""
"ទំព័រ <a "
"href=\":pathauto_delete\">\"លុបឈ្មោះអ្នកប្រើប្រាស់ជំនួស\"</a> "
"អនុញ្ញាតឱ្យអ្នកលុបទំព័រឈ្មោះអ្នកប្រើប្រាស់ជំនួសពីធាតុដែលបានចាត់តាំងឈ្មោះជំនួសដោយប្រើ "
"pathauto មុននេះ។"

msgid ""
"You need to select a pattern type, then a pattern and filter, and a "
"label. Additional types can be enabled on the <a "
"href=\":settings\">Settings</a> page."
msgstr ""
"អ្នកត្រូវតែជ្រើសរើសប្រភេទលំនាំ "
"បន្ទាប់មកជ្រើសរើសលំនាំ "
"និងតម្រង "
"ហើយបន្ទាប់មកជ្រើសរើសស្លាក។ "
"ប្រភេទបន្ថែមអាចត្រូវបានបើកដំណើរការនៅលើទំព័រ "
"<a href=\":settings\">ការកំណត់</a>។"

msgid "Enabled entity types"
msgstr "ប្រភេទអង្គភាពដែលបានបើកใช้งาน"

msgid ""
"Enable to add a path field and allow to define alias patterns for the "
"given type. Disabled types already define a path field themselves or "
"currently have a pattern."
msgstr ""
"អនុញ្ញាតឱ្យបន្ថែមវាលផ្លូវ "
"និងអនុញ្ញាតឱ្យកំណត់រាងឈ្មោះអាលីយ៉ាសសម្រាប់ប្រភេទដែលបានផ្តល់។ "
"ប្រភេទដែលបានដំណើរការ "
"អត់ត្រូវការបន្ថែមវាលផ្លូវឡើយ "
"ឬកំពុងមានរាងឈ្មោះរួចហើយ។"

msgid "Broken type"
msgstr "ប្រភេទខូច"

msgid "AliasType"
msgstr "ប្រភេទAlias"

msgid ""
"Bulk generation can be used to generate URL aliases for items that "
"currently have no aliases. This is typically used when installing "
"Pathauto on a site that has existing un-aliased content that needs to "
"be aliased in bulk."
msgstr ""
"ការបង្កើតជាច្រកពីរាជ្យអាចប្រើបានសម្រាប់បង្កើតនាមដៅ "
"URL "
"ជំនួសសម្រាប់ធាតុដែលពុំមាននាមដៅជំនួសទេ។ "
"វាត្រូវបានប្រើជាទូទៅពេលដំឡើងបណ្ដាញ "
"Pathauto "
"លើគេហទំព័រដែលមានមាតិកា​មិន​ទាន់​មាន​នាម​ដៅ​ជំនួស "
"ដែលត្រូវការបង្កើតនាមដៅជំនួសជាច្រកពីរាជ្យ។"

msgid ""
"It can also be used to regenerate URL aliases for items that have an "
"old alias and for which the Pathauto pattern has been changed."
msgstr ""
"វាក៏អាចប្រើបានដើម្បីបង្កើតអាសយដ្ឋាន "
"URL "
"ឡើងវិញសម្រាប់ធាតុដែលមានអាសយដ្ឋានចាស់ "
"ហើយសម្រាប់ដែលរាងនៃ Pathauto "
"ត្រូវបានផ្លាស់ប្តូរ។"

msgid ""
"Note that this will only affect items which are configured to have "
"their URL alias automatically set. Items whose URL alias is manually "
"set are not affected."
msgstr ""
"សូមចំណាំថាសកម្មភាពនេះនឹងមានผลប៉ះពាល់តែអំពីធាតុដែលបានកំណត់ឱ្យមានហៅ "
"URL ដោយស្វ័យប្រវត្តិ។ "
"ធាតុដែលមានហៅ URL "
"ដោយដៃមិនត្រូវបានប៉ះពាល់ឡើយ។"

msgid "The %element-title doesn't allow the patterns ending with whitespace."
msgstr ""
"%element-title "
"មិនអនុញ្ញាតឲ្យមានគំរូដែលបញ្ចប់ដោយចន្លោះទេ។"

msgid "Select the types of paths for which to generate URL aliases"
msgstr ""
"ជ្រើសប្រភេទផ្លូវសម្រាប់បង្កើតឈ្មោះ "
"URL ជំនួស"

msgid "Select which URL aliases to generate"
msgstr ""
"ជ្រើសរើសឈ្មោះ URL "
"ជំនួសដែលត្រូវបង្កើត"

msgid "Generate a URL alias for un-aliased paths only"
msgstr ""
"បង្កើតឈ្មោះចំណងជើង URL "
"សម្រាប់ផ្លូវដែលមិនមានឈ្មោះចំណងជើងតែប៉ុណ្ណោះ។"

msgid ""
"<a href=\":url\">Pathauto settings</a> are set to ignore paths which "
"already have a URL alias. You can only create URL aliases for paths "
"having none."
msgstr ""
"<a href=\":url\">ការកំណត់ Pathauto</a> "
"ត្រូវបានកំណត់ឲ្យរំលងផ្លូវដែលមានឈ្មោះ "
"URL ផ្សេងរួចហើយ។ "
"អ្នកអាចបង្កើតឈ្មោះ URL "
"សំរាប់ផ្លូវដែលមិនមានទេបានតែប៉ុណ្ណោះ។"

msgid "Update the URL alias for paths having an old URL alias"
msgstr ""
"ជំនួយផ្លូវ URL "
"សម្រាប់ផ្លូវដែលមានជំនួយផ្លូវ "
"URL ចាស់"

msgid "Regenerate URL aliases for all paths"
msgstr ""
"បង្កើតបំពេញពាក្យ URL "
"សម្រាប់ផ្លូវទាំងអស់ឡើងវិញ"

msgid "A short name to help you identify this pattern in the patterns list."
msgstr "ឈ្មោះខ្លីមួយដើម្បីជួយអ្នកកំណត់អត្តសញ្ញាណម៉ូតនេះក្នុងបញ្ជីម៉ូត។"

msgid "Only delete automatically generated aliases"
msgstr "លុបតែនៅឈ្មោះជំនួសដែលបានបង្កើតដោយស្វ័យប្រវត្តិเท่านั้น"

msgid ""
"When checked, aliases which have been manually set are not affected by "
"this mass-deletion."
msgstr ""
"នៅពេលបានសម្រួលហើយ, "
"អាសយដ្ឋានជំនួសដែលបានកំណត់ដោយដៃមិនបានរងផលប៉ះពាល់ពីការលុបចោលជាច្រើននេះទេ។"

msgid "Bulk deleting URL aliases"
msgstr ""
"លុបឈ្មោះរូបតំណភ្ជាប់ URL "
"ជាច្រើនក្នុងមួយដង"

msgid "All of your automatically generated path aliases have been deleted."
msgstr "ភ្លាមៗណែនាំផ្លូវដែលបានបង្កើតដោយស្វ័យប្រវត្តិរបស់អ្នកទាំងអស់ត្រូវបានលុបចោល។"

msgid ""
"All of your automatically generated %label path aliases have been "
"deleted."
msgstr ""
"បានលុបឲ្យហើយនូវឈ្មោះផ្លូវ "
"%label "
"គ្រាន់តែដែលបានបង្កើតដោយស្វ័យប្រវត្តិទាំងអស់របស់អ្នក។"

msgid "Tokens that are safe to use and do not need to be cleaned."
msgstr ""
"តូកែនដែលមានសុវត្ថិភាពក្នុងការប្រើ "
"និងមិនចាំបាច់ត្រូវបានសម្អាត។"

msgid "Safe tokens"
msgstr "សញ្ញាសុវត្ថិភាព"

msgid ""
"List of tokens that are safe to use in alias patterns and do not need "
"to be cleaned. For example urls, aliases, machine names. Separated "
"with a comma."
msgstr ""
"បញ្ជីនៃសញ្ញាណដែលមានសុវត្ថិភាពក្នុងការប្រើប្រាស់នៅក្នុងលំនាំអាលីអាស "
"ហើយមិនចាំបាច់ត្រូវបានសម្អាតឡើយ។ "
"ឧទាហរណ៍ URL, អាលីអាស, "
"ឈ្មោះម៉ាស៊ីន។ "
"បំបែកដោយសញ្ញាក្បៀស។"

msgid "Pattern %label saved."
msgstr ""
"គំរូ %label "
"ត្រូវបានរក្សាទុក។"

msgid "Duplicate Pathauto pattern"
msgstr "លំនាំ Pathauto ត្រូវបានចម្លង"

msgid "Choose the action to perform."
msgstr "ជ្រើសរើសសកម្មភាពដែលត្រូវអនុវត្ត។"

msgid ""
"Invalid action argument \"@invalid_action\". Please use one of: "
"@valid_actions"
msgstr ""
"អុចសិនឥតបានត្រឹមត្រូវ "
"\"@invalid_action\"។ "
"សូមប្រើមួយក្នុងចំណោម: "
"@valid_actions"

msgid ""
"Invalid type argument \"@invalid_types\". Please choose from the "
"following: @valid_types"
msgstr ""
"ប្រភេទអ аргументы \"@invalid_types\" "
"មិនបានចាត់ទុក។ "
"សូមជ្រើសពីដូចខាងក្រោម៖ "
"@valid_types"

msgid "Generate a URL alias for un-aliased paths only."
msgstr "បង្កើតឈ្មោះដែនជំនួសសម្រាប់ផ្លូវដែលគ្មានឈ្មោះជំនួសតែប៉ុណ្ណោះ។"

msgid "Update the URL alias for paths having an old URL alias."
msgstr ""
"អាប់ដែតឱ្យ URL alias "
"សម្រាប់ផ្លូវដែលមាន URL alias "
"ចាស់។"

msgid "Regenerate URL aliases for all paths."
msgstr ""
"បង្កើត​ឡើងវិញ​ឈ្មោះ​ជំនួស "
"URL សម្រាប់​ម៉ោង​ទាំងអស់។"

msgid "The name of the pattern's variable."
msgstr "ឈ្មោះអថេរនៃគំរូ។"

msgid "The value of the pattern's variable."
msgstr "តម្លៃនៃអថេររបស់លំនាំ។"

msgid ""
"The <strong>maximum alias length</strong> and <strong>maximum "
"component length</strong> values default to 100 and have a limit of "
"@max from Pathauto. You should enter a value that is the length of the "
"\"alias\" column of the path_alias database table minus the length of "
"any strings that might get added to the end of the URL. The "
"recommended and default value is 100."
msgstr ""
"តម្លៃ "
"<strong>ប្រវែងឈ្មោះលំនាំបំផុត</strong> "
"និង "
"<strong>ប្រវែងធាតុបំផុត</strong> "
"មានតម្លៃលំនាំដើមនៅ ១០០ "
"និងមានដែនកំណត់ @max ពី Pathauto។ "
"អ្នកគួរបញ្ចូលតម្លៃដែលស្មាតធ្វើការប្រវែងជួរឈរ "
"\"alias\" នៃតារាងទិន្នន័យ path_alias "
"បន្ថយដោយប្រវែងនៃខ្សែអក្សរណាមួយដែលអាចត្រូវបានបញ្ចូលទៅចុង "
"URL។ "
"តម្លៃដែលបានផ្ដល់អនុសាសន៍ "
"និងតម្លៃលំនាំដើមគឺ ១០០។"

msgid ""
"<strong>Note:</strong> there is no confirmation. Be sure of your "
"action before clicking the \"Delete aliases now!\" button.<br />You "
"may want to make a backup of the database and/or the path_alias and "
"path_alias_revision tables prior to using this feature."
msgstr ""
"<strong>សម្គាល់៖</strong> "
"មិនមានការបញ្ជាក់ទេ។ "
"សូមប្រាកដថាអ្នកពិតជាចង់ចុចប៊ូតុង "
"\"លុបឈ្មោះដំឡើងឥឡូវ!\" "
"មុនពេលចុច។<br "
"/>អ្នកប្រហែលជាចង់បង្កើតចម្លងស្តុកមួយសម្រាប់មូលដ្ឋានទិន្នន័យ "
"និង/ឬតារាង path_alias និង path_alias_revision "
"មុនការប្រើប្រាស់មុខងារនេះ។"

msgid "General settings"
msgstr "ការ​កំណត់​ទូទៅ"

msgid "Widget settings"
msgstr "ការកំណត់ widget"

msgid "reCAPTCHA"
msgstr "reCAPTCHA"

msgid "Secret key"
msgstr "កូនសោសម្ងាត់"

msgid "Defines which theme to use for reCAPTCHA."
msgstr ""
"កំណត់ថាតើប្រធានបែបណាដែលត្រូវប្រើសម្រាប់ "
"reCAPTCHA។"

msgid "Site key"
msgstr "ពាក្យកិច្ចសម្រាប់គេហទំព័រ"

msgid "@error"
msgstr "@បញ្ហា"

msgid "Image (default)"
msgstr "រូបភាព (លំនាំដើម)"

msgid "Administer the Google No CAPTCHA reCAPTCHA web service."
msgstr ""
"គ្រប់គ្រងសេវាបណ្ដាញ Google No "
"CAPTCHA reCAPTCHA។"

msgid "Administer reCAPTCHA"
msgstr "គ្រប់គ្រង reCAPTCHA"

msgid "Normal (default)"
msgstr "ធម្មតា (លំនಡ្ឋ)"

msgid "Light (default)"
msgstr "ស្រាល (លំនាំដើម)"

msgid "The type of CAPTCHA to serve."
msgstr "ប្រភេទ CAPTCHA ដែលត្រូវបម្រើ។"

msgid "Enable fallback for browsers with JavaScript disabled"
msgstr ""
"បើកដំណើរការជំនួសសម្រាប់កម្មវិធីរុករកដែលបិទ "
"JavaScript"

msgid ""
"If JavaScript is a requirement for your site, you should "
"<strong>not</strong> enable this feature. With this enabled, a "
"compatibility layer will be added to the captcha to support non-js "
"users."
msgstr ""
"ប្រសិនបើ JavaScript "
"គឺជាការទាមទារ​សម្រាប់​វេបសាយ​របស់អ្នក "
"អ្នកគួរតែ <strong>មិន</strong> "
"បើកមុខងារនេះ។ "
"ពេលបើកមុខងារនេះ "
"ប្រវែងសមត្ថភាពត្រូវបានបន្ថែមទៅលើ "
"captcha "
"ដើម្បីគាំទ្រ​អ្នកប្រើប្រាស់​ដែល​មិនប្រើ "
"js។"

msgid "The secret parameter is missing."
msgstr ""
"ប៉ារ៉ាម៉ែត្រ secret "
"នេះអន់បាត់។"

msgid "The secret parameter is invalid or malformed."
msgstr ""
"ប៉ារ៉ាម៉ែត្រសម្ងាត់មិនត្រឹមត្រូវ "
"ឬមានប៊ូងប៉ង។"

msgid "The response parameter is missing."
msgstr "ពាក្យប៉ារ៉ាម៉ែត្រឆ្លើយតបបាត់ខ្លួន។"

msgid "The response parameter is invalid or malformed."
msgstr ""
"ពារ៉ាម៉ែត្រឆ្លើយតបមិនត្រឹមត្រូវ "
"ឬមានរចនាសម្ព័ន្ធខុសប្លែក។"

msgid ""
"Protect your website from spam and abuse while letting real people "
"pass through with ease."
msgstr ""
"ការពារបណ្ដាញរបស់អ្នកពីស្ពាមនិងការប្រើប្រាស់ដោយមិនប្រក្រតី "
"ខណៈដែលអនុញ្ញាតឱ្យមនុស្សពិតៗឆ្លងកាត់បានយ៉ាងស្រួល។"

msgid "The json response is invalid or malformed."
msgstr ""
"ការឆ្លើយតប json "
"មិនត្រឹមត្រូវ "
"ឬមានទ្រង់ទ្រាយខ្វះខាត។"

msgid ""
"Google <a href=\":url\">reCAPTCHA</a> is a free service to protect "
"your website from spam and abuse. reCAPTCHA uses an advanced risk "
"analysis engine and adaptive CAPTCHAs to keep automated software from "
"engaging in abusive activities on your site. It does this while "
"letting your valid users pass through with ease."
msgstr ""
"Google <a href=\":url\">reCAPTCHA</a> "
"គឺជាសេវាឥតគិតថ្លៃសម្រាប់ការពារបណ្តាញរបស់អ្នកពីស្ពាមនិងការប្រើប្រាស់អាក្រក់។ "
"reCAPTCHA "
"ប្រើម៉ាស៊ីនវិភាគហានិភ័យកម្រិតខ្ពស់ "
"និង CAPTCHA ដូចបែបបត់បែន "
"ដើម្បីទប់ស្កាត់កម្មវិធីស្វ័យប្រវត្តិនៅក្នុងការធ្វើអ្វីដែលក្លែងក្លាយនៅលើគេហទំព័ររបស់អ្នក។ "
"វាបានធ្វើនេះខណៈដែលអនុញ្ញាតឲ្យអ្នកប្រើប្រាស់ដែលត្រឹមត្រូវឆ្លងកាត់បានយ៉ាងងាយស្រួល។"

msgid "Administer reCAPTCHA settings."
msgstr "គ្រប់គ្រងការកំណត់ reCAPTCHA។"

msgid "reCAPTCHA settings"
msgstr "ការកំណត់ reCAPTCHA"

msgid "The size of CAPTCHA to serve."
msgstr "ទំហំ CAPTCHA សម្រាប់បម្រើ។"

msgid "@info"
msgstr "@info"

msgid "Protects and defends"
msgstr "ការពារ និងការពារ"

msgid ""
"reCAPTCHA is built for security. Armed with state of the art "
"technology, it always stays at the forefront of spam and abuse "
"fighting trends. reCAPTCHA is on guard for you, so you can rest easy."
msgstr ""
"reCAPTCHA "
"ត្រូវបាន​បង្កើត​ឡើង​សម្រាប់​ការពារ​សុវត្ថិភាព។ "
"ដោយ​ផ្តោតលើ​បច្ចេកវិទ្យា​ថ្មី​ទាន់សម័យ "
"reCAPTCHA "
"កាន់តែ​រីកចម្រើន​នៅ​ជំពូក​ការ​ប្រយុទ្ធប្រឆាំង​នឹង​ស្បៀង "
"និង​ការប្រើប្រាស់​អាក្រក់។ "
"reCAPTCHA គឺ​កំពុង​តែ​រក្សា​ភ "
"amplifiedអោយ​អ្នក "
"ដូច្នេះ​អ្នក​អាច​សម្រាក​បាន​យ៉ាង​ស្ងប់​ស្ងាត់។"

msgid ""
"You will now find a reCAPTCHA tab in the CAPTCHA administration page "
"available at: Administration > Configuration > People > CAPTCHA module "
"settings > reCAPTCHA"
msgstr ""
"ឥឡូវនេះ អ្នកនឹងឃើញផ្ទាំង "
"reCAPTCHA "
"នៅក្នុងទំព័រគ្រប់គ្រង "
"CAPTCHA ដែលអាចប្រើបានតាមរយៈ៖ "
"Administration > Configuration > People > CAPTCHA module settings > "
"reCAPTCHA"

msgid ""
"Register your web site at <a "
"href=\":url\">https://www.google.com/recaptcha/admin/create</a>"
msgstr ""
"ចុះឈ្មោះវែបសាយរបស់អ្នក​នៅ "
"<a href=\":url\">https://www.google.com/recaptcha/admin/create</a>"

msgid "Input the site and private keys into the reCAPTCHA settings."
msgstr ""
"បញ្ចូលគន្លងវេបសាយ "
"និងគន្លងឯកជនទៅក្នុងការកំណត់ "
"reCAPTCHA។"

msgid ""
"Visit the Captcha administration page and set where you want the "
"reCAPTCHA form to be presented: Administration > Configuration > "
"People > CAPTCHA module settings"
msgstr ""
"ចូលទៅកាន់ទំព័រគ្រប់គ្រង "
"Captcha "
"ហើយកំណត់កន្លែងដែលអ្នកចង់បង្ហាញបែបបទ "
"reCAPTCHA៖ Administration > Configuration > People > CAPTCHA module "
"settings"

msgid "Local domain name validation"
msgstr "ផ្ទៀងផ្ទាត់ឈ្មោះដែនទឹកដី"

msgid ""
"Checks the hostname on your server when verifying a solution. Enable "
"this validation only, if <em>Verify the origin of reCAPTCHA "
"solutions</em> is unchecked for your key pair. Provides crucial "
"security by verifying requests come from one of your listed domains."
msgstr ""
"ពិនិត្យឈ្មោះម៉ាស៊ីននៅលើម៉ាស៊ីនបម្រើរបស់អ្នកពេលផ្ទៀងផ្ទាត់ដំណោះស្រាយ។ "
"បើកការត្រួតពិនិត្យនេះតែប៉ុណ្ណោះ "
"ប្រសិនបើ "
"<em>ពិនិត្យប្រភពដើមនៃដំណោះស្រាយ "
"reCAPTCHA</em> "
"មិនត្រូវបានធ្វើសំរាប់គូកូនសោរបស់អ្នក។ "
"ផ្តល់សុវត្ថិភាពសំខាន់ដោយផ្ទៀងផ្ទាត់ថា "
"ពាក្យស្នើរសុំមកពីដែនដែលអ្នកបានរាយបញ្ជូល។"

msgid "Expected action did not match."
msgstr "សកម្មភាពដែលបានរំពឹងមិនត្រូវគ្នា។"

msgid "Expected APK package name did not match."
msgstr ""
"ឈ្មោះកញ្ចប់ APK "
"ដែលរំពឹងទុកមិនត្រូវគ្នាទេ។"

msgid "Did not receive a 200 from the service."
msgstr "មិនទទួលបាន 200 ពីសេវាកម្ម។"

msgid "The request is invalid or malformed."
msgstr "សំណើនេះមិនត្រឹមត្រូវឬមានទំរង់ខុស។"

msgid "Challenge timeout."
msgstr "ពេលវេលាសម្រាលកំណត់បានផុត។"

msgid "Could not connect to service."
msgstr "មិនអាចភ្ជាប់ទៅសេវាកម្មបាន។"

msgid "Expected hostname did not match."
msgstr "ឈ្មោះម៉ាស៊ីនផ្សាយដែលរំពឹងទុកមិនត្រូវគ្នា។"

msgid "Score threshold not met."
msgstr "ប្រភេទពិន្ទុមិនទាន់បង្ហាញ។"

msgid "Not a success, but no error codes received!"
msgstr ""
"មិនជាការជោគជ័យទេ "
"ប៉ុន្តែមិនទទួលបានកូដកំហុសណាមួយឡើយ!"

msgid "The challenge response timed out or was already verified."
msgstr ""
"ការឆ្លើយតបនៃការប្រឈមបានផុតពេល "
"ឬត្រូវបានបញ្ចាក់រួចហើយ។"

msgid "Use reCAPTCHA globally"
msgstr "ប្រើ reCAPTCHA ទាំងពិភពលោក"

msgid ""
