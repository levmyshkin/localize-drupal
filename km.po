msgstr "ឆ្នាំបង្កើត"

msgid "Created month"
msgstr "បានបង្កើតខែ"

msgid "Created day"
msgstr "ថ្ងៃបង្កើត"

msgid "Created week"
msgstr "បានបង្កើតសប្តាហ៍"

msgid "Updated year + month"
msgstr ""
"ឆ្នាំ + ខែ "
"ដែលបានធ្វើបច្ចុប្បន្នភាព"

