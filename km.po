msgstr "ដោយ @owner នៅ @creation-datetime"

msgid "by @owner"
msgstr "ដោយ @owner"

msgid "on @creation-datetime"
msgstr "នៅលើ @creation-datetime"

msgid "Included %bundles"
msgstr "បានបញ្ចូល %bundles"

msgid "Single"
msgid_plural "Limited to @count"
msgstr[0] "តែមួយ"
msgstr[1] "កំណត់ទៅ @count"

msgid ""
"Updates entity links with <code>data-entity-type</code> and "
"<code>data-entity-uuid</code> attributes to point to the latest entity "
"URL aliases."
msgstr ""
"ធ្វើបច្ចុប្បន្នភាពតំណភ្ជាប់អង្គភាពជាមួយលក្ខណៈបញ្ជាក់ "
"<code>data-entity-type</code> និង <code>data-entity-uuid</code> "
"ដើម្បីបញ្ជាក់ទៅកាន់អាសយដ្ឋាន "
"URL "
"ផ្ទាល់អង្គភាពថ្មីបំផុត។"

msgid "Media with link target selection"
msgstr "មេឌៀជាមួយជម្រើសគោលដៅតំណភ្ជាប់"

msgid "Administrative sidebar"
msgstr "បន្ទាត់របស់កម្មវិធីរដ្ឋបាល"

msgctxt "Validation"
msgid "Validate mapping as a Collection"
msgstr "ផ្ទៀងផ្ទាត់ការផ្គូផ្គងជាគម្រប"

msgctxt "Validation"
msgid "Mark a field as optional in a Collection constraint"
msgstr ""
"កំណត់ថាលើសមួយជាជម្រើសក្នុងកំណត់ការ "
"Collection"

msgctxt "Validation"
msgid "Mark a field as required in a Collection constraint"
msgstr ""
"ធ្វើសម្ងាត់វាលមួយជាវាលត្រូវការ​ក្នុងការជាប់ខណ្ឌ "
"Collection"

msgctxt "Validation"
msgid "Serialized"
msgstr "បានធ្វើបញ្ជី"

msgid "This value should be a serialized object."
msgstr "តម្លៃនេះគួរតែជាវត្ថុដែលបានបំលែងជាស៊េរីយ៉ាល។"

msgid "This value should be a string, \"{type}\" given."
msgstr ""
"តម្លៃនេះគួរតែជាស្ទ្រីង, "
"បានផ្ដល់ \"{type}\"។"

msgid ""
"The phpinfo() function is disabled. See <a href=\":url\" "
"target=\"_blank\">PHP documentation</a>."
msgstr ""
"មុខងារ phpinfo() ត្រូវបានបិទ។ "
"សូមមើល <a href=\":url\" "
"target=\"_blank\">ឯកសារពី PHP</a>។"

msgid ""
"Display \"@display\" needs a selected search fields to work properly. "
"See the settings for the Entity Reference Revisions list format."
msgstr ""
"ការបង្ហាញ \"@display\" "
"ត្រូវការ​ទំព័រការស្វែងរកដែលបានជ្រើសរើស​ដើម្បីធ្វើការ​បានត្រឹមត្រូវ។ "
"សូមមើលការកំណត់សម្រាប់ទ្រង់ទ្រាយបញ្ជី "
"Entity Reference Revisions។"

msgid ""
"Display \"@display\" uses field %field as search field, but the field "
"is no longer present. See the settings for the Entity Reference "
"Revisions list format."
msgstr ""
"បង្ហាញ \"@display\" ប្រើវាល %field "
"ជាវាលស្វែងរក "
"ប៉ុន្តែវាលនោះមិនមានទៀតរួចហើយ។ "
"សូមមើលការកំណត់សម្រាប់ទ្រង់ទ្រាយបញ្ជី "
"Entity Reference Revisions។"

msgid "Entity Reference Revisions Source"
msgstr "ប្រភព​កំណែ​តំណ​ភ្ជាប់​អង្គភាព"

msgid ""
"Allow to access to the Entity Reference Revisions orphan deletion "
"form."
msgstr ""
"អនុញ្ញាតឱ្យចូលប្រើប្រាស់ទម្រង់លុបអត្តសញ្ញាណដែលគ្មានម្ចាស់នៅក្នុង "
"Entity Reference Revisions។"

msgid ""
"Checked @entity_type revisions for orphans: @current of @total in "
"@interval (@deletions deleted)"
msgstr ""
"បានពិនិត្យកំណែ @entity_type "
"សម្រាប់កូនកាត់សត្វក្រពើ៖ "
"@current ក្នុងចំនួនសរុប @total "
"នៅក្នុង @interval (@deletions "
"ត្រូវបានលុប)"

msgid ""
"Delete orphaned composite entities revisions that are no longer "
"referenced. If there are no revisions left, the entity will be deleted "
"as long as it is not used."
msgstr ""
"លុបការកែប្រែអង្គភាពសមាស "
"orphaned "
"ដែលមិនត្រូវបានយោងទៀត។ "
"ប្រសិនបើមិនមានការកែប្រែណាមួយនៅសល់ទេ "
"អង្គភាពនោះនឹងត្រូវលុប "
"បើវាមិនត្រូវបានប្រើជាមួយ។"

msgid "Select the entity types to check for orphans"
msgstr "ជ្រើសប្រភេទអង្គភាពដែលត្រូវពិនិត្យសម្រាប់ឬស្សីឯកត្តិ"

msgid "Entity Reference Revisions Orphan Purger"
msgstr "ការលុបអង្គភាពយោងកំណែបក្សានុពល"

msgid "Other (revisions)"
msgstr "ផ្សេងទៀត (កំណែ)"

msgid "Display the label of the referenced entity revisions."
msgstr "បង្ហាញស្លាកនៃការតំណាងស្រទាប់ពត៌មានដែលបានយោង។"

msgid "@entity_type (revisions)"
msgstr "@entity_type (កំណែរបច្ចុប្បន្ន)"

msgid ""
"If you want to use the Field Group accordion formatter, you will need "
"to install the <a href=\":link\" target=\"_blank\">jQuery UI "
"Accordion</a> module."
msgstr ""
"ប្រសិនបើអ្នកចង់ប្រើ formatter "
"ម្ចាស់ក្រុមវាល Field Group accordion "
"អ្នកត្រូវតែដំឡើងម៉ូឌុល <a "
"href=\":link\" target=\"_blank\">jQuery UI Accordion</a>។"

msgid ""
"Fieldgroup will, as the name implies, group fields together. All "
"fieldable entities will have the possibility to add groups to wrap "
"their fields together. Fieldgroup comes with default HTML wrappers "
"like vertical tabs, horizontal tabs, fieldsets or div wrappers."
msgstr ""
"Fieldgroup នឹងដូចជាឈ្មោះរបស់វា "
"ប្រមួយវាលជាមួយគ្នា។ "
"អង្គធាតុដែលអាចមានវាលទាំងអស់ "
"នឹងមានឱកាសបន្ថែមក្រុមដើម្បីបង្ហាប់វាលរបស់ពួកវាជាមួយគ្នា។ "
"Fieldgroup មកជាមួយនឹងប្រអប់ HTML "
"ដែលមានអត្រាដូចជា តាប.VERTICAL, "
"តាប.HORIZONTAL, fieldsets ឬ div wrappers។"

msgid ""
"The field group project is a follow-up on the field group module in <a "
"href=\"@link-cck\">CCK</a>. The release will only exist for Drupal 7 "
"release and higher, so since the existence of the Fields API in "
"core.</br>By moving field group to a separate module, this may open "
"some new perspectives."
msgstr ""
"គម្រោង field group "
"គឺជាការតាមដានបន្ទាប់ពីម៉ូឌុល "
"field group ក្នុង <a href=\"@link-cck\">CCK</a>។ "
"ការចេញផ្សាយនេះនឹងមានសម្រាប់ការចេញផ្សាយ "
"Drupal 7 "
"និងខ្ពស់ជាងនេះប៉ុណ្ណោះ "
"ដូច្នេះវាមានស្រាប់តាំងពីមាន "
"Fields API "
"ក្នុងគោលដៅ។</br>ដោយផ្ទេរប្រភេទ "
"field group ទៅម៉ូឌុលផ្សេង "
