msgstr ""
"…ពេល "
"<b>ការដាក់ស្នើត្រូវបានចាក់សោ</b>។"

msgid "Post data when <b>submission is completed</b>."
msgstr ""
"ផ្ញើទិន្នន័យពេល "
"<b>ការដាក់ស្នើបានបញ្ចប់</b>។"

msgid "Post data when <b>submission is updated</b>."
msgstr ""
"បញ្ជូនទិន្នន័យពេល "
"<b>ការដាក់ស្នើត្រូវបានធ្វើបច្ចុប្បន្នភាព</b>។"

msgid "Post data when <b>submission is deleted</b>."
msgstr ""
"បញ្ជូនទិន្នន័យពេល "
"<b>ការដាក់ស្នើត្រូវបានលុប</b>។"

msgid "draft created"
msgstr "សេចក្ដីព្រាងបានបង្កើត"

msgid "Post data when <b>draft is created.</b>"
msgstr ""
"ប៉ុស្ដិ៍ទិន្នន័យពេល "
"<b>សាច់ក្រដាសត្រូវបានបង្កើត។</b>"

msgid "draft updated"
msgstr "ការរៀបចំបានបន្ទាន់សម័យ"

msgid "Post data when <b>draft is updated.</b>"
msgstr ""
"ផ្ញើទិន្នន័យពេល "
