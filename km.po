msgstr ""
"ផ្តល់ជូន <a href=\":href\">Entity Print</a> (PDF) "
"សមាសភាពរួមបញ្ចូល "
"និងអនុញ្ញាតឱ្យអ្នកបង្កើតវេបសាយអាចទាញយកនាំចេញ "
"និងផ្ញើអ៊ីមែលច្បាប់ PDF "
"នៃការដាក់សំណើរពីវេបហ្វមបាន។"

msgid "Select the progress indicator displayed when Ajax is triggered."
msgstr ""
"ជ្រើសរើសសញ្ញាបង្ហាញវឌ្ឍនភាពដែលបង្ហាញនៅពេល "
"Ajax ត្រូវបានចាប់ផ្តើម។"

msgid "Select the effect displayed when Ajax is triggered."
msgstr ""
"ជ្រើសរើសប្រតិកម្មដែលបង្ហាញពេល "
"Ajax ត្រូវបានធ្វើហៅ។"

msgid "Select the effect speed."
msgstr "ជ្រើសរើសល្បឿនផលប៉ះពាល់។"

msgid "Repair and remove older Webform configuration files."
msgstr ""
"ជួសជុល "
"និងយកឯកសារ​កំណត់រចនាសម្ព័ន្ធ "
"Webform ចាស់ៗ​ចេញ។"

msgid "Repair webform submission storage schema"
msgstr ""
"ជួសជុលស្កីម៉ា "
"ស្តុកទុកការដាក់សំណើរបែបបទវែប"

msgid "Repair admin configuration"
msgstr "ជួសជុលការកំណត់រចនាសម្ព័ន្ធរបស់អ្នកគ្រប់គ្រង"

msgid "Repair webform settings"
msgstr "ជួសជុលការកំណត់ webform"

msgid "Repair webform handlers"
msgstr "ជួសជុលអ្នកដំណើរការពត៌មានបែបបទវែប"

msgid "Repair webform field storage definitions"
msgstr "ជួសជុលនិម្មិតស្តុកសម្រាប់ប្រអប់វែប<form>"

msgid "Remove webform submission translation settings"
msgstr "លុបការកំណត់បកប្រែការដាក់ស្នើវែបហ្វូម"

msgid "Using Pattern Trigger (Regex) in Webform Conditional Logic in Drupal 8"
msgstr ""
"ការប្រើប្រាស់ Pattern Trigger (Regex) "
"ក្នុងលក្ខខណ្ឌ​ទម្រង់វេបសាយ "
"(Webform Conditional Logic) នៅក្នុង Drupal 8"

msgid ""
"Using Pattern Trigger (Regex) in Webform Conditional Logic in Drupal 8 "
"| WebWash"
msgstr ""
"ប្រើប្រាស់ Pattern Trigger (Regex) "
"ក្នុងលូ កូដលក្ខខណ្ឌ Webform "
"ក្នុង Drupal 8 | WebWash"

msgid "Display confirmation when submission is updated"
msgstr "បង្ហាញការបញ្ជាក់ពេលការដាក់ស្នើត្រូវបានធ្វើបច្ចុប្បន្នភាព"

msgid "Webforms for Designers"
msgstr "សូម្បីសម្រាប់អ្នករចនា​វេបសាយ"

msgid ""
"This presentation introduces designers to the Webform module for "
"Drupal 8."
msgstr ""
"ការបង្ហាញនេះណែនាំឲ្យអ្នករចនាផ្គាប់ជាមួយម៉ូឌុល "
"Webform សម្រាប់ Drupal 8។"

msgid ""
"If checked this select confirmation type and message will be displayed "
"when the submission is updated. Otherwise, a status message will be "
"displayed at the top the page when a submission is updated."
msgstr ""
"បើបានជ្រើសប្រភេទការបញ្ជាក់ "
"និងសារនេះនឹងត្រូវបង្ហាញនៅពេលការដាក់ស្នើត្រូវបានធ្វើបច្ចុប្បន្នភាព។ "
"បើមិនដូច្នោះទាំងសារស្ថានៈនឹងត្រូវបង្ហាញនៅខាងលើទំព័រនៅពេលការដាក់ស្នើត្រូវបានធ្វើបច្ចុប្បន្នភាព។"

msgid "Help display"
msgstr "ជួយបង្ហាញ"

msgid "Before element"
msgstr "មុនធាតុ"

msgid "After element"
msgstr "បន្ទាប់​ពីធាតុ"

msgid "This is an example of a comment."
msgstr "នេះគឺជាឧទាហរណ៍នៃមតិមួយ។"

msgid "The below example uses a token to get the current node's title."
msgstr ""
"ឧទាហរណ៍ខាងក្រោមប្រើ token "
"មួយដើម្បីទទួលបានចំណងជើងនៃកំណត់ត្រាបច្ចុប្បន្ន។"

msgid ""
"The below example uses a token to get a field value from the current "
"node."
msgstr ""
"ឧទាហរណ៍ខាងក្រោមប្រើ token "
"ដើម្បីទទួលបានតម្លៃជួរដែនពី "
"node បច្ចុប្បន្ន។"

msgid "Source description display"
msgstr "បង្ហាញព័ត៌មានប្រែសម្រួលប្រភព"

msgid "Same as settings"
msgstr "ដូចគ្នាដូចការកំណត់"

msgid ""
"Please note, the source and destination element must be the same "
"element types."
msgstr ""
"សូមចំណាំថា "
"ធាតុប្រភពនិងធាតុគោលដៅ "
"ត្រូវតែជាប្រភេទធាតុដដែលគ្នា។"

msgid ""
"Determine how the destination element's state is toggled when 'Same "
"as' is checked"
msgstr ""
"កំណត់របៀបដែលស្ថានភាពធាតុគោលដៅត្រូវបានប្ដូរទៅវិញទៅមកនៅពេលដែលបានជ្រើសទ្រង់ទ្រាយ "
"'ដូចជា'"

msgid "The source and destination can not be the same element."
msgstr "ប្រភពនិងគោលដៅមិនអាចជាធាតុដូចគ្នានោះបានទេ។"

msgid ""
"The destination element (@destination) must be the same element type "
"(@type) as source element (@source)."
msgstr ""
"ធាតុគោលដៅ (@destination) "
"ត្រូវតែជាប្រភេទធាតុដូចគ្នា "
"(@type) ដូចធាតុម៉ួយ (@source)។"

msgid "Billing address is the same as the shipping address"
msgstr "អាសយដ្ឋានវិក្កយបត្រមានដូចគ្នានឹងអាសយដ្ឋានដឹកជញ្ជូន"

msgid "Provides a form element for syncing the value of two elements."
msgstr "ផ្ដល់ជាធាតុទម្រង់សម្រាប់សមមូលតម្លៃរវាងធាតុពីរមុខ។"

msgid "This email is sent to employees."
msgstr "អ៊ីមែលនេះត្រូវបានផ្ញើទៅនិយោជិក។"

msgid "Draft created URL"
msgstr ""
"URL "
"បានបង្កើតក្នុងរចនាសម្ព័ន្ធខាងមូល"

msgid "Draft created custom data"
msgstr "បង់សាច់ប៉ុនបង្កើតទិន្នន័យផ្ទាល់ខ្លួន"

msgid "Draft updated URL"
msgstr ""
"ឯកសាររៀបចំ URL "
"ដែលបានធ្វើបច្ចុប្បន្នភាព"

msgid "Draft updated custom data"
msgstr "សេចក្ដីព្រាងទិន្នន័យដែលបានប័ណ្ណបន្ទាន់"

msgid "Element key pattern"
msgstr "គំរូកូនសោធាតុ"

msgid "@expected values expected and only @found found."
msgstr ""
"@expected ត្រូវបានរំពឹងទុក "
"ហើយមានតែ @found "
"ត្រូវបានរកឃើញ។"

msgid "letters, numbers, and underscores"
msgstr "អក្សរ លេខ និងអញ្ញោះក្រោម"

msgid "letters, numbers, underscores, and dashes"
msgstr ""
"អក្សរព្រួញ ព្រះលេខ "
"អង់ដឺស្ករ "
"និងសញ្ញាក្សាន្ត"

msgid "A unique element key. Can only contain @requirements."
msgstr ""
"កកូដធាតុគ្រប់លក្ខណៈមួយដែលមានតែម្ដងតែប៉ុណ្ណោះ។ "
"អាចមានតែ @requirements ប៉ុណ្ណោះ។"

msgid "The element key name must contain only @requirements."
msgstr ""
"ឈ្មោះកូនសោធាតុត្រូវតែមានតែក្នុង "
"@requirements ប៉ុណ្ណោះ។"

msgid ""
"The element key %name on line @line_number must contain only "
"@requirement."
msgstr ""
"គោលដៅ %name នៅលើជួរ @line_number "
"ត្រូវតែមានតែ @requirement "
"ប៉ុណ្ណោះ។"

msgid "Webforms for Government"
msgstr "សំណុំបែបបទវេបសាយសម្រាប់រដ្ឋាភិបាល"

msgid ""
"This screencast will explore how governments can leverage the Webform "
"module for Drupal 8 to build accessible forms that securely collective "
"massive amounts of data."
msgstr ""
"ស្ពាន់នេះនឹងសិក្សាពីរបៀបដែលរដ្ឋាភិបាល "
"អាចប្រើម៉ូឌុល Webform សម្រាប់ "
"Drupal 8 "
"ដើម្បីបង្កើតបែបបទដែលអាចចូលដំណើរការ​បាន "
"និងប្រមូលទិន្នន័យបរិមាណធំបានយ៉ាងសុវត្ថិភាព។"

msgid ""
"Because the saving of submissions is disabled, the "
"<code>[webform_submission:values]</code> token will not be available "
"to the confirmation page's message."
msgstr ""
"ដោយសារតែការរក្សាទុកនៃការដាក់ស្នើត្រូវបានបិទ។ "
"<code>[webform_submission:values]</code> "
"ទំនាក់ទំនងនឹងមិនអាចប្រើបានសម្រាប់សារនៅលើទំព័របញ្ជាក់ទេ។"

msgid "The element key pattern is used to limit the format of element keys."
msgstr "គំរូគន្លងចម្បងធាតុត្រូវបានប្រើដើម្បីកំណត់ដែនកំណត់រចនាសម្ព័ន្ធនៃចម្បងធាតុ។"

msgid "File mime type"
msgstr "ប្រភេទ Mime របស់ឯកសារ"

msgid "File size (Bytes)"
msgstr "ទំហំព្រៃ (បៃ)"

msgid "File content (Base64)"
msgstr "មាតិកា​ឯកសារ (Base64)"

msgid ""
"%title can only hold @max values but there were @count uploaded. The "
"following files have been omitted as a result: %list."
msgstr ""
"%title អាចទទួលបានត្រឹម @max "
"តែមាន @count បានផ្ទុកឡើង។ "
"ឯកសារដូចខាងក្រោមត្រូវបានលុបចោលដោយសារតែ៖ "
"%list។"

msgid "…when <b>draft is created</b>."
msgstr ""
"…នៅពេល "
"<b>ខ្លឹមសារគ្រោងត្រូវបានបង្កើត</b>។"

msgid "…when <b>draft is updated</b>."
msgstr ""
"...ពេល "
"<b>ព្រាងត្រូវបានបច្ចុប្បន្នភាព</b>។"

msgid "…when anonymous <b>submission is converted</b> to authenticated."
msgstr ""
"…ពេលការដាក់ស្នើ "
"<b>ដោយមិនចុះឈ្មោះ</b> "
"ត្រូវបានបម្លែងទៅជាអ្នកភ្ជាប់សញ្ញាបត្រ។"

msgid "…when <b>submission is completed</b>."
msgstr ""
"…ពេល "
"<b>ការដាក់ស្នើបានបញ្ចប់</b>។"

msgid "…when <b>submission is updated</b>."
msgstr ""
"…ពេល "
"<b>ការដាក់ស្នើត្រូវបានធ្វើបច្ចុប្បន្នភាព</b>។"

msgid "…when <b>submission is deleted</b>."
msgstr ""
"…ពេលដែល "
