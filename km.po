"ដើម្បីបញ្ចេញធាតុផ្ទាល់ខ្លួន "
"សូមជំនួស '?' ជា…"

msgid "Source element"
msgstr "ធាតុប្រភព"

msgid "Destination element"
msgstr "ធាតុ​គោលដៅ"

msgid "Destination state"
msgstr "រដ្ឋគោលដៅ"

msgid "Same as…"
msgstr "ដូចជា…"

msgid "Draft created"
msgstr "អ្នកបានបង្កើតព្រាងឯកសារ"

msgid "Draft updated"
msgstr "ព្រាងបានផ្លាស់ប្តូរថ្មី"

msgid "lowercase letters, numbers, and underscores"
msgstr ""
"អក្សរតូច លេខ "
"និងរោគខ្ទង់ក្រោម"

msgid ""
"Please note: Automatically generated element keys are lowercased "
"letters, numbers, and underscores"
msgstr ""
"សូមកត់សម្គាល់៖ "
"កូនសោធាតុដែលបង្កើតឡើងដោយស្វ័យប្រវត្តិគឺជាអក្សរតូច "
"លេខ និងស្នាមបន្ទាត់ក្រោម"

msgid "Lowercase letters, numbers, and underscores. (i.e. element_key)"
msgstr ""
"អក្សរតូច ខ្ទង់លេខ "
"និងខ្សែរខាងក្រោម។ (ឧ. element_key)"

msgid "Letters, numbers, and underscores. (i.e. element_KEY)"
msgstr ""
"អក្សរ លេខ និង "
"aកសណ្ឋានក្រោម (underscore)។ (ឧ. "
"element_KEY)"

msgid "Letters, numbers, underscores, and dashes. (i.e. element-KEY)"
msgstr ""
"អក្សរ លេខ ខ្សែអន្ទ្រី "
"និងសញ្ញា​ខ្ទង់។ (ឧ. element-KEY)"

msgid "Use Taxonomy Terms as Webform Options in Drupal 8"
msgstr ""
"ប្រើពាក្យបញ្ចូលពន្ធដារ "
"(Taxonomy Terms) ជាជម្រើស Webform ក្នុង "
"Drupal 8"

msgid ""
"Learn how to create a select element which uses a taxonomy vocabulary "
"instead of the standard options."
msgstr ""
"សូមរៀនពីរបៀបបង្កើតធាតុជ្រើសរើសមួយ "
"ដែលប្រើវាក្យសព្ទវិញ្ញាសារបន្សំជំនាន់ជំនួសជាជម្រើសស្តង់ដារ។"

msgid "Use Taxonomy Terms as Webform Options in Drupal 8 | WebWash"
msgstr ""
"ប្រើពាក្យសកម្មវិធីវេបសាយជា "
"ជម្រើស Webform ក្នុង Drupal 8 | WebWash"

msgid "Use Ajax for all webforms"
msgstr ""
"ប្រើ Ajax "
"សម្រាប់ទម្រង់វេបសាយគ្រប់ចំណុច"

msgid "Truncate webform submission tables."
msgstr "កាត់តារាងដាក់ស្នើរ Webform។"

msgid "Information message"
msgstr "សារ​ព័ត៌មាន"

msgid "Webform Entity Print (PDF) Attachment"
msgstr "ភ្ជាប់ទម្រង់ Webform Entity Print (PDF)"

msgid "Options limit"
msgstr "ជម្រើសដាក់កំណត់"

msgid ""
"The <strong>Options</strong> page displays a summary of the webform's "
"options limits."
msgstr ""
"ទំព័រ <strong>ជម្រើស</strong> "
"បង្ហាញសង្ខេបពីការកំណត់ជម្រើសរបស់ទម្រង់វេប។"

msgid ""
"Allows elements with options (i.e. select, checkboxes, and radios) to "
"have option specific submission limits."
msgstr ""
"អនុញ្ញាតឱ្យធាតុដែលមានជំរើស "
"(ឧ. ជម្រើស, ប្រអប់សម្រុក, "
"និងប៊ិចប៊ុក) "
"មានកំណត់ការដាក់ស្នើជាក់លាក់សម្រាប់ជម្រើសនីមួយៗ។"

msgid "Limit reached message"
msgstr "សារ​ចាប់ទៅដល់ដែនកំណត់"

msgid "Limit reached behavior"
msgstr "អាកប្បកិរិយាកម្មពេលឈានដល់កំណត់"

msgid "@title (@type)"
msgstr "@title (@type)"

msgid "'@element_key' is missing."
msgstr "'@element_key' គឺអត់មាន។"

msgid "@title @type limits"
msgstr "@title @type កំណត់"

msgid "Do not display a message"
msgstr "កុំបង្ហាញសារ"

msgid "Placeholder help"
msgstr "ជំនួយទីតាំង​ចន្លោះ"

msgid "The following placeholders can be used:"
msgstr "អាចប្រើកន្លែងដាក់ឈ្មោះបង្ហាប់ខាងក្រោមបានៈ"

msgid "@name - The element's title."
msgstr ""
"@name - "
"សេចក្ដីចំណងជើងរបស់ធាតុ។"

msgid "Tee shirts in @label are no longer available."
msgstr ""
"អាវយឺតនៅក្នុង @label "
"ឥឡូវនេះមិនមានទៀត​ហើយ។"

msgid ""
"The file's name exceeds the Webform module's 150 characters limit. "
"Please rename the file and try again."
msgstr ""
"ឈ្មោះឯកសារលើសកំណត់ 150 "
"តួអក្សររបស់ម៉ូឌុល Webform។ "
"សូមប្ដូរឈ្មោះឯកសារនេះហើយសាកល្បងម្តងទៀត។"

msgid "Webform: Experimental modules enabled"
msgstr ""
"Webform: "
"ម៉ូឌុលប្រកួតប្រជែងបានបើកដំណើរការ"

msgid ""
"Experimental webform modules found: %module_list. <a "
"href=\":url\">Experimental modules</a> are provided for testing "
"purposes only. Use at your own risk."
msgstr ""
"បានរកឃើញម៉ូឌុលបែបតេស្ត "
"webform: %module_list ។ <a "
"href=\":url\">ម៉ូឌុលបែបតេស្ត</a> "
"ត្រូវបានផ្តល់ឱ្យសម្រាប់គោលបំណងសាកល្បងប៉ុណ្ណោះ។ "
"ប្រើប្រាស់ដោយខ្លួនឯងមានសារពើភ័ណ្ឌ។"

msgid "Option value attribute names"
msgstr "ឈ្មោះលក្ខណៈអថេរតម្លៃជម្រើស"

msgid "Allow SVG to be filled using CSS"
msgstr ""
"អនុញ្ញាតឲ្យ SVG "
"ត្រូវបានបំពេញដោយប្រើ CSS"

msgid "Enable SVG panning and zooming"
msgstr ""
"បើកការបញ្ជូននិងបង្ហាញរូបភាព "
"SVG"

msgid "Display text and description in a tooltip"
msgstr ""
"បង្ហាញអត្ថបទ "
"និងការពិពណ៌នានៅក្នុងឧបករណ៍បង្ហាញព័ត៌មាន "
"Tooltip"

msgid "Affect any elements which use these custom options"
msgstr "ប៉ះពាល់ដល់ធាតុណាមួយដែលប្រើជម្រើសផ្ទាល់ខ្លួន这些នេះ"

msgid "Duplicate '@label' custom options"
msgstr ""
"ជ្រើសរើសប្តូរ '@label' "
"ដែលចម្លងពីជំនាញផ្ទាល់ខ្លួន"

msgid ""
"A brief description present to the user when adding this element to a "
"webform."
msgstr "ការពិពណ៌នាសង្ខេបដែលបង្ហាញទៅអ្នកប្រើនៅពេលបន្ថែមធាតុនេះទៅក្នុងទម្រង់បណ្តាញ។"

msgid ""
"Instructions to present to the user below this element on the editing "
"form."
msgstr "សេចក្ដីណែនាំសម្រាប់បង្ហាញទៅអ្នកប្រើនៅខាងក្រោមធាតុនេះនៅលើទំរង់កែសម្រួល។"

msgid "HTML/SVG file URL or path"
msgstr "URL ឬផ្លូវឯកសារ HTML/SVG"

msgid "Allow SVG option elements to be filled using CSS"
msgstr ""
"អនុញ្ញាតឲ្យធាតុជម្រើស SVG "
"ត្រូវបានបំពេញដោយប្រើ CSS"

msgid "If checked, inline fill styles will be removed and replaced using CSS."
msgstr ""
"ប្រសិនបើបានប្រាប់មក "
"ពណ៌បញ្ចូលក្នុងជួរដេកនឹងត្រូវបានដកចេញ "
"ហើយប្ដូរជាមួយ CSS។"

msgid "CSS/JS"
msgstr "CSS/JS"

msgid ""
"Below options are used to enhance and also translate the custom "
"options parsed from the HTML/SVG markup."
msgstr ""
"ជម្រើសខាងក្រោមត្រូវបានប្រើសម្រាប់បង្កើននិងបកប្រែជម្រើសផ្ទាល់ខ្លួនដែលបានបញ្ចូលពីកូដ "
"HTML/SVG។"

msgid "Option descriptions are displayed by tooltips."
msgstr "ការពិពណ៌នាអំពីជម្រើសត្រូវបានបង្ហាញតាមរយៈស្លាកឧបករណ៍។"

msgid "Display option text and description in a tooltip"
msgstr ""
"បង្ហាញអត្ថបទជម្រើស "
"និងការពិពណ៌នារបស់វា "
"ក្នុងប្រអប់ព័ត៌មាន(toolip)"

msgid ""
"If checked, option text and description will be displayed using a "
"tooltip."
msgstr ""
"បើបានត្រួតពិនិត្យ "
"អត្ថបទជម្រើស "
"និងការពិពណ៌នាពីជម្រើសនឹងត្រូវបង្ហាញជាមួយ "
"tooltip។"

msgid ""
"If checked, this custom options element will be available when a user "
"is adding elements to a webform."
msgstr ""
"បើបានធ្វើត្រួតពិនិត្យ "
"មុខមាត់ជម្រើសផ្ទាល់ខ្លួននេះនឹងអាចប្រើបាននៅពេលអ្នកប្រើកំពុងបញ្ចូលធាតុនៅក្នុងទម្រង់បណ្តាញ។"

msgid ""
"If checked, this custom options element will be available for entity "
"references when a user is adding elements to a webform."
msgstr ""
"ប្រសិនបើបានសម្គាល់ "
"ជម្រើសប្ដូរផ្ទាល់ខ្លួននេះនឹងមានស្រាប់សម្រាប់ការដាក់យោងអង្គភាពនៅពេលអ្នកប្រើបញ្ចូលធាតុទៅកាន់បែបបទបណ្ដាញ។"

msgid "Filter by title, description, help, template, or url"
msgstr ""
"តម្រៀបតាមចំណងជើង, ពណ៌នា, "
"ជំនួយ, លំអរគំរូ, ឬ url"

msgid ""
"Below options are used to enhance and also translate the custom "
"options."
msgstr "ជម្រើសខាងក្រោមត្រូវបានប្រើសម្រាប់បង្កើននិងផ្លាស់ប្ដូរជម្រើសប្ដូរតាមតម្រូវការ។"

msgid "The screencast walks through creating custom webform options elements."
msgstr "វីដេអូម៉ោងនេះដឹកនាំការបង្កើតធាតុជម្រើសវែបហ្វូមដែលប្ដូរតាមតម្រូវការ។"

msgid "View (token) URL"
msgstr "មើល URL (token)"

msgid ""
"The URL that can used to view the webform submission. The webform must "
"be configured to allow users to view a submission using a secure "
"token."
msgstr ""
"URL "
"ដែលអាចប្រើដើម្បីមើលការដាក់សំណុំបែបបទវែប។ "
"បែបបទវែបត្រូវតែបានកំណត់ឲ្យអនុញ្ញាតឱ្យអ្នកប្រើមើលការដាក់សំណុំដោយប្រើសញ្ញាសុវត្ថិភាព។"

msgid "Update (token) URL"
msgstr "បន្ទាន់សម័យ URL (token)"

msgid ""
"Omit the '?' to output all values. Output all values as HTML using "
"[webform_submission:values:html]."
msgstr ""
"បង្ហើប​តំលៃ​ទាំងអស់ដោយ​មិន​មាន​សញ្ញា "
"'?'។ បង្ហាញ​តំលៃ​ទាំងអស់ជា "
"HTML ដោយប្រើ [webform_submission:values:html]។"

msgid "Allow viewing a submission using token"
msgstr ""
"អនុញ្ញាតឲ្យមើលការដាក់ស្នើដោយប្រើ "
"token"

msgid "Allow updating a submission using token"
msgstr ""
"អនុញ្ញាតឱ្យធ្វើបច្ចុប្បន្នភាពការដាក់ស្នើដោយប្រើ "
"token"

msgid "Limit per source entity"
msgstr "ក្ដាប់សម្រាប់អត្ថាធិប្បាយប្រភពមួយៗ"

msgid "The Title of the source entity or webform."
msgstr ""
"ចំណងជើងរបស់អង្គភាពប្រភព "
"ឬបែបបទគេហទំព័រ។"

msgid "All users, custom email addresses, and administrators"
msgstr ""
"អ្នកប្រើប្រាស់ទាំងអស់ "
"អាសយដ្ឋានអ៊ីមែលប្ដូរតាមកំណត់ "
"និងអ្នកគ្រប់គ្រង"

msgid "Edit webform variants"
msgstr "កែសម្រួលជំនាន់វេបហ្វូម"

msgid "Allows administrators to create variations of a webform."
msgstr "អនុញ្ញាតឱ្យអ្នកគ្រប់គ្រងបង្កើតបំរែបំរួលនៃវែបមួយ។"

msgid "Webforms: Variants configuration"
msgstr ""
"Webforms: "
"ការកំណត់រចនាប័ទ្មផ្សេងៗ"

msgid "Select a variant"
msgstr "ជ្រើសរើសជម្រើសមួយ"

msgid "Add webform variant"
msgstr "បន្ថែមវែបហ្វមប្រភេទផ្សេងៗ"

msgid "Edit webform variant"
msgstr "កែសម្រួលវេរូបមន្តបែបផ្សេងៗ"

msgid "Duplicate webform variant"
msgstr "ចម្លងមួយចំនួននៃវេបហ្វូម"

msgid "Delete webform variant"
msgstr "លុប​ប្រភេទ​បែបបទ​បណ្ដាញ"

msgid "Apply webform variant"
msgstr "អនុវត្ត​បែបបទ​វេបសាយ​ជាប្រភេទ​បញ្ឈរ"

msgid "View webform variants"
msgstr "មើលជម្រើសវែបហ្គោម"

msgid "Test webform variants"
msgstr "បែបផ្សេងៗនៃវេទិកាបញ្ជូលទិន្នន័យលើវេបសាយ"

msgid "Webform plugins: Variants"
msgstr ""
"កម្មវិធីបន្ថែម Webform: "
"ជម្រើសផ្សេងៗ"

msgid "Webform variants"
msgstr "ជំរើស Webform"

msgid "Variant plugin ID"
msgstr "អត្តសញ្ញាណផ្លាស់ប្តូរប្លុក"

msgid "Variant instance ID"
msgstr "អត្តសញ្ញាណវ៉ារីអង់ទីثចោល"

msgid "Variant element key"
msgstr "កូនសោធាតុកំណែ"

msgid "Variants settings"
msgstr "ការកំណត់វ៉ារីយង់"

msgid "Filter category"
msgstr "ចម្រាញ់ប្រភេទ"

msgid "Filter state"
msgstr "ស្ថានភាពចម្រាញ់"

msgid "Excluded webform variants"
msgstr "ប្រភេទបែបបទគេហទំព័រដែលមិនរាប់បញ្ចូល"

msgid "Webform Variant Example"
msgstr "ឧទាហរណ៍​បែបផ្សេង​នៃ Webform"

msgid "Provides an example of webform variants."
msgstr "ផ្ដល់ឧទាហរណ៍នៃវេរីយ៉ង់នៃវែបហ្វូម។"

msgid ""
"If checked, variant information will be displayed onscreen to all "
"users."
msgstr ""
"បើបានសម្គាល់ ប្រវត្តVariant "
"នឹងត្រូវបង្ហាញលើអេក្រង់ដល់អ្នកប្រើប្រាស់ទូទៅ។"

msgid "Example of a webform variant."
msgstr "ឧទាហរណ៍នៃបម្លែងវែបហ្វូមមួយ។"

msgid "Webform [DEPRECATED]"
msgstr "Webform [មិនប្រើប្រាស់ទៀត]"

msgid ""
"Enter webform information and then click submit, which will redirect "
"you to the appropriate create content form."
msgstr ""
"បញ្ចូលព័ត៌មានទម្រង់បណ្ដាញ "
"ហើយបន្ទាប់មកចុចបញ្ជូន "
"ដែលនឹងបញ្ជូនអ្នកទៅទម្រង់បង្កើតមាតិកាសមរម្យ។"

msgid "Delete all related variants"
msgstr "លុបបំភ្លឺចេញពីអ្វីដែលទាក់ទងទាំងអស់"

msgid "View variants"
msgstr "មើលភាពផ្លាស់ប្តូរ"

msgid "Test variants"
msgstr "បំរើសំណាកា"

msgid "Apply variants"
msgstr "អនុវត្តជម្រើសផ្សេងៗ"

msgid "There are currently no variants setup for this webform."
msgstr "ឥឡូវនេះមិនមានវេរីយ៉ង់ណាមួយត្រូវបានរៀបចំសម្រាប់ទំរង់វេបនេះទេ។"

msgid ""
"This screencast provides an overview of how to use webform variants to "
"create A/B tests, audience segmentation, and personalization."
msgstr ""
"ស្គ្រីនកាសនេះផ្តល់នូវទិដ្ឋភាពទូទៅអំពីរបៀបប្រើប្រាស់វេបហ្វូមវេរ្យាន់ដើម្បីបង្កើតការធ្វើតេស្ត "
"A/B ការបែងចែកទស្សនិកជន "
"និងការផ្ទៀងផ្ទាត់ការប្រើប្រាស់ផ្ទាល់ខ្លួន។"

msgid ""
"Webform module now supports variants, which can be used for A/B tests, "
"segmentation, and personalization"
msgstr ""
"ម៉ូឌុល Webform "
"ឥឡូវនេះគាំទ្រការបម្លែង "
"ដែលអាចប្រើសម្រាប់ការធ្វើតេស្ត "
"A/B ការបំបែកជាគម្ពី "
"និងការប្ដូរតាមបុគ្គលិកលក្ខណៈ"

msgid "Configuration: Variants"
msgstr ""
"កំណត់រចនាសម្ព័ន្ធ៖ "
"ប្រភេទនៃការប្រែប្រួល"

msgid ""
"The <strong>Variants configuration</strong> page allows administrators "
"to enable/disable variants."
msgstr ""
"ទំព័រ "
"<strong>ការកំណត់បម្លែង</strong> "
"អនុញ្ញាតឱ្យអ្នកគ្រប់គ្រងបើក/បិទបម្លែងបាន។"

msgid ""
"<strong>Variants</strong> are used for A/B testing, segmentation, and "
"personalization."
msgstr ""
"<strong>Variants</strong> "
"ត្រូវបានប្រើសម្រាប់ការធ្វើតេស្ត "
"A/B, ការបែងចែក "
"និងការផ្ទេរពីភាពផ្ទាល់ខ្លួន។"

msgid "Plugins: Variants"
msgstr ""
"ប្លុកអភិវឌ្ឍន៍: "
"ប្រភេទផ្សេងៗ"

msgid ""
"The <strong>Variants</strong> page allows variations of a webform to "
"be created and managed for A/B testing, segmentation, and "
"personalization."
msgstr ""
"ទំព័រ <strong>Variants</strong> "
"អនុញ្ញាតឱ្យបង្កើត "
"និងគ្រប់គ្រងការប្រែប្រួលនៃបែបបទវែបសម្រាប់ការធ្វើតេស្ត "
"A/B, ការបែងចែកវិសាលភាព "
"និងការផ្ទាល់ខ្លួន។"

msgid "@total variants"
msgstr "@ចំនួនតម្លៃបន្ថែម"

msgid "variants"
msgstr "វ៉ារីយ៉ង់ (variants)"

msgid "No variant available."
msgstr "គ្មានវ៉ារ្យង់ដែលអាចប្រើបាន។"

msgid "Enter @none to hide this message."
msgstr "វាយ @none ដើម្បីលាក់សារ​នេះ។"

msgid "Apply variants?"
msgstr "អនុវត្តវ៉ារីយ៉ង់?"

msgid "Delete the selected variants"
msgstr "លុបបំរែបំរួលដែលបានជ្រើស"

msgid "Delete all variants"
msgstr "លុបរាល់ប្រភេទបំបែក"

msgid "Do not delete any variants"
msgstr "កុំលុបបំលែងណាមួយទាំងអស់"

msgid "Please select variants to be applied to the webform."
msgstr "សូមជ្រើសរើសខ្លឹមសារប្រភេទដែលត្រូវអនុវត្តទៅលើបណ្តាញផ្សាយទ្រង។"

msgid "The selected webform variants have been applied and deleted."
msgstr ""
"វែបហ្វូមដែលបានជ្រើសរើសត្រូវបានអនុវត្ត "
"និងលុបចោលទៅហើយ។"

msgid "The webform variant %title has been applied and deleted."
msgstr ""
"បម្លែងវែបហ្វម %title "
"ត្រូវបានអនុវត្តន៍ហើយបានលុបចោល។"

msgid ""
"The selected webform variants have been applied and all variants have "
"been deleted."
msgstr "វ៉ារីយ៉ង់ទំរង់បែបបទត្រូវបានជ្រើសរើសបានអនុវត្តហើយវ៉ារីយ៉ង់ទាំងអស់ត្រូវបានលុបចោល។"

msgid ""
"The webform variant %title has been applied and all variants have been "
"deleted."
msgstr ""
"វែបហ្វូមបរិយាយ %title "
"ត្រូវបានអនុវត្ត "
"ហើយបរិយាយទាំងអស់ត្រូវបានលុបចោល។"

msgid "The selected webform variants have been applied."
msgstr "កំណែវែបហ្វর্মដែលបានជ្រើសរើសត្រូវបានអនុវត្ត។"

msgid "The webform variant %title has been applied."
msgstr ""
"ប្លង់វេបសាយ %title "
"ត្រូវបានអនុវត្ត។"

msgid "The webform variant %name has been deleted."
msgstr ""
"វាចំណែកវេបហ្វូម %name "
"ត្រូវបានលុបចោល។"

msgid "Edit @label variant"
msgstr ""
"កែសម្រួលចំណុចបច្ចេកទេស "
"@label"

msgid "The webform variant was successfully added."
msgstr "វ៉េរីយ៉ង់វែបហ្វូមត្រូវបានបន្ថែមជោគជ័យ។"

msgid "The webform variant was successfully updated."
msgstr ""
"ការផ្លាស់ប្តូររូបបែប webform "
"ត្រូវបានបន្ថែមយ៉ាងជោគជ័យ។"

msgid ""
"Select variants and then click submit, which will redirect you to the "
"@operation form."
msgstr ""
"ជ្រើសរើសជម្រើសបំលែង "
"ហើយបន្ទាប់មកចុចបញ្ជូន "
"ដែលនឹងបញ្ជូនអ្នកទៅកាន់ទម្រង់ "
"@operation។"

msgid "Filter webforms default category"
msgstr "ចម្រាស់ប្រភេទលំនាំដើមរបស់បែបបទវែប"

msgid ""
"Select the filter webforms default category selected on the <a "
"href=\":href\">webform overview page</a>."
msgstr ""
"ជ្រើសរើសប្រភេទលំនាំដើមសម្រាប់កាលវិភាគលំអរូបបទដែលបានជ្រើសនៅលើ "
"<a "
"href=\":href\">ទំព័រមើលទូទៅនៃវេបហ្វូម</a>។"

msgid "Filter webforms default state"
msgstr "ស្រុតស្វែងរកស្ថានភាពដើមរបស់វែបហ្វូម"

msgid ""
"Select the filter webforms default state selected on the <a "
"href=\":href\">webform overview page</a>."
msgstr ""
"ជ្រើសរើសស្ថានភាពលំនាំដើមនៃការតម្រឹមវ៉េបផមស្តេតដែលបានជ្រើសនៅលើ "
"<a "
"href=\":href\">ទំព័រប្រវត្តិសង្ខេបវ៉េបផម</a>។"

msgid "Form URL path settings"
msgstr ""
"ការកំណត់ផ្លូវ URL "
"របស់បែបបទ"

msgid "Select available variants"
msgstr "ជ្រើសរើសវ៉ារ្យង់ដែលមានស្រាប់"

msgid "All excluded variants must be manually removed from existing webforms."
msgstr "គ្រប់បរិយារូបមន្តដែលមិនរួមបញ្ចូលត្រូវតែដកចេញដោយដៃពីវេបហ្វូរមដែលមានស្រាប់។"

msgid "Allow element to be populated using query string parameters."
msgstr ""
"អនុញ្ញាតឱ្យធាតុត្រូវបានបំពេញដោយប្រើប៉ារ៉ាម៉ែត្រ "
"query string។"

msgid ""
"Note that the CAPTCHA module disables page caching of pages that "
"include a CAPTCHA challenge."
msgstr ""
"សូមចំណាំថា ម៉ូឌុល CAPTCHA "
"បានបិទការកែតម្រូវផ្ទុកទំព័រដែលមានកំណត់ "
"CAPTCHA។"

msgid ""
"This is used after a submission has been saved and finalized to the "
"database."
msgstr ""
"នេះត្រូវបានប្រើបន្ទាប់ពីការដាក់សុំត្រូវបានរក្សាទុក "
"និងបញ្ចប់ទៅក្នុងមូលដ្ឋានទិន្នន័យ។"

msgid "Provides a form element for enabling and tracking webform variants."
msgstr "ផ្តល់ជំហ៊ែបែបបទសម្រាប់បើកហើយតាមដានវែបហ្វូមវ៉ា្យរីយ៉ង់។"

msgid ""
"<strong>ATTENTION DEVELOPERS!!!</strong> Please make sure to download "
"and update the <a href=\":href\">Input Mask</a> library to version "
"5.0.x"
msgstr ""
"<strong>ជូនដំណឹងទៅដល់អ្នកអភិវឌ្ឍន៍!!!</strong> "
"សូមប្រាកដថាអ្នកបានទាញយកនិងធ្វើការអាប់ដេត "
"<a href=\":href\">បណ្ណាល័យ Input Mask</a> "
"ទៅកំណែ 5.0.x"

msgid ""
"<a href=\":href\">Learn more about updating the Webform module's "
"external libraries</a>"
msgstr ""
"<a "
"href=\":href\">ស្វែងយល់បន្ថែមអំពីការអាប់ដេតបណ្ណាល័យខាងក្រៅរបស់ម៉ូឌុល "
"Webform</a>"

msgid ""
"Learn more about <a "
"href=\"https://www.drupal.org/docs/8/api/form-api\">Form API in Drupal "
"8</a>."
msgstr ""
"សូមរៀនបន្ថែមអំពី <a "
"href=\"https://www.drupal.org/docs/8/api/form-api\">Form API "
"ក្នុង Drupal 8</a>។"

msgid "Do not schedule email if the action should be triggered in the past"
msgstr ""
"កុំកំណត់ពេលវេលាសម្រាប់អ៊ីមែល "
"ប្រសិនបើសកម្មភាពគួរត្រូវបានបញ្ចេញនៅកន្លងមក"

