msgstr "បណ្តោយទៅ @entity_type_label"

msgid "Provide a view link to the @entity_type_label."
msgstr ""
"ផ្តល់ជាការភ្ជាប់មើលទៅកាន់ "
"@entity_type_label។"

msgid "Link to edit @entity_type_label"
