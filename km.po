msgstr "រក្សាទុក + បន្ថែមធាតុ"

msgid "Webform access controls"
msgstr ""
"ការត្រួតពិនិត្យការចូលប្រើ "
"Webform"

msgid "Access Control | Tag1 Consulting"
msgstr ""
"ការគ្រប់គ្រងការចូលប្រើ | "
"Tag1 Consulting"

msgid "Opening webforms in modal dialogs"
msgstr "បើកបែបបទវែបនៅក្នុងប្រអប់ការពិភាក្សាជាគ្រាប់ចុច"

msgid "This screencast shows how to open webforms in modal dialogs."
msgstr ""
"ការថតវីដេអូនេះបង្ហាញពីរបៀបបើកសំណុំបែបបទវេបក្នុងប្រអប់បង្ហាញ "
"modal។"

msgid "Creating a modal in Drupal 8 | Befused"
msgstr "បង្កើត modal នៅក្នុង Drupal 8 | Befused"

msgid "Display forms in a modal dialog with Drupal 8 | Agaric"
msgstr ""
"បង្ហាញបែបបទក្នុងប្រអប់មូដាល់ជាមួយ "
"Drupal 8 | Agaric"

msgid "Webform views integration"
msgstr "ការរួមបញ្ចូល Webform views"

msgid "D8 Webform and Webform Views Integration @ Drupalcamp Colorado"
msgstr ""
"D8 Webform និងការរួមបញ្ចូល Webform Views "
"@ Drupalcamp Colorado"

msgid "RateIt is used to provide a customizable rating element."
msgstr ""
"RateIt "
"ត្រូវបានប្រើសម្រាប់ផ្ដល់ធាតុការវាយតម្លៃដែលអាចកែប្រែបាន។"

msgid "more submission views"
msgstr "មើលការដាក់ស្នើបន្ថែម"

msgid ""
"A webform submission embed display. The selected view should also "
"include contextual filters. "
"{webform_id}/{source_entity_type}/{source_entity_id}/{account_id}/{in_draft}"
msgstr ""
"ការបង្ហាញការបញ្ចូលសំណុំបែបបទវេប។ "
"សមីការដែលបានជ្រើសរើសគួរតែរួមបញ្ចូលការណិតតម្រុយផងដែរ។ "
"{webform_id}/{source_entity_type}/{source_entity_id}/{account_id}/{in_draft}"

msgid ""
"The name to be displayed in the URL when there are multiple submission "
"views available."
msgstr ""
"ឈ្មោះដែលត្រូវបង្ហាញនៅក្នុង "
"URL "
"នៅពេលមានទិដ្ឋភាពស្នើសុំច្រើន។"

msgid ""
"The title to be display in the dropdown menu when there are multiple "
"submission views available."
msgstr "ចំណងជើងដែលត្រូវបង្ហាញនៅក្នុងម៉ឺនុយចុចចុះពេលមានទិដ្ឋភាពការដាក់សំណើជាច្រើន។"

msgid "Replace the global results with submission views"
msgstr ""
"បម្លែងលទ្ធផលសកលជា views "
"ការដាក់ស្នើ"

msgid "Replace the webform results with submission views"
msgstr "ប្ដូរព័ត៌មានលទ្ធផលទម្រង់បែបបទក្នុងគេហទំព័រជាមួយមើលការដាក់ស្នើ"

msgid "Replace the node results with submission views"
msgstr ""
"ជំនួសលទ្ធផល node ជាមួយ views "
"ការបញ្ជូន"

msgid ""
"Only 'Inline', 'Message', 'Modal', and 'None' confirmation types are "
"fully supported by Ajax."
msgstr ""
"តែប្រភេទការបញ្ជាក់ 'Inline', "
"'Message', 'Modal', និង 'None' "
"តែប៉ុណ្ណោះបញ្ជាក់បានគ្រប់លក្ខណៈដោយ "
"Ajax។"

msgid "When a user is denied access to this webform"
msgstr "នៅពេលដែលអ្នកប្រើប្រាស់ត្រូវបានបដិសេធការចូលប្រើវែ​ប្ថតបារ៉មនេះ"

msgid "Login (Redirects to user login form and displays message)"
msgstr ""
"ចូល(Login) "
"(បញ្ជូនបែបបទចូលអ្នកប្រើ "
"និងបង្ហាញសារ)"

msgid ""
"Will be displayed either in-line or as a status message depending on "
"the setting above."
msgstr ""
"សារនឹងត្រូវបង្ហាញ either "
"នៅក្នុង​បន្ទាត់ឬ​ជា​សារស្ថានភាព​អាស្រ័យលើ​ការ​កំណត់​ខាងលើ។"

msgid "Access denied message attributes"
msgstr "គុណលក្ខណៈសារបដិសេធការចូលប្រើ"

msgid ""
"For example, appending "
"<code>?source_entity_type=node&source_entity_id=1</code> to a "
"webform's URL would set a submission's 'Submitted to' value to "
"'node:1'."
msgstr ""
"ឧទាហរណ៍ ការបញ្ចូល "
"<code>?source_entity_type=node&source_entity_id=1</code> "
"ចូលទៅកាន់ URL របស់បែបបទវេប "
"(webform) នឹងកំណត់តម្លៃ 'Submitted to' "
"របស់ការដាក់ស្នើជា 'node:1'។"

msgid ""
"You can also append "
"<code>?source_entity_type=ENTITY_TYPE&amp;source_entity_id=ENTITY_ID</code> "
"and the <code>ENTITY_TYPE</code> and <code>ENTITY_ID</code> parameters "
"will automatically be replaced based on the current page's source "
"entity."
msgstr ""
"អ្នកអាចបន្ថែម "
"<code>?source_entity_type=ENTITY_TYPE&amp;source_entity_id=ENTITY_ID</code> "
"ហើយប៉ារ៉ាម៉ែត្រ <code>ENTITY_TYPE</code> "
"និង <code>ENTITY_ID</code> "
"នឹងត្រូវបានជំនួសដោយស្វ័យប្រវត្តិដោយផ្អែកលើសកលវិទ្យាសាស្រ្តប្រភពនៃទំព័របច្ចុប្បន្ន។"

msgid "When a user is denied access to a submission"
msgstr "នៅពេលដែលអ្នកប្រើប្រាស់ត្រូវបានបដិសេធការចូលប្រើទៅកាន់ការដាក់ស្នើមួយ"

msgid "Page (Displays message when access is denied to a submission)"
msgstr ""
"ទំព័រ "
"(បង្ហាញសារ​នៅពេលបានរឹតបន្ទាប់ការចូលដល់ការដាក់ស្នើ)"

msgid ""
"To expose your webform elements to your webform submission views. "
"Please install the <a href=\":href\">Webform Views Integration</a> "
"module."
msgstr ""
"ដើម្បីបង្ហាញធាតុទំរង់បែបបទវែបរបស់អ្នកទៅកាន់មើលការដាក់ស្នើរទំរង់បែបបទវែបរបស់អ្នក "
"សូមដំឡើងម៉ូឌុល <a href=\":href\">Webform "
"Views Integration</a>។"

msgid "Create new submission view"
msgstr "បង្កើតទិដ្ឋភាពការបញ្ជាក់ថ្មី"

msgid ""
"If checked, help text will be removed from every webform page and "
"form."
msgstr ""
"ប្រសិនបើបានពិនិត្យ "
"សំនួរជំនួយនឹងត្រូវយកចេញពីទំព័រផ្ទាល់ខ្លួន "
"និងទម្រង់គ្រប់ទំព័រ។"

msgid ""
"Files uploaded via the CKEditor file dialog to webform elements, "
"settings, and configuration will not be exportable."
msgstr ""
"ឯកសារដែលបានផ្ទុកឡើងតាមរយៈប្រអប់ឆាតឯកសារ "
"CKEditor ទៅឯកតាវេបហ្វូម "
"ការកំណត់ "
"និងការកំណត់រចនាសម្ព័ន្ធ "
"នឹងមិនអាចនាំចេញបាន។"

msgid ""
"It is recommended to use the <a href=\":href\">IMCE module</a> to "
"manage webform elements, settings, and configuration files."
msgstr ""
"គួរតែប្រើ <a href=\":href\">ម៉ូឌុល "
"IMCE</a> ដើម្បីគ្រប់គ្រងធាតុ "
"webform ការកំណត់ "
"និងឯកសារកំណត់រចនាសម្ព័ន្ធ។"

msgid "Randomize elements"
msgstr "ច្របល់ធាតុ"

