msgstr ""
"តម្លៃផ្ទាល់ខ្លួនរបស់រាងកាយ "
"(Twig)"

msgid ""
"All of the below webform settings can be overridden but overriding "
"certain settings can trigger unexpected results."
msgstr ""
"ការកំណត់វេបហ្វូមទាំងអស់ខាងក្រោម "
"អាចត្រូវបានតម្រង់បាន "
"ប៉ុន្តែការតម្រង់កំណត់ខ្លះៗអាចបណ្តាលឲ្យមានលទ្ធផលដែលមិនរំពឹងទុក។"

msgid "every @increment years"
msgstr "រៀងរាល់ @increment ឆ្នាំ"

msgid "Lock selected submission configuration"
msgstr "ចាក់សោការកំណត់ការដាក់ស្នើដែលបានជ្រើស"

msgid "Unlock selected submission configuration"
msgstr "ដំណើរការការកំណត់ការផ្ញើដែលបានជ្រើស"

msgid "Display required indicator"
msgstr "បង្ហាញសញ្ញាត្រូវការ"

msgid "Submission locked message"
msgstr "សារ​បិទ​ការដាក់ស្នើ"

msgid "A flag that indicates a locked webform submission."
msgstr "បដិវេទនាដែលបង្ហាញថាការដាក់ស្នើវែបម៉ូភម์ត្រូវបានចាក់សោ។"

msgid "You have successfully installed the Webform module."
msgstr ""
"អ្នកបានតំឡើងម៉ូឌុល Webform "
"បានជោគជ័យ។"

msgid ""
"Learn more about the <a href=\":about_href\">Webform module and "
"Drupal</a>"
msgstr ""
"សូមរៀនបន្ថែមពី <a "
"href=\":about_href\">ម៉ូឌុល Webform និង Drupal</a>"

msgid "Locked [@total]"
msgstr "ចាក់សោររួច [@total]"

msgid "Unlocked [@total]"
msgstr "បានបើក [@total]"

msgid "Lock this submission"
msgstr "ចាក់សោលើការដាក់ស្នើនេះ"

msgid "If checked, users will not be able to update this submission."
msgstr ""
"ប្រសិនបើបានពិនិត្យហើយ "
"អ្នកប្រើប្រាស់នឹងមិនអាចធ្វើបច្ចុប្បន្នភាពការដាក់ស្នើនេះទេ។"

msgid "@title (@id): Found element validation errors."
