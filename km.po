"Webform"

msgid "Allow users to view a submission using a secure token"
msgstr "អនុញ្ញាតឲ្យអ្នកប្រើមើលការដាក់ស្នើបានដោយប្រើសញ្ញាសុវត្ថិភាព"

msgid ""
"If checked users will be able to view a submission using the webform "
"submission's URL appended with the submission's (secure) token."
msgstr ""
"បើបានធ្វើសម្គាល់ "
"អ្នកប្រើប្រាស់នឹងអាចមើលការដាក់ស្នើបានដោយប្រើ "
"URL នៃការដាក់ស្នើវេបហ្វម "
"ជាមួយនឹងទ្រក់ស្លាក (token) "
"ដែលមានសុវត្ថិភាពរបស់ការដាក់ស្នើនោះ។"

msgid "Submission View"
msgstr "មើលការដាក់ស្នើ"

msgid "Recipient user roles"
msgstr "តួនាទីអ្នកប្រើដែលទទួលបាន"

msgid ""
"Select user roles that can be assigned to receive a webform's email. "
"<em>Please note: Selected user roles will be available to all "
"webforms.</em>"
msgstr ""
"ជ្រើសរើសតួនាទីអ្នកប្រើដែលអាចត្រូវផ្ដល់អ៊ីមែលនៃវែបហ្វមមួយ។ "
"<em>សូមចំណាំ៖ "
"តួនាទីអ្នកប្រើដែលបានជ្រើសរើសនឹងអាចប្រើបាននៅក្នុងវែបហ្វមទាំងអស់។</em>"

msgid ""
"Please note: You can select which <strong>user roles</strong> are "
"available to receive webform emails by going to the Webform module's "
"<a href=\":href\">admin settings</a> form."
msgstr ""
"សូមបញ្ជាក់៖ "
"អ្នកអាចជ្រើសរើស "
"<strong>តួនាទីអ្នកប្រើ</strong> "
"ដែលអាចទទួលអ៊ីមែលវេបភូមិនេះបានដោយចូលទៅកាន់ទម្រង់ "
"<a "
"href=\":href\">ការកំណត់ជាមគ្គុទេសក៍របស់ "
"Webform module</a>។"

msgid "The current (last submitted) wizard page of the webform submission."
msgstr ""
"ទំព័រវីសាដ៍បច្ចុប្បន្ន "
"(ដែលបានស្មារតីចុងក្រោយ) "
"នៃការដាក់ស្នើវែបផតฟូម។"

msgid ""
"The current (last submitted) wizard page title of the webform "
"submission."
msgstr ""
"ចំណងជើងទំព័រអ្នកជំនួយមួយដែលបានដាក់សម្គាល់ចុងក្រោយនៃការដាក់សំណើរ "
"webform នៅពេលនេះ។"

msgid "Exclude file attachments"
msgstr "ដកហូតឯកសារភ្ជាប់"

msgid "Notes element types"
msgstr "ប្រភេទធាតុកំណត់ត្រា"

msgid "Notes element type"
msgstr "ប្រភេទធាតុកំណត់សម្គាល់"

msgid "Notes element type:"
msgstr "ប្រភេទធាតុតំណាងសំគាល់៖"

msgid "Webform jQueryUI Buttons"
msgstr "ប៊ូតុង Webform jQueryUI"

msgid ""
"Provides a group of multiple buttons used for selecting a value. "
"jQueryUI is no longer maintained."
msgstr ""
"ផ្តល់ជាក្រុមប៊ូតុងច្រើនដែលប្រើសម្រាប់ជ្រើសរើសតម្លៃមួយ។ "
"jQueryUI "
"មិនទាន់មានការថែទាំទៀតហើយ។"

msgid ""
"The %key element can not be removed because the %title webform has "
"related <a href=\":href\">variants</a>."
msgstr ""
"ធាតុ %key "
"មិនអាចលុបចោលបានព្រោះសំណុំបែបបទវែប "
"%title មាន <a "
"href=\":href\">ជម្រើសផ្សេងៗ</a> "
"ដែលទាក់ទងជាប់។"

msgid "Title / Notes"
msgstr "ចំណងជើង / កំណត់សម្គាល់"

msgid "Save variants"
msgstr "រក្សាទុកប្រភេទផ្សេងៗ"

msgid "Webform %label variant saved."
msgstr ""
"ការបម្លែង Webform %label "
"បានរក្សាទុក។"

msgid "This @label variant was @op."
msgstr ""
"វ៉ារីអង់ @label នេះត្រូវបាន "
"@op។"

msgid "Webform @label variant saved."
msgstr ""
"ផ្លាស់ប្តូរ Webform @label "
"បានរក្សាទុក។"

msgid "Personalized Webforms"
msgstr "សំណុំ​បែបបទ​បណ្ដាញ​ផ្ទាល់​ខ្លួន"

msgid ""
"The <strong>Variant plugins</strong> overview page lists all available "
"webform variant plugins."
msgstr ""
"ទំព័រ <strong>Variant plugins</strong> សង្ខេប "
"បង្ហាញបញ្ជីបច្ចេកវិទ្យា "
"variant plugins សម្រាប់ webform "
"ដែលមានទាំងអស់។"

msgid "Filter by variant name"
msgstr "តម្រាញ់តាមឈ្មោះវ៉ារ្យង់"

msgid "Enter @none or @none_translated to hide this message."
msgstr ""
"បញ្ចូល @none ឬ @none_translated "
"ដើម្បីលាក់សារ​នេះ។"

msgid "Add @label variant"
msgstr "បន្ថែមអថេរលេខ @label"

msgid "Apply variant?"
msgstr "អនុវត្តប្រភេទ?"

msgid "Apply the selected variants to the %webform webform?"
msgstr ""
"អនុវត្តជម្រើសដែលបានជ្រើសទៅលើទំព័របែបបទ "
"%webform?"

msgid "Apply variant to the %webform webform?"
msgstr ""
"អនុវត្តប្លែកទៅលើទម្រង់ "
"%webform ឬ?"

msgid "Are you sure you want to apply the %title variant?"
msgstr ""
"តើអ្នកប្រាកដហើយឬថាចង់អនុវត្តប្រភេទ "
"%title?"

msgid "Are you sure you want to apply the selected variants?"
msgstr "តើអ្នកប្រាកដជាចង់អនុវត្តជម្រើសដែលបានជ្រើសរើសទេ?"

msgid ""
"Replace existing settings, elements, and handler with selected "
"variants."
msgstr ""
"ជំនុំជម្រះការកំណត់, ធាតុ, "
"និងអ្នកដំណើរការដែលមានស្រាប់ "
"ជាមួយជម្រើសដែលបានជ្រើស។"

msgid "Replace existing settings, elements, and handler with this variant."
msgstr ""
"ជំនួសការកំណត់ របស់មាន "
"សមាសភា "
"និងអ្នកដំណើរការជាមួយជម្រើសនេះ។"

msgid "After selected variants are applied…"
msgstr "បន្ទាប់ពីបានអនុវត្តខ្លឹមសារ​ជ្រើសរើស..."

msgid "After this variant is applied…"
msgstr "បន្ទាប់ពីដាក់ប្រើប្រាស់ការប្រែចិត្តនេះ…"

msgid "Delete the '@title' variant?"
msgstr "លុបប្រភេទ '@title' ឬ?"

msgid "Delete the %title variant from the %webform webform?"
msgstr ""
"លុបបម្លែង %title "
"ចេញពីព្រមទំព័រ %webform?"

msgid "Are you sure you want to delete the %title variant?"
msgstr ""
"តើអ្នកពិតជាចង់លុបបម្រែបម្រួល "
"%title មែនទេ?"

msgid "Remove this variant"
msgstr "ជំរុញការលុបបំប្លែងនេះ"

msgid "Duplicate @label variant"
msgstr "ចម្លងអថេរប្រភេទ @label"

msgid "Form overview settings"
msgstr "ការកំណត់ទិដ្ឋភាពរបស់ទម្រង់"

msgid "Form Ajax settings"
msgstr "ការកំណត់ Ajax សម្រាប់បែបបទ"

msgid ""
"You need to be assigned <a href=\"@href\">Edit webform variants</a> "
"permission to be able create and manage variants."
msgstr ""
"អ្នកត្រូវការត្រូវបានផ្ដល់សិទ្ធិ "
"<a "
"href=\"@href\">កែប្រែវឌ្ឍនកម្មវែបហ្វូម</a> "
"ដើម្បីអាចបង្កើត "
"និងគ្រប់គ្រងវឌ្ឍនកម្មបាន។"

msgid ""
"Users need to be assigned <a href=\"@href\">Edit webform variants</a> "
"permission to be able create and manage variants."
msgstr ""
"អ្នកប្រើគួរត្រូវបានផ្ដល់សិទ្ធិ "
"<a "
"href=\"@href\">កែសម្រួលវ៉ារីអង់ត៍របស់វែបហ្វូម</a> "
"ដើម្បីអាចបង្កើត "
"និងគ្រប់គ្រងវ៉ារីអង់ត៍បាន។"

msgid ""
"To limit the minimum date to the submission date use the "
"<code>[webform_submission:created:html_date]</code> token."
msgstr ""
"ដើម្បីកំណត់កាលបរិច្ឆេទតិចបំផុតទៅកាលបរិច្ឆេទសំណល់ "
"សូមប្រើតំណរ "
"<code>[webform_submission:created:html_date]</code>។"

msgid ""
"To limit the maximum date to the submission date use the "
"<code>[webform_submission:created:html_date]</code> token."
msgstr ""
"ដើម្បីកំណត់កាលបរិច្ឆេទអតិបរមាជាកាលបរិច្ឆេទសម្រង់ "
"អ្នកត្រូវប្រើតុកិន "
"<code>[webform_submission:created:html_date]</code>។"

msgid ""
"To limit the minimum date/time to the submission date/time use the "
"<code>[webform_submission:created:html_datetime]</code> token."
msgstr ""
"ដើម្បីកំណត់កាលបរិច្ឆេទ/ពេលវេលាដ៏ទាបបំផុតជាកាលបរិច្ឆេទ/ពេលវេលាដែលបញ្ជូនសំណុំបែបបទ "
"សូមប្រើសញ្ញា "
"<code>[webform_submission:created:html_datetime]</code>។"

msgid ""
"To limit the maximum date/time to the submission date/time use the "
"<code>[webform_submission:created:html_datetime]</code> token."
msgstr ""
"ដើម្បីកំណត់កាលបរិច្ឆេទ/ម៉ោងអតិបរមា "
"ទៅកាលបរិច្ឆេទ/ម៉ោងដាក់ស្នើ "
"សូមប្រើស្លាក "
"<code>[webform_submission:created:html_datetime]</code>។"

msgid ""
"View displays with exposed filters are not supported because exposed "
"filters nest a &lt;form&gt; within a &lt;form&gt; and this breaks the "
"webform."
msgstr ""
"ការបង្ហាញ View "
"ដែលមានស្វ័យត្រួតពិនិត្យចេញមិនគាំទ្រ "
"ដោយសារតែស្វ័យត្រួតពិនិត្យចេញបញ្ចូល&lt;form&gt;មួយនៅក្នុង&lt;form&gt;មួយទៀត "
"ហើយនេះធ្វើឲ្យ webform "
"បែកផ្ទុក។"

msgid ""
"Only users who can 'Administer views' or 'Edit webform source code' "
"can update the view name, display id, and arguments."
msgstr ""
"មានតែអ្នកប្រើដែលអាច "
"'គ្រប់គ្រងពិព័រណ៍' ឬ "
"'កែសម្រួលកូដប្រភពវេបហ្វូម' "
"เท่านั้นដែលអាចធ្វើបច្ចុប្បន្នភាពឈ្មោះពិព័រណ៍, "
"លេខសម្គាល់បង្ហាញ, "
"និងអាគុយម៉ង់ត៍បាន។"

msgid "View display %display_id does not exist."
msgstr ""
"មើលការបង្ហាញ %display_id "
"មិនមានទេ។"

msgid ""
"View display %display_id has exposed filters which will break the "
"webform."
msgstr ""
"បង្ហាញទិដ្ឋភាព %display_id "
"មានម៉ាស៊ីនចម្រាញ់បង្ហាញដែលនឹងបំបែកបែបបទវេទិកា។"

msgid ""
"Provides a view embed element. Only users who can 'Administer views' "
"or 'Edit webform source code' can create and update this element."
msgstr ""
"ផ្ដល់ជាធាតុបញ្ចូលទិដ្ឋភាពមួយ។ "
"មានតែអ្នកប្រើដែលអាច "
"'គ្រប់គ្រងទិដ្ឋភាព' ឬ "
"'កែសម្រួលកូដប្រភពវេបហ្វូម' "
"ទើបអាចបង្កើតនិងធ្វើបច្ចុប្បន្នភាពធាតុនេះបាន។"

msgid ""
"After clicking 'Save', the 'Variants' manage tab will be displayed. "
"Use the 'Variants' manage tab to add and remove variants."
msgstr ""
"បន្ទាប់ពីចុច 'រក្សាទុក' "
"តារាងគ្រប់គ្រង 'បម្លែង' "
"នឹងត្រូវបង្ហាញ។ "
"ប្រើតារាងគ្រប់គ្រង "
"'បម្លែង' "
"ដើម្បីបន្ថែមនិងលុបបម្លែង។"

msgid ""
"Add and remove variants using the <a href=\"@href\">Variants</a> "
"manage tab."
msgstr ""
"បន្ថែម "
"និងលុបប្រភេទផ្សេងៗដោយប្រើផ្ទាំងគ្រប់គ្រង "
"<a href=\"@href\">Variants</a> ។"

msgid "Select the variant type to be displayed on the 'Variants' manage tab."
msgstr ""
"ជ្រើសរើសប្រភេទនៃវេរីយ៉ង់ដែលត្រូវបង្ហាញនៅលើផ្ទាំងគ្រប់គ្រង "
"'Variants'។"

msgid "This variant is currently in-use. The variant type cannot be changed."
msgstr ""
"វ៉ារីយ៉ង់នេះកំពុងត្រូវបានប្រើប្រាស់។ "
"ប្រភេទវ៉ារីយ៉ង់មិនអាចផ្លាស់ប្តូរបានទេ។"

msgid "Prepopulate this variant"
msgstr "បំពេញទ្រង់ទ្រាយនេះជាមុន"

msgid "Randomly load variant"
msgstr "ផ្ទុកជម្រើសបំភ្លេចៗ"

msgid ""
"Randomly redirects to the webform with the variant populated using "
"query string parameter. This element's default value/data will be "
"ignored."
msgstr ""
"ប្តូរទីតាំងដោយចៃដន្យទៅកាន់វេបភ័ស្ត្រដែលមានជម្រើសបំពេញដោយប៉ារ៉ាម៉ែត្រ "
"query string។ "
