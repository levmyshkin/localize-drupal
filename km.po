msgstr "សូមបញ្ចូលអត្ថបទមួយ។"

msgid ""
"<strong>Warning:</strong> Opening %type files with spreadsheet "
"applications may expose you to <a href=\":injection_href\">formula "
"injection</a> or other security vulnerabilities. When the submissions "
"contain data from untrusted users and the downloaded file will be used "
"with Microsoft Excel, use the <a href=\":excel_href\">Webform XLSX "
"export</a> module."
msgstr ""
"<strong>ការព្រមាន៖</strong> "
"ការបើកឯកសារ %type "
"ជាមួយកម្មវិធីតារាងហោងអាចធ្វើឲ្យអ្នកអាចប្រឈមមុខនឹង "
"<a "
"href=\":injection_href\">ការបញ្ចូលរូបមន្តកូដ</a> "
"ឬច្របល់សុវត្ថិភាពផ្សេងៗ។ "
"នៅពេលដែលការដាក់ស្នើមានទិន្នន័យពីអ្នកប្រើដែលមិនទុកចិត្ត "
"និងឯកសារដោនឡोडនឹងត្រូវបានប្រើជាមួយ "
"Microsoft Excel សូមប្រើម៉ូឌុល <a "
"href=\":excel_href\">Webform XLSX export</a>។"

msgctxt "module"
msgid "Webform"
msgstr "Webform"

msgid "Default confirmation robots noindex"
msgstr ""
"ខ្នាញ់បញ្ជាក់លំនាំដើម robots "
"noindex"

msgid ""
"If checked, a meta tag robots noindex directive  will be added to the "
"confirmation page of all webforms."
msgstr ""
"ប្រសិនបើបានពិនិត្យ "
"បញ្ជាគោល noindex "
"របស់ម៉ែតាតැ็ก robots "
"នឹងត្រូវបន្ថែមទៅនៅទំព័របញ្ចាក់នៃបែបបទវេបសាយទាំងអស់។"

msgid "Webform submissions can only be unlocked programmatically."
msgstr ""
"ការដាក់ស្នើរលើ Webform "
"អាចត្រូវបានបើកចំហតែតាមកម្មវិធីប៉ុណ្ណោះ។"

msgid ""
"An error occurred while trying to validate the submission. Please save "
"your work and reload this page."
msgstr ""
"មានកំហុសកើតឡើងខណៈព្យាយាមផ្ទៀងផ្ទាត់ការដាក់ស្នើ។ "
"សូមរក្សាទុកការងាររបស់អ្នកហើយផ្ទុកទំព័រនេះឡើងវិញ។"

msgid "@label (Users, custom email addresses, Administrators)"
msgstr ""
"@label (អ្នកប្រើ, "
"អាសយដ្ឋានអ៊ីមែលផ្ទាល់ខ្លួន, "
"អ្នកគ្រប់គ្រង)"

msgid ""
"If you enjoy and value Drupal and the Webform module consider <a "
"href=\":href_involved\">getting involved in the Drupal community</a>, "
"<a href=\":href_join\">joining the Drupal Association</a>, and <a "
"href=\":href_opencollective\">contributing funds to the Webform "
"module's Open Collective</a>."
msgstr ""
"បើអ្នករីករាយ "
"និងមានតម្លៃចំពោះ Drupal "
"និងមូឌុល Webform សូមពិចារណា <a "
"href=\":href_involved\">ចូលរួមក្នុងសហគមន៍ "
"Drupal</a>, <a "
"href=\":href_join\">ចូលរួមក្នុងសមាគម "
"Drupal</a>, និង <a "
"href=\":href_opencollective\">ចូលរួមឥណទានផ្នែកហិរញ្ញវត្ថុទៅកាន់ "
"Open Collective របស់មូឌុល Webform</a>។"

msgid "This behavior is not supported when Ajax is enabled."
msgstr ""
"អាកប្បកិរិយានេះមិនគាំទ្រនៅពេលដែល "
"Ajax ត្រូវបានបើកใช้งานទេ។"

msgid ""
"If checked, the browser back button will submit the previous page and "
"navigate back emulating the behavior of user clicking a wizard or "
"preview page's back button."
msgstr ""
"ប្រសិនបើបានសម្គាល់ "
"ប៊ូតុងថយក្រោយរបស់កម្មវិធីរុករកនឹងធ្វើការដាក់ស្នើទំព័រមុន "
"ហើយឆ្លើយតបតាមការប្រព្រឹត្តនៃអ្នកប្រើដែលចុចប៊ូតុងថយក្រោយនៅលើ "
"wizard ឬទំព័រមើល 미ុន។"

msgid "@name must be %max @type but is currently %length @type long."
msgstr ""
"@name ត្រូវតែមានប្រភេទជា %max "
"@type "
"ប៉ុន្តែបច្ចុប្បន្នមានប្រវែង "
"%length @type។"

msgid "@name must be at least %min @type but is currently %length @type long."
msgstr ""
"@name "
"ត្រូវតែមានប្រវែងយ៉ាងน้อย "
"%min @type "
"ប៉ុន្តែបច្ចុប្បន្នមានប្រវែង "
"%length @type។"

msgid "Decimal (-)"
msgstr "ទសភាគ (-)"

msgid "Decimal (+/-)"
msgstr "ទសភាគ (+/-)"

msgid "If checked, variants will be available using query string parameters."
msgstr ""
"ប្រសិនបើបានត្រួតពិនិត្យ "
"ជម្រើសវ៉ៃរិយោលនឹងអាចប្រើបានដោយប្រើប៉ារ៉ាម៉ែត្រ "
"query string។"

msgid ""
"This is used for the Previous Page button on the page before this page "
"break."
msgstr ""
"នេះ​ត្រូវបាន​ប្រើ​សម្រាប់​ប៊ូតុង​​ទំព័រមុន "
"នៅលើទំព័រមុន​ពេល​បំបែកទំព័រនេះ។"

msgid ""
"This is used for the Next Page button on the page after this page "
"break."
msgstr ""
"នេះត្រូវបានប្រើសម្រាប់ប៊ូតុង "
"ទំព័របន្ទាប់ "
"នៅលើទំព័របន្ទាប់ពីការបំបែកទំព័រនេះ។"

msgid ""
"<strong>Warning:</strong> Opening %type files with spreadsheet "
"applications may expose you to <a href=\":injection_href\">formula "
"injection</a> or other security vulnerabilities. When the submissions "
"contain data from untrusted users and the downloaded file will be used "
"with Microsoft Excel, use the <strong>XLSX</strong> export format."
msgstr ""
"<strong>ការព្រមាន:</strong> "
"ការបើក​ឯកសារ %type "
"ជាមួយ​កម្មវិធី​សៀវភៅ​ទិន្នន័យ​អាច​ធ្វើ​ឲ្យ​អ្នក​ប្រឈម​នឹង "
"<a "
"href=\":injection_href\">ការវាយប្រហារ​រូបមន្ត</a> "
"ឬបញ្ហាសន្តិសុខ​ផ្សេងទៀត។ "
"នៅពេល​ការ​ដាក់ស្នើ​មាន​ទិន្នន័យ​ពី​អ្នកប្រើប្រាស់​ដែល​មិន​គួរឱ្យទុកចិត្ត "
"និង​ឯកសារ​ដែល​ទាញយក​នឹង​ត្រូវ​បានប្រើ​ជាមួយ "
"Microsoft Excel "
"សូម​ប្រើ​ទ្រង់ទ្រាយ​នាំ​ចេញ "
"<strong>XLSX</strong>។"

msgid ""
"The Drupal Association is an educational non-profit organization that "
"tasks itself with fostering and supporting the Drupal software "
"project, the community and its growth."
msgstr ""
"សមាគម Drupal "
"គឺជាសម្រាប់អប់រំមិនរកប្រាក់ចំណេញ "
"ដែលមានភារកិច្ចក្នុងការជម្រុញ "
"និងគាំទ្រគម្រោងកម្មវិធី "
"Drupal, សហគមន៍ "
"និងការលូតលាស់របស់វា។"

