msgstr "ឈ្មោះអង្គភាពកំណត់រចនាសម្ព័ន្ធដែលត្រូវមិនគិត"

msgid "Mode of operation"
msgstr "របៀបដំណើរការ"

msgid "Configuration Ignore settings"
msgstr "ការកំណត់មិនគិតបន្សំ"

msgid "Ignore certain configuration during imports and exports"
msgstr "មិនគួរចិញ្ចើមការកំណត់ខ្លះៗខណៈពេលនាំចូលនិងនាំចេញ"

msgid "Operational mode"
msgstr "របៀបអនុវត្ត"

msgid "lists for import and export ignoring"
msgstr ""
"បញ្ជីសម្រាប់នាំចូល "
"និងនាំចេញ មិនថែរក្សា"

msgid "List of ignored configurations on import"
msgstr "បញ្ជីការកំណត់ដែលមិនបានគិតក្នុងការនាំចូល"

msgid "List of ignored configurations on export"
msgstr "បញ្ជីការកំណត់ដែលបានរំលងនៅពេលនាំចេញ"

msgid "Settings for advanced ignoring"
msgstr "ការកំណត់សម្រាប់ការជៀសវាងជំរុះ"

msgid "List of created ignored configurations"
msgstr ""
"បញ្ជីការកំណត់ដែលបានបង្កើត "
"និងមិនបានអនុវត្ត"

msgid "List of updated ignored configurations"
msgstr "បញ្ជីនៃកំណត់រចនាសម្ព័ន្ធដែលត្រូវបានមិនគិតបន្ទាន់សម័យថ្មី"

msgid "List of deleted ignored configurations"
msgstr ""
"បញ្ជីនៃការកំណត់ដែលបានលុប "
"និងមិនបានគោរព"

msgid ""
"This setting controls how complicated the configuration is. If you do "
"not have a use-case for a more advanced set-up the recommendation is "
"to keep it simple."
msgstr ""
"ការកំណត់នេះគ្រប់គ្រងពីភាពស្មុគស្មាញនៃការកំណត់រចនាសម្ព័ន្ធ។ "
"ប្រសិនបើអ្នកមិនមានករណីប្រើប្រាស់សម្រាប់ការដំឡើងលំដាប់ខ្ពស់ជាងនេះទេ "
"ការផ្តល់អនុសាសន៍គឺឲ្យរក្សាតាមរបៀបធម្មតា។"

msgid "The configuration ignored in all cases"
msgstr "ការកំណត់រចនាសម្ព័ន្ធនេះត្រូវបានបដិសេធក្នុងគ្រប់ករណី"

msgid ""
"One configuration name per line.<br />\n"
"Examples: "
"<ul>\n"
"<li>user.settings</li>\n"
"<li>views.settings</li>\n"
"<li>contact.settings</li>\n"
"<li>webform.webform.* "
"(will ignore all config entities that starts with "
"<em>webform.webform</em>)</li>\n"
"<li>*.contact_message.custom_contact_form.* "
"(will ignore all config entities that starts with "
"<em>.contact_message.custom_contact_form.</em> like fields attached to "
"a custom contact form)</li>\n"
"<li>* (will ignore "
"everything)</li>\n"
"<li>~webform.webform.contact (will force import for "
"this configuration, even if ignored by a "
"wildcard)</li>\n"
"<li>user.mail:register_no_approval_required.body "
"(will ignore the body of the no approval required email setting, but "
"will not ignore other user.mail "
"configuration.)</li>\n"
"<li>language.*|* (will ignore all language "
"collections)</li>\n"
"<li>language.fr|* (will ignore all fr language "
"collection)</li>\n"
"<li>language.fr|field.field.* (will ignore all fr "
"field "
"translations)</li>\n"
"<li>~language.fr|field.field.media.file.field_media_file "
"(will force import for certain field "
"translation)</li>\n"
"<li>language.*|system.site:name (will ignore just "
"the site name but in all translations)</li>\n"
"</ul>"
msgstr ""
"ឈ្មោះកំណត់រចនាសម្ព័ន្ធមួយក្នុងមួួយបន្ទាត់។<br "
"/>\n"
"ឧទាហរណ៍ៈ "
"<ul>\n"
"<li>user.settings</li>\n"
"<li>views.settings</li>\n"
"<li>contact.settings</li>\n"
"<li>webform.webform.* "
"(នឹងមិនគោរពអង្គភាពកំណត់រចនាសម្ព័ន្ធទាំងអស់ដែលចាប់ផ្តើមដោយ "
"<em>webform.webform</em>)</li>\n"
"<li>*.contact_message.custom_contact_form.* "
"(នឹងមិនគោរពអង្គភាពកំណត់រចនាសម្ព័ន្ធទាំងអស់ដែលចាប់ផ្តើមដោយ "
"<em>.contact_message.custom_contact_form.</em> "
"ដូចជាវាលដែលភ្ជាប់ទៅនឹងបែបបទទំនាក់ទំនងផ្ទាល់ខ្លួន)</li>\n"
"<li>* "
"(នឹងមិនគោរពអ្វីៗទាំងអស់)</li>\n"
"<li>~webform.webform.contact "
"(នឹងបង្ខំការនាំចូលសម្រាប់កំណត់រចនាសម្ព័ន្ធនេះ "
"ទោះបីជាត្រូវបានមិនគោរពដោយតួអក្សរជំនួសក្តារ)</li>\n"
"<li>user.mail:register_no_approval_required.body "
"(នឹងមិនគោរពខ្លឹមសាររបស់ការកំណត់អ៊ីម៉ែលដែលមិនត្រូវការអនុម័ត "
"ប៉ុន្តាមិនមិនគោរពកំណត់រចនាសម្ព័ន្ធ "
"user.mail ផ្សេងទៀត)</li>\n"
"<li>language.*|* "
"(នឹងមិនគោរពប្រមុខភាសាទាំងអស់)</li>\n"
"<li>language.fr|* "
"(នឹងមិនគោរពប្រមុខភាសាបារាំងទាំងអស់)</li>\n"
"<li>language.fr|field.field.* "
"(នឹងមិនគោរពការបកប្រែនៃវាលភាសាបារាំងទាំងអស់)</li>\n"
"<li>~language.fr|field.field.media.file.field_media_file "
"(នឹងបង្ខំការនាំចូលសម្រាប់ការបកប្រែវាលជាក់លាក់)</li>\n"
"<li>language.*|system.site:name "
"(នឹងមិនគោរពតែឈ្មោះតំបន់បែបបទប៉ុណ្ណោះ "
"ប៉ុន្តែនៅក្នុងការបកប្រែទាំងអស់)</li>\n"
"</ul>"

msgid "Select theme"
msgstr "ជ្រើសរើសថេម"

