msgstr "លេខតួអក្ខរក្នុងការផ្ដល់Autocompleteតិចបំផុត"

msgid "Autocomplete matching operator"
msgstr "ប្រតិបត្តិករចូលសមមោងអូតូ"

msgid "Column header prefix"
msgstr "ពាក្យដើមកថាអក្សរឈរ"

msgid "Column header prefix key delimiter"
msgstr "កូនសោផ្នែកបឋមរបស់មុខជួរឈរ"

msgid "Column header prefix label delimiter"
msgstr "អ្នកបំបែកស្លាកមុខក្បាលជួរឈរ"

msgid "Toggle details widget state."
msgstr "បើកបិទ​ស្ថានភាពកម្មវិធី​ជំនួយបង្ហាញព័ត៌មាន។"

msgid "Form API #states must be manually entered."
msgstr ""
"Form API #states "
"ត្រូវបានបញ្ចូលដោយដៃតែម្ដង។"

msgid "Learn more about Drupal's <a href=\":href\">Form API #states</a>."
msgstr ""
"សូម​ស្វែងយល់​បន្ថែម​អំពី "
"<a href=\":href\">Form API #states</a> របស់ Drupal។"

msgid "of the following is met:"
msgstr ""
"ក្នុងចំណោមខាងក្រោម "
"ត្រូវបានបំពេញ:"

msgid "Conditional logic (Form API #states) is using a custom %state state."
msgstr ""
"លក្ខខណ្ឌតាមលក្ខណៈ (Form API #states) "
"កំពុងប្រើ %state "
"រដ្ឋផ្ទាល់ខ្លួន។"

msgid "Conditional logic (Form API #states) is using multiple triggers."
msgstr ""
"ហេតុផលលក្ខខណ្ឌ (Form API #states) "
"កំពុងប្រើការបញ្ចេញសញ្ញាជាច្រើន។"

msgid ""
"Conditional logic (Form API #states) is using multiple nested "
"conditions."
msgstr ""
"តិចណូឡូជីលក្ខខណ្ឌ (Form API #states) "
"កំពុងប្រើលក្ខខណ្ឌស្រទាប់ច្រើន។"

msgid "Conditional logic (Form API #states) is using the %operator operator."
msgstr ""
"យុទ្ធសាស្រ្តលក្ខខណ្ឌ (Form API "
"#states) "
"កំពុងប្រើកម្មវិធីប្រតិបត្តិ "
"%operator។"

msgid "Conditional logic (Form API #states) has multiple operators."
msgstr ""
"លក្ខខណ្ឌត្រឹមត្រូវ (Form API "
"#states) "
"មានអាណាព្យាយាមជាច្រើន។"

msgid "%name must be on or after %min."
msgstr ""
"%name "
"ត្រូវតែរៀបចំដែលមានថ្ងៃខែឆ្នាំស្មើឬក្រោយ "
"%min។"

msgid "%name must be on or before %max."
msgstr ""
"%name ត្រូវតែធ្វើនៅលើ ឬមុន "
"%max។"

msgid "Select the date parts and order that should be used in the element."
msgstr ""
"ជ្រើសរើសផ្នែកកាលបរិច្ឆេទ "
"និងលំដាប់ដែលគួរត្រូវបានប្រើនៅក្នុងធាតុ។"

msgid ""
"Select date parts that should be presented as text fields instead of "
"drop-down selectors."
msgstr ""
"ជ្រើសរើសផ្នែកកាលបរិច្ឆេទដែលគួរត្រូវបង្ហាញជាវិស័យអត្ថបទបង្ហាញផ្ទាល់ "
"ជំនួសការជ្រើសរើសតាមបញ្ជីចុះចត់។"

msgid "@title [Time]"
msgstr "@title [ពេលវេលា]"

msgid "Entity reference elements"
msgstr "ធាតੂយោងអង្គភាព"

msgid "File upload elements"
msgstr "ធាតុផ្ទុកឡើងឯកសារ"

msgid "Markup elements"
msgstr "ធាតុ Markup"

msgid "Range settings"
msgstr "ការកំណត់ជួរ"

msgid "Send on"
msgstr "ផ្ញើនៅលើ"

msgid ""
"Check this option if the user should be allowed to upload multiple "
"files."
msgstr ""
"សូមផ្ទៀងផ្ទាត់ជម្រើសនេះ "
"ប្រសិនបើអ្នកប្រើគួរត្រូវបានអនុញ្ញាតឲ្យបញ្ចូលឯកសារច្រើន។"

msgid "Get involved"
msgstr "ចូលរួម"

msgid "Signature Pad"
msgstr "ក្តារចុះហត្ថលេខា"

msgid ""
"Controls how videos are displayed in inline help and within the global "
"help section."
msgstr ""
"គ្រប់គ្រងរបៀបបង្ហាញវីដេអូក្នុងជំនួយបង្ហាញនៅជាប់ "
"និងនៅក្នុងផ្នែកជំនួយសកល។"

msgid "Tableselect sort"
msgstr "តម្រៀបតារាងជ្រើសរើស"

msgid ""
"'@title' is a '@type' element, which has been disabled and will not be "
"rendered."
msgstr ""
"'@title' គឺជា​ធាតុ '@type' មួយ "
"ដែលត្រូវបានបិទហើយនឹងមិនត្រូវបានបង្ហាញឡើយ។"

msgid ""
"The %title options are being set by the %module_names @module. "
"Altering any of the below options will override these dynamically "
"populated options."
msgstr ""
"ជម្រើស %title "
"ត្រូវបានកំណត់ដោយ %module_names "
"@module។ "
"ការផ្លាស់ប្តូរជម្រើសណាមួយខាងក្រោមនេះ "
"នឹងលុបចោលជម្រើស "
"ដែលបានបំពេញដោយស្វ័យប្រវត្តិទាំងនេះ។"

msgid ""
"The %title options have been customized. Resetting the below options "
"will allow the %module_names @module to dynamically populate these "
"options."
msgstr ""
"ជម្រើស %title "
"ត្រូវបានកែប្រែតាមបំណង។ "
"ការកំណត់ឡើងវិញជម្រើសខាងក្រោមនេះ "
"នឹងអនុញ្ញាតឱ្យ %module_names @module "
"បំពេញជម្រើសទាំងនេះដោយអូតូម៉ាទិច។"

msgid ""
"Accepts any date in any <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">GNU "
"Date Input Format</a>. Strings such as today, +2 months, and Dec 9 "
"2004 are all valid."
msgstr ""
"ទទូលបានកាលបរិច្ឆេទណាមួយនៅក្នុង "
"<a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">ទ្រង់ទ្រាយបញ្ចូលកាលបរិច្ឆេទ "
"GNU</a>ណាមួយ។ "
"ខ្សែអក្សរ​ដូចជា today, +2 months, "
"និង Dec 9 2004 "
"ទាំងអស់គឺត្រឹមត្រូវ។"

msgid ""
"The @title could not be interpreted in <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">GNU "
"Date Input Format</a>."
msgstr ""
"@title មិនអាចបកស្រាយបានក្នុង "
"<a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">របៀបបញ្ចូលកាលបរិច្ឆេទ "
"GNU</a>។"

msgid "Use min/max validation to define a more specific date range."
msgstr ""
"ប្រើការផ្ទៀងផ្ទាត់ min/max "
"ដើម្បីកំណត់ជួរថ្ងៃខែដែលមានភាពជាក់លាក់ច្បាស់។"

msgid ""
"HTML5 datetime elements do not gracefully degrade in older browsers "
"and will be displayed as a plain text field without a date or time "
"picker."
msgstr ""
"ធាតុ datetime របស់ HTML5 "
"មិនធ្លាប់ធ្វើការធ្លាក់លំយោលយ៉ាងទន់ភ្លន់នៅក្នុងកម្មវិធីរកមើលបង្ហាញចាស់ៗ "
"ហើយវានឹងត្រូវបង្ហាញជា "
"វាលអត្ថបទទៀងទាត់ "
"ដោយគ្មានជម្រើសជ្រើសរើសកាលបរិច្ឆេទ "
"ឬម៉ោង។"

msgid ""
"Time format is only applicable for browsers that do not have support "
"for the HTML5 time element. Browsers that support the HTML5 time "
"element will display the time using the user's preferred format."
msgstr ""
"ទ្រង់ទ្រាយពេលវេលាគឺអនុវត្តបានសម្រាប់កម្មវិធីរុករកដែលមិនគាំទ្រ "
"<time> ធាតុ HTML5 នោះទេ។ "
"កម្មវិធីរុករកដែលគាំទ្រធាតុ "
"<time> HTML5 "
"នឹងបង្ហាញពេលវេលាប្រើបែបបទដែលអ្នកប្រើប្រាស់ពូលចិត្ត។"

msgid ""
"Enter time format using <a "
"href=\"http://php.net/manual/en/function.date.php\">Time Input "
"Format</a>."
msgstr ""
"បញ្ចូលទ្រង់ទ្រាយពេលវេលាជាមួយ "
"<a "
"href=\"http://php.net/manual/en/function.date.php\">ទ្រង់ទ្រាយការបញ្ចូលពេលវេលា</a>។"

msgid ""
"Private file system is not set. This must be changed in <a "
"href=\"https://www.drupal.org/documentation/modules/file\">settings.php</a>. "
"For more information see: <a "
"href=\"https://www.drupal.org/psa-2016-003\">DRUPAL-PSA-2016-003</a>"
msgstr ""
"ប្រព័ន្ធឯកសារឯកជនមិនត្រូវបានកំណត់ឡើងទេ។ "
"ខ្លឹមសារនេះត្រូវបានផ្លាស់ប្តូរនៅក្នុង "
"<a "
"href=\"https://www.drupal.org/documentation/modules/file\">settings.php</a>។ "
"សម្រាប់ព័ត៌មានបន្ថែម "
"សូមមើល: <a "
"href=\"https://www.drupal.org/psa-2016-003\">DRUPAL-PSA-2016-003</a>"

msgid ""
"Specifies the legal number intervals. Leave blank to support any "
"number interval."
msgstr ""
"កំណត់ចន្លោះលេខផ្លូវច្បាប់។ "
"បោះបង់ទទេដើម្បីគាំទ្រចន្លោះលេខណាមួយក៏បាន។"

msgid ""
"Accepts any time in any <a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">GNU "
"Date Input Format</a>. Strings such as now, +2 hours, and 4:30 PM are "
"all valid."
msgstr ""
"ទទួលយកពេលវេលាណាមួយក្នុង "
"<a "
"href=\"https://www.gnu.org/software/tar/manual/html_chapter/tar_7.html#Date-input-formats\">ទ្រង់ទ្រាយបញ្ចូលកាលបរិច្ឆេទ "
"GNU អ្វីៗ</a>។ ខ្សែអក្សរដូចជា "
"ឥឡូវនេះ, +2 ម៉ោង, និង 4:30 ល្ងាច "
"គឺទាំងអស់គឺត្រឹមត្រូវ។"

msgid ""
"If checked, the download file extension will be change from .html to "
".xls."
msgstr ""
"ប្រសិនបើបានជ្រើស គ្នា "
"ការពង្រឹងឯកសារចេញទាញទំនាក់ទំនងនឹងត្រូវប្ដូរពី "
".html ទៅជា .xls។"

msgid ""
"%title is a %type element, which has been disabled and will not be "
"rendered. Go to the <a href=\":href\">admin settings</a> page to "
"enable this element."
msgstr ""
"%title គឺជាធាតុ %type មួយ "
"ដែលត្រូវបានបិទហើយនឹងមិនត្រូវបានបង្ហាញឡើងវិញទេ។ "
"សូមចូល​ទៅ​ទំព័រ <a "
"href=\":href\">ការកំណត់​ការ​គ្រប់គ្រង</a> "
"ដើម្បីបើកការប្រើប្រាស់ធាតុនេះ។"

msgid ""
"%title is a %type element, which has been disabled and will not be "
"rendered. Please contact a site administrator."
msgstr ""
"%title គឺជាធាតុ %type មួយ "
"ដែលត្រូវបានបិទហើយនឹងមិនត្រូវបានបង្ហាញឡើងទេ។ "
"សូមទាក់ទងអ្នកគ្រប់គ្រងតំបន់បណ្ដាញ។"

msgid ""
"Select roles and users that should be able to populate this element "
"when creating a new submission."
msgstr ""
"ជ្រើសរើសតួនាទី "
"និងអ្នកប្រើដែលគួរតែអាចបញ្ចូលធាតុនេះបានពេលបង្កើតការដាក់សំណើថ្មី។"

msgid ""
"Select roles and users that should be able to update this element when "
"updating an existing submission."
msgstr ""
"ជ្រើសរើសតួនាទី "
"និងអ្នកប្រើដែលគួរតែអាចធ្វើបច្ចុប្បន្នភាពធាតុនេះកាលបរិច្ឆេទធ្វើការដាក់ស្នើមានស្រាប់។"

msgid ""
"Select roles and users that should be able to view this element when "
"viewing a submission."
msgstr ""
"ជ្រើសរើសតួនាទី "
"និងអ្នកប្រើដែលគួរត្រូវបានអនុញ្ញាតឲ្យមើលធាតុនេះពេលមើលការដាក់ស្នើ។"

msgid "Read the %label element's <a href=\":href\">API documentation</a>."
msgstr ""
"អាន <a "
"href=\":href\">ឯកសារពិពណ៌នាអំពី "
"API</a> របស់ធាតុ %label ។"

msgid "A select menu field."
msgstr "ប្រអប់ជម្រើស​មួយ។"

msgid "Processed text settings"
msgstr "ការកំណត់អត្ថបទបានដំណើរការ"

msgid ""
"Allowing N/A is ideal for situations where you wish to make a likert "
"element required, but still want to allow users to opt out of certain "
"questions."
msgstr ""
"ការអនុញ្ញាត N/A "
"គឺល្អឥតខ្ចោះសម្រាប់ស្ថានការណ៍ដែលអ្នកចង់ឲ្យធាតុ "
"likert មួយក្លាយជារឿងបន្ទាន់ "
"ប៉ុន្តែថែមទាំងចង់អោយអ្នកប្រើប្រាស់អាចជ្រើសរើសមិនចូលរួមចំម្លើយសំណួរចំនួនស "
"določភាពបាន។"

msgid "N/A answer text"
msgstr "ជម្លើយ N/A"

msgid "Employee Evaluation"
msgstr "ការវាយតម្លៃនិយោជិក"

msgid "Job Seeker Profile"
msgstr "ប្រវត្តិរូបអ្នកស្វែងរកការងារ"

msgid "Session Evaluation"
msgstr "ការវាយតម្លៃសម័យសិក្សា"

msgid ""
"Below are all available element properties with translatable "
"properties in <strong>bold</strong>."
msgstr ""
"សូមមើលខាងក្រោមសេព្រិលធាតុទាំងអស់ដែលមានលក្ខណៈអាចបកប្រែបានក្នុង "
"<strong>អក្សរដាស់ដូចខ្នង</strong>។"

msgid "Number settings"
msgstr "ការកំណត់លេខ"

msgid "Other option settings"
msgstr "ជម្រើសការកំណត់ផ្សេងទៀត"

msgid "If checked, a select all checkbox will be added to the header."
msgstr ""
"បើបានគូស, "
"ប៊ូតុងជ្រើសរើស​ទាំងអស់​នឹង​ត្រូវ​បន្ថែម​នៅ​ក្នុង​មុខតំណែងក្បាល។"

msgid "Specifies the minimum time."
msgstr "កំណត់ពេលវេលាគិតតិចបំផុត។"

msgid "Specifies the maximum time."
msgstr "កំណត់ពេលវេលាខ្ពស់បំផុត។"

msgid "Specifies the minute intervals."
msgstr "បញ្ជាក់ពីចំណីនាទី។"

msgid "Enter interval in seconds."
msgstr "បញ្ចូលចន្លោះពេលវេលាជាវិនាទី។"

msgid "If checked, sent emails will be displayed onscreen to all users."
msgstr ""
"បើបានធ្វើមួលសញ្ញា "
"អ៊ីមែលដែលបានផ្ញើនឹងត្រូវបង្ហាញលើអេក្រង់ដល់អ្នកប្រើប្រាស់ទាំងអស់។"

msgid ""
"If checked, posted submissions will be displayed onscreen to all "
"users."
msgstr ""
"បើបានធ្វើការ​ជ្រើស​រើស "
"ការដាក់ស្នើដែលបានបង្ហោះ​នឹងត្រូវបង្ហាញលើអេក្រង់ដល់អ្នកប្រើប្រាស់ទាំងអស់។"

msgid "E164"
msgstr "E164"

msgid "Valid countries"
msgstr "ប្រទេសដែលត្រឹមត្រូវ"

msgid "Provides CAPTCHA for adding challenges to arbitrary forms."
msgstr ""
"ផ្ដល់ CAPTCHA "
"សម្រាប់បន្ថែមការប្រឈមទៅទម្រង់ចង់បាន។"

msgid ""
"Text or code that is placed directly in front of the input. This can "
"be used to prefix an input with a constant string. Examples: $, #, -."
msgstr ""
"អក្សរឬកូដដែលត្រូវបានដាក់នៅពីមុខផ្ទាល់នៃវាលបញ្ចូល។ "
"អាចប្រើវាសម្រាប់ដាក់ជាអក្សររួមមួយច្រកជាមួយនឹងវាលបញ្ចូល។ "
"ឧទាហរណ៍៖ $, #, -។"

msgid ""
"Text or code that is placed directly after the input. This can be used "
"to add a unit to an input. Examples: lb, kg, %."
msgstr ""
"អក្សរឬកូដដែលត្រូវដាក់ភ្លាមៗនៅខាងក្រោយបញ្ចូល។ "
"នេះអាចប្រើបានសម្រាប់បន្ថែមឯកតា "
"menyang បញ្ចូល។ ឧទាហរណ៍: lb, kg, %។"

msgid ""
"Unable to render elements, please view the below message(s) and the "
"error log."
msgstr ""
"មិនអាចបង្ហាញធាតុបានទេ "
"សូមមើលសារ(ៗ)ខាងក្រោម "
"និងកំណត់ត្រាភាពខុសប្រក្រតី។"

msgid "Unsaved warning is enabled for all forms."
msgstr "ការជូនដំណឹងមិនបានរក្សាទុកត្រូវបានបើកសម្រាប់ទ្រង់ទ្រាយទាំងអស់។"

msgid ""
"If checked, users will be displayed a warning message when they "
"navigate away from a form with unsaved changes."
msgstr ""
"ប្រសិនបើបានពិនិត្យ "
"អ្នកប្រើនឹងត្រូវបង្ហាញសារព្រមាននៅពេលដែលពួកគេចាកចេញពីទម្រង់ដែលមានការផ្លាស់ប្តូរមិនទាន់បានរក្សាទុក។"

msgid ""
"Expand/collapse all (details) link is automatically added to all "
"forms."
msgstr ""
"តំណលម្អៀង/បង្រួមទ្រង់ទ្រាយទាំងអស់ "
"(ព័ត៌មានលម្អិត) "
"ត្រូវបានបន្ថែមដោយស្វ័យប្រវត្តិទៅលើទម្រង់ទាំងអស់។"

msgid "The HTTP method with which the form will be submitted."
msgstr ""
"វិធីសាស្រ្ត HTTP "
"ដែលត្រូវប្រើសម្រាប់ដាក់សំណុំបែបបទ។"

msgid "POST (Custom)"
msgstr "POST (ផ្ទាល់ខ្លួន)"

msgid "GET (Custom)"
msgstr "GET (បុគ្គលិក)"

msgid ""
"Code Mirror is used to provide a text editor for YAML, HTML, CSS, and "
"JavaScript configuration settings and messages."
msgstr ""
"Code Mirror "
"ត្រូវបានប្រើប្រាស់ដើម្បីផ្ដល់ម៉ឺនុយកែសម្រួលអត្ថបទសម្រាប់កំណត់តម្លៃរចនាសម្ព័ន្ធ "
"និងសារជា YAML, HTML, CSS, និង JavaScript។"

msgid ""
"Input masks are used to ensure predefined and custom formats for text "
"fields."
msgstr ""
"មាស៊ីនបញ្ចូលត្រូវបានប្រើសម្រាប់ធានារូបแบบដែលបានកំណត់រួច "
"និងរូបแบบផ្ទាល់ខ្លួនសម្រាប់វាលអត្ថបទ។"

msgid ""
"Rating plugin for jQuery. Fast, progressive enhancement, touch "
"support, customizable (just swap out the images, or change some CSS), "
"unobtrusive JavaScript (using HTML5 data-* attributes), RTL support. "
"The Rating plugin supports as many stars as you'd like, and also any "
"step size."
msgstr ""
"ផ្លាញន់វាយ​តម្លៃសម្រាប់ "
"jQuery។ លឿន "
"មានការកែលម្អឆាប់រហ័ស "
"គាំទ្រពីរបៀបប៉ះ "
"ប្តូរតាមចំណង់ចំណូលចិត្តបាន "
"(គ្រាន់តែប្តូររូបភាព "
"ឬផ្លាស់ប្ដូរចំនួន CSS ខ្លះ) "
"ជាស្គ្រីប JavaScript មិនរំខាន "
"(ប្រើលក្ខណៈពិសេស HTML5 data-*) "
"គាំទ្រប្រភេទសរសេរក្នុងទិសដៅស្ដាំទៅឆ្វេង "
"(RTL) "
"ផ្លាញន់វាយ​តម្លៃគាំទ្រចំនួនផ្កាយច្រើនប៉ុន្មានក៏បាន "
"ដែលអ្នកចង់បាន "
"ហើយអាចកំណត់ជំហានវាស់ណាមួយក៏បានផងដែរ។"

msgid ""
"Select2 gives you a customizable select box with support for searching "
"and tagging."
msgstr ""
"Select2 "
"ផ្តល់ឱ្យអ្នកជាមួយប្រអប់ជ្រើសរើសដែលអាចកែសម្រួលបានដែលគាំទ្រការស្វែងរក "
"និងការចំណាំ标签។"

msgid ""
"Signature Pad is a JavaScript library for drawing smooth signatures. "
"It is HTML5 canvas based and uses variable width Bézier curve "
"interpolation. It works in all modern desktop and mobile browsers and "
"doesn't depend on any external libraries."
msgstr ""
"Signature Pad គឺជាបណ្ណាល័យ JavaScript "
"សម្រាប់គូរស្នាមហត្ថលេខាដែលមានរលូន។ "
"វាគឺមានមូលដ្ឋានលើក្រដាស់ "
"HTML5 "
"ហើយប្រើការបញ្ចូលត្រង់រាង "
"Bézier ដែលមានទទឹងបម្លែងបាន។ "
"វាធ្វើការជាមួយកម្មវិធីរ៉ូប៊ូតផ្ទាល់ត្រៀមទាំងអស់នៅលើកុំព្យូទ័រដេសក្ដុប "
"និងទូរស័ព្ទចល័ត "
"ហើយមិនពឹងផ្អែកលើបណ្ណាល័យខាងក្រៅណាមួយទេ។"

msgid "Signature Pad is used to provide a signature element."
msgstr ""
"Signature Pad "
"ត្រូវបានប្រើសម្រាប់ផ្ដល់ធាតុហត្ថលេខា។"

msgid ""
"A lightweight, customizable javascript timepicker plugin for jQuery, "
"inspired by Google Calendar."
msgstr ""
"កម្មវិធីជាមុខងារ timepicker ជា "
"javascript ដែលមានទំហំតូច "
"និងអាចប្តូរតាមចិត្តសម្រាប់ "
"jQuery, ដែលមានគំនិតចាប់ពី Google "
"Calendar។"

msgid "Timepicker is used to provide a polyfill for HTML 5 time elements."
msgstr ""
"Timepicker "
"ត្រូវបានប្រើដើម្បីផ្តល់ជាន់សម្រាប់ "
"HTML 5 time elements។"

msgid ""
"Word or character counting, with server-side validation, is available "
"for text fields and text areas."
msgstr ""
"ការគណនាពាក្យ ឬ តួអក្សរ "
"ជាមួយនឹងការផ្ទៀងផ្ទាត់ខាងម៉ាស៊ីនមេ "
"គឺអាចប្រើបានសម្រាប់ប្រអប់អក្សរនិងតំបន់អក្សរ។"

msgid "For multiple options, use commas to separate multiple defaults."
msgstr ""
"សម្រាប់ជម្រើសច្រើន "
"សូមប្រើសញ្ញាក្បៀសដើម្បីបំបែកលំនាំដើមច្រើន។"

msgid "Other field prefix"
msgstr "ពាក្យ​នៅ​មុខ​សាលា​ផ្សេង​ទៀត"

msgid "Other field suffix"
msgstr "បន្សំដែនទៀត"

msgid ""
"Select where the final files should be stored. Private file storage "
"has more overhead than public files, but allows restricted access to "
"files within this element."
msgstr ""
"ជ្រើសរើសកន្លែងដែលគេគួរតែរក្សាទុកឯកសារចុងក្រោយ។ "
"ការផ្ទុកឯកសារឯកជនមានសំណង់ច្រើនជាងឯកសារសាធារណៈ "
"ប៉ុន្តែអនុញ្ញាតឱ្យមានការទស្សន៍ដើម្បីចូលប្រើឯកសារក្នុងធាតុនេះបានកំណត់។"

msgid "Confirmation page URL alias"
msgstr ""
"ឈ្មោះច្រោះ URL "
"ទំព័របញ្ជាក់"

msgid "Default confirmation back label"
msgstr "ស្លាកត្រឡប់បញ្ជាក់មុនបង្ហាញលំនាំដើម"

msgid "Confirmation back link CSS classes"
msgstr ""
"ថ្នាក់ CSS "
"សម្រាប់តំណត្រឡប់បញ្ជាក់"

msgid "Wizard start attributes"
msgstr "លក្ខណៈរាងចាប់ផ្តើមកម្មវិធីWizard"

msgid "Wizard next page button label"
msgstr "ប៊ូតុងស្លាកបន្ទាប់បង្អួចវីស្សាត"

msgid "Confirmation back link"
msgstr "ត្រលប់ទៅតំណភ្ជាប់បញ្ជាក់"

msgid ""
"A list of classes that will be provided in \"Button CSS classes\" "
"dropdown. Enter one or more classes on each line. These styles should "
"be available in your theme's CSS file."
msgstr ""
"បញ្ជីថ្នាក់ដែលនឹងផ្ដល់ជូនក្នុង​ចំណុច​ជ្រើសយក "
"\"Button CSS classes\"។ "
"សូមបញ្ចូលថ្នាក់មួយឬច្រើនក្នុងមួយជួរដេក។ "
"ស្ទីលเหล่านี้គួរត្រូវមាននៅក្នុងឯកសារ "
"CSS នៃប្រធានបទរបស់អ្នក។"

msgid ""
"A list of classes that will be provided in the \"Confirmation CSS "
"classes\" dropdown. Enter one or more classes on each line. These "
"styles should be available in your theme's CSS file."
msgstr ""
"បញ្ជីថ្នាក់ដែលនឹងផ្តល់ជូនក្នុងបង្អួចចុច "
"\"Confirmation CSS classes\" ។ "
"សូមបញ្ចូលថ្នាក់ទមួយឬច្រើនក្នុងមួយជួរ។ "
"ស្តាយទាំងនេះគួរតែមានក្នុងឯកសារ "
"CSS នៃប្រធានបទរបស់អ្នក។"

msgid ""
"A list of classes that will be provided in the \"Confirmation back "
"link CSS classes\" dropdown. Enter one or more classes on each line. "
"These styles should be available in your theme's CSS file."
msgstr ""
"បញ្ជីថ្នាក់ដែលនឹងត្រូវផ្តល់នៅក្នុងបញ្ជីជ្រើសរើស "
"\"Confirmation back link CSS classes\"។ "
"សូមបញ្ចូលថ្នាក់មួយឬច្រើនក្នុងមួយបន្ទាត់។ "
"រចនាប័ទ្មទាំងនេះគួរត្រូវមានក្នុងឯកសារ "
"CSS របស់ប្រធានបទរបស់អ្នក។"

msgid "Webform test third party settings"
msgstr ""
"ការកំណត់ភាគីទីបីសម្រាប់ការធ្វើតេស្ត "
"Webform"

msgid "Webform confidential message"
msgstr "សារ​ឯកជន​របស់សំណុំបែបបទ​បណ្ដាញ"

msgid "Webform handlers"
msgstr "អ្នកគ្រប់គ្រង Webform"

msgid "Webform field storage settings"
msgstr "កំណត់ការផ្ទុកដែន Webform"

msgid "Webform autocomplete display format settings"
msgstr ""
"ការកំណត់ទ្រង់ទ្រាយបង្ហាញ "
"autocomplete របស់ Webform"

msgid "Display the referenced webform with default submission data."
msgstr "បង្ហាញទម្រង់គេហទំព័រដែលបានយោងជាមួយទិន្នន័យការដាក់ស្នើលំនាំដើម។"

msgid "webforms"
msgstr "បែបបទវិប"

msgid "This command will export webform submissions to a file."
msgstr "ពាក្យបញ្ជានេះនឹងនាំចេញការដាក់ស្នើរបែបបទបណ្តាញទៅឯកសារ។"

msgid "'@title' (@entity_type:@entity_id) does not reference a webform."
msgstr ""
"'@title' (@entity_type:@entity_id) "
"មិនបានយោងទៅកាន់វេបភាវរ៉មនោះទេ។"

msgid ""
"'@title' (@entity_type:@entity_id) does not have a '@webform_id' "
"webform associated with it."
msgstr ""
"'@title' (@entity_type:@entity_id) មិនមានបែបបទ "
"'@webform_id' "
"តភ្ជាប់ជាមួយវាក្នុងការប្រើប្រាស់ទេ។"

msgid ""
"If you run into any issues with a webform, you can also attach the "
"below configuration (without any personal information) to a new ticket "
"in the Webform module's <a href=\":href\">issue queue</a>."
msgstr ""
"បើអ្នកប្រទះបញ្ហាមួយណាមួយជាមួយវែបហ្វូម "
"អ្នកក៏អាចភ្ជាប់ការកំណត់ខាងក្រោមនេះ "
"(ដោយគ្មានព័ត៌មានផ្ទាល់ខ្លួនណាមួយ) "
"ទៅក្នុងសំបុត្រថ្មីមួយក្នុង "
"<a href=\":href\">កម្ពស់បញ្ហា</a> "
"របស់ម៉ូឌុល Webform។"

msgid "A flag that indicate the status of the webform submission."
msgstr "ទង់ដែលបង្ហាញស្ថានភាពនៃការដាក់ស្នើទ្រង់ទ្រាយវែប។"

msgid "Administrative notes about the webform submission."
msgstr "កំណត់សម្គាល់រដ្ឋបាលអំពីការដាក់ស្នើវែបហ្វម។"

msgid "The serial number of the webform submission entity."
msgstr "លេខសំរាប់ស្វែបហ្វមដែលបានដាក់ស្នើ។"

msgid "Here is your webform's configuration:"
msgstr "នេះជាការកំណត់រចនាសម្ព័ន្ធរបស់វែបហ្វ្រាំរបស់អ្នក៖"

msgid ""
"Provides examples of all webform elements and functionality which can "
"used for demonstrating and testing advanced functionality or used as "
"cut-n-paste code snippets for creating new webforms."
msgstr ""
"ផ្ដល់ឧទាហរណ៍នៃធាតុ webform "
"ទាំងអស់ និងមុខងារ "
"ដែលអាចប្រើសម្រាប់បង្ហាញ "
"និងសាកល្បងមុខងារកម្រិតខ្ពស់ "
"ឬប្រើជា snippet កូដដែលអាចកាត់ "
"និងបិទ ដើម្បីបង្កើត webform "
"ថ្មី។"

msgid "View webform submissions for any node"
msgstr "មើលការដាក់ស្នើវែបហ្វូមសម្រាប់កំណត់ត្រាណាមួយ"

msgid "View webform submissions for own node"
msgstr "មើលការដាក់ស្នើទម្រង់បណ្តាញសម្រាប់កំណត់ត្រារបស់ខ្លួនเอง"

msgid "Edit webform submissions for any node"
msgstr "កែសម្រួលការដាក់ស្នើបទប្លង់វែបសម្រាប់និមិត្តគ្រប់ប្រភេទ"

msgid "Edit webform submissions for own node"
msgstr "កែសម្រួលការដាក់ស្នើវែបភორმសម្រាប់កំណត់ត្រារបស់ខ្លួនเอง"

msgid "Delete webform submissions for any node"
msgstr "លុបការដាក់ស្នើបែបបទវេបសម្រាប់កំណត់ត្រាណាមួយ"

msgid "Delete webform submissions for own node"
msgstr "លុបការដាក់ស្នើបែបបទវេបសម្រាប់កំណត់ហេតុរបស់ខ្លួនเอง"

msgid "Webform Templates"
msgstr "គំរូបែបបទបែបបទបណ្ដាញ"

msgid "The webform element %title has been deleted."
msgstr ""
"ធាតុវែបហ្វর্ম %title "
"ត្រូវបានលុបចោល។"

msgid "Webform element %type test has been reset."
msgstr ""
"ធាតួប៊ិច Webform %type "
"ត្រូវបានកំណត់ឡើងវិញ។"

msgid "Webform element %type test has been updated."
msgstr ""
"ធាតុ Webform %type "
"ត្រូវបានធ្វើបច្ចុប្បន្នភាព។"

msgid ""
"This is used as a descriptive label when displaying this webform "
"element."
msgstr "នេះ​ត្រូវបាន​ប្រើ​ជា​ស្លាក់​ពណ៌នា​ពេល​បង្ហាញ​ធាតុ​បណ្ដាញរូបមន្ត​នេះ។"

msgid "The default value of the webform element."
msgstr "តម្លៃលំនាំដើមនៃធាតុបែបបទបណ្ដាញ។"

msgid ""
"If set, this message will be used when a required webform element is "
"empty, instead of the default \"Field x is required.\" message."
msgstr ""
"បើបានកំណត់ "
"សារ​នេះ​នឹងត្រូវបានប្រើនៅពេលធាតុវែបហ្វូមដែលត្រូវការ "
"មិនមានតម្លៃ ដោយជំនួសសារ "
"\"ប្រអប់ x គឺ​ត្រូវការ\" "
"ដ៏ទូទៅ។"

msgid "<a href=\":href\">Delete all submissions</a> to this webform."
msgstr ""
"<a "
"href=\":href\">លុបការដាក់ស្នើទាំងអស់</a> "
"ទៅកាន់បែបបទបណ្ដាញនេះ។"

msgid ""
"<a href=\":href\">Enable the Webform UI module</a> and safely delete "
"this element."
msgstr ""
"<a href=\":href\">បើកម៉ូឌុល Webform UI</a> "
"ហើយលុបធាតុនេះដោយសុវត្ថិភាព។"

msgid ""
"The %key element can not be removed because the %title webform has <a "
"href=\":href\">results</a>."
msgstr ""
"ធាតុ %key មិនអាចលុបចោលបានទេ "
"ពីព្រោះវែបហ្វួម %title មាន <a "
"href=\":href\">លទ្ធផល</a>។"

msgid ""
"The %title (@type) is a webform element that can not have any child "
"elements."
msgstr ""
"%title (@type) គឺជាធាតុ webform មួយ "
"ដែលមិនអាចមានធាតុលูกណាមួយបាន។"

msgid "Webform %label created."
msgstr ""
"ប្រមូលព័ត៌មានបែប %label "
"ត្រូវបានបង្កើត។"

msgid "Webform %label elements saved."
msgstr ""
"ធាតុស្លាក %label "
"ក្នុងបែបបទបណ្ដាញបានរក្សាទុក។"

msgid "Webform @label created."
msgstr "Webform @label បានបង្កើត​ហើយ។"

msgid "There are currently no handlers setup for this webform."
msgstr "បច្ចុប្បន្ននេះមិនមានអ្នកដំណើរការណាមួយដែលបានកំណត់សម្រាប់វែបဖូមនេះទេ។"

msgid "Webform %label handler saved."
msgstr ""
"អ្នកដំណើរការ Webform %label "
"ត្រូវបានរក្សាទុក។"

msgid "Webform @label handler saved."
msgstr ""
"អ្នកគ្រប់គ្រង Webform @label "
"ត្រូវបានរក្សាទុក។"

msgid ""
"If checked, this webform will be available as a template to all users "
"who can create new webforms."
msgstr ""
"បើបានជ្រើសរើស "
"ម៍វែបហ្វូមនេះនឹងអាចប្រើបានជាមួយគំរូសម្រាប់អ្នកប្រើទាំងអស់ដែលអាចបង្កើតវែបហ្វូមថ្មី។"

msgid ""
"If checked, all warnings and log messages about 'This webform is "
"currently not saving any submitted data.' will be suppressed."
msgstr ""
"ប្រសិនបើបានមួយចុច, "
"សេចក្តីរំលឹកជូន "
"និងសារ​កំណត់ហេតុទាំងអស់​អំពី "
"'គេហទំព័របែបនេះ​កំពុងមិន​រក្សាទុកទិន្នន័យដែលបានដាក់ទុកឡើយ​។' "
"នឹងត្រូវបានលោតឆ្លង។"

msgid ""
"Optionally specify an alternative URL by which the webform "
"confirmation page can be accessed."
msgstr ""
"ជាជម្រើស អ្នកអាចបញ្ជាក់ "
"URL ផ្លូវជំរើសមួយ តាមរយៈវា "
"ដែលអ្នកអាចចូលទំព័របញ្ជាក់បែបបទវែបបាន។"

msgid "A message to be displayed if the webform breaks."
msgstr "សារមួយសម្រាប់បង្ហាញបើទម្រង់វេបប្រែប្រួលខូច។"

msgid ""
"If checked, users will be displayed a warning message when they "
"navigate away from a webform with unsaved changes."
msgstr ""
"បើបានជ្រើស "
"អ្នកប្រើប្រាស់នឹងត្រូវបង្ហាញសារ​ព្រមាន​នៅពេលពួកគេបញ្ជួលចេញពីវេបភ័ណ្ឌដែលមានការផ្លាស់ប្តូរដែលមិនទាន់បានរក្សាទុក។"

msgid ""
"If checked, an expand/collapse all (details) link will be added to "
"this webform when there are two or more details elements available on "
"the webform."
msgstr ""
"បើបានសម្គាល់ "
"តំណបិទ/បើក​ទាំងអស់ "
"(ព័ត៌មាន​លម្អិត) "
"សន្និដ្ឋាននឹងត្រូវបានបញ្ចូលទៅក្នុងបែបបទវេបនេះ "
"នៅពេលមានធាតុព័ត៌មាន​លម្អិតពីរឬច្រើន "
"ក្នុងបែបបទវេប។"

msgid ""
"The value of the next submission number. This is usually 1 when you "
"start and will go up with each webform submission."
msgstr ""
"តម្លៃនៃលេខបញ្ជូនបន្ទាប់។ "
"ជាទូទៅ វានឹងចាប់ផ្តើមពី 1 "
"នៅពេលដែលអ្នកចាប់ផ្តើម "
"ហើយនឹងកើនឡើងរៀងរាល់ការបញ្ជូនទម្រង់វេបសាយនីមួយៗ។"

msgid "The username of the webform author/owner."
msgstr "ឈ្មោះអ្នកប្រើរបស់អ្នកសរសេរឬម្ចាស់ទម្រង់បែបបទវេបសាយ។"

msgid ""
"Please make sure this webform's action URL or path is setup to handle "
"the webform's submission."
msgstr ""
"សូមធ្វើការត្រួតពិនិត្យឱ្យប្រាកដថា "
"URL សកម្មភាព ឬ "
"ផ្លូវរបស់បែបបទបណ្ដាញនេះត្រូវបានកំណត់ដើម្បីដោះស្រាយការដាក់ស្នើបែបបទបណ្ដាញ។"

msgid "The URL or path to which the webform will be submitted."
msgstr ""
"URL ឬ "
"ផ្លូវដែលបែបបទវេបសាយនឹងត្រូវបានដាក់ស្នើ។"

msgid ""
"This webform is currently not saving any submitted data. Please enable "
"the <a href=\":settings_href\">saving of results</a> or add a <a "
"href=\":handlers_href\">submission handler</a> to the webform."
msgstr ""
"ប្រែសម្រួល:  "
"\n"
"សំណុំបែបបទវើបនេះកំពុងមិនរក្សាទុកទិន្នន័យដែលបានដាក់ស្នើនៅឡើយ។ "
"សូមបើក <a "
"href=\":settings_href\">ការរក្សាទុកលទ្ធផល</a> "
"ឬបន្ថែម <a "
"href=\":handlers_href\">អ្នកដោះស្រាយការដាក់ស្នើ</a> "
"ទៅក្នុងសំណុំបែបបទវើបនេះ។"

msgid ""
"The below webform has been prepopulated with custom/random test data. "
"When submitted, this information <strong>will still be saved</strong> "
"and/or <strong>sent to designated recipients</strong>."
msgstr ""
"វែបហ្វ័មខាងក្រោមនេះបានបំពេញជាមុនជាមួយទិន្នន័យសាកល្បងផ្ទាល់ខ្លួន/ចៃដន្យ។ "
"ពេលដាក់ស្នើ ព័ត៌មាននេះ "
"<strong>នៅតែត្រូវបានរក្សាទុក</strong> "
"និង/ឬ "
"<strong>ផ្ញើទៅអ្នកទទួលដែលបានកំណត់</strong>។"

msgid "Submissions to %webform for %user"
msgstr ""
"ការដាក់ស្នើទៅ %webform សម្រាប់ "
"%user"

msgid ""
"There are no third party settings available. Please install a "
"contributed module that integrates with the Webform module."
msgstr ""
"គ្មានការកំណត់ភាគីទីបីណាមួយដែលអាចប្រើបាន។ "
"សូមដំឡើងម៉ូឌុលដែលរួមចំណែក "
"ដែលបញ្ចូលជាមួយម៉ូឌុល "
"Webform។"

msgid "Webform info"
msgstr "ព័ត៌មាន Webform"

msgid ""
"No export file ready for download. The file may have already been "
"downloaded by your browser. Visit the <a href=\":href\">download "
"export webform</a> to create a new export."
msgstr ""
"គ្មានឯកសារនាំចេញណាមួយដែលមានស្រាប់សម្រាប់ទាញយកទេ។ "
"ឯកសារនោះអាចត្រូវបានទាញយករួចហើយដោយកម្មវិធីរុករករបស់អ្នក។ "
"សូមចូលទៅកាន់ <a "
"href=\":href\">ទំព័រទាញយកឯកសារនាំចេញ</a> "
"ដើម្បីបង្កើតការនាំចេញថ្មី។"

msgid "Testing %title webform"
msgstr ""
"ការធ្វើតេស្តទំរង់បែបបទវែប "
"%title"

msgid "The UUID of the webform submission entity."
msgstr ""
"UUID "
"នៃអត្តសញ្ញាណកម្មការដាក់ស្នើវែបហ្វូម។"

msgid "The URI the user submitted the webform."
msgstr ""
"URI "
"ដែលអ្នកប្រើបានដាក់សំណុំបែបបទវែប។"

msgid ""
"The time that the webform submission was first saved as draft or "
"submitted."
msgstr ""
"ពេលវេលា​ដែលការ​ដាក់សំរាប់រូបមន្ត​បណ្ដាញ​ត្រូវបាន​រក្សាទុក​ជា​សេចក្តីព្រាង​ជាលើកដំបូង "
"ឬ​បាន​ដាក់​ស្នើ។"

msgid ""
"The time that the webform submission was submitted as complete (not "
"draft)."
msgstr ""
"ពេលវេលាដែលការដាក់ស្នើវែបភូមបានដាក់ស្នើជាសព្វថ្ងៃ "
"(មិនមែនជាសេចក្តីព្រាងទេ)។"

msgid ""
"The time that the webform submission was last saved (complete or "
"draft)."
msgstr ""
"ពេលវេលាដែលការដាក់ស្នើរវេបផឺមត្រូវបានរក្សាទុកចុងក្រោយ "
"(បញ្ចប់ ឬ ឯកសារព្រោង)។"

msgid "Disable client-side validation for all webforms"
msgstr "បិទការផ្ទៀងផ្ទាត់ពីផ្នែកអ្នកប្រើសម្រាប់ទំរង់ជាពាណិជ្ជកម្មទាំងអស់"

msgid ""
"If checked, the <a href=\":href\">novalidate</a> attribute, which "
"disables client-side validation, will be added to all webforms."
msgstr ""
"ប្រសិនបើបានពិនិត្យ "
"សមាជិក <a href=\":href\">novalidate</a> "
"ដែលបិទការត្រួតពិនិត្យចំណុចត្រួតពិនិត្យនៅផ្នែកអ្នកប្រើប្រាស់ "
"នឹងត្រូវបានបន្ថែមទៅលើសំណុំបែបបទគេហទំព័រទាំងអស់។"

msgid ""
"Determines the default placement of the description for all webform "
"elements."
msgstr "កំណត់ទីតាំងលំនាំដើមសម្រាប់ការពណ៌នារបស់ធាតុគ្រប់យ៉ាងនៅលើប៊កវែប។"

msgid ""
"Public files upload destination is dangerous for webforms that are "
"available to anonymous and/or untrusted users."
msgstr ""
"ទីតាំងផ្ទុកឡើងឯកសារសាធារណៈគឺមានហានិភ័យសម្រាប់វេបហ្វូមដែលអាចចូលប្រើបានដោយអ្នកប្រើប្រាស់អនាមិកនិង/ឬ "
"អ្នកប្រើដែលមិនទុកចិត្ត។"

msgid "Webform submissions cleared."
msgstr "ការដាក់សំណុំបែបបទវេបសាយត្រូវបានលុបចោល។"

msgid "Webform submissions purged."
msgstr "ការដាក់សំណុំបែបបទវែបបានលុបចោល។"

msgid "Webform selection"
msgstr "ការជ្រើសរើស Webform"

msgid ""
"Flag to control whether this webform should be open or closed to new "
"submissions."
msgstr "ពិធីសញ្ញា​ដើម្បីគ្រប់គ្រងថាតើទម្រង់បែបបទវែបនេះគួរត្រូវបានបើកឬបិទសម្រាប់ការដាក់ស្នើថ្មីៗ។"

msgid "A webform containing default submission values."
msgstr "សំណុំវែបដែលមានតម្លៃដាក់ស្នើលំនាំដើម។"

msgid "Webform PHP mailer"
msgstr "អ្នកផ្ញើអ៊ីមែល PHP របស់ Webform"

msgid ""
"A +/- value describes a dynamic value that is that many years earlier "
"or later than the current year at the time the webform is displayed."
msgstr ""
"តម្លៃ +/- "
"បញ្ជាក់ពីតម្លៃដែលចលនាដែលជាប្រមាណឆ្នាំមួយចំនួនមុនឬបន្ទាប់ពីឆ្នាំបច្ចុប្បន្ននៅពេលបង្ហាញបែបបទបណ្តាញ។"

msgid ""
"Randomizes the order of the options when they are displayed in the "
"webform."
msgstr "ធ្វើការរាយចាក់លំដាប់ជាលក្ខណៈចៃដន្យសម្រាប់ជម្រើសពេលពួកវាបង្ហាញនៅក្នុងវេបហ្វូម។"

msgid ""
"If checked, all existing submission values will be visible to the "
"webform's users."
msgstr ""
"បើបានជ្រើស "
"រួមទាំងតម្លៃការដាក់ស្មើទាំងអស់ដែលមានស្រាប់ "
"នឹងត្រូវបង្ហាញចំពោះអ្នកប្រើប្រាស់របស់វេបហ្វូម។"

msgid "The default value of the composite webform element as YAML."
msgstr ""
"តម្លៃលំនាំដើមនៃធាតុសំណុំបែបបទគេប័រ(composite "
"webform element) ជា YAML។"

msgid ""
"Randomizes the order of the questions when they are displayed in the "
"webform."
msgstr "ធ្វើការប្រែរបៀបរៀបចំសំណួរជាប្រចាំពេលដែលវាត្រូវបានបង្ហាញក្នុងវេបហ្វូម។"

msgid "A basic contact webform template."
msgstr "មាតិការគម្រូបែបទម្រង់បណ្តាញទំនាក់ទំនងមូលដ្ឋាន។"

msgid "An employee evaluation webform template."
msgstr "ទម្រង់វែបហ្វូមសម្រាប់ការវាយតម្លៃនិយោជិកមួយ។"

msgid "An issue webform template."
msgstr "គំរូវែបហ្វូមបញ្ហា។"

