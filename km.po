msgstr ""
"ស្ថានភាពអ៊ីមែល​ដែលកំណត់ពេលវេលា "
"(@total)"

msgid ""
"It is strongly recommended that <a href=\":href\">submission "
"logging</a> is enable to track scheduled emails."
msgstr ""
"អ្នកត្រូវបានពន្យល់យ៉ាងខ្លាំងឲ្យ "
"<a "
"href=\":href\">ការចុះបញ្ជីការដាក់ស្នើ</a> "
"ត្រូវបានបើកដើម្បីតាមដានអ៊ីមែលដែលបានកំណត់ពេលវេលា។"

msgid "Send email on"
msgstr "ផ្ញើអ៊ីមែលនៅលើ"

msgid "Check schedule emails after submissions have been processed."
msgstr "សូមពិនិត្យអ៊ីមែលកាលវិភាគបន្ទាប់ពីការដាក់ស្នើត្រូវបានដំណើរការ។"

msgid "Multiple handlers can be used to schedule multiple emails."
msgstr "អ្នកគ្រប់គ្រងជាច្រើនអាចត្រូវបានប្រើដើម្បីកំណត់ពេលវេលាសម្រាប់អ៊ីមែលជាច្រើន។"

msgid "Deleting this handler will unschedule all scheduled emails."
msgstr "ការលុបអ្នកដឹកនាំនេះនឹងបោះបង់កំណត់ម៉ោងអ៊ីមែលទាំងអស់ដែលបានកំណត់។"

msgid ""
"Scheduled emails are automatically sent starting at midnight using <a "
"href=\":href\">cron</a>, which is executed at predefined interval."
msgstr ""
"អ៊ីមែលដែលបានកំណត់កាលវិភាគ "
"នឹងត្រូវផ្ញើដោយស្វ័យប្រវត្តិតាំងពីម៉ោងកណ្ដាលយប់ "
"ដោយប្រើ <a href=\":href\">cron</a> "
"ដែលបានដំណើរការតាមចន្លោះពេលកំណត់មួយ។"

msgid ""
"%submission: Email <b>not sent</b> for %handler handler because a "
"<em>To</em>, <em>CC</em>, or <em>BCC</em> email was not provided."
msgstr ""
"%submission: អ៊ីមែល <b>មិនបានផ្ញើ</b> "
"សម្រាប់អ្នកដំណើរការ %handler "
"ព្រោះមិនបានផ្តល់អ៊ីមែល "
"<em>ទៅ</em>, <em>ចំលែក</em>, ឬ "
"<em>ចំលែកលាក់</em>។"

msgid ""
"%submission: Email <b>not scheduled</b> for %handler handler because "
"%send is not a valid date/token."
msgstr ""
"%submission: អ៊ីមែល "
"<b>មិនបានកំណត់ពេលវេលា</b> "
"សម្រាប់អ្នកដំណើរការ %handler "
"ព្រោះ %send "
"មិនមែនជាពេលវេលា/ទំព័រឬសញ្ញាត្រឹមត្រូវ។"

msgid ""
"%submission: Email <b>@action</b> by %handler handler to be sent on "
"%date."
msgstr ""
"%submission: អ៊ីមែល <b>@action</b> "
"ដោយអ្នកគ្រប់គ្រង %handler "
"ត្រូវបញ្ជូននៅលើ %date។"

msgid "%submission: Email <b>unscheduled</b> for %handler handler."
msgstr ""
"%submission: អ៊ីមែល "
"<b>មិនបានកំណត់សំណុំបែបបទ</b> "
"សម្រាប់អ្នកដំណោះស្រាយ "
"%handler។"

