msgstr "សារពុំឲ្យលើសកំណត់ការដាក់ស្នើរបស់អ្នកប្រើប្រាស់ប្រចាំម្នាក់"

msgid ""
"An <a href=\":href\">inputmask</a> helps the user with the element by "
"ensuring a predefined format."
msgstr ""
"<a href=\":href\">inputmask</a> "
"ជួយអ្នកប្រើប្រាស់ជាមួយធាតុដោយធានារបៀបដែលបានកំណត់ជាមុន។"

msgid "Email multiple"
msgstr "អ៊ីមែលច្រើនជាងមួយ"

msgid ""
"A <a href=\":href\">regular expression</a> that the element's value is "
"checked against."
msgstr ""
"<a "
"href=\":href\">បញ្ជាក់ទ្រង់ទ្រាយស៊េរីឯកទេស</a> "
"ដែលតម្លៃរបស់ធាតុត្រូវបានពិនិត្យប្រៀបធៀប។"

msgid "The maximum number of matches to be displayed."
msgstr "ចំនួនគន្លង់ខ្ពស់បំផុតដែលត្រូវបង្ហាញ។"

