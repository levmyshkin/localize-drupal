msgstr ""
"ឧទាហរណ៍នៃ Webform "
"សមាសភាគផ្ទាល់ខ្លួនមួយ។"

msgid ""
"webform_example_composite:\n"
"  '#type': webform_example_composite\n"
"  "
"'#title': 'Webform Example "
"Composite'\n"
"webform_example_composite_multiple:\n"
"  '#type': "
"webform_example_composite\n"
"  '#title': 'Webform Example Composite "
"Multiple'\n"
"  '#multiple': true\n"
"  '#multiple__header': true\n"
""
msgstr ""
"webform_example_composite:\n"
"  '#type': webform_example_composite\n"
"  "
"'#title': "
"'គំរូបែបបទវែបមួយរួម'\n"
"\n"
"webform_example_composite_multiple:\n"
" "
" '#type': webform_example_composite\n"
"  '#title': "
"'គំរូបែបបទវែបមួយរួមច្រើន'\n"
" "
" '#multiple': true\n"
"  '#multiple__header': true"

msgid "Example: Webform Element"
msgstr "ឧទាហរណ៍៖ ធាតុ Webform"

msgid "An example of a custom Webform element."
msgstr ""
"ឧទាហរណ៍នៃធាតុ Webform "
"ផ្ទាល់ខ្លួន។"

msgid "Example: Webform Handler"
msgstr "ឧទាហរណ៍៖ Webform Handler"

msgid "An example of a custom Webform handler."
msgstr "ឧទាហរណ៍នៃអ្នកដំណើរការផែនវេបគម្រប់ផ្ទាល់ខ្លួន។"

msgid "Example: Remote post"
msgstr "ឧទាហរណ៍៖ បញ្ចូលពីចម្ងាយ"

msgid "An example of a webform submission posted to a remote server."
msgstr "ឧទាហរណ៍នៃការដាក់សំណុំបែបបទបណ្តាញមួយដែលបានផ្ញើទៅម៉ាស៊ីនបម្រើពីចម្ងាយ។"

msgid "Example: Computed"
msgstr "ឧទាហរណ៍៖ គណនា"

msgid "Examples of a computed elements."
msgstr "ឧទាហរណ៍នៃធាតុដែលបានគណនា។"

msgid "Example: Computed Ajax"
msgstr "ឧទាហរណ៍៖ Ajax គណនា"

msgid "Example of a computed element using Ajax."
msgstr ""
"ឧទាហរណ៍នៃធាតុដែលគណនាដោយប្រើ "
"Ajax។"

msgid ""
"checkbox_example:\n"
"  '#type': details\n"
