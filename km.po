msgstr "ទ្រង់ទ្រាយក្រុមវាល:"

msgid ""
"The css class must include only letters, numbers, underscores and "
"dashes."
msgstr ""
"ថ្នាក់ css "
"ត្រូវតែរួមទាំងតែអក្សរ "
"លេខ ខ្ទង់ក្រោម "
"និងសញ្ញាកាត់ប្លង់តែមួយ។"

msgid "Are you sure you want to delete the group %group?"
msgstr ""
"តើអ្នកប្រាកដថាចង់លុបក្រុម "
"%group មែនទេ?"

msgid "The group %group has been deleted from the %type content type."
msgstr ""
"ក្រុម %group "
"ត្រូវបានលុបចេញពីប្រភេទមាតិកា "
"%type។"

msgid "This fieldgroup renders child groups as jQuery accordion."
msgstr ""
"ក្រុមវាលនេះបង្ហាញក្រុមកូនជាទម្រង់jQuery "
"accordion។"

msgid "This fieldgroup renders the content in a div, part of accordion group."
msgstr ""
"ក្រុមវាលនេះបង្ហាញមាតិកានៅក្នុង "
"div មួយ "
"ដែលជាផ្នែកមួយនៃក្រុម accordion "
"។"

msgid "Extra CSS classes"
msgstr "ថ្នាក់ CSS បន្ថែម"

msgid "Horizontal Tabs"
msgstr "តាបកាដើម្បីផ្ដេក"

msgid "Fieldgroups"
msgstr "ក្រុមវាល"

msgid ""
"<p class=\"fieldgroup-help\">Fields can be dragged into groups with "
"unlimited nesting. Each fieldgroup format comes with a configuration "
"form, specific for that format type.<br />Note that some formats come "
"in pair. These types have a html wrapper to nest its fieldgroup "
"children. E.g. Place accordion items into the accordion, vertical tabs "
"in vertical tab group and horizontal tabs in the horizontal tab group. "
"There is one exception to this rule, you can use a vertical tab "
"without a wrapper when the additional settings tabs are available. "
"E.g. node forms.</p>"
msgstr ""
"<p "
"class=\"fieldgroup-help\">វាលអាចត្រូវបានអូសចូលទៅក្នុងក្រុមជាមួយការកំណត់បន្ថែមដោយគ្មានដែនកំណត់។ "
"ទម្រង់ fieldgroup "
"រៀងរាល់មួយសំនើដោយមានបែបបទកំណត់ដែលជាក់លាក់សម្រាប់ប្រភេទនោះ។<br "
"/>សូមចំណាំថា "
"មានទម្រង់ខ្លះៗដែលមកជារូមគូ។ "
"ប្រភេទទាំងនេះមានរបារខាងក្រៅ "
"html ដើម្បីបោលកូន fieldgroup "
"របស់វាឱ្យរួមគ្នា។ ឧ. "
"ដាក់ធាតុ accordion ចូលក្នុង accordion, "
"តាបខ្នាតបញ្ឈរនៅក្នុងក្រុមតាបខ្នាតបញ្ឈរ "
"និង "
"តាបឈរ​ក្នុង​ក្រុមតាបឈរ។ "
"មានករណីមួយក្រៅពីបទបញ្ជានេះ "
"ដែលអ្នកអាចប្រើតាបខ្នាតបញ្ឈរដោយគ្មានរបារ "
"ខណៈដែលមានតាបកំណត់បន្ថែម។ "
"ឧ. ទំរង់ node។</p>"

msgid "New group %label successfully created."
msgstr ""
"ក្រុមថ្មី %label "
"ត្រូវបានបង្កើតដោយជោគជ័យ។"

