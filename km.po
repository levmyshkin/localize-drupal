"<a href=\":href_webform\">Honeypot protection</a> is enabled for all "
"webforms."
msgstr ""
"<a "
"href=\":href_webform\">ការពារប្រឆាំងហូញឡើងហ្វូត</a> "
"ត្រូវបានបើកសម្រាប់ទម្រង់បណ្ដាញទាំងអស់។"

msgid ""
"<a href=\":href_honeypot\">Time limit</a> is disabled for all "
"webforms."
msgstr ""
"<a href=\":href_honeypot\">ពេលកំណត់</a> "
"ត្រូវបានបិទចន្លោះសម្រាប់បែបបទគេហទំព័រទាំងអស់។"

msgid "<a href=\":href_webform\">Time limit</a> is enabled for all webforms."
msgstr ""
"<a href=\":href_webform\">ពេលកំណត់</a> "
"ត្រូវបានអនុញ្ញាតសម្រាប់ទម្រង់បណ្ដាញទាំងអស់។"

