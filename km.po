msgstr ""
"ទំព័រ <strong>អត្ថបទផ្ទាល់</strong> "
"បង្ហាញព័ត៌មានទូទៅ "
"និងទិន្នន័យរបស់ការដាក់ស្នើក្នុងรูปแบบអត្ថបទសាមញ្ញ។"

msgid "Submission: Data (YAML)"
msgstr "ការដាក់ស្នើ: ទិន្នន័យ (YAML)"

msgid "Submission: Edit All"
msgstr "ស្នើសុំ៖ កែប្រែ​ទាំងអស់"

msgid ""
"The <strong>Resend</strong> form allows administrator to preview and "
"resend emails and messages."
msgstr ""
"ទម្រង់ <strong>Resend</strong> "
"អនុញ្ញាតឱ្យអ្នកគ្រប់គ្រងមើលជាមុន "
"និងផ្ញើអ៊ីមែល និងសារ "
"ម្តងទៀត។"

msgid ""
"The <strong>Submissions</strong> page displays a customizable overview "
"of a webform node's submissions."
msgstr ""
"ទំព័រ <strong>ការដាក់ស្នើ</strong> "
"បង្ហាញមើលជាអ្នកប្តូរប្រែដែលអាចកំណត់បាននៃការដាក់ស្នើនៃកំណត់ត្រា "
"webform។"

msgid ""
"Only webform administrators are allowed to access this page and create "
"new submissions."
msgstr ""
"តែអ្នកគ្រប់គ្រងវែបហ្វូមតែប៉ុណ្ណោះដែលអនុញ្ញាតឱ្យចូលប្រើទំព័រនេះ "
"និងបង្កើតការដាក់ស្នើថ្មី។"

msgid "The delimiter used when an element has multiple values."
msgstr "គ្រឿងដាច់ចេញដែលប្រើនៅពេលដែលធាតុមានតម្លៃច្រើន។"

msgid ""
"Include an element's title with all sub elements and values in each "
"column header"
msgstr ""
"រួមបញ្ចូលចំណងជើងធាតុមួយជាមួយធាតុរងទាំងអស់ "
"និងតម្លៃនៅក្នុងក្បាលជួរឈរ​នីមួយៗ"

msgid ""
"Message (reloads the current page/form and displays the confirmation "
"message at the top of the page)"
msgstr ""
"សារជូនដំណឹង "
"(បញ្ចំហួសទំព័រពេលនេះ/បញ្ចូលប្រែប្រួលទម្រង់ "
"ហើយបង្ហាញសារបញ្ជាក់នៅលើផ្នែកខាងលើនៃទំព័រ)"

msgid ""
"URL with message (redirects to a custom path or URL and displays the "
"confirmation message at the top of the page)"
msgstr ""
"URL ជាមួយសារ "
"(បញ្ជូនបន្តទៅផ្លូវដែលផ្ទាល់ខ្លួន "
"ឬ URL "
"ហើយបង្ហាញសារបញ្ជាក់នៅខាងលើនៃទំព័រ)"

msgid "Autofocus the first element"
msgstr ""
"ដាក់​អនុឡោមពេល​ផ្សេង​ទៅធាតុ​ចុងក្រោយ​ដែល​មាន "
"autofocus"

msgid ""
"If checked, the first visible and enabled form element will be focused "
"when adding a new submission."
msgstr ""
"បើបានធ្វើเครื่องหมาย "
"តំបន់ទម្រង់ដែលមើលឃើញ "
"និងប្រើបានដំបូងនឹងត្រូវផ្តោតនៅពេលបន្ថែមការដាក់ស្នើថ្មី។"

msgid "Allow source entity to be populated using query string parameters"
msgstr "អនុញ្ញាតឱ្យអង្គភាពប្រភពត្រូវបានបំពេញដោយប្រើប៉ារ៉ាម៉ែត្រខ្សែសំណួរ"

msgid "Require source entity to be populated using query string parameters"
msgstr ""
"ត្រូវទាមទារឲ្យអង្គភាពប្រភពត្រូវបានបំពេញដោយប្រើប៉ារ៉ាម៉ែត្រសរសេរក្នុងសំណួរ "
"(query string parameters)"

msgid "The title displayed on the preview page."
msgstr "ចំណងជើងដែលបង្ហាញនៅលើទំព័រមើលមុន។"

msgid "Allow this webform to be used as a template"
msgstr "អនុញ្ញាតឲ្យបែបបទវេបសាយនេះត្រូវបានប្រើជាគំរូ"

msgid "Disable saving of submissions"
msgstr "បិទការរក្សាទុកការដាក់សុំព័ត៍មាន"

msgid "Allow users to post submissions from a dedicated URL"
msgstr ""
"អនុញ្ញាតឲ្យអ្នកប្រើប្រាស់បញ្ចូនការដាក់ស្នើពី "
"URL ដែលបានចាត់ទុកជាពិសេស"

msgid ""
"Any user who can update this webform will still be able to <a "
"href=\":view_href\">view</a> and <a href=\":test_href\">test</a> this "
"webform with the administrative theme."
msgstr ""
"អ្នកប្រើប្រាស់ណាដែលអាចឱ្យបន្ទាន់សម័យសំណុំបែបបទបណ្តាញនេះ "
"នៅតែអាច <a href=\":view_href\">មើល</a> និង "
"<a href=\":test_href\">សាកល្បង</a> "
"សំណុំបែបបទបណ្តាញនេះជាមួយរចនាបថរដ្ឋបាល។"

msgid ""
"Select where the page should be scrolled to when paging, saving of "
"drafts, previews, submissions, and confirmations. Select 'None' to "
"disable scrolling."
msgstr ""
"ជ្រើសរើសទីតាំងដែលទំព័រត្រូវបានរអិលទៅពេលរុករកទំព័រ, "
"រក្សាទុកការរចនា, មើលមុន, "
"ដាក់ស្នើ, និងបញ្ជាក់។ "
"ជ្រើសរើស 'គ្មាន' "
"ដើម្បីបិទការរអិល។"

msgctxt "Sort by {sort} in {direction} order"
msgid "in"
msgstr "នៅក្នុង"

msgctxt "Sort by {sort} in {direction} order"
msgid "order"
msgstr "លំដាប់"

msgctxt "Show {limit} results per page"
msgid "Show"
msgstr "បង្ហាញ"

msgid ""
"If checked, all element descriptions will be moved to help text "
"(tooltip)."
msgstr ""
"ប្រសិនបើបានមarked "
"ទាំងអធិប្បាយទាំងអស់នៃធាតុប្រតិបត្តិការនឹងត្រូវបានផ្ទេរទៅជាព្រះនិពន្ធជំនួយ "
"(tooltip)។"

msgid ""
"Text that will be shown when empty elements are included in submission "
"previews and/or emails"
msgstr ""
"អត្ថបទដែលត្រូវបង្ហាញនៅពេលមានធាតុលាក់ទទេបង្ហាញនៅក្នុងការមើលជាមុននៃការដាក់ស្នើ "
"និង/ឬ អ៊ីមែល"

