msgstr ""
"ជំនួសធាតុ select "
"ជាមួយប្រអប់ជ្រើសរើស <a "
"href=\":href\">Choice.js</a> ។"

msgid ""
"Replace select element with jQuery <a href=\":href\">Chosen</a> select "
"box."
msgstr ""
"ជំនួសធាតុ select "
"ជាមួយប្រអប់ជ្រើសរើស <a "
"href=\":href\">Chosen</a> ដោយប្រើ jQuery។"

