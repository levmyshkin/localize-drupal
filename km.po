msgstr "កំណត់អប្បបរមាទំហំឯកសារដែលអាចផ្ទុកឡើង"

msgid "Excluded submission handlers"
msgstr "កម្មវិធីដំណើរការដាក់ស្នើដែលមិនបានរាប់បញ្ចូល"

msgid "Purging settings"
msgstr "ការលុបការកំណត់"

msgid ""
"If checked, source entity can be populated using query string "
"parameters. For example, appending "
"?source_entity_type=node&source_entity_id=1 to a webform's URL would "
"set a submission's 'Submitted to' value to 'node:1'."
msgstr ""
"បើបានជ្រើស "
"អង្គភាពដើមអាចត្រូវបានបញ្ចូលដោយប្រើប៉ារ៉ាម៉ែត្រខ្សែសំណុំសំណើ។ "
"ឧទាហរណ៍ ការបន្ថែម "
"?source_entity_type=node&source_entity_id=1 ទៅ URL "
"នៃវេបហ្វូមមួយ "
"នឹងកំណត់តម្លៃ 'Submitted to' "
"នៃការដាក់ស្នើឲ្យទៅជា "
"'node:1'។"

msgid ""
"Third party settings allow contrib and custom modules to define "
"webform specific customization settings."
msgstr ""
"ការកំណត់ភាគីទីបីអនុញ្ញាតឱ្យម៉ូឌុលមានរួមចំណែក "
"និងម៉ូឌុលផ្ទាល់ខ្លួនកំណត់ការកំណត់ផ្ទាល់ខ្លួនជាក់លាក់សម្រាប់វេបហ្វូម។"

msgid "Required by @type element."
msgid_plural "Required by @type elements."
msgstr[0] ""
"តម្រូវដោយធាតុ @type។  "
"\n"
"តម្រូវដោយធាតុ @type "
"ជាច្រើន។"

msgid "Duplicate '@label' options"
msgstr ""
"ជម្រើស '@label' "
"ត្រូវបានចម្លងឲ្យដូចគ្នា"

msgid "%name: this element cannot hold more than @count value."
msgid_plural "%name: this element cannot hold more than @count values."
msgstr[0] ""
"%name: "
"ធាតុនេះមិនអាចផ្ទុកតម្លៃបានលើស "
"@count។  \n"
"%name: "
"ធាតុនេះមិនអាចផ្ទុកតម្លៃបានលើស "
"@count ទេ។"

msgid ""
"Third party settings allow contrib and custom modules to define global "
"settings that are applied to all webforms and submissions."
msgstr ""
"ការកំណត់ភាគីទីបីអនុញ្ញាតឱ្យម៉ូឌុល "
"contrib "
"និងម៉ូឌុលប្ដូរប្តូរសមត្ថភាពកំណត់ទូទៅដែលត្រូវបានអនុវត្តទៅលើបែបបទវែបគ្រប់គ្រាន់ "
"និងការដាក់សំណើរទាំងអស់។"

msgid "File upload settings"
msgstr "ការកំណត់ការបញ្ជូនឯកសារ"

msgid ""
"Uncheck the below optional external libraries that you do not want to "
"be used by any webforms."
msgstr "មិនត្រូវមើលសំរាប់បណ្ណាល័យខាងក្រៅជាជម្រើសខាងក្រោមដែលអ្នកមិនចង់ឱ្យប្រើដោយវែបហ្វមណាមួយ។"

msgid ""
"The default sender address for emailed webform results; often the "
"email address of the maintainer of your forms."
msgstr ""
"អាសយដ្ឋាន​អ៊ីមែល​ផ្ញើលទ្ធផលវែបហ្វូមដែលកំណត់ជាមុនជាធម្មតា; "
"ជាញឹកញាប់ជាអាសយដ្ឋាន​អ៊ីមែលរបស់អ្នកថែទាំបែបបទរបស់អ្នក។"

msgid "Select available submission handlers"
msgstr "ជ្រើសរើសអ្នកដំណើរការដាក់ស្នើដែលមានស្រាប់"

msgid "Wizard previous"
msgstr ""
"Wizard previous  \n"
"ម៉ាស៊ីនយន្តមុនគេ"

msgid "wizard previous"
msgstr "ជំនួយការមុន"

msgid "Wizard next"
msgstr "អ្នកជំនួយ​បន្ទាប់"

msgid "wizard next"
msgstr "wizard next -> វីសាដបន្ទាប់"

msgid "Computed settings"
msgstr "កំណត់តម្លៃគណនា"

msgid ""
"This computed element's value will only be available as a token or "
"exported value."
msgstr "តម្លៃរបស់ធាតុលំហែរនេះនឹងអាចប្រើបានតែជាទូចិនឬតម្លៃដែលបាននាំចេញតែប៉ុណ្ណោះ។"

