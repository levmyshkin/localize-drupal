msgstr "ចំណងជើង 1 (h1)"

msgid "Header 2 (h2)"
msgstr "ហេតថ័រ ២ (h2)"

msgid "Header 3 (h3)"
msgstr "កំណត់ចំណងជើង 3 (h3)"

msgid "Header 4 (h4)"
msgstr "ចំណងជើង 4 (h4)"

msgid "Header 5 (h5)"
msgstr "ចំណងជើង 5 (h5)"

