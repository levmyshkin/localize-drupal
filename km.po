"/>កំណត់សម្គាល់៖ "
"ផ្លូវនេះត្រូវមានរួចហើយក្នុង "
"Drupal។"

msgid "Site validation: SIWECOS"
msgstr ""
"ការផ្ទៀងផ្ទាត់តំបន់បណ្ដាញ៖ "
"SIWECOS"

msgid "Google Site Verification"
msgstr ""
"ការផ្ទៀងផ្ទាត់គេហទំព័រ "
"Google"

msgid "SIWECOS"
msgstr "SIWECOS"

msgid "Metatag widget options"
msgstr "ជម្រើស​វេចខ្ចប់ Metatag"

msgid ""
"Various options for the field widget used on entity forms, e.g. on "
"content type forms."
msgstr ""
"ជម្រើសផ្សេងៗសម្រាប់វិជ្ជមានវាលដែលប្រើនៅលើបែបបទអង្គភាព "
"ឧ. "
"នៅលើបែបបទប្រភេទមាតិការបស់ "
"Drupal។"

msgid "Scroll maximum height"
msgstr "រជើរឡើងមកកម្ពស់អតិបរមា"

msgid "eg 500px or 8rem"
msgstr "ឧទាហរណ៍ 500px ឬ 8rem"

msgid ""
"To enable scrolling please enter a value and its units, e.g. 500px, "
"8rem, etc. Removing this value will remove the scroll."
msgstr ""
"ដើម្បីបើកការបង្វិល "
"សូមបញ្ចូលតម្លៃ "
"និងឯកតារបស់វា ឧ. 500px, 8rem, ល។ "
"ការដកតម្លៃនេះចេញនឹងធ្វើឱ្យការបង្វិលបាត់។"

msgid "Define the author of a page."
msgstr "កំណត់អ្នកនិពន្ធនៃទំព័រ។"

msgid ""
"The <a href=\"@module\">Token OR module</a> is suggested for when the "
"basic content tokens are not flexible enough, e.g. to make a meta tag "
"show the contents of one field if it is filled in or another if the "
"first one is empty."
msgstr ""
"<a href=\"@module\">Token OR module</a> "
"ត្រូវបានពេញនិយមសម្រាប់ពេលដែល "
"token "
"មាតិការស្តង់ដារមិនអាចបត់បែនបានគ្រប់គ្រាន់, "
"ឧ. ដើម្បីធ្វើឲ្យ meta tag "
"បង្ហាញមាតិកានៃវាលមួយនៅពេលវាលនោះបានបំពេញ "
"ឬបង្ហាញវាលផ្សេងទៀត "
"ប្រសិនបើវាលដំបូងទទេ។"

msgid "Href per language"
msgstr "Href តាមភាសា"

msgid ""
"This was expected to be an array but it is not: \n"
"%value"
msgstr ""
"នេះគួរត្រូវបានរំពឹងថាជា "
"array ប៉ុន្តែមិនមែនទេ៖  \n"
"%value"

msgid ""
"This could not be unserialized: \n"
"%value"
msgstr ""
"នេះមិនអាចបម្លែងពីអក្សរ​ទៅជា​ទ្រង់ទ្រាយដើមបានទេ៖ "
"\n"
"%value"

msgid "Metatag Field Diff"
msgstr ""
"មេចតាក "
"វាល​ផ្ទេរបម្លាស់ប្ដូរ"

msgid "Use Maxlength module to force these limits?"
msgstr ""
"ប្រើម៉ូឌុល Maxlength "
"ដើម្បីបង្ខិតកំណត់ទាំងនេះ?"

msgid "Install the Maxlength module to enable this option."
msgstr ""
"តំឡើងម៉ូឌុល Maxlength "
"ដើម្បីបើកអនុគមន៍នេះ។"

msgid "Intended workflow"
msgstr "លំហូរ​ការ​ធ្វើការ​ដែល​មាន​គោលបំណង"

msgid ""
"Allows assigning meta tags to be used on custom routes, equivalent to "
"custom paths."
msgstr ""
"អនុញ្ញាតឱ្យកំណត់ meta tags "
"សម្រាប់ប្រើនៅលើផ្លូវផ្ទាល់ខ្លួន "
"ដែលមានតម្លៃសម្រួលនឹងផ្លូវផ្ទាល់ខ្លួន។"

msgid ""
"Indicate to search engines and other page scrapers whether or not "
"links should be followed. See <a "
"href='https://w3c.github.io/webappsec/specs/referrer-policy/'>the W3C "
"specifications</a> for further details. Note: this serves the same "
"purpose as the HTTP header by the same name."
msgstr ""
"បង់បង្ហាញទៅកាន់ម៉ាស៊ីនស្វែងរក "
"និងកម្មវិធីលាក់ទម្រង់ទំព័រផ្សេងទៀតថាតើត្រូវតាមតំណភ្ជាប់ទេឬមិនត្រូវតាម។ "
"សូមមើល <a "
"href='https://w3c.github.io/webappsec/specs/referrer-policy/'>ការបញ្ជាក់អំពី "
"W3C</a> "
"សម្រាប់ព័ត៌មានលម្អិតបន្ថែម។ "
"សូមចំណាំ៖ "
"នេះមានគោលបំណងដូចគ្នានឹងក្បាល "
"HTTP ដែលមានឈ្មោះដូចគ្នា។"

msgid "Max Snippet"
msgstr "អតិបរមា​ស្និបភាគ"

msgid ""
"Use a number character as a textual snippet for this search result. "
"\"0\" equals \"nosnippet\". \"-1\" will let the search engine decide "
"the most effective length."
msgstr ""
"ប្រើអក្សរលេខមួយជាឈ្លោកអត្ថបទសម្រាប់លទ្ធផលស្វែងរកនេះ។ "
"\"0\" ស្មើនឹង \"nosnippet\"។ \"-1\" "
"នឹងឲ្យម៉ាស៊ីនស្វែងរកសម្រេចចិត្តកម្ពស់អត្ថបទដែលមានប្រសិទ្ធភាពបំផុត។"

msgid ""
"Use a maximum of number seconds as a video snippet for videos on this "
"page in search results. \"0\" will use a static a image. \"-1\" means "
"there is no limit."
msgstr ""
"ប្រើរយៈពេលអតិបរមា​ជា​ចំនួន​វិនាទី​មួយ​ជា​ចំណុច​វីដេអូ​សម្រាប់​វីដេអូ​លើ​ទំព័រនេះ​ក្នុង​លទ្ធផល​ស្វែងរក។ "
"\"0\" នឹងប្រើរូបភាពថេរ​មួយ។ "
"\"-1\" "
"មានន័យ​ថា​គ្មាន​កំណត់។"

msgid "Max Image Preview"
msgstr "ការមើលជាមុនរូបភាពអតិបរមា"

msgid "Unavailable after date"
msgstr "មិនអាចប្រើប្រាស់បានបន្ទាប់ពីកាលបរិច្ឆេទ"

msgid "Do not show this page in search results after the specified date"
msgstr "កុំបង្ហាញទំព័រនេះក្នុងលទ្ធផលស្វែងរកបន្ទាប់ពីកាលបរិច្ឆេទដែលបានកំណត់"

msgid ""
"There were no overridden Metatag records that needed to be updated to "
"store the data using JSON."
msgstr ""
"មិនមានកំណត់ត្រា Metatag "
"ដែលបានគេចខ្លួនដែលត្រូវតែធ្វើបច្ចុប្បន្នភាពដើម្បីផ្ទុកទិន្នន័យដោយប្រើ "
"JSON នោះទេ។"

msgid ""
"Processed @processed of @total updating Metatag records with the "
"Publisher or Name meta tags."
msgstr ""
"បានដំណើរការថ្មី @processed នៃ @total "
"កំណត់ត្រា Metatag "
"ដែលកំពុងបន្ទាន់សម័យជាមួយ "
"Publisher ឬ Name meta tags។"

msgid "There were no Metatag records to update."
msgstr ""
"មិនមានបញ្ជី Metatag "
"ទាំងអស់សម្រាប់ធ្វើបច្ចុប្បន្នភាពឡើយ។"

msgid "Removed meta tags from the @config Metatag configuration."
msgstr ""
"បានដកចេញ meta tags ពីការកំណត់ "
"@config Metatag។"

msgid "Metatag: Google Plus is not enabled, nothing to do."
msgstr ""
"Metatag: Google Plus មិនបានបើកប្រើទេ "
"គិតថាមានអ្វីធ្វើមិនได้។"

msgid "Metatag: Google Plus has been uninstalled."
msgstr ""
"Metatag: Google Plus "
"ត្រូវបានដកចេញរួចហើយ។"

msgid ""
"Corrected the Twitter Card \"type\" value in the @config Metatag "
"configuration."
msgstr ""
"បានកែតម្រូវតម្លៃ \"type\" របស់ "
"Twitter Card ក្នុងការកំណត់ @config "
"Metatag។"

msgid "The computed meta tags for the entity."
msgstr "ស្លាក​មេតា​ដែល​បានគណនា​សម្រាប់អង្គភាព។"

msgid "Deprecated module, do not use. Will be removed in 3.0.0."
msgstr ""
"ម៉ូឌុលដែលមិនបានគាំទ្រ "
"យោងទៅមិនគួរប្រើ។ "
"នឹងត្រូវបានដកចេញនៅក្នុងកំណែ "
"3.0.0។"

msgid ""
"Notes:<ul><li>no other fields are required for a Summary "
"card</li><li>Media player card requires the 'title', 'description', "
"'media player URL', 'media player width', 'media player height' and "
"'image' fields,</li><li>Summary Card with Large Image card requires "
"the 'Summary' field and the 'image' field,</li><li>App Card requires "
"the 'iPhone app ID' field, the 'iPad app ID' field and the 'Google "
"Play app ID' field,</li></ul>"
msgstr ""
"សកម្មៈ<ul><li>មិនត្រូវការ​វាលផ្សេងទៀតសម្រាប់​កាត​ចំណងជើង​សង្ខេប​ទេ</li><li>កាត​ម៉េឌៀ​ផ្លេអ៊ែរ​តម្រូវ​ឲ្យ​មាន​វាល "
"'ចំណងជើង', 'ការពិពណ៌នា', 'URL "
"ម៉េឌៀ​ផ្លេអ៊ែរ', "
"'ទទឹងម៉េឌៀ​ផ្លេអ៊ែរ', "
"'កម្ពស់​ម៉េឌៀ​ផ្លេអ៊ែរ' "
"និង "
"'រូបភាព'</li><li>កាត​សង្ខេប​ជាមួយរូបភាព​ធំ​តម្រូវ​ឲ្យ​មាន​វាល "
"'សង្ខេប' និង​វាល "
"'រូបភាព'</li><li>កាតកម្មវិធី​តម្រូវ​ឲ្យ​មាន​វាល "
"'IDកម្មវិធី iPhone', វាល "
"'IDកម្មវិធី iPad' និង​វាល "
"'IDកម្មវិធី Google Play'</li></ul>"

msgid "Separator used with multiple values"
msgstr "អ្នកបំបែកដែលប្រើជាមួយតម្លៃច្រើន"

msgid ""
"Controls the separator used when a meta tag allows multiple values. "
"Multiple characters can be used together, it does not have to be one "
"single character long. Defaults to \":default\"."
msgstr ""
"គ្រប់គ្រងខ្សែបំបែកដែលប្រើពេល "
"meta tag "
"អនុញ្ញាតឲ្យមានតម្លៃច្រើន។ "
"អក្សរច្រើនអាចប្រើរួមគ្នា, "
"មិនចាំបាច់ត្រូវមានតែអក្សរតែមួយផ្នែកនោះទេ។ "
"ពិចារណាលេខផ្តល់មកជា "
"\":default\"។"

msgid ""
"Multiple values may be used, separated by `:delimiter`. Note: Tokens "
"that return multiple values will be handled automatically."
msgstr ""
"អាចប្រើតម្លៃច្រើនបាន "
"ដោយបំបែកដោយ `:delimiter`។ "
"បំណុចគោល៖ "
"រូបសញ្ញាដែលត្រឡប់តម្លៃច្រើននឹងត្រូវបានដំណើរការដោយស្វ័យប្រវត្តិ។"

msgid ""
"The full URL for loading a media player, specifically an iframe for an "
"embedded video rather than the URL to a page that contains a player. "
"Required when using the Player Card type."
msgstr ""
"URL "
"ពេញលេញសម្រាប់​ផ្ទុកកម្មវិធី​ចាក់មេឌា "
"ជាពិសេស iframe "
"សម្រាប់​វីដេអូចាក់បញ្ចូល "
"មិនមែន URL "
"ទៅកាន់​ទំព័រ​ដែលមានកម្មវិធី​ចាក់នោះទេ។ "
"តម្រូវ​ឲ្យមានពេលប្រើ​ប្រភេទ "
"Player Card។"

msgid ""
"The height of the media player iframe, in pixels. Required when using "
"the Player Card type."
msgstr ""
"កម្ពស់របស់ iframe "
"នៃអ្នកចាក់មេឌៀ "
"ក្នុងបទភីក្ស។ "
"ត្រូវការ​ពេលប្រើប្រភេទ "
"Player Card។"

msgid ""
"The width of the media player iframe, in pixels. Required when using "
"the Player Card type."
msgstr ""
"ទទឹងនៃ iframe "
"ពីអ្នក​ចាក់​សារពីមាន​ទ្រព្យរូបមន្ត, "
"នៅ​ក្នុង​ពិចល។ "
"ត្រូវការ​នៅពេល​ប្រើប្រភេទ "
"Card Player។"

msgid ""
"This will be truncated to a maximum of %max characters after any "
"tokens are processed."
msgstr ""
"នេះនឹងត្រូវកាត់បន្ថយទៅជា "
"%max តួអក្សរប្រៀបបានបំផុត "
"បន្ទាប់ពីតួអក្សរណាមួយត្រូវបានដំណើរការ។"

msgid ""
"Because of how tokens are processed in meta tags, use of the Maxlength "
"module may not provide an accurate representation of the actual "
"current length of each meta tag, so it may cause more problem than it "
"is worth."
msgstr ""
"ដោយសារតែវិធីដែល token "
"ត្រូវបានដំណើរការនៅក្នុង "
"meta tags ការប្រើប្រាស់ម៉ូឌុល "
"Maxlength "
"អាចនឹងមិនផ្តល់នូវការតំណាងដែលត្រឹមត្រូវនៃប្រវែងបច្ចុប្បន្នពិតប្រាកដនៃ "
"meta tag រៀងរាល់ឯងបានទេ "
"ដូច្នេះ "
"វាអាចបង្ករបញ្ហាបន្ថែមជាងតម្លៃដែលវាផ្ដល់បាន។"

msgid ""
"Control the Metatag settings pages. Does not control access to the "
"Metatag field on content forms, etc, use the Field Permissions module "
"or hook_form_alter()."
msgstr ""
"គ្រប់គ្រងទំព័រកំណត់ Metatag។ "
"មិនគ្រប់គ្រងការចូលប្រើវាល "
"Metatag នៅលើសំណុំបែបបទមាតិកា "
"រឺផ្សេងទៀតទេ ប្រើម៉ូឌុល "
"Field Permissions ឬ hook_form_alter()។"

msgid "End of the word trimming"
msgstr "ចុងបញ្ចប់នៃការកាត់ពាក្យ"

msgid "This module provides support to define and manage custom meta tags."
msgstr ""
"ម៉ូឌុលនេះផ្ដល់នូវការគាំទ្រដើម្បីកំណត់ "
"និងគ្រប់គ្រងស្លាកមេតាផ្ទាល់ខ្លួន។"

msgid ""
"The module provides the option to create different <a "
"href=\":metatag_custom_tag\">\"Custom Tags\"</a> to use for different "
"purposes."
msgstr ""
"ម៉ូឌុលនេះផ្តល់ជម្រើសសម្រាប់បង្កើត "
"<a "
"href=\":metatag_custom_tag\">\"ស្លាកផ្ទាល់ខ្លួន\"</a> "
"ផ្សេងៗ "
"ដើម្បីប្រើសម្រាប់គោលបំណងផ្សេងៗ។"

msgid "The best way of using Metatag: Custom Tags is as follows:"
msgstr ""
"វិធីដែលល្អបំផុតសម្រាប់ប្រើ "
"Metatag: Custom Tags គឺ如下៖"

msgid ""
"Create the <a href=\":metatag_custom_tag_create\">\"Custom Tag\"</a>, "
"fill in the specific values that every page should have."
msgstr ""
"បង្កើត <a "
"href=\":metatag_custom_tag_create\">\"ស្លាកផ្ទាល់ខ្លួន\"</a> "
"បញ្ចូលតម្លៃជាក់លាក់ដែលគ្រប់ទំព័រត្រូវតែមាន។"

msgid "Configure Custom tags below."
msgstr "កំណត់ស្លាកផ្ទាល់ខ្លួនខាងក្រោម។"

msgid "Metatag: Custom Tags"
msgstr "Metatag: ស្លាកផ្ទាល់ខ្លួន"

msgid "Provides support to define and manage custom meta tags."
msgstr ""
"ផ្ដល់ការគាំទ្រសម្រាប់កំណត់និងគ្រប់គ្រង "
"meta tags និយម។"

msgid "Add Custom tag"
msgstr "បន្ថែមស្លាកតាមបំណង"

msgid "Administer Custom tags"
msgstr "គ្រប់គ្រងស្លាកផ្ទាល់ខ្លួន"

msgid "Control the main settings pages and modify custom tags."
msgstr ""
"គ្រប់គ្រងទំព័រសកលការកំណត់ "
"និងផ្លាស់ប្តូរតាក់ប្ដូររចនាបទផ្ទាល់ខ្លួន។"

msgid "Delete Custom tag"
msgstr "លុបស្លាកផ្ទាល់ខ្លួន"

msgid "Specify the name of the custom tag."
msgstr "បញ្ជាក់ឈ្មោះស្លាកផ្ទាល់ខ្លួន។"

msgid "Specify the description of the Custom tag."
msgstr ""
"បញ្ជាក់ការពិពណ៌នាអំពីស្លាក "
"Custom។"

msgid "Select the HTML element of the Custom tag."
msgstr ""
"ជ្រើសរើសធាតុ HTML នៃស្លាក "
"Custom។"

msgid "Value attribute"
msgstr "Attribute តម្លៃ"

msgid "Created %label Custom tag."
msgstr ""
"បានបង្កើតស្លាកផ្ទាល់ខ្លួន "
"%label។"

msgid "Updated %label Custom tag."
msgstr ""
"បានធ្វើបច្ចុប្បន្នភាពស្លាកផ្ទាល់ខ្លួន "
"%label។"

msgid "Edit Custom tag @label"
msgstr ""
"កែសម្រួលស្លាកផ្ទាល់ខ្លួន "
"@label"

msgid ""
"These custom tags are designed to use the custom purpose on the "
"website."
msgstr "តេកផ្ទាល់ខ្លួនเหล่านี้គឺត្រូវបានរចនាឡើងសម្រាប់ប្រើប្រាស់គោលបំណងផ្ទាល់ខ្លួននៅលើគេហទំព័រ។"

msgid "The entities routes metatags must be added by fields."
msgstr ""
"តម្រូវឲ្យបញ្ចូល routes metatags "
"សម្រាប់អង្គភាពតាមវាល។"

msgid "Trimming options"
msgstr "ជម្រើសកាត់បន្ថយ"

msgid ""
"A list of characters to trim at the end of all metatags. Provide a "
"single string without any separators, e.g. \"|,.\" (instead of \"| , "
".\"). Note that spaces, tabs, new lines, carriage returns and vertical "
"tabs (\" \\n"
"\\r\\t\\v\") will be trimmed automatically and do not "
"need to be listed in this field. The trimming is applied at the very "
"end after the tag is trimmed for length, and after the trimming option "
"was executed."
msgstr ""
"បញ្ជីតួអក្សរដើម្បីកាត់ចេញនៅចុងបញ្ចប់នៃ "
"metatags ទាំងអស់។ "
"សូមផ្តល់ជាផ្សំខ្សែតែមួយដោយគ្មានអ្នកបំបែកណាមួយ "
"ដូចជា \"|,.\" (ជំនួស \"| , .\")។ "
"សូមចំណាំថា "
"ចន្លោះខ្សែអក្សរ ត្បាញ "
"បន្ទាត់ថ្មី "
"ការពង្រឹងតួអក្សរ "
"និងត្បាញកណ្តាលបញ្ឈរ (\" "
"\\n"
"\\r\\t\\v\") "
"នឹងត្រូវបានកាត់ចេញដោយស្វ័យប្រវត្តិ "
"ហើយមិនចាំបាច់ត្រូវបានបញ្ជូលក្នុងដែននេះទេ។ "
"ការកាត់ចេញនេះគឺអនុវត្តនៅចុងបញ្ចប់បន្ទាប់ពីតួបញ្ចូលត្រូវបានកាត់សម្រាប់ប្រវែង "
"ហើយបន្ទាប់ពីជម្រើសកាត់ចេញត្រូវបានអនុវត្ត។"

msgid "Configuration instance"
msgstr "គំរូកំណត់កុងហ្វីក្រេសិន"

msgid ""
"Meta tag configuration, stored as either a serialized array or a "
"JSON-encoded string."
msgstr ""
"ការកំណត់ Meta tag "
"ដែលបានរក្សាទុកជាarray "
"ដែលបានបន្តបន្ទាប់ (serialized array) "
"ឬជាស៊្រីង​ដែលកូដជា JSON "
"(JSON-encoded string)។"

msgid "Expected an array but got null or other type for group: @group_name"
msgstr ""
"រំពឹងថា​អារេមួយ​ប៉ុន្តែ​បានទទួល "
"null "
"ឬប្រភេទផ្សេងសម្រាប់​ក្រុម៖ "
"@group_name"

msgid "Optional suffix to add"
msgstr "បច្ច័យបន្ថែម​ជាជម្រើស​សម្រាប់​បន្ថែម"

msgid "Element of the HTML tag. e.g. meta, link, etc."
msgstr ""
"ធាតុ​នៃ​ស្លាក HTML។ ឧ. meta, link, "
"ល។"

msgid ""
"The name of the html value attribute. e.g. content, href, charset, "
"etc."
msgstr ""
"ឈ្មោះនៃអនុគណន៍ html value attribute ។ "
"ឧ. content, href, charset, ហើយតទៅ។"

msgid ""
"Enter a unique identifier for this custom tag. This identifier can "
"contain lowercase letters, numbers and underscores. This is only used "
"internally, it is not used in the actual HTML output."
msgstr ""
"បញ្ចូលអត្តសញ្ញាណដែលមិនទាន់ប្រើសម្រាប់ស្លាកផ្ទាល់ខ្លួននេះ។ "
"អត្តសញ្ញាណនេះអាចមានអក្សរតូចលេខ "
"និងខ្ទង់ក្រោម។ "
"នេះគ្រាន់តែប្រើសម្រាប់ក្នុងប្រព័ន្ធប៉ុណ្ណោះ "
"មិនបានប្រើជាយថាហេតុក្នុងលទ្ធផល "
"HTML។"

msgid ""
"Select the Value attribute of the Custom tag. This determines which "
"HTML attribute will contain the user-provided content."
msgstr ""
"ជ្រើសរើសអនុលក្ខណ៍ Value "
"របស់ស្លាក Custom។ វាកំណត់ថា "
"អនុលក្ខណ៍ HTML "
"ណាមួយនឹងមានបញ្ចូលមាតិកាដែលអ្នកប្រើផ្តល់ឲ្យ។"

msgid ""
"Define the HTML attributes for this custom meta tag. The first "
"attribute serves as the primary identifier and is required. Additional "
"attributes are optional and provide fixed values for all instances of "
"this tag."
msgstr ""
"កំណត់លក្ខណៈ HTML "
"សម្រាប់ស្លាកមេតា Custom នេះ។ "
"លក្ខណៈទីមួយមានមុខងារជាអត្តសញ្ញាណបឋម "
"និងត្រូវការជាចាំបាច់។ "
"លក្ខណៈបន្ថែមផ្សេងទៀតជាជម្រើស "
"និងផ្ដល់តម្លៃកំណត់សម្រាប់គ្រប់ឱកាសនៃស្លាកនេះ។"

msgid "Primary attribute (Required)"
msgstr "គុណលក្ខណៈចម្បង (ចាំបាច់)"

msgid "Additional attribute @num"
msgstr "គុណលក្ខណៈបន្ថែម @num"

msgid "This attribute identifies the meta tag and is required."
msgstr ""
"លក្ខណៈនេះកំណត់ស្លាកเมតា "
"ហើយចាំបាច់ត្រូវមាន។"

msgid "This attribute provides a fixed value for all instances of this tag."
msgstr "គុណលក្ខណៈនេះផ្ដល់តម្លៃថេរសម្រាប់គ្រប់វត្តមាននៃស្លាកនេះ។"

msgid "Common values: name, property, rel, http-equiv, itemprop."
msgstr ""
"តម្លៃធម្មតាៈ name, property, rel, http-equiv, "
"itemprop។"

msgid "Additional attribute name (e.g., type, sizes)."
msgstr ""
"ឈ្មោះ Attribute បន្ថែម (ឧ. ប្រភេទ, "
"ទំហំ)។"

msgid ""
"For new tags, defaults to the machine name. For existing tags, this "
"identifies the specific meta tag."
msgstr ""
"សម្រាប់ស្លាក​ថ្មី​ "
"មានតម្លៃលំនាំដើមជាឈ្មោះម៉ាស៊ីន។ "
"សម្រាប់ស្លាក​ដែល​មានរួច​​ "
"វាពិចារណាថាជាស្លាក​មេតា​ជាក់លាក់។"

msgid "Fixed value for this attribute."
msgstr "តម្លៃថែរក្សាសម្រាប់គុណលក្ខណៈនេះ។"

msgid ""
"\n"
"        <h4>Common Examples:</h4>\n"
"        <ul>\n"
"          "
"<li><strong>Basic meta tag:</strong><br>\n"
"            Primary "
"attribute: name = \"description\"<br>\n"
"            Result: &lt;meta "
"name=\"description\" content=\"[user-input]\" /&gt;</li>\n"
"          "
"<li><strong>Open Graph tag:</strong><br>\n"
"            Primary "
"attribute: property = \"og:title\"<br>\n"
"            Result: &lt;meta "
"property=\"og:title\" content=\"[user-input]\" /&gt;</li>\n"
"          "
"<li><strong>Twitter Card:</strong><br>\n"
"            Primary "
"attribute: name = \"twitter:card\"<br>\n"
"            Result: &lt;meta "
"name=\"twitter:card\" content=\"[user-input]\" /&gt;</li>\n"
"          "
"<li><strong>Link with type:</strong><br>\n"
"            Primary "
"attribute: rel = \"icon\"<br>\n"
"            Additional attribute: type "
"= \"image/svg+xml\"<br>\n"
"            Result: &lt;link rel=\"icon\" "
"type=\"image/svg+xml\" href=\"[user-input]\" /&gt;</li>\n"
"        "
"</ul>\n"
"      "
msgstr ""
"<h4>ឧទាហរណ៍ទូទៅ៖</h4>\n"
"<ul>\n"
"  "
"<li><strong>ម៉េតា​ធាតុ​មូលដ្ឋាន៖</strong><br>\n"
" "
"   គុណលក្ខណៈ​សំខាន់៖ name = "
"\"description\"<br>\n"
"    លទ្ធផល៖ &lt;meta "
"name=\"description\" content=\"[user-input]\" /&gt;</li>\n"
"  "
"<li><strong>ធាតុ Open Graph៖</strong><br>\n"
"    "
"គុណលក្ខណៈ​សំខាន់៖ property = "
"\"og:title\"<br>\n"
"    លទ្ធផល៖ &lt;meta "
"property=\"og:title\" content=\"[user-input]\" /&gt;</li>\n"
"  "
"<li><strong>កាត Twitter៖</strong><br>\n"
"    "
"គុណលក្ខណៈ​សំខាន់៖ name = "
"\"twitter:card\"<br>\n"
"    លទ្ធផល៖ &lt;meta "
"name=\"twitter:card\" content=\"[user-input]\" /&gt;</li>\n"
"  "
"<li><strong>តំណភ្ជាប់ជាមួយប្រភេទ៖</strong><br>\n"
" "
"   គុណលក្ខណៈ​សំខាន់៖ rel = "
"\"icon\"<br>\n"
"    គុណលក្ខណៈ​បន្ថែម៖ "
"type = \"image/svg+xml\"<br>\n"
"    លទ្ធផល៖ &lt;link "
"rel=\"icon\" type=\"image/svg+xml\" href=\"[user-input]\" "
"/&gt;</li>\n"
"</ul>"

msgid "At least one attribute with both name and value must be provided."
msgstr ""
"យ៉ាងហោចណាស់ "
"ត្រូវផ្តល់លក្ខណៈមួយដែលមានទាំងឈ្មោះ "
"និងតម្លៃ។"

msgid "The primary attribute name and value are required."
msgstr ""
"ឈ្មោះលក្ខណៈ "
"និងតម្លៃសំខាន់ត្រូវបានទាមទារ។"

