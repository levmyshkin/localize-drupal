msgstr ""
"Ознака дугмета „претходна страница“ "
"у подразумеваном чаробњаку/картицама"

msgid "Default wizard/cards next page button label"
msgstr ""
"Подразумевана ознака дугмета "
"„Следеће“ за чаробњак/картице"

