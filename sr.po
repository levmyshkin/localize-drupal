"Подразумевана ознака за потврду "
"чаробњака"

msgid "Default more title"
msgstr "Podrazumevani dodatni naslov"

msgid "Default section title tag"
msgstr ""
"Подразумевани наслов за секцију (title "
"tag)"

msgid "Wizard confirmation label"
msgstr "Натпис за потврду чаробњака"

msgid "Track wizard progress in the URL"
msgstr "Prati napredak čarobnjaka u URL-u"

msgid "Schedule emails for all existing submissions"
msgstr ""
