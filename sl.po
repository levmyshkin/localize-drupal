msgstr "Prezri določene konfiguracije med uvažanjem in izvažanjem"

msgid "Operational mode"
msgstr "Operativni način"

msgid "lists for import and export ignoring"
msgstr "seznami za uvoz in izvoz, ki ignorirajo"

msgid "List of ignored configurations on import"
msgstr "Seznam prezrtih konfiguracij pri uvozu"

msgid "List of ignored configurations on export"
msgstr "Seznam prezrtih nastavitev pri izvozu"

