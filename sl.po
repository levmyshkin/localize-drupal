msgid "Do not index this <em>@bundle</em> entity in sitemap <em>@sitemap</em>"
msgstr ""
"Ne indeksiraj te entitete <em>@bundle</em> v zemljevidu spletnih "
"strani <em>@sitemap</em>."

msgid "Index this <em>@bundle</em> entity in sitemap <em>@sitemap</em>"
msgstr ""
"Indeksiraj entiteto <em>@bundle</em> v zemljevidu spletnega mesta "
"<em>@sitemap</em>"

