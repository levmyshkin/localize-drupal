msgstr ""
"<a href=\":href\">inputmask</a> uporabniku pomaga z elementom tako, da "
"zagotovi vnaprej določen format."

msgid "Email multiple"
msgstr "E-pošlji več"

msgid ""
"A <a href=\":href\">regular expression</a> that the element's value is "
"checked against."
msgstr ""
"Redni izraz <a href=\":href\">, s katerim se preverja vrednost "
"elementa</a>."

msgid "The maximum number of matches to be displayed."
msgstr "Največje število prikazanih zadetkov."

