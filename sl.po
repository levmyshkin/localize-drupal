msgstr "XML-zemljevid strani po meri"

msgid "Use a relative path with a slash in front. For example, \"/about\"."
msgstr ""
"Uporabite relativno pot z začetnim poševnim z rezultatom. Na primer, "
"„/about“."

msgid "XML Sitemap Engines"
msgstr "XML-zemljevidi spletnih strani"

msgid "Minimum lifetime for sitemaps"
msgstr "Minimalna življenjska doba za zemljevide spletnega mesta"

msgid "Generated %sitemap-url with @count links."
msgstr "Ustvarjena je bila %sitemap-url z @count povezavami."

