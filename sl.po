msgstr ""
"<a "
"href=\"https://www.php.net/manual/en/function.ob-start.php\">Izpisno "
"medpomnjenje</a> ni omogočeno. To lahko poslabša zmogljivost "
"delovanja Drupala. Izpisno medpomnjenje lahko privzeto omogočite <a "
"href=\"https://www.php.net/manual/en/outcontrol.configuration.php#ini.output-buffering\">v "
"svojih nastavitvah PHP</a>."

msgid ""
