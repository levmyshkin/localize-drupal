msgid ""
"Install <a href=\":composer_deploy\">Composer Deploy</a> or <a "
"href=\":git_deploy\">Git Deploy</a> as appropriate for accurate update "
"recommendations"
msgstr ""
"Namestite <a href=\":composer_deploy\">Composer Deploy</a> ali <a "
"href=\":git_deploy\">Git Deploy</a>, kot je ustrezno, da bodo "
"priporočila za posodobitve pravilna."

msgid "Environment is incompatible"
msgstr "Okolje ni združljivo"

msgid "Environment checks passed"
msgstr "Preverjanja okolja so uspešno prestala"

