msgid ""
"The maximum number of messages to keep in the database log. Requires a "
"<a href=\":cron\">cron maintenance task</a>."
msgstr ""
"Največje število sporočil, ki se ohranijo v dnevniku v podatkovni "
"zbirki. Zahteva <a href=\":cron\">vzdrževalno opravilo cron</a>."

msgid "Deprecated: Use account-name or display-name instead."
msgstr "Opuščeno: namesto tega uporabite account-name ali display-name."

