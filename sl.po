msgstr ""
"Vnos HTML datetime (lokaliziran) – Uporabite tip elementa HTML5 "
"datetime-local."

msgid "HTML date input - Use the HTML5 date element type."
msgstr "HTML vnos datuma – uporabite vrsto elementa HTML5 `date`."

