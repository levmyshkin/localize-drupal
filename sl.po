msgstr ""
"Posodobitev je bila uspešno dokončana. Vaše spletno mesto je bilo "
"odstranjeno iz načina vzdrževanja."

msgid "Update was completed successfully."
msgstr "Posodobitev je bila uspešno dokončana."

msgid "Update failed! See the log below for more information."
msgstr "Posodobitev ni uspela! Za več informacij si oglejte dnevnik spodaj."

