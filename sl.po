msgstr "Po meri (z uporabo tokenov)"

msgid ""
"For token support the <a href=\"@token_url\">token module</a> must be "
"installed."
msgstr ""
"Za podporo tokenov mora biti nameščen <a href=\"@token_url\">modul "
"za tokene</a>."

msgid "Plain (mainly for images)"
msgstr "Običajno (predvsem za slike)"

