msgid "Webform Cards"
msgstr "Kartice Webform"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"Omogoča vsebnik tipa »Kartica« za hitro izvajanje večkorakovne "
"paginacije obrazca na strani odjemalca."

