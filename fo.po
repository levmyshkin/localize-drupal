msgstr "Hini sparaðu %label-ynkaringarprofíl."

msgid "Label for the Backup Source."
msgstr "Merkið fyri endurlesning-/uppafturkjarnan uppruna."

msgid ""
"%title must contain only letters, numbers, dashes (-) and underscores "
