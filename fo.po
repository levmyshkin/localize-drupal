msgstr "@language-övinum-ýdlan av @type %label er strikað."

msgid "Xdebug settings"
msgstr "Xdebug-ynstillingar"

msgid "xdebug.max_nesting_level is set to %value."
msgstr "xdebug.max_nesting_level er sett til %value."

msgid ""
"Set <code>xdebug.max_nesting_level=@level</code> in your PHP "
