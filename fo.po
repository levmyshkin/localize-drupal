msgstr "Gevið eina týðingarleiðslu til @entity_type_label."

msgid "Interface text language selected for page"
msgstr "Sprogtum brúkt fyri ynstrúksjonstrík á síðuni valdur"

msgid ""
"Customize %language_name language detection to differ from Interface "
"text language detection settings"
msgstr ""
"Broyta %language_name málkanning, soleiðis at hon ger mun á "
