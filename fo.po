msgstr "Yvirlit yvir plugins, ið verða brúkt af Webform-modulinum."

msgid "Webform plugins: Elements"
msgstr "Webform-plugins: Elementir"

msgid "Webform plugins: Handlers"
msgstr "Webform-plugins: Hentarar"

msgid "Webform plugins: Exporters"
msgstr "Webform-plugins: Eksportarar"

