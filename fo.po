msgstr ""
"noimageindex - Forðrar at leitismiðlar indexera myndir á þessari "
"síðu."

msgid ""
"notranslate - Prevent search engines from offering to translate this "
"page in search results."
msgstr ""
"notranslate - forðingar netumsóknir frá at bjóða at týða hesa "
"síðu í søkieldum."

