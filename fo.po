msgid ""
"Inline (Displays message when access is denied to field, nodes, and "
"blocks)"
msgstr ""
"Inlinu (Vísir eina boðskap, tá atgongd verður sýnd frá til ein "
"feløg, nøgdir og blokkar)"

msgid ""
"Page (Displays message when access is denied to forms, fields, nodes, "
"and blocks)"
msgstr ""
"Síða (Vísir ein boð, tá at atgongd verður noktað til formulir, "
"feløg, nœt og blokkar)"

