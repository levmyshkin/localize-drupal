msgstr "Einstaka auðkennið (ID) fyri upplastaða fílinn."

msgid "The name of the file on disk."
msgstr "Nummarið á fílu í harðdiski."

msgid "The web-accessible URL for the file."
msgstr "Den web-athyggelige URL-fasaden fyri fíluna."

