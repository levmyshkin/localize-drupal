msgstr ""
"Mametraha sakantsakana ambony indrindra ho an’ilay votoaty efa "
"voaloa. Ohatra: “100%”, 500, “500px”."

msgid ""
"Set a maximum height for loaded content. Example: \"100%\", 500, "
"\"500px\"."
msgstr ""
"Mametraha ny haavony ambony indrindra ho an’ireo votoaty efa voaloa. "
"Ohatra: “100%”, 500, “500px”."

