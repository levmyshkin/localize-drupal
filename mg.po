msgstr "Asehoy ho lahatsoratra tsotra izay HTML rehetra"

msgid "Display basic HTML help in long filter tips"
msgstr ""
"Asehoy ny fanampiana HTML fototra ao anatin’ny torohevitra lava "
"amin’ny sivana"

