msgstr ""
"Izy no manara-maso ny lesoka 404 ary mamela ireo mpampiasa hamorona "
"redirect ho an’ireo pejy tsy hita nefa matetika no tadiavina."

msgid "404 error database logging settings."
msgstr ""
"Toeram-panitsiana fandraisam-peo ny angon-drakitra (database) ho "
"an’ny hadisoana 404."

msgid "404 error database logs to keep."
msgstr "Error 404: firaketana tahirin-kevitra ao anaty tahiry hotazomina."

msgid "Redirect 404 operations"
msgstr "Atodiho ny fandidiana 404"

