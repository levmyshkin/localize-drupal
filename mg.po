msgstr ""
"Tsy misy ny fanitarana <a href=\":pg_trgm\">pg_trgm</a> ao amin’ny "
"PostgreSQL. Ilaina ity fanitarana ity mba hanatsarana ny "
"fahombiazan’i Drupal rehefa mampiasa PostgreSQL. Jereo ny <a "
"href=\":requirements\">fepetra takian’ny mpizara angona an’i "
"Drupal</a> raha mila fanazavana fanampiny."

msgid "Drupal requires databases that support JSON storage."
msgstr "Mitaky tahiry (database) manohana fitehirizana JSON i Drupal."

msgid "Last run: never"
msgstr "Nanao farany: mbola tsy nisy"

