msgctxt "Plural"
msgid "Enabled"
msgstr "Ampandehanana"

msgid "Pre-content"
msgstr "Alohan’ny atiny"

msgid "Active menu trail"
msgstr "Tabilao misy singa an-dalàna mavitrika"

msgid "Configuration updates"
msgstr "Fanavaozana ny fanahafana"

msgid "The listed configuration will be updated."
msgstr "Hohavaozina ny fikirakirana voatanisa."

msgid "An entity field containing a password value."
msgstr "Sahan-kevitra (field) misy sanda tenimiafina (password)."

msgid "An autocomplete text field with tagging support."
msgstr ""
