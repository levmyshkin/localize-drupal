msgstr ""
"Ny fanamarinana an’io safidy io dia hahatonga ny sanda **Display "
"Type** sy **Separator** ao amin’ilay vondrona tsy ho raisina."

msgid "Multiple field settings"
msgstr "Fanamboarana saha maromaro"

msgid "Display all values in the same row"
msgstr "Asehoy ny sandan‑tsirairay rehetra amin’ny andalana iray ihany"

msgid "Display @count value(s)"
msgstr "Asehero ny sandan’ny @count isa(i)"

