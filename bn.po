msgstr ""
"%name: পূর্ণসংখ্যাটি অবশ্যই %min "
"বা তার চেয়ে বড় হতে হবে।"

msgid "Size of URI field"
msgstr "URI ফিল্ডের আকার"

msgid "URI field"
msgstr "URI ক্ষেত্র"

