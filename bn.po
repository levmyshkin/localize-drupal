msgctxt "Entity type group"
msgid "Other"
msgstr "অন্যান্য"

msgctxt "Entity type group"
msgid "Configuration"
msgstr "কনফিগারেশন"

msgid "Action ID"
msgstr "অ্যাকশন আইডি"

