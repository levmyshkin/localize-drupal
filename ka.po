msgstr ""
"ჩასაწერი (<em>public</em> "
"ჩამოტვირთვის მეთოდი)"

msgid "Writable (<em>private</em> download method)"
msgstr ""
"ჩაწერადი (<em>private</em> "
"ჩამოტვირთვის მეთოდი)"

