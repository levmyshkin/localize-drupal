msgstr ""
"წაიშალა მორგებული მენიუ "
"%title და მისი ყველა მენიუს "
"ბმული."

msgid "Managing menus"
msgstr "მენიუს მართვა"

msgid "Displaying menus"
msgstr "მენიუების ჩვენება"

msgid "Provide a menu link"
msgstr "მიაწოდეთ მენიუს ბმული"

msgid "Available menus"
msgstr "ხელმისაწვდომი მენიუები"

msgid "Edit menu link"
msgstr ""
"მენიუს ბმულის "
"რედაქტირება"

msgid "Reset menu link"
msgstr ""
"მენიუს ბმულის "
"გადატვირთვა"

