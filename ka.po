msgstr ""
"დაშვება დაბლოკილია "
"შესვლის მცდელობისთვის: "
"გადაუდებელი კონტროლი — uid "
"%uid, ip %ip"

msgid "Flood control blocked login attempt for uid %uid"
msgstr ""
