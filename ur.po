msgstr ""
"تبصرہ کرنے والے مصنف کی جانب سے دیا گیا "
"ہوم پیج URL۔"

msgid "The formatted content of the comment itself."
msgstr "تبصرے کے خود اس کے فارمیٹ شدہ مواد۔"

msgid "The URL of the comment."
msgstr "تبصرے (comment) کا URL۔"

msgid "Edit URL"
msgstr "URL میں ترمیم کریں"

msgid "The URL of the comment's edit page."
msgstr "تبصرے کے ترمیمی صفحے کا URL۔"

