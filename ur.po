msgstr ""
"ایک کثیر مرحلہ (multiple step) ’’وزرڈ‘‘ طرز "
"کا ویب فارم کی مثال۔"

msgid ""
"[webform_submission:values:first_name] "
"[webform_submission:values:last_name]"
msgstr ""
"[webform_submission:values:first_name] "
"[webform_submission:values:last_name]"

