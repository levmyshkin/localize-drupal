msgid "Webform Cards"
msgstr "ویبفارم کارڈز"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"تیز کلائنٹ سائیڈ ملٹی اسٹیپ فارم "
"پیجینیشن کے لیے ایک “کارڈ” کنٹینر "
"عنصر فراہم کرتا ہے۔"

msgid "Convert wizard pages to cards"
msgstr "وزرڈ کے صفحات کو کارڈز میں تبدیل کریں"

msgid "Convert @title wizard pages to cards"
msgstr ""
"@title وزرڈ کے صفحات کو کارڈز میں تبدیل "
