msgstr "URL ری ڈائریکٹس"

msgid "Redirect settings"
msgstr "ری ڈائریکٹ کی ترتیبات"

msgid "Redirect 404"
msgstr "404 پر ری ڈائریکٹ کریں"

msgid "The user ID of the node author."
msgstr "نوڈ کے مصنف کا یوزر آئی ڈی۔"

msgid "Pages to ignore"
msgstr "نظر انداز کرنے والے صفحات"

msgid "Last Used"
