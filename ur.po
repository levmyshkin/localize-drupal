msgstr ""
"%directory کو بنانا ممکن نہیں ہوا کیونکہ "
"درج ذیل وجہ ہے: %reason"

msgid "Configuring cron"
msgstr "کرون کو ترتیب دینا"

msgid "Controlling visibility"
msgstr "مرئیت (Visibility) کو کنٹرول کرنا"

msgid "Demonstrate block regions (@theme)"
msgstr "بلاک ریجنز (@theme) کو ڈیمونسٹریٹ کریں"

msgid "Restricted to certain pages"
msgstr "صرف مخصوص صفحات تک محدود ہے"

