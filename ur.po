msgid "Configuration synchronization"
msgstr "ترتیب کی مطابقت پذیری"

msgid "Import and export your configuration."
msgstr ""
"اپنی ترتیب (configuration) کو درآمد (import) اور "
"برآمد (export) کریں۔"

msgid "@date by @username"
msgstr "@date پر @username کی طرف سے"

msgid ""
"You must include at least one keyword to match in the content, and "
"punctuation is ignored."
msgid_plural ""
"You must include at least one keyword to match in the content. "
"Keywords must be at least @count characters, and punctuation is "
"ignored."
msgstr[0] ""
"آپ کو مواد میں کم از کم ایک ایسا کلیدی "
"لفظ شامل کرنا ہوگا جس سے میچ کیا جا "
"سکے، اور اوقاتِ اعراب (punctuation) کو نظر "
"انداز کیا جاتا ہے۔"
msgstr[1] ""
"آپ کو مواد میں کم از کم ایک ایسا کلیدی "
"لفظ شامل کرنا ہوگا جس سے میچ کیا جا "
"سکے۔ کلیدی الفاظ کم از کم @count حروف کے "
"ہونے چاہئیں، اور اوقاتِ اعراب کو نظر "
"انداز کیا جاتا ہے۔"

