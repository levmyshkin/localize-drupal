msgid "checked"
msgstr "چیک کیا گیا"

msgctxt "Remove check mark"
msgid "unchecked"
msgstr "غیر منتخب"

msgid "This webform has no elements added to it."
msgstr ""
"اس ویب فارم میں کوئی عناصر شامل نہیں "
"کیے گئے ہیں۔"

msgctxt "Add check mark"
msgid "Checked"
msgstr "چیک کیا گیا"

msgctxt "Remove check mark"
msgid "Unchecked"
msgstr "غیر منتخب"

msgid ""
"%name must be a valid time with intervals from the dropdown (%step "
