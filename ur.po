msgstr ""
"@language ترجمہ کامیابی کے ساتھ اپ ڈیٹ کر "
"دیا گیا ہے۔"

msgid "(Empty)"
msgstr "(خالی)"

msgid ""
"Are you sure you want to apply the updated %name image effect to all "
