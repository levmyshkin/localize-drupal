msgstr "ویبفارم پلگ اِنز: مختلف صورتیں"

msgid "Webform variants"
msgstr "ویبفارم ویرینٹس"

msgid "Variant plugin ID"
msgstr "ویریئنٹ پلگ اِن آئی ڈی"

msgid "Variant instance ID"
msgstr "ویریئنٹ انسٹنس آئی ڈی"

msgid "Variant element key"
msgstr "ویریئنٹ ایلیمنٹ کلید"

msgid "Variants settings"
msgstr "ویریئنٹس کی ترتیبات"

msgid "Filter category"
msgstr "زمرہ فلٹر کریں"

msgid "Filter state"
msgstr "فلٹر اسٹیٹ"

msgid "Excluded webform variants"
msgstr "خارج کردہ ویب فارم ویریئنٹس"

msgid "Webform Variant Example"
msgstr "Webform ویریئنٹ کی مثال"

