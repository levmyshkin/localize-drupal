msgstr ""
"اگر یہ غیر منتخب ہو تو ہر ٹیبل کی قطار "
"سے ہٹانے کا بٹن (remove button) ہٹا دیا جائے "
"گا۔"

msgid "Admin notes/comments"
msgstr "ایڈمن نوٹس/تبصرے"

msgid ""
"Admin notes/comments are display next to the element title in the form "
"builder and visible in the form's YAML source"
msgstr ""
"ایڈمن نوٹس/تبصرے فارم بلڈر میں عنصر کے "
"عنوان کے ساتھ دکھائے جاتے ہیں اور فارم "
"کے YAML سورس میں نظر آتے ہیں۔"

msgid "Webforms: @webforms"
msgstr "ویبفارمز: @webforms"

msgid "Next submission number disabled"
msgstr "اگلا جمع کرانے کا نمبر غیر فعال ہے"

msgid "is filled"
msgstr "پر بھرا ہوا ہے"

msgid "is checked"
msgstr "چیک کیا گیا ہے"

msgid "is between"
msgstr "کے درمیان"

msgid "is not between"
msgstr "کے درمیان نہیں ہے"

