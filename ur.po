"%field_type_label فیلڈ ٹائپ کو درج ذیل فیلڈ میں "
"استعمال کیا جاتا ہے: @fields"
msgstr[1] ""
"%field_type_label فیلڈ ٹائپ کو درج ذیل فیلڈز "
"میں استعمال کیا جاتا ہے: @fields"

