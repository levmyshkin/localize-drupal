msgstr ""
"کیا ہوگا اگر یہ کہے کہ "
"<code>cweagans/composer-patches</code> کو root dependency ہونا "
"ضروری ہے؟"

msgid "Additional trusted composer plugins"
msgstr "اضافی قابلِ اعتماد کمپوزر پلگ اِنز"

msgid "Trusted composer plugin"
msgstr "قابلِ اعتماد کمپوزر پلگ اِن"

msgid ""
"Cannot claim the stage because it is not owned by the current user or "
