"товчийг хэрэглэгч товшсонтой адил "
"байдлаар буцаан шилжүүлнэ."

msgid "@name must be %max @type but is currently %length @type long."
msgstr ""
"@name нь %max @type байх ёстой боловч "
"одоогоор %length @type байна."

