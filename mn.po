msgstr "@field-ийн өгөгдмөл эрэмбэлэх дараалал"

msgid "Default sort for @field"
msgstr "@field-ийн өгөгдмөл эрэмбэлэлт"

msgid "Alignment for @field"
msgstr "@field-н зэрэгцүүлэлт"

