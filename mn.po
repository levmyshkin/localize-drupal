msgstr ""
"Одоогоор нийтлэгдээгүй контентыг "
"харах"

msgid "Relative default value"
msgstr "Харьцангуй анхдагч утга"

msgid "Headings"
msgstr "Гарчигүүд"

msgid "The comment UUID."
msgstr "Сэтгэгдлийн UUID."

