msgstr "Сонголтуудын арга ба тохиргоонууд"

msgid "CONNECT method settings"
msgstr "Холболтын аргын тохиргоо"

msgid "Theme settings variable for a theme."
msgstr ""
"Сэдвийн тохиргооны хувьсагч (theme settings "
