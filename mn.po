msgstr ""
"“%” нь зам (path)-ын эхний сегментэд "
"ашиглагдах боломжгүй."

msgid "A display whose path ends with a % cannot be a tab."
msgstr ""
"Зам нь “%”-аар төгссөн дэлгэц нь таб "
"байж болохгүй."

