msgstr ""
"%field-ыг %type %source_label-аас устгах явцад "
"асуудал гарсан."

msgid "Field Storage"
msgstr "Талбарын сан (Field Storage)"

msgid "An error occurred while saving the field: @error"
msgstr ""
"Талбарыг хадгалах үед алдаа гарлаа: "
"@error"

