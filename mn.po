msgstr ""
"Drupal 6 эсвэл Drupal 7 сайтаас контент болон "
"тохиргоог шинэ хувилбар руу "
"шилжүүлнэ."

msgid "View the upgrade log."
msgstr "Шинэчлэлийн бүртгэлийг харах."

