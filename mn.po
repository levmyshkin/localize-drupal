"  '#type': textfield\n"
"  '#required': true\n"
"message:\n"
"  "
"'#title': Message\n"
"  '#type': textarea\n"
"  '#required': "
"true\n"
"confirmation_number:\n"
"  '#title': 'Confirmation number'\n"
"  "
"'#type': value\n"
"  '#value': "
"'[webform:handler:remote_post:completed:confirmation_number]'\n"
""
msgstr ""
"```yaml\n"
"first_name:\n"
"  '#title': 'Өвөг нэр'\n"
"  '#type': "
"textfield\n"
"  '#required': true\n"
"last_name:\n"
"  '#title': "
"'Овог'\n"
"  '#type': textfield\n"
"  '#required': true\n"
"email:\n"
"  "
"'#title': Имэйл\n"
"  '#type': email\n"
"  '#required': "
"true\n"
"subject:\n"
"  '#title': Сэдэв\n"
"  '#type': textfield\n"
"  "
"'#required': true\n"
"message:\n"
"  '#title': Мессеж\n"
"  '#type': "
"textarea\n"
"  '#required': true\n"
"confirmation_number:\n"
"  '#title': "
"'Баталгаажуулалтын дугаар'\n"
