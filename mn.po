msgid "File Extension Secure"
msgstr "Файлын өргөтгөлийн хамгаалалт"

msgctxt "Validation"
msgid "File Image Dimensions"
msgstr "Файлын зургийн хэмжээ"

msgctxt "Validation"
msgid "File Is Image"
msgstr "Файл нь зураг байна"

msgctxt "Validation"
msgid "File Name Length"
msgstr "Файлын нэрийн урт"

