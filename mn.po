"first_name:\n"
"  '#title': 'First name'\n"
"  '#type': textfield\n"
"  "
"'#required': true\n"
"last_name:\n"
"  '#title': 'Last name'\n"
"  '#type': "
"textfield\n"
"  '#required': true\n"
"email:\n"
"  '#title': Email\n"
"  "
"'#type': email\n"
"  '#required': true\n"
"subject:\n"
"  '#title': "
