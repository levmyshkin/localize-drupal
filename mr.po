msgstr ""
"क्वेरी प्लगिनसाठी काही "
"प्रगत (advanced) सेटिंग्ज सेट "
"करण्याची परवानगी द्या"

msgid "The name and the description of this display"
msgstr ""
"या डिस्प्लेचे नाव आणि "
"वर्णन"

