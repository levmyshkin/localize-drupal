msgstr "पोस्टल कोड / झिप कोड"

msgid "Telephone attributes"
msgstr "दूरध्वनीची वैशिष्ट्ये"

msgid "Telephone - home"
msgstr "दूरध्वनी - घरचा"

msgid "Telephone - work"
msgstr "दूरध्वनी - कामाचे ठिकाण"

msgid "Telephone - work extension"
msgstr ""
"दूरध्वनी - कार्याचे "
"एक्स्टेंशन"

