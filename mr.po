msgstr ""
"%name: पूर्णांक %min इतका किंवा "
"त्यापेक्षा मोठा असणे "
"आवश्यक आहे."

msgid "Size of URI field"
msgstr "URI फील्डचा आकार"

msgid "URI field"
msgstr "URI फील्ड"

