msgstr ""
"सर्व @entity_type_plural हटवण्यात आले "
"आहेत."

msgid "And <strong>@count</strong> more @entity_type_singular."
msgid_plural "And <strong>@count</strong> more @entity_type_plural."
msgstr[0] ""
"आणि <strong>@count</strong> इतक्या अधिक "
"@entity_type_singular. आणि <strong>@count</strong> "
"इतक्या अधिक @entity_type_plural."

msgid "This will delete <strong>@count</strong> @entity_type_singular."
msgid_plural "This will delete <strong>@count</strong> @entity_type_plural."
msgstr[0] ""
"यामुळे <strong>@count</strong> @entity_type_singular "
"हटवले जाईल."
msgstr[1] ""
"यामुळे <strong>@count</strong> @entity_type_plural "
"हटवले जातील."

