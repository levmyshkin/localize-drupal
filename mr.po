msgstr ""
"तुमचा पासवर्ड अधिक मजबूत "
"करण्यासाठीच्या सूचना:"

msgid ""
"Unrecognized username or password. <a href=\":password\">Forgot your "
"password?</a>"
msgstr ""
"अपरिचित वापरकर्तानाव "
"किंवा पासवर्ड. <a "
"href=\":password\">तुमचा पासवर्ड "
"विसरलात का?</a>"

