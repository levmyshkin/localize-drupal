msgstr ""
"नवीन URL उपनाम (aliases) तयार "
"करण्याची आवश्यकता नाही."

msgid "Double quotation marks"
msgstr "दुहेरी अवतरणचिन्हे"

msgid "Single quotation marks (apostrophe)"
msgstr ""
"एकेरी अवतरणचिन्हे "
"(अपोस्‍ट्रॉफी)"

msgid "Back tick"
msgstr "बॅक टिक"

msgid "Hyphen"
msgstr "हायफन"

msgid "Vertical bar (pipe)"
msgstr "उभा बार (पाइप)"

