msgstr ""
"HTML आणि SVG मार्कअप वापरून "
"सानुकूल पर्याय तयार "
"करण्यासाठी फॉर्म घटक "
"प्रदान करते."

msgid "Custom elements"
msgstr "सानुकूल घटक"

msgid "Custom entity reference"
msgstr "सानुकूल एंटिटी संदर्भ"

