msgstr ""
"निर्दिष्ट %ip_range या "
"श्रेणीमध्ये %ip_address हा IP "
"पत्ता वैध नाही."

msgid "Upper IP address %ip_address in range %ip_range is not valid."
msgstr ""
"%ip_range या श्रेणीतील %ip_address ही "
"वरची IP पत्ता वैध नाही."

msgid ""
"Lower IP can't be greater than upper IP addresses in range. Please "
"correct range %ip_range."
msgstr ""
"रेंजमध्ये खालचा IP पत्ता "
"वरच्या IP पत्त्यांपेक्षा "
"मोठा असू शकत नाही. कृपया "
"%ip_range हा रेंज दुरुस्त करा."

msgid "Add Captcha Point"
msgstr "कॅप्चा पॉइंट जोडा"

msgid "Overview of the available CAPTCHA challenge types with examples'"
msgstr ""
"उपलब्ध CAPTCHA चॅलेंज "
"प्रकारांचा आढावा, "
"उदाहरणांसह"

msgid "CAPTCHA Examples"
msgstr "CAPTCHA उदाहरणे"

msgid "The default captcha title."
msgstr "कॅप्चाचा डीफॉल्ट शीर्षक."

msgid "Text Content"
msgstr "मजकूर सामग्री"

msgid "Customize image CAPTCHA text content."
msgstr ""
"प्रतिमेच्या CAPTCHA मजकुराचे "
"सानुकूलन करा."

msgid "Refresh button text."
msgstr "रीफ्रेश बटणावरील मजकूर."

