msgstr "@entity_type_label आयडी"

msgid "Rendering Language"
msgstr "भाषा प्रदर्शित करीत आहे"

msgid ""
"All content that supports translations will be displayed in the "
"selected language."
msgstr ""
"अनुवादांना सहाय्य करणारी "
"सर्व सामग्री निवडलेल्या "
"भाषेत प्रदर्शित केली जाईल."

msgid "The contextual filter values are provided by the URL."
msgstr ""
"संदर्भाधारित फिल्टरचे "
"मूल्य URL द्वारे दिले जातात."

msgid ""
"The following replacement tokens are available for this field. Note "
"that due to rendering order, you cannot use fields that come after "
"this field; if you need a field not listed here, rearrange your "
"fields."
msgstr ""
"या फील्डसाठी खालील "
"रिप्लेसमेंट टोकन्स "
"उपलब्ध आहेत. लक्षात घ्या "
"की रेंडरिंग क्रमामुळे, "
"तुम्ही या फील्डनंतर "
"येणारी फील्ड्स वापरू शकत "
"नाही; जर तुम्हाला येथे "
"सूचीबद्ध नसलेले फील्ड "
"आवश्यक असेल, तर तुमची "
"फील्ड्स पुन्हा मांडणी "
"(rearrange) करा."

msgid "Enter permission name"
msgstr ""
"परवानगीचे नाव प्रविष्ट "
"करा"

msgid "Entity reference field storage settings"
msgstr ""
"एंटिटी संदर्भ फील्डसाठी "
"स्टोरेज सेटिंग्ज"

msgid "Entity reference field settings"
msgstr ""
"एंटिटी संदर्भ फील्ड "
"सेटिंग्ज"

