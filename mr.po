msgstr ""
"कॅशेमध्ये फॉर्म "
"साठवण्याचा प्रयत्न "
"करताना फॉर्म build-id मध्ये "
"विसंगती आढळली."

msgid "Synchronizing configuration: @op @name."
msgstr ""
"कॉन्फिगरेशन समक्रमित करत "
"आहे: @op @name."

