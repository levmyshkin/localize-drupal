msgid "Webform Cards"
msgstr "वेबफॉर्म कार्ड्स"

msgid ""
"Provides a 'Card' container element for fast clientside multistep form "
"pagination."
msgstr ""
"क्लायंटसाइड मल्टीस्टेप "
"फॉर्म पेजिनेशनसाठी जलद "
"“कार्ड” कंटेनर घटक प्रदान "
"करते."

