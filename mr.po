msgstr ""
"निवडलेल्या प्रकार लागू "
"केल्यानंतर…"

msgid "After this variant is applied…"
msgstr ""
"हा व्हेरिएंट लागू "
"केल्यानंतर…"

msgid "Delete the '@title' variant?"
msgstr "'@title' व्हेरिएंट हटवायचा का?"

