msgstr ""
"विझार्ड पानांना "
"कार्ड्समध्ये रूपांतरित "
"करा"

msgid "Convert @title wizard pages to cards"
msgstr ""
"@title विजार्ड पानांना "
"कार्ड्समध्ये रूपांतरित "
"करा"

