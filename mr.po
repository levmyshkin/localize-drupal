msgstr "बहुभाषिक समर्थन."

msgid "Lock language."
msgstr "भाषा लॉक करा."

msgid "%type: @message in %function (line %line of %file) @backtrace_string."
msgstr ""
"%file (रेषा %line) मधील @backtrace_string हे "
"@function मध्ये %type: @message."

msgid "Starting execution of @module_cron()."
msgstr ""
"@module_cron() ची अंमलबजावणी सुरू "
"करत आहे."

