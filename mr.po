msgstr ""
"भाषेचे तपशील भरा आणि <em>Add custom "
"language</em> वापरून ती भाषा सेव्ह "
"करा."

msgid "The language %language (%langcode) already exists."
msgstr ""
"%language (%langcode) ही भाषा आधीच "
"अस्तित्वात आहे."

msgid "Use the <em>Add language</em> button to save a predefined language."
msgstr ""
"पूर्वनिर्धारित भाषा जतन "
"करण्यासाठी <em>भाषा जोडा</em> "
"हे बटण वापरा."

