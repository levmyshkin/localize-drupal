msgstr ""
"स्त्रोत पथाचा (source path) "
"प्रारंभ स्लॅशने (`/`) झालाच "
"पाहिजे."

msgid "An alias used with this path."
msgstr ""
"या मार्गासह वापरलेला एक "
"उपनाम."

msgid "The alias path has to start with a slash."
msgstr ""
"अलियास पथाची सुरुवात "
"स्लॅश (/) नेच झाली पाहिजे."

msgctxt "Validation"
