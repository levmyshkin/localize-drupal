msgid "Entity links"
msgstr "एंटिटी लिंक्स"

msgid "About text formats"
msgstr "पाठ्य स्वरूपांबद्दल"

msgid "One or more names separated by , or +"
msgstr ""
"स्वल्पविराम (, ) किंवा + ने "
"विभक्त केलेली एक किंवा "
"अधिक नावे"

msgid "Title field required"
msgstr "शीर्षक फील्ड आवश्यक आहे"

msgid "Boolean string"
msgstr "बूलियन स्ट्रिंग"

msgid "OPML Feed"
msgstr "OPML फीड"

msgid "Entity Reference reference access"
msgstr ""
"एंटिटी रेफरन्स (Entity Reference) "
"संदर्भ प्रवेश"

msgctxt "Validation"
msgid "Email"
