"उदाहरणार्थ, “about” पेज "
"लिहिताना “/about” असे टाइप "
"करा."

msgid "Administer REST resource configuration"
msgstr ""
"REST संसाधनांची कॉन्फिगरेशन "
"व्यवस्थापित करा"

msgid "Supported methods"
msgstr "समर्थित पद्धती"

msgid "Supported authentication providers"
msgstr ""
"समर्थित प्रमाणीकरण "
"प्रदाते"

msgid "REST resource config"
msgstr "REST रीसोर्स कॉन्फिगरेशन"

msgid "REST resource config ID"
msgstr "REST रिसोर्स कॉन्फिग आयडी"

msgid "REST resource plugin id"
msgstr "REST संसाधन प्लगइन आयडी"

