msgctxt "Imperial height unit"
msgid "Inches"
msgstr "इंच"

msgid "Height settings"
msgstr "उंचीच्या सेटिंग्ज"

msgid "Height element type"
msgstr "उंची घटक प्रकार"

msgid "Select menu with suffixes"
msgstr ""
"पुढील प्रत्ययांसह मेनू "
"निवडा"

msgid "Height suffix format"
msgstr "उंची प्रत्ययाचे स्वरूप"

msgid "Units (feet/foot and inches/inch)"
msgstr "एकके (फूट/पाऊल आणि इंच/इंच)"

msgid "Abbreviated units (ft and in)"
msgstr ""
"संक्षिप्त एकके (फूट आणि "
"इंच)"

msgid "Symbols (″ and ′)"
msgstr "चिन्हे (″ आणि ′)"

msgid "Feet minimum"
msgstr "किमान पावले"

msgid "Specifies the feet's minimum value."
msgstr ""
"पायांच्या (feet) किमान "
"मूल्याचे निर्दिष्ट करते."

msgid "Feet maximum"
msgstr "कमाल पायथ्याची लांबी"

msgid "Specifies the feet's maximum value."
msgstr ""
"पायांच्या (feet) कमाल "
"मूल्याची मर्यादा "
"निर्दिष्ट करते."

msgid "@title: Feet"
msgstr "@title: पाय"

msgid "@title: Inches"
msgstr "@title: इंच"

msgid "Height (feet/inches)"
msgstr "उंची (फूट/इंच)"

msgid "Access the webform help page"
msgstr ""
"वेबफॉर्म मदत पृष्ठावर "
"प्रवेश करा"

msgid "Allow users to delete a submission using a secure token"
msgstr ""
"सुरक्षित टोकनचा वापर करून "
"वापरकर्त्यांना सबमिशन "
"हटविण्याची परवानगी द्या"

msgid ""
"The below Ajax scroll, effect, and speed settings will also be applied "
"to cards."
msgstr ""
"खालील Ajax स्क्रोल, इफेक्ट "
"आणि स्पीडच्या सेटिंग्ज "
"कार्ड्सवरही लागू होतील."

msgid "Page/card name (?page=contact)"
msgstr "पृष्ठ/कार्डचे नाव (?page=contact)"

msgid "Page/card index (?page=2)"
msgstr "पेज/कार्ड इंडेक्स (?page=2)"

msgid "is not checked"
msgstr "चेक केलेले नाही"

msgid ""
"If checked, the generated file's carriage returns will be compatible "
"with Excel and a marker flagging the data as UTF-8 will be added at "
"the beginning."
msgstr ""
"जर हे चिन्हांकित केले "
"असेल, तर तयार झालेल्या "
"फाईलमधील कॅरिज रिटर्न्स "
"एक्सेलसह सुसंगत असतील आणि "
"डेटाला UTF-8 म्हणून "
"चिन्हांकित करणारा फ्लॅग "
"सुरुवातीला जोडला जाईल."

msgid ""
"If multiple email addresses are entered the '@name' will be not "
"included in the email."
msgstr ""
"जर एकापेक्षा अधिक ईमेल "
"पत्ते प्रविष्ट केले असतील "
"तर ईमेलमध्ये ‘@name’ "
"समाविष्ट केला जाणार नाही."

msgid "Submission Delete"
msgstr "सबमिशन हटवा"

msgid "The URL alias has to start with a slash and cannot end with a slash."
msgstr ""
"URL alias ला सुरुवात `/` नेच करावी "
"आणि त्याचा शेवट `/` ने होता "
"कामा नये."

msgid "The base path has to start with a slash and cannot end with a slash."
msgstr ""
"मूलभूत पथ (base path) हा स्लॅशने "
"सुरू झाला पाहिजे आणि "
"स्लॅशने समाप्त होऊ शकत "
"नाही."

msgid "Submission access token settings"
msgstr ""
"सबमिशन ऍक्सेस टोकन "
"सेटिंग्ज"

msgid "The webform (@webform) is broken or missing."
msgstr ""
"वेबफॉर्म (@webform) खराब झाला "
"आहे किंवा उपलब्ध नाही."

msgid ""
"To add details and fieldsets this vertical tabs element, you must "
"defined a custom <code>'#group': vertical_tab_key</code> property in "
"the details or fieldset element with this vertical tabs' element key."
msgstr ""
"तपशील आणि फील्डसेट्स "
"जोडण्यासाठी या व्हर्टिकल "
"टॅब्स घटकात, तुम्हाला "
"तपशील (`details`) किंवा फील्डसेट "
"(`fieldset`) घटकामध्ये या "
"व्हर्टिकल टॅब्सच्या "
"घटकाच्या कीसह `'#group': vertical_tab_key` "
"अशी कस्टम प्रॉपर्टी "
"परिभाषित करावी लागेल."

msgid ""
"The default tab must be the [id] attributes of the details or fieldset "
"element."
msgstr ""
"डीफॉल्ट टॅब हा details किंवा "
"fieldset या घटकातील [id] गुणधर्म "
"असला पाहिजे."

msgid ""
"A short description of the element used as help for the user when they "
"use the webform."
msgstr ""
"वेबफॉर्म वापरताना "
"वापरकर्त्यासाठी मदत "
"म्हणून वापरल्या जाणाऱ्या "
"घटकाचे संक्षिप्त वर्णन."

msgid "level(s)"
msgstr "स्तर/स्तर(अ)"

msgid "Default wizard/cards show all elements label"
msgstr ""
"डीफॉल्ट "
"विज़ार्ड/कार्ड्समध्ये "
"सर्व घटकांची लेबल्स दाखवा"

msgid "Default wizard/cards hide all elements label"
msgstr ""
"मूळ विजार्ड/कार्ड्स सर्व "
"घटकांचे लेबेल लपवतात"

msgid ""
"It is recommended that these libraries are installed in your Drupal "
"installation's /libraries or /web/libraries directory."
msgstr ""
"या लायब्ररी तुमच्या Drupal "
"इन्स्टॉलेशनमधील `/libraries` "
"किंवा `/web/libraries` या "
"डिरेक्टरीमध्ये इन्स्टॉल "
"करणे शिफारसीय आहे."

msgid "Filter by exporter label"
msgstr ""
"निर्यातक लेबलनुसार "
"फिल्टर करा"

msgid "exporter"
msgstr "एक्सपोर्टर"

msgid "exporters"
msgstr "एक्सपोर्टर्स"

msgid "Enter a part of the exporter label to filter by."
msgstr ""
"फिल्टर करण्यासाठी "
"एक्सपोर्टर लेबलचा काही "
"भाग प्रविष्ट करा."

msgid "Filter by handler label"
msgstr ""
"हँडलर लेबलनुसार फिल्टर "
"करा"

msgid "Enter a part of the handler label to filter by."
msgstr ""
"फिल्टर करण्यासाठी हँडलर "
"लेबलचा काही भाग प्रविष्ट "
"करा."

msgid "Filter by variant label"
msgstr ""
"व्हेरिएंट लेबलनुसार "
"फिल्टर करा"

msgid "Enter a part of the variant label to filter by."
msgstr ""
